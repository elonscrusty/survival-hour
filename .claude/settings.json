{
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/setup_env.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash tools/check.sh:*)",
      "Bash(bash tools/setup_env.sh:*)",
      "Bash(python3 tools/check_bounds.py:*)",
      "Bash(python3 blender/build.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./build/**)",
      "Read(./Export/**)",
      "Read(./Source/**)",
      "Read(./Textures/**)",
      "Read(./Marketing/**)",
      "Read(./SurvivalHourAssets.rbxm)"
    ]
  }
}
