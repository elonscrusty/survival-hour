--!strict
-- Builds every pet, egg, breakable and prop from primitive parts described in
-- ModelData (generated by models/gen_models.py). No uploaded meshes, so all of
-- it works in Studio immediately. See docs/CONTRACTS.md (Models section).
--
-- Every model returned here:
--   * is a fresh clone of a cached template (safe to parent and edit),
--   * has an invisible PrimaryPart "Root" (its bounding box),
--   * has its pivot at the bottom centre, facing -Z,
--   * is anchored.

local ModelData = require(script.ModelData) :: any

local Models = {}

local MATS: { [string]: Enum.Material } = {
	P = Enum.Material.SmoothPlastic,
	N = Enum.Material.Neon,
	G = Enum.Material.Glass,
	F = Enum.Material.Foil,
	M = Enum.Material.Metal,
	I = Enum.Material.Ice,
	L = Enum.Material.Glacier,
	S = Enum.Material.Snow,
	W = Enum.Material.Wood,
	K = Enum.Material.WoodPlanks,
	R = Enum.Material.Rock,
	T = Enum.Material.Slate,
	B = Enum.Material.Basalt,
	C = Enum.Material.CrackedLava,
	A = Enum.Material.Sand,
	E = Enum.Material.Grass,
	O = Enum.Material.Concrete,
	X = Enum.Material.Fabric,
	Y = Enum.Material.Marble,
	D = Enum.Material.DiamondPlate,
	Q = Enum.Material.Pebble,
	Z = Enum.Material.ForceField,
	U = Enum.Material.Cobblestone,
	H = Enum.Material.Brick,
	J = Enum.Material.Granite,
	V = Enum.Material.Sandstone,
	a = Enum.Material.Asphalt,
	g = Enum.Material.Ground,
	l = Enum.Material.LeafyGrass,
	p = Enum.Material.Plastic,
	s = Enum.Material.Salt,
	c = Enum.Material.CeramicTiles,
	m = Enum.Material.Mud,
}

-- Collision profiles.
export type Profile = { CanCollide: boolean, CanQuery: boolean, CanTouch: boolean }
Models.Profiles = {
	Pet = { CanCollide = false, CanQuery = false, CanTouch = false } :: Profile,
	Breakable = { CanCollide = true, CanQuery = true, CanTouch = false } :: Profile,
	Solid = { CanCollide = true, CanQuery = true, CanTouch = false } :: Profile,
	Ghost = { CanCollide = false, CanQuery = true, CanTouch = false } :: Profile,
}

-- Parts with these names keep their colour for Golden/Rainbow variants.
local KEEP_COLOUR = { Eye = true, Collar = true }
-- Rainbow also keeps the cream face / chest patches (see reference/puppy_variants.jpg).
local KEEP_RAINBOW = { Eye = true, Collar = true, Face = true }
-- Invisible helper parts inside props (never collide or block clicks).
local HELPER = { Prompt = true, SignFace = true, EggSpot = true, Root = true }

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local GOLD_DARK = Color3.fromRGB(166, 108, 10)
local GOLD_LIGHT = Color3.fromRGB(255, 206, 74)
local RAINBOW_HUES = { 0, 0.08, 0.15, 0.33, 0.58, 0.76 }
local GOLD_NEON = Color3.fromRGB(255, 213, 74)
local SHINY_TINT = Color3.fromRGB(255, 246, 224)

local function hexColor(c: number): Color3
	return Color3.fromRGB(bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255))
end

local function luminance(c: Color3): number
	return 0.3 * c.R + 0.59 * c.G + 0.11 * c.B
end

-- Creates one part from a data row (see the header of ModelData.luau).
-- `base` places the row; `scale` scales size and offset.
function Models.MakePart(row: { any }, base: CFrame, scale: number, profile: Profile): BasePart
	local shape = row[1] :: string
	local part: BasePart
	if shape == "W" then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if shape == "C" then
			p.Shape = Enum.PartType.Cylinder
		end
		part = p
	end
	local tag = row[13] :: string?
	part.Name = if tag and tag ~= "" then tag else "Part"
	part.Size = Vector3.new(row[2] * scale, row[3] * scale, row[4] * scale)
	part.CFrame = base
		* CFrame.new(row[5] * scale, row[6] * scale, row[7] * scale)
		* CFrame.fromEulerAnglesXYZ(math.rad(row[8]), math.rad(row[9]), math.rad(row[10]))
	part.Color = hexColor(row[11])
	part.Material = MATS[row[12] :: string] or Enum.Material.SmoothPlastic
	part.Transparency = (row[14] :: number?) or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	if shape == "S" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	if HELPER[part.Name] then
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
	else
		part.CanCollide = profile.CanCollide
		part.CanQuery = profile.CanQuery
		part.CanTouch = profile.CanTouch
		-- Tiny details do not need shadows.
		if part.Size.Magnitude < 0.6 * scale then
			part.CastShadow = false
		end
	end
	return part
end

-- Builds all rows of a data entry under `parent` (no Model wrapper).
function Models.BuildRows(rows: { any }, parent: Instance, base: CFrame, scale: number, profile: Profile): { BasePart }
	local out = table.create(#rows)
	for _, row in rows do
		local p = Models.MakePart(row, base, scale, profile)
		p.Parent = parent
		table.insert(out, p)
	end
	return out
end

local function newModel(name: string, entry: any, scale: number, profile: Profile): Model
	local m = Instance.new("Model")
	m.Name = name
	local b = entry.B
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(math.max(b[1] * scale, 0.2), math.max(b[2] * scale, 0.2), math.max(b[3] * scale, 0.2))
	root.CFrame = CFrame.new(0, b[2] * scale / 2, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = profile.CanQuery
	root.CanTouch = false
	root.CastShadow = false
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = m
	Models.BuildRows(entry.P, m, CFrame.identity, scale, profile)
	-- With a PrimaryPart the model pivot is PrimaryPart.CFrame * PivotOffset
	-- (WorldPivot is ignored), so offset it down to the bottom centre.
	root.PivotOffset = CFrame.new(0, -b[2] * scale / 2, 0)
	m.PrimaryPart = root
	return m
end

local function placeholder(name: string, profile: Profile): Model
	warn("[Models] no model data for " .. name)
	local entry: any = { B = { 2.5, 2.5, 2.5 }, P = { { "S" :: any, 2.5, 2.5, 2.5, 0, 1.25, 0, 0, 0, 0, 0xFF66CC, "P", "Body" } } }
	return newModel(name, entry, 1, profile)
end

-- Variants -----------------------------------------------------------------

local function applyGolden(m: Model)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and not KEEP_COLOUR[d.Name] then
			if d.Material == Enum.Material.Neon then
				d.Color = GOLD_NEON
			else
				local t = math.clamp(luminance(d.Color) * 0.6 + 0.3, 0, 1)
				d.Color = GOLD_DARK:Lerp(GOLD_LIGHT, t)
				d.Material = Enum.Material.Foil
				d.Reflectance = 0.08
			end
		end
	end
	m:SetAttribute("Golden", true)
end

-- Static rainbow stripes by height. Each recoloured part carries a
-- RainbowHue attribute (0..1) so the client can animate the hues.
local function applyRainbow(m: Model, height: number)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and not KEEP_RAINBOW[d.Name] then
			-- Horizontal bands (each 15% of the pet height) cycling red, orange, yellow,
			-- green, blue, purple from the top down.
			local rel = 1 - math.clamp(d.Position.Y / math.max(height, 0.01), 0, 1)
			local hue = RAINBOW_HUES[(math.floor(rel / 0.15) % 6) + 1]
			d.Color = Color3.fromHSV(hue, 0.75, 0.97)
			if d.Material ~= Enum.Material.Neon then
				d.Material = Enum.Material.SmoothPlastic
			end
			d:SetAttribute("RainbowHue", hue)
		end
	end
	m:SetAttribute("Rainbow", true)
end

local function applyShiny(m: Model)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and not KEEP_COLOUR[d.Name] then
			d.Color = d.Color:Lerp(SHINY_TINT, 0.15)
		end
	end
	local root = m.PrimaryPart :: BasePart
	local e = Instance.new("ParticleEmitter")
	e.Name = "ShinySparkles"
	e.Texture = SPARKLE_TEXTURE
	e.Rate = 7
	e.Lifetime = NumberRange.new(0.6, 1.3)
	e.Speed = NumberRange.new(0.4, 1.2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.3, 0.45),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.8),
	})
	e.Color = ColorSequence.new(Color3.fromRGB(255, 244, 170), Color3.fromRGB(255, 200, 60))
	e.LightEmission = 1
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Parent = root
	m:SetAttribute("Shiny", true)
end

-- Cache --------------------------------------------------------------------

local templates: { [string]: Model } = {}

local function cached(key: string, make: () -> Model): Model
	local t = templates[key]
	if not t then
		t = make()
		templates[key] = t
	end
	return t:Clone()
end

-- Public API ---------------------------------------------------------------

function Models.Pet(petId: string, variant: string, shiny: boolean): Model
	local key = "Pet|" .. petId .. "|" .. tostring(variant) .. "|" .. (if shiny then "1" else "0")
	return cached(key, function()
		local entry = ModelData.Pets[petId]
		local m = if entry then newModel(petId, entry, 1, Models.Profiles.Pet) else placeholder(petId, Models.Profiles.Pet)
		if variant == "Golden" then
			applyGolden(m)
		elseif variant == "Rainbow" then
			applyRainbow(m, if entry then entry.B[2] else 2.5)
		end
		if shiny then
			applyShiny(m)
		end
		m:SetAttribute("PetId", petId)
		m:SetAttribute("Variant", variant)
		return m
	end)
end

-- Creature (contract API; see docs/CONTRACTS.md). PLACEHOLDER until the models pass:
-- an element-coloured block sized by stage, with Saddle/Hat/Aura attachments.
export type CreatureOpts = { Neon: boolean?, Cosmetics: { [string]: string }? }
function Models.Creature(species: string, element: string, rarity: string, stage: string, opts: CreatureOpts?): Model
	local m = placeholder(species, Models.Profiles.Pet)
	local root = m.PrimaryPart :: BasePart
	for _, name in { "Saddle", "Hat", "Aura" } do
		local a = Instance.new("Attachment")
		a.Name = name
		a.Parent = root
	end
	m:SetAttribute("Species", species)
	m:SetAttribute("Element", element)
	m:SetAttribute("Rarity", rarity)
	m:SetAttribute("Stage", stage)
	m:SetAttribute("Neon", opts ~= nil and opts.Neon == true)
	return m
end

-- Cosmetic model (contract API). PLACEHOLDER until the models pass.
function Models.Cosmetic(id: string): Model
	return placeholder(id, Models.Profiles.Pet)
end

function Models.Egg(eggId: string, scale: number?): Model
	local s = scale or 1
	return cached("Egg|" .. eggId .. "|" .. s, function()
		local entry = ModelData.Eggs[eggId]
		local m = if entry then newModel(eggId, entry, s, Models.Profiles.Pet) else placeholder(eggId, Models.Profiles.Pet)
		m:SetAttribute("EggId", eggId)
		return m
	end)
end

function Models.Breakable(kind: string, areaId: string): Model
	return cached("Breakable|" .. kind .. "|" .. areaId, function()
		local byArea = ModelData.Breakables[areaId] or ModelData.Breakables.Meadow
		local entry = byArea and byArea[kind]
		local m = if entry
			then newModel(kind, entry, 1, Models.Profiles.Breakable)
			else placeholder(kind, Models.Profiles.Breakable)
		m:SetAttribute("Kind", kind)
		m:SetAttribute("Area", areaId)
		return m
	end)
end

-- Props (decorations and interactable bodies). Not part of the gameplay
-- contract; used by World.luau and available to the client for effects.
function Models.Prop(name: string, scale: number?): Model
	local s = scale or 1
	return cached("Prop|" .. name .. "|" .. s, function()
		local entry = ModelData.Props[name]
		if not entry then
			return placeholder(name, Models.Profiles.Solid)
		end
		return newModel(name, entry, s, if entry.C then Models.Profiles.Solid else Models.Profiles.Ghost)
	end)
end

-- Raw prop entry ({ B, C, P }) or nil.
function Models.PropData(name: string): any
	return ModelData.Props[name]
end

-- True when the generator produced data for this pet / egg / breakable.
function Models.HasPet(petId: string): boolean
	return ModelData.Pets[petId] ~= nil
end

function Models.HasEgg(eggId: string): boolean
	return ModelData.Eggs[eggId] ~= nil
end

return Models
