--!strict
-- Builds the whole map under workspace.World from primitives (WorldData is
-- generated by models/gen_models.py) and returns the positions the server
-- needs. Tags, attributes and prompts follow docs/CONTRACTS.md (World).
--
-- Six contiguous regions along +X, with a starter hub, individual habitats,
-- and an optional trainer battle arena. Ground top is y = 0.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Models = require(script.Parent)
local Data = require("./WorldData") :: any
local Areas = require("../Areas")
local Eggs = require("../Eggs")

export type Zone = { Center: Vector3, Size: Vector3 }
export type WorldInfo = {
	Spawns: { [string]: CFrame },
	Zones: { [string]: { Zone } },
	Bounds: { [string]: { Min: Vector3, Max: Vector3 } },
	Arena: { Center: Vector3, Radius: number }, -- battle arena (floor top at Center.Y)
}

local World = {}

World.IslandSpacing = Data.IslandSpacing :: number
World.WaterLevel = Data.Water.level :: number

local PROMPT_DISTANCE = 12
local EGG_STAND_SCALE = 1.8
local FONT = Enum.Font.FredokaOne

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

-- 2500 -> "2.5K", 1.6e8 -> "160M"
local function short(n: number): string
	local sizes = { 1e12, 1e9, 1e6, 1e3 }
	local names = { "T", "B", "M", "K" }
	for i, size in sizes do
		if n >= size then
			local v = n / size
			local s = if v >= 100 then string.format("%d", math.floor(v + 0.5)) else string.format("%.1f", v)
			s = string.gsub(s, "%.0$", "")
			return s .. names[i]
		end
	end
	return tostring(math.floor(n))
end
World.Short = short

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function addPrompt(part: BasePart, action: string, object: string): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = PROMPT_DISTANCE
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.Parent = part
	return p
end

-- Text on the front face of a SignFace part: a title and an optional subtitle.
local function addSign(part: BasePart, title: string, sub: string?, color: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Parent = part
	local function label(text: string, y: number, h: number, col: Color3)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(0.96, h)
		l.Position = UDim2.fromScale(0.02, y)
		l.Font = FONT
		l.Text = text
		l.TextScaled = true
		l.TextColor3 = col
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Color = Color3.fromRGB(40, 28, 50)
		stroke.Parent = l
		l.Parent = gui
	end
	local main = color or Color3.fromRGB(255, 255, 255)
	if sub then
		label(title, 0.02, 0.58, main)
		label(sub, 0.6, 0.38, Color3.fromRGB(255, 226, 90))
	else
		label(title, 0.08, 0.84, main)
	end
	local back = gui:Clone()
	back.Name = "SignGuiBack"
	back.Face = Enum.NormalId.Back
	back.Parent = part
end

local function findPart(m: Model, name: string): BasePart?
	local p = m:FindFirstChild(name)
	return if p and p:IsA("BasePart") then p else nil
end

local function propCFrame(pos: Vector3, yawDeg: number): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)
end

-- Builds an interactable prop as a Model (pivot = bottom centre).
local function interactModel(prop: string, name: string, cf: CFrame, parent: Instance): Model
	local m = Models.Prop(prop)
	m.Name = name
	m:PivotTo(cf)
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	m.Parent = parent
	return m
end

local function setupLighting()
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local a = Instance.new("Atmosphere")
		a.Density = 0.26
		a.Offset = 0.2
		a.Color = Color3.fromRGB(205, 225, 255)
		a.Decay = Color3.fromRGB(110, 150, 200)
		a.Glare = 0.15
		a.Haze = 1
		a.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local b = Instance.new("BloomEffect")
		b.Intensity = 0.5
		b.Size = 28
		b.Threshold = 1.6
		b.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local c = Instance.new("ColorCorrectionEffect")
		c.Saturation = 0.12
		c.Contrast = 0.05
		c.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local s = Instance.new("SunRaysEffect")
		s.Intensity = 0.05
		s.Spread = 0.6
		s.Parent = Lighting
	end
	-- Lets Foil/Metal (golden pets, coins) pick up sky reflections.
	Lighting.EnvironmentSpecularScale = math.max(Lighting.EnvironmentSpecularScale, 0.8)
	Lighting.EnvironmentDiffuseScale = math.max(Lighting.EnvironmentDiffuseScale, 0.6)
end

local function fillWater()
	local w = Data.Water
	local terrain = workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(56, 170, 230)
	terrain.WaterTransparency = 0.55
	terrain.WaterReflectance = 0.4
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
	local depth = 32
	local chunk = 400
	local x = w.minx
	while x < w.maxx do
		local sx = math.min(chunk, w.maxx - x)
		local z = w.minz
		while z < w.maxz do
			local sz = math.min(chunk, w.maxz - z)
			local cx, cz = x + sx / 2, z + sz / 2
			terrain:FillBlock(CFrame.new(cx, w.level - depth / 2, cz), Vector3.new(sx, depth, sz), Enum.Material.Water)
			terrain:FillBlock(CFrame.new(cx, w.level - depth - 4, cz), Vector3.new(sx, 8, sz), Enum.Material.Sand)
			z += chunk
		end
		x += chunk
	end
end

function World.Build(): WorldInfo
	local old = workspace:FindFirstChild("World")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "World"
	local info: WorldInfo = { Spawns = {}, Zones = {}, Bounds = {}, Arena = { Center = Vector3.zero, Radius = 0 } }

	-- Static geometry (ground, cliffs, paths, walls, bridges).
	local groups: { [string]: Folder } = {}
	local function group(name: string): Folder
		local g = groups[name]
		if not g then
			g = folder(name, root)
			groups[name] = g
		end
		return g
	end
	for name, rows in Data.Parts do
		local g = group(name)
		local parts = Models.BuildRows(rows, g, CFrame.identity, 1, Models.Profiles.Solid)
		for _, p in parts do
			if p.Name == "Wall" then
				p.Transparency = 1
				p.CanCollide = true
				p.CanQuery = false
				p.CanTouch = false
				p.CastShadow = false
			end
		end
	end

	-- Decorations: plain parts (no Model per prop) to keep the instance count low.
	local decor: { [string]: Folder } = {}
	for _, pl in Data.Place do
		local name, x, y, z, yaw, s, area = pl[1], pl[2], pl[3], pl[4], pl[5], pl[6], pl[7]
		local entry = Models.PropData(name)
		if not entry then
			warn("[World] missing prop " .. tostring(name))
			continue
		end
		local f = decor[area]
		if not f then
			f = folder("Decor", group(area))
			decor[area] = f
		end
		local profile = if entry.C then Models.Profiles.Solid else Models.Profiles.Ghost
		Models.BuildRows(entry.P, f, propCFrame(Vector3.new(x, y, z), yaw), s, profile)
	end

	-- Interactables.
	for _, it in Data.Interact do
		local area = it.Area :: string
		local pos = v3(it.P)
		local cf = propCFrame(pos, it.Yaw)
		local parent = group(area)
		local kind = it.Kind :: string
		local attrs = it.A
		if kind == "SpawnLocation" then
			local pad = interactModel(it.Prop, "SpawnPad", cf, parent)
			pad.ModelStreamingMode = Enum.ModelStreamingMode.Default
			local sp = Instance.new("SpawnLocation")
			sp.Name = "SpawnLocation"
			sp.Size = Vector3.new(12, 1, 12)
			local spawnPos = pos + Vector3.new(0, 0.2, 0)
			sp.CFrame = CFrame.lookAt(spawnPos, spawnPos + Vector3.xAxis)
			sp.Anchored = true
			sp.CanCollide = false
			sp.CanQuery = false
			sp.Transparency = 1
			sp.Neutral = true
			sp.Duration = 0
			sp.Parent = parent
		elseif kind == "Sign" then
			local m = interactModel(it.Prop, "Sign", cf, parent)
			local face = findPart(m, "SignFace")
			if face then
				addSign(face, attrs.Text)
			end
		elseif kind == "EggStand" then
			local eggId = attrs.EggId :: string
			local egg = Eggs.ById[eggId]
			local m = interactModel(it.Prop, "EggStand_" .. eggId, cf, parent)
			m:SetAttribute("EggId", eggId)
			local spot = findPart(m, "EggSpot")
			if spot then
				local eggModel = Models.Egg(eggId, EGG_STAND_SCALE)
				eggModel.Name = "Egg"
				eggModel:PivotTo(spot.CFrame)
				eggModel.Parent = m
			end
			local cost = if egg then short(egg.Cost) .. (if egg.Currency == "Gems" then " Gems" else " Coins") else ""
			local face = findPart(m, "SignFace")
			if face then
				addSign(face, if egg then egg.Name else eggId, cost)
			end
			local promptPart = findPart(m, "Prompt")
			if promptPart then
				addPrompt(promptPart, "Hatch", (if egg then egg.Name else eggId) .. " (" .. cost .. ")")
			end
			CollectionService:AddTag(m, "EggStand")
		elseif kind == "Gate" then
			local areaId = attrs.AreaId :: string
			local a = Areas.ById[areaId]
			local m = interactModel(it.Prop, "Gate_" .. areaId, cf, parent)
			m:SetAttribute("AreaId", areaId)
			local barrier = findPart(m, "Barrier")
			if barrier then
				barrier.CanCollide = true
				barrier.CanQuery = true
				barrier.CanTouch = false
				barrier.CastShadow = false
			end
			local cost = if a then short(a.GateCost) .. " Coins" else ""
			local face = findPart(m, "SignFace")
			if face then
				addSign(face, if a then a.Name else areaId, cost)
			end
			local promptPart = findPart(m, "Prompt")
			if promptPart then
				addPrompt(promptPart, "Unlock", (if a then a.Name else areaId) .. " (" .. cost .. ")")
			end
			CollectionService:AddTag(m, "Gate")
		else
            local m = interactModel(it.Prop, kind, cf, parent)
            local texts: { [string]: { string } } = {}
			local t = texts[kind] or { kind, "Open", kind }
            if kind == "HabitatPlot" then
                m:SetAttribute("PlotIndex", tonumber(attrs.PlotIndex))
                for slot=1,8 do
                    local attachment=Instance.new("Attachment")
                    attachment.Name="Slot" .. slot
                    local worldSlot = pos + Vector3.new((slot-1)%4*10-15,1,(math.floor((slot-1)/4)-.5)*18)
                    attachment.Position=(m.PrimaryPart :: BasePart).CFrame:PointToObjectSpace(worldSlot)
                    attachment.Parent=m.PrimaryPart
                end
                t={"HABITAT " .. tostring(attrs.PlotIndex),"Manage","Your creature garden"}
            elseif kind == "BattleArena" then
                t={"TRAINER ARENA","Battle","Optional 3 creature PvP"}
            elseif kind == "Hatchery" then t={"HATCHERY","Incubate","Egg incubators"}
            elseif kind == "FusionAltar" then t={"FUSION","Fuse","Fuse two creatures"}
            elseif kind == "CosmeticShop" then t={"COSMETICS","Shop","Creature accessories"}
            end
			local face = findPart(m, "SignFace")
			if face then
				addSign(face, t[1])
			end
			local promptPart = findPart(m, "Prompt") or m.PrimaryPart
			if promptPart then
				addPrompt(promptPart, t[2], t[3])
			end
			CollectionService:AddTag(m, kind)
		end
	end

	-- Area bounds, spawns, zones.
	for _, a in Areas.List do
		local b = Data.Bounds[a.Id]
		local s = Data.Spawns[a.Id]
		if not b or not s then
			warn("[World] no layout for area " .. a.Id)
			continue
		end
		local mn, mx = v3(b.Min), v3(b.Max)
		local box = Instance.new("Part")
		box.Name = "AreaBounds_" .. a.Id
		box.Size = mx - mn
		box.CFrame = CFrame.new((mn + mx) / 2)
		box.Anchored = true
		box.CanCollide = false
		box.CanQuery = false
		box.CanTouch = true
		box.CastShadow = false
		box.Transparency = 1
		box:SetAttribute("AreaId", a.Id)
		CollectionService:AddTag(box, "AreaBounds")
		box.Parent = group(a.Id)
		info.Bounds[a.Id] = { Min = mn, Max = mx }
		local sp = v3(s)
		info.Spawns[a.Id] = CFrame.lookAt(sp, sp + Vector3.xAxis)
		local zones = {}
		for _, z in Data.Zones[a.Id] do
			table.insert(zones, { Center = v3(z.C), Size = v3(z.S) })
		end
		info.Zones[a.Id] = zones
	end

	-- Battle arena bounds are informational; walking in never begins a fight.
	do
		local c = v3(Data.Arena.C) + Vector3.new(0, 0.8, 0)
		local r: number = Data.Arena.R
		local zone = Instance.new("Part")
		zone.Name = "ArenaZone"
		zone.Shape = Enum.PartType.Cylinder
		zone.Size = Vector3.new(14, r * 2, r * 2)
		zone.CFrame = CFrame.new(c + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90))
		zone.Anchored = true
		zone.CanCollide = false
		zone.CanQuery = false
		zone.CanTouch = false
		zone.CastShadow = false
		zone.Transparency = 1
		zone:SetAttribute("Radius", r)
		CollectionService:AddTag(zone, "BattleArenaBounds")
		zone.Parent = group("Meadow")
		info.Arena = { Center = c, Radius = r }
	end

	setupLighting()
	fillWater()
	root.Parent = workspace
	return info
end

return World
