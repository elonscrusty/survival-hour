        <Item class="Folder" referent="79">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- UI kit: small helpers for building the whole interface in code.
-- Everything is sized in "reference pixels" (Theme.RefWidth x RefHeight);
-- Kit.autoScale adds a UIScale that fits that canvas to the real screen, so
-- the same layout works on phones, tablets and PC.

local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require("./Theme")
local Sounds = require("../Core/Sounds")

local Kit = {}

-- Kit.new("Frame", { Size = ..., Parent = ... }, { children })
function Kit.new(className: string, props: { [string]: any }?, children: { any }?): any
	local inst: any = Instance.new(className :: any)
	local parent: Instance? = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(radius: (number | UDim)?): any
	local r: UDim
	if typeof(radius) == "UDim" then
		r = radius
	elseif type(radius) == "number" then
		r = UDim.new(0, radius)
	else
		r = Theme.Corner
	end
	return Kit.new("UICorner", { CornerRadius = r })
end

function Kit.stroke(color: Color3?, thickness: number?, transparency: number?): any
	return Kit.new("UIStroke", {
		Color = color or Theme.Colors.Stroke,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Text outline (applies to the text of a TextLabel/TextButton).
function Kit.textStroke(color: Color3?, thickness: number?): any
	return Kit.new("UIStroke", {
		Color = color or Theme.Colors.Stroke,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

function Kit.pad(top: number, right: number?, bottom: number?, left: number?): any
	local r = right or top
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or r),
	})
end

function Kit.list(
	dir: Enum.FillDirection?,
	padding: number?,
	halign: Enum.HorizontalAlignment?,
	valign: Enum.VerticalAlignment?
): any
	return Kit.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Kit.grid(cell: Vector2, padding: number?): any
	local p = padding or 8
	return Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(p, p),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
	})
end

-- Vertical gradient that multiplies the background colour (top lighter).
function Kit.shade(amount: number?): any
	local a = amount or 0.25
	return Kit.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1 - a, 1 - a, 1 - a)),
	})
end

function Kit.gradient(a: Color3, b: Color3, rotation: number?): any
	return Kit.new("UIGradient", { Rotation = rotation or 90, Color = ColorSequence.new(a, b) })
end

function Kit.tween(inst: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

-- Text label. props may include Color, Size, TextSize, Outline (bool or
-- Color3), Align ("Left"|"Center"|"Right"), Font, Rich.
function Kit.label(text: string, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = if props then table.clone(props) else {}
	local outline = p.Outline
	local align = p.Align
	local color = p.Color
	local rich = p.Rich
	p.Outline = nil
	p.Align = nil
	p.Color = nil
	p.Rich = nil
	p.Text = text
	p.BackgroundTransparency = 1
	p.Font = p.Font or Theme.Font
	p.TextSize = p.TextSize or 20
	p.TextColor3 = color or p.TextColor3 or (if outline then Theme.Colors.TextLight else Theme.Colors.Text)
	p.Size = p.Size or UDim2.new(1, 0, 0, (p.TextSize :: number) + 6)
	p.TextWrapped = if p.TextWrapped == nil then true else p.TextWrapped
	p.RichText = rich == true
	if align == "Left" then
		p.TextXAlignment = Enum.TextXAlignment.Left
	elseif align == "Right" then
		p.TextXAlignment = Enum.TextXAlignment.Right
	end
	local kids: { any } = {}
	if outline then
		table.insert(kids, Kit.textStroke(if typeof(outline) == "Color3" then outline else Theme.Colors.Stroke, 2))
	end
	return Kit.new("TextLabel", p, kids)
end

-- Text label that shrinks to fit its box (TextScaled with a max size).
function Kit.fitLabel(text: string, maxSize: number, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = if props then table.clone(props) else {}
	p.TextScaled = true
	p.TextSize = maxSize
	local l = Kit.label(text, p)
	Kit.new("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8, Parent = l })
	return l
end

local function applyTone(b: GuiObject, toneName: string)
	local tone = Theme.Tones[toneName] or Theme.Tones.Blue
	b.BackgroundColor3 = tone.Top
	local rim = b:FindFirstChild("Rim") :: UIStroke?
	if rim then
		rim.Color = tone.Rim
	end
	local label = b:FindFirstChild("Label") :: TextLabel?
	if label then
		label.TextColor3 = tone.Text
		local ts = label:FindFirstChildOfClass("UIStroke")
		if ts then
			ts.Color = tone.Rim
			ts.Enabled = toneName ~= "White"
		end
	end
end

-- Candy button. `text` may contain RichText. Returns the TextButton; the
-- visible text is the child "Label". Use Kit.setButton to change it later.
-- props: Size, Position, AnchorPoint, LayoutOrder, TextSize, Parent, Name, ZIndex.
function Kit.button(text: string, tone: string?, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local p: { [string]: any } = if props then table.clone(props) else {}
	local textSize = p.TextSize or 22
	p.TextSize = nil
	p.Text = ""
	p.AutoButtonColor = false
	p.BorderSizePixel = 0
	p.Size = p.Size or UDim2.fromOffset(160, Theme.TouchMin)
	local b: TextButton = Kit.new("TextButton", p, {
		Kit.corner(12),
		Kit.new("UIStroke", { Name = "Rim", Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round }),
		Kit.shade(0.18),
		Kit.new("UIScale", { Name = "Press" }),
		Kit.new("TextLabel", {
			Name = "Label",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -12, 1, -6),
			Position = UDim2.fromOffset(6, 2),
			Font = Theme.Font,
			Text = text,
			RichText = true,
			TextScaled = true,
			TextWrapped = true,
			ZIndex = (p.ZIndex or 1) + 1,
		}, {
			Kit.new("UITextSizeConstraint", { MaxTextSize = textSize, MinTextSize = 8 }),
			Kit.textStroke(nil, 2),
		}),
	})
	b:SetAttribute("Tone", tone or "Blue")
	b:SetAttribute("Enabled", true)
	applyTone(b, tone or "Blue")
	local press = b:FindFirstChild("Press") :: UIScale
	b.MouseButton1Down:Connect(function()
		Kit.tween(press, 0.08, { Scale = 0.92 })
	end)
	local function release()
		Kit.tween(press, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
	b.MouseEnter:Connect(function()
		if b:GetAttribute("Enabled") ~= false then
			Kit.tween(press, 0.1, { Scale = 1.04 })
		end
	end)
	if onClick then
		b.Activated:Connect(function()
			if b:GetAttribute("Enabled") == false then
				Sounds.Play("Error")
				return
			end
			Sounds.Play("Click")
			onClick()
		end)
	end
	return b
end

export type ButtonChange = { Text: string?, Tone: string?, Enabled: boolean? }

function Kit.setButton(b: GuiObject, change: ButtonChange)
	if change.Text then
		local label = b:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = change.Text
		end
	end
	if change.Tone then
		b:SetAttribute("Tone", change.Tone)
	end
	if change.Enabled ~= nil then
		b:SetAttribute("Enabled", change.Enabled)
	end
	local tone = b:GetAttribute("Tone") :: string?
	applyTone(b, if b:GetAttribute("Enabled") == false then "Grey" else (tone or "Blue"))
end

-- Rounded panel with a dark outline.
function Kit.panel(props: { [string]: any }, children: { any }?): Frame
	local p = table.clone(props)
	p.BackgroundColor3 = p.BackgroundColor3 or Theme.Colors.Panel
	p.BorderSizePixel = 0
	local kids = children or {}
	table.insert(kids, Kit.corner(p.Corner or 14))
	table.insert(kids, Kit.stroke(p.StrokeColor or Theme.Colors.Stroke, p.StrokeThickness or 3))
	p.Corner = nil
	p.StrokeColor = nil
	p.StrokeThickness = nil
	return Kit.new("Frame", p, kids)
end

-- Transparent frame (layout container).
function Kit.box(props: { [string]: any }, children: { any }?): Frame
	local p = table.clone(props)
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	return Kit.new("Frame", p, children)
end

function Kit.scroll(props: { [string]: any }, children: { any }?): ScrollingFrame
	local p = table.clone(props)
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.ScrollBarThickness = p.ScrollBarThickness or 8
	p.ScrollBarImageColor3 = Theme.Colors.Stroke
	p.ScrollBarImageTransparency = 0.4
	p.CanvasSize = UDim2.new()
	p.AutomaticCanvasSize = p.AutomaticCanvasSize or Enum.AutomaticSize.Y
	p.ScrollingDirection = p.ScrollingDirection or Enum.ScrollingDirection.Y
	p.ElasticBehavior = Enum.ElasticBehavior.Always
	return Kit.new("ScrollingFrame", p, children)
end

-- Progress bar. Returns the frame and a setter(fraction, text?).
function Kit.bar(props: { [string]: any }, fill: Color3): (Frame, (number, string?) -> ())
	local p = table.clone(props)
	p.BackgroundColor3 = Theme.Colors.PanelDark
	p.BorderSizePixel = 0
	local frame: Frame = Kit.new("Frame", p, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(Theme.Colors.Stroke, 2) })
	local inner: Frame = Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = fill,
		BorderSizePixel = 0,
		Parent = frame,
	}, { Kit.corner(UDim.new(0.5, 0)), Kit.shade(0.2) })
	local label = Kit.fitLabel("", 16, {
		Size = UDim2.fromScale(1, 1),
		Outline = true,
		ZIndex = (p.ZIndex or 1) + 2,
		Parent = frame,
	})
	local function set(frac: number, text: string?)
		local f = math.clamp(if frac ~= frac then 0 else frac, 0, 1)
		inner.Size = UDim2.fromScale(f, 1)
		inner.Visible = f > 0.001
		if text then
			label.Text = text
		end
	end
	return frame, set
end

-- Small rounded pill: icon + text, used for prices, badges and timers.
function Kit.pill(text: string, color: Color3, props: { [string]: any }?): Frame
	local p: { [string]: any } = if props then table.clone(props) else {}
	p.BackgroundColor3 = color
	p.Size = p.Size or UDim2.fromOffset(90, 28)
	local f: Frame = Kit.new("Frame", p, {
		Kit.corner(UDim.new(0.5, 0)),
		Kit.stroke(Theme.Darken(color, 0.45), 2),
		Kit.shade(0.15),
	})
	Kit.fitLabel(text, (p.Size :: UDim2).Y.Offset - 8, {
		Name = "Label",
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.fromOffset(5, 0),
		Outline = Theme.Darken(color, 0.5),
		Rich = true,
		Parent = f,
	})
	return f
end

function Kit.setPill(f: Instance, text: string)
	local l = f:FindFirstChild("Label") :: TextLabel?
	if l then
		l.Text = text
	end
end

-- Row of tab buttons. Returns the row and select(name) (which also calls onSelect).
function Kit.tabs(parent: Instance, names: { string }, labels: { [string]: string }?, onSelect: (string) -> ()): (Frame, (string) -> ())
	local row: Frame = Kit.box({
		Name = "Tabs",
		Size = UDim2.new(1, 0, 0, 56),
		Parent = parent,
	}, { Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left) })
	local buttons: { [string]: TextButton } = {}
	local function select(name: string)
		for n, b in buttons do
			Kit.setButton(b, { Tone = if n == name then "Blue" else "White" })
		end
		onSelect(name)
	end
	for i, n in names do
		local b = Kit.button(if labels and labels[n] then labels[n] else n, "White", {
			Size = UDim2.fromOffset(150, 52),
			LayoutOrder = i,
			TextSize = 22,
			Parent = row,
		}, function()
			select(n)
		end)
		buttons[n] = b
	end
	return row, select
end

-- Pop-in animation for a newly shown element. Reuses the element's own
-- UIScale when it has one (a GuiObject must never get two UIScales).
function Kit.pop(inst: GuiObject, from: number?)
	local s = inst:FindFirstChildOfClass("UIScale")
	if not s then
		s = Kit.new("UIScale", { Name = "Pop", Parent = inst })
	end
	local scale = s :: UIScale
	local base = 1
	if scale.Name == "AutoScale" then
		local mult = scale:GetAttribute("Mult")
		base = Kit.screenScale() * (if type(mult) == "number" then mult else 1)
	end
	scale.Scale = base * (from or 0.6)
	Kit.tween(scale, 0.25, { Scale = base }, Enum.EasingStyle.Back)
end

-- Removes children except layout helpers.
function Kit.clear(container: Instance)
	for _, c in container:GetChildren() do
		if not (c:IsA("UIListLayout") or c:IsA("UIGridLayout") or c:IsA("UIPadding") or c:IsA("UICorner") or c:IsA("UIStroke") or c:IsA("UIGradient") or c:IsA("UIScale") or c:IsA("UISizeConstraint")) then
			c:Destroy()
		end
	end
end

-- Auto scale ---------------------------------------------------------------

local scales: { [UIScale]: number } = {} -- UIScale -> multiplier

function Kit.screenScale(): number
	local cam = Workspace.CurrentCamera
	local vs = if cam then cam.ViewportSize else Vector2.new(Theme.RefWidth, Theme.RefHeight)
	if vs.X < 2 or vs.Y < 2 then
		return 1
	end
	-- leave room for the Roblox top bar and notches
	local ok, topLeft, bottomRight = pcall(function()
		return GuiService:GetGuiInset()
	end)
	local insetY = if ok and topLeft and bottomRight then (topLeft :: Vector2).Y + (bottomRight :: Vector2).Y else 36
	local h = math.max(100, vs.Y - insetY)
	return math.clamp(math.min(vs.X / Theme.RefWidth, h / Theme.RefHeight), 0.5, 1.4)
end

-- True on small (phone-sized) screens.
function Kit.isSmall(): boolean
	local cam = Workspace.CurrentCamera
	return cam ~= nil and math.min(cam.ViewportSize.X, cam.ViewportSize.Y) < 500
end

local function refreshScales()
	local s = Kit.screenScale()
	for sc, mult in scales do
		sc.Scale = s * mult
	end
end

-- Adds a UIScale that follows the screen size. `mult` tweaks it per element.
function Kit.autoScale(gui: Instance, mult: number?): UIScale
	local m = mult or 1
	local sc: UIScale = Kit.new("UIScale", { Name = "AutoScale", Parent = gui })
	sc:SetAttribute("Mult", m)
	scales[sc] = m
	sc.Destroying:Connect(function()
		scales[sc] = nil
	end)
	sc.Scale = Kit.screenScale() * m
	return sc
end

local camConn: RBXScriptConnection? = nil
local function watchCamera()
	if camConn then
		camConn:Disconnect()
	end
	local cam = Workspace.CurrentCamera
	if cam then
		camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
	end
	refreshScales()
end
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">PetCard</string>
              <string name="Source"><![CDATA[--!strict
-- Pet tile used by every pet grid (inventory, crafting, expeditions, trade).
-- Rarity-coloured card with the pet picture, power, level and badges.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

local Theme = require("./Theme")
local Kit = require("./Kit")
local Viewport = require("./Viewport")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")

type PetInstance = Types.PetInstance

local PetCard = {}

export type Flags = {
	Equipped: boolean?,
	Locked: boolean?,
	Busy: boolean?,
	Selected: boolean?,
	Marked: boolean?, -- red "to delete" outline
	Dim: boolean?,
}

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 110, 110)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 90)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(140, 240, 110)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(100, 210, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 120, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 200)),
})
PetCard.RainbowSequence = RAINBOW

local function badge(text: string, color: Color3, pos: UDim2, anchor: Vector2, name: string, parent: Instance)
	local f = Kit.pill(text, color, {
		Name = name,
		Size = UDim2.fromOffset(34, 24),
		Position = pos,
		AnchorPoint = anchor,
		ZIndex = 5,
		Parent = parent,
	})
	f.Visible = false
	return f
end

-- Creates a card. size defaults to 100 x 118.
function PetCard.new(pet: PetInstance, size: Vector2?, onClick: (() -> ())?): TextButton
	local s = size or Vector2.new(100, 118)
	local rarity = PetInfo.Rarity(pet.Id)
	local rc = Theme.RarityColor(rarity)
	local card: TextButton = Kit.new("TextButton", {
		Name = pet.Uid,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(s.X, s.Y),
		BackgroundColor3 = Theme.Lighten(rc, 0.55),
		BorderSizePixel = 0,
	}, {
		Kit.corner(14),
		Kit.new("UIStroke", { Name = "Outline", Color = Theme.Darken(rc, 0.25), Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		Kit.new("UIScale", { Name = "Press" }),
	})
	card:SetAttribute("PetId", pet.Id)
	if pet.Variant == "Rainbow" then
		Kit.new("UIGradient", { Name = "Bg", Color = RAINBOW, Rotation = 35, Parent = card })
		card.BackgroundColor3 = Color3.new(1, 1, 1)
	elseif pet.Variant == "Golden" then
		Kit.new("UIGradient", {
			Name = "Bg",
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(240, 180, 40)),
			Parent = card,
		})
		card.BackgroundColor3 = Color3.new(1, 1, 1)
	else
		Kit.new("UIGradient", {
			Name = "Bg",
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)),
			Parent = card,
		})
	end
	Viewport.Pet(pet.Id, pet.Variant, pet.Shiny, {
		Size = UDim2.new(1, -8, 1, -30),
		Position = UDim2.fromOffset(4, 4),
		ZIndex = 2,
		Parent = card,
	})
	Kit.fitLabel(Theme.Icons.Boost .. Format.num(PetInfo.Power(pet)), 18, {
		Name = "Power",
		Size = UDim2.new(1, -8, 0, 24),
		Position = UDim2.new(0, 4, 1, -27),
		Outline = Theme.Darken(rc, 0.5),
		ZIndex = 4,
		Parent = card,
	})
	if (pet.Level or 1) > 1 then
		Kit.fitLabel("Lv" .. tostring(pet.Level), 14, {
			Name = "Level",
			Size = UDim2.fromOffset(40, 18),
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -4, 1, -28),
			Outline = true,
			Align = "Right",
			ZIndex = 4,
			Parent = card,
		})
	end
	if pet.Shiny then
		Kit.fitLabel(Theme.Icons.Shiny, 20, {
			Name = "Shiny",
			Size = UDim2.fromOffset(24, 24),
			Position = UDim2.new(0, 4, 1, -52),
			ZIndex = 4,
			Parent = card,
		})
	end
	badge(Theme.Icons.Equipped, Theme.Colors.Good, UDim2.fromOffset(-6, -6), Vector2.zero, "Equipped", card)
	badge(Theme.Icons.Lock, Theme.Colors.Warn, UDim2.new(1, 6, 0, -6), Vector2.new(1, 0), "Locked", card)
	badge(Theme.Icons.Expeditions, Theme.Colors.Info, UDim2.new(0.5, 0, 0, -6), Vector2.new(0.5, 0), "Busy", card)
	local press = card:FindFirstChild("Press") :: UIScale
	card.MouseButton1Down:Connect(function()
		Kit.tween(press, 0.08, { Scale = 0.93 })
	end)
	card.MouseButton1Up:Connect(function()
		Kit.tween(press, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	card.MouseLeave:Connect(function()
		Kit.tween(press, 0.15, { Scale = 1 })
	end)
	if onClick then
		card.Activated:Connect(function()
			Sounds.Play("Click")
			onClick()
		end)
	end
	return card
end

function PetCard.SetFlags(card: Instance, flags: Flags)
	local function show(name: string, on: boolean?)
		local b = card:FindFirstChild(name) :: GuiObject?
		if b then
			b.Visible = on == true
		end
	end
	show("Equipped", flags.Equipped)
	show("Locked", flags.Locked)
	show("Busy", flags.Busy)
	local outline = card:FindFirstChild("Outline") :: UIStroke?
	if outline then
		if flags.Marked then
			outline.Color = Theme.Colors.Bad
			outline.Thickness = 5
		elseif flags.Selected then
			outline.Color = Color3.fromRGB(40, 120, 255)
			outline.Thickness = 5
		else
			local id = card:GetAttribute("PetId")
			local rc = Theme.RarityColor(PetInfo.Rarity(if type(id) == "string" then id else ""))
			outline.Color = Theme.Darken(rc, 0.25)
			outline.Thickness = 3
		end
	end
	local pic = card:FindFirstChild("Picture") :: ViewportFrame?
	if pic then
		pic.ImageTransparency = if flags.Dim or flags.Busy then 0.55 else 0
	end
end

-- Card for a species (no instance): used by the Index and odds lists.
function PetCard.Species(petId: string, discovered: boolean, size: Vector2?): Frame
	local s = size or Vector2.new(100, 118)
	local rarity = PetInfo.Rarity(petId)
	local rc = Theme.RarityColor(rarity)
	local card: Frame = Kit.new("Frame", {
		Name = petId,
		Size = UDim2.fromOffset(s.X, s.Y),
		BackgroundColor3 = if discovered then Theme.Lighten(rc, 0.55) else Theme.Colors.PanelDark,
		BorderSizePixel = 0,
	}, {
		Kit.corner(14),
		Kit.stroke(if discovered then Theme.Darken(rc, 0.25) else Theme.Colors.Locked, 3),
		Kit.shade(0.2),
	})
	Viewport.Pet(petId, "Normal", false, {
		Size = UDim2.new(1, -8, 1, -30),
		Position = UDim2.fromOffset(4, 4),
		Silhouette = not discovered,
		Parent = card,
	})
	Kit.fitLabel(if discovered then PetInfo.Name(petId) else "???", 16, {
		Size = UDim2.new(1, -8, 0, 24),
		Position = UDim2.new(0, 4, 1, -27),
		Outline = if discovered then Theme.Darken(rc, 0.5) else Theme.Colors.Stroke,
		ZIndex = 3,
		Parent = card,
	})
	return card
end

return PetCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">RewardText</string>
              <string name="Source"><![CDATA[--!strict
-- One-line description of a reward spec/result: "🪙 500  💎 10  ⚡ 2x Luck".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Theme = require("./Theme")
local Format = require("../Core/Format")

return function(r: { [string]: any }?): string
	if type(r) ~= "table" then
		return ""
	end
	local parts: { string } = {}
	if type(r.Coins) == "number" and r.Coins > 0 then
		table.insert(parts, Theme.Icons.Coins .. " " .. Format.num(r.Coins))
	end
	if type(r.Gems) == "number" and r.Gems > 0 then
		table.insert(parts, Theme.Icons.Gems .. " " .. Format.num(r.Gems))
	end
	if type(r.Boost) == "string" then
		local def = Config.Boosts[r.Boost]
		table.insert(parts, Theme.Icons.Boost .. " " .. (if def then def.Name else r.Boost))
	end
	if type(r.Equip) == "number" and r.Equip > 0 then
		table.insert(parts, Theme.Icons.Pets .. " +" .. r.Equip .. " equip")
	end
	if type(r.Storage) == "number" and r.Storage > 0 then
		table.insert(parts, "🎒 +" .. r.Storage .. " storage")
	end
	if type(r.Pets) == "table" and #r.Pets > 0 then
		table.insert(parts, Theme.Icons.Pets .. " " .. #r.Pets .. " pet" .. (if #r.Pets == 1 then "" else "s"))
	end
	return table.concat(parts, "   ")
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Pet Expedition look: bright, rounded, cheerful. Light cream panels, candy
-- coloured buttons with a darker rim, chunky rounded font with outlines.

local Theme = {}

local rgb = Color3.fromRGB

Theme.Colors = {
	Panel = rgb(250, 247, 240),
	PanelAlt = rgb(236, 242, 252),
	PanelDark = rgb(214, 224, 240),
	Header = rgb(88, 156, 255),
	HeaderDark = rgb(48, 104, 210),
	Stroke = rgb(44, 58, 96),
	Text = rgb(40, 46, 74),
	TextDim = rgb(110, 118, 146),
	TextLight = rgb(255, 255, 255),
	Backdrop = rgb(18, 22, 40),
	Coins = rgb(255, 205, 50),
	Gems = rgb(90, 220, 255),
	Good = rgb(76, 200, 90),
	Bad = rgb(240, 84, 84),
	Info = rgb(88, 156, 255),
	Warn = rgb(255, 176, 50),
	Luck = rgb(90, 220, 120),
	Locked = rgb(150, 156, 170),
}

-- Rarity colours (Config.Rarities order).
Theme.Rarity = {
	Common = rgb(170, 176, 186),
	Uncommon = rgb(88, 204, 92),
	Rare = rgb(64, 150, 255),
	Epic = rgb(170, 90, 255),
	Legendary = rgb(255, 196, 40),
	Mythic = rgb(255, 64, 110),
} :: { [string]: Color3 }

Theme.Variant = {
	Normal = rgb(255, 255, 255),
	Golden = rgb(255, 200, 40),
	Rainbow = rgb(255, 120, 200),
} :: { [string]: Color3 }

-- Button tones: Top (face colour) and Rim (outline / darker shade).
export type Tone = { Top: Color3, Rim: Color3, Text: Color3 }
Theme.Tones = {
	Green = { Top = rgb(90, 214, 96), Rim = rgb(36, 132, 48), Text = rgb(255, 255, 255) },
	Blue = { Top = rgb(80, 164, 255), Rim = rgb(32, 92, 196), Text = rgb(255, 255, 255) },
	Yellow = { Top = rgb(255, 204, 60), Rim = rgb(196, 128, 16), Text = rgb(255, 255, 255) },
	Red = { Top = rgb(255, 96, 96), Rim = rgb(176, 40, 52), Text = rgb(255, 255, 255) },
	Purple = { Top = rgb(176, 108, 255), Rim = rgb(100, 48, 186), Text = rgb(255, 255, 255) },
	Pink = { Top = rgb(255, 120, 190), Rim = rgb(186, 48, 120), Text = rgb(255, 255, 255) },
	Cyan = { Top = rgb(70, 214, 236), Rim = rgb(20, 128, 160), Text = rgb(255, 255, 255) },
	White = { Top = rgb(255, 255, 255), Rim = rgb(150, 164, 196), Text = rgb(40, 46, 74) },
	Grey = { Top = rgb(176, 182, 196), Rim = rgb(110, 116, 132), Text = rgb(255, 255, 255) },
} :: { [string]: Tone }

Theme.Font = Enum.Font.FredokaOne
Theme.FontBody = Enum.Font.GothamBold
Theme.FontLight = Enum.Font.GothamMedium

Theme.Corner = UDim.new(0, 14)
Theme.TouchMin = 60 -- reference px; with UIScale ~0.7 on phones this is ~42 pt

-- Reference canvas the UI is designed for; UIScale shrinks/grows from here.
Theme.RefWidth = 900
Theme.RefHeight = 560

Theme.Icons = {
	Coins = "🪙",
	Gems = "💎",
	Pets = "🐾",
	Shop = "🛒",
	Expeditions = "🧭",
	Quests = "📜",
	Index = "📖",
	Trade = "🤝",
	Settings = "⚙️",
	Islands = "🗺️",
	Rebirth = "🌀",
	Craft = "⚒️",
	Luck = "🍀",
	Lock = "🔒",
	Equipped = "✅",
	Shiny = "✨",
	Close = "✕",
	Star = "⭐",
	Gift = "🎁",
	Clock = "⏱️",
	Boost = "⚡",
	Egg = "🥚",
}

function Theme.RarityColor(rarity: string): Color3
	return Theme.Rarity[rarity] or Theme.Rarity.Common
end

-- Darker shade for strokes and gradients.
function Theme.Darken(c: Color3, amount: number?): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount or 0.35)
end

function Theme.Lighten(c: Color3, amount: number?): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount or 0.35)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Toast messages (stacked under the currency bar) and big centre banners.

local Theme = require("./Theme")
local Kit = require("./Kit")
local Windows = require("./Windows")
local Viewport = require("./Viewport")
local Sounds = require("../Core/Sounds")

local Toasts = {}

local TONES: { [string]: Color3 } = {
	good = Theme.Colors.Good,
	bad = Theme.Colors.Bad,
	info = Theme.Colors.Info,
	gold = Theme.Rarity.Legendary,
	luck = Theme.Colors.Luck,
	purple = Theme.Rarity.Epic,
}

local MAX = 4
local holder: Frame? = nil
local order = 0

local function getHolder(): Frame
	local h = holder
	if h then
		return h
	end
	local nh: Frame = Kit.box({
		Name = "Toasts",
		Size = UDim2.fromOffset(520, 400),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Parent = Windows.Gui("Toasts"),
	}, { Kit.list(Enum.FillDirection.Vertical, 8) })
	Kit.autoScale(nh, 1)
	holder = nh
	return nh
end

export type ToastOptions = {
	Icon: string?,
	PetId: string?,
	Variant: string?,
	Shiny: boolean?,
	Duration: number?,
	Silent: boolean?,
}

-- tone: good | bad | info | gold | luck | purple
function Toasts.Show(text: string, tone: string?, opts: ToastOptions?)
	local o: ToastOptions = opts or {}
	local color = TONES[tone or "info"] or Theme.Colors.Info
	local h = getHolder()
	-- drop the oldest when too many
	local items = {}
	for _, c in h:GetChildren() do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #items >= MAX do
		local first = table.remove(items, 1) :: Frame
		first:Destroy()
	end
	order += 1
	local hasPic = o.PetId ~= nil
	local f: Frame = Kit.panel({
		Name = "Toast",
		Size = UDim2.fromOffset(500, if hasPic then 70 else 54),
		BackgroundColor3 = Theme.Colors.Panel,
		StrokeColor = Theme.Darken(color, 0.25),
		Corner = 16,
		LayoutOrder = order,
		Parent = h,
	})
	Kit.new("Frame", {
		Size = UDim2.new(0, 10, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = f,
	}, { Kit.corner(5) })
	local x = 24
	if hasPic then
		Viewport.Pet(o.PetId :: string, o.Variant, o.Shiny, {
			Size = UDim2.fromOffset(62, 62),
			Position = UDim2.fromOffset(20, 4),
			Parent = f,
		})
		x = 88
	elseif o.Icon then
		Kit.fitLabel(o.Icon, 30, { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(22, 7), Parent = f })
		x = 66
	end
	Kit.fitLabel(text, 22, {
		Size = UDim2.new(1, -x - 12, 1, -8),
		Position = UDim2.fromOffset(x, 4),
		Align = "Left",
		Rich = true,
		Parent = f,
	})
	Kit.pop(f, 0.7)
	if not o.Silent then
		Sounds.Play(if tone == "bad" then "Error" else "Toast")
	end
	task.delay(o.Duration or 3.5, function()
		if f.Parent then
			local t = Kit.tween(f, 0.25, { BackgroundTransparency = 1 })
			for _, d in f:GetDescendants() do
				if d:IsA("TextLabel") then
					Kit.tween(d, 0.25, { TextTransparency = 1 })
				elseif d:IsA("UIStroke") then
					Kit.tween(d, 0.25, { Transparency = 1 })
				end
			end
			t.Completed:Wait()
			f:Destroy()
		end
	end)
end

-- Big banner across the middle-top of the screen.
function Toasts.Banner(title: string, subtitle: string?, color: Color3?, seconds: number?)
	local c = color or Theme.Colors.Header
	local gui = Windows.Gui("Toasts")
	local f: Frame = Kit.box({
		Name = "Banner",
		Size = UDim2.fromOffset(760, 120),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Parent = gui,
	})
	Kit.autoScale(f, 1)
	local t = Kit.fitLabel(title, 54, {
		Size = UDim2.new(1, 0, 0, 66),
		Outline = Theme.Darken(c, 0.5),
		Color = c,
		Parent = f,
	})
	local sub: TextLabel? = nil
	if subtitle then
		sub = Kit.fitLabel(subtitle, 26, {
			Size = UDim2.new(1, 0, 0, 36),
			Position = UDim2.fromOffset(0, 70),
			Outline = true,
			Parent = f,
		})
	end
	Kit.pop(f, 0.5)
	task.delay(seconds or 3, function()
		Kit.tween(t, 0.4, { TextTransparency = 1 })
		local ts = t:FindFirstChildOfClass("UIStroke")
		if ts then
			Kit.tween(ts, 0.4, { Transparency = 1 })
		end
		if sub then
			Kit.tween(sub, 0.4, { TextTransparency = 1 })
			local ss = sub:FindFirstChildOfClass("UIStroke")
			if ss then
				Kit.tween(ss, 0.4, { Transparency = 1 })
			end
		end
		task.wait(0.45)
		f:Destroy()
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Viewport</string>
              <string name="Source"><![CDATA[--!strict
-- ViewportFrame pictures of pets and eggs (clones of Models.*). Pets face -Z,
-- so the camera sits on the -Z side, slightly above and to the side.

local RunService = game:GetService("RunService")

local ModelCache = require("../Core/ModelCache")
local Kit = require("./Kit")

local Viewport = {}

export type Options = {
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Parent: any,
	ZIndex: number?,
	LayoutOrder: number?,
	Silhouette: boolean?,
	Spin: boolean?,
	Angle: number?, -- yaw in degrees (default 25: three-quarter view)
	Name: string?,
}

local spinning: { [ViewportFrame]: Model } = {}

-- Frames the camera on the model (call after the model changes size).
function Viewport.Frame(vp: ViewportFrame, model: Model, angle: number?)
	local cam = vp.CurrentCamera
	if not cam then
		local c = Instance.new("Camera")
		c.FieldOfView = 30
		c.Parent = vp
		vp.CurrentCamera = c
		cam = c
	end
	local camera = cam :: Camera
	local cf, size = model:GetBoundingBox()
	local radius = math.max(size.X, size.Y, size.Z) * 0.5
	local dist = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.08
	local yaw = math.rad(angle or 25)
	local dir = Vector3.new(math.sin(yaw), 0.32, -math.cos(yaw)).Unit
	local target = cf.Position
	camera.CFrame = CFrame.lookAt(target + dir * (dist + radius * 0.3), target)
end

local function make(model: Model, opts: Options?): ViewportFrame
	local o: Options = opts or {}
	local vp: ViewportFrame = Kit.new("ViewportFrame", {
		Name = o.Name or "Picture",
		BackgroundTransparency = 1,
		Size = o.Size or UDim2.fromScale(1, 1),
		Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero,
		ZIndex = o.ZIndex or 1,
		LayoutOrder = o.LayoutOrder or 0,
		Ambient = Color3.fromRGB(190, 190, 200),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.7),
	})
	if o.Silhouette then
		vp.ImageColor3 = Color3.fromRGB(30, 34, 52)
		vp.Ambient = Color3.new(0, 0, 0)
		vp.LightColor = Color3.new(0, 0, 0)
	end
	-- particles don't render in viewports; strip them to save memory
	for _, d in model:GetDescendants() do
		if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	model:PivotTo(CFrame.new())
	model.Parent = vp
	Viewport.Frame(vp, model, o.Angle)
	if o.Spin then
		spinning[vp] = model
		vp.Destroying:Connect(function()
			spinning[vp] = nil
		end)
	end
	if o.Parent then
		vp.Parent = o.Parent
	end
	return vp
end

function Viewport.Pet(petId: string, variant: string?, shiny: boolean?, opts: Options?): ViewportFrame
	return make(ModelCache.Pet(petId, variant or "Normal", shiny == true), opts)
end

function Viewport.Egg(eggId: string, opts: Options?): ViewportFrame
	return make(ModelCache.Egg(eggId), opts)
end

-- Gets the model inside a viewport made here.
function Viewport.ModelOf(vp: ViewportFrame): Model?
	return vp:FindFirstChildOfClass("Model")
end

RunService.RenderStepped:Connect(function(dt: number)
	for vp, model in spinning do
		if vp.Parent == nil then
			spinning[vp] = nil
		elseif vp.Visible then
			model:PivotTo(model:GetPivot() * CFrame.Angles(0, dt * 0.9, 0))
		end
	end
end)

return Viewport
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[--!strict
-- Screen layers, modal windows and a tiny router so controllers can open each
-- other's menus by name without requiring each other (Windows.Open("Shop", "Gems")).
-- One window is open at a time; opening another closes the current one.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Theme = require("./Theme")
local Kit = require("./Kit")
local Signal = require("../Core/Signal")
local Sounds = require("../Core/Sounds")

local Windows = {}

export type Window = {
	Name: string,
	Root: Frame,
	Body: Frame,
	Header: Frame,
	Title: TextLabel,
	Opened: Signal.Signal,
	Closed: Signal.Signal,
	IsOpen: boolean,
}

-- (name?) whenever the open window changes
Windows.Changed = Signal.new()
-- (name) when a Show was refused because a locked window is open
Windows.Refused = Signal.new()

local player = Players.LocalPlayer
local guis: { [string]: ScreenGui } = {}
local windows: { [string]: Window } = {}
local routes: { [string]: (...any) -> () } = {}
local current: Window? = nil
local backdrop: TextButton? = nil
local locked: string? = nil

local LAYERS = {
	Hud = 1,
	Windows = 5,
	Popups = 8,
	Overlay = 12,
	Toasts = 15,
}

-- ScreenGui for a layer, created on first use.
function Windows.Gui(layer: string): ScreenGui
	local g = guis[layer]
	if g then
		return g
	end
	local sg: ScreenGui = Kit.new("ScreenGui", {
		Name = "PE_" .. layer,
		ResetOnSpawn = false,
		DisplayOrder = LAYERS[layer] or 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = if layer == "Overlay" then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets,
		IgnoreGuiInset = layer == "Overlay",
		Parent = player:WaitForChild("PlayerGui"),
	})
	guis[layer] = sg
	return sg
end

local function getBackdrop(): TextButton
	local b = backdrop
	if b then
		return b
	end
	local nb: TextButton = Kit.new("TextButton", {
		Name = "Backdrop",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.Backdrop,
		BackgroundTransparency = 0.45,
		Size = UDim2.new(1, 0, 1, 200),
		Position = UDim2.fromOffset(0, -100),
		Visible = false,
		ZIndex = 0,
		Parent = Windows.Gui("Windows"),
	})
	nb.Activated:Connect(function()
		Windows.Close()
	end)
	backdrop = nb
	return nb
end

export type WindowOptions = {
	Title: string,
	Icon: string?,
	Color: Color3?,
	Size: Vector2?,
}

-- Creates a (hidden) window. Content goes into window.Body.
function Windows.Create(name: string, opts: WindowOptions): Window
	local size = opts.Size or Vector2.new(860, 540)
	local color = opts.Color or Theme.Colors.Header
	local root: Frame = Kit.panel({
		Name = name,
		Size = UDim2.fromOffset(size.X, size.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Visible = false,
		ZIndex = 2,
		StrokeThickness = 4,
		Corner = 20,
		Parent = Windows.Gui("Windows"),
	})
	Kit.autoScale(root, 1)
	-- swallow clicks so they don't fall through to the backdrop
	Kit.new("TextButton", {
		Name = "Blocker",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		AutoButtonColor = false,
		Parent = root,
	})
	local header: Frame = Kit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = root,
	}, {
		Kit.corner(20),
		Kit.gradient(Theme.Lighten(color, 0.15), Theme.Darken(color, 0.1)),
	})
	-- square off the header's bottom corners
	Kit.new("Frame", {
		Name = "Square",
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		BackgroundColor3 = Theme.Darken(color, 0.1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = header,
	})
	local title = Kit.fitLabel((opts.Icon and (opts.Icon .. "  ") or "") .. opts.Title, 34, {
		Name = "Title",
		Size = UDim2.new(1, -150, 1, -10),
		Position = UDim2.fromOffset(24, 5),
		Align = "Left",
		Outline = Theme.Darken(color, 0.45),
		ZIndex = 3,
		Parent = header,
	})
	local close = Kit.button(Theme.Icons.Close, "Red", {
		Name = "Close",
		Size = UDim2.fromOffset(56, 52),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		TextSize = 30,
		ZIndex = 4,
		Parent = header,
	}, function()
		Windows.Close()
	end)
	close:SetAttribute("Shortcut", "Close")
	local body: Frame = Kit.box({
		Name = "Body",
		Size = UDim2.new(1, -28, 1, -80),
		Position = UDim2.fromOffset(14, 70),
		ZIndex = 2,
		Parent = root,
	})
	local w: Window = {
		Name = name,
		Root = root,
		Body = body,
		Header = header,
		Title = title,
		Opened = Signal.new(),
		Closed = Signal.new(),
		IsOpen = false,
	}
	windows[name] = w
	return w
end

function Windows.Get(name: string): Window?
	return windows[name]
end

function Windows.CurrentName(): string?
	local c = current
	return if c then c.Name else nil
end

function Windows.IsOpen(name: string): boolean
	local c = current
	return c ~= nil and c.Name == name
end

-- Shows a created window (closing any other).
-- Locks the named window open (e.g. an active trade): backdrop taps, Esc and
-- Windows.Close() no longer close it, and other windows are refused until
-- Windows.Lock(nil). Only Windows.Close(true) closes it.
function Windows.Lock(name: string?)
	locked = name
end

function Windows.LockedName(): string?
	return locked
end

-- Shows a created window (closing any other). Returns false when refused.
function Windows.Show(name: string, ...: any): boolean
	local w = windows[name]
	if not w then
		return false
	end
	if locked and locked ~= name then
		Windows.Refused:Fire(name)
		return false
	end
	local c = current
	if c and c ~= w then
		Windows.Close()
	end
	local already = w.IsOpen
	current = w
	w.IsOpen = true
	getBackdrop().Visible = true
	w.Root.Visible = true
	if not already then
		Kit.pop(w.Root, 0.8)
		Sounds.Play("Open")
	end
	w.Opened:Fire(...)
	Windows.Changed:Fire(name)
	return true
end

-- Closes the open window. A locked window only closes with force = true.
function Windows.Close(force: boolean?)
	local c = current
	if not c then
		return
	end
	if locked == c.Name and not force then
		return
	end
	current = nil
	c.IsOpen = false
	c.Root.Visible = false
	getBackdrop().Visible = false
	c.Closed:Fire()
	Windows.Changed:Fire(nil)
end

function Windows.Toggle(name: string, ...: any)
	if Windows.IsOpen(name) then
		Windows.Close()
	else
		Windows.Open(name, ...)
	end
end

-- Router: controllers register how to open their menu (with arguments).
function Windows.Register(name: string, fn: (...any) -> ())
	routes[name] = fn
end

function Windows.Open(name: string, ...: any)
	local fn = routes[name]
	if fn then
		fn(...)
	else
		Windows.Show(name, ...)
	end
end

-- Popup confirm dialog (above windows).
function Windows.Confirm(title: string, text: string, yesText: string, tone: string?, onYes: () -> (), noText: string?)
	local gui = Windows.Gui("Popups")
	local shade: TextButton = Kit.new("TextButton", {
		Name = "Confirm",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.Backdrop,
		BackgroundTransparency = 0.4,
		Size = UDim2.new(1, 0, 1, 200),
		Position = UDim2.fromOffset(0, -100),
		Parent = gui,
	})
	local box: Frame = Kit.panel({
		Size = UDim2.fromOffset(460, 270),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Corner = 20,
		StrokeThickness = 4,
		Parent = shade,
	})
	Kit.autoScale(box, 1.05)
	Kit.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = box })
	Kit.fitLabel(title, 30, {
		Size = UDim2.new(1, -30, 0, 44),
		Position = UDim2.fromOffset(15, 12),
		Parent = box,
	})
	Kit.fitLabel(text, 20, {
		Size = UDim2.new(1, -40, 0, 110),
		Position = UDim2.fromOffset(20, 58),
		Font = Theme.FontBody,
		Color = Theme.Colors.TextDim,
		Rich = true,
		Parent = box,
	})
	local function close()
		shade:Destroy()
	end
	Kit.button(noText or "Cancel", "White", {
		Size = UDim2.fromOffset(190, 64),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 22, 1, -18),
		Parent = box,
	}, close)
	Kit.button(yesText, tone or "Green", {
		Size = UDim2.fromOffset(210, 64),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -22, 1, -18),
		Parent = box,
	}, function()
		close()
		onYes()
	end)
	shade.Activated:Connect(close)
	Kit.pop(box)
end

-- Escape closes the open window (PC).
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
		Windows.Close()
	end
end)

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="87">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>