      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Areas</string>
          <string name="Source"><![CDATA[--!strict
-- The six islands, in unlock order. The world builder lays them out along +X;
-- each one has a gate (except the first), an egg stand, a breakable field and
-- one expedition destination. CoinMult scales breakable and expedition coins;
-- PowerMult scales the power of pets that hatch here.

export type Breakable = { Kind: string, Weight: number, Hp: number, Coins: number, Gems: number? }
export type Area = {
	Id: string,
	Index: number,
	Name: string,
	GateCost: number, -- coins to open (0 = always open)
	CoinMult: number,
	PowerMult: number,
	Egg: string, -- Eggs id sold on this island
	ExpeditionPet: string, -- Pets id that can only be found on expeditions here
	MaxBreakables: number,
	Breakables: { Breakable },
	Blurb: string,
}

local Areas = {}

-- Breakable kinds are shared across areas; Hp and Coins are multiplied by the
-- area's CoinMult at spawn time. Gems are flat.
local field: { Breakable } = {
	{ Kind = "CoinPile", Weight = 62, Hp = 100, Coins = 12 },
	{ Kind = "Crate", Weight = 26, Hp = 300, Coins = 40 },
	{ Kind = "Chest", Weight = 10.5, Hp = 1000, Coins = 150 },
	{ Kind = "GemRock", Weight = 1.5, Hp = 750, Coins = 20, Gems = 1 },
	{ Kind = "BigChest", Weight = 1, Hp = 6000, Coins = 1200, Gems = 2 },
}

Areas.List = {
	{ Id = "Meadow", Index = 1, Name = "Sunny Meadow", GateCost = 0, CoinMult = 1, PowerMult = 1,
		Egg = "MeadowEgg", ExpeditionPet = "SunflowerSprite", MaxBreakables = 40, Breakables = field,
		Blurb = "Flowers, hay bales and the friendliest pets around." },
	{ Id = "Grove", Index = 2, Name = "Mushroom Grove", GateCost = 5000, CoinMult = 8, PowerMult = 6,
		Egg = "GroveEgg", ExpeditionPet = "FairyMoth", MaxBreakables = 40, Breakables = field,
		Blurb = "Glowing caps and sleepy forest critters." },
	{ Id = "Frost", Index = 3, Name = "Frostbite Peaks", GateCost = 120000, CoinMult = 64, PowerMult = 36,
		Egg = "FrostEgg", ExpeditionPet = "PolarKing", MaxBreakables = 40, Breakables = field,
		Blurb = "Snowy cliffs where the toughest fluff lives." },
	{ Id = "Coral", Index = 4, Name = "Coral Cove", GateCost = 2.7e6, CoinMult = 512, PowerMult = 216,
		Egg = "CoralEgg", ExpeditionPet = "PearlSeahorse", MaxBreakables = 40, Breakables = field,
		Blurb = "Warm sand, tide pools and sunken treasure." },
	{ Id = "Volcano", Index = 5, Name = "Ember Volcano", GateCost = 5.4e7, CoinMult = 4096, PowerMult = 1296,
		Egg = "VolcanoEgg", ExpeditionPet = "Phoenix", MaxBreakables = 40, Breakables = field,
		Blurb = "Lava rivers, hot rocks and fire-proof friends." },
	{ Id = "Starfall", Index = 6, Name = "Starfall Isles", GateCost = 1.1e9, CoinMult = 32768, PowerMult = 7776,
		Egg = "StarEgg", ExpeditionPet = "VoidKraken", MaxBreakables = 40, Breakables = field,
		Blurb = "Floating islands at the edge of space." },
} :: { Area }

Areas.ById = {} :: { [string]: Area }
for _, a in Areas.List do
	Areas.ById[a.Id] = a
end

return Areas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Tuning numbers for Pet Expedition. Everything a designer might tweak lives
-- here; pure rules in Logic/ read these values instead of hard-coding them.

export type RewardSpec = { Coins: number?, Gems: number?, Boost: string?, Equip: number?, Storage: number?, Minutes: number?, Fraction: number? }

local Config = {}

Config.Version = 1 -- profile schema version (Logic/Profile migrates older saves)

-- Rarities, weakest first. Order matters (index used for sorting / colours).
Config.Rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

Config.RarityPower = {
	Common = 1,
	Uncommon = 1.6,
	Rare = 2.6,
	Epic = 4.5,
	Legendary = 8,
	Mythic = 15,
} :: { [string]: number }

-- Rarity colours live in client UI/Theme.luau (Config must stay Roblox-type free for CLI tests).

-- Pet variants. Power multiplier; crafting N of the previous variant makes one.
Config.Variants = { "Normal", "Golden", "Rainbow" }
Config.VariantPower = { Normal = 1, Golden = 2.5, Rainbow = 6 } :: { [string]: number }
Config.CraftCost = 5 -- pets of the same species+variant consumed per craft
Config.CraftSuccess = { Golden = 1, Rainbow = 1 } :: { [string]: number } -- always succeeds (no gambling)
Config.ShinyChance = 1 / 150 -- rolled on every hatch / expedition find
Config.ShinyPower = 1.5

-- Pet levels: pets earn XP while breaking things.
Config.PetMaxLevel = 25
Config.PetLevelPower = 0.03 -- +3% power per level above 1
Config.PetXpForLevel = function(level: number): number
	return math.floor(20 * level ^ 1.6)
end

-- Inventory
Config.BaseEquip = 3
Config.BaseStorage = 60
Config.MaxEquipCap = 12 -- hard cap after every bonus
Config.DeleteRefund = 0.1 -- coins refunded = power * area coin mult * this (min 1)

-- Hatching
Config.HatchCooldown = 0.9 -- seconds between hatch requests (server-enforced)
Config.HatchAnimSeconds = 3.2
Config.FastHatchAnimSeconds = 1.2
Config.LuckyPassMult = 1.5 -- weight multiplier for Rare and above
Config.LuckBoostMult = 2 -- 2x Luck boost weight multiplier for Rare and above
Config.ServerLuckMult = 2 -- server-wide luck boost (stacks multiplicatively, capped)
Config.MaxLuckMult = 6

-- Breakables / farming
Config.PetDamageInterval = 0.5 -- seconds between pet damage ticks
Config.PetDamagePerPower = 10 -- damage per tick = power * this
Config.MaxTargetDistance = 90 -- studs from player to the breakable they target
Config.BreakableRespawn = { 6, 14 } -- seconds (random in range)
Config.XpPerBreak = 4
Config.BreakGemsPerHour = 15 -- per-player cap on gems from breakables (rolling hour)

-- Coins
Config.VipCoinMult = 1.2
Config.CoinBoostMult = 2
Config.PremiumCoinMult = 1.1
Config.RebirthCoinBonus = 1 -- +100% coins per rebirth (additive)

-- Rebirth: resets coins and opened gates; keeps pets, gems, passes.
Config.RebirthBaseCost = 6e9
Config.RebirthCostGrowth = 2
Config.RebirthGems = 150
Config.MaxRebirths = 16 -- cost passes the coin cap (1e15) after this

-- Expeditions
Config.BaseExpeditionSlots = 1
Config.MaxPetsPerExpedition = 3
Config.ExpeditionDurations = {
	{ Key = "Short", Seconds = 5 * 60, Mult = 1, FindChance = 0.04, GemChance = 0.05 },
	{ Key = "Medium", Seconds = 30 * 60, Mult = 5, FindChance = 0.12, GemChance = 0.25 },
	{ Key = "Long", Seconds = 2 * 3600, Mult = 16, FindChance = 0.3, GemChance = 0.5 },
	{ Key = "Epic", Seconds = 8 * 3600, Mult = 50, FindChance = 0.65, GemChance = 1 },
}
Config.ExpeditionCoinsPerPower = 75 -- coins = sum(min(power / area PowerMult, ExpeditionMaxRelPower)) * this * area coin mult * duration mult
Config.ExpeditionMaxRelPower = 12 -- caps strong pets sent to cheap islands
Config.ExpeditionEggChance = 0.35 -- chance (scaled by duration mult, capped at 1) to bring back a free egg
Config.ExpeditionGems = { 3, 15 } -- gem range when GemChance hits (scaled by sqrt(duration mult))
Config.ExpeditionSkipGemsPerMinute = 2 -- gems to finish early (min 5)
Config.FastExpeditionMult = 0.75 -- duration multiplier with the Swift Expeditions perk (not sold; reserved)

-- Daily, playtime, quests
Config.DailyRewards = { -- streak day -> reward (loops after the last day)
	{ Coins = 500, Gems = 10 },
	{ Coins = 1500, Gems = 15 },
	{ Coins = 4000, Gems = 25 },
	{ Coins = 10000, Gems = 35 },
	{ Coins = 25000, Gems = 50 },
	{ Coins = 60000, Gems = 75 },
	{ Coins = 150000, Gems = 150, Boost = "Luck2x" },
} :: { RewardSpec }
Config.PlaytimeGifts = { -- minutes played today (UTC day) -> reward, each once per day
	{ Minutes = 3, Coins = 300 },
	{ Minutes = 8, Gems = 5 },
	{ Minutes = 15, Coins = 2500 },
	{ Minutes = 25, Gems = 15 },
	{ Minutes = 40, Boost = "Coins2x" },
	{ Minutes = 60, Gems = 25 },
} :: { RewardSpec }
Config.QuestsPerDay = 3
Config.QuestPool = {
	{ Kind = "Break", Goals = { 150, 300, 600 }, Gems = { 15, 25, 40 } },
	{ Kind = "Hatch", Goals = { 20, 50, 100 }, Gems = { 15, 25, 40 } },
	{ Kind = "Expedition", Goals = { 2, 4, 8 }, Gems = { 15, 25, 40 } },
	{ Kind = "Coins", Goals = { 5000, 12000, 25000 } --[[ x CoinMult of highest opened area ]], Gems = { 15, 25, 40 } },
	{ Kind = "Craft", Goals = { 1, 2, 4 }, Gems = { 20, 35, 55 } },
}
Config.IndexRewards = { -- fraction of species discovered -> reward
	{ Fraction = 0.25, Gems = 50, Equip = 1 },
	{ Fraction = 0.5, Gems = 100, Equip = 1 },
	{ Fraction = 0.75, Gems = 200, Storage = 50 },
	{ Fraction = 1, Gems = 500, Equip = 1 },
} :: { RewardSpec }

-- Boost durations (seconds), stack by extending.
Config.Boosts = {
	Coins2x = { Seconds = 30 * 60, Name = "2x Coins" },
	Luck2x = { Seconds = 30 * 60, Name = "2x Luck" },
	Xp2x = { Seconds = 30 * 60, Name = "2x Pet XP" },
} :: { [string]: { Seconds: number, Name: string } }
Config.ServerLuckSeconds = 15 * 60
Config.MaxBoostSeconds = 24 * 3600

-- Trading
Config.TradeMaxPets = 8
Config.TradeMaxGems = 0 -- pets only (stops alt gem funnelling and real-money gem sales)
Config.TradeConfirmSeconds = 4 -- countdown after both ready; any change cancels it
Config.TradeRequestTimeout = 20
Config.TradeMinAccountAgeDays = 7
Config.TradeCooldown = 10 -- seconds between trade requests from one player

-- Pet Ring (walk-in free-for-all in the Meadow hub; see docs/CONTRACTS.md "Pet Ring").
-- Ring strength = RarityFactor * VariantFactor * ShinyFactor (capped at MaxGearFactor)
--                 * (1 + LevelBonus * (level - 1)).
-- Island power multipliers are ignored here, so levels (time spent) matter most and paid
-- advantages (rarer pets, XP boosts, an extra fighter) help but never exceed ~2x.
Config.Ring = {
	TickSeconds = 0.2, -- server simulation step
	ReplicateSeconds = 0.1, -- fighter attribute updates
	Fighters = 3, -- pets that fight for you (your strongest equipped)
	PassFighters = 1, -- extra fighter with the RingChampion pass
	MoveSpeed = 18, -- studs per second
	AttackRange = 4.5,
	AttackInterval = 0.9,
	BaseHp = 100,
	BaseDamage = 11,
	CritChance = 0.1,
	CritMult = 1.75,
	LevelBonus = 0.06, -- +6% strength per level above 1 (level 25 = 2.44x)
	RarityFactor = { Common = 1, Uncommon = 1.12, Rare = 1.25, Epic = 1.4, Legendary = 1.6, Mythic = 1.8 } :: { [string]: number },
	VariantFactor = { Normal = 1, Golden = 1.1, Rainbow = 1.2 } :: { [string]: number },
	ShinyFactor = 1.05,
	MaxGearFactor = 2, -- cap on rarity * variant * shiny
	EnterGraceSeconds = 2, -- new arrivals can't be hit for this long
	KoTrophies = 1,
	KoCoins = 40, -- x CoinMult of the winner's highest opened island
	XpPerHit = 2,
	XpPerKo = 30,
	SameVictimLimit = 3, -- KO rewards per victim player per window (stops alt farming)
	SameVictimWindow = 600,
	KingMinStreak = 3, -- KOs in a row needed before you can wear the crown
	-- Wild challengers keep the ring fun when you're alone in it.
	WildWhenAlone = true,
	WildDelay = 3, -- seconds alone before a wild pet jumps in
	WildStrength = 0.9, -- relative to the player's average fighter
	WildCoins = 0.25, -- fraction of KoCoins for beating a wild pet; no trophies
}

-- Saving
Config.AutosaveSeconds = 90
Config.SessionLockSeconds = 300 -- a lock older than this is treated as dead
Config.DataStoreName = "PetExpedition_v1"

-- Group bonus (set GroupId to the owner's group to enable; 0 = off)
Config.GroupId = 0
Config.GroupCoinMult = 1.05

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Eggs</string>
          <string name="Source"><![CDATA[--!strict
-- Eggs and their odds. Weights are percentages and each egg sums to 100.
-- Odds are always shown to players before they hatch (Roblox rule for paid
-- random items, and fair anyway). Luck multiplies the weight of Rare and
-- above (Logic/Hatch renormalises).

export type Odds = { Pet: string, Weight: number }
export type Egg = {
	Id: string,
	Name: string,
	Area: string,
	Currency: string, -- "Coins" | "Gems"
	Cost: number,
	Odds: { Odds },
}

local Eggs = {}

Eggs.List = {
	{ Id = "MeadowEgg", Name = "Meadow Egg", Area = "Meadow", Currency = "Coins", Cost = 100, Odds = {
		{ Pet = "Puppy", Weight = 55 }, { Pet = "Kitten", Weight = 30 }, { Pet = "Bunny", Weight = 12 },
		{ Pet = "Fox", Weight = 2.7 }, { Pet = "HoneyBear", Weight = 0.3 },
	} },
	{ Id = "GroveEgg", Name = "Grove Egg", Area = "Grove", Currency = "Coins", Cost = 3600, Odds = {
		{ Pet = "Toadstool", Weight = 55 }, { Pet = "Snail", Weight = 30 }, { Pet = "Frog", Weight = 12 },
		{ Pet = "Owl", Weight = 2.7 }, { Pet = "GlowcapDragon", Weight = 0.3 },
	} },
	{ Id = "FrostEgg", Name = "Frost Egg", Area = "Frost", Currency = "Coins", Cost = 72000, Odds = {
		{ Pet = "Penguin", Weight = 55 }, { Pet = "SnowBunny", Weight = 30 }, { Pet = "ArcticFox", Weight = 12 },
		{ Pet = "Yeti", Weight = 2.7 }, { Pet = "AuroraWolf", Weight = 0.3 },
	} },
	{ Id = "CoralEgg", Name = "Coral Egg", Area = "Coral", Currency = "Coins", Cost = 1.5e6, Odds = {
		{ Pet = "Crab", Weight = 55 }, { Pet = "Turtle", Weight = 30 }, { Pet = "Pufferfish", Weight = 12 },
		{ Pet = "Octopus", Weight = 2.7 }, { Pet = "Narwhal", Weight = 0.3 },
	} },
	{ Id = "VolcanoEgg", Name = "Volcano Egg", Area = "Volcano", Currency = "Coins", Cost = 3e7, Odds = {
		{ Pet = "LavaSlime", Weight = 55 }, { Pet = "Salamander", Weight = 30 }, { Pet = "EmberBat", Weight = 12 },
		{ Pet = "LavaGolem", Weight = 2.7 }, { Pet = "InfernoDragon", Weight = 0.3 },
	} },
	{ Id = "StarEgg", Name = "Star Egg", Area = "Starfall", Currency = "Coins", Cost = 5.4e8, Odds = {
		{ Pet = "CometCat", Weight = 55 }, { Pet = "MoonBunny", Weight = 30 }, { Pet = "NebulaFox", Weight = 12 },
		{ Pet = "GalaxyAxolotl", Weight = 2.65 }, { Pet = "CelestialDragon", Weight = 0.3 }, { Pet = "CosmicUnicorn", Weight = 0.05 },
	} },
	-- Premium egg: bought with gems (earnable in play or bought with Robux).
	-- Hidden for players whose PolicyService says paid random items are restricted.
	{ Id = "PrismEgg", Name = "Prism Egg", Area = "Meadow", Currency = "Gems", Cost = 400, Odds = {
		{ Pet = "CrystalPup", Weight = 62 }, { Pet = "PrismFox", Weight = 30 },
		{ Pet = "RainbowUnicorn", Weight = 7 }, { Pet = "DiamondDragon", Weight = 1 },
	} },
} :: { Egg }

Eggs.ById = {} :: { [string]: Egg }
for _, e in Eggs.List do
	Eggs.ById[e.Id] = e
end

return Eggs
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Currency, multipliers, boosts and capacity rules. Every coin or gem change
-- goes through AddCoins / SpendCoins / AddGems / SpendGems so balances stay
-- finite, whole and inside the hard caps.

local Config = require("../Config")
local Areas = require("../Areas")
local Schema = require("./Schema")

type Profile = Schema.Profile

export type MultContext = {
	Now: number,
	Premium: boolean?,
	InGroup: boolean?,
	ServerLuckUntil: number?,
	-- PolicyService restricts paid random items for this player: luck from the
	-- Lucky pass, luck boosts and server luck doesn't apply to them.
	NoPaidLuck: boolean?,
}

local Economy = {}

function Economy.HasPass(p: Profile, key: string): boolean
	return p.Passes[key] == true
end

function Economy.BoostActive(p: Profile, key: string, now: number): boolean
	local expires = p.Boosts[key]
	return type(expires) == "number" and expires > now
end

function Economy.CoinMult(p: Profile, c: MultContext): number
	local mult = 1 + Config.RebirthCoinBonus * math.max(0, p.Rebirths)
	if Economy.HasPass(p, "VIP") then
		mult *= Config.VipCoinMult
	end
	if Economy.BoostActive(p, "Coins2x", c.Now) then
		mult *= Config.CoinBoostMult
	end
	if c.Premium then
		mult *= Config.PremiumCoinMult
	end
	if c.InGroup and Config.GroupId ~= 0 then
		mult *= Config.GroupCoinMult
	end
	return mult
end

function Economy.LuckMult(p: Profile, c: MultContext): number
	if c.NoPaidLuck then
		return 1
	end
	local mult = 1
	if Economy.HasPass(p, "Lucky") then
		mult *= Config.LuckyPassMult
	end
	if Economy.BoostActive(p, "Luck2x", c.Now) then
		mult *= Config.LuckBoostMult
	end
	local serverUntil = c.ServerLuckUntil
	if serverUntil and serverUntil > c.Now then
		mult *= Config.ServerLuckMult
	end
	return math.min(mult, Config.MaxLuckMult)
end

function Economy.MaxEquip(p: Profile): number
	local n = Config.BaseEquip + math.max(0, p.ExtraEquip)
	if Economy.HasPass(p, "MoreEquip") then
		n += 3
	end
	return math.min(n, Config.MaxEquipCap)
end

function Economy.MaxStorage(p: Profile): number
	local n = Config.BaseStorage + math.max(0, p.ExtraStorage)
	if Economy.HasPass(p, "BigBackpack") then
		n += 150
	end
	return n
end

function Economy.ExpeditionSlots(p: Profile): number
	local n = Config.BaseExpeditionSlots
	if Economy.HasPass(p, "MoreExpeditions") then
		n += 2
	end
	return n
end

function Economy.RebirthCost(rebirths: number): number
	return Config.RebirthBaseCost * Config.RebirthCostGrowth ^ math.max(0, rebirths)
end

-- Adds coins (rounded down, capped). Returns the amount actually added.
-- `earned` counts the coins toward Stats.CoinsEarned (gameplay income).
function Economy.AddCoins(p: Profile, amount: number, earned: boolean?): number
	if not Schema.IsFinite(amount) or amount <= 0 then
		return 0
	end
	local before = p.Coins
	p.Coins = math.min(Schema.MaxCoins, math.floor(before + amount))
	local added = p.Coins - before
	if earned and added > 0 then
		p.Stats.CoinsEarned = math.min(Schema.MaxStat, p.Stats.CoinsEarned + added)
	end
	return added
end

function Economy.CanAfford(p: Profile, currency: string, amount: number): boolean
	if not Schema.IsFinite(amount) or amount < 0 then
		return false
	end
	if currency == "Coins" then
		return p.Coins >= amount
	elseif currency == "Gems" then
		return p.Gems >= amount
	end
	return false
end

-- Removes currency if the player can afford it. Returns success.
function Economy.Spend(p: Profile, currency: string, amount: number): boolean
	if not Economy.CanAfford(p, currency, amount) then
		return false
	end
	amount = math.ceil(amount)
	if currency == "Coins" then
		p.Coins = math.max(0, p.Coins - amount)
	else
		p.Gems = math.max(0, p.Gems - amount)
	end
	return true
end

function Economy.AddGems(p: Profile, amount: number): number
	if not Schema.IsFinite(amount) or amount <= 0 then
		return 0
	end
	local before = p.Gems
	p.Gems = math.min(Schema.MaxGems, math.floor(before + amount))
	return p.Gems - before
end

-- Starts or extends a personal boost. Stacks by extending, capped at
-- Config.MaxBoostSeconds from now. Returns the new expiry (0 if unknown key).
function Economy.ApplyBoost(p: Profile, key: string, now: number): number
	local def = Config.Boosts[key]
	if not def then
		return 0
	end
	local current = p.Boosts[key]
	local from = if type(current) == "number" and current > now then current else now
	local expires = math.min(from + def.Seconds, now + Config.MaxBoostSeconds)
	p.Boosts[key] = expires
	return expires
end

-- Removes expired boosts. Returns true if anything was removed.
function Economy.PruneBoosts(p: Profile, now: number): boolean
	local changed = false
	for key, expires in p.Boosts do
		if type(expires) ~= "number" or expires <= now then
			p.Boosts[key] = nil
			changed = true
		end
	end
	return changed
end

-- Server-wide luck: returns the new expiry after one more purchase.
function Economy.ExtendServerLuck(currentUntil: number, now: number): number
	local from = if currentUntil > now then currentUntil else now
	return math.min(from + Config.ServerLuckSeconds, now + Config.MaxBoostSeconds)
end

export type Share = { Coins: number, Gems: number, Credit: boolean }

Economy.MinCreditShare = 0.05 -- damage share needed for credit (quests, XP, min 1 coin)

-- Splits a broken breakable's loot by damage dealt. `damage` is a list (one
-- entry per contributor). Coins are returned unrounded (the caller applies
-- each player's coin multiplier, then rounds). Gems use a largest-remainder
-- split, so they always add up to exactly `gems` and never more. Contributors
-- with at least MinCreditShare of the damage get Credit (and >= 1 coin).
function Economy.SplitBreak(damage: { number }, coins: number, gems: number): { Share }
	local out: { Share } = {}
	local total = 0
	for _, d in damage do
		if Schema.IsFinite(d) and d > 0 then
			total += d
		end
	end
	local gemTotal = if Schema.IsFinite(gems) and gems > 0 then math.floor(gems) else 0
	local coinTotal = if Schema.IsFinite(coins) and coins > 0 then coins else 0
	local rema: { { I: number, R: number, D: number } } = {}
	local given = 0
	for i, d in damage do
		local dmg = if Schema.IsFinite(d) and d > 0 then d else 0
		local share = if total > 0 then dmg / total else 0
		local credit = share >= Economy.MinCreditShare
		local c = coinTotal * share
		if credit then
			c = math.max(1, c)
		end
		local exact = gemTotal * share
		local g = math.floor(exact)
		given += g
		out[i] = { Coins = c, Gems = g, Credit = credit }
		table.insert(rema, { I = i, R = exact - g, D = dmg })
	end
	table.sort(rema, function(a, b)
		if a.R ~= b.R then
			return a.R > b.R
		end
		if a.D ~= b.D then
			return a.D > b.D
		end
		return a.I < b.I
	end)
	local left = gemTotal - given
	for _, r in rema do
		if left <= 0 or total <= 0 then
			break
		end
		if r.D > 0 then
			out[r.I].Gems += 1
			left -= 1
		end
	end
	return out
end

export type CapEntry = { At: number, N: number }

-- Rolling-window cap (e.g. Config.BreakGemsPerHour). `log` holds what was
-- granted recently and is updated in place. Returns how much of `amount` may
-- be granted now (0..amount).
function Economy.CapRolling(log: { CapEntry }, now: number, amount: number, cap: number, window: number): number
	local i = 1
	while i <= #log do
		if now - log[i].At >= window then
			table.remove(log, i)
		else
			i += 1
		end
	end
	if not Schema.IsFinite(amount) or amount <= 0 then
		return 0
	end
	local used = 0
	for _, e in log do
		used += e.N
	end
	local allowed = math.max(0, math.min(math.floor(amount), math.floor(cap) - used))
	if allowed > 0 then
		table.insert(log, { At = now, N = allowed })
	end
	return allowed
end

-- Opens the next island's gate. Islands open in order.
function Economy.OpenGate(p: Profile, areaId: string): (boolean, string?)
	local area = Areas.ById[areaId]
	if not area then
		return false, "Unknown island"
	end
	if p.Areas[areaId] then
		return false, "Already open"
	end
	local prev = Areas.List[area.Index - 1]
	if prev and not p.Areas[prev.Id] then
		return false, "Open " .. prev.Name .. " first"
	end
	if not Economy.Spend(p, "Coins", area.GateCost) then
		return false, "Not enough coins"
	end
	p.Areas[areaId] = true
	return true, nil
end

-- Rebirth: costs coins, resets coins and gates, keeps pets / gems / passes,
-- grants gems and a permanent coin bonus.
function Economy.Rebirth(p: Profile): (boolean, string?)
	if p.Rebirths >= Config.MaxRebirths then
		return false, "Maximum rebirths reached"
	end
	local cost = Economy.RebirthCost(p.Rebirths)
	if p.Coins < cost then
		return false, "Not enough coins"
	end
	p.Coins = 0
	p.Areas = { [Schema.StartArea] = true }
	p.Rebirths += 1
	Economy.AddGems(p, Config.RebirthGems)
	return true, nil
end

-- Highest opened island (by unlock order).
function Economy.HighestArea(p: Profile): string
	local best = Schema.StartArea
	for _, a in Areas.List do
		if p.Areas[a.Id] then
			best = a.Id
		end
	end
	return best
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Expedition</string>
            <string name="Source"><![CDATA[--!strict
-- Expeditions: send up to Config.MaxPetsPerExpedition pets to an opened
-- island for a fixed time. The reward is computed only from the expedition's
-- Seed (fixed at start), its pets' power, the duration and the area, so it
-- can't be re-rolled by claiming again or by rejoining.

local Config = require("../Config")
local Areas = require("../Areas")
local Eggs = require("../Eggs")
local Economy = require("./Economy")
local Hatch = require("./Hatch")
local Inventory = require("./Inventory")
local PetMath = require("./PetMath")
local Rng = require("./Rng")
local Schema = require("./Schema")

type Profile = Schema.Profile
type Expedition = Schema.Expedition
type PetInstance = Schema.PetInstance

export type Duration = { Key: string, Seconds: number, Mult: number, FindChance: number, GemChance: number }
export type RewardRoll = { Coins: number, Gems: number, Pets: { Inventory.PetSpec } }

local Expedition = {}

function Expedition.Duration(key: string): Duration?
	for _, d in Config.ExpeditionDurations do
		if d.Key == key then
			return d
		end
	end
	return nil
end

-- First free slot key ("1", "2", ...) or nil.
function Expedition.FreeSlot(p: Profile): string?
	for i = 1, Economy.ExpeditionSlots(p) do
		local key = tostring(i)
		if p.Expeditions[key] == nil then
			return key
		end
	end
	return nil
end

-- Starts an expedition in the first free slot. Pets are unequipped. Returns
-- the slot key and the expedition, or nil and a reason.
function Expedition.Start(
	p: Profile,
	areaId: string,
	durationKey: string,
	uids: { string },
	now: number,
	seed: number,
	blocked: { [string]: boolean }?,
	coinMult: number?
): (string?, Expedition?, string?)
	local area = Areas.ById[areaId]
	if not area then
		return nil, nil, "Unknown island"
	end
	if not p.Areas[areaId] then
		return nil, nil, "Open that island first"
	end
	local dur = Expedition.Duration(durationKey)
	if not dur then
		return nil, nil, "Unknown duration"
	end
	if type(uids) ~= "table" or #uids < 1 then
		return nil, nil, "Choose at least one pet"
	end
	if #uids > Config.MaxPetsPerExpedition then
		return nil, nil, string.format("At most %d pets per expedition", Config.MaxPetsPerExpedition)
	end
	local slot = Expedition.FreeSlot(p)
	if not slot then
		return nil, nil, "All expedition slots are busy"
	end
	local busy = Inventory.BusySet(p)
	local seen: { [string]: boolean } = {}
	for _, uid in uids do
		if seen[uid] then
			return nil, nil, "Same pet chosen twice"
		end
		seen[uid] = true
		if not Inventory.Find(p, uid) then
			return nil, nil, "You don't have that pet"
		end
		if busy[uid] then
			return nil, nil, "That pet is already on an expedition"
		end
		if blocked and blocked[uid] then
			return nil, nil, "That pet is in a trade"
		end
	end
	local list: { string } = table.clone(uids)
	for _, uid in list do
		local idx = table.find(p.Equipped, uid)
		if idx then
			table.remove(p.Equipped, idx)
		end
	end
	local exp: Expedition = {
		Area = areaId,
		Duration = dur.Key,
		Pets = list,
		StartAt = now,
		EndAt = now + dur.Seconds,
		Seed = Rng.New(seed).State,
	}
	p.Expeditions[slot] = exp
	-- The coin multiplier is fixed at start, so buying a boost or VIP just
	-- before claiming doesn't multiply hours of expedition income.
	local mult = coinMult or 1
	p.ExpeditionMult[slot] = if Schema.IsFinite(mult) and mult > 0 then math.min(mult, Schema.MaxCoinMult) else 1
	return slot, exp, nil
end

-- Sum over the expedition's pets of min(power / destination PowerMult,
-- Config.ExpeditionMaxRelPower).
function Expedition.RelativePower(p: Profile, exp: Expedition): number
	local area = Areas.ById[exp.Area]
	if not area then
		return 0
	end
	local scale = Economy.HighestArea(p)
	local total = 0
	for _, uid in exp.Pets do
		local pet = Inventory.Find(p, uid)
		if pet then
			total += math.min(PetMath.Power(pet, scale) / area.PowerMult, Config.ExpeditionMaxRelPower)
		end
	end
	return total
end

-- The deterministic base reward (coins before the player's coin multiplier).
function Expedition.RollReward(p: Profile, exp: Expedition): RewardRoll
	local roll: RewardRoll = { Coins = 0, Gems = 0, Pets = {} }
	local area = Areas.ById[exp.Area]
	local dur = Expedition.Duration(exp.Duration)
	if not area or not dur then
		return roll
	end
	-- Each pet counts with its power relative to the destination island
	-- (pet power already includes its own island's PowerMult), capped so a
	-- very strong pet sent to a cheap island can't farm it.
	local rel = Expedition.RelativePower(p, exp)
	local rng = Rng.New(exp.Seed)
	roll.Coins = math.floor(rel * Config.ExpeditionCoinsPerPower * area.CoinMult * dur.Mult)
	-- The same number of random draws happens whatever the outcomes, so a
	-- reward never depends on anything but the inputs above.
	local gemHit = rng:Chance(dur.GemChance)
	local gemRoll = rng:Next()
	local eggHit = rng:Chance(math.min(1, Config.ExpeditionEggChance * dur.Mult))
	local findHit = rng:Chance(dur.FindChance)
	local findShiny = rng:Next() < Config.ShinyChance
	local lo, hi = Config.ExpeditionGems[1], Config.ExpeditionGems[2]
	if gemHit then
		local base = lo + math.floor(gemRoll * (hi - lo + 1))
		roll.Gems = math.floor(math.min(base, hi) * math.sqrt(dur.Mult))
	end
	if eggHit then
		local egg = Eggs.ById[area.Egg]
		if egg then
			local id, shiny = Hatch.Roll(egg, 1, rng)
			table.insert(roll.Pets, { Id = id, Shiny = shiny })
		end
	end
	if findHit then
		table.insert(roll.Pets, { Id = area.ExpeditionPet, Shiny = findShiny })
	end
	return roll
end

export type Claimed = {
	Coins: number,
	Gems: number,
	Pets: { PetInstance },
	Discovered: { string },
}

-- Claims a finished expedition: frees its pets and grants the reward.
-- Refuses (and changes nothing) if the found pets would not fit. Coins use the
-- multiplier snapshotted at Start; `fallbackMult` is only for expeditions
-- saved before snapshots existed.
function Expedition.Claim(p: Profile, slot: string, now: number, fallbackMult: number?): (Claimed?, string?)
	local exp = p.Expeditions[slot]
	if not exp then
		return nil, "No expedition in that slot"
	end
	if now < exp.EndAt then
		return nil, "Your pets aren't back yet"
	end
	local roll = Expedition.RollReward(p, exp)
	if #roll.Pets > Inventory.FreeSpace(p) then
		return nil, string.format("Make room for %d pet(s) first", #roll.Pets)
	end
	p.Expeditions[slot] = nil
	local snap = p.ExpeditionMult[slot]
	p.ExpeditionMult[slot] = nil
	local m = snap or fallbackMult or 1
	local mult = if Schema.IsFinite(m) and m > 0 then math.min(m, Schema.MaxCoinMult) else 1
	local out: Claimed = { Coins = 0, Gems = 0, Pets = {}, Discovered = {} }
	out.Coins = Economy.AddCoins(p, roll.Coins * mult, true)
	out.Gems = Economy.AddGems(p, roll.Gems)
	for _, spec in roll.Pets do
		local pet, discovered = Inventory.Add(p, spec)
		if pet then
			table.insert(out.Pets, pet)
			if discovered then
				table.insert(out.Discovered, pet.Id)
			end
		end
	end
	p.Stats.Expeditions = math.min(Schema.MaxStat, p.Stats.Expeditions + 1)
	return out, nil
end

-- Gems needed to finish now (0 when already finished).
function Expedition.SkipCost(exp: Expedition, now: number): number
	local left = exp.EndAt - now
	if left <= 0 then
		return 0
	end
	return math.max(5, math.ceil(left / 60 * Config.ExpeditionSkipGemsPerMinute))
end

function Expedition.Skip(p: Profile, slot: string, now: number): (number?, string?)
	local exp = p.Expeditions[slot]
	if not exp then
		return nil, "No expedition in that slot"
	end
	local cost = Expedition.SkipCost(exp, now)
	if cost <= 0 then
		return nil, "Already finished"
	end
	if not Economy.Spend(p, "Gems", cost) then
		return nil, string.format("You need %d gems", cost)
	end
	exp.EndAt = now
	return cost, nil
end

return Expedition
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Hatch</string>
            <string name="Source"><![CDATA[--!strict
-- Egg rolls. Luck multiplies the weight of every pet rarer than the egg's
-- lowest rarity (so it also works on the Prism Egg, whose lowest is Rare);
-- the weights are then renormalised (the roll picks against their new
-- total). Luck is clamped to [1, Config.MaxLuckMult].

local Config = require("../Config")
local Pets = require("../Pets")
local Eggs = require("../Eggs")
local PetMath = require("./PetMath")
local Schema = require("./Schema")
local Rng = require("./Rng")

local Hatch = {}


function Hatch.ClampLuck(luck: number): number
	if not Schema.IsFinite(luck) then
		return 1
	end
	return math.clamp(luck, 1, Config.MaxLuckMult)
end

-- Effective weights for an egg at a luck level: { { Pet, Weight } }.
function Hatch.Weights(egg: Eggs.Egg, luck: number): { Eggs.Odds }
	luck = Hatch.ClampLuck(luck)
	local lowest = math.huge
	for _, o in egg.Odds do
		local def = Pets.ById[o.Pet]
		if def then
			lowest = math.min(lowest, PetMath.RarityIndex(def.Rarity))
		end
	end
	local out: { Eggs.Odds } = {}
	for _, o in egg.Odds do
		local def = Pets.ById[o.Pet]
		local w = o.Weight
		if def and PetMath.RarityIndex(def.Rarity) > lowest then
			w *= luck
		end
		table.insert(out, { Pet = o.Pet, Weight = w })
	end
	return out
end

-- Odds in percent (sums to 100) for showing to players.
function Hatch.Odds(egg: Eggs.Egg, luck: number): { [string]: number }
	local weights = Hatch.Weights(egg, luck)
	local total = 0
	for _, o in weights do
		total += o.Weight
	end
	local out: { [string]: number } = {}
	for _, o in weights do
		out[o.Pet] = if total > 0 then o.Weight / total * 100 else 0
	end
	return out
end

-- Picks a pet id. `roll` is a number in [0, 1).
function Hatch.Pick(egg: Eggs.Egg, luck: number, roll: number): string
	local weights = Hatch.Weights(egg, luck)
	local total = 0
	for _, o in weights do
		total += o.Weight
	end
	if not Schema.IsFinite(roll) then
		roll = 0
	end
	local target = math.clamp(roll, 0, 1) * total
	local acc = 0
	for _, o in weights do
		acc += o.Weight
		if target < acc then
			return o.Pet
		end
	end
	return weights[#weights].Pet
end

-- Full roll with an Rng: returns the pet id and whether it is shiny.
function Hatch.Roll(egg: Eggs.Egg, luck: number, rng: Rng.Rng): (string, boolean)
	local id = Hatch.Pick(egg, luck, rng:Next())
	local shiny = rng:Next() < Config.ShinyChance
	return id, shiny
end

return Hatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Inventory</string>
            <string name="Source"><![CDATA[--!strict
-- Pet inventory rules: adding (capacity, unique uids), removing, equipping,
-- locking, deleting with refunds and crafting 5 -> next variant.
--
-- "Busy" pets are on an expedition: they can't be equipped, deleted,
-- crafted or traded until the expedition is claimed. Callers can pass an
-- extra `blocked` set (e.g. pets offered in an open trade) that is treated
-- the same way for delete / craft.

local Config = require("../Config")
local Pets = require("../Pets")
local Economy = require("./Economy")
local PetMath = require("./PetMath")
local Schema = require("./Schema")

type Profile = Schema.Profile
type PetInstance = Schema.PetInstance

export type PetSpec = { Id: string, Variant: string?, Shiny: boolean?, Level: number?, Xp: number? }

local Inventory = {}

function Inventory.Find(p: Profile, uid: string): (PetInstance?, number?)
	for i, pet in p.Pets do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end

-- Set of uids currently on expeditions.
function Inventory.BusySet(p: Profile): { [string]: boolean }
	local busy: { [string]: boolean } = {}
	for _, e in p.Expeditions do
		for _, uid in e.Pets do
			busy[uid] = true
		end
	end
	return busy
end

function Inventory.IsBusy(p: Profile, uid: string): boolean
	return Inventory.BusySet(p)[uid] == true
end

function Inventory.IsEquipped(p: Profile, uid: string): boolean
	return table.find(p.Equipped, uid) ~= nil
end

function Inventory.FreeSpace(p: Profile): number
	return math.max(0, Economy.MaxStorage(p) - #p.Pets)
end

-- Returns a uid that no pet in this profile uses, and advances the counter.
function Inventory.NewUid(p: Profile): string
	local existing: { [string]: boolean } = {}
	for _, pet in p.Pets do
		existing[pet.Uid] = true
	end
	local uid
	repeat
		p.NextUid += 1
		uid = tostring(p.NextUid)
	until not existing[uid]
	return uid
end

-- Validates a pet spec and builds a fresh instance (not yet added).
function Inventory.Make(p: Profile, spec: PetSpec): (PetInstance?, string?)
	if type(spec) ~= "table" or type(spec.Id) ~= "string" or not Pets.ById[spec.Id] then
		return nil, "Unknown pet"
	end
	local variant = spec.Variant or "Normal"
	if not table.find(Config.Variants, variant) then
		return nil, "Unknown variant"
	end
	local level = Schema.ClampInt(spec.Level or 1, 1, Config.PetMaxLevel)
	local xp = if level >= Config.PetMaxLevel then 0 else Schema.ClampInt(spec.Xp or 0, 0, PetMath.XpToNext(level) - 1)
	return {
		Uid = Inventory.NewUid(p),
		Id = spec.Id,
		Variant = variant,
		Shiny = spec.Shiny == true,
		Level = level,
		Xp = xp,
		Locked = false,
	}, nil
end

-- Adds one pet if there is room. Returns the pet and whether its species is
-- new to the player's Index.
function Inventory.Add(p: Profile, spec: PetSpec): (PetInstance?, boolean, string?)
	if Inventory.FreeSpace(p) < 1 then
		return nil, false, "Pet storage is full"
	end
	local pet, err = Inventory.Make(p, spec)
	if not pet then
		return nil, false, err
	end
	table.insert(p.Pets, pet)
	local discovered = not p.Index[pet.Id]
	p.Index[pet.Id] = true
	return pet, discovered, nil
end

-- Removes pets by uid (no checks) and unequips them.
function Inventory.RemoveUnchecked(p: Profile, uids: { string })
	local drop: { [string]: boolean } = {}
	for _, u in uids do
		drop[u] = true
	end
	local kept: { PetInstance } = {}
	for _, pet in p.Pets do
		if not drop[pet.Uid] then
			table.insert(kept, pet)
		end
	end
	p.Pets = kept
	local eq: { string } = {}
	for _, u in p.Equipped do
		if not drop[u] then
			table.insert(eq, u)
		end
	end
	p.Equipped = eq
end

function Inventory.Equip(p: Profile, uid: string, equip: boolean): (boolean, string?)
	local pet = Inventory.Find(p, uid)
	if not pet then
		return false, "You don't have that pet"
	end
	local idx = table.find(p.Equipped, uid)
	if not equip then
		if idx then
			table.remove(p.Equipped, idx)
		end
		return true, nil
	end
	if idx then
		return true, nil
	end
	if Inventory.IsBusy(p, uid) then
		return false, "That pet is on an expedition"
	end
	if #p.Equipped >= Economy.MaxEquip(p) then
		return false, "No free pet slots"
	end
	table.insert(p.Equipped, uid)
	return true, nil
end

function Inventory.UnequipAll(p: Profile)
	p.Equipped = {}
end

-- Equips the strongest pets that aren't busy.
function Inventory.EquipBest(p: Profile)
	local busy = Inventory.BusySet(p)
	local list: { PetInstance } = {}
	for _, pet in p.Pets do
		if not busy[pet.Uid] then
			table.insert(list, pet)
		end
	end
	table.sort(list, PetMath.StrongerAt(Economy.HighestArea(p)))
	local eq: { string } = {}
	for i = 1, math.min(#list, Economy.MaxEquip(p)) do
		table.insert(eq, list[i].Uid)
	end
	p.Equipped = eq
end

function Inventory.EquippedPets(p: Profile): { PetInstance }
	local out: { PetInstance } = {}
	for _, uid in p.Equipped do
		local pet = Inventory.Find(p, uid)
		if pet then
			table.insert(out, pet)
		end
	end
	return out
end

function Inventory.EquippedPower(p: Profile): number
	local total = 0
	local scale = Economy.HighestArea(p)
	for _, pet in Inventory.EquippedPets(p) do
		total += PetMath.Power(pet, scale)
	end
	return total
end

function Inventory.Lock(p: Profile, uid: string, locked: boolean): (boolean, string?)
	local pet = Inventory.Find(p, uid)
	if not pet then
		return false, "You don't have that pet"
	end
	pet.Locked = locked == true
	return true, nil
end

-- Deletes pets for a coin refund. All-or-nothing: any locked / busy / blocked
-- / unknown uid rejects the whole request. Returns the refund.
function Inventory.Delete(p: Profile, uids: { string }, blocked: { [string]: boolean }?): (number?, string?)
	local busy = Inventory.BusySet(p)
	local seen: { [string]: boolean } = {}
	local refund = 0
	for _, uid in uids do
		if seen[uid] then
			return nil, "Same pet chosen twice"
		end
		seen[uid] = true
		local pet = Inventory.Find(p, uid)
		if not pet then
			return nil, "You don't have that pet"
		end
		if pet.Locked then
			return nil, "Unlock a pet before deleting it"
		end
		if busy[uid] then
			return nil, "That pet is on an expedition"
		end
		if blocked and blocked[uid] then
			return nil, "That pet is in a trade"
		end
		refund += PetMath.DeleteRefund(pet)
	end
	Inventory.RemoveUnchecked(p, uids)
	local added = Economy.AddCoins(p, refund, false)
	return added, nil
end

-- Pets that could be crafted together with `pet` (same species, variant and
-- shininess, unlocked, not busy or blocked), the chosen pet first, then
-- unequipped pets before equipped ones, lowest level first.
function Inventory.CraftGroup(p: Profile, pet: PetInstance, blocked: { [string]: boolean }?): { PetInstance }
	local busy = Inventory.BusySet(p)
	local group: { PetInstance } = {}
	for _, other in p.Pets do
		if other.Uid ~= pet.Uid and other.Id == pet.Id and other.Variant == pet.Variant
			and other.Shiny == pet.Shiny and not other.Locked and not busy[other.Uid]
			and not (blocked and blocked[other.Uid]) then
			table.insert(group, other)
		end
	end
	table.sort(group, function(a, b)
		local ea, eb = Inventory.IsEquipped(p, a.Uid), Inventory.IsEquipped(p, b.Uid)
		if ea ~= eb then
			return not ea
		end
		if a.Level ~= b.Level then
			return a.Level < b.Level
		end
		return a.Uid < b.Uid
	end)
	table.insert(group, 1, pet)
	return group
end

-- Combines Config.CraftCost copies of a pet into one of the next variant.
-- The new pet is equipped if any consumed pet was equipped.
function Inventory.Craft(p: Profile, uid: string, blocked: { [string]: boolean }?): (PetInstance?, string?)
	local pet = Inventory.Find(p, uid)
	if not pet then
		return nil, "You don't have that pet"
	end
	local nextVariant = PetMath.NextVariant(pet.Variant)
	if not nextVariant then
		return nil, "This pet can't be upgraded further"
	end
	if pet.Locked then
		return nil, "Unlock the pet first"
	end
	if Inventory.IsBusy(p, uid) then
		return nil, "That pet is on an expedition"
	end
	if blocked and blocked[uid] then
		return nil, "That pet is in a trade"
	end
	local group = Inventory.CraftGroup(p, pet, blocked)
	if #group < Config.CraftCost then
		return nil, string.format("You need %d of this pet (unlocked, at home)", Config.CraftCost)
	end
	local used: { string } = {}
	local wasEquipped = false
	for i = 1, Config.CraftCost do
		table.insert(used, group[i].Uid)
		wasEquipped = wasEquipped or Inventory.IsEquipped(p, group[i].Uid)
	end
	local id, shiny = pet.Id, pet.Shiny
	Inventory.RemoveUnchecked(p, used)
	-- Room is guaranteed: we just freed Config.CraftCost slots.
	local made = Inventory.Make(p, { Id = id, Variant = nextVariant, Shiny = shiny })
	if not made then
		return nil, "Craft failed"
	end
	table.insert(p.Pets, made)
	if wasEquipped and #p.Equipped < Economy.MaxEquip(p) then
		table.insert(p.Equipped, made.Uid)
	end
	p.Stats.Crafted = math.min(Schema.MaxStat, p.Stats.Crafted + 1)
	return made, nil
end

return Inventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">PetMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pet power and levels.
--   Power = RarityPower[rarity] * area PowerMult * VariantPower * (ShinyPower if shiny)
--           * (1 + PetLevelPower * (level - 1))
--
-- Gem pets (Source "Gem", from the Prism Egg) have no home island of their
-- own: they use the PowerMult of `scaleArea`, which callers set to the
-- player's highest opened island (Economy.HighestArea) at the moment power
-- is used. Without a scaleArea they count as Meadow pets. So gems buy a pet
-- that is strong for where the player already is, never a progression skip.

local Config = require("../Config")
local Pets = require("../Pets")
local Areas = require("../Areas")
local Schema = require("./Schema")

type PetInstance = Schema.PetInstance

local PetMath = {}

function PetMath.RarityIndex(rarity: string): number
	return table.find(Config.Rarities, rarity) or 0
end

PetMath.GemScaleDefault = "Meadow"

-- True for pets whose power follows the owner's progress (Prism Egg pets).
function PetMath.IsScaling(petId: string): boolean
	local def = Pets.ById[petId]
	return def ~= nil and def.Source == "Gem"
end

-- The island whose multipliers a pet uses.
function PetMath.PowerArea(petId: string, scaleArea: string?): Areas.Area?
	local def = Pets.ById[petId]
	if not def then
		return nil
	end
	if def.Source == "Gem" then
		return Areas.ById[scaleArea or PetMath.GemScaleDefault] or Areas.ById[PetMath.GemScaleDefault]
	end
	return Areas.ById[def.Area]
end

-- Power of a level 1, Normal, non-shiny pet of this species (0 if unknown).
function PetMath.BasePower(petId: string, scaleArea: string?): number
	local def = Pets.ById[petId]
	if not def then
		return 0
	end
	local area = PetMath.PowerArea(petId, scaleArea)
	local areaMult = if area then area.PowerMult else 1
	return (Config.RarityPower[def.Rarity] or 1) * areaMult
end

function PetMath.Power(pet: PetInstance, scaleArea: string?): number
	local base = PetMath.BasePower(pet.Id, scaleArea)
	local variant = Config.VariantPower[pet.Variant] or 1
	local shiny = if pet.Shiny then Config.ShinyPower else 1
	local level = Schema.ClampInt(pet.Level, 1, Config.PetMaxLevel)
	return base * variant * shiny * (1 + Config.PetLevelPower * (level - 1))
end

-- The variant a craft produces from `variant`, or nil when it is the last one.
function PetMath.NextVariant(variant: string): string?
	local i = table.find(Config.Variants, variant)
	if not i or i >= #Config.Variants then
		return nil
	end
	return Config.Variants[i + 1]
end

-- XP needed to go from `level` to `level + 1`.
function PetMath.XpToNext(level: number): number
	return math.max(1, Config.PetXpForLevel(level))
end

-- Adds XP to a pet (mutates it). Returns the number of levels gained.
function PetMath.AddXp(pet: PetInstance, xp: number): number
	if not Schema.IsFinite(xp) or xp <= 0 then
		return 0
	end
	if pet.Level >= Config.PetMaxLevel then
		pet.Level = Config.PetMaxLevel
		pet.Xp = 0
		return 0
	end
	local gained = 0
	pet.Xp += math.floor(xp)
	while pet.Level < Config.PetMaxLevel and pet.Xp >= PetMath.XpToNext(pet.Level) do
		pet.Xp -= PetMath.XpToNext(pet.Level)
		pet.Level += 1
		gained += 1
	end
	if pet.Level >= Config.PetMaxLevel then
		pet.Level = Config.PetMaxLevel
		pet.Xp = 0
	end
	return gained
end

-- Coins refunded when a pet is deleted. Gem pets always refund at Meadow
-- level (never scaled), so gems can't be turned into coins for gates.
function PetMath.DeleteRefund(pet: PetInstance): number
	local area = PetMath.PowerArea(pet.Id, nil)
	local coinMult = if area then area.CoinMult else 1
	return math.max(1, math.floor(PetMath.Power(pet, nil) * coinMult * Config.DeleteRefund))
end

-- Sort comparator: strongest first (at `scaleArea`), ties broken by uid.
function PetMath.StrongerAt(scaleArea: string?): (PetInstance, PetInstance) -> boolean
	return function(a: PetInstance, b: PetInstance): boolean
		local pa, pb = PetMath.Power(a, scaleArea), PetMath.Power(b, scaleArea)
		if pa ~= pb then
			return pa > pb
		end
		return a.Uid < b.Uid
	end
end

PetMath.Stronger = PetMath.StrongerAt(nil)

return PetMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
-- Profiles: defaults for new players, sanitising of loaded (possibly old or
-- corrupted) data, and building the client's PlayerState snapshot.

local Config = require("../Config")
local Pets = require("../Pets")
local Areas = require("../Areas")
local Products = require("../Products")
local Types = require("../Types")
local Economy = require("./Economy")
local Inventory = require("./Inventory")
local Expedition = require("./Expedition")
local PetMath = require("./PetMath")
local Rewards = require("./Rewards")
local Schema = require("./Schema")

type Profile = Schema.Profile
type PetInstance = Schema.PetInstance

export type StateContext = {
	Now: number,
	Premium: boolean?,
	InGroup: boolean?,
	ServerLuckUntil: number?,
	CanBuyGemEggs: boolean?,
	CanTrade: boolean?,
	NoPaidLuck: boolean?,
}

local Profile = {}

Profile.MaxPets = 3000 -- hard cap on stored pets (bounds the save size)
Profile.MaxExtraStorage = 10000

function Profile.Default(): Profile
	local settings: { [string]: any } = {}
	for k, v in Schema.SettingDefaults do
		settings[k] = v
	end
	return {
		Version = Config.Version,
		Coins = Schema.StartCoins,
		Gems = 0,
		Rebirths = 0,
		Areas = { [Schema.StartArea] = true },
		Pets = {},
		NextUid = 0,
		Equipped = {},
		Expeditions = {},
		Passes = {},
		Boosts = {},
		Index = {},
		IndexClaimed = {},
		Daily = { Streak = 0, LastDay = -1 },
		Quests = { Day = -1, List = {} },
		Stats = { Hatched = 0, Broken = 0, Expeditions = 0, CoinsEarned = 0, Crafted = 0 },
		Settings = settings,
		ExtraEquip = 0,
		ExtraStorage = 0,
		Receipts = {},
		Playtime = { Day = -1, Minutes = 0, Claimed = {} },
		ExpeditionMult = {},
		PendingTrade = nil,
		AppliedTrades = {},
	}
end

local function tbl(v: any): { [any]: any }
	return if type(v) == "table" then v else {}
end

local function sanitizePets(p: Profile, raw: any)
	local list: { PetInstance } = {}
	local needUid: { PetInstance } = {}
	local seen: { [string]: boolean } = {}
	local maxNum = p.NextUid
	for _, r in tbl(raw) do
		if #list >= Profile.MaxPets then
			break
		end
		if type(r) ~= "table" or type(r.Id) ~= "string" or not Pets.ById[r.Id] then
			continue
		end
		local variant = if type(r.Variant) == "string" and table.find(Config.Variants, r.Variant) then r.Variant else "Normal"
		local level = Schema.ClampInt(r.Level, 1, Config.PetMaxLevel)
		local xp = if level >= Config.PetMaxLevel then 0 else Schema.ClampInt(r.Xp, 0, PetMath.XpToNext(level) - 1)
		local pet: PetInstance = {
			Uid = "",
			Id = r.Id,
			Variant = variant,
			Shiny = r.Shiny == true,
			Level = level,
			Xp = xp,
			Locked = r.Locked == true,
		}
		local uid = r.Uid
		if type(uid) == "string" and #uid > 0 and #uid <= Schema.MaxUidLength and not seen[uid] then
			seen[uid] = true
			pet.Uid = uid
			local n = tonumber(uid)
			if n and Schema.IsFinite(n) and n > maxNum then
				maxNum = math.min(math.floor(n), 1e15)
			end
		else
			table.insert(needUid, pet)
		end
		table.insert(list, pet)
	end
	p.Pets = list
	p.NextUid = maxNum
	-- Pets with a missing or duplicate uid get a fresh one (never dropped).
	for _, pet in needUid do
		pet.Uid = Inventory.NewUid(p)
	end
	for _, pet in list do
		p.Index[pet.Id] = true
	end
end

local function sanitizeExpeditions(p: Profile, raw: any)
	local maxSlots = Config.BaseExpeditionSlots + 2
	local used: { [string]: boolean } = {}
	p.Expeditions = {}
	local src = tbl(raw)
	-- Slots in order, so a pet listed twice always stays with the lower slot.
	for slot = 1, maxSlots do
		local e = src[tostring(slot)]
		if type(e) ~= "table" then
			continue
		end
		if type(e.Area) ~= "string" or not Areas.ById[e.Area] then
			continue
		end
		if type(e.Duration) ~= "string" or not Expedition.Duration(e.Duration) then
			continue
		end
		if not Schema.IsFinite(e.StartAt) or not Schema.IsFinite(e.EndAt) then
			continue
		end
		local pets: { string } = {}
		for _, uid in tbl(e.Pets) do
			if #pets >= Config.MaxPetsPerExpedition then
				break
			end
			if type(uid) == "string" and not used[uid] and Inventory.Find(p, uid) then
				used[uid] = true
				table.insert(pets, uid)
			end
		end
		if #pets == 0 then
			continue
		end
		p.Expeditions[tostring(slot)] = {
			Area = e.Area,
			Duration = e.Duration,
			Pets = pets,
			StartAt = math.floor(e.StartAt),
			EndAt = math.floor(e.EndAt),
			Seed = Schema.ClampInt(e.Seed, 1, 2147483646),
		}
	end
end

local function sanitizeQuests(p: Profile, raw: any)
	local q = tbl(raw)
	local list: { Schema.Quest } = {}
	local ok = Schema.IsInt(q.Day)
	for _, r in tbl(q.List) do
		if type(r) ~= "table" or type(r.Kind) ~= "string" or not Schema.IsFinite(r.Goal) or r.Goal < 1 then
			ok = false
			break
		end
		local goal = math.floor(r.Goal)
		table.insert(list, {
			Kind = r.Kind,
			Goal = goal,
			Progress = Schema.ClampInt(r.Progress, 0, goal),
			Gems = Schema.ClampInt(r.Gems, 0, 1000),
			Claimed = r.Claimed == true,
		})
	end
	if not ok or #list > Config.QuestsPerDay then
		p.Quests = { Day = -1, List = {} } -- regenerated on next use
	else
		p.Quests = { Day = q.Day, List = list }
	end
end

-- Builds a valid profile from anything loaded from the DataStore (nil for a
-- new player). Unknown fields are dropped; bad values are clamped.
function Profile.Sanitize(raw: any): Profile
	local p = Profile.Default()
	if type(raw) ~= "table" then
		return p
	end
	p.Coins = if raw.Coins == nil then Schema.StartCoins else Schema.ClampInt(raw.Coins, 0, Schema.MaxCoins)
	p.Gems = Schema.ClampInt(raw.Gems, 0, Schema.MaxGems)
	p.Rebirths = Schema.ClampInt(raw.Rebirths, 0, Config.MaxRebirths)
	for id, v in tbl(raw.Areas) do
		if v == true and type(id) == "string" and Areas.ById[id] then
			p.Areas[id] = true
		end
	end
	for key, v in tbl(raw.Passes) do
		if v == true and type(key) == "string" and Products.PassByKey[key] then
			p.Passes[key] = true
		end
	end
	for key, v in tbl(raw.Boosts) do
		if type(key) == "string" and Config.Boosts[key] and Schema.IsFinite(v) then
			p.Boosts[key] = math.floor(v)
		end
	end
	for id, v in tbl(raw.Index) do
		if v == true and type(id) == "string" and Pets.ById[id] then
			p.Index[id] = true
		end
	end
	for key, v in tbl(raw.IndexClaimed) do
		local n = tonumber(key)
		if v == true and n and Schema.IsInt(n, 1, #Config.IndexRewards) then
			p.IndexClaimed[tostring(n)] = true
		end
	end
	p.ExtraEquip = Schema.ClampInt(raw.ExtraEquip, 0, Config.MaxEquipCap)
	p.ExtraStorage = Schema.ClampInt(raw.ExtraStorage, 0, Profile.MaxExtraStorage)
	p.NextUid = Schema.ClampInt(raw.NextUid, 0, 1e15)
	sanitizePets(p, raw.Pets)
	sanitizeExpeditions(p, raw.Expeditions)

	local busy = Inventory.BusySet(p)
	local maxEquip = Economy.MaxEquip(p)
	for _, uid in tbl(raw.Equipped) do
		if #p.Equipped >= maxEquip then
			break
		end
		if type(uid) == "string" and not busy[uid] and not table.find(p.Equipped, uid) and Inventory.Find(p, uid) then
			table.insert(p.Equipped, uid)
		end
	end

	local daily = tbl(raw.Daily)
	p.Daily.Streak = Schema.ClampInt(daily.Streak, 0, 1e6)
	p.Daily.LastDay = if Schema.IsInt(daily.LastDay) then daily.LastDay else -1
	sanitizeQuests(p, raw.Quests)

	local stats = tbl(raw.Stats)
	local outStats: { [string]: number } = p.Stats :: any
	for key in outStats do
		outStats[key] = Schema.ClampInt(stats[key], 0, Schema.MaxStat)
	end
	local settings = tbl(raw.Settings)
	for key, default in Schema.SettingDefaults do
		local v = settings[key]
		p.Settings[key] = if type(v) == "boolean" then v else default
	end

	for id, at in tbl(raw.Receipts) do
		if type(id) == "string" and #id <= 128 and Schema.IsFinite(at) then
			p.Receipts[id] = at
		end
	end
	Profile.TrimReceipts(p)

	local play = tbl(raw.Playtime)
	if Schema.IsInt(play.Day) then
		p.Playtime.Day = play.Day
		p.Playtime.Minutes = if Schema.IsFinite(play.Minutes) then math.clamp(play.Minutes, 0, 24 * 60) else 0
		for key, v in tbl(play.Claimed) do
			local n = tonumber(key)
			if v == true and n and Schema.IsInt(n, 1, #Config.PlaytimeGifts) then
				p.Playtime.Claimed[tostring(n)] = true
			end
		end
	end

	for slot, mult in tbl(raw.ExpeditionMult) do
		if type(slot) == "string" and p.Expeditions[slot] and Schema.IsFinite(mult) and mult > 0 then
			p.ExpeditionMult[slot] = math.min(mult, Schema.MaxCoinMult)
		end
	end
	if type(raw.PendingTrade) == "string" and #raw.PendingTrade > 0 and #raw.PendingTrade <= 64 then
		p.PendingTrade = raw.PendingTrade
	end
	for _, id in tbl(raw.AppliedTrades) do
		if type(id) == "string" and #id <= 64 and #p.AppliedTrades < Schema.MaxAppliedTrades then
			table.insert(p.AppliedTrades, id)
		end
	end
	return p
end

-- Keeps only the newest Schema.MaxReceipts purchase ids.
function Profile.TrimReceipts(p: Profile)
	local list: { { Id: string, At: number } } = {}
	for id, at in p.Receipts do
		table.insert(list, { Id = id, At = at })
	end
	if #list <= Schema.MaxReceipts then
		return
	end
	table.sort(list, function(a, b)
		if a.At ~= b.At then
			return a.At > b.At
		end
		return a.Id > b.Id
	end)
	local kept: { [string]: number } = {}
	for i = 1, Schema.MaxReceipts do
		kept[list[i].Id] = list[i].At
	end
	p.Receipts = kept
end

function Profile.HasReceipt(p: Profile, purchaseId: string): boolean
	return p.Receipts[purchaseId] ~= nil
end

function Profile.RecordReceipt(p: Profile, purchaseId: string, now: number)
	p.Receipts[purchaseId] = now
	Profile.TrimReceipts(p)
end

function Profile.SetSetting(p: Profile, key: any, value: any): (boolean, string?)
	if type(key) ~= "string" or Schema.SettingDefaults[key] == nil then
		return false, "Unknown setting"
	end
	if type(value) ~= "boolean" then
		return false, "Bad value"
	end
	p.Settings[key] = value
	return true, nil
end

function Profile.CopyPet(pet: PetInstance): PetInstance
	return {
		Uid = pet.Uid,
		Id = pet.Id,
		Variant = pet.Variant,
		Shiny = pet.Shiny,
		Level = pet.Level,
		Xp = pet.Xp,
		Locked = pet.Locked,
	}
end

local function copySet(t: { [string]: boolean }): { [string]: boolean }
	local out: { [string]: boolean } = {}
	for k, v in t do
		if v then
			out[k] = true
		end
	end
	return out
end

-- The snapshot sent to the owning client.
function Profile.BuildState(p: Profile, c: StateContext): Types.PlayerState
	local now = c.Now
	local mult: Economy.MultContext = { Now = now, Premium = c.Premium, InGroup = c.InGroup, ServerLuckUntil = c.ServerLuckUntil, NoPaidLuck = c.NoPaidLuck }
	local day = Rewards.DayNumber(now)
	local pets: { PetInstance } = {}
	for _, pet in p.Pets do
		table.insert(pets, Profile.CopyPet(pet))
	end
	local exps: { [string]: Types.Expedition } = {}
	for key, e in p.Expeditions do
		exps[key] = {
			Area = e.Area,
			Duration = e.Duration,
			Pets = table.clone(e.Pets),
			StartAt = e.StartAt,
			EndAt = e.EndAt,
			Seed = 0, -- the reward seed stays on the server
		}
	end
	local boosts: { [string]: number } = {}
	for key, expires in p.Boosts do
		if expires > now then
			boosts[key] = expires
		end
	end
	local quests: { Schema.Quest } = {}
	local questList: { Schema.Quest } = Rewards.QuestsFor(p, day)
	for _, q in questList do
		table.insert(quests, { Kind = q.Kind, Goal = q.Goal, Progress = q.Progress, Gems = q.Gems, Claimed = q.Claimed })
	end
	local settings: { [string]: any } = {}
	for k, v in p.Settings do
		settings[k] = v
	end
	local serverLuck = c.ServerLuckUntil
	return {
		Coins = p.Coins,
		Gems = p.Gems,
		Rebirths = p.Rebirths,
		CoinMult = Economy.CoinMult(p, mult),
		LuckMult = Economy.LuckMult(p, mult),
		Areas = copySet(p.Areas),
		Pets = pets,
		Equipped = table.clone(p.Equipped),
		MaxEquip = Economy.MaxEquip(p),
		MaxStorage = Economy.MaxStorage(p),
		Expeditions = exps,
		ExpeditionSlots = Economy.ExpeditionSlots(p),
		Passes = copySet(p.Passes),
		Boosts = boosts,
		ServerLuckUntil = if serverLuck and serverLuck > now then serverLuck else 0,
		Index = copySet(p.Index),
		IndexClaimed = copySet(p.IndexClaimed),
		Daily = Rewards.DailyStatus(p, day),
		Quests = quests,
		-- SessionMinutes keeps its name for the client; it is minutes played today.
		Playtime = {
			SessionMinutes = math.floor(Rewards.PlaytimeMinutes(p, now)),
			Claimed = if p.Playtime.Day == day then copySet(p.Playtime.Claimed) else {},
		},
		Stats = {
			Hatched = p.Stats.Hatched,
			Broken = p.Stats.Broken,
			Expeditions = p.Stats.Expeditions,
			CoinsEarned = p.Stats.CoinsEarned,
			Crafted = p.Stats.Crafted,
		},
		Settings = settings,
		RebirthCost = if p.Rebirths >= Config.MaxRebirths then 0 else Economy.RebirthCost(p.Rebirths),
		CanBuyGemEggs = c.CanBuyGemEggs ~= false,
		CanTrade = c.CanTrade ~= false,
		ServerTime = now,
	}
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token-bucket rate limiting, per owner (a player) and per bucket name (a
-- remote). Each bucket refills `Rate` tokens per second up to `Burst`; every
-- call costs one token. Pure: the caller passes the clock.

export type Limit = { Rate: number, Burst: number }
type Bucket = { Tokens: number, At: number }
export type Limiter = { Owners: { [any]: { [string]: Bucket } } }

local RateLimiter = {}

function RateLimiter.New(): Limiter
	return { Owners = {} }
end

function RateLimiter.Allow(l: Limiter, owner: any, name: string, limit: Limit, now: number): boolean
	local buckets = l.Owners[owner]
	if not buckets then
		buckets = {}
		l.Owners[owner] = buckets
	end
	local b = buckets[name]
	if not b then
		b = { Tokens = limit.Burst, At = now }
		buckets[name] = b
	end
	local elapsed = now - b.At
	if elapsed > 0 then
		b.Tokens = math.min(limit.Burst, b.Tokens + elapsed * limit.Rate)
	end
	b.At = math.max(b.At, now)
	if b.Tokens >= 1 then
		b.Tokens -= 1
		return true
	end
	return false
end

function RateLimiter.Forget(l: Limiter, owner: any)
	l.Owners[owner] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Daily streak, playtime gifts, daily quests and Index (collection) rewards.
-- Days are UTC day numbers: floor(os.time() / 86400).

local Config = require("../Config")
local Pets = require("../Pets")
local Areas = require("../Areas")
local Economy = require("./Economy")
local Rng = require("./Rng")
local Schema = require("./Schema")

type Profile = Schema.Profile
type Quest = Schema.Quest
type Reward = Schema.Reward

local Rewards = {}

local SECONDS_PER_DAY = 86400

function Rewards.DayNumber(now: number): number
	return math.floor(now / SECONDS_PER_DAY)
end

-- Grants a Config.RewardSpec. Returns what was actually given.
function Rewards.Apply(p: Profile, spec: Config.RewardSpec, now: number): Reward
	local out: Reward = {}
	if spec.Coins then
		out.Coins = Economy.AddCoins(p, spec.Coins, false)
	end
	if spec.Gems then
		out.Gems = Economy.AddGems(p, spec.Gems)
	end
	if spec.Boost and Config.Boosts[spec.Boost] then
		Economy.ApplyBoost(p, spec.Boost, now)
		out.Boost = spec.Boost
	end
	if spec.Equip and spec.Equip > 0 then
		p.ExtraEquip += math.floor(spec.Equip)
		out.Equip = math.floor(spec.Equip)
	end
	if spec.Storage and spec.Storage > 0 then
		p.ExtraStorage += math.floor(spec.Storage)
		out.Storage = math.floor(spec.Storage)
	end
	return out
end

-- Daily ----------------------------------------------------------------------

-- The streak the player currently has (0 once a day was missed).
function Rewards.EffectiveStreak(p: Profile, day: number): number
	if p.Daily.LastDay >= day - 1 then
		return p.Daily.Streak
	end
	return 0
end

function Rewards.DailyStatus(p: Profile, day: number): { Streak: number, LastDay: number, CanClaim: boolean }
	return {
		Streak = Rewards.EffectiveStreak(p, day),
		LastDay = p.Daily.LastDay,
		CanClaim = p.Daily.LastDay < day,
	}
end

-- Reward for a streak day (1-based, loops after the last entry).
function Rewards.DailySpec(streakDay: number): Config.RewardSpec
	local n = #Config.DailyRewards
	return Config.DailyRewards[((math.max(1, streakDay) - 1) % n) + 1]
end

function Rewards.ClaimDaily(p: Profile, now: number): (Reward?, number?, string?)
	local day = Rewards.DayNumber(now)
	if p.Daily.LastDay >= day then
		return nil, nil, "Come back tomorrow"
	end
	local streak = if p.Daily.LastDay == day - 1 then p.Daily.Streak + 1 else 1
	p.Daily.Streak = math.min(streak, 1e6)
	p.Daily.LastDay = day
	return Rewards.Apply(p, Rewards.DailySpec(streak), now), streak, nil
end

-- Playtime gifts (once per UTC day, minutes played today) ------------------------

-- Starts a fresh playtime day when the day changed. Returns true if reset.
function Rewards.EnsurePlaytimeDay(p: Profile, now: number): boolean
	local day = Rewards.DayNumber(now)
	if p.Playtime.Day == day then
		return false
	end
	p.Playtime = { Day = day, Minutes = 0, Claimed = {} }
	return true
end

-- Adds online time (seconds) to today's minutes. Time is credited to the day
-- it is added on (a session over midnight starts the new day from zero).
function Rewards.AddPlaytime(p: Profile, seconds: number, now: number)
	Rewards.EnsurePlaytimeDay(p, now)
	if not Schema.IsFinite(seconds) or seconds <= 0 then
		return
	end
	-- One call can't add more than an hour (guards against clock jumps).
	p.Playtime.Minutes = math.min(24 * 60, p.Playtime.Minutes + math.min(seconds, 3600) / 60)
end

function Rewards.PlaytimeMinutes(p: Profile, now: number): number
	if p.Playtime.Day ~= Rewards.DayNumber(now) then
		return 0
	end
	return p.Playtime.Minutes
end

function Rewards.ClaimPlaytime(p: Profile, index: number, now: number): (Reward?, string?)
	if not Schema.IsInt(index, 1, #Config.PlaytimeGifts) then
		return nil, "Unknown gift"
	end
	Rewards.EnsurePlaytimeDay(p, now)
	local key = tostring(index)
	if p.Playtime.Claimed[key] then
		return nil, "Already claimed today"
	end
	local gift = Config.PlaytimeGifts[index]
	if p.Playtime.Minutes < (gift.Minutes or 0) then
		return nil, "Not ready yet"
	end
	p.Playtime.Claimed[key] = true
	return Rewards.Apply(p, gift, now), nil
end

-- Quests -----------------------------------------------------------------------

-- The same quests for everyone on a day. Coins goals are multiplied by
-- `coinMult` (the CoinMult of the player's highest opened island), so they
-- stay meaningful as the player progresses.
function Rewards.GenerateQuests(day: number, coinMult: number?): { Quest }
	local scale = if coinMult and Schema.IsFinite(coinMult) and coinMult > 0 then coinMult else 1
	local rng = Rng.New(Rng.Hash("quests", day))
	local pool = {}
	for i = 1, #Config.QuestPool do
		table.insert(pool, i)
	end
	-- Fisher-Yates shuffle.
	for i = #pool, 2, -1 do
		local j = rng:Int(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local out: { Quest } = {}
	for i = 1, math.min(Config.QuestsPerDay, #pool) do
		local def = Config.QuestPool[pool[i]]
		local tier = rng:Int(1, #def.Goals)
		local goal = def.Goals[tier]
		if def.Kind == "Coins" then
			goal = math.floor(goal * scale)
		end
		table.insert(out, {
			Kind = def.Kind,
			Goal = goal,
			Progress = 0,
			Gems = def.Gems[tier],
			Claimed = false,
		})
	end
	return out
end

-- CoinMult of the player's highest opened island (scales Coins quests).
function Rewards.QuestCoinMult(p: Profile): number
	local best = Areas.ById[Schema.StartArea]
	for _, a in Areas.List do
		if p.Areas[a.Id] then
			best = a
		end
	end
	return if best then best.CoinMult else 1
end

-- Today's quests for this player (fresh ones if the stored day is old).
function Rewards.QuestsFor(p: Profile, day: number): { Quest }
	if p.Quests.Day == day and #p.Quests.List > 0 then
		return p.Quests.List
	end
	return Rewards.GenerateQuests(day, Rewards.QuestCoinMult(p))
end

-- Replaces yesterday's quests. Goals are fixed when generated. Returns true
-- if they changed.
function Rewards.EnsureQuests(p: Profile, day: number): boolean
	if p.Quests.Day == day and #p.Quests.List > 0 then
		return false
	end
	p.Quests = { Day = day, List = Rewards.GenerateQuests(day, Rewards.QuestCoinMult(p)) }
	return true
end

-- Adds progress to every unclaimed quest of a kind. Returns true if changed.
function Rewards.AddQuestProgress(p: Profile, kind: string, amount: number, now: number): boolean
	if not Schema.IsFinite(amount) or amount <= 0 then
		return false
	end
	Rewards.EnsureQuests(p, Rewards.DayNumber(now))
	local changed = false
	for _, q in p.Quests.List do
		if q.Kind == kind and not q.Claimed and q.Progress < q.Goal then
			q.Progress = math.min(q.Goal, q.Progress + amount)
			changed = true
		end
	end
	return changed
end

function Rewards.ClaimQuest(p: Profile, index: number, now: number): (Reward?, string?)
	Rewards.EnsureQuests(p, Rewards.DayNumber(now))
	if not Schema.IsInt(index, 1, #p.Quests.List) then
		return nil, "Unknown quest"
	end
	local q = p.Quests.List[index]
	if q.Claimed then
		return nil, "Already claimed"
	end
	if q.Progress < q.Goal then
		return nil, "Quest not finished"
	end
	q.Claimed = true
	return Rewards.Apply(p, { Gems = q.Gems }, now), nil
end

-- Index ------------------------------------------------------------------------

function Rewards.IndexCount(p: Profile): number
	local n = 0
	for _, def in Pets.List do
		if p.Index[def.Id] then
			n += 1
		end
	end
	return n
end

function Rewards.IndexFraction(p: Profile): number
	return Rewards.IndexCount(p) / math.max(1, #Pets.List)
end

function Rewards.ClaimIndex(p: Profile, tier: number, now: number): (Reward?, string?)
	if not Schema.IsInt(tier, 1, #Config.IndexRewards) then
		return nil, "Unknown reward"
	end
	local key = tostring(tier)
	if p.IndexClaimed[key] then
		return nil, "Already claimed"
	end
	local spec = Config.IndexRewards[tier]
	-- Compare counts, not fractions, so 100% isn't lost to rounding.
	local needed = math.ceil((spec.Fraction or 1) * #Pets.List - 1e-9)
	if Rewards.IndexCount(p) < needed then
		return nil, "Discover more pets first"
	end
	p.IndexClaimed[key] = true
	return Rewards.Apply(p, spec, now), nil
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Seedable deterministic pseudo random numbers (Park-Miller "minimal
-- standard" generator, multiplier 48271, modulus 2^31 - 1). Every product
-- stays below 2^53, so results are identical on every machine and in the CLI
-- test runner. Used where a roll must be reproducible (expedition rewards
-- fixed by a seed, daily quests fixed by the day number).

local Rng = {}

local MOD = 2147483647
local MULT = 48271

export type Rng = {
	State: number,
	Next: (self: Rng) -> number,
	Int: (self: Rng, lo: number, hi: number) -> number,
	Range: (self: Rng, lo: number, hi: number) -> number,
	Chance: (self: Rng, p: number) -> boolean,
}

-- Turns any number into a valid internal state (1 .. MOD - 1).
local function normalise(seed: number): number
	if type(seed) ~= "number" or seed ~= seed or seed == math.huge or seed == -math.huge then
		seed = 1
	end
	local s = math.floor(math.abs(seed)) % MOD
	if s == 0 then
		s = 1
	end
	return s
end

local function nextValue(self: Rng): number
	self.State = (self.State * MULT) % MOD
	return (self.State - 1) / (MOD - 1) -- [0, 1)
end

-- Integer in [lo, hi] (inclusive). Swaps the bounds if needed.
local function int(self: Rng, lo: number, hi: number): number
	lo, hi = math.floor(lo), math.floor(hi)
	if hi < lo then
		lo, hi = hi, lo
	end
	local n = lo + math.floor(nextValue(self) * (hi - lo + 1))
	return math.min(n, hi)
end

-- Real number in [lo, hi).
local function range(self: Rng, lo: number, hi: number): number
	return lo + (hi - lo) * nextValue(self)
end

local function chance(self: Rng, p: number): boolean
	if p ~= p or p <= 0 then
		return false
	end
	if p >= 1 then
		return true
	end
	return nextValue(self) < p
end

function Rng.New(seed: number): Rng
	local r: Rng = {
		State = normalise(seed),
		Next = nextValue,
		Int = int,
		Range = range,
		Chance = chance,
	}
	-- Discard the first value: tiny seeds otherwise start with tiny outputs.
	r:Next()
	return r
end

-- Combines several numbers / strings into one seed (stable across machines).
function Rng.Hash(...: any): number
	local h = 5381
	for i = 1, select("#", ...) do
		local v = select(i, ...)
		local s = tostring(v)
		for j = 1, #s do
			h = (h * 33 + string.byte(s, j)) % MOD
		end
		h = (h * 31 + 7) % MOD
	end
	return normalise(h)
end

Rng.Modulus = MOD

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Schema</string>
            <string name="Source"><![CDATA[--!strict
-- The saved profile shape and a few hard limits shared by every Logic module.
-- The client never sees this table directly: Logic/Profile.BuildState turns it
-- into a Types.PlayerState.

local Types = require("../Types")

export type PetInstance = Types.PetInstance
export type Expedition = Types.Expedition
export type Quest = Types.Quest
export type Reward = Types.Reward

export type Stats = { Hatched: number, Broken: number, Expeditions: number, CoinsEarned: number, Crafted: number }

export type Profile = {
	Version: number,
	Coins: number,
	Gems: number,
	Rebirths: number,
	Areas: { [string]: boolean },
	Pets: { PetInstance },
	NextUid: number,
	Equipped: { string },
	Expeditions: { [string]: Expedition },
	Passes: { [string]: boolean },
	Boosts: { [string]: number },
	Index: { [string]: boolean },
	IndexClaimed: { [string]: boolean },
	Daily: { Streak: number, LastDay: number },
	Quests: { Day: number, List: { Quest } },
	Stats: Stats,
	Settings: { [string]: any },
	ExtraEquip: number, -- from Index rewards
	ExtraStorage: number, -- from Index rewards
	Receipts: { [string]: number }, -- PurchaseId -> os.time granted
	Playtime: { Day: number, Minutes: number, Claimed: { [string]: boolean } }, -- minutes played on UTC day `Day`
	ExpeditionMult: { [string]: number }, -- slot -> coin multiplier snapshotted at start
	PendingTrade: string?, -- trade id whose journal may still need applying (see Logic/Trade)
	AppliedTrades: { string }, -- newest trade ids already applied (journal replay guard)
}

local Schema = {}

Schema.StartCoins = 150 -- enough for the first Meadow Egg
Schema.StartArea = "Meadow"
Schema.MaxCoins = 1e15
Schema.MaxGems = 1e12
Schema.MaxStat = 1e15
Schema.MaxReceipts = 100 -- newest purchase ids kept for dedupe
Schema.MaxUidLength = 24
Schema.MaxAppliedTrades = 30
Schema.MaxCoinMult = 1e6 -- sanity cap for snapshotted multipliers

-- Settings the client may change (SetSetting) and their defaults. All booleans.
Schema.SettingDefaults = {
	Music = true,
	Sfx = true,
	HideOthersPets = false,
	AutoFarm = false,
} :: { [string]: boolean }

-- True for a finite number (not NaN, not +-inf).
function Schema.IsFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- True for a finite whole number inside [lo, hi].
function Schema.IsInt(n: any, lo: number?, hi: number?): boolean
	if not Schema.IsFinite(n) or n ~= math.floor(n) then
		return false
	end
	if lo and n < lo then
		return false
	end
	if hi and n > hi then
		return false
	end
	return true
end

-- Clamps any value into a finite whole number inside [lo, hi] (bad input -> lo).
function Schema.ClampInt(n: any, lo: number, hi: number): number
	if not Schema.IsFinite(n) then
		return lo
	end
	return math.clamp(math.floor(n), lo, hi)
end

-- Validates a client-sent list of uids: an array of 1..maxCount distinct,
-- short strings. Returns the list (copied) or nil and a reason.
function Schema.UidList(v: any, maxCount: number): ({ string }?, string?)
	if type(v) ~= "table" then
		return nil, "Bad pet list"
	end
	local n = #v
	if n < 1 then
		return nil, "No pets chosen"
	end
	if n > maxCount then
		return nil, "Too many pets"
	end
	local count = 0
	for _ in v do
		count += 1
	end
	if count ~= n then
		return nil, "Bad pet list"
	end
	local seen: { [string]: boolean } = {}
	local out: { string } = {}
	for i = 1, n do
		local u = v[i]
		if type(u) ~= "string" or #u == 0 or #u > Schema.MaxUidLength then
			return nil, "Bad pet id"
		end
		if seen[u] then
			return nil, "Same pet chosen twice"
		end
		seen[u] = true
		table.insert(out, u)
	end
	return out, nil
end

return Schema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Trade</string>
            <string name="Source"><![CDATA[--!strict
-- Trading as a pure state machine.
--
--   Open --(both ready)--> Confirming --(countdown ends)--> swap -> Done
--     ^                        |
--     +---- any offer change --+         (Cancel at any time -> Cancelled)
--
-- Offers are re-validated at swap time, so a pet that was deleted, locked,
-- sent on an expedition or gems that were spent in the meantime make the swap
-- fail instead of duplicating anything. The swap first computes both new
-- inventories without touching either profile, then commits them together.

local Config = require("../Config")
local Types = require("../Types")
local Economy = require("./Economy")
local Inventory = require("./Inventory")
local Profile = require("./Profile")
local Schema = require("./Schema")

type Profile = Schema.Profile
type PetInstance = Schema.PetInstance

export type Side = { UserId: number, Name: string, Pets: { string }, Gems: number, Ready: boolean }
export type TradeState = {
	Id: string,
	Sides: { Side },
	Status: string, -- "Open" | "Confirming" | "Done" | "Cancelled"
	ConfirmAt: number?,
}

export type SidePlan = {
	Pets: { PetInstance },
	Equipped: { string },
	NextUid: number,
	Gems: number,
	Received: { PetInstance },
}
export type Plan = { A: SidePlan, B: SidePlan }

local Trade = {}

function Trade.New(id: string, aUserId: number, aName: string, bUserId: number, bName: string): TradeState
	return {
		Id = id,
		Sides = {
			{ UserId = aUserId, Name = aName, Pets = {}, Gems = 0, Ready = false },
			{ UserId = bUserId, Name = bName, Pets = {}, Gems = 0, Ready = false },
		},
		Status = "Open",
		ConfirmAt = nil,
	}
end

function Trade.SideIndex(t: TradeState, userId: number): number?
	if t.Sides[1].UserId == userId then
		return 1
	elseif t.Sides[2].UserId == userId then
		return 2
	end
	return nil
end

function Trade.IsActive(t: TradeState): boolean
	return t.Status == "Open" or t.Status == "Confirming"
end

-- Checks that a profile can give these pets and gems right now.
function Trade.ValidateOffer(p: Profile, uids: any, gems: any): (boolean, string?)
	if type(uids) ~= "table" then
		return false, "Bad pet list"
	end
	local n = #uids
	local count = 0
	for _ in uids do
		count += 1
	end
	if count ~= n then
		return false, "Bad pet list"
	end
	if n > Config.TradeMaxPets then
		return false, string.format("At most %d pets per trade", Config.TradeMaxPets)
	end
	if Config.TradeMaxGems <= 0 and gems ~= 0 then
		return false, "Gems can't be traded"
	end
	if not Schema.IsInt(gems, 0, Config.TradeMaxGems) then
		return false, "Bad gem amount"
	end
	if gems > p.Gems then
		return false, "Not enough gems"
	end
	local busy = Inventory.BusySet(p)
	local seen: { [string]: boolean } = {}
	for i = 1, n do
		local uid = uids[i]
		if type(uid) ~= "string" or #uid == 0 or #uid > Schema.MaxUidLength then
			return false, "Bad pet id"
		end
		if seen[uid] then
			return false, "Same pet chosen twice"
		end
		seen[uid] = true
		local pet = Inventory.Find(p, uid)
		if not pet then
			return false, "You don't have that pet"
		end
		if pet.Locked then
			return false, "Locked pets can't be traded"
		end
		if busy[uid] then
			return false, "Pets on expeditions can't be traded"
		end
	end
	return true, nil
end

local function resetReady(t: TradeState)
	t.Sides[1].Ready = false
	t.Sides[2].Ready = false
	t.Status = "Open"
	t.ConfirmAt = nil
end

-- Replaces one side's offer. Any change un-readies both sides.
function Trade.SetOffer(t: TradeState, userId: number, p: Profile, uids: any, gems: any): (boolean, string?)
	if not Trade.IsActive(t) then
		return false, "Trade is closed"
	end
	local i = Trade.SideIndex(t, userId)
	if not i then
		return false, "Not in this trade"
	end
	local ok, err = Trade.ValidateOffer(p, uids, gems)
	if not ok then
		return false, err
	end
	local side = t.Sides[i]
	local list: { string } = {}
	for _, uid in uids do
		table.insert(list, uid)
	end
	side.Pets = list
	side.Gems = gems
	resetReady(t)
	return true, nil
end

function Trade.SetReady(t: TradeState, userId: number, ready: boolean, now: number): (boolean, string?)
	if not Trade.IsActive(t) then
		return false, "Trade is closed"
	end
	local i = Trade.SideIndex(t, userId)
	if not i then
		return false, "Not in this trade"
	end
	if ready then
		local a, b = t.Sides[1], t.Sides[2]
		if #a.Pets == 0 and a.Gems == 0 and #b.Pets == 0 and b.Gems == 0 then
			return false, "Add something to the trade first"
		end
	end
	t.Sides[i].Ready = ready == true
	if t.Sides[1].Ready and t.Sides[2].Ready then
		if t.Status ~= "Confirming" then
			t.Status = "Confirming"
			t.ConfirmAt = now + Config.TradeConfirmSeconds
		end
	else
		t.Status = "Open"
		t.ConfirmAt = nil
	end
	return true, nil
end

-- True when the countdown has finished and the swap should run.
function Trade.Due(t: TradeState, now: number): boolean
	local at = t.ConfirmAt
	return t.Status == "Confirming" and at ~= nil and now >= at
end

function Trade.Cancel(t: TradeState)
	if Trade.IsActive(t) then
		t.Status = "Cancelled"
		t.ConfirmAt = nil
	end
end

local function planSide(p: Profile, give: { string }, giveGems: number, get: { PetInstance }, getGems: number): SidePlan
	local drop: { [string]: boolean } = {}
	for _, uid in give do
		drop[uid] = true
	end
	local pets: { PetInstance } = {}
	local used: { [string]: boolean } = {}
	for _, pet in p.Pets do
		if not drop[pet.Uid] then
			table.insert(pets, pet)
			used[pet.Uid] = true
		end
	end
	local equipped: { string } = {}
	for _, uid in p.Equipped do
		if not drop[uid] then
			table.insert(equipped, uid)
		end
	end
	-- Incoming pets get fresh uids from the receiver's counter and arrive unlocked.
	local nextUid = p.NextUid
	local received: { PetInstance } = {}
	for _, src in get do
		local uid
		repeat
			nextUid += 1
			uid = tostring(nextUid)
		until not used[uid]
		used[uid] = true
		local pet = Profile.CopyPet(src)
		pet.Uid = uid
		pet.Locked = false
		table.insert(pets, pet)
		table.insert(received, pet)
	end
	local gems = math.min(Schema.MaxGems, p.Gems - giveGems + getGems)
	return { Pets = pets, Equipped = equipped, NextUid = nextUid, Gems = gems, Received = received }
end

local function offeredPets(p: Profile, uids: { string }): { PetInstance }
	local out: { PetInstance } = {}
	for _, uid in uids do
		local pet = Inventory.Find(p, uid)
		if pet then
			table.insert(out, pet)
		end
	end
	return out
end

-- Validates both offers against the current profiles and computes both new
-- inventories. Touches nothing. `pa` belongs to Sides[1], `pb` to Sides[2].
function Trade.Plan(t: TradeState, pa: Profile, pb: Profile): (Plan?, string?)
	if t.Status ~= "Confirming" then
		return nil, "Trade isn't confirmed"
	end
	local a, b = t.Sides[1], t.Sides[2]
	if not a.Ready or not b.Ready then
		return nil, "Both players must be ready"
	end
	local okA, errA = Trade.ValidateOffer(pa, a.Pets, a.Gems)
	if not okA then
		return nil, a.Name .. ": " .. (errA or "offer changed")
	end
	local okB, errB = Trade.ValidateOffer(pb, b.Pets, b.Gems)
	if not okB then
		return nil, b.Name .. ": " .. (errB or "offer changed")
	end
	local newCountA = #pa.Pets - #a.Pets + #b.Pets
	if #b.Pets > #a.Pets and newCountA > Economy.MaxStorage(pa) then
		return nil, a.Name .. " doesn't have room for those pets"
	end
	local newCountB = #pb.Pets - #b.Pets + #a.Pets
	if #a.Pets > #b.Pets and newCountB > Economy.MaxStorage(pb) then
		return nil, b.Name .. " doesn't have room for those pets"
	end
	local petsA = offeredPets(pa, a.Pets)
	local petsB = offeredPets(pb, b.Pets)
	return {
		A = planSide(pa, a.Pets, a.Gems, petsB, b.Gems),
		B = planSide(pb, b.Pets, b.Gems, petsA, a.Gems),
	}, nil
end

-- Journal ------------------------------------------------------------------------
-- A trade touches two profiles that are saved separately, so a crash between
-- the two saves could duplicate items. TradeService prevents that with a
-- journal record written before either profile changes:
--   1. both profiles get PendingTrade = id and are saved;
--   2. the journal (both sides' changes) is written under its own key;
--   3. each side is applied with ApplySide and saved.
-- A profile that loads with PendingTrade set replays its side from the journal
-- (or just clears the flag if no journal was written). ApplySide is idempotent
-- through AppliedTrades, so replaying twice changes nothing.

export type JournalSide = { Give: { string }, GiveGems: number, Get: { PetInstance }, GetGems: number }
export type Journal = { Id: string, Sides: { [string]: JournalSide } }

-- Builds the journal for a planned trade (keys are tostring(UserId)).
function Trade.Journal(t: TradeState, plan: Plan): Journal
	local a, b = t.Sides[1], t.Sides[2]
	local function copyList(list: { PetInstance }): { PetInstance }
		local out: { PetInstance } = {}
		for _, pet in list do
			table.insert(out, Profile.CopyPet(pet))
		end
		return out
	end
	return {
		Id = t.Id,
		Sides = {
			[tostring(a.UserId)] = { Give = table.clone(a.Pets), GiveGems = a.Gems, Get = copyList(plan.A.Received), GetGems = b.Gems },
			[tostring(b.UserId)] = { Give = table.clone(b.Pets), GiveGems = b.Gems, Get = copyList(plan.B.Received), GetGems = a.Gems },
		},
	}
end

-- Validates one side of a journal loaded from storage. Returns nil if unusable.
function Trade.SanitizeSide(raw: any): JournalSide?
	if type(raw) ~= "table" or type(raw.Give) ~= "table" or type(raw.Get) ~= "table" then
		return nil
	end
	local give: { string } = {}
	for _, uid in raw.Give do
		if type(uid) == "string" and #uid > 0 and #uid <= Schema.MaxUidLength then
			table.insert(give, uid)
		end
	end
	-- Reuse the profile sanitiser for the pets (validates ids, variants, levels).
	local tmp = Profile.Sanitize({ Pets = raw.Get })
	return {
		Give = give,
		GiveGems = Schema.ClampInt(raw.GiveGems, 0, Config.TradeMaxGems),
		Get = tmp.Pets,
		GetGems = Schema.ClampInt(raw.GetGems, 0, Config.TradeMaxGems),
	}
end

-- Applies one side of a trade to a profile. Returns false (and changes
-- nothing) if this trade was already applied. Received pets keep their uid
-- unless it is taken, arrive unlocked, and may exceed storage (the trade was
-- agreed when they fit).
function Trade.ApplySide(p: Profile, side: JournalSide, tradeId: string): boolean
	if table.find(p.AppliedTrades, tradeId) then
		if p.PendingTrade == tradeId then
			p.PendingTrade = nil
		end
		return false
	end
	Inventory.RemoveUnchecked(p, side.Give)
	local used: { [string]: boolean } = {}
	for _, pet in p.Pets do
		used[pet.Uid] = true
	end
	for _, src in side.Get do
		local pet = Profile.CopyPet(src)
		pet.Locked = false
		if used[pet.Uid] or #pet.Uid == 0 or #pet.Uid > Schema.MaxUidLength then
			pet.Uid = Inventory.NewUid(p)
		else
			local n = tonumber(pet.Uid)
			if n and Schema.IsFinite(n) and n > p.NextUid then
				p.NextUid = math.min(math.floor(n), 1e15)
			end
		end
		used[pet.Uid] = true
		table.insert(p.Pets, pet)
		p.Index[pet.Id] = true
	end
	p.Gems = math.clamp(p.Gems - side.GiveGems + side.GetGems, 0, Schema.MaxGems)
	table.insert(p.AppliedTrades, tradeId)
	while #p.AppliedTrades > Schema.MaxAppliedTrades do
		table.remove(p.AppliedTrades, 1)
	end
	if p.PendingTrade == tradeId then
		p.PendingTrade = nil
	end
	return true
end

-- Plans and applies the swap in memory (tests and the final step of the
-- journaled flow). Both profiles change, or neither does.
function Trade.Execute(t: TradeState, pa: Profile, pb: Profile): (Plan?, string?)
	local plan, err = Trade.Plan(t, pa, pb)
	if not plan then
		return nil, err
	end
	local j = Trade.Journal(t, plan)
	Trade.ApplySide(pa, j.Sides[tostring(t.Sides[1].UserId)], t.Id)
	Trade.ApplySide(pb, j.Sides[tostring(t.Sides[2].UserId)], t.Id)
	t.Status = "Done"
	t.ConfirmAt = nil
	return plan, nil
end

local function sideView(s: Side, p: Profile?): Types.TradeSide
	local pets: { PetInstance } = {}
	if p then
		for _, uid in s.Pets do
			local pet = Inventory.Find(p, uid)
			if pet then
				table.insert(pets, Profile.CopyPet(pet))
			end
		end
	end
	return { UserId = s.UserId, Name = s.Name, Pets = pets, Gems = s.Gems, Ready = s.Ready }
end

-- The window as seen by `userId`. `profileOf` looks up a side's profile.
function Trade.View(t: TradeState, userId: number, now: number, profileOf: (number) -> Profile?): Types.TradeView?
	local i = Trade.SideIndex(t, userId)
	if not i then
		return nil
	end
	local me, them = t.Sides[i], t.Sides[3 - i]
	local at = t.ConfirmAt
	return {
		Id = t.Id,
		Me = sideView(me, profileOf(me.UserId)),
		Them = sideView(them, profileOf(them.UserId)),
		Countdown = if t.Status == "Confirming" and at then math.max(0, math.ceil(at - now)) else nil,
		Status = t.Status,
	}
end

return Trade
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[--!strict
-- Builds every pet, egg, breakable and prop from primitive parts described in
-- ModelData (generated by models/gen_models.py). No uploaded meshes, so all of
-- it works in Studio immediately. See docs/CONTRACTS.md (Models section).
--
-- Every model returned here:
--   * is a fresh clone of a cached template (safe to parent and edit),
--   * has an invisible PrimaryPart "Root" (its bounding box),
--   * has its pivot at the bottom centre, facing -Z,
--   * is anchored.

local ModelData = require(script.ModelData) :: any

local Models = {}

local MATS: { [string]: Enum.Material } = {
	P = Enum.Material.SmoothPlastic,
	N = Enum.Material.Neon,
	G = Enum.Material.Glass,
	F = Enum.Material.Foil,
	M = Enum.Material.Metal,
	I = Enum.Material.Ice,
	L = Enum.Material.Glacier,
	S = Enum.Material.Snow,
	W = Enum.Material.Wood,
	K = Enum.Material.WoodPlanks,
	R = Enum.Material.Rock,
	T = Enum.Material.Slate,
	B = Enum.Material.Basalt,
	C = Enum.Material.CrackedLava,
	A = Enum.Material.Sand,
	E = Enum.Material.Grass,
	O = Enum.Material.Concrete,
	X = Enum.Material.Fabric,
	Y = Enum.Material.Marble,
	D = Enum.Material.DiamondPlate,
	Q = Enum.Material.Pebble,
	Z = Enum.Material.ForceField,
	U = Enum.Material.Cobblestone,
	H = Enum.Material.Brick,
	J = Enum.Material.Granite,
	V = Enum.Material.Sandstone,
	a = Enum.Material.Asphalt,
	g = Enum.Material.Ground,
	l = Enum.Material.LeafyGrass,
	p = Enum.Material.Plastic,
	s = Enum.Material.Salt,
	c = Enum.Material.CeramicTiles,
	m = Enum.Material.Mud,
}

-- Collision profiles.
export type Profile = { CanCollide: boolean, CanQuery: boolean, CanTouch: boolean }
Models.Profiles = {
	Pet = { CanCollide = false, CanQuery = false, CanTouch = false } :: Profile,
	Breakable = { CanCollide = true, CanQuery = true, CanTouch = false } :: Profile,
	Solid = { CanCollide = true, CanQuery = true, CanTouch = false } :: Profile,
	Ghost = { CanCollide = false, CanQuery = true, CanTouch = false } :: Profile,
}

-- Parts with these names keep their colour for Golden/Rainbow variants.
local KEEP_COLOUR = { Eye = true, Collar = true }
-- Rainbow also keeps the cream face / chest patches (see reference/puppy_variants.jpg).
local KEEP_RAINBOW = { Eye = true, Collar = true, Face = true }
-- Invisible helper parts inside props (never collide or block clicks).
local HELPER = { Prompt = true, SignFace = true, EggSpot = true, Root = true }

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local GOLD_DARK = Color3.fromRGB(166, 108, 10)
local GOLD_LIGHT = Color3.fromRGB(255, 206, 74)
local RAINBOW_HUES = { 0, 0.08, 0.15, 0.33, 0.58, 0.76 }
local GOLD_NEON = Color3.fromRGB(255, 213, 74)
local SHINY_TINT = Color3.fromRGB(255, 246, 224)

local function hexColor(c: number): Color3
	return Color3.fromRGB(bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255))
end

local function luminance(c: Color3): number
	return 0.3 * c.R + 0.59 * c.G + 0.11 * c.B
end

-- Creates one part from a data row (see the header of ModelData.luau).
-- `base` places the row; `scale` scales size and offset.
function Models.MakePart(row: { any }, base: CFrame, scale: number, profile: Profile): BasePart
	local shape = row[1] :: string
	local part: BasePart
	if shape == "W" then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if shape == "C" then
			p.Shape = Enum.PartType.Cylinder
		end
		part = p
	end
	local tag = row[13] :: string?
	part.Name = if tag and tag ~= "" then tag else "Part"
	part.Size = Vector3.new(row[2] * scale, row[3] * scale, row[4] * scale)
	part.CFrame = base
		* CFrame.new(row[5] * scale, row[6] * scale, row[7] * scale)
		* CFrame.fromEulerAnglesXYZ(math.rad(row[8]), math.rad(row[9]), math.rad(row[10]))
	part.Color = hexColor(row[11])
	part.Material = MATS[row[12] :: string] or Enum.Material.SmoothPlastic
	part.Transparency = (row[14] :: number?) or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	if shape == "S" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	if HELPER[part.Name] then
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
	else
		part.CanCollide = profile.CanCollide
		part.CanQuery = profile.CanQuery
		part.CanTouch = profile.CanTouch
		-- Tiny details do not need shadows.
		if part.Size.Magnitude < 0.6 * scale then
			part.CastShadow = false
		end
	end
	return part
end

-- Builds all rows of a data entry under `parent` (no Model wrapper).
function Models.BuildRows(rows: { any }, parent: Instance, base: CFrame, scale: number, profile: Profile): { BasePart }
	local out = table.create(#rows)
	for _, row in rows do
		local p = Models.MakePart(row, base, scale, profile)
		p.Parent = parent
		table.insert(out, p)
	end
	return out
end

local function newModel(name: string, entry: any, scale: number, profile: Profile): Model
	local m = Instance.new("Model")
	m.Name = name
	local b = entry.B
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(math.max(b[1] * scale, 0.2), math.max(b[2] * scale, 0.2), math.max(b[3] * scale, 0.2))
	root.CFrame = CFrame.new(0, b[2] * scale / 2, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = profile.CanQuery
	root.CanTouch = false
	root.CastShadow = false
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = m
	Models.BuildRows(entry.P, m, CFrame.identity, scale, profile)
	-- With a PrimaryPart the model pivot is PrimaryPart.CFrame * PivotOffset
	-- (WorldPivot is ignored), so offset it down to the bottom centre.
	root.PivotOffset = CFrame.new(0, -b[2] * scale / 2, 0)
	m.PrimaryPart = root
	return m
end

local function placeholder(name: string, profile: Profile): Model
	warn("[Models] no model data for " .. name)
	local entry: any = { B = { 2.5, 2.5, 2.5 }, P = { { "S" :: any, 2.5, 2.5, 2.5, 0, 1.25, 0, 0, 0, 0, 0xFF66CC, "P", "Body" } } }
	return newModel(name, entry, 1, profile)
end

-- Variants -----------------------------------------------------------------

local function applyGolden(m: Model)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and not KEEP_COLOUR[d.Name] then
			if d.Material == Enum.Material.Neon then
				d.Color = GOLD_NEON
			else
				local t = math.clamp(luminance(d.Color) * 0.6 + 0.3, 0, 1)
				d.Color = GOLD_DARK:Lerp(GOLD_LIGHT, t)
				d.Material = Enum.Material.Foil
				d.Reflectance = 0.08
			end
		end
	end
	m:SetAttribute("Golden", true)
end

-- Static rainbow stripes by height. Each recoloured part carries a
-- RainbowHue attribute (0..1) so the client can animate the hues.
local function applyRainbow(m: Model, height: number)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and not KEEP_RAINBOW[d.Name] then
			-- Horizontal bands (each 15% of the pet height) cycling red, orange, yellow,
			-- green, blue, purple from the top down.
			local rel = 1 - math.clamp(d.Position.Y / math.max(height, 0.01), 0, 1)
			local hue = RAINBOW_HUES[(math.floor(rel / 0.15) % 6) + 1]
			d.Color = Color3.fromHSV(hue, 0.75, 0.97)
			if d.Material ~= Enum.Material.Neon then
				d.Material = Enum.Material.SmoothPlastic
			end
			d:SetAttribute("RainbowHue", hue)
		end
	end
	m:SetAttribute("Rainbow", true)
end

local function applyShiny(m: Model)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and not KEEP_COLOUR[d.Name] then
			d.Color = d.Color:Lerp(SHINY_TINT, 0.15)
		end
	end
	local root = m.PrimaryPart :: BasePart
	local e = Instance.new("ParticleEmitter")
	e.Name = "ShinySparkles"
	e.Texture = SPARKLE_TEXTURE
	e.Rate = 7
	e.Lifetime = NumberRange.new(0.6, 1.3)
	e.Speed = NumberRange.new(0.4, 1.2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.3, 0.45),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.8),
	})
	e.Color = ColorSequence.new(Color3.fromRGB(255, 244, 170), Color3.fromRGB(255, 200, 60))
	e.LightEmission = 1
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Parent = root
	m:SetAttribute("Shiny", true)
end

-- Cache --------------------------------------------------------------------

local templates: { [string]: Model } = {}

local function cached(key: string, make: () -> Model): Model
	local t = templates[key]
	if not t then
		t = make()
		templates[key] = t
	end
	return t:Clone()
end

-- Public API ---------------------------------------------------------------

function Models.Pet(petId: string, variant: string, shiny: boolean): Model
	local key = "Pet|" .. petId .. "|" .. tostring(variant) .. "|" .. (if shiny then "1" else "0")
	return cached(key, function()
		local entry = ModelData.Pets[petId]
		local m = if entry then newModel(petId, entry, 1, Models.Profiles.Pet) else placeholder(petId, Models.Profiles.Pet)
		if variant == "Golden" then
			applyGolden(m)
		elseif variant == "Rainbow" then
			applyRainbow(m, if entry then entry.B[2] else 2.5)
		end
		if shiny then
			applyShiny(m)
		end
		m:SetAttribute("PetId", petId)
		m:SetAttribute("Variant", variant)
		return m
	end)
end

function Models.Egg(eggId: string, scale: number?): Model
	local s = scale or 1
	return cached("Egg|" .. eggId .. "|" .. s, function()
		local entry = ModelData.Eggs[eggId]
		local m = if entry then newModel(eggId, entry, s, Models.Profiles.Pet) else placeholder(eggId, Models.Profiles.Pet)
		m:SetAttribute("EggId", eggId)
		return m
	end)
end

function Models.Breakable(kind: string, areaId: string): Model
	return cached("Breakable|" .. kind .. "|" .. areaId, function()
		local byArea = ModelData.Breakables[areaId] or ModelData.Breakables.Meadow
		local entry = byArea and byArea[kind]
		local m = if entry
			then newModel(kind, entry, 1, Models.Profiles.Breakable)
			else placeholder(kind, Models.Profiles.Breakable)
		m:SetAttribute("Kind", kind)
		m:SetAttribute("Area", areaId)
		return m
	end)
end

-- Props (decorations and interactable bodies). Not part of the gameplay
-- contract; used by World.luau and available to the client for effects.
function Models.Prop(name: string, scale: number?): Model
	local s = scale or 1
	return cached("Prop|" .. name .. "|" .. s, function()
		local entry = ModelData.Props[name]
		if not entry then
			return placeholder(name, Models.Profiles.Solid)
		end
		return newModel(name, entry, s, if entry.C then Models.Profiles.Solid else Models.Profiles.Ghost)
	end)
end

-- Raw prop entry ({ B, C, P }) or nil.
function Models.PropData(name: string): any
	return ModelData.Props[name]
end

-- True when the generator produced data for this pet / egg / breakable.
function Models.HasPet(petId: string): boolean
	return ModelData.Pets[petId] ~= nil
end

function Models.HasEgg(eggId: string): boolean
	return ModelData.Eggs[eggId] ~= nil
end

return Models
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ModelData</string>
            <string name="Source"><![CDATA[--!nocheck
-- GENERATED by models/gen_models.py. Do not edit by hand; edit the generator and re-run it.
-- Pure data (no Roblox types). Each part row:
--   { shape, sizeX, sizeY, sizeZ, posX, posY, posZ, rotX, rotY, rotZ, colour, material, tag?, transparency? }
-- shape: "B" block, "S" sphere mesh (ellipsoid), "C" cylinder (axis X), "W" wedge.
-- rot: degrees for CFrame.fromEulerAnglesXYZ. material: code, see MATS in Models/init.luau.
-- Positions are relative to the model pivot (bottom centre, facing -Z). B = bounding box size.
return {
	Pets = {
		Puppy = { B = {2.641,2.6,2.3}, P = {
			{"B",0.384,0.426,0.398,0.309,0.247,-0.21,0,0,0,0xE7B57A,"P"},
			{"B",0.426,0.206,0.453,0.309,0.103,-0.23,0,0,0,0xFFF3DC,"P"},
			{"B",0.384,0.426,0.398,0.309,0.247,0.518,0,0,0,0xE7B57A,"P"},
			{"B",0.426,0.206,0.453,0.309,0.103,0.497,0,0,0,0xFFF3DC,"P"},
			{"B",0.384,0.426,0.398,-0.309,0.247,-0.21,0,0,0,0xE7B57A,"P"},
			{"B",0.426,0.206,0.453,-0.309,0.103,-0.23,0,0,0,0xFFF3DC,"P"},
			{"B",0.384,0.426,0.398,-0.309,0.247,0.518,0,0,0,0xE7B57A,"P"},
			{"B",0.426,0.206,0.453,-0.309,0.103,0.497,0,0,0,0xFFF3DC,"P"},
			{"B",1.03,0.395,1.167,0,0.589,0.154,0,0,0,0xE7B57A,"P","Body"},
			{"B",1.03,0.395,1.167,0,0.983,0.154,0,0,0,0xE7B57A,"P","Body"},
			{"B",0.638,0.592,0.055,0,0.752,-0.45,0,0,0,0xFFF3DC,"P","Face"},
			{"B",1.784,0.48,1.51,0,1.283,-0.258,0,0,0,0xE7B57A,"P","Body"},
			{"B",1.784,0.48,1.51,0,1.764,-0.258,0,0,0,0xE7B57A,"P","Body"},
			{"B",1.784,0.48,1.51,0,2.244,-0.258,0,0,0,0xE7B57A,"P","Body"},
			{"B",0.755,0.549,0.055,0,1.352,-1.04,0,0,0,0xFFF3DC,"P","Face"},
			{"B",0.206,0.515,0.055,0,1.805,-1.04,0,0,0,0xFFF3DC,"P","Face"},
			{"C",0.041,0.549,0.549,-0.467,1.819,-1.047,90,0,90,0x15121C,"P","Eye"},
			{"C",0.027,0.198,0.198,-0.379,1.912,-1.088,90,0,90,0xFFFFFF,"N","Eye"},
			{"C",0.027,0.088,0.088,-0.549,1.72,-1.088,90,0,90,0xFFFFFF,"N","Eye"},
			{"C",0.041,0.275,0.275,-0.673,1.407,-1.04,90,0,90,0xFF8FA8,"P","Eye"},
			{"C",0.041,0.549,0.549,0.467,1.819,-1.047,90,0,90,0x15121C,"P","Eye"},
			{"C",0.027,0.198,0.198,0.555,1.912,-1.088,90,0,90,0xFFFFFF,"N","Eye"},
			{"C",0.027,0.088,0.088,0.384,1.72,-1.088,90,0,90,0xFFFFFF,"N","Eye"},
			{"C",0.041,0.275,0.275,0.673,1.407,-1.04,90,0,90,0xFF8FA8,"P","Eye"},
			{"S",0.22,0.151,0.124,0,1.544,-1.088,0,0,0,0x1E1A22,"P","Eye"},
			{"C",0.034,0.384,0.384,0,1.325,-1.075,90,0,90,0x5A1E2A,"P","Eye"},
			{"B",0.453,0.199,0.041,0,1.424,-1.088,0,0,0,0xFFF3DC,"P","Face"},
			{"C",0.027,0.206,0.206,0,1.229,-1.095,90,0,90,0xFF6F86,"P","Eye"},
			{"B",0.343,1.03,0.686,1.03,2.059,-0.224,0,0,14,0x9A6235,"P"},
			{"B",0.343,1.03,0.686,-1.03,2.059,-0.224,0,0,-14,0x9A6235,"P"},
			{"B",0.288,0.48,0.288,0,1.026,0.737,-35,0,0,0xE7B57A,"P"},
			{"B",0.275,0.377,0.275,0,1.335,0.929,-35,0,0,0xE7B57A,"P"},
			{"B",1.126,0.192,0.686,0,1.078,-0.121,0,0,0,0xE03A44,"P","Collar"},
			{"S",0.247,0.247,0.247,0,0.927,-0.484,0,0,0,0xFFC93C,"F","Collar"},
		} },
		Kitten = { B = {1.863,2.9,2.211}, P = {
			{"B",0.362,0.401,0.375,0.291,0.233,-0.22,0,0,0,0xF59A3A,"P"},
			{"B",0.401,0.194,0.427,0.291,0.097,-0.239,0,0,0,0xFFF3DC,"P"},
			{"B",0.362,0.401,0.375,0.291,0.233,0.466,0,0,0,0xF59A3A,"P"},
			{"B",0.401,0.194,0.427,0.291,0.097,0.446,0,0,0,0xFFF3DC,"P"},
			{"B",0.362,0.401,0.375,-0.291,0.233,-0.22,0,0,0,0xF59A3A,"P"},
