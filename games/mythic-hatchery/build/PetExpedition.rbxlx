          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Craft</string>
              <string name="Source"><![CDATA[--!strict
-- Crafting machine: lists every group of matching pets (same species,
-- variant and shininess) and turns Config.CraftCost of them into the next
-- variant (Normal -> Golden -> Rainbow). Always succeeds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Viewport = require("../UI/Viewport")
local Inventory = require("./Inventory")

type PetInstance = Types.PetInstance

local Craft = {}

local win: Windows.Window
local list: ScrollingFrame
local note: TextLabel
local lastSig = ""

local function render()
	if not win.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	local busy = State.BusyUids()
	local trading = State.TradeUids()
	type Group = { Key: string, Sample: PetInstance, Count: number }
	local groups: { [string]: Group } = {}
	for _, p in d.Pets do
		if PetInfo.NextVariant(p.Variant) and not p.Locked and not busy[p.Uid] and not trading[p.Uid] then
			local key = PetInfo.CraftKey(p)
			local g = groups[key]
			if g then
				g.Count += 1
			else
				groups[key] = { Key = key, Sample = p, Count = 1 }
			end
		end
	end
	local arr: { Group } = {}
	local sig = tostring(PetInfo.ScaleArea()) .. "|"
	for _, g in groups do
		table.insert(arr, g)
	end
	table.sort(arr, function(a, b)
		local ra, rb = a.Count >= Config.CraftCost, b.Count >= Config.CraftCost
		if ra ~= rb then
			return ra
		end
		local pa, pb = PetInfo.Power(a.Sample), PetInfo.Power(b.Sample)
		if pa ~= pb then
			return pa > pb
		end
		return a.Key < b.Key
	end)
	for _, g in arr do
		sig ..= g.Key .. g.Count .. ";"
	end
	if sig == lastSig then
		return
	end
	lastSig = sig
	Kit.clear(list)
	note.Visible = #arr == 0
	for i, g in arr do
		local p = g.Sample
		local nextVariant = PetInfo.NextVariant(p.Variant) or "Golden"
		local rc = Theme.RarityColor(PetInfo.Rarity(p.Id))
		local ready = g.Count >= Config.CraftCost
		local row = Kit.panel({
			Size = UDim2.new(1, -10, 0, 92),
			LayoutOrder = i,
			BackgroundColor3 = if ready then Theme.Lighten(Theme.Variant[nextVariant] or rc, 0.7) else Theme.Colors.Panel,
			Parent = list,
		})
		Viewport.Pet(p.Id, p.Variant, p.Shiny, { Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(6, 6), Parent = row })
		Kit.fitLabel("➜", 34, { Size = UDim2.fromOffset(40, 80), Position = UDim2.fromOffset(88, 6), Parent = row })
		Viewport.Pet(p.Id, nextVariant, p.Shiny, { Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(128, 6), Parent = row })
		Kit.fitLabel(PetInfo.FullName(p) .. "  ➜  " .. nextVariant, 22, {
			Size = UDim2.new(1, -460, 0, 32),
			Position = UDim2.fromOffset(218, 8),
			Align = "Left",
			Parent = row,
		})
		local bar, set = Kit.bar({ Size = UDim2.new(1, -460, 0, 26), Position = UDim2.fromOffset(218, 50) }, if ready then Theme.Colors.Good else Theme.Colors.Info)
		bar.Parent = row
		set(g.Count / Config.CraftCost, math.min(g.Count, Config.CraftCost) .. "/" .. Config.CraftCost .. (if g.Count > Config.CraftCost then "  (have " .. g.Count .. ")" else ""))
		local b = Kit.button(Theme.Icons.Craft .. " Craft  " .. Theme.Icons.Boost .. Format.num(PetInfo.Power({
			Uid = "",
			Id = p.Id,
			Variant = nextVariant,
			Shiny = p.Shiny,
			Level = 1,
			Xp = 0,
			Locked = false,
		})), "Purple", {
			Size = UDim2.fromOffset(220, 64),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Parent = row,
		}, function()
			Inventory.Craft(p)
		end)
		if not ready then
			Kit.setButton(b, { Enabled = false })
		end
	end
end

function Craft.Init()
	win = Windows.Create("Craft", { Title = "Craft Golden & Rainbow", Icon = Theme.Icons.Craft, Color = Theme.Tones.Purple.Top })
	Kit.fitLabel("Combine " .. Config.CraftCost .. " matching pets into one stronger pet. Locked pets and pets on expeditions are skipped.", 18, {
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontBody,
		Color = Theme.Colors.TextDim,
		Parent = win.Body,
	})
	list = Kit.scroll({
		Size = UDim2.new(1, 0, 1, -38),
		Position = UDim2.fromOffset(0, 38),
		Parent = win.Body,
	}, { Kit.list(Enum.FillDirection.Vertical, 8), Kit.pad(4, 6, 6, 4) })
	note = Kit.fitLabel("No pets to craft yet. Hatch more of the same pet!", 22, {
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 150),
		Color = Theme.Colors.TextDim,
		Visible = false,
		Parent = win.Body,
	})
	win.Opened:Connect(function()
		lastSig = ""
		render()
	end)
	State.Changed:Connect(render)
end

return Craft
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Studio-only DEV panel: quick test shortcuts (coins, gems, finish
-- expeditions, open gates, reset data) through the DevAction remote. Not
-- created at all outside Studio, and the server refuses it there too.

local RunService = game:GetService("RunService")

local Remote = require("../Core/Remote")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Toasts = require("../UI/Toasts")

local DevPanel = {}

type Action = { Key: string, Label: string, Tone: string, Confirm: string? }

local ACTIONS: { Action } = {
	{ Key = "Coins1M", Label = Theme.Icons.Coins .. " +1M coins", Tone = "Yellow" },
	{ Key = "CoinsX1000", Label = Theme.Icons.Coins .. " Coins x1000", Tone = "Yellow" },
	{ Key = "Gems1000", Label = Theme.Icons.Gems .. " +1000 gems", Tone = "Cyan" },
	{ Key = "FinishExpeditions", Label = Theme.Icons.Expeditions .. " Finish expeditions", Tone = "Green" },
	{ Key = "OpenGates", Label = Theme.Icons.Islands .. " Open all gates", Tone = "Blue" },
	{ Key = "ResetData", Label = "🗑 Reset my data", Tone = "Red", Confirm = "Wipe your Studio test profile and start fresh? (Studio saves use a separate DataStore, live data is never touched.)" },
}

local function run(a: Action)
	local res = Remote.CallOnce("DevAction", a.Key)
	if res then
		Sounds.Play("Reward")
		Toasts.Show("DEV: " .. tostring(res.message or a.Key), "purple")
	end
end

function DevPanel.Init()
	if not RunService:IsStudio() then
		return
	end
	local win = Windows.Create("Dev", { Title = "DEV (Studio only)", Icon = "🛠", Color = Theme.Rarity.Mythic, Size = Vector2.new(640, 420) })
	local grid = Kit.box({ Size = UDim2.fromScale(1, 1), Parent = win.Body }, { Kit.grid(Vector2.new(296, 92), 12) })
	for i, a in ACTIONS do
		Kit.button(a.Label, a.Tone, { LayoutOrder = i, TextSize = 22, Parent = grid }, function()
			local text = a.Confirm
			if text then
				Windows.Confirm("Are you sure?", text, "Reset", "Red", function()
					run(a)
				end)
			else
				run(a)
			end
		end)
	end
	local btn = Kit.button("DEV", "Pink", {
		Name = "DevButton",
		Size = UDim2.fromOffset(80, 44),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -150),
		TextSize = 20,
		Parent = Windows.Gui("Hud"),
	}, function()
		Windows.Toggle("Dev")
	end)
	Kit.autoScale(btn, 1)
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Expeditions</string>
              <string name="Source"><![CDATA[--!strict
-- Expeditions (the idle loop): slots with live countdowns, Claim with a
-- reward reveal, Skip for gems, locked slots that offer the MoreExpeditions
-- pass, and a 3-step start flow: island -> duration -> up to 3 unequipped pets.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Areas = require(Shared:WaitForChild("Areas"))
local Types = require(Shared:WaitForChild("Types"))
local ExpeditionLogic = require(Shared:WaitForChild("Logic"):WaitForChild("Expedition"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Viewport = require("../UI/Viewport")
local PetCard = require("../UI/PetCard")
local Toasts = require("../UI/Toasts")
local Shop = require("./Shop")

type PetInstance = Types.PetInstance
type Expedition = Types.Expedition

local Expeditions = {}

local EXTRA_SLOTS_FROM_PASS = 2

local win: Windows.Window
local header: Frame
local stepLabel: TextLabel
local backBtn: TextButton
local content: ScrollingFrame
local footer: Frame
local listLayout: UIListLayout
local gridLayout: UIGridLayout

local view = "Slots" -- Slots | Area | Duration | Pets
local draft = { Area = "", Duration = "", Pets = {} :: { string } }
local tickers: { () -> () } = {}
local renderedSig = ""

local function durationDef(key: string)
	for _, d in Config.ExpeditionDurations do
		if d.Key == key then
			return d
		end
	end
	return Config.ExpeditionDurations[1]
end

-- Same price the server charges (Logic/Expedition).
local function skipCost(exp: Expedition): number
	return ExpeditionLogic.SkipCost(exp :: any, State.Now())
end

local function estimateCoins(areaId: string, durationKey: string, uids: { string }): number
	local a = Areas.ById[areaId]
	local dd = durationDef(durationKey)
	local power = 0
	for _, uid in uids do
		local p = State.PetByUid(uid)
		if p then
			power += PetInfo.Power(p)
		end
	end
	return power * Config.ExpeditionCoinsPerPower * (if a then a.CoinMult else 1) * dd.Mult
end

local function render() end -- assigned below

local function setView(v: string)
	view = v
	renderedSig = ""
	render()
end

-- Reward reveal popup -------------------------------------------------------------

local function showReward(reward: { [string]: any })
	local gui = Windows.Gui("Popups")
	local shade: TextButton = Kit.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.Backdrop,
		BackgroundTransparency = 0.4,
		Size = UDim2.new(1, 0, 1, 200),
		Position = UDim2.fromOffset(0, -100),
		Parent = gui,
	})
	local box = Kit.panel({
		Size = UDim2.fromOffset(620, 400),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Corner = 20,
		StrokeThickness = 4,
		Parent = shade,
	})
	Kit.autoScale(box, 1)
	Kit.fitLabel(Theme.Icons.Expeditions .. " Expedition complete!", 34, { Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 10), Parent = box })
	local items = Kit.scroll({
		Size = UDim2.new(1, -30, 1, -150),
		Position = UDim2.fromOffset(15, 66),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		Parent = box,
	}, { Kit.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local order = 0
	local function tile(icon: string, text: string, color: Color3)
		order += 1
		local t = Kit.panel({ Size = UDim2.fromOffset(130, 150), LayoutOrder = order, BackgroundColor3 = Theme.Lighten(color, 0.7), Parent = items })
		Kit.fitLabel(icon, 54, { Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromOffset(0, 12), Parent = t })
		Kit.fitLabel(text, 24, { Size = UDim2.new(1, -10, 0, 40), Position = UDim2.fromOffset(5, 98), Outline = Theme.Darken(color, 0.5), Color = color, Parent = t })
		Kit.pop(t, 0.3)
	end
	if type(reward.Coins) == "number" and reward.Coins > 0 then
		tile(Theme.Icons.Coins, "+" .. Format.num(reward.Coins), Theme.Colors.Coins)
	end
	if type(reward.Gems) == "number" and reward.Gems > 0 then
		tile(Theme.Icons.Gems, "+" .. Format.num(reward.Gems), Theme.Colors.Gems)
	end
	if type(reward.Boost) == "string" then
		local def = Config.Boosts[reward.Boost]
		tile(Theme.Icons.Boost, if def then def.Name else reward.Boost, Theme.Colors.Luck)
	end
	if type(reward.Pets) == "table" then
		for _, p in reward.Pets do
			if type(p) == "table" and type(p.Id) == "string" then
				order += 1
				local card = PetCard.new(p :: PetInstance, Vector2.new(130, 150))
				card.LayoutOrder = order
				card.Parent = items
				Kit.pop(card, 0.3)
				local species = PetInfo.Species(p.Id)
				if species and species.Source == "Expedition" then
					Toasts.Show(Theme.Icons.Star .. " Rare find: <b>" .. PetInfo.FullName(p :: PetInstance) .. "</b>!", "gold", { PetId = p.Id, Variant = p.Variant, Shiny = p.Shiny })
				end
			end
		end
	end
	if order == 0 then
		tile("🍃", "Nothing this time", Theme.Colors.TextDim)
	end
	Sounds.Play("Reward")
	Kit.button("Yay!", "Green", {
		Size = UDim2.fromOffset(220, 64),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Parent = box,
	}, function()
		shade:Destroy()
	end)
	Kit.pop(box)
end

-- Slots view --------------------------------------------------------------------

local function claim(slot: number)
	local res, err = Remote.Try("ClaimExpedition", slot)
	if res then
		showReward(if type(res.reward) == "table" then res.reward else {})
	elseif err then
		local d = State.Data
		local full = d ~= nil and #d.Pets >= d.MaxStorage - Config.MaxPetsPerExpedition
		Toasts.Show(err .. (if full then "\nFree some space: delete or craft pets in " .. Theme.Icons.Pets .. " Pets." else ""), "bad", { Duration = 5 })
	end
end

local function skip(slot: number, e: Expedition)
	local left = e.EndAt - State.Now()
	local cost = skipCost(e)
	Windows.Confirm(
		"Finish now?",
		"Skip the remaining " .. Format.time(left) .. " for " .. Theme.Icons.Gems .. " <b>" .. cost .. "</b> gems.",
		"Skip " .. Theme.Icons.Gems .. cost,
		"Cyan",
		function()
			Remote.CallOnce("SkipExpedition", slot)
		end
	)
end

local function slotRow(slot: number, e: Expedition?, order: number)
	local row = Kit.panel({
		Size = UDim2.new(1, -10, 0, 120),
		LayoutOrder = order,
		BackgroundColor3 = if e then Theme.Colors.Panel else Theme.Colors.PanelAlt,
		Parent = content,
	})
	Kit.fitLabel("#" .. slot, 26, { Size = UDim2.fromOffset(50, 40), Position = UDim2.fromOffset(8, 8), Color = Theme.Colors.TextDim, Parent = row })
	if not e then
		Kit.fitLabel("Free slot. Send pets to explore an island!", 22, {
			Size = UDim2.new(1, -360, 0, 60),
			Position = UDim2.fromOffset(60, 30),
			Align = "Left",
			Color = Theme.Colors.TextDim,
			Parent = row,
		})
		Kit.button(Theme.Icons.Expeditions .. " Start", "Green", {
			Size = UDim2.fromOffset(240, 70),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Parent = row,
		}, function()
			draft.Area = ""
			draft.Duration = ""
			draft.Pets = {}
			setView("Area")
		end)
		return
	end
	local exp = e :: Expedition
	local a = Areas.ById[exp.Area]
	local dd = durationDef(exp.Duration)
	Kit.fitLabel((if a then a.Name else exp.Area) .. "  ·  " .. Format.duration(dd.Seconds), 22, {
		Size = UDim2.new(1, -560, 0, 30),
		Position = UDim2.fromOffset(60, 10),
		Align = "Left",
		Parent = row,
	})
	local pics = Kit.box({ Size = UDim2.fromOffset(210, 70), Position = UDim2.fromOffset(60, 44), Parent = row }, {
		Kit.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Left),
	})
	for i, uid in exp.Pets do
		local p = State.PetByUid(uid)
		if p then
			Viewport.Pet(p.Id, p.Variant, p.Shiny, { Size = UDim2.fromOffset(66, 66), LayoutOrder = i, Parent = pics })
		end
	end
	local bar, set = Kit.bar({ Size = UDim2.fromOffset(240, 32), Position = UDim2.fromOffset(280, 58) }, Theme.Colors.Good)
	bar.Parent = row
	local btn = Kit.button("", "Green", {
		Size = UDim2.fromOffset(240, 70),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Parent = row,
	}, function()
		if State.Now() >= exp.EndAt then
			claim(slot)
		else
			skip(slot, exp)
		end
	end)
	local wasDone: boolean? = nil
	local function tick()
		local now = State.Now()
		local total = math.max(1, exp.EndAt - exp.StartAt)
		local left = exp.EndAt - now
		local done = left <= 0
		set(1 - math.max(0, left) / total, if done then "Done!" else Format.time(left))
		if done ~= wasDone then
			wasDone = done
			if done then
				Kit.setButton(btn, { Text = Theme.Icons.Gift .. " Claim!", Tone = "Green" })
				Kit.pop(btn, 1.2)
			end
		end
		if not done then
			Kit.setButton(btn, { Text = "Skip " .. Theme.Icons.Gems .. skipCost(exp), Tone = "Cyan" })
		end
	end
	tick()
	table.insert(tickers, tick)
end

local function lockedRow(order: number)
	local row = Kit.panel({
		Size = UDim2.new(1, -10, 0, 90),
		LayoutOrder = order,
		BackgroundColor3 = Theme.Colors.PanelDark,
		Parent = content,
	})
	Kit.fitLabel(Theme.Icons.Lock .. " Extra slot", 24, {
		Size = UDim2.new(1, -320, 0, 60),
		Position = UDim2.fromOffset(20, 15),
		Align = "Left",
		Color = Theme.Colors.TextDim,
		Parent = row,
	})
	Kit.button("Unlock +" .. EXTRA_SLOTS_FROM_PASS .. " slots", "Purple", {
		Size = UDim2.fromOffset(260, 64),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Parent = row,
	}, function()
		Shop.Upsell("MoreExpeditions", "Run more expeditions at the same time!")
	end)
end

-- Start flow views -----------------------------------------------------------------

local function areaCards()
	local d = State.Data
	if not d then
		return
	end
	for i, a in Areas.List do
		local open = d.Areas[a.Id] == true
		local card = Kit.panel({
			Size = UDim2.fromOffset(250, 210),
			LayoutOrder = i,
			BackgroundColor3 = if open then Theme.Colors.Panel else Theme.Colors.PanelDark,
			Parent = content,
		})
		Kit.fitLabel(a.Name, 24, { Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 6), Parent = card })
		local found = d.Index[a.ExpeditionPet] == true
		Viewport.Pet(a.ExpeditionPet, "Normal", false, {
			Size = UDim2.fromOffset(100, 100),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 38),
			Silhouette = not found,
			Parent = card,
		})
		Kit.fitLabel((if found then PetInfo.Name(a.ExpeditionPet) else "???") .. " can be found here", 15, {
			Size = UDim2.new(1, -16, 0, 22),
			Position = UDim2.fromOffset(8, 138),
			Font = Theme.FontBody,
			Color = Theme.Colors.TextDim,
			Parent = card,
		})
		local b = Kit.button(if open then "Choose" else Theme.Icons.Lock .. " Locked", if open then "Green" else "Grey", {
			Size = UDim2.new(1, -24, 0, 44),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			TextSize = 20,
			Parent = card,
		}, function()
			if not open then
				Toasts.Show("Open " .. a.Name .. " first!", "info")
				return
			end
			draft.Area = a.Id
			setView("Duration")
		end)
		if not open then
			Kit.setButton(b, { Tone = "Grey" })
		end
	end
end

local function durationCards()
	for i, dd in Config.ExpeditionDurations do
		local card = Kit.panel({
			Size = UDim2.fromOffset(250, 210),
			LayoutOrder = i,
			Parent = content,
		})
		Kit.fitLabel(Theme.Icons.Clock .. " " .. Format.duration(dd.Seconds), 30, { Size = UDim2.new(1, -16, 0, 40), Position = UDim2.fromOffset(8, 6), Parent = card })
		local eggChance = math.min(1, Config.ExpeditionEggChance * dd.Mult)
		Kit.fitLabel(string.format(
			"%s x%d rewards\n%s Rare pet %s\n%s Gems %s\n%s Free egg %s",
			Theme.Icons.Coins,
			dd.Mult,
			Theme.Icons.Star,
			Format.percent(dd.FindChance * 100),
			Theme.Icons.Gems,
			Format.percent(dd.GemChance * 100),
			Theme.Icons.Egg,
			Format.percent(eggChance * 100)
		), 18, {
			Size = UDim2.new(1, -24, 0, 100),
			Position = UDim2.fromOffset(12, 48),
			Font = Theme.FontBody,
			Align = "Left",
			Parent = card,
		})
		Kit.button("Choose", "Green", {
			Size = UDim2.new(1, -24, 0, 44),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			TextSize = 20,
			Parent = card,
		}, function()
			draft.Duration = dd.Key
			draft.Pets = {}
			setView("Pets")
		end)
	end
end

local sendBtn: TextButton? = nil
local estimateLabel: TextLabel? = nil

local function refreshSend()
	local n = #draft.Pets
	if sendBtn then
		Kit.setButton(sendBtn, { Text = "Send " .. n .. "/" .. Config.MaxPetsPerExpedition, Enabled = n > 0 })
	end
	if estimateLabel then
		estimateLabel.Text = "Expected about " .. Theme.Icons.Coins .. " <b>" .. Format.num(estimateCoins(draft.Area, draft.Duration, draft.Pets)) .. "</b> coins"
	end
end

local function petPicker()
	local d = State.Data
	if not d then
		return
	end
	local busy = State.BusyUids()
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	local trading = State.TradeUids()
	local list: { PetInstance } = {}
	for _, p in d.Pets do
		if not busy[p.Uid] and not trading[p.Uid] then
			table.insert(list, p)
		end
	end
	-- unequipped pets first; equipped ones can go too (the server unequips them)
	local power: { [string]: number } = {}
	for _, p in list do
		power[p.Uid] = PetInfo.Power(p)
	end
	table.sort(list, function(a, b)
		local ea, eb = eq[a.Uid] == true, eq[b.Uid] == true
		if ea ~= eb then
			return eb
		end
		if power[a.Uid] ~= power[b.Uid] then
			return power[a.Uid] > power[b.Uid]
		end
		return a.Uid < b.Uid
	end)
	if #list == 0 then
		Kit.fitLabel("No free pets. Hatch more!", 22, {
			Size = UDim2.new(1, 0, 0, 60),
			Color = Theme.Colors.TextDim,
			Parent = content,
		})
	end
	local cardsByUid: { [string]: TextButton } = {}
	for i, p in list do
		local uid = p.Uid
		local card = PetCard.new(p, Vector2.new(100, 118), function()
			local idx = table.find(draft.Pets, uid)
			if idx then
				table.remove(draft.Pets, idx)
			elseif #draft.Pets >= Config.MaxPetsPerExpedition then
				Toasts.Show("Up to " .. Config.MaxPetsPerExpedition .. " pets per expedition.", "info")
				return
			else
				table.insert(draft.Pets, uid)
			end
			for u, c in cardsByUid do
				PetCard.SetFlags(c, { Selected = table.find(draft.Pets, u) ~= nil, Locked = (State.PetByUid(u) or p).Locked, Equipped = eq[u] == true })
			end
			refreshSend()
		end)
		card.LayoutOrder = i
		card.Parent = content
		cardsByUid[uid] = card
		PetCard.SetFlags(card, { Selected = table.find(draft.Pets, uid) ~= nil, Locked = p.Locked, Equipped = eq[uid] == true })
	end
end

local function renderImpl()
	if not win.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	-- the slots view rebuilds only when the expeditions themselves change
	local sig = view
	if view == "Slots" then
		sig ..= "|" .. d.ExpeditionSlots .. "|" .. tostring(State.HasPass("MoreExpeditions"))
		for k, e in d.Expeditions do
			sig ..= k .. e.Area .. e.EndAt .. table.concat(e.Pets, ",")
		end
	end
	if sig == renderedSig then
		return
	end
	renderedSig = sig
	table.clear(tickers)
	Kit.clear(content)
	Kit.clear(footer)
	sendBtn = nil
	estimateLabel = nil
	local layout = gridLayout
	backBtn.Visible = view ~= "Slots"
	footer.Visible = view == "Pets"
	if view == "Slots" then
		layout.Parent = nil
		listLayout.Parent = content
		content.Size = UDim2.new(1, 0, 1, -60)
		stepLabel.Text = "Your expeditions"
		for slot = 1, d.ExpeditionSlots do
			slotRow(slot, d.Expeditions[tostring(slot)], slot)
		end
		if not State.HasPass("MoreExpeditions") then
			for i = 1, EXTRA_SLOTS_FROM_PASS do
				lockedRow(100 + i)
			end
		end
	else
		listLayout.Parent = nil
		layout.Parent = content
		content.Size = UDim2.new(1, 0, 1, if view == "Pets" then -140 else -60)
		if view == "Area" then
			stepLabel.Text = "1/3  Pick an island"
			layout.CellSize = UDim2.fromOffset(250, 210)
			areaCards()
		elseif view == "Duration" then
			local a = Areas.ById[draft.Area]
			stepLabel.Text = "2/3  How long? (" .. (if a then a.Name else "") .. ")"
			layout.CellSize = UDim2.fromOffset(250, 210)
			durationCards()
		else
			stepLabel.Text = "3/3  Pick up to " .. Config.MaxPetsPerExpedition .. " pets (equipped ones get unequipped)"
			layout.CellSize = UDim2.fromOffset(100, 118)
			petPicker()
			estimateLabel = Kit.fitLabel("", 22, {
				Size = UDim2.new(1, -280, 1, 0),
				Align = "Left",
				Rich = true,
				Parent = footer,
			})
			sendBtn = Kit.button("Send", "Green", {
				Size = UDim2.fromOffset(250, 66),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -4, 0.5, 0),
				Parent = footer,
			}, function()
				if #draft.Pets == 0 then
					return
				end
				local res = Remote.CallOnce("StartExpedition", draft.Area, draft.Duration, table.clone(draft.Pets))
				if res then
					Sounds.Play("Reward")
					Toasts.Show(Theme.Icons.Expeditions .. " Your pets set off! Come back in " .. Format.duration(durationDef(draft.Duration).Seconds) .. ".", "good")
					draft.Pets = {}
					setView("Slots")
				end
			end)
			refreshSend()
		end
	end
end
render = renderImpl

function Expeditions.Init()
	win = Windows.Create("Expeditions", { Title = "Expeditions", Icon = Theme.Icons.Expeditions, Color = Theme.Tones.Green.Rim })
	header = Kit.box({ Size = UDim2.new(1, 0, 0, 52), Parent = win.Body })
	backBtn = Kit.button("◀ Back", "White", { Size = UDim2.fromOffset(130, 50), Parent = header }, function()
		if view == "Pets" then
			setView("Duration")
		elseif view == "Duration" then
			setView("Area")
		else
			setView("Slots")
		end
	end)
	stepLabel = Kit.fitLabel("", 26, {
		Size = UDim2.new(1, -150, 1, 0),
		Position = UDim2.fromOffset(146, 0),
		Align = "Left",
		Parent = header,
	})
	content = Kit.scroll({
		Size = UDim2.new(1, 0, 1, -60),
		Position = UDim2.fromOffset(0, 60),
		Parent = win.Body,
	}, { Kit.pad(4, 8, 6, 4) })
	-- slots use a list, the start flow a grid; only one is parented at a time
	listLayout = Kit.list(Enum.FillDirection.Vertical, 10)
	gridLayout = Kit.grid(Vector2.new(250, 210), 12)
	listLayout.Parent = content
	footer = Kit.box({
		Size = UDim2.new(1, 0, 0, 74),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Visible = false,
		Parent = win.Body,
	})
	win.Opened:Connect(function(which: string?)
		if which == "Start" then
			setView("Area")
		else
			setView("Slots")
		end
	end)
	State.Changed:Connect(function()
		if view == "Slots" then
			render()
		end
	end)
	task.spawn(function()
		while true do
			if win.IsOpen then
				for _, t in tickers do
					t()
				end
			end
			task.wait(0.5)
		end
	end)
end

return Expeditions
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Farming</string>
              <string name="Source"><![CDATA[--!strict
-- Farming: tap/click a breakable to send your pets (SetTarget), tap it again
-- or tap the ground to call them back. Selection highlight, HP bars, break
-- pops (Notify Broken) and floating rewards with coins flying to the HUD
-- (Notify Reward).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Breakables = require("../Core/Breakables")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Toasts = require("../UI/Toasts")
local Hud = require("./Hud")

local Farming = {}

local player = Players.LocalPlayer
local fxFolder: Folder
local highlight: Highlight
local localTarget: string? = nil
type Bar = { Gui: BillboardGui, Set: (number, string?) -> () }
local bars: { [string]: Bar } = {}

-- Fired when the local player picks a target (for the tutorial).
Farming.OnTarget = nil :: ((id: string) -> ())?

local function character(): (Model?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	return char, char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function currentTarget(): string?
	local t = player:GetAttribute("Target")
	if type(t) == "string" and t ~= "" then
		return t
	end
	return nil
end

local function refreshHighlight()
	local id = localTarget or currentTarget()
	local info = Breakables.Get(id)
	if info then
		highlight.Adornee = info.Model
		highlight.Enabled = true
	else
		highlight.Adornee = nil
		highlight.Enabled = false
	end
end

-- HP bars -------------------------------------------------------------------

local function ensureBar(info: Breakables.Info): Bar?
	local existing = bars[info.Id]
	if existing then
		return existing
	end
	local adornee = info.Model.PrimaryPart or info.Model:FindFirstChildWhichIsA("BasePart", true)
	if not adornee then
		return nil
	end
	local gui: BillboardGui = Kit.new("BillboardGui", {
		Name = "HpBar",
		Adornee = adornee,
		Size = UDim2.fromOffset(120, 22),
		StudsOffsetWorldSpace = Vector3.new(info.Center.X, info.Center.Y + info.Size.Y / 2 + 1.4, info.Center.Z) - (adornee :: BasePart).Position,
		AlwaysOnTop = false,
		MaxDistance = 90,
		LightInfluence = 0,
		ResetOnSpawn = false,
	})
	local _, set = Kit.bar({ Size = UDim2.fromScale(1, 1), Parent = gui }, Theme.Colors.Good)
	gui.Parent = info.Model
	local entry: Bar = { Gui = gui, Set = set }
	bars[info.Id] = entry
	return entry
end

local function updateBar(info: Breakables.Info, force: boolean?)
	local hp = info.Model:GetAttribute("Hp")
	local maxHp = info.Model:GetAttribute("MaxHp")
	if type(hp) ~= "number" or type(maxHp) ~= "number" or maxHp <= 0 then
		return
	end
	local isTarget = info.Id == (localTarget or currentTarget())
	if hp >= maxHp and not isTarget and not force then
		local existing = bars[info.Id]
		if existing then
			existing.Gui.Enabled = false
		end
		return
	end
	local entry = ensureBar(info)
	if entry then
		entry.Gui.Enabled = true
		entry.Set(hp / maxHp, Format.num(hp))
	end
end

local function watchBreakable(info: Breakables.Info)
	info.Model:GetAttributeChangedSignal("Hp"):Connect(function()
		updateBar(info)
	end)
	updateBar(info)
end

-- Picking ---------------------------------------------------------------------

local function pick(screenPos: Vector2): Breakables.Info?
	local cam = Workspace.CurrentCamera
	if not cam then
		return nil
	end
	local char = character()
	-- 1. raycast (works when breakable parts are queryable)
	local ray = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { fxFolder }
	if char then
		table.insert(exclude, char)
	end
	local pets = Workspace:FindFirstChild("ClientPets")
	if pets then
		table.insert(exclude, pets)
	end
	params.FilterDescendantsInstances = exclude
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 600, params)
	if hit then
		local info = Breakables.FromModel(hit.Instance)
		if info then
			return info
		end
	end
	-- 2. screen-space pick: nearest breakable whose projected size covers the
	-- tap (generous so small coin piles are easy to hit with a finger)
	local best: Breakables.Info? = nil
	local bestScore = math.huge
	local halfFov = math.tan(math.rad(cam.FieldOfView / 2))
	local vh = cam.ViewportSize.Y
	for _, info in Breakables.All() do
		if info.Model.Parent == nil then
			continue
		end
		local p, onScreen = cam:WorldToScreenPoint(info.Center)
		if onScreen and p.Z > 0 then
			local radiusPx = (math.max(info.Size.X, info.Size.Y, info.Size.Z) / 2) / (p.Z * halfFov) * (vh / 2)
			local d = (Vector2.new(p.X, p.Y) - screenPos).Magnitude
			local reach = radiusPx + 26
			if d <= reach then
				local score = d / reach + p.Z * 0.002
				if score < bestScore then
					bestScore = score
					best = info
				end
			end
		end
	end
	return best
end

local function setTarget(id: string?)
	localTarget = id
	Remote.Fire("SetTarget", id)
	refreshHighlight()
	if id then
		local info = Breakables.Get(id)
		if info then
			updateBar(info, true)
		end
	end
	-- fall back to the server's value shortly after
	task.delay(1.5, function()
		if localTarget == id then
			localTarget = nil
			refreshHighlight()
		end
	end)
end

local function onTap(screenPos: Vector2)
	local info = pick(screenPos)
	local current = localTarget or currentTarget()
	if info then
		if info.Id == current then
			setTarget(nil)
			Sounds.Play("Click", 0.8)
			return
		end
		local d = State.Data
		if d and info.Area ~= "" and not d.Areas[info.Area] then
			Toasts.Show(Theme.Icons.Lock .. " Open this island's gate first!", "bad")
			return
		end
		local _, root = character()
		if root and (root.Position - info.Center).Magnitude > Config.MaxTargetDistance then
			Toasts.Show("Too far away! Walk closer.", "info")
			return
		end
		if d and #d.Equipped == 0 then
			Toasts.Show("Equip a pet first! Open " .. Theme.Icons.Pets .. " Pets.", "info")
			return
		end
		setTarget(info.Id)
		Sounds.Play("Target")
		local cb = Farming.OnTarget
		if cb then
			cb(info.Id)
		end
	elseif current then
		setTarget(nil)
	end
end

-- Effects -------------------------------------------------------------------

local function nearCamera(pos: Vector3, range: number): boolean
	local cam = Workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude <= range
end

local function breakPop(pos: Vector3, kind: string?)
	if not nearCamera(pos, 160) then
		return
	end
	Sounds.Play("Break", 0.9 + math.random() * 0.3)
	local color = if kind == "GemRock" then Theme.Colors.Gems else Theme.Colors.Coins
	-- expanding ring
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Ball
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.new(1, 1, 1)
	ring.Transparency = 0.3
	ring.Size = Vector3.new(1, 1, 1)
	ring.CFrame = CFrame.new(pos)
	ring.Parent = fxFolder
	TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.new(9, 9, 9), Transparency = 1 }):Play()
	task.delay(0.4, function()
		ring:Destroy()
	end)
	-- chunks
	for _ = 1, 9 do
		local chunk = Instance.new("Part")
		chunk.Anchored = true
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.CanTouch = false
		chunk.Material = Enum.Material.SmoothPlastic
		chunk.Color = if math.random() < 0.5 then color else Theme.Lighten(color, 0.4)
		local s = 0.5 + math.random() * 0.6
		chunk.Size = Vector3.new(s, s, s)
		chunk.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		chunk.Parent = fxFolder
		local dir = Vector3.new(math.random() * 2 - 1, 0.6 + math.random(), math.random() * 2 - 1).Unit
		local goal = pos + dir * (4 + math.random() * 4)
		TweenService:Create(chunk, TweenInfo.new(0.55, Enum.EasingStyle.Quad), {
			CFrame = CFrame.new(goal) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
			Transparency = 1,
			Size = Vector3.new(0.1, 0.1, 0.1),
		}):Play()
		task.delay(0.6, function()
			chunk:Destroy()
		end)
	end
end

local function floatText(pos: Vector3, text: string, color: Color3, offset: number)
	if not nearCamera(pos, 200) then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(pos + Vector3.new(0, 3 + offset, 0))
	anchor.Parent = fxFolder
	local gui: BillboardGui = Kit.new("BillboardGui", {
		Size = UDim2.fromOffset(200, 50),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Adornee = anchor,
		Parent = anchor,
	})
	local label = Kit.fitLabel(text, 36, {
		Size = UDim2.fromScale(1, 1),
		Color = color,
		Outline = Theme.Darken(color, 0.6),
		Parent = gui,
	})
	Kit.pop(label, 0.4)
	TweenService:Create(anchor, TweenInfo.new(1.1, Enum.EasingStyle.Quad), { CFrame = anchor.CFrame + Vector3.new(0, 4, 0) }):Play()
	task.delay(0.7, function()
		Kit.tween(label, 0.4, { TextTransparency = 1 })
		local st = label:FindFirstChildOfClass("UIStroke")
		if st then
			Kit.tween(st, 0.4, { Transparency = 1 })
		end
	end)
	task.delay(1.2, function()
		anchor:Destroy()
	end)
end

local function onReward(data: { [string]: any })
	local pos = if typeof(data.Position) == "Vector3" then data.Position :: Vector3 else nil
	local coins = if type(data.Coins) == "number" then data.Coins else 0
	local gems = if type(data.Gems) == "number" then data.Gems else 0
	if pos then
		if coins > 0 then
			floatText(pos, "+" .. Format.num(coins) .. " " .. Theme.Icons.Coins, Theme.Colors.Coins, 0)
			Hud.FlyFrom(pos, "Coins", math.clamp(math.floor(math.log10(coins + 1) * 2), 2, 7))
		end
		if gems > 0 then
			floatText(pos, "+" .. Format.num(gems) .. " " .. Theme.Icons.Gems, Theme.Colors.Gems, 1.6)
			Hud.FlyFrom(pos, "Gems", math.clamp(gems, 1, 5))
		end
	else
		if coins > 0 then
			Hud.Bump("Coins")
			Sounds.Play("Coin")
		end
		if gems > 0 then
			Hud.Bump("Gems")
			Sounds.Play("Gem")
		end
	end
end

function Farming.Init()
	local f = Instance.new("Folder")
	f.Name = "ClientFx"
	f.Parent = Workspace
	fxFolder = f
	local h = Instance.new("Highlight")
	h.Name = "TargetHighlight"
	h.FillColor = Color3.fromRGB(255, 230, 90)
	h.FillTransparency = 0.7
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Enabled = false
	h.Parent = f
	highlight = h

	Breakables.Added:Connect(watchBreakable)
	for _, info in Breakables.All() do
		watchBreakable(info)
	end
	Breakables.Removed:Connect(function(id: string)
		bars[id] = nil
		if localTarget == id then
			localTarget = nil
		end
		refreshHighlight()
	end)

	player:GetAttributeChangedSignal("Target"):Connect(function()
		local t = currentTarget()
		if localTarget and t == localTarget then
			localTarget = nil
		end
		refreshHighlight()
		local info = Breakables.Get(t)
		if info then
			updateBar(info, true)
		end
	end)

	-- touch: TouchTapInWorld only fires for taps that miss the UI
	UserInputService.TouchTapInWorld:Connect(function(pos: Vector2, processed: boolean)
		if processed then
			return
		end
		onTap(pos)
	end)
	-- mouse: a short click without dragging
	local downAt: Vector2? = nil
	local downTime = 0
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			downAt = Vector2.new(input.Position.X, input.Position.Y)
			downTime = os.clock()
		end
	end)
	UserInputService.InputEnded:Connect(function(input, processed)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local start = downAt
		downAt = nil
		if processed or not start then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if os.clock() - downTime < 0.4 and (pos - start).Magnitude < 12 then
			onTap(pos)
		end
	end)

	State.Notify:Connect(function(kind: string, data: { [string]: any })
		if kind == "Broken" then
			local pos = if typeof(data.Position) == "Vector3" then data.Position :: Vector3 else nil
			if pos then
				breakPop(pos, if type(data.Kind) == "string" then data.Kind else nil)
			end
			if type(data.Id) == "string" and data.Id == localTarget then
				localTarget = nil
				refreshHighlight()
			end
		elseif kind == "Reward" then
			onReward(data)
		end
	end)
end

return Farming
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Hatch</string>
              <string name="Source"><![CDATA[--!strict
-- Hatch menu (opened from an EggStand prompt): egg picture, price, the full
-- odds list (base and luck-boosted), Hatch 1 / Hatch 3 / Auto hatch.
-- The Prism Egg is locked when the server says paid random items are
-- restricted for this player (CanBuyGemEggs = false).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared:WaitForChild("Eggs"))
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Viewport = require("../UI/Viewport")
local Toasts = require("../UI/Toasts")
local HatchAnim = require("./HatchAnim")
local Hud = require("./Hud")
local Shop = require("./Shop")

type PetInstance = Types.PetInstance

local Hatch = {}

local player = Players.LocalPlayer
local AUTO_RANGE = 30 -- studs from the stand before auto hatch stops

local win: Windows.Window
local eggHolder: Frame
local eggName: TextLabel
local costPill: Frame
local luckLabel: TextLabel
local oddsList: ScrollingFrame
local lockNote: TextLabel
local btn1: TextButton
local btn3: TextButton
local btnAuto: TextButton

local currentEgg: string? = nil
local standPos: Vector3? = nil
local hatching = false
local auto = false
local autoGen = 0 -- bumped on every start/stop so an old auto loop never touches a new run

-- Fired after each successful hatch (tutorial).
Hatch.OnHatched = nil :: (() -> ())?

local function eggLocked(eggId: string): boolean
	local egg = Eggs.ById[eggId]
	local d = State.Data
	return egg ~= nil and egg.Currency == "Gems" and d ~= nil and d.CanBuyGemEggs == false
end

local function currencyIcon(currency: string): string
	return if currency == "Gems" then Theme.Icons.Gems else Theme.Icons.Coins
end

local function charPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

local function stopAuto()
	auto = false
	autoGen += 1
	Hud.SetAutoHatch(nil)
	if btnAuto then
		Kit.setButton(btnAuto, { Text = "Auto: OFF", Tone = "White" })
	end
end

local oddsSig = ""

local function renderOdds(force: boolean?)
	local eggId = currentEgg
	local d = State.Data
	if not eggId or not d then
		return
	end
	local luck = d.LuckMult or 1
	local rows = PetInfo.Odds(eggId, luck)
	-- skip rebuilding the list when nothing it shows has changed
	local sig = eggId .. "|" .. tostring(luck) .. "|" .. tostring(PetInfo.ScaleArea())
	for _, row in rows do
		sig ..= if d.Index[row.Pet] then "1" else "0"
	end
	if sig == oddsSig and not force then
		return
	end
	oddsSig = sig
	Kit.clear(oddsList)
	for i, row in rows do
		local rarity = PetInfo.Rarity(row.Pet)
		local rc = Theme.RarityColor(rarity)
		local discovered = d.Index[row.Pet] == true
		local r = Kit.panel({
			Size = UDim2.new(1, -10, 0, 70),
			LayoutOrder = i,
			BackgroundColor3 = Theme.Lighten(rc, 0.75),
			StrokeColor = Theme.Darken(rc, 0.2),
			Parent = oddsList,
		})
		Viewport.Pet(row.Pet, "Normal", false, {
			Size = UDim2.fromOffset(62, 62),
			Position = UDim2.fromOffset(6, 4),
			Parent = r,
		})
		Kit.fitLabel(PetInfo.Name(row.Pet) .. (if discovered then "" else "  <font color=\"#F05454\">NEW</font>"), 22, {
			Size = UDim2.new(1, -250, 0, 30),
			Position = UDim2.fromOffset(76, 6),
			Align = "Left",
			Rich = true,
			Parent = r,
		})
		Kit.fitLabel(rarity .. "  " .. Theme.Icons.Boost .. Format.num(PetInfo.BasePower(row.Pet)), 16, {
			Size = UDim2.new(1, -250, 0, 24),
			Position = UDim2.fromOffset(76, 38),
			Align = "Left",
			Color = rc,
			Outline = Theme.Darken(rc, 0.55),
			Parent = r,
		})
		local boosted = math.abs(row.Boosted - row.Base) > 1e-6
		local pct = if boosted
			then "<font color=\"#6E7692\"><s>" .. Format.percent(row.Base) .. "</s></font>  <font color=\"#2FA84F\">" .. Format.percent(row.Boosted) .. "</font>"
			else Format.percent(row.Base)
		Kit.fitLabel(pct, 24, {
			Size = UDim2.fromOffset(170, 50),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Align = "Right",
			Rich = true,
			Parent = r,
		})
	end
	if luck > 1 then
		luckLabel.Text = Theme.Icons.Luck .. " Luck x" .. string.format("%.2g", luck) .. " (Rare+ boosted)"
		luckLabel.TextColor3 = Theme.Colors.Good
	else
		luckLabel.Text = "Odds shown before every hatch"
		luckLabel.TextColor3 = Theme.Colors.TextDim
	end
end

local function renderButtons()
	local eggId = currentEgg
	local d = State.Data
	if not eggId or not d then
		return
	end
	local egg = Eggs.ById[eggId]
	if not egg then
		return
	end
	local icon = currencyIcon(egg.Currency)
	local locked = eggLocked(eggId)
	local balance = if egg.Currency == "Gems" then d.Gems else d.Coins
	lockNote.Visible = locked
	Kit.setButton(btn1, { Text = "Hatch 1  " .. icon .. Format.num(egg.Cost), Enabled = not locked, Tone = if balance >= egg.Cost then "Green" else "Yellow" })
	if State.HasPass("TripleHatch") then
		Kit.setButton(btn3, { Text = "Hatch 3  " .. icon .. Format.num(egg.Cost * 3), Enabled = not locked, Tone = if balance >= egg.Cost * 3 then "Green" else "Yellow" })
	else
		Kit.setButton(btn3, { Text = Theme.Icons.Lock .. " Hatch 3", Enabled = not locked, Tone = "Purple" })
	end
	Kit.setButton(btnAuto, { Text = if auto then "Auto: ON" else "Auto: OFF", Tone = if auto then "Blue" else "White", Enabled = not locked })
	Kit.setPill(costPill, icon .. " " .. Format.num(egg.Cost))
end

local function render()
	local eggId = currentEgg
	if not eggId then
		return
	end
	local egg = Eggs.ById[eggId]
	if not egg then
		return
	end
	win.Title.Text = Theme.Icons.Egg .. "  " .. egg.Name
	eggName.Text = egg.Name
	Kit.clear(eggHolder)
	Viewport.Egg(eggId, { Size = UDim2.fromScale(1, 1), Spin = true, Parent = eggHolder })
	renderOdds(true)
	renderButtons()
end

-- One hatch request + animation. Returns true on success.
local function doHatch(count: number, isAuto: boolean): boolean
	local eggId = currentEgg
	local d = State.Data
	if hatching or not eggId or not d then
		return false
	end
	if eggLocked(eggId) then
		Toasts.Show("This egg isn't available for your account.", "bad")
		return false
	end
	hatching = true
	local before = table.clone(d.Index)
	local wasOpen = win.IsOpen
	local res = Remote.Call("HatchEgg", eggId, count)
	local ok = false
	if res and type(res.pets) == "table" and #res.pets > 0 then
		ok = true
		if wasOpen then
			Windows.Close()
		end
		HatchAnim.Play(eggId, res.pets :: { PetInstance }, before, isAuto)
		local cb = Hatch.OnHatched
		if cb then
			cb()
		end
		if wasOpen and not auto then
			Windows.Show("Hatch")
		end
	end
	hatching = false
	return ok
end

local function startAuto()
	if auto or not currentEgg then
		return
	end
	autoGen += 1
	local gen = autoGen
	auto = true
	renderButtons()
	Windows.Close()
	local eggId = currentEgg
	Hud.SetAutoHatch(Theme.Icons.Egg .. " Auto hatching " .. (if eggId and Eggs.ById[eggId] then Eggs.ById[eggId].Name else ""), stopAuto)
	task.spawn(function()
		local function alive(): boolean
			return auto and autoGen == gen and currentEgg == eggId
		end
		while alive() do
			-- a manual hatch may still be animating; wait instead of giving up
			while hatching and alive() do
				task.wait(0.1)
			end
			if not alive() then
				break
			end
			local pos = charPos()
			if standPos and pos and (pos - standPos).Magnitude > AUTO_RANGE then
				Toasts.Show("Auto hatch stopped: you walked away.", "info")
				break
			end
			local count = if State.HasPass("TripleHatch") then 3 else 1
			if not doHatch(count, true) then
				break
			end
			task.wait(math.max(0.1, Config.HatchCooldown - 0.6))
		end
		if autoGen == gen then
			stopAuto()
		end
	end)
end

function Hatch.Open(eggId: string, stand: Instance?)
	if not Eggs.ById[eggId] then
		return
	end
	if currentEgg ~= eggId and auto then
		stopAuto()
	end
	currentEgg = eggId
	standPos = nil
	if stand then
		if stand:IsA("Model") then
			standPos = stand:GetPivot().Position
		elseif stand:IsA("BasePart") then
			standPos = stand.Position
		end
	end
	Windows.Show("Hatch")
	render()
end

function Hatch.IsBusy(): boolean
	return hatching or auto
end

function Hatch.Init()
	win = Windows.Create("Hatch", { Title = "Hatch", Icon = Theme.Icons.Egg, Color = Theme.Tones.Yellow.Rim })
	local body = win.Body
	-- left: egg
	local left = Kit.box({ Size = UDim2.new(0, 270, 1, -80), Parent = body })
	eggHolder = Kit.panel({
		Size = UDim2.fromOffset(250, 230),
		Position = UDim2.fromOffset(10, 0),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		Parent = left,
	}, { Kit.gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 220, 255)) })
	eggName = Kit.fitLabel("", 28, { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 238), Parent = left })
	costPill = Kit.pill("", Theme.Colors.Coins, {
		Size = UDim2.fromOffset(170, 38),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 280),
		Parent = left,
	})
	luckLabel = Kit.fitLabel("", 18, {
		Size = UDim2.new(1, -10, 0, 50),
		Position = UDim2.fromOffset(5, 324),
		Font = Theme.FontBody,
		Parent = left,
	})
	-- right: odds
	local right = Kit.panel({
		Size = UDim2.new(1, -284, 1, -80),
		Position = UDim2.fromOffset(280, 0),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		StrokeThickness = 2,
		Parent = body,
	})
	Kit.fitLabel("Odds", 24, { Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(12, 4), Align = "Left", Parent = right })
	oddsList = Kit.scroll({
		Size = UDim2.new(1, -12, 1, -44),
		Position = UDim2.fromOffset(8, 40),
		Parent = right,
	}, { Kit.list(Enum.FillDirection.Vertical, 6), Kit.pad(2, 4, 4, 2) })
	-- bottom: buttons
	local bar = Kit.box({
		Size = UDim2.new(1, 0, 0, 70),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = body,
	}, { Kit.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	btn1 = Kit.button("Hatch 1", "Green", { Size = UDim2.fromOffset(260, 66), LayoutOrder = 1, Parent = bar }, function()
		task.spawn(doHatch, 1, false)
	end)
	btn3 = Kit.button("Hatch 3", "Green", { Size = UDim2.fromOffset(260, 66), LayoutOrder = 2, Parent = bar }, function()
		if not State.HasPass("TripleHatch") then
			Shop.Upsell("TripleHatch", "Open 3 eggs at once!")
			return
		end
		task.spawn(doHatch, 3, false)
	end)
	btnAuto = Kit.button("Auto: OFF", "White", { Size = UDim2.fromOffset(220, 66), LayoutOrder = 3, Parent = bar }, function()
		if auto then
			stopAuto()
		else
			startAuto()
		end
	end)
	lockNote = Kit.fitLabel(Theme.Icons.Lock .. " Prism Eggs aren't available for your account (just joined? give it a few seconds).", 18, {
		Size = UDim2.new(1, -20, 0, 50),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -72),
		Color = Theme.Colors.Bad,
		Font = Theme.FontBody,
		Visible = false,
		ZIndex = 5,
		Parent = body,
	})

	Windows.Register("Hatch", function(eggId: string?, stand: Instance?)
		if eggId then
			Hatch.Open(eggId, stand)
		elseif currentEgg then
			Hatch.Open(currentEgg, nil)
		end
	end)
	State.Changed:Connect(function()
		if win.IsOpen then
			renderOdds()
			renderButtons()
		end
	end)
end

return Hatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">HatchAnim</string>
              <string name="Source"><![CDATA[--!strict
-- Hatch animation: the egg(s) appear in front of the camera, shake faster and
-- faster, flash white and reveal the pet with rarity-coloured rays, its name,
-- rarity and "NEW!" when it is the first of its species. Fast Hatch shortens
-- it; triple hatches show three eggs side by side. Tap to skip the hold.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Viewport = require("../UI/Viewport")
local PetCard = require("../UI/PetCard")

type PetInstance = Types.PetInstance

local HatchAnim = {}

HatchAnim.Playing = false

local function rays(parent: Instance, color: Color3): Frame
	local holder: Frame = Kit.box({
		Name = "Rays",
		Size = UDim2.fromOffset(10, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		ZIndex = 2,
		Parent = parent,
	})
	for i = 1, 12 do
		Kit.new("Frame", {
			Size = UDim2.fromOffset(46, 520),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = i * 15,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = holder,
		}, {
			Kit.new("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.55),
					NumberSequenceKeypoint.new(0.5, 0.2),
					NumberSequenceKeypoint.new(0.65, 0.55),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
	end
	-- soft glow disc in the middle
	Kit.new("Frame", {
		Size = UDim2.fromOffset(260, 260),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Lighten(color, 0.4),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = holder,
	}, { Kit.corner(UDim.new(0.5, 0)) })
	return holder
end

-- Plays the animation and yields until it finishes (or is skipped).
-- `indexBefore` is the player's Index before hatching, for "NEW!".
function HatchAnim.Play(eggId: string, pets: { PetInstance }, indexBefore: { [string]: boolean }, auto: boolean?)
	if #pets == 0 then
		return
	end
	HatchAnim.Playing = true
	local fast = State.HasPass("FastHatch")
	local total = if fast then Config.FastHatchAnimSeconds else Config.HatchAnimSeconds
	local shakeT = total * 0.62
	local holdT = if auto then 0.9 else 1.6

	local gui = Windows.Gui("Overlay")
	-- a full-screen Active button: it swallows taps (so they never reach the
	-- world and retarget pets) and a tap skips the hold
	local root: TextButton = Kit.new("TextButton", {
		Name = "Hatch",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Selectable = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Backdrop,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	Kit.tween(root, 0.25, { BackgroundTransparency = 0.35 })
	local blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = Lighting
	Kit.tween(blur, 0.25, { Size = 14 })

	local stage: Frame = Kit.box({
		Size = UDim2.fromOffset(Theme.RefWidth, Theme.RefHeight),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = root,
	})
	Kit.autoScale(stage, 1)

	local n = #pets
	local spacing = if n >= 3 then 290 else 330
	local slotSize = if n >= 3 then 250 else 320
	local slots: { Frame } = {}
	local eggs: { ViewportFrame } = {}
	for i = 1, n do
		local x = (i - (n + 1) / 2) * spacing
		local slot: Frame = Kit.box({
			Size = UDim2.fromOffset(slotSize, slotSize + 120),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, x, 0.5, 0),
			Parent = stage,
		})
		slots[i] = slot
		local vp = Viewport.Egg(eggId, {
			Size = UDim2.fromOffset(slotSize, slotSize),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 0),
			ZIndex = 3,
			Angle = 0,
			Parent = slot,
		})
		Kit.pop(vp, 0.3)
		eggs[i] = vp
	end

	local skip = false
	local tapConn = root.Activated:Connect(function()
		skip = true
	end)

	-- shake, faster and faster
	local t0 = os.clock()
	local lastTick = 0
	local shakeConn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local p = math.clamp(t / shakeT, 0, 1)
		local freq = 7 + 30 * p * p
		local amp = math.rad(5 + 16 * p)
		local angle = math.sin(t * freq) * amp
		for _, vp in eggs do
			local m = Viewport.ModelOf(vp)
			if m then
				m:PivotTo(CFrame.Angles(0, 0, angle))
			end
		end
		local period = math.pi / freq
		if t - lastTick > period * 2 then
			lastTick = t
			Sounds.Play("EggShake", 0.8 + p * 0.8)
		end
	end)
	task.wait(shakeT)
	shakeConn:Disconnect()

	-- flash
	local flash: Frame = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = root,
	})
	Kit.tween(flash, 0.45, { BackgroundTransparency = 1 })
	task.delay(0.5, function()
		flash:Destroy()
	end)

	-- reveal
	local best = 1
	local rayHolders: { Frame } = {}
	local seen: { [string]: boolean } = table.clone(indexBefore)
	for i, pet in pets do
		eggs[i]:Destroy()
		local slot = slots[i]
		local rarity = PetInfo.Rarity(pet.Id)
		local rc = Theme.RarityColor(rarity)
		best = math.max(best, PetInfo.RarityIndex(rarity))
		table.insert(rayHolders, rays(slot, rc))
		local vp = Viewport.Pet(pet.Id, pet.Variant, pet.Shiny, {
			Size = UDim2.fromOffset(slotSize, slotSize),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 0),
			ZIndex = 4,
			Spin = true,
			Parent = slot,
		})
		Kit.pop(vp, 0.2)
		local nameColor = if pet.Variant == "Golden" then Theme.Variant.Golden else rc
		local name = Kit.fitLabel(PetInfo.FullName(pet), 34, {
			Size = UDim2.new(1, 40, 0, 44),
			Position = UDim2.new(0, -20, 0, slotSize - 6),
			Color = Color3.new(1, 1, 1),
			Outline = Theme.Darken(nameColor, 0.35),
			ZIndex = 6,
			Parent = slot,
		})
		if pet.Variant == "Rainbow" then
			Kit.new("UIGradient", { Color = PetCard.RainbowSequence, Parent = name })
		end
		Kit.fitLabel(rarity .. "  " .. Theme.Icons.Boost .. Format.num(PetInfo.Power(pet)), 24, {
			Size = UDim2.new(1, 0, 0, 30),
			Position = UDim2.new(0, 0, 0, slotSize + 38),
			Color = rc,
			Outline = Theme.Darken(rc, 0.6),
			ZIndex = 6,
			Parent = slot,
		})
		if not seen[pet.Id] then
			seen[pet.Id] = true
			local newTag = Kit.pill("NEW!", Theme.Colors.Bad, {
				Size = UDim2.fromOffset(110, 44),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -40, 0, 30),
				Rotation = 12,
				ZIndex = 8,
				Parent = slot,
			})
			Kit.pop(newTag, 0.2)
		end
		if pet.Shiny then
			Kit.fitLabel(Theme.Icons.Shiny .. " SHINY " .. Theme.Icons.Shiny, 26, {
				Size = UDim2.new(1, 0, 0, 34),
				Position = UDim2.fromOffset(0, -10),
				Color = Color3.fromRGB(255, 250, 200),
				Outline = true,
				ZIndex = 8,
				Parent = slot,
			})
		end
	end
	Sounds.Play(if best >= PetInfo.RarityIndex("Legendary") then "Rare" else "Hatch")
	local spinConn = RunService.RenderStepped:Connect(function(dt: number)
		for _, h in rayHolders do
			h.Rotation += dt * 25
		end
	end)

	local revealT = total - shakeT + holdT
	local start = os.clock()
	skip = false
	while os.clock() - start < revealT and not (skip and os.clock() - start > 0.35) do
		task.wait()
	end
	spinConn:Disconnect()
	tapConn:Disconnect()
	Kit.tween(root, 0.2, { BackgroundTransparency = 1 })
	Kit.tween(blur, 0.2, { Size = 0 })
	task.wait(0.2)
	root:Destroy()
	blur:Destroy()
	HatchAnim.Playing = false
end

return HatchAnim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD: coins/gems with animated counters, side menu buttons with
-- notification dots, active boost timers, server luck banner, island banner
-- (from AreaBounds parts) and flying coin/gem pickups.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Areas = require(Shared:WaitForChild("Areas"))
local Pets = require(Shared:WaitForChild("Pets"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Toasts = require("../UI/Toasts")

type PlayerState = Types.PlayerState

local Hud = {}

local player = Players.LocalPlayer

local gui: ScreenGui
local coinsLabel: TextLabel
local gemsLabel: TextLabel
local coinIcon: GuiObject
local gemIcon: GuiObject
local boostsFrame: Frame
local luckBanner: Frame
local autoPill: Frame
local dots: { [string]: Frame } = {}

local shown = { Coins = 0, Gems = 0 }
local target = { Coins = 0, Gems = 0 }
local currentArea: string? = nil

-- Side menu: window name, icon, label, tone, keyboard shortcut.
local MENU = {
	{ Name = "Pets", Icon = Theme.Icons.Pets, Label = "Pets", Tone = "Yellow", Key = Enum.KeyCode.P },
	{ Name = "Shop", Icon = Theme.Icons.Shop, Label = "Shop", Tone = "Pink", Key = Enum.KeyCode.M },
	{ Name = "Expeditions", Icon = Theme.Icons.Expeditions, Label = "Trips", Tone = "Green", Key = Enum.KeyCode.X },
	{ Name = "Quests", Icon = Theme.Icons.Quests, Label = "Quests", Tone = "Purple", Key = Enum.KeyCode.J },
	{ Name = "Index", Icon = Theme.Icons.Index, Label = "Index", Tone = "Cyan", Key = Enum.KeyCode.I },
	{ Name = "Islands", Icon = Theme.Icons.Islands, Label = "Islands", Tone = "Blue", Key = Enum.KeyCode.N },
	{ Name = "Trade", Icon = Theme.Icons.Trade, Label = "Trade", Tone = "Red", Key = Enum.KeyCode.T },
	{ Name = "Settings", Icon = Theme.Icons.Settings, Label = "Settings", Tone = "Grey", Key = Enum.KeyCode.K },
}

local function currencyPill(icon: string, color: Color3, order: number, onPlus: (() -> ())?): (Frame, TextLabel, GuiObject)
	local f: Frame = Kit.panel({
		Name = "Currency" .. order,
		Size = UDim2.fromOffset(190, 50),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Corner = 25,
		LayoutOrder = order,
	})
	local iconLabel = Kit.fitLabel(icon, 34, {
		Name = "Icon",
		Size = UDim2.fromOffset(46, 46),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -8, 0.5, 0),
		Parent = f,
	})
	local value = Kit.fitLabel("0", 30, {
		Name = "Value",
		Size = UDim2.new(1, if onPlus then -92 else -52, 1, -8),
		Position = UDim2.fromOffset(42, 4),
		Outline = Theme.Darken(color, 0.55),
		Color = color,
		Parent = f,
	})
	if onPlus then
		Kit.button("+", "Green", {
			Size = UDim2.fromOffset(40, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -5, 0.5, 0),
			TextSize = 30,
			Parent = f,
		}, onPlus)
	end
	return f, value, iconLabel
end

local function buildTop()
	local top: Frame = Kit.box({
		Name = "Top",
		Size = UDim2.fromOffset(420, 56),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Parent = gui,
	}, { Kit.list(Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center) })
	Kit.autoScale(top, 1.05)
	local cf, cl, ci = currencyPill(Theme.Icons.Coins, Theme.Colors.Coins, 1, nil)
	cf.Parent = top
	coinsLabel, coinIcon = cl, ci
	local gf, gl, gi = currencyPill(Theme.Icons.Gems, Theme.Colors.Gems, 2, function()
		Windows.Open("Shop", "Gems")
	end)
	gf.Parent = top
	gemsLabel, gemIcon = gl, gi

	luckBanner = Kit.pill("", Theme.Colors.Luck, {
		Name = "ServerLuck",
		Size = UDim2.fromOffset(330, 36),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Visible = false,
		Parent = gui,
	})
	Kit.autoScale(luckBanner, 1.05)
end

local function buildSide()
	local side: Frame = Kit.box({
		Name = "Side",
		Size = UDim2.fromOffset(176, 360),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.45, 0),
		Parent = gui,
	}, { Kit.grid(Vector2.new(82, 82), 8) })
	Kit.autoScale(side, 1)
	for i, item in MENU do
		local b = Kit.button("", item.Tone, {
			Name = item.Name,
			Size = UDim2.fromOffset(82, 82),
			LayoutOrder = i,
		}, function()
			Windows.Toggle(item.Name)
		end)
		Kit.fitLabel(item.Icon, 40, {
			Size = UDim2.new(1, 0, 0, 48),
			Position = UDim2.fromOffset(0, 4),
			ZIndex = 3,
			Parent = b,
		})
		Kit.fitLabel(item.Label, 18, {
			Size = UDim2.new(1, -4, 0, 22),
			Position = UDim2.new(0, 2, 1, -26),
			Outline = true,
			ZIndex = 3,
			Parent = b,
		})
		b.Parent = side
		local dot: Frame = Kit.new("Frame", {
			Name = "Dot",
			Size = UDim2.fromOffset(28, 28),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -4, 0, 4),
			BackgroundColor3 = Theme.Colors.Bad,
			Visible = false,
			ZIndex = 6,
			Parent = b,
		}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(Color3.new(1, 1, 1), 2) })
		Kit.fitLabel("!", 18, { Name = "Count", Size = UDim2.fromScale(1, 1), Outline = true, ZIndex = 7, Parent = dot })
		dots[item.Name] = dot
	end
end

local function buildBoosts()
	boostsFrame = Kit.box({
		Name = "Boosts",
		Size = UDim2.fromOffset(170, 200),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 70),
		Parent = gui,
	}, { Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right) })
	Kit.autoScale(boostsFrame, 1)
end

local function buildAutoPill()
	autoPill = Kit.panel({
		Name = "AutoHatch",
		Size = UDim2.fromOffset(330, 58),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Visible = false,
		Corner = 29,
		Parent = gui,
	})
	Kit.autoScale(autoPill, 1)
	Kit.fitLabel(Theme.Icons.Egg .. " Auto hatching...", 22, {
		Name = "Text",
		Size = UDim2.new(1, -130, 1, 0),
		Position = UDim2.fromOffset(16, 0),
		Align = "Left",
		Parent = autoPill,
	})
end

-- Shows or hides the "Auto hatching" pill at the bottom of the screen.
local stopConn: RBXScriptConnection? = nil
function Hud.SetAutoHatch(text: string?, onStop: (() -> ())?)
	autoPill.Visible = text ~= nil
	if text then
		local l = autoPill:FindFirstChild("Text") :: TextLabel
		l.Text = text
	end
	local old = autoPill:FindFirstChild("Stop")
	if old then
		old:Destroy()
	end
	if stopConn then
		stopConn:Disconnect()
		stopConn = nil
	end
	if text and onStop then
		Kit.button("Stop", "Red", {
			Name = "Stop",
			Size = UDim2.fromOffset(104, 46),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Parent = autoPill,
		}, onStop)
	end
end

-- Absolute screen position of a currency icon's centre.
function Hud.Target(kind: string): Vector2
	local icon = if kind == "Gems" then gemIcon else coinIcon
	return icon.AbsolutePosition + icon.AbsoluteSize / 2
end

function Hud.Bump(kind: string)
	local label = if kind == "Gems" then gemsLabel else coinsLabel
	local pill = label.Parent :: GuiObject
	Kit.pop(pill, 1.15)
end

-- Flies a few coin/gem icons from a world position to the HUD counter.
function Hud.FlyFrom(worldPos: Vector3, kind: string, count: number?)
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local screenPt, onScreen = cam:WorldToScreenPoint(worldPos)
	if not onScreen then
		Hud.Bump(kind)
		return
	end
	-- children are positioned relative to the ScreenGui, whose origin is moved
	-- by the safe-area insets (notches, top bar)
	local origin = gui.AbsolutePosition
	local pt = Vector2.new(screenPt.X, screenPt.Y) - origin
	local goal = Hud.Target(kind) - origin
	local n = math.clamp(count or 5, 1, 8)
	for i = 1, n do
		local icon = Kit.fitLabel(if kind == "Gems" then Theme.Icons.Gems else Theme.Icons.Coins, 30, {
			Size = UDim2.fromOffset(34, 34),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(pt.X, pt.Y),
			ZIndex = 20,
			Parent = gui,
		})
		local spread = Vector2.new(math.random(-60, 60), math.random(-60, 20))
		task.delay((i - 1) * 0.05, function()
			Kit.tween(icon, 0.22, { Position = UDim2.fromOffset(pt.X + spread.X, pt.Y + spread.Y) }, Enum.EasingStyle.Quad)
			task.wait(0.22)
			local t = Kit.tween(icon, 0.45, { Position = UDim2.fromOffset(goal.X, goal.Y), Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			t.Completed:Wait()
			icon:Destroy()
			if i == 1 then
				Hud.Bump(kind)
				Sounds.Play(if kind == "Gems" then "Gem" else "Coin")
			end
		end)
	end
end

local function setDot(name: string, count: number)
	local d = dots[name]
	if not d then
		return
	end
	d.Visible = count > 0
	local l = d:FindFirstChild("Count") :: TextLabel?
	if l then
		l.Text = if count > 9 then "9+" else tostring(count)
	end
end

local function refreshDots()
	local d = State.Data
	if not d then
		return
	end
	local now = State.Now()
	-- Expeditions ready to claim
	local ready = 0
	for _, e in d.Expeditions do
		if e.EndAt <= now then
			ready += 1
		end
	end
	setDot("Expeditions", ready)
	-- Quests / daily / playtime
	local q = 0
	if d.Daily.CanClaim then
		q += 1
	end
	for _, quest in d.Quests do
		if not quest.Claimed and quest.Progress >= quest.Goal then
			q += 1
		end
	end
	local minutes = State.SessionMinutes()
	for i, gift in Config.PlaytimeGifts do
		if not d.Playtime.Claimed[tostring(i)] and minutes >= (gift.Minutes or 0) then
			q += 1
		end
	end
	setDot("Quests", q)
	-- Index tiers
	local found = 0
	for _ in d.Index do
		found += 1
	end
	local total = #Pets.List
	local idx = 0
	for tier, r in Config.IndexRewards do
		if not d.IndexClaimed[tostring(tier)] and total > 0 and found / total >= (r.Fraction or 1) then
			idx += 1
		end
	end
	setDot("Index", idx)
end

local boostRows: { [string]: Frame } = {}

local function boostRow(key: string, text: string, color: Color3): Frame
	local existing = boostRows[key]
	if existing then
		return existing
	end
	local row = Kit.pill(text, color, { Name = key, Size = UDim2.fromOffset(170, 36) })
	row.Parent = boostsFrame
	boostRows[key] = row
	return row
end

local function refreshTimers()
	local d = State.Data
	if not d then
		return
	end
	local seen: { [string]: boolean } = {}
	for key, _ in d.Boosts do
		local left = State.BoostLeft(key)
		-- paid luck doesn't apply when the policy restricts paid random items
		if left > 0 and (d.CanBuyGemEggs or not string.find(key, "Luck")) then
			seen[key] = true
			local def = Config.Boosts[key]
			local name = if def then def.Name else key
			local color = if string.find(key, "Luck") then Theme.Colors.Luck else Theme.Colors.Coins
			local row = boostRow(key, "", color)
			Kit.setPill(row, Theme.Icons.Boost .. " " .. name .. "  " .. Format.time(left))
		end
	end
	for key, row in boostRows do
		if not seen[key] then
			row:Destroy()
			boostRows[key] = nil
		end
	end
	local luck = State.ServerLuckLeft()
	luckBanner.Visible = luck > 0 and d.CanBuyGemEggs == true
	if luckBanner.Visible then
		Kit.setPill(luckBanner, Theme.Icons.Luck .. " Server Luck x" .. tostring(Config.ServerLuckMult) .. "  " .. Format.time(luck))
	end
end

local function onState(d: PlayerState)
	target.Coins = d.Coins
	target.Gems = d.Gems
	refreshDots()
	refreshTimers()
end

-- Island banner: which AreaBounds box contains the character.
local function areaAt(pos: Vector3): string?
	for _, part in CollectionService:GetTagged("AreaBounds") do
		if part:IsA("BasePart") then
			local rel = part.CFrame:PointToObjectSpace(pos)
			local half = part.Size / 2
			if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
				local id = part:GetAttribute("AreaId")
				if type(id) == "string" then
					return id
				end
			end
		end
	end
	return nil
end

function Hud.CurrentArea(): string?
	return currentArea
end

local function checkArea()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local id = areaAt(root.Position)
	if id and id ~= currentArea then
		currentArea = id
		local a = Areas.ById[id]
		if a then
			Toasts.Banner(a.Name, a.Blurb, Theme.Colors.Coins, 3)
		end
	end
end

function Hud.Init()
	gui = Windows.Gui("Hud")
	buildTop()
	buildSide()
	buildBoosts()
	buildAutoPill()

	State.Changed:Connect(onState)
	if State.Data then
		onState(State.Data)
		shown.Coins = State.Data.Coins
		shown.Gems = State.Data.Gems
	end
	State.Ready:Connect(function(d: PlayerState)
		-- don't count up from zero on join
		shown.Coins = d.Coins
		shown.Gems = d.Gems
	end)

	-- animated counters (ease towards the real value)
	game:GetService("RunService").RenderStepped:Connect(function(dt: number)
		for _, kind in { "Coins", "Gems" } do
			local cur, goal = shown[kind], target[kind]
			if cur ~= goal then
				local nextV = cur + (goal - cur) * math.min(1, dt * 8)
				if math.abs(goal - nextV) < math.max(1, math.abs(goal) * 0.0005) then
					nextV = goal
				end
				shown[kind] = nextV
			end
		end
		coinsLabel.Text = Format.num(shown.Coins)
		gemsLabel.Text = Format.num(shown.Gems)
	end)

	task.spawn(function()
		while true do
			refreshTimers()
			refreshDots()
			checkArea()
			task.wait(0.5)
		end
	end)

	-- keyboard shortcuts (PC)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		for _, item in MENU do
			if input.KeyCode == item.Key then
				Windows.Toggle(item.Name)
			end
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">IndexMenu</string>
              <string name="Source"><![CDATA[--!strict
-- Index (collection book): every species grouped by island, undiscovered ones
-- as dark silhouettes with "???", and the tier rewards for discovering a
-- fraction of all species.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Pets = require(Shared:WaitForChild("Pets"))
local Areas = require(Shared:WaitForChild("Areas"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local PetCard = require("../UI/PetCard")
local Toasts = require("../UI/Toasts")
local RewardText = require("../UI/RewardText")

local IndexMenu = {}

local win: Windows.Window
local content: ScrollingFrame
local renderedSig = ""

local function sections(): { { Title: string, Ids: { string } } }
	local out: { { Title: string, Ids: { string } } } = {}
	local byTitle: { [string]: { Title: string, Ids: { string } } } = {}
	local function add(title: string, id: string)
		local s = byTitle[title]
		if not s then
			s = { Title = title, Ids = {} }
			byTitle[title] = s
			table.insert(out, s :: any)
		end
		table.insert((s :: any).Ids, id)
	end
	for _, a in Areas.List do
		for _, p in Pets.List do
			if p.Area == a.Id and p.Source ~= "Gem" then
				add(a.Name, p.Id)
			end
		end
	end
	for _, p in Pets.List do
		if p.Source == "Gem" then
			add("Prism Egg", p.Id)
		end
	end
	return out
end

local function render(force: boolean?)
	if not win.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	local found = 0
	local sig = ""
	for _, p in Pets.List do
		if d.Index[p.Id] then
			found += 1
			sig ..= p.Id
		end
	end
	for k in d.IndexClaimed do
		sig ..= "#" .. k
	end
	if sig == renderedSig and not force then
		return
	end
	renderedSig = sig
	Kit.clear(content)
	local total = #Pets.List
	local frac = if total > 0 then found / total else 0

	-- progress + tiers
	local top = Kit.panel({ Size = UDim2.new(1, -10, 0, 190), LayoutOrder = 1, BackgroundColor3 = Theme.Colors.PanelAlt, Parent = content })
	local bar, set = Kit.bar({ Size = UDim2.new(1, -30, 0, 34), Position = UDim2.fromOffset(15, 12) }, Theme.Rarity.Legendary)
	bar.Parent = top
	set(frac, Theme.Icons.Index .. " " .. found .. " / " .. total .. " discovered")
	local tiers = Kit.box({ Size = UDim2.new(1, -20, 0, 128), Position = UDim2.fromOffset(10, 54), Parent = top }, {
		Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center),
	})
	for tier, r in Config.IndexRewards do
		local need = math.ceil((r.Fraction or 1) * total)
		local claimedTier = d.IndexClaimed[tostring(tier)] == true
		local reached = found >= need
		local t = Kit.panel({
			Size = UDim2.fromOffset(190, 124),
			LayoutOrder = tier,
			BackgroundColor3 = if claimedTier then Theme.Colors.PanelDark elseif reached then Theme.Lighten(Theme.Colors.Good, 0.6) else Theme.Colors.Panel,
			Parent = tiers,
		})
		Kit.fitLabel(need .. " pets", 20, { Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 4), Parent = t })
		Kit.fitLabel(RewardText(r :: any), 15, { Size = UDim2.new(1, -10, 0, 34), Position = UDim2.fromOffset(5, 30), Font = Theme.FontBody, Parent = t })
		local b = Kit.button(if claimedTier then Theme.Icons.Equipped .. " Claimed" elseif reached then "Claim" else Theme.Icons.Lock .. " " .. found .. "/" .. need, if reached and not claimedTier then "Green" else "Grey", {
			Size = UDim2.new(1, -16, 0, 46),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			TextSize = 18,
			Parent = t,
		}, function()
			local res = Remote.CallOnce("ClaimIndex", tier)
			if res then
				Sounds.Play("Reward")
				Toasts.Show(Theme.Icons.Index .. " Index reward! " .. RewardText(if type(res.reward) == "table" then res.reward else r :: any), "gold")
			end
		end)
		if claimedTier or not reached then
			Kit.setButton(b, { Enabled = false })
		end
	end

	-- species
	for i, s in sections() do
		local count = 0
		for _, id in s.Ids do
			if d.Index[id] then
				count += 1
			end
		end
		Kit.fitLabel(s.Title .. "  (" .. count .. "/" .. #s.Ids .. ")", 26, {
			Size = UDim2.new(1, -10, 0, 34),
			LayoutOrder = 10 + i * 2,
			Align = "Left",
			Parent = content,
		})
		local grid = Kit.box({
			Size = UDim2.new(1, -10, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 11 + i * 2,
			Parent = content,
		}, { Kit.grid(Vector2.new(104, 122), 8) })
		for j, id in s.Ids do
			local discovered = d.Index[id] == true
			local card = PetCard.Species(id, discovered, Vector2.new(104, 122))
			card.LayoutOrder = j
			card.Parent = grid
			local species = Pets.ById[id]
			if species and species.Source == "Expedition" then
				Kit.fitLabel(Theme.Icons.Expeditions, 20, {
					Size = UDim2.fromOffset(26, 26),
					Position = UDim2.fromOffset(4, 4),
					ZIndex = 4,
					Parent = card,
				})
			end
		end
	end
end

function IndexMenu.Init()
	win = Windows.Create("Index", { Title = "Pet Index", Icon = Theme.Icons.Index, Color = Theme.Tones.Cyan.Rim })
	content = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = win.Body }, {
		Kit.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Left),
		Kit.pad(4, 8, 8, 4),
	})
	win.Opened:Connect(function()
		render(true)
	end)
	State.Changed:Connect(function()
		render()
	end)
end

return IndexMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[--!strict
-- Pets inventory: grid sorted by power (equipped first) with filters, a
-- details panel (power, level/xp, variant, shiny) with Equip, Lock, Delete
-- and Craft, plus Equip Best, Unequip All and a multi-delete mode.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Viewport = require("../UI/Viewport")
local PetCard = require("../UI/PetCard")
local Toasts = require("../UI/Toasts")

type PetInstance = Types.PetInstance

local Inventory = {}

local FILTERS = { "All", "Equipped", "Golden", "Rainbow", "Shiny", "Locked" }

local win: Windows.Window
local grid: ScrollingFrame
local countLabel: TextLabel
local equipLabel: TextLabel
local filterBtn: TextButton
local deleteModeBtn: TextButton
local deleteBtn: TextButton
local details: Frame
local detailPic: Frame
local detailName: TextLabel
local detailInfo: TextLabel
local setXp: (number, string?) -> ()
local btnEquip: TextButton
local btnLock: TextButton
local btnDelete: TextButton
local btnCraft: TextButton
local emptyNote: TextLabel

local filter = "All"
local selected: string? = nil
local deleteMode = false
local marked: { [string]: boolean } = {}
type CardEntry = { Card: TextButton, Sig: string }
local cards: { [string]: CardEntry } = {}

local function sigOf(p: PetInstance): string
	-- the power on a gem pet's card depends on the player's highest island
	local species = PetInfo.Species(p.Id)
	local scale = if species and species.Source == "Gem" then tostring(PetInfo.ScaleArea()) else ""
	return p.Id .. p.Variant .. tostring(p.Shiny) .. tostring(p.Level) .. scale
end

local function passes(p: PetInstance, equipped: boolean): boolean
	if filter == "Equipped" then
		return equipped
	elseif filter == "Golden" then
		return p.Variant == "Golden"
	elseif filter == "Rainbow" then
		return p.Variant == "Rainbow"
	elseif filter == "Shiny" then
		return p.Shiny
	elseif filter == "Locked" then
		return p.Locked
	end
	return true
end

-- Pets that could be crafted together with `p` (same species, variant and
-- shininess, not locked and not away on an expedition).
function Inventory.CraftGroup(p: PetInstance): { PetInstance }
	local d = State.Data
	local out: { PetInstance } = {}
	if not d then
		return out
	end
	local busy = State.BusyUids()
	local trading = State.TradeUids()
	local key = PetInfo.CraftKey(p)
	for _, q in d.Pets do
		if PetInfo.CraftKey(q) == key and not q.Locked and not busy[q.Uid] and not trading[q.Uid] then
			table.insert(out, q)
		end
	end
	return out
end

function Inventory.Craft(p: PetInstance)
	local nextVariant = PetInfo.NextVariant(p.Variant)
	if not nextVariant then
		Toasts.Show("Rainbow is the best variant already!", "info")
		return
	end
	local group = Inventory.CraftGroup(p)
	if #group < Config.CraftCost then
		Toasts.Show("Need " .. Config.CraftCost .. " matching unlocked pets (you have " .. #group .. ").", "bad")
		return
	end
	Windows.Confirm(
		"Craft " .. nextVariant .. " " .. PetInfo.Name(p.Id) .. "?",
		"Uses " .. Config.CraftCost .. " " .. PetInfo.FullName(p) .. " to make 1 " .. nextVariant .. " pet ("
			.. string.format("%gx", (Config.VariantPower[nextVariant] or 1) / (Config.VariantPower[p.Variant] or 1)) .. " power).",
		Theme.Icons.Craft .. " Craft",
		"Purple",
		function()
			local res = Remote.CallOnce("CraftPet", p.Uid)
			if res then
				Sounds.Play("Reward")
				local made = res.pet
				if type(made) == "table" and type(made.Id) == "string" then
					Toasts.Show("Crafted <b>" .. PetInfo.FullName(made :: PetInstance) .. "</b>!", "gold", {
						PetId = made.Id,
						Variant = made.Variant,
						Shiny = made.Shiny,
					})
					selected = made.Uid
				else
					Toasts.Show("Crafted a " .. nextVariant .. " pet!", "gold")
				end
			end
		end
	)
end

local function deletePets(uids: { string })
	if #uids == 0 then
		return
	end
	Windows.Confirm(
		"Delete " .. #uids .. " pet" .. (if #uids == 1 then "" else "s") .. "?",
		"Deleted pets are gone forever. You get a few coins back.",
		"Delete",
		"Red",
		function()
			local res = Remote.CallOnce("DeletePets", uids)
			if res then
				Toasts.Show("Deleted " .. #uids .. " pet" .. (if #uids == 1 then "" else "s") .. (if type(res.coins) == "number" and res.coins > 0 then "  +" .. Theme.Icons.Coins .. Format.num(res.coins) else ""), "good")
				for _, uid in uids do
					marked[uid] = nil
					if selected == uid then
						selected = nil
					end
				end
			end
		end
	)
end

local function renderDetails()
	local d = State.Data
	local p = if selected then State.PetByUid(selected) else nil
	if not d or not p then
		details.Visible = false
		return
	end
	local pet = p :: PetInstance
	details.Visible = true
	local key = sigOf(pet)
	if detailPic:GetAttribute("Sig") ~= key then
		detailPic:SetAttribute("Sig", key)
		Kit.clear(detailPic)
		Viewport.Pet(pet.Id, pet.Variant, pet.Shiny, { Size = UDim2.fromScale(1, 1), Spin = true, Parent = detailPic })
	end
	local rarity = PetInfo.Rarity(pet.Id)
	local rc = Theme.RarityColor(rarity)
	detailName.Text = PetInfo.FullName(pet)
	local stroke = detailName:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Theme.Darken(rc, 0.45)
	end
	local busy = State.BusyUids()[pet.Uid] == true
	local inTrade = State.TradeUids()[pet.Uid] == true
	local equipped = State.IsEquipped(pet.Uid)
	detailInfo.Text = string.format(
		"<font color=\"#%s\"><b>%s</b></font>   %s %s\n%s Power <b>%s</b>%s",
		rc:ToHex(),
		rarity,
		pet.Variant,
		if pet.Shiny then Theme.Icons.Shiny .. "Shiny" else "",
		Theme.Icons.Boost,
		Format.num(PetInfo.Power(pet)),
		if busy then "\n" .. Theme.Icons.Expeditions .. " On an expedition" elseif inTrade then "\n" .. Theme.Icons.Trade .. " In a trade" else ""
	)
	local level = pet.Level or 1
	if level >= Config.PetMaxLevel then
		setXp(1, "Lv " .. level .. "  MAX")
	else
		local need = Config.PetXpForLevel(level)
		setXp((pet.Xp or 0) / math.max(1, need), "Lv " .. level .. "   " .. Format.num(pet.Xp or 0) .. "/" .. Format.num(need) .. " XP")
	end
	Kit.setButton(btnEquip, {
		Text = if equipped then "Unequip" else "Equip",
		Tone = if equipped then "Yellow" else "Green",
		Enabled = not busy,
	})
	Kit.setButton(btnLock, { Text = if pet.Locked then Theme.Icons.Lock .. " Unlock" else Theme.Icons.Lock .. " Lock", Tone = "Blue" })
	Kit.setButton(btnDelete, { Enabled = not pet.Locked and not busy and not equipped and not inTrade })
	local nextVariant = PetInfo.NextVariant(pet.Variant)
	local group = #Inventory.CraftGroup(pet)
	if nextVariant then
		Kit.setButton(btnCraft, {
			Text = Theme.Icons.Craft .. " " .. math.min(group, Config.CraftCost) .. "/" .. Config.CraftCost,
			Enabled = group >= Config.CraftCost and not pet.Locked and not inTrade,
		})
	else
		Kit.setButton(btnCraft, { Text = "Max", Enabled = false })
	end
end

local function onCard(uid: string)
	local d = State.Data
	if not d then
		return
	end
	if deleteMode then
		local p = State.PetByUid(uid)
		if not p then
			return
		end
		if p.Locked then
			Toasts.Show("That pet is locked.", "info")
			return
		end
		if State.IsEquipped(uid) or State.BusyUids()[uid] or State.TradeUids()[uid] then
			Toasts.Show("Unequip it first (or wait for its expedition or trade).", "info")
			return
		end
		if marked[uid] then
			marked[uid] = nil
		else
			marked[uid] = true
		end
		Inventory.Render()
		return
	end
	selected = uid
	Inventory.Render()
end

function Inventory.Render()
	if not win or not win.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	local list = table.clone(d.Pets)
	PetInfo.Sort(list, d.Equipped)
	local busy = State.BusyUids()
	local eqSet: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eqSet[uid] = true
	end
	local alive: { [string]: boolean } = {}
	local shownCount = 0
	for i, p in list do
		local equipped = eqSet[p.Uid] == true
		local show = passes(p, equipped)
		local entry: CardEntry? = cards[p.Uid]
		local sig = sigOf(p)
		if entry and entry.Sig ~= sig then
			entry.Card:Destroy()
			entry = nil
		end
		if not entry then
			local uid = p.Uid
			local card = PetCard.new(p, Vector2.new(96, 112), function()
				onCard(uid)
			end)
			card.Parent = grid
			entry = { Card = card, Sig = sig }
			cards[p.Uid] = entry
		end
		local e = entry :: CardEntry
		alive[p.Uid] = true
		e.Card.LayoutOrder = i
		e.Card.Visible = show
		if show then
			shownCount += 1
		end
		PetCard.SetFlags(e.Card, {
			Equipped = equipped,
			Locked = p.Locked,
			Busy = busy[p.Uid] == true,
			Selected = not deleteMode and selected == p.Uid,
			Marked = deleteMode and marked[p.Uid] == true,
		})
	end
	for uid, entry in cards do
		if not alive[uid] then
			entry.Card:Destroy()
			cards[uid] = nil
			marked[uid] = nil
		end
	end
	if selected and not alive[selected] then
		selected = nil
	end
	emptyNote.Visible = shownCount == 0
	emptyNote.Text = if #d.Pets == 0 then "No pets yet! Hatch an egg at an egg stand." else "No pets match this filter."
	countLabel.Text = Theme.Icons.Pets .. " " .. #d.Pets .. "/" .. d.MaxStorage
	countLabel.TextColor3 = if #d.Pets >= d.MaxStorage then Theme.Colors.Bad else Theme.Colors.Text
	equipLabel.Text = Theme.Icons.Equipped .. " " .. #d.Equipped .. "/" .. d.MaxEquip
	Kit.setButton(filterBtn, { Text = "Filter: " .. filter })
	local nMarked = 0
	for _ in marked do
		nMarked += 1
	end
	Kit.setButton(deleteModeBtn, { Text = if deleteMode then "Done" else "Multi-delete", Tone = if deleteMode then "Blue" else "Red" })
	deleteBtn.Visible = deleteMode
	Kit.setButton(deleteBtn, { Text = "Delete " .. nMarked, Enabled = nMarked > 0 })
	renderDetails()
end

function Inventory.Init()
	win = Windows.Create("Pets", { Title = "Pets", Icon = Theme.Icons.Pets, Color = Theme.Tones.Yellow.Rim })
	local body = win.Body
	-- top bar
	local top = Kit.box({ Size = UDim2.new(1, 0, 0, 52), Parent = body })
	countLabel = Kit.fitLabel("", 26, { Size = UDim2.fromOffset(150, 46), Position = UDim2.fromOffset(4, 3), Align = "Left", Parent = top })
	equipLabel = Kit.fitLabel("", 26, { Size = UDim2.fromOffset(120, 46), Position = UDim2.fromOffset(150, 3), Align = "Left", Parent = top })
	filterBtn = Kit.button("Filter: All", "White", {
		Size = UDim2.fromOffset(200, 50),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -300, 0, 0),
		TextSize = 20,
		Parent = top,
	}, function()
		local i = table.find(FILTERS, filter) or 1
		filter = FILTERS[i % #FILTERS + 1]
		Inventory.Render()
	end)

	-- grid
	grid = Kit.scroll({
		Size = UDim2.new(1, -300, 1, -122),
		Position = UDim2.fromOffset(0, 58),
		Parent = body,
	}, { Kit.grid(Vector2.new(96, 112), 8), Kit.pad(8, 6, 8, 6) })
	emptyNote = Kit.fitLabel("", 22, {
		Size = UDim2.new(1, -300, 0, 60),
		Position = UDim2.fromOffset(0, 140),
		Color = Theme.Colors.TextDim,
		Visible = false,
		Parent = body,
	})

	-- details
	details = Kit.panel({
		Size = UDim2.new(0, 290, 1, -58),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		Visible = false,
		Parent = body,
	})
	detailPic = Kit.box({ Size = UDim2.new(1, -20, 0, 150), Position = UDim2.fromOffset(10, 6), Parent = details })
	detailName = Kit.fitLabel("", 24, {
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 156),
		Outline = true,
		Parent = details,
	})
	detailInfo = Kit.fitLabel("", 16, {
		Size = UDim2.new(1, -16, 0, 54),
		Position = UDim2.fromOffset(8, 186),
		Font = Theme.FontBody,
		Rich = true,
		Parent = details,
	})
	local xpBar, xpSet = Kit.bar({ Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 244) }, Theme.Colors.Info)
	xpBar.Parent = details
	setXp = xpSet
	local actions = Kit.box({
		Size = UDim2.new(1, -16, 0, 124),
		Position = UDim2.fromOffset(8, 274),
		Parent = details,
	}, { Kit.grid(Vector2.new(132, 56), 8) })
	btnEquip = Kit.button("Equip", "Green", { LayoutOrder = 1, Parent = actions }, function()
		local uid = selected
		if not uid then
			return
		end
		Remote.CallOnce("EquipPet", uid, not State.IsEquipped(uid))
	end)
	btnLock = Kit.button("Lock", "Blue", { LayoutOrder = 2, Parent = actions }, function()
		local p = if selected then State.PetByUid(selected) else nil
		if p then
			Remote.CallOnce("LockPet", p.Uid, not p.Locked)
		end
	end)
	btnDelete = Kit.button("Delete", "Red", { LayoutOrder = 3, Parent = actions }, function()
		if selected then
			deletePets({ selected })
		end
	end)
	btnCraft = Kit.button("Craft", "Purple", { LayoutOrder = 4, Parent = actions }, function()
		local p = if selected then State.PetByUid(selected) else nil
		if p then
			Inventory.Craft(p)
		end
	end)

	-- bottom bar
	local bottom = Kit.box({
		Size = UDim2.new(1, -300, 0, 58),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = body,
	}, { Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
	Kit.button("Equip Best", "Green", { Size = UDim2.fromOffset(140, 54), LayoutOrder = 1, Parent = bottom, TextSize = 20 }, function()
		Remote.CallOnce("EquipBest")
	end)
	Kit.button("Unequip All", "Yellow", { Size = UDim2.fromOffset(140, 54), LayoutOrder = 2, Parent = bottom, TextSize = 20 }, function()
		Remote.CallOnce("UnequipAll")
	end)
	deleteModeBtn = Kit.button("Multi-delete", "Red", { Size = UDim2.fromOffset(110, 54), LayoutOrder = 3, Parent = bottom, TextSize = 18 }, function()
		deleteMode = not deleteMode
		table.clear(marked)
		Inventory.Render()
	end)
	deleteBtn = Kit.button("Delete 0", "Red", { Size = UDim2.fromOffset(100, 54), LayoutOrder = 4, Parent = bottom, TextSize = 18 }, function()
		local uids = {}
		for uid in marked do
			table.insert(uids, uid)
		end
		deletePets(uids)
	end)
	deleteBtn.Visible = false

	win.Opened:Connect(function()
		Inventory.Render()
	end)
	win.Closed:Connect(function()
		deleteMode = false
		table.clear(marked)
	end)
	State.Changed:Connect(function()
		Inventory.Render()
	end)
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!strict
-- Turns server Notify messages into toasts and banners:
-- Toast, Discovered, LevelUp, Purchased, ServerLuck. (Reward/Broken are
-- handled by Farming, TradeRequest by Trade.) Also adds the VIP chat tag.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local State = require("../Core/State")
local PetInfo = require("../Core/PetInfo")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Toasts = require("../UI/Toasts")
local HatchAnim = require("./HatchAnim")

local Notifications = {}

local lastLevelToast = 0

local function onNotify(kind: string, data: { [string]: any })
	if kind == "Toast" then
		local tone = if data.Tone == "good" or data.Tone == "bad" or data.Tone == "info" then data.Tone else "info"
		Toasts.Show(tostring(data.Text or ""), tone)
	elseif kind == "Discovered" then
		-- the hatch animation already shows "NEW!"
		if HatchAnim.Playing or type(data.PetId) ~= "string" then
			return
		end
		Toasts.Show(Theme.Icons.Index .. " New pet discovered: <b>" .. PetInfo.Name(data.PetId) .. "</b>!", "purple", { PetId = data.PetId })
	elseif kind == "LevelUp" then
		local uid = data.Uid
		local pet = if type(uid) == "string" then State.PetByUid(uid) else nil
		-- many pets can level at once; keep it to one toast per second
		local now = os.clock()
		if now - lastLevelToast < 1 then
			return
		end
		lastLevelToast = now
		local name = if pet then PetInfo.FullName(pet) else "Your pet"
		Toasts.Show("⬆ " .. name .. " reached level " .. tostring(data.Level or "?") .. "!", "good", {
			PetId = if pet then pet.Id else nil,
			Variant = if pet then pet.Variant else nil,
			Shiny = if pet then pet.Shiny else nil,
			Duration = 2.5,
		})
	elseif kind == "Purchased" then
		Sounds.Play("Rare")
		Toasts.Show("🎉 Thank you! You got <b>" .. tostring(data.Name or "your item") .. "</b>", "gold", { Duration = 5 })
	elseif kind == "ServerLuck" then
		local d = State.Data
		if not d or not d.CanBuyGemEggs then
			return
		end
		Sounds.Play("Reward")
		Toasts.Banner(
			Theme.Icons.Luck .. " Server Luck x" .. tostring(Config.ServerLuckMult) .. "!",
			"Thanks to " .. tostring(data.By or "a kind player") .. "! Everyone hatches luckier.",
			Theme.Colors.Luck,
			4
		)
	end
end

-- VIP chat tag and golden name (TextChatService).
local function setupChat()
	local ok, err = pcall(function()
		TextChatService.OnIncomingMessage = function(message: TextChatMessage): any
			local source = message.TextSource
			if not source then
				return nil
			end
			local p = Players:GetPlayerByUserId(source.UserId)
			if not p or p:GetAttribute("Vip") ~= true then
				return nil
			end
			local props = Instance.new("TextChatMessageProperties")
			props.PrefixText = "<font color=\"#FFC828\">[VIP]</font> <font color=\"#FFD700\">" .. message.PrefixText .. "</font>"
			return props
		end
	end)
	if not ok then
		warn("[Notifications] chat tag setup failed: " .. tostring(err))
	end
end

function Notifications.Init()
	State.Notify:Connect(onNotify)
	setupChat()
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">PetRenderer</string>
              <string name="Source"><![CDATA[--!strict
-- Renders every player's equipped pets locally from the replicated `Pets`
-- player attribute. Pets follow their owner in a neat formation with a soft
-- hover, and fly to the breakable named by the owner's `Target` attribute,
-- hopping and lunging around it. One RenderStepped loop moves them all;
-- models are pooled so equipping/unequipping doesn't rebuild them.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require("../Core/State")
local ModelCache = require("../Core/ModelCache")
local Breakables = require("../Core/Breakables")

local PetRenderer = {}

-- A part that cycles through the rainbow: its authored colour, the hue offset
-- from its RainbowHue attribute, and its saturation/brightness (kept).
type RainbowPart = { Part: BasePart, Color: Color3, Hue: number, S: number, V: number }

type Follower = {
	Uid: string,
	Key: string,
	Variant: string,
	Model: Model,
	Pos: Vector3,
	Yaw: number,
	Phase: number,
	Rainbow: { RainbowPart }?,
}

type Owner = {
	Player: Player,
	Raw: string,
	Followers: { Follower },
	Conns: { RBXScriptConnection },
}

local localPlayer = Players.LocalPlayer
local folder: Folder
local owners: { [Player]: Owner } = {}
local pool: { [string]: { Model } } = {}

local SPACING = 4.6
local PER_ROW = 4
local CULL_DISTANCE = 320
local HOVER = 0.7
local POOL_PER_KEY = 4 -- spare models kept per pet look; extras are destroyed

local function hideOthers(): boolean
	return State.Setting("HideOthersPets", false) == true
end

local function acquire(petId: string, variant: string, shiny: boolean): Model
	local key = ModelCache.PetKey(petId, variant, shiny)
	local list = pool[key]
	if list and #list > 0 then
		return table.remove(list) :: Model
	end
	local m = ModelCache.Pet(petId, variant, shiny)
	if variant == "Golden" then
		local root = m.PrimaryPart
		if root and not root:FindFirstChildOfClass("PointLight") then
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 210, 90)
			light.Brightness = 0.9
			light.Range = 7
			light.Parent = root
		end
	end
	return m
end

local function release(f: Follower)
	f.Model.Parent = nil
	if f.Rainbow then
		-- restore the authored colours before pooling
		for _, entry in f.Rainbow do
			entry.Part.Color = entry.Color
		end
	end
	local list = pool[f.Key]
	if not list then
		list = {}
		pool[f.Key] = list
	end
	local l = list :: { Model }
	if #l >= POOL_PER_KEY then
		f.Model:Destroy()
		return
	end
	table.insert(l, f.Model)
end

type Entry = { Uid: string, Id: string, Variant: string, Shiny: boolean }

local function parse(raw: any): { Entry }
	local out: { Entry } = {}
	if type(raw) ~= "string" or raw == "" then
		return out
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(decoded) ~= "table" then
		return out
	end
	for _, e in decoded do
		if type(e) == "table" and type(e.Id) == "string" then
			table.insert(out, {
				Uid = tostring(e.Uid or e.Id),
				Id = e.Id,
				Variant = if type(e.Variant) == "string" then e.Variant else "Normal",
				Shiny = e.Shiny == true,
			})
		end
		if #out >= 16 then
			break
		end
	end
	return out
end

local function rootOf(p: Player): BasePart?
	local char = p.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function rebuild(o: Owner)
	local raw = o.Player:GetAttribute("Pets")
	local entries: { Entry } = {}
	if o.Player == localPlayer or not hideOthers() then
		entries = parse(raw)
	end
	o.Raw = if type(raw) == "string" then raw else ""
	-- keep followers whose uid and look are unchanged
	local keep: { [string]: Follower } = {}
	for _, f in o.Followers do
		keep[f.Uid .. "#" .. f.Key] = f
	end
	local root = rootOf(o.Player)
	local start = if root then root.Position else Vector3.zero
	local list: { Follower } = {}
	for i, e in entries do
		local key = ModelCache.PetKey(e.Id, e.Variant, e.Shiny)
		local f = keep[e.Uid .. "#" .. key]
		if f then
			keep[e.Uid .. "#" .. key] = nil
		else
			local m = acquire(e.Id, e.Variant, e.Shiny)
			local nf: Follower = {
				Uid = e.Uid,
				Key = key,
				Variant = e.Variant,
				Model = m,
				Pos = start + Vector3.new(math.random() * 2 - 1, 1, math.random() * 2 - 1),
				Yaw = 0,
				Phase = (i - 1) * 1.7 + math.random() * 0.5,
				Rainbow = nil,
			}
			if e.Variant == "Rainbow" then
				-- only parts the model marked with RainbowHue (eyes etc. keep their colour)
				local parts: { RainbowPart } = {}
				for _, d in m:GetDescendants() do
					local hue = d:GetAttribute("RainbowHue")
					if d:IsA("BasePart") and type(hue) == "number" then
						local _, sat, val = d.Color:ToHSV()
						table.insert(parts, { Part = d, Color = d.Color, Hue = hue, S = sat, V = val })
					end
				end
				nf.Rainbow = if #parts > 0 then parts else nil
			end
			m.Parent = folder
			f = nf
		end
		table.insert(list, f :: Follower)
	end
	for _, f in keep do
		release(f)
	end
	o.Followers = list
end

local function track(p: Player)
	if owners[p] then
		return
	end
	local o: Owner = { Player = p, Raw = "", Followers = {}, Conns = {} }
	owners[p] = o
	table.insert(o.Conns, p:GetAttributeChangedSignal("Pets"):Connect(function()
		rebuild(o)
	end))
	rebuild(o)
end

local function untrack(p: Player)
	local o = owners[p]
	if not o then
		return
	end
	owners[p] = nil
	for _, c in o.Conns do
		c:Disconnect()
	end
	for _, f in o.Followers do
		release(f)
	end
end

local function angleLerp(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

local rainbowClock = 0

local function step(dt: number)
	local now = os.clock()
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	local alpha = 1 - math.exp(-dt * 7)
	local turn = 1 - math.exp(-dt * 10)
	rainbowClock += dt
	local doRainbow = rainbowClock > 0.08
	if doRainbow then
		rainbowClock = 0
	end
	for p, o in owners do
		local root = rootOf(p)
		local n = #o.Followers
		if n == 0 then
			continue
		end
		if not root or (root.Position - camPos).Magnitude > CULL_DISTANCE then
			for _, f in o.Followers do
				if f.Model.Parent ~= nil then
					f.Model.Parent = nil
				end
			end
			continue
		end
		local rootPos = root.Position
		local hum = (root.Parent :: Instance):FindFirstChildOfClass("Humanoid")
		local groundY = rootPos.Y - (if hum then hum.HipHeight else 2) - root.Size.Y / 2
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		if look.Magnitude < 0.01 then
			look = Vector3.new(0, 0, -1)
		end
		look = look.Unit
		local flat = CFrame.lookAt(Vector3.new(rootPos.X, groundY, rootPos.Z), Vector3.new(rootPos.X, groundY, rootPos.Z) + look)
		local targetId = p:GetAttribute("Target")
		local info = if type(targetId) == "string" then Breakables.Get(targetId) else nil
		if info and (info.Center - rootPos).Magnitude > 200 then
			info = nil
		end
		local rows = math.ceil(n / PER_ROW)
		for i, f in o.Followers do
			local goal: Vector3
			local faceDir: Vector3?
			if info then
				-- circle the breakable, hopping and lunging in
				local radius = math.max(info.Size.X, info.Size.Z) / 2 + 2.2
				local ang = (i - 1) / n * math.pi * 2 + now * 0.25
				local lunge = math.max(0, math.sin(now * 5 + f.Phase)) * 1.4
				local r = radius - lunge
				local hop = math.abs(math.sin(now * 5 + f.Phase)) * 1.8
				goal = Vector3.new(info.Center.X + math.cos(ang) * r, info.Bottom + 0.2 + hop, info.Center.Z + math.sin(ang) * r)
				faceDir = Vector3.new(info.Center.X - goal.X, 0, info.Center.Z - goal.Z)
			else
				local row = (i - 1) // PER_ROW
				local inRow = if row < rows - 1 then PER_ROW else n - row * PER_ROW
				local col = (i - 1) % PER_ROW
				local x = (col - (inRow - 1) / 2) * SPACING
				local z = 5 + row * SPACING + math.abs(x) * 0.25 -- slight V shape
				local base = flat:PointToWorldSpace(Vector3.new(x, 0, z))
				goal = Vector3.new(base.X, groundY + HOVER + math.sin(now * 2.4 + f.Phase) * 0.35, base.Z)
			end
			local dist = (goal - f.Pos).Magnitude
			local prev = f.Pos
			if dist > 90 then
				f.Pos = goal
			else
				f.Pos = f.Pos:Lerp(goal, alpha)
			end
			local moved = f.Pos - prev
			local dir: Vector3
			if faceDir and faceDir.Magnitude > 0.05 then
				dir = faceDir
			elseif Vector3.new(moved.X, 0, moved.Z).Magnitude > dt * 3 then
				dir = Vector3.new(moved.X, 0, moved.Z)
			else
				dir = look
			end
			local yaw = math.atan2(-dir.X, -dir.Z)
			f.Yaw = angleLerp(f.Yaw, yaw, turn)
			if f.Model.Parent ~= folder then
				f.Model.Parent = folder
			end
			f.Model:PivotTo(CFrame.new(f.Pos) * CFrame.Angles(0, f.Yaw, 0))
			if doRainbow and f.Rainbow then
				for _, entry in f.Rainbow do
					entry.Part.Color = Color3.fromHSV((entry.Hue + now * 0.25) % 1, entry.S, entry.V)
				end
			end
		end
	end
end

function PetRenderer.Init()
	local f = Instance.new("Folder")
	f.Name = "ClientPets"
	f.Parent = Workspace
	folder = f
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	for _, p in Players:GetPlayers() do
		track(p)
	end
	-- re-evaluate everyone when HideOthersPets flips
	local lastHide = hideOthers()
	State.Changed:Connect(function()
		local h = hideOthers()
		if h ~= lastHide then
			lastHide = h
			for _, o in owners do
				rebuild(o)
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return PetRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[--!strict
-- Quests panel: daily login streak (with countdown to the next claim), the 3
-- daily quests with progress bars, and playtime gifts for this session.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Toasts = require("../UI/Toasts")
local RewardText = require("../UI/RewardText")

local Quests = {}

local win: Windows.Window
local content: ScrollingFrame
local tab = "Daily"
local selectTab: (string) -> ()
local tickers: { () -> () } = {}
local renderedSig = ""
local questBars: { [number]: (number, string?) -> () } = {}

local QUEST_TEXT: { [string]: string } = {
	Break = "Break %s things",
	Hatch = "Hatch %s eggs",
	Expedition = "Finish %s expeditions",
	Coins = "Earn %s coins",
	Craft = "Craft %s pets",
}

local QUEST_ICON: { [string]: string } = {
	Break = "💥",
	Hatch = Theme.Icons.Egg,
	Expedition = Theme.Icons.Expeditions,
	Coins = Theme.Icons.Coins,
	Craft = Theme.Icons.Craft,
}

local function secondsToNextDay(): number
	local now = State.Now()
	return 86400 - (now % 86400)
end

local function claimed(res: { [string]: any }?)
	if res then
		Sounds.Play("Reward")
		local text = RewardText(if type(res.reward) == "table" then res.reward else nil)
		Toasts.Show(Theme.Icons.Gift .. " Claimed! " .. text, "good")
	end
end

local function renderDaily()
	local d = State.Data
	if not d then
		return
	end
	local daily = d.Daily
	local n = #Config.DailyRewards
	-- the streak continues only when the last claim was yesterday (UTC days)
	local today = math.floor(State.Now() / 86400)
	local nextDay = if not daily.CanClaim then daily.Streak elseif daily.LastDay >= today - 1 then daily.Streak + 1 else 1
	local highlight = ((math.max(1, nextDay) - 1) % n) + 1
	local top = Kit.box({ Size = UDim2.new(1, -10, 0, 50), LayoutOrder = 1, Parent = content })
	Kit.fitLabel("🔥 Streak: " .. daily.Streak .. " day" .. (if daily.Streak == 1 then "" else "s"), 28, {
		Size = UDim2.fromScale(1, 1),
		Align = "Left",
		Parent = top,
	})
	local row = Kit.box({ Size = UDim2.new(1, -10, 0, 170), LayoutOrder = 2, Parent = content }, {
		Kit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center),
	})
	for i, r in Config.DailyRewards do
		local isNext = i == highlight
		local done = i < highlight or (i == highlight and not daily.CanClaim)
		local tile = Kit.panel({
			Size = UDim2.fromOffset(106, 160),
			LayoutOrder = i,
			BackgroundColor3 = if isNext and daily.CanClaim then Theme.Lighten(Theme.Colors.Good, 0.6) elseif done then Theme.Colors.PanelDark else Theme.Colors.Panel,
			StrokeColor = if isNext then Theme.Colors.Good else Theme.Colors.Stroke,
			Parent = row,
		})
		Kit.fitLabel("Day " .. i, 20, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 6), Parent = tile })
		Kit.fitLabel(if done then Theme.Icons.Equipped else Theme.Icons.Gift, 38, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 34), Parent = tile })
		Kit.fitLabel(RewardText(r :: any), 15, {
			Size = UDim2.new(1, -8, 0, 64),
			Position = UDim2.fromOffset(4, 88),
			Font = Theme.FontBody,
			Parent = tile,
		})
	end
	local bottom = Kit.box({ Size = UDim2.new(1, -10, 0, 80), LayoutOrder = 3, Parent = content })
	if daily.CanClaim then
		Kit.button(Theme.Icons.Gift .. " Claim Day " .. highlight, "Green", {
			Size = UDim2.fromOffset(300, 70),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Parent = bottom,
		}, function()
			claimed(Remote.CallOnce("ClaimDaily"))
		end)
	else
		local l = Kit.fitLabel("", 24, { Size = UDim2.fromScale(1, 1), Color = Theme.Colors.TextDim, Parent = bottom })
		local function tick()
			l.Text = Theme.Icons.Clock .. " Next reward in " .. Format.time(secondsToNextDay())
		end
		tick()
		table.insert(tickers, tick)
	end
end

local function renderQuests()
	local d = State.Data
	if not d then
		return
	end
	local l = Kit.fitLabel("", 20, { Size = UDim2.new(1, -10, 0, 30), LayoutOrder = 0, Color = Theme.Colors.TextDim, Parent = content })
	local function tick()
		l.Text = Theme.Icons.Clock .. " New quests in " .. Format.time(secondsToNextDay())
	end
	tick()
	table.insert(tickers, tick)
	if #d.Quests == 0 then
		Kit.fitLabel("No quests right now.", 22, { Size = UDim2.new(1, -10, 0, 40), LayoutOrder = 1, Parent = content })
	end
	for i, q in d.Quests do
		local done = q.Progress >= q.Goal
		local row = Kit.panel({
			Size = UDim2.new(1, -10, 0, 100),
			LayoutOrder = i,
			BackgroundColor3 = if q.Claimed then Theme.Colors.PanelDark elseif done then Theme.Lighten(Theme.Colors.Good, 0.65) else Theme.Colors.Panel,
			Parent = content,
		})
		Kit.fitLabel(QUEST_ICON[q.Kind] or Theme.Icons.Quests, 40, { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(10, 15), Parent = row })
		local fmt = QUEST_TEXT[q.Kind] or (q.Kind .. " %s")
		Kit.fitLabel(string.format(fmt, Format.num(q.Goal)), 24, {
			Size = UDim2.new(1, -360, 0, 34),
			Position = UDim2.fromOffset(86, 10),
			Align = "Left",
			Parent = row,
		})
		local bar, set = Kit.bar({ Size = UDim2.new(1, -360, 0, 28), Position = UDim2.fromOffset(86, 56) }, if done then Theme.Colors.Good else Theme.Colors.Info)
		bar.Parent = row
		set(q.Progress / math.max(1, q.Goal), Format.num(math.min(q.Progress, q.Goal)) .. " / " .. Format.num(q.Goal))
		questBars[i] = set
		local b = Kit.button(
			if q.Claimed then Theme.Icons.Equipped .. " Done" else "Claim " .. Theme.Icons.Gems .. q.Gems,
			if q.Claimed then "Grey" elseif done then "Green" else "White",
			{
				Size = UDim2.fromOffset(230, 66),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Parent = row,
			},
			function()
				claimed(Remote.CallOnce("ClaimQuest", i))
			end
		)
		if q.Claimed or not done then
			Kit.setButton(b, { Enabled = false })
		end
	end
end

local function renderGifts()
	local d = State.Data
	if not d then
		return
	end
	local grid = Kit.box({ Size = UDim2.new(1, -10, 0, 440), LayoutOrder = 1, Parent = content }, { Kit.grid(Vector2.new(250, 200), 12) })
	for i, gift in Config.PlaytimeGifts do
		local isClaimed = d.Playtime.Claimed[tostring(i)] == true
		local tile = Kit.panel({
			LayoutOrder = i,
			BackgroundColor3 = if isClaimed then Theme.Colors.PanelDark else Theme.Colors.Panel,
			Parent = grid,
		})
		Kit.fitLabel(if isClaimed then Theme.Icons.Equipped else Theme.Icons.Gift, 44, { Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 8), Parent = tile })
		Kit.fitLabel(RewardText(gift :: any), 22, { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 66), Parent = tile })
		local b = Kit.button("", "Green", {
			Size = UDim2.new(1, -24, 0, 58),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -12),
			Parent = tile,
		}, function()
			claimed(Remote.CallOnce("ClaimPlaytime", i))
		end)
		local ready: boolean? = nil
		local function tick()
			if isClaimed then
				Kit.setButton(b, { Text = "Claimed", Enabled = false })
				return
			end
			local left = (gift.Minutes or 0) * 60 - State.SessionMinutes() * 60
			if left <= 0 then
				if ready ~= true then
					ready = true
					Kit.setButton(b, { Text = Theme.Icons.Gift .. " Claim!", Enabled = true, Tone = "Green" })
				end
			else
				ready = false
				Kit.setButton(b, { Text = Theme.Icons.Clock .. " " .. Format.time(left), Enabled = false })
			end
		end
		tick()
		table.insert(tickers, tick)
	end
end

local function render(force: boolean?)
	if not win.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	local sig = tab .. tostring(d.Daily.CanClaim) .. d.Daily.Streak
	-- progress alone doesn't rebuild the list: bars are updated in place
	for _, q in d.Quests do
		sig ..= q.Kind .. q.Goal .. tostring(q.Progress >= q.Goal) .. tostring(q.Claimed)
	end
	for k in d.Playtime.Claimed do
		sig ..= k
	end
	if sig == renderedSig and not force then
		for i, set in questBars do
			local q = d.Quests[i]
			if q then
				set(q.Progress / math.max(1, q.Goal), Format.num(math.min(q.Progress, q.Goal)) .. " / " .. Format.num(q.Goal))
			end
		end
		return
	end
	renderedSig = sig
	table.clear(tickers)
	table.clear(questBars)
	Kit.clear(content)
	if tab == "Daily" then
		renderDaily()
	elseif tab == "Quests" then
		renderQuests()
	else
		renderGifts()
	end
end

function Quests.Init()
	win = Windows.Create("Quests", { Title = "Quests & Rewards", Icon = Theme.Icons.Quests, Color = Theme.Tones.Purple.Top })
	local _, sel = Kit.tabs(win.Body, { "Daily", "Quests", "Gifts" }, {
		Daily = "🔥 Daily",
		Quests = Theme.Icons.Quests .. " Quests",
		Gifts = Theme.Icons.Gift .. " Gifts",
	}, function(name: string)
		tab = name
		render(true)
	end)
	selectTab = sel
	content = Kit.scroll({
		Size = UDim2.new(1, 0, 1, -64),
		Position = UDim2.fromOffset(0, 64),
		Parent = win.Body,
	}, { Kit.list(Enum.FillDirection.Vertical, 10), Kit.pad(4, 8, 6, 4) })
	Windows.Register("Quests", function(which: string?)
		Windows.Show("Quests")
		if which then
			selectTab(which)
		else
			-- open on the tab with something to claim
			local d = State.Data
			local pick = tab
			if d then
				local questReady = false
				for _, q in d.Quests do
					if not q.Claimed and q.Progress >= q.Goal then
						questReady = true
					end
				end
				if d.Daily.CanClaim then
					pick = "Daily"
				elseif questReady then
					pick = "Quests"
				end
			end
			selectTab(pick)
		end
	end)
	State.Changed:Connect(function()
		render()
	end)
	task.spawn(function()
		while true do
			if win.IsOpen then
				for _, t in tickers do
					t()
				end
			end
			task.wait(0.5)
		end
	end)
end

return Quests
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Rebirth</string>
              <string name="Source"><![CDATA[--!strict
-- Rebirth menu: cost, what resets, what you keep, and the permanent bonus.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Toasts = require("../UI/Toasts")

local Rebirth = {}

local win: Windows.Window
local info: TextLabel
local setProgress: (number, string?) -> ()
local btn: TextButton

local function render()
	if not win.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	local now = d.Rebirths
	local maxed = now >= Config.MaxRebirths
	local bonusNow = math.floor(now * Config.RebirthCoinBonus * 100 + 0.5)
	local bonusNext = math.floor((now + 1) * Config.RebirthCoinBonus * 100 + 0.5)
	info.Text = string.format(
		"Rebirths: <b>%d</b>  (coin bonus <b>+%d%%</b>)\n\n"
			.. "<font color=\"#2FA84F\"><b>You get:</b></font> +%d%% coins forever (total +%d%%) and %s %d gems\n"
			.. "<font color=\"#F05454\"><b>Resets:</b></font> your coins and opened islands\n"
			.. "<font color=\"#5896FF\"><b>You keep:</b></font> pets, gems, passes and your Index",
		now,
		bonusNow,
		math.floor(Config.RebirthCoinBonus * 100 + 0.5),
		bonusNext,
		Theme.Icons.Gems,
		Config.RebirthGems
	)
	setProgress(d.Coins / math.max(1, d.RebirthCost), Theme.Icons.Coins .. " " .. Format.num(d.Coins) .. " / " .. Format.num(d.RebirthCost))
	if maxed then
		Kit.setButton(btn, { Text = "Max rebirths!", Enabled = false })
	else
		Kit.setButton(btn, {
			Text = Theme.Icons.Rebirth .. " Rebirth  " .. Theme.Icons.Coins .. Format.num(d.RebirthCost),
			Enabled = d.Coins >= d.RebirthCost,
			Tone = "Purple",
		})
	end
end

function Rebirth.Init()
	win = Windows.Create("Rebirth", {
		Title = "Rebirth",
		Icon = Theme.Icons.Rebirth,
		Color = Theme.Tones.Purple.Rim,
		Size = Vector2.new(680, 480),
	})
	info = Kit.fitLabel("", 22, {
		Size = UDim2.new(1, -20, 0, 210),
		Position = UDim2.fromOffset(10, 4),
		Font = Theme.FontBody,
		Align = "Left",
		Rich = true,
		Parent = win.Body,
	})
	local bar, set = Kit.bar({ Size = UDim2.new(1, -40, 0, 38), Position = UDim2.fromOffset(20, 226) }, Theme.Colors.Coins)
	bar.Parent = win.Body
	setProgress = set
	btn = Kit.button("Rebirth", "Purple", {
		Size = UDim2.fromOffset(380, 76),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		TextSize = 28,
		Parent = win.Body,
	}, function()
		local d = State.Data
		if not d then
			return
		end
		Windows.Confirm(
			"Rebirth now?",
			"Your coins and opened islands reset. You keep all pets and gems and earn more coins forever.",
			"Rebirth!",
			"Purple",
			function()
				local res = Remote.CallOnce("Rebirth")
				if res then
					Sounds.Play("Rare")
					Toasts.Banner("Rebirth!", "Coins are now boosted forever", Theme.Rarity.Epic, 3)
					Windows.Close()
				end
			end
		)
	end)
	win.Opened:Connect(render)
	State.Changed:Connect(render)
end

return Rebirth
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--!strict
-- Settings: Music, Sound effects, Hide other players' pets, Auto Farm (only
-- with the AutoFarm pass). Saved on the server via SetSetting.

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Shop = require("./Shop")

local Settings = {}

type Row = { Key: string, Label: string, Blurb: string, Default: boolean, Pass: string? }

local ROWS: { Row } = {
	{ Key = "Music", Label = "🎵 Music", Blurb = "Background music", Default = true },
	{ Key = "Sfx", Label = "🔊 Sound effects", Blurb = "Clicks, coins and hatching sounds", Default = true },
	{ Key = "HideOthersPets", Label = "🙈 Hide other pets", Blurb = "Only show your own pets (smoother on phones)", Default = false },
	{ Key = "AutoFarm", Label = "🤖 Auto Farm", Blurb = "Pets attack the nearest coins on their own", Default = false, Pass = "AutoFarm" },
}

local win: Windows.Window
local toggles: { [string]: TextButton } = {}

local function render()
	for _, row in ROWS do
		local b = toggles[row.Key]
		if b then
			if row.Pass and not State.HasPass(row.Pass) then
				Kit.setButton(b, { Text = Theme.Icons.Lock .. " Get pass", Tone = "Purple" })
			else
				local on = State.Setting(row.Key, row.Default) == true
				Kit.setButton(b, { Text = if on then "ON" else "OFF", Tone = if on then "Green" else "White" })
			end
		end
	end
end

local function toggle(row: Row)
	if row.Pass and not State.HasPass(row.Pass) then
		Shop.Upsell(row.Pass)
		return
	end
	local old = State.Setting(row.Key, row.Default) == true
	local new = not old
	State.SetLocalSetting(row.Key, new)
	render()
	local res = Remote.CallOnce("SetSetting", row.Key, new)
	if not res then
		State.SetLocalSetting(row.Key, old)
		render()
	end
end

function Settings.Init()
	win = Windows.Create("Settings", {
		Title = "Settings",
		Icon = Theme.Icons.Settings,
		Color = Theme.Tones.Grey.Rim,
		Size = Vector2.new(680, 500),
	})
	local list = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = win.Body }, {
		Kit.list(Enum.FillDirection.Vertical, 10),
		Kit.pad(4, 8, 4, 4),
	})
	for i, row in ROWS do
		local f = Kit.panel({ Size = UDim2.new(1, -10, 0, 90), LayoutOrder = i, Parent = list })
		Kit.fitLabel(row.Label, 26, { Size = UDim2.new(1, -200, 0, 36), Position = UDim2.fromOffset(16, 8), Align = "Left", Parent = f })
		Kit.fitLabel(row.Blurb, 16, {
			Size = UDim2.new(1, -200, 0, 34),
			Position = UDim2.fromOffset(16, 46),
			Align = "Left",
			Font = Theme.FontBody,
			Color = Theme.Colors.TextDim,
			Parent = f,
		})
		toggles[row.Key] = Kit.button("", "White", {
			Size = UDim2.fromOffset(160, 64),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Parent = f,
		}, function()
			toggle(row)
		end)
	end
	win.Opened:Connect(render)
	State.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Shop: game passes, gem packs and boosts. Configured items (Id ~= 0) open the
-- Roblox purchase prompt with live prices; unconfigured ones (Id 0) are
-- simulated with DevPurchase in Studio and show "Coming soon" in live games.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))
local Config = require(Shared:WaitForChild("Config"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Format = require("../Core/Format")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Toasts = require("../UI/Toasts")

local Shop = {}

local player = Players.LocalPlayer
local win: Windows.Window
local content: ScrollingFrame
local tab = "Passes"
local selectTab: (string) -> ()
local prices: { [string]: number } = {} -- "pass:<id>" / "product:<id>" -> live Robux price
local fetching: { [string]: boolean } = {}

local PASS_ICONS: { [string]: string } = {
	VIP = "👑",
	Lucky = Theme.Icons.Luck,
	TripleHatch = "🥚🥚🥚",
	FastHatch = "⏩",
	MoreEquip = Theme.Icons.Pets,
	MoreExpeditions = Theme.Icons.Expeditions,
	AutoFarm = "🤖",
	BigBackpack = "🎒",
}

local function render(_force: boolean?) end -- forward declared below

local function fetchPrice(kind: string, id: number)
	local key = kind .. ":" .. tostring(id)
	if id == 0 or prices[key] or fetching[key] then
		return
	end
	fetching[key] = true
	task.spawn(function()
		local infoType = if kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
		local ok, info = pcall(function()
			local mps = MarketplaceService :: any
			-- prefer the newer async name when the engine has it
			local okNew, res = pcall(function()
				return mps:GetProductInfoAsync(id, infoType)
			end)
			if okNew and type(res) == "table" then
				return res
			end
			return MarketplaceService:GetProductInfo(id, infoType)
		end)
		fetching[key] = false
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
			prices[key] = info.PriceInRobux
			render()
		end
	end)
end

local function priceText(kind: string, id: number, fallback: number): string
	if id == 0 then
		return if RunService:IsStudio() then "Test buy" else "Coming soon"
	end
	local p = prices[kind .. ":" .. tostring(id)]
	fetchPrice(kind, id)
	return "R$ " .. tostring(p or fallback)
end

-- Luck items (Lucky pass, luck boost, server luck) are hidden for players
-- whose policy restricts paid random items (State.CanBuyGemEggs = false).
local LUCK_ITEMS: { [string]: boolean } = { Lucky = true, BoostLuck = true, ServerLuck = true }

local function luckAllowed(): boolean
	local d = State.Data
	return d ~= nil and d.CanBuyGemEggs == true
end

local function hidden(key: string): boolean
	return LUCK_ITEMS[key] == true and not luckAllowed()
end

local function devPurchase(key: string)
	local res = Remote.CallOnce("DevPurchase", key)
	if res then
		Toasts.Show("Studio test purchase: " .. key, "good")
	end
end

function Shop.BuyPass(key: string)
	local pass = Products.PassByKey[key]
	if not pass or hidden(key) then
		return
	end
	if State.HasPass(key) then
		Toasts.Show("You already own " .. pass.Name .. "!", "info")
		return
	end
	if pass.Id ~= 0 then
		local ok, err = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		end)
		if not ok then
			warn("[Shop] " .. tostring(err))
			Toasts.Show("The shop is busy. Try again!", "bad")
		end
	elseif RunService:IsStudio() then
		devPurchase(key)
	else
		Toasts.Show(pass.Name .. " is coming soon!", "info")
	end
end

function Shop.BuyProduct(key: string)
	local product = Products.ByKey[key]
	if not product or hidden(key) then
		return
	end
	if product.Id ~= 0 then
		local ok, err = pcall(function()
			MarketplaceService:PromptProductPurchase(player, product.Id)
		end)
		if not ok then
			warn("[Shop] " .. tostring(err))
			Toasts.Show("The shop is busy. Try again!", "bad")
		end
	elseif RunService:IsStudio() then
		devPurchase(key)
	else
		Toasts.Show(product.Name .. " is coming soon!", "info")
	end
end

-- Popup offering a pass (used when a locked feature is tapped).
function Shop.Upsell(key: string, reason: string?)
	local pass = Products.PassByKey[key]
	if not pass or hidden(key) then
		return
	end
	Windows.Confirm(
		(PASS_ICONS[key] or Theme.Icons.Star) .. " " .. pass.Name,
		(if reason then reason .. "\n\n" else "") .. pass.Blurb,
		priceText("pass", pass.Id, pass.Price),
		"Green",
		function()
			Shop.BuyPass(key)
		end,
		"Not now"
	)
end

local function card(order: number, icon: string, title: string, blurb: string, color: Color3): Frame
	local c = Kit.panel({
		Name = title,
		LayoutOrder = order,
		BackgroundColor3 = Theme.Lighten(color, 0.78),
		StrokeColor = Theme.Darken(color, 0.3),
		Parent = content,
	}, { Kit.shade(0.12) })
	Kit.fitLabel(icon, 40, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 8), Parent = c })
	Kit.fitLabel(title, 24, {
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 58),
		Outline = Theme.Darken(color, 0.45),
		Parent = c,
	})
	Kit.fitLabel(blurb, 16, {
		Name = "Blurb",
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.fromOffset(10, 90),
		Font = Theme.FontBody,
		Color = Theme.Colors.TextDim,
		Parent = c,
	})
	return c
end

local function buyButton(parent: Instance, text: string, tone: string, enabled: boolean, onClick: () -> ())
	local b = Kit.button(text, tone, {
		Size = UDim2.new(1, -24, 0, 54),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Parent = parent,
	}, onClick)
	if not enabled then
		Kit.setButton(b, { Enabled = false })
	end
	return b
end

local renderedSig = ""
local tickers: { () -> () } = {}

local function renderImpl(force: boolean?)
	if not win or not win.IsOpen then
		return
	end
	-- rebuild only when owned passes, known prices, the tab or which boosts
	-- are active change; boost timers tick in place
	local sig = tab .. tostring(luckAllowed())
	for _, pass in Products.Passes do
		sig ..= if State.HasPass(pass.Key) then "1" else "0"
	end
	for k in prices do
		sig ..= k
	end
	if tab == "Boosts" then
		sig ..= tostring(State.ServerLuckLeft() > 0)
		for _, product in Products.Products do
			if product.Boost then
				sig ..= tostring(State.BoostLeft(product.Boost) > 0)
			end
		end
	end
	if sig == renderedSig and not force then
		return
	end
	renderedSig = sig
	table.clear(tickers)
	Kit.clear(content)
	if tab == "Passes" then
		for i, pass in Products.Passes do
			if hidden(pass.Key) then
				continue
			end
			local owned = State.HasPass(pass.Key)
			local c = card(i, PASS_ICONS[pass.Key] or Theme.Icons.Star, pass.Name, pass.Blurb, Theme.Rarity.Legendary)
			if owned then
				buyButton(c, Theme.Icons.Equipped .. " Owned", "Green", false, function() end)
			else
				buyButton(c, priceText("pass", pass.Id, pass.Price), "Green", true, function()
					Shop.BuyPass(pass.Key)
				end)
			end
		end
	elseif tab == "Gems" then
		local i = 0
		for _, product in Products.Products do
			if product.Kind == "Gems" then
				i += 1
				local c = card(i, string.rep(Theme.Icons.Gems, math.min(3, 1 + i // 2)), Format.commas(product.Amount or 0) .. " Gems", "Spend on Prism Eggs and skipping expeditions.", Theme.Colors.Gems)
				buyButton(c, priceText("product", product.Id, product.Price), "Green", true, function()
					Shop.BuyProduct(product.Key)
				end)
			end
		end
	else
		local i = 0
		for _, product in Products.Products do
			if product.Kind ~= "Gems" and not hidden(product.Key) then
				i += 1
				local blurb: string
				if product.Kind == "ServerLuck" then
					blurb = "x" .. tostring(Config.ServerLuckMult) .. " luck for EVERYONE in this server for " .. Format.duration(Config.ServerLuckSeconds) .. "!"
				else
					local def = Config.Boosts[product.Boost or ""]
					blurb = (if def then def.Name else "Boost") .. " for " .. Format.duration(if def then def.Seconds else 0) .. ". Stacks by adding time."
				end
				local icon = if product.Kind == "ServerLuck" then Theme.Icons.Luck .. "🌍" elseif product.Boost == "Luck2x" then Theme.Icons.Luck else Theme.Icons.Coins .. Theme.Icons.Boost
				local c = card(i, icon, product.Name, blurb, if product.Kind == "ServerLuck" or product.Boost == "Luck2x" then Theme.Colors.Luck else Theme.Colors.Coins)
				local blurbLabel = c:FindFirstChild("Blurb") :: TextLabel?
				local kind, boost = product.Kind, product.Boost or ""
				local function tick()
					local l = if kind == "ServerLuck" then State.ServerLuckLeft() else State.BoostLeft(boost)
					if blurbLabel then
						blurbLabel.Text = blurb .. (if l > 0 then "\nActive: " .. Format.time(l) else "")
					end
				end
				tick()
				table.insert(tickers, tick)
				buyButton(c, priceText("product", product.Id, product.Price), "Green", true, function()
					Shop.BuyProduct(product.Key)
				end)
			end
		end
	end
end
render = renderImpl

function Shop.Init()
	win = Windows.Create("Shop", { Title = "Shop", Icon = Theme.Icons.Shop, Color = Theme.Tones.Pink.Top })
	local _, sel = Kit.tabs(win.Body, { "Passes", "Gems", "Boosts" }, {
		Passes = Theme.Icons.Star .. " Passes",
		Gems = Theme.Icons.Gems .. " Gems",
		Boosts = Theme.Icons.Boost .. " Boosts",
	}, function(name: string)
		tab = name
		render(true)
	end)
	selectTab = sel
	content = Kit.scroll({
		Size = UDim2.new(1, 0, 1, -64),
		Position = UDim2.fromOffset(0, 64),
		Parent = win.Body,
	}, { Kit.grid(Vector2.new(260, 210), 12), Kit.pad(6, 8, 6, 6) })
	Windows.Register("Shop", function(which: string?)
		Windows.Show("Shop")
		selectTab(which or tab)
	end)
	State.Changed:Connect(function()
		render()
	end)
	task.spawn(function()
		while true do
			if win.IsOpen then
				for _, t in tickers do
					t()
				end
			end
			task.wait(0.5)
		end
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who: Player, _id: number, bought: boolean)
		if who == player and bought then
			Toasts.Show("Thank you! Your pass is being added...", "good")
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Trade</string>
              <string name="Source"><![CDATA[--!strict
-- Trading: a player list with Request buttons, the incoming request popup
-- (accept / decline, times out), and the trade window showing both offers
-- with pet pictures, a gems box, Ready toggle, countdown and Cancel.
-- Disabled with a message when CanTrade is false (PolicyService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local PetInfo = require("../Core/PetInfo")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local PetCard = require("../UI/PetCard")
local Toasts = require("../UI/Toasts")

type PetInstance = Types.PetInstance
type TradeView = Types.TradeView
type TradeSide = Types.TradeSide

local Trade = {}

local player = Players.LocalPlayer

-- Player list window
local listWin: Windows.Window
local playerList: ScrollingFrame
local disabledNote: TextLabel
local requestedAt: { [number]: number } = {}

-- Trade window
local tradeWin: Windows.Window
local myGrid: ScrollingFrame
local theirGrid: ScrollingFrame
local myReady: Frame
local theirReady: Frame
local theirTitle: TextLabel
local theirGems: TextLabel
local gemsBox: TextBox
local readyBtn: TextButton
local addBtn: TextButton
local countdownLabel: TextLabel
local picker: Frame
local pickerGrid: ScrollingFrame
local pickerSig = ""
local lastViewId: string? = nil
local renderedSig = ""

local function myOffer(): ({ string }, number)
	local v = State.Trade
	if not v then
		return {}, 0
	end
	local uids: { string } = {}
	for _, p in v.Me.Pets do
		table.insert(uids, p.Uid)
	end
	return uids, v.Me.Gems
end

local function sendOffer(uids: { string }, gems: number)
	Remote.CallOnce("TradeSetOffer", uids, gems)
end

-- Player list ---------------------------------------------------------------------

local function renderList()
	if not listWin.IsOpen then
		return
	end
	local d = State.Data
	Kit.clear(playerList)
	local can = d ~= nil and d.CanTrade
	disabledNote.Visible = not can
	playerList.Visible = can
	if not can then
		return
	end
	local others = {}
	for _, p in Players:GetPlayers() do
		if p ~= player then
			table.insert(others, p)
		end
	end
	table.sort(others, function(a, b)
		return a.DisplayName:lower() < b.DisplayName:lower()
	end)
	if #others == 0 then
		Kit.fitLabel("Nobody else is here yet. Invite a friend!", 22, {
			Size = UDim2.new(1, -10, 0, 60),
			Color = Theme.Colors.TextDim,
			Parent = playerList,
		})
	end
	for i, p in others do
		local row = Kit.panel({ Size = UDim2.new(1, -10, 0, 84), LayoutOrder = i, Parent = playerList })
		local thumb: ImageLabel = Kit.new("ImageLabel", {
			Size = UDim2.fromOffset(68, 68),
			Position = UDim2.fromOffset(8, 8),
			BackgroundColor3 = Theme.Colors.PanelDark,
			Parent = row,
		}, { Kit.corner(UDim.new(0.5, 0)) })
		task.spawn(function()
			local ok, img = pcall(function()
				return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if ok and thumb.Parent then
				thumb.Image = img
			end
		end)
		Kit.fitLabel(p.DisplayName, 24, { Size = UDim2.new(1, -320, 0, 34), Position = UDim2.fromOffset(88, 10), Align = "Left", Parent = row })
		Kit.fitLabel("@" .. p.Name, 16, {
			Size = UDim2.new(1, -320, 0, 24),
			Position = UDim2.fromOffset(88, 46),
			Align = "Left",
			Font = Theme.FontBody,
			Color = Theme.Colors.TextDim,
			Parent = row,
		})
		local uid = p.UserId
		local b = Kit.button(Theme.Icons.Trade .. " Request", "Blue", {
			Size = UDim2.fromOffset(210, 62),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Parent = row,
		}, nil)
		b.Activated:Connect(function()
			local since = os.clock() - (requestedAt[uid] or -999)
			if since < Config.TradeCooldown then
				Toasts.Show("Wait " .. math.ceil(Config.TradeCooldown - since) .. "s before asking again.", "info")
				return
			end
			Sounds.Play("Click")
			local res = Remote.CallOnce("TradeRequest", uid)
			if res then
				requestedAt[uid] = os.clock()
				Toasts.Show("Trade request sent to " .. p.DisplayName .. "!", "good")
				Kit.setButton(b, { Text = "Sent!", Tone = "Grey" })
			end
		end)
	end
end

-- Incoming request popup ---------------------------------------------------------------

local function showRequest(fromUserId: number, fromName: string)
	local d = State.Data
	if d and not d.CanTrade then
		return
	end
	local gui = Windows.Gui("Popups")
	local box = Kit.panel({
		Name = "TradeRequest",
		Size = UDim2.fromOffset(460, 190),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Corner = 20,
		StrokeThickness = 4,
		Parent = gui,
	})
	Kit.autoScale(box, 1)
	Kit.fitLabel(Theme.Icons.Trade .. " " .. fromName .. " wants to trade!", 26, {
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.fromOffset(10, 10),
		Parent = box,
	})
	local bar, set = Kit.bar({ Size = UDim2.new(1, -40, 0, 16), Position = UDim2.fromOffset(20, 58) }, Theme.Colors.Info)
	bar.Parent = box
	local done = false
	local function close()
		done = true
		box:Destroy()
	end
	Kit.button("Decline", "Red", {
		Size = UDim2.fromOffset(190, 64),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -16),
		Parent = box,
	}, function()
		close()
		Remote.Quiet("TradeRespond", fromUserId, false)
	end)
	Kit.button("Accept", "Green", {
		Size = UDim2.fromOffset(190, 64),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -16),
		Parent = box,
	}, function()
		close()
		Remote.CallOnce("TradeRespond", fromUserId, true)
	end)
	Kit.pop(box)
	Sounds.Play("Toast")
	task.spawn(function()
		local start = os.clock()
		while not done do
			local left = Config.TradeRequestTimeout - (os.clock() - start)
			if left <= 0 then
				close()
				break
			end
			set(left / Config.TradeRequestTimeout)
			task.wait(0.1)
		end
	end)
end

-- Trade window ----------------------------------------------------------------------

local function readyBadge(f: Frame, ready: boolean)
	f.BackgroundColor3 = if ready then Theme.Colors.Good else Theme.Colors.Locked
	Kit.setPill(f, if ready then Theme.Icons.Equipped .. " Ready" else "Not ready")
end

local function fillGrid(grid: ScrollingFrame, pets: { PetInstance })
	Kit.clear(grid)
	for i, p in pets do
		local c = PetCard.new(p, Vector2.new(92, 108), nil)
		c.LayoutOrder = i
		c.Parent = grid
	end
	if #pets == 0 then
		Kit.fitLabel("No pets offered", 18, { Size = UDim2.fromOffset(200, 40), Color = Theme.Colors.TextDim, Parent = grid })
	end
end

local function renderPicker()
	if not picker.Visible then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	local busy = State.BusyUids()
	local offered, gems = myOffer()
	-- rebuild only when something the picker shows has changed
	local sig = table.concat(offered, ",") .. "#" .. table.concat(d.Equipped, ",") .. "#" .. tostring(PetInfo.ScaleArea())
	for _, p in d.Pets do
		sig ..= p.Uid .. p.Variant .. tostring(p.Level) .. tostring(p.Locked) .. tostring(busy[p.Uid] == true) .. ";"
	end
	if sig == pickerSig then
		return
	end
	pickerSig = sig
	Kit.clear(pickerGrid)
	local offeredSet: { [string]: boolean } = {}
	for _, uid in offered do
		offeredSet[uid] = true
	end
	local list: { PetInstance } = {}
	for _, p in d.Pets do
		if not busy[p.Uid] then
			table.insert(list, p)
		end
	end
	PetInfo.Sort(list, nil)
	for i, p in list do
		local uid = p.Uid
		local card = PetCard.new(p, Vector2.new(92, 108), function()
			if p.Locked then
				Toasts.Show("Locked pets can't be traded. Unlock it in Pets first.", "info")
				return
			end
			local cur = myOffer()
			local idx = table.find(cur, uid)
			if idx then
				table.remove(cur, idx)
			elseif #cur >= Config.TradeMaxPets then
				Toasts.Show("Up to " .. Config.TradeMaxPets .. " pets per trade.", "info")
				return
			else
				table.insert(cur, uid)
			end
			sendOffer(cur, gems)
		end)
		card.LayoutOrder = i
		card.Parent = pickerGrid
		PetCard.SetFlags(card, { Selected = offeredSet[uid] == true, Locked = p.Locked, Equipped = State.IsEquipped(uid), Dim = p.Locked })
	end
end

local function renderTrade()
	local v = State.Trade
	if not v then
		return
	end
	local sig = v.Id .. v.Status .. tostring(v.Me.Ready) .. tostring(v.Them.Ready) .. v.Me.Gems .. "|" .. v.Them.Gems
	for _, p in v.Me.Pets do
		sig ..= p.Uid
	end
	sig ..= "|"
	for _, p in v.Them.Pets do
		sig ..= p.Uid
	end
	if sig ~= renderedSig then
		renderedSig = sig
		theirTitle.Text = v.Them.Name .. "'s offer"
		fillGrid(myGrid, v.Me.Pets)
		fillGrid(theirGrid, v.Them.Pets)
		readyBadge(myReady, v.Me.Ready)
		readyBadge(theirReady, v.Them.Ready)
		theirGems.Text = Theme.Icons.Gems .. " " .. Format.commas(v.Them.Gems)
		if not gemsBox:IsFocused() then
			gemsBox.Text = tostring(v.Me.Gems)
		end
		Kit.setButton(readyBtn, {
			Text = if v.Me.Ready then "Not ready" else Theme.Icons.Equipped .. " Ready",
			Tone = if v.Me.Ready then "Yellow" else "Green",
		})
	end
	renderPicker()
end

local function closeTradeWindow()
	Windows.Lock(nil)
	if tradeWin.IsOpen then
		Windows.Close(true)
	end
	picker.Visible = false
	pickerSig = ""
end

local function onTrade(v: TradeView?)
	if not v or v.Status == "Done" or v.Status == "Cancelled" then
		-- the server sends its own toast for how the trade ended
		if v and v.Status == "Done" then
			Sounds.Play("Reward")
		end
		lastViewId = nil
		renderedSig = ""
		closeTradeWindow()
		return
	end
	if lastViewId ~= v.Id then
		lastViewId = v.Id
		renderedSig = ""
		picker.Visible = false
		pickerSig = ""
	end
	-- an active trade keeps its window open: only Cancel or the server ends it
	Windows.Lock("TradeSession")
	if not tradeWin.IsOpen then
		Windows.Show("TradeSession")
	end
	renderTrade()
end

local function buildTradeWindow()
	tradeWin = Windows.Create("TradeSession", { Title = "Trade", Icon = Theme.Icons.Trade, Color = Theme.Tones.Red.Top })
	local body = tradeWin.Body
	local function side(xScale: number, xOffset: number, title: string): (Frame, TextLabel, Frame, ScrollingFrame)
		local f = Kit.panel({
			Size = UDim2.new(0.5, -6, 1, -78),
			Position = UDim2.new(xScale, xOffset, 0, 0),
			BackgroundColor3 = Theme.Colors.PanelAlt,
			Parent = body,
		})
		local t = Kit.fitLabel(title, 24, { Size = UDim2.new(1, -150, 0, 36), Position = UDim2.fromOffset(12, 6), Align = "Left", Parent = f })
		local badge = Kit.pill("Not ready", Theme.Colors.Locked, {
			Size = UDim2.fromOffset(130, 34),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 8),
			Parent = f,
		})
		local grid = Kit.scroll({
			Size = UDim2.new(1, -16, 1, -108),
			Position = UDim2.fromOffset(8, 48),
			Parent = f,
		}, { Kit.grid(Vector2.new(92, 108), 8), Kit.pad(6, 4, 6, 4) })
		return f, t, badge, grid
	end
	local mine, _, mb, mg = side(0, 0, "Your offer")
	myReady, myGrid = mb, mg
	local _, tt, tb, tg = side(0.5, 6, "Their offer")
	theirTitle, theirReady, theirGrid = tt, tb, tg
	-- gems
	local gemsIcon = Kit.fitLabel(Theme.Icons.Gems, 30, { Size = UDim2.fromOffset(40, 46), Position = UDim2.new(0, 12, 1, -54), Parent = mine })
	gemsBox = Kit.new("TextBox", {
		Size = UDim2.new(1, -70, 0, 44),
		Position = UDim2.new(0, 56, 1, -54),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Font = Theme.Font,
		TextSize = 24,
		TextColor3 = Theme.Colors.Text,
		PlaceholderText = "Gems to add",
		Text = "0",
		ClearTextOnFocus = false,
		Parent = mine,
	}, { Kit.corner(10), Kit.stroke(Theme.Colors.Stroke, 2) })
	gemsBox.FocusLost:Connect(function()
		local d = State.Data
		local n = tonumber((gemsBox.Text:gsub("[^%d]", ""))) or 0
		n = math.clamp(math.floor(n), 0, math.min(Config.TradeMaxGems, if d then d.Gems else 0))
		gemsBox.Text = tostring(n)
		local uids, gems = myOffer()
		if n ~= gems then
			sendOffer(uids, n)
		end
	end)
	theirGems = Kit.fitLabel(Theme.Icons.Gems .. " 0", 26, {
		Size = UDim2.new(0.5, -30, 0, 44),
		Position = UDim2.new(0.5, 18, 1, -132),
		Align = "Left",
		Parent = body,
	})
	-- Gem trading is switched off when Config.TradeMaxGems is 0 (pets only).
	local gemsAllowed = Config.TradeMaxGems > 0
	gemsIcon.Visible = gemsAllowed
	gemsBox.Visible = gemsAllowed
	theirGems.Visible = gemsAllowed
	-- bottom bar
	local bar = Kit.box({
		Size = UDim2.new(1, 0, 0, 70),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = body,
	})
	addBtn = Kit.button(Theme.Icons.Pets .. " Add pets", "Blue", { Size = UDim2.fromOffset(200, 64), Position = UDim2.fromOffset(0, 3), Parent = bar }, function()
		picker.Visible = not picker.Visible
		pickerSig = ""
		Kit.setButton(addBtn, { Text = if picker.Visible then "Done" else Theme.Icons.Pets .. " Add pets" })
		renderPicker()
	end)
	readyBtn = Kit.button("Ready", "Green", { Size = UDim2.fromOffset(200, 64), Position = UDim2.fromOffset(212, 3), Parent = bar }, function()
		local v = State.Trade
		if v then
			Remote.CallOnce("TradeReady", not v.Me.Ready)
		end
	end)
	countdownLabel = Kit.fitLabel("", 26, {
		Size = UDim2.new(1, -640, 1, 0),
		Position = UDim2.fromOffset(424, 0),
		Color = Theme.Colors.Good,
		Parent = bar,
	})
	Kit.button("Cancel", "Red", {
		Size = UDim2.fromOffset(190, 64),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 3),
		Parent = bar,
	}, function()
		Remote.Quiet("TradeCancel")
		State.Trade = nil
		closeTradeWindow()
	end)
	-- pet picker overlay (covers the left side)
	picker = Kit.panel({
		Size = UDim2.new(0.5, -6, 1, -78),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = body,
	})
	Kit.fitLabel("Tap pets to add or remove", 20, { Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 6), ZIndex = 11, Parent = picker })
	pickerGrid = Kit.scroll({
		Size = UDim2.new(1, -16, 1, -46),
		Position = UDim2.fromOffset(8, 40),
		ZIndex = 11,
		Parent = picker,
	}, { Kit.grid(Vector2.new(92, 108), 8), Kit.pad(6, 4, 6, 4) })
	-- the header X would close the window without ending the trade; use Cancel
	local closeBtn = tradeWin.Header:FindFirstChild("Close") :: GuiObject?
	if closeBtn then
		closeBtn.Visible = false
	end
	tradeWin.Closed:Connect(function()
		picker.Visible = false
		pickerSig = ""
		Kit.setButton(addBtn, { Text = Theme.Icons.Pets .. " Add pets" })
	end)
end

function Trade.Init()
	listWin = Windows.Create("Trade", { Title = "Trade", Icon = Theme.Icons.Trade, Color = Theme.Tones.Red.Top, Size = Vector2.new(760, 520) })
	playerList = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = listWin.Body }, {
		Kit.list(Enum.FillDirection.Vertical, 8),
		Kit.pad(4, 8, 4, 4),
	})
	disabledNote = Kit.fitLabel(Theme.Icons.Lock .. " Trading isn't available for your account (just joined? give it a few seconds).", 24, {
		Size = UDim2.new(1, -20, 0, 80),
		Position = UDim2.fromOffset(10, 120),
		Color = Theme.Colors.TextDim,
		Visible = false,
		Parent = listWin.Body,
	})
	listWin.Opened:Connect(renderList)
	Players.PlayerAdded:Connect(renderList)
	Players.PlayerRemoving:Connect(function()
		task.defer(renderList)
	end)
	buildTradeWindow()

	State.TradeChanged:Connect(onTrade)
	local lastCanTrade: boolean? = nil
	State.Changed:Connect(function(d: any)
		if d and d.CanTrade ~= lastCanTrade then
			lastCanTrade = d.CanTrade
			renderList()
		end
		renderPicker()
	end)
	Windows.Refused:Connect(function()
		if Windows.LockedName() == "TradeSession" then
			Toasts.Show("Finish or cancel your trade first.", "info")
		end
	end)
	State.Notify:Connect(function(kind: string, data: { [string]: any })
		if kind == "TradeRequest" and type(data.FromUserId) == "number" then
			showRequest(data.FromUserId, tostring(data.FromName or "Someone"))
		end
	end)
	task.spawn(function()
		while true do
			local left = State.TradeCountdown()
			if countdownLabel then
				countdownLabel.Text = if left then "Trading in " .. math.ceil(left) .. "..." else ""
			end
			task.wait(0.1)
		end
	end)
end

return Trade
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-time hints with a glowing beam and a bouncing arrow:
--   1. walk to the Meadow egg stand and hatch a pet
--   2. tap a coin pile so your pets break it
--   3. collect coins and open the gate to the next island
-- Progress comes from the player's Stats/Areas, so nothing extra is saved.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared:WaitForChild("Areas"))

local State = require("../Core/State")
local Format = require("../Core/Format")
local Breakables = require("../Core/Breakables")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")

local Tutorial = {}

local player = Players.LocalPlayer
local hint: Frame
local hintText: TextLabel
local anchor: Part
local arrowGui: BillboardGui
local beam: Beam
local att1: Attachment
local att0: Attachment? = nil

local FIRST = Areas.List[1]
local SECOND = Areas.List[2]

local function posOf(inst: Instance): Vector3?
	if inst:IsA("Model") then
		local cf, size = inst:GetBoundingBox()
		return cf.Position + Vector3.new(0, size.Y / 2, 0)
	elseif inst:IsA("BasePart") then
		return inst.Position + Vector3.new(0, inst.Size.Y / 2, 0)
	end
	return nil
end

local function findTagged(tag: string, attr: string, value: string): Instance?
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:GetAttribute(attr) == value then
			return inst
		end
	end
	return nil
end

local function nearestPile(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local best: Vector3? = nil
	local bestD = math.huge
	for _, info in Breakables.All() do
		if info.Kind == "CoinPile" and info.Area == FIRST.Id and info.Model.Parent then
			local d = (info.Center - root.Position).Magnitude
			if d < bestD then
				bestD = d
				best = info.Center + Vector3.new(0, info.Size.Y / 2, 0)
			end
		end
	end
	return best
end

-- Returns (hint text, target position) for the current step, or nil when done.
local function step(): (string?, Vector3?)
	local d = State.Data
	if not d then
		return nil, nil
	end
	if d.Stats.Hatched == 0 then
		local stand = findTagged("EggStand", "EggId", FIRST.Egg)
		return Theme.Icons.Egg .. " Walk to the egg stand and hatch your first pet!", if stand then posOf(stand) else nil
	end
	if d.Stats.Broken == 0 then
		return Theme.Icons.Coins .. " Tap a coin pile to send your pets!", nearestPile()
	end
	if SECOND and not d.Areas[SECOND.Id] then
		local gate = findTagged("Gate", "AreaId", SECOND.Id)
		local text = if d.Coins >= SECOND.GateCost
			then Theme.Icons.Islands .. " You have enough! Open the gate to " .. SECOND.Name
			else Theme.Icons.Coins .. " Collect " .. Format.num(d.Coins) .. "/" .. Format.num(SECOND.GateCost) .. " coins, then open the gate"
		return text, if gate then posOf(gate) else nil
	end
	return nil, nil
end

local function ensureAttachment0(): Attachment?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local a = att0
	if a and a.Parent == root then
		return a
	end
	local na = Instance.new("Attachment")
	na.Name = "TutorialBeam"
	na.Parent = root
	att0 = na
	return na
end

local function update()
	local text, target = step()
	local busy = Windows.CurrentName() ~= nil
	hint.Visible = text ~= nil and not busy
	if text then
		hintText.Text = text
	end
	local a0 = ensureAttachment0()
	local show = text ~= nil and target ~= nil and a0 ~= nil
	beam.Enabled = show
	arrowGui.Enabled = show
	if show then
		anchor.Position = target :: Vector3
		beam.Attachment0 = a0
	end
end

function Tutorial.Init()
	hint = Kit.panel({
		Name = "TutorialHint",
		Size = UDim2.fromOffset(560, 56),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -80),
		BackgroundColor3 = Color3.fromRGB(255, 250, 220),
		StrokeColor = Theme.Tones.Yellow.Rim,
		Corner = 28,
		Visible = false,
		Parent = Windows.Gui("Hud"),
	})
	Kit.autoScale(hint, 1)
	hintText = Kit.fitLabel("", 24, { Size = UDim2.new(1, -24, 1, -8), Position = UDim2.fromOffset(12, 4), Parent = hint })

	local folder = Workspace:FindFirstChild("ClientFx") or Workspace
	local p = Instance.new("Part")
	p.Name = "TutorialTarget"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Parent = folder
	anchor = p
	att1 = Instance.new("Attachment")
	att1.Parent = p
	local b = Instance.new("Beam")
	b.Attachment1 = att1
	b.FaceCamera = true
	b.Width0 = 0.9
	b.Width1 = 0.9
	b.Segments = 12
	b.LightEmission = 1
	b.Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 140, 60))
	b.Transparency = NumberSequence.new(0.15, 0.35)
	b.TextureSpeed = 1
	b.Enabled = false
	b.Parent = p
	beam = b
	arrowGui = Kit.new("BillboardGui", {
		Size = UDim2.fromOffset(80, 80),
		StudsOffset = Vector3.new(0, 4, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Adornee = p,
		Enabled = false,
		Parent = p,
	})
	local arrow = Kit.fitLabel("⬇", 64, {
		Size = UDim2.fromScale(1, 1),
		Color = Theme.Colors.Coins,
		Outline = Theme.Tones.Yellow.Rim,
		Parent = arrowGui,
	})
	RunService.RenderStepped:Connect(function()
		if arrowGui.Enabled then
			arrow.Position = UDim2.fromOffset(0, math.sin(os.clock() * 5) * 10)
		end
	end)
	task.spawn(function()
		while true do
			update()
			task.wait(0.5)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">World</string>
              <string name="Source"><![CDATA[--!strict
-- World interactables: proximity prompts open the right menu per tag,
-- gates open locally once their island is bought, prompt texts show prices,
-- and the Islands window lists every island with Teleport / Open buttons.

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared:WaitForChild("Areas"))
local Eggs = require(Shared:WaitForChild("Eggs"))
local Types = require(Shared:WaitForChild("Types"))

local State = require("../Core/State")
local Remote = require("../Core/Remote")
local Format = require("../Core/Format")
local Sounds = require("../Core/Sounds")
local Theme = require("../UI/Theme")
local Kit = require("../UI/Kit")
local Windows = require("../UI/Windows")
local Toasts = require("../UI/Toasts")

type PlayerState = Types.PlayerState

local World = {}

local TAGS = { "EggStand", "Gate", "ExpeditionBoard", "CraftMachine", "RebirthStatue", "IndexBook" }

-- Finds the nearest ancestor (or self) carrying one of our tags.
local function taggedAncestor(inst: Instance): (Instance?, string?)
	local cur: Instance? = inst
	while cur and cur ~= workspace and cur ~= game do
		for _, tag in TAGS do
			if CollectionService:HasTag(cur, tag) then
				return cur, tag
			end
		end
		cur = cur.Parent
	end
	return nil, nil
end

function World.OpenGate(areaId: string)
	local a = Areas.ById[areaId]
	local d = State.Data
	if not a or not d then
		return
	end
	if d.Areas[areaId] then
		Toasts.Show(a.Name .. " is already open!", "info")
		return
	end
	-- previous island must be open first
	local prev = Areas.List[a.Index - 1]
	if prev and not d.Areas[prev.Id] then
		Toasts.Show("Open " .. prev.Name .. " first!", "bad")
		return
	end
	local canAfford = d.Coins >= a.GateCost
	Windows.Confirm(
		"Open " .. a.Name .. "?",
		a.Blurb .. "\n\nCost: " .. Theme.Icons.Coins .. " <b>" .. Format.num(a.GateCost) .. "</b>"
			.. (if canAfford then "" else "\n<font color=\"#F05454\">You need " .. Format.num(a.GateCost - d.Coins) .. " more coins.</font>"),
		"Open " .. Theme.Icons.Coins .. Format.num(a.GateCost),
		if canAfford then "Green" else "Grey",
		function()
			local res = Remote.CallOnce("OpenGate", areaId)
			if res then
				Sounds.Play("Reward")
				Toasts.Banner(a.Name .. " unlocked!", "New egg and new treasure ahead", Theme.Colors.Coins, 3)
			end
		end
	)
end

-- Gates ------------------------------------------------------------------------

local function setBarrier(gate: Instance, open: boolean)
	local barrier = gate:FindFirstChild("Barrier", true)
	if barrier and barrier:IsA("BasePart") then
		barrier.CanCollide = not open
		barrier.LocalTransparencyModifier = if open then 1 else 0
		for _, d in barrier:GetDescendants() do
			if d:IsA("Decal") then
				d.LocalTransparencyModifier = if open then 1 else 0
			elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Beam") then
				(d :: any).Enabled = not open
			end
		end
	end
end

local function refreshGate(gate: Instance)
	local d = State.Data
	local areaId = gate:GetAttribute("AreaId")
	if type(areaId) ~= "string" then
		return
	end
	local a = Areas.ById[areaId]
	local open = d ~= nil and d.Areas[areaId] == true
	setBarrier(gate, open)
	for _, p in gate:GetDescendants() do
		if p:IsA("ProximityPrompt") then
			p.Enabled = not open
			if a then
				p.ObjectText = a.Name
				p.ActionText = "Open " .. Theme.Icons.Coins .. Format.num(a.GateCost)
			end
		end
	end
end

local function refreshStand(stand: Instance)
	local eggId = stand:GetAttribute("EggId")
	local egg = if type(eggId) == "string" then Eggs.ById[eggId] else nil
	if not egg then
		return
	end
	for _, p in stand:GetDescendants() do
		if p:IsA("ProximityPrompt") then
			p.ObjectText = egg.Name
			p.ActionText = "Hatch " .. (if egg.Currency == "Gems" then Theme.Icons.Gems else Theme.Icons.Coins) .. Format.num(egg.Cost)
		end
	end
end

local function refreshAll()
	for _, g in CollectionService:GetTagged("Gate") do
		refreshGate(g)
	end
end

-- Islands window -----------------------------------------------------------------

local islandsWin: Windows.Window
local islandList: ScrollingFrame

local function buildIslands()
	islandsWin = Windows.Create("Islands", { Title = "Islands", Icon = Theme.Icons.Islands, Color = Theme.Tones.Blue.Top })
	islandList = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = islandsWin.Body }, {
		Kit.list(Enum.FillDirection.Vertical, 10),
		Kit.pad(4, 10, 4, 4),
	})
end

local islandsSig = ""

local function renderIslands(force: boolean?)
	if not islandsWin.IsOpen then
		return
	end
	local d = State.Data
	if not d then
		return
	end
	-- rebuild only when an island opens or a gate becomes affordable
	local sig = ""
	for _, a in Areas.List do
		sig ..= (if d.Areas[a.Id] then "1" else "0") .. (if d.Coins >= a.GateCost then "1" else "0")
	end
	if sig == islandsSig and not force then
		return
	end
	islandsSig = sig
	Kit.clear(islandList)
	for i, a in Areas.List do
		local open = d.Areas[a.Id] == true
		local prevOpen = i == 1 or d.Areas[Areas.List[i - 1].Id] == true
		local row = Kit.panel({
			Size = UDim2.new(1, -8, 0, 96),
			LayoutOrder = i,
			BackgroundColor3 = if open then Theme.Colors.Panel else Theme.Colors.PanelDark,
			Parent = islandList,
		})
		Kit.fitLabel(tostring(i), 34, {
			Size = UDim2.fromOffset(56, 80),
			Position = UDim2.fromOffset(8, 8),
			Color = Theme.Colors.Coins,
			Outline = true,
			Parent = row,
		})
		Kit.fitLabel(a.Name, 26, {
			Size = UDim2.new(1, -300, 0, 34),
			Position = UDim2.fromOffset(70, 8),
			Align = "Left",
			Parent = row,
		})
		Kit.fitLabel(a.Blurb .. "  " .. Theme.Icons.Coins .. "x" .. Format.num(a.CoinMult), 16, {
			Size = UDim2.new(1, -300, 0, 44),
			Position = UDim2.fromOffset(70, 44),
			Align = "Left",
			Font = Theme.FontBody,
			Color = Theme.Colors.TextDim,
			Parent = row,
		})
		local btnProps = {
			Size = UDim2.fromOffset(210, 64),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Parent = row,
		}
		if open then
			Kit.button("Teleport", "Blue", btnProps, function()
				local res = Remote.CallOnce("Teleport", a.Id)
				if res then
					Windows.Close()
				end
			end)
		elseif prevOpen then
			local b = Kit.button("Open " .. Theme.Icons.Coins .. Format.num(a.GateCost), "Green", btnProps, function()
				World.OpenGate(a.Id)
			end)
			if d.Coins < a.GateCost then
				Kit.setButton(b, { Tone = "Yellow" })
			end
		else
			Kit.button(Theme.Icons.Lock .. " Locked", "Grey", btnProps, function()
				Toasts.Show("Open " .. Areas.List[i - 1].Name .. " first!", "info")
			end)
		end
	end
end

function World.Init()
	buildIslands()
	islandsWin.Opened:Connect(function()
		renderIslands(true)
	end)
	local gatesSig: string? = nil
	State.Changed:Connect(function(d: any)
		-- gates only change when the opened islands do (open, rebirth)
		local sig = ""
		for _, a in Areas.List do
			sig ..= if d and d.Areas[a.Id] then "1" else "0"
		end
		if sig ~= gatesSig then
			gatesSig = sig
			refreshAll()
		end
		renderIslands()
	end)

	CollectionService:GetInstanceAddedSignal("Gate"):Connect(refreshGate)
	CollectionService:GetInstanceAddedSignal("EggStand"):Connect(refreshStand)
	for _, g in CollectionService:GetTagged("Gate") do
		refreshGate(g)
	end
	for _, s in CollectionService:GetTagged("EggStand") do
		refreshStand(s)
	end
	-- prompts can stream in after their model; refresh texts when they appear
	ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt)
		local inst, tag = taggedAncestor(prompt)
		if inst and tag == "Gate" then
			refreshGate(inst)
		elseif inst and tag == "EggStand" then
			refreshStand(inst)
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= game:GetService("Players").LocalPlayer then
			return
		end
		local inst, tag = taggedAncestor(prompt)
		if not inst or not tag then
			return
		end
		if tag == "EggStand" then
			local eggId = inst:GetAttribute("EggId")
			if type(eggId) == "string" then
				Windows.Open("Hatch", eggId, inst)
			end
		elseif tag == "Gate" then
			local areaId = inst:GetAttribute("AreaId")
			if type(areaId) == "string" then
				World.OpenGate(areaId)
			end
		elseif tag == "ExpeditionBoard" then
			Windows.Open("Expeditions")
		elseif tag == "CraftMachine" then
			Windows.Open("Craft")
		elseif tag == "RebirthStatue" then
			Windows.Open("Rebirth")
		elseif tag == "IndexBook" then
			Windows.Open("Index")
		end
	end)
end

return World
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="69">
          <Properties>
            <string name="Name">Core</string>
          </Properties>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Breakables</string>
              <string name="Source"><![CDATA[--!strict
-- Index of breakables in workspace (CollectionService tag "Breakable"), by
-- their `Id` attribute, with cached bounds for effects and pet positioning.

local CollectionService = game:GetService("CollectionService")

local Signal = require("./Signal")

local Breakables = {}

export type Info = {
	Id: string,
	Model: Model,
	Kind: string,
	Area: string,
	Center: Vector3, -- bounding box centre
	Size: Vector3,
	Bottom: number, -- Y of the bounding box bottom
	BoundsAt: number,
}

Breakables.Added = Signal.new() -- (info)
Breakables.Removed = Signal.new() -- (id, info)

local byId: { [string]: Info } = {}
local byModel: { [Instance]: Info } = {}

local function measure(info: Info)
	local ok, cf, size = pcall(function()
		return info.Model:GetBoundingBox()
	end)
	if ok and cf and size then
		info.Center = (cf :: CFrame).Position
		info.Size = size :: Vector3
		info.Bottom = info.Center.Y - (size :: Vector3).Y / 2
	end
	info.BoundsAt = os.clock()
end

local function add(inst: Instance)
	if not inst:IsA("Model") or byModel[inst] then
		return
	end
	local id = inst:GetAttribute("Id")
	if type(id) ~= "string" then
		-- the server may set Id just after tagging; try again when it arrives
		local conn: RBXScriptConnection? = nil
		conn = inst:GetAttributeChangedSignal("Id"):Connect(function()
			if conn then
				conn:Disconnect()
			end
			add(inst)
		end)
		return
	end
	local kind = inst:GetAttribute("Kind")
	local area = inst:GetAttribute("Area")
	local info: Info = {
		Id = id,
		Model = inst,
		Kind = if type(kind) == "string" then kind else "CoinPile",
		Area = if type(area) == "string" then area else "",
		Center = inst:GetPivot().Position,
		Size = Vector3.new(4, 3, 4),
		Bottom = inst:GetPivot().Position.Y,
		BoundsAt = 0,
	}
	measure(info)
	byId[id] = info
	byModel[inst] = info
	Breakables.Added:Fire(info)
	-- parts can stream in a moment later; measure again
	task.delay(1, function()
		if byModel[inst] == info then
			measure(info)
		end
	end)
end

local function remove(inst: Instance)
	local info = byModel[inst]
	if not info then
		return
	end
	byModel[inst] = nil
	if byId[info.Id] == info then
		byId[info.Id] = nil
	end
	Breakables.Removed:Fire(info.Id, info)
end

function Breakables.Get(id: string?): Info?
	if not id or id == "" then
		return nil
	end
	local info = byId[id]
	if info and info.Model.Parent == nil then
		return nil
	end
	return info
end

function Breakables.FromModel(inst: Instance?): Info?
	local cur = inst
	while cur and cur ~= workspace do
		local info = byModel[cur]
		if info then
			return info
		end
		cur = cur.Parent
	end
	return nil
end

function Breakables.All(): { [string]: Info }
	return byId
end

function Breakables.Init()
	CollectionService:GetInstanceAddedSignal("Breakable"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("Breakable"):Connect(remove)
	for _, inst in CollectionService:GetTagged("Breakable") do
		add(inst)
	end
end

return Breakables
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Format</string>
              <string name="Source"><![CDATA[--!strict
-- Number and time formatting for the UI.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 999 -> "999", 1234 -> "1.2K", 3400000 -> "3.4M", 5.6e9 -> "5.6B", 7.8e12 -> "7.8T", 1e15 -> "1Qa".
function Format.num(n: number?): string
	local v = n or 0
	if v ~= v then
		return "0"
	end
	local neg = v < 0
	v = math.abs(v)
	if v < 1000 then
		local s = tostring(math.floor(v))
		return if neg then "-" .. s else s
	end
	local tier = math.min(math.floor(math.log10(v) / 3), #SUFFIXES - 1)
	local scaled = v / 10 ^ (tier * 3)
	local s: string
	if scaled >= 100 then
		s = tostring(math.floor(scaled))
	else
		-- one decimal, dropped when it is .0 ("1K" rather than "1.0K")
		local t = math.floor(scaled * 10) / 10
		if t == math.floor(t) then
			s = tostring(math.floor(t))
		else
			s = string.format("%.1f", t)
		end
	end
	s ..= SUFFIXES[tier + 1]
	return if neg then "-" .. s else s
end

-- Full number with thousands separators: 1234567 -> "1,234,567".
function Format.commas(n: number): string
	local s = tostring(math.floor(n))
	local formatted = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then
		formatted = string.sub(formatted, 2)
	end
	formatted = string.gsub(formatted, "^%-,", "-")
	return formatted
end

-- Countdown: "45s", "3:07", "1:02:03", "2d 4h".
function Format.time(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s >= 86400 then
		return string.format("%dd %dh", s // 86400, (s % 86400) // 3600)
	elseif s >= 3600 then
		return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
	elseif s >= 60 then
		return string.format("%d:%02d", s // 60, s % 60)
	end
	return tostring(s) .. "s"
end

-- Duration words: 300 -> "5 min", 7200 -> "2 h".
function Format.duration(seconds: number): string
	if seconds >= 3600 then
		local h = seconds / 3600
		return (if h == math.floor(h) then tostring(math.floor(h)) else string.format("%.1f", h)) .. " h"
	end
	return tostring(math.floor(seconds / 60)) .. " min"
end

function Format.percent(p: number): string
	-- p is 0..100
	if p >= 10 then
		return string.format("%.1f%%", p)
	elseif p >= 0.01 then
		return string.format("%.2f%%", p)
	elseif p > 0 then
		return string.format("%.3f%%", p)
	end
	return "0%"
end

return Format
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">ModelCache</string>
              <string name="Source"><![CDATA[--!strict
-- Builds each pet/egg model once (Models builds them from primitives, which
-- costs a little) and hands out clones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Models = require(Shared:WaitForChild("Models"))

local ModelCache = {}

local templates: { [string]: Model } = {}

local function fallback(name: string): Model
	-- used only if the model builder errors, so the UI never breaks
	local m = Instance.new("Model")
	m.Name = name
	local p = Instance.new("Part")
	p.Name = "Root"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(2.5, 2.5, 2.5)
	p.Color = Color3.fromRGB(240, 200, 120)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CFrame = CFrame.new(0, 1.25, 0)
	p.Parent = m
	p.PivotOffset = CFrame.new(0, -1.25, 0) -- pivot at the bottom centre, like Models
	m.PrimaryPart = p
	return m
end

local function prepare(m: Model)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		end
	end
end

function ModelCache.PetKey(petId: string, variant: string, shiny: boolean): string
	return petId .. "|" .. variant .. "|" .. (if shiny then "1" else "0")
end

function ModelCache.Pet(petId: string, variant: string, shiny: boolean): Model
	local key = "P:" .. ModelCache.PetKey(petId, variant, shiny)
	local t = templates[key]
	if not t then
		local ok, res = pcall(Models.Pet, petId, variant, shiny)
		local m = if ok and typeof(res) == "Instance" and res:IsA("Model") then res else fallback(petId)
		if not ok then
			warn("[ModelCache] Models.Pet failed for " .. petId .. ": " .. tostring(res))
		end
		prepare(m)
		templates[key] = m
		t = m
	end
	return (t :: Model):Clone()
end

function ModelCache.Egg(eggId: string): Model
	local key = "E:" .. eggId
	local t = templates[key]
	if not t then
		local ok, res = pcall(Models.Egg, eggId)
		local m = if ok and typeof(res) == "Instance" and res:IsA("Model") then res else fallback(eggId)
		if not ok then
			warn("[ModelCache] Models.Egg failed for " .. eggId .. ": " .. tostring(res))
		end
		prepare(m)
		templates[key] = m
		t = m
	end
	return (t :: Model):Clone()
end

return ModelCache
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">PetInfo</string>
              <string name="Source"><![CDATA[--!strict
-- Read-only pet helpers for the UI: display power, sorting, odds with luck.
-- Formulas come from the shared Logic modules (PetMath, Hatch, Economy) so
-- the UI always shows exactly what the server uses.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared:WaitForChild("Pets"))
local Eggs = require(Shared:WaitForChild("Eggs"))
local Types = require(Shared:WaitForChild("Types"))
local Logic = Shared:WaitForChild("Logic")
local PetMath = require(Logic:WaitForChild("PetMath"))
local HatchLogic = require(Logic:WaitForChild("Hatch"))
local Economy = require(Logic:WaitForChild("Economy"))

local State = require("./State")

type PetInstance = Types.PetInstance

local PetInfo = {}

function PetInfo.RarityIndex(rarity: string): number
	return math.max(1, PetMath.RarityIndex(rarity))
end

-- Island whose power multiplier gem pets use right now (the player's highest
-- opened island, as on the server).
function PetInfo.ScaleArea(): string?
	local d = State.Data
	if not d then
		return nil
	end
	return Economy.HighestArea(d :: any)
end

function PetInfo.Species(petId: string): Pets.Pet?
	return Pets.ById[petId]
end

function PetInfo.Name(petId: string): string
	local s = Pets.ById[petId]
	return if s then s.Name else petId
end

function PetInfo.Rarity(petId: string): string
	local s = Pets.ById[petId]
	return if s then s.Rarity else "Common"
end

-- Base power of a species (rarity x island; gem pets use the scale island).
function PetInfo.BasePower(petId: string): number
	return PetMath.BasePower(petId, PetInfo.ScaleArea())
end

-- Power of a pet instance including variant, shiny and level.
function PetInfo.Power(p: PetInstance): number
	return PetMath.Power(p :: any, PetInfo.ScaleArea())
end

-- Key that groups pets that can be crafted together.
function PetInfo.CraftKey(p: PetInstance): string
	return p.Id .. "|" .. p.Variant .. "|" .. (if p.Shiny then "S" else "N")
end

function PetInfo.NextVariant(variant: string): string?
	return PetMath.NextVariant(variant)
end

-- Display name like "Golden Fox" or "Shiny Rainbow Puppy".
function PetInfo.FullName(p: PetInstance): string
	local name = PetInfo.Name(p.Id)
	if p.Variant ~= "Normal" then
		name = p.Variant .. " " .. name
	end
	if p.Shiny then
		name = "Shiny " .. name
	end
	return name
end

export type OddsRow = { Pet: string, Base: number, Boosted: number }

-- Odds for an egg in percent: base (no luck) and boosted by the player's luck.
function PetInfo.Odds(eggId: string, luckMult: number): { OddsRow }
	local egg = Eggs.ById[eggId]
	local rows: { OddsRow } = {}
	if not egg then
		return rows
	end
	local base = HatchLogic.Odds(egg, 1)
	local boosted = HatchLogic.Odds(egg, luckMult)
	for _, o in egg.Odds do
		table.insert(rows, { Pet = o.Pet, Base = base[o.Pet] or 0, Boosted = boosted[o.Pet] or 0 })
	end
	return rows
end

-- Sort: equipped first, then power, rarity and name.
function PetInfo.Sort(list: { PetInstance }, equipped: { string }?)
	local eq: { [string]: boolean } = {}
	if equipped then
		for _, uid in equipped do
			eq[uid] = true
		end
	end
	local power: { [string]: number } = {}
	for _, p in list do
		power[p.Uid] = PetInfo.Power(p)
	end
	table.sort(list, function(a, b)
		local ea, eb = eq[a.Uid] == true, eq[b.Uid] == true
		if ea ~= eb then
			return ea
		end
		local pa, pb = power[a.Uid], power[b.Uid]
		if pa ~= pb then
			return pa > pb
		end
		if a.Id ~= b.Id then
			return a.Id < b.Id
		end
		return a.Uid < b.Uid
	end)
end

return PetInfo
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Remote</string>
              <string name="Source"><![CDATA[--!strict
-- Server calls. Every RemoteFunction is invoked inside pcall; a failed call
-- or an { ok = false, err } result shows the reason as a toast.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local Toasts = require("../UI/Toasts")
local State = require("./State")

local Remote = {}

export type Result = { [string]: any }

local busy: { [string]: boolean } = {}

-- Claims and purchases stay blocked after a success until the next State
-- snapshot shows the result (or a short timeout), so a quick double tap on a
-- button that still says "Claim" doesn't send a second request.
local HOLD_AFTER_SUCCESS: { [string]: boolean } = {
	ClaimExpedition = true,
	SkipExpedition = true,
	StartExpedition = true,
	ClaimDaily = true,
	ClaimPlaytime = true,
	ClaimQuest = true,
	ClaimIndex = true,
	DevPurchase = true,
	OpenGate = true,
	Rebirth = true,
	CraftPet = true,
	DeletePets = true,
}
local holds: { [string]: number } = {} -- name -> os.clock() deadline

local function isBusy(name: string): boolean
	if busy[name] then
		return true
	end
	local h = holds[name]
	if h and os.clock() < h then
		return true
	end
	holds[name] = nil
	return false
end

local function release(name: string, succeeded: boolean)
	busy[name] = false
	if succeeded and HOLD_AFTER_SUCCESS[name] then
		holds[name] = os.clock() + 1.5
	end
end

-- The next snapshot carries the result, so lift every hold then.
State.Changed:Connect(function()
	table.clear(holds)
end)

-- Returns the result table when ok, nil otherwise (after showing a toast).
-- `quiet` suppresses the error toast.
function Remote.Call(name: string, ...: any): Result?
	local args = table.pack(...)
	local ok, res = pcall(function()
		return Net.Function(name):InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		warn("[Remote] " .. name .. " failed: " .. tostring(res))
		Toasts.Show("Couldn't reach the server. Try again!", "bad")
		return nil
	end
	if type(res) ~= "table" then
		Toasts.Show("Something went wrong. Try again!", "bad")
		return nil
	end
	if res.ok ~= true then
		Toasts.Show(tostring(res.err or "That didn't work."), "bad")
		return nil
	end
	return res
end

-- Same as Call but ignores repeated taps while a call with this name is in
-- flight (and, for claims and purchases, until the result shows up).
function Remote.CallOnce(name: string, ...: any): Result?
	if isBusy(name) then
		return nil
	end
	busy[name] = true
	local ok, res = pcall(Remote.Call, name, ...)
	release(name, ok and res ~= nil)
	if not ok then
		warn("[Remote] " .. tostring(res))
		return nil
	end
	return res
end

-- Like Call but shows no toast: returns (result, nil) or (nil, readable error)
-- so the caller can add its own hint. Guarded like CallOnce: returns
-- (nil, nil) when the same call is already in flight.
function Remote.Try(name: string, ...: any): (Result?, string?)
	if isBusy(name) then
		return nil, nil
	end
	busy[name] = true
	local args = table.pack(...)
	local ok, res = pcall(function()
		return Net.Function(name):InvokeServer(table.unpack(args, 1, args.n))
	end)
	release(name, ok and type(res) == "table" and res.ok == true)
	if not ok then
		warn("[Remote] " .. name .. " failed: " .. tostring(res))
		return nil, "Couldn't reach the server. Try again!"
	end
	if type(res) ~= "table" then
		return nil, "Something went wrong. Try again!"
	end
	if res.ok ~= true then
		return nil, tostring(res.err or "That didn't work.")
	end
	return res, nil
end

-- Same as Call, but errors are not shown (for background polling-style calls).
function Remote.Quiet(name: string, ...: any): Result?
	local args = table.pack(...)
	local ok, res = pcall(function()
		return Net.Function(name):InvokeServer(table.unpack(args, 1, args.n))
	end)
	if ok and type(res) == "table" and res.ok == true then
		return res
	end
	return nil
end

function Remote.Fire(name: string, ...: any)
	local args = table.pack(...)
	local ok, err = pcall(function()
		Net.Event(name):FireServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		warn("[Remote] " .. name .. " fire failed: " .. tostring(err))
	end
end

return Remote
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Signal</string>
              <string name="Source"><![CDATA[--!strict
-- Minimal signal: Connect returns a disconnect function. Handlers run in
-- order, and an error in one handler doesn't stop the others.

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> () -> (),
	Fire: (self: Signal, ...any) -> (),
	_handlers: { (...any) -> () },
}

local Signal = {}

local function connect(self: Signal, fn: (...any) -> ()): () -> ()
	table.insert(self._handlers, fn)
	return function()
		local i = table.find(self._handlers, fn)
		if i then
			table.remove(self._handlers, i)
		end
	end
end

local function fire(self: Signal, ...: any)
	for _, fn in table.clone(self._handlers) do
		local ok, err = pcall(fn :: any, ...)
		if not ok then
			warn("[Signal] handler error: " .. tostring(err))
		end
	end
end

function Signal.new(): Signal
	return {
		_handlers = {},
		Connect = connect,
		Fire = fire,
	}
end

return Signal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Sounds</string>
              <string name="Source"><![CDATA[--!strict
-- Client sounds. Uses sounds that ship with the Roblox client so nothing has
-- to be uploaded; swap any `Id` for a licensed rbxassetid:// later.
-- Respects the Sfx and Music settings.

local SoundService = game:GetService("SoundService")

local State = require("./State")

local Sounds = {}

export type SoundDef = { Id: string, Volume: number, Speed: number }

Sounds.Defs = {
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.5, Speed = 1.1 },
	Open = { Id = "rbxasset://sounds/button.wav", Volume = 0.4, Speed = 0.85 },
	Coin = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, Speed = 1.5 },
	Gem = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.45, Speed = 2 },
	Reward = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 1 },
	Break = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.45, Speed = 0.8 },
	Target = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.35, Speed = 1.3 },
	EggShake = { Id = "rbxasset://sounds/button.wav", Volume = 0.35, Speed = 0.6 },
	Hatch = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, Speed = 0.7 },
	Rare = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.9, Speed = 0.5 },
	Error = { Id = "rbxasset://sounds/button.wav", Volume = 0.5, Speed = 0.5 },
	Toast = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.3, Speed = 1.25 },
} :: { [string]: SoundDef }

-- Background music track. nil until a licensed track is chosen.
Sounds.MusicId = nil :: string?
Sounds.MusicVolume = 0.25

local folder: Folder? = nil
local cache: { [string]: Sound } = {}
local music: Sound? = nil
local lastPlayed: { [string]: number } = {}

local function getFolder(): Folder
	local f = folder
	if f then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "PetExpeditionSounds"
	nf.Parent = SoundService
	folder = nf
	return nf
end

-- Plays a named sound. `pitch` multiplies the playback speed.
function Sounds.Play(name: string, pitch: number?)
	if State.Setting("Sfx", true) == false then
		return
	end
	local def = Sounds.Defs[name]
	if not def then
		return
	end
	-- don't stack the same sound more than ~25 times per second
	local now = os.clock()
	if (lastPlayed[name] or 0) > now - 0.04 then
		return
	end
	lastPlayed[name] = now
	local base = cache[name]
	if not base then
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = def.Id
		s.Volume = def.Volume
		s.Parent = getFolder()
		cache[name] = s
		base = s
	end
	local s = base:Clone()
	s.PlaybackSpeed = def.Speed * (pitch or 1)
	s.Parent = getFolder()
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
	task.delay(6, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

local function refreshMusic()
	local want = State.Setting("Music", true) ~= false and Sounds.MusicId ~= nil
	if want and not music then
		local m = Instance.new("Sound")
		m.Name = "Music"
		m.SoundId = Sounds.MusicId :: string
		m.Looped = true
		m.Volume = Sounds.MusicVolume
		m.Parent = getFolder()
		m:Play()
		music = m
	elseif not want and music then
		music:Destroy()
		music = nil
	end
end

function Sounds.Init()
	State.Changed:Connect(refreshMusic)
end

return Sounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
-- Client state store. Receives the server's `State` snapshots and the `Trade`
-- window, keeps a clock offset to the server, and fires change signals the
-- controllers subscribe to. Everything here is read-only from the UI's point
-- of view: changes always go through the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))

local Signal = require("./Signal")

export type PlayerState = Types.PlayerState
export type PetInstance = Types.PetInstance
export type TradeView = Types.TradeView

local State = {}

State.Data = nil :: PlayerState?
State.Previous = nil :: PlayerState?
State.Trade = nil :: TradeView?
State.TradeReceivedAt = 0
State.ReceivedAt = 0 -- os.clock() when the last snapshot arrived

-- (new, old) every snapshot
State.Changed = Signal.new()
-- (view?) every trade update
State.TradeChanged = Signal.new()
-- (kind, data) every Notify
State.Notify = Signal.new()
-- fires once, the first time a snapshot arrives
State.Ready = Signal.new()

local offset = 0
local gotFirst = false

local function localNow(): number
	return DateTime.now().UnixTimestampMillis / 1000
end

-- Server time estimate (seconds, os.time scale, fractional).
function State.Now(): number
	return localNow() + offset
end

function State.Get(): PlayerState?
	return State.Data
end

-- Wait until the first snapshot is in.
function State.Wait(): PlayerState
	while not State.Data do
		task.wait()
	end
	return State.Data :: PlayerState
end

function State.HasPass(key: string): boolean
	local d = State.Data
	return d ~= nil and d.Passes[key] == true
end

function State.Setting(key: string, default: any): any
	local d = State.Data
	if not d or d.Settings == nil then
		return default
	end
	local v = d.Settings[key]
	if v == nil then
		return default
	end
	return v
end

-- Optimistic local update of a setting (the server echoes the real value).
function State.SetLocalSetting(key: string, value: any)
	local d = State.Data
	if d then
		d.Settings[key] = value
		State.Changed:Fire(d, d)
	end
end

function State.BoostLeft(key: string): number
	local d = State.Data
	if not d then
		return 0
	end
	local untilT = d.Boosts[key]
	if not untilT then
		return 0
	end
	return math.max(0, untilT - State.Now())
end

function State.ServerLuckLeft(): number
	local d = State.Data
	if not d then
		return 0
	end
	return math.max(0, (d.ServerLuckUntil or 0) - State.Now())
end

function State.PetByUid(uid: string): PetInstance?
	local d = State.Data
	if not d then
		return nil
	end
	for _, p in d.Pets do
		if p.Uid == uid then
			return p
		end
	end
	return nil
end

function State.IsEquipped(uid: string): boolean
	local d = State.Data
	return d ~= nil and table.find(d.Equipped, uid) ~= nil
end

-- Set of uids currently away on an expedition.
function State.BusyUids(): { [string]: boolean }
	local set: { [string]: boolean } = {}
	local d = State.Data
	if d then
		for _, e in d.Expeditions do
			for _, uid in e.Pets do
				set[uid] = true
			end
		end
	end
	return set
end

-- Set of uids offered in the open trade (can't be deleted, crafted or sent away).
function State.TradeUids(): { [string]: boolean }
	local set: { [string]: boolean } = {}
	local t = State.Trade
	if t then
		for _, p in t.Me.Pets do
			set[p.Uid] = true
		end
	end
	return set
end

-- os.clock() when this session started, estimated from the snapshots. The
-- server floors SessionMinutes, so each snapshot gives a start that is up to a
-- minute too late; we only ever move the estimate earlier so countdowns never
-- jump back up.
local sessionStart: number? = nil

local function noteSession(d: PlayerState)
	local minutes = d.Playtime and d.Playtime.SessionMinutes
	if type(minutes) ~= "number" then
		return
	end
	local candidate = os.clock() - minutes * 60
	local cur = sessionStart
	if cur == nil or candidate < cur then
		sessionStart = candidate
	end
end

-- Minutes played this session (smooth between snapshots).
function State.SessionMinutes(): number
	local start = sessionStart
	if not start then
		return 0
	end
	return (os.clock() - start) / 60
end

function State.TradeCountdown(): number?
	local t = State.Trade
	if not t or t.Countdown == nil then
		return nil
	end
	return math.max(0, t.Countdown - (os.clock() - State.TradeReceivedAt))
end

function State.Init()
	Net.Event("State").OnClientEvent:Connect(function(data: PlayerState)
		if type(data) ~= "table" then
			return
		end
		if type(data.ServerTime) == "number" then
			local diff = data.ServerTime - localNow()
			-- ServerTime is whole seconds, so only resync on real drift
			if not gotFirst or math.abs(diff - offset) > 1.5 then
				offset = diff
			end
		end
		local old = State.Data
		State.Previous = old
		State.Data = data
		State.ReceivedAt = os.clock()
		noteSession(data)
		State.Changed:Fire(data, old)
		if not gotFirst then
			gotFirst = true
			State.Ready:Fire(data)
		end
	end)
	Net.Event("Trade").OnClientEvent:Connect(function(view: TradeView?)
		State.Trade = if type(view) == "table" then view else nil
		State.TradeReceivedAt = os.clock()
		State.TradeChanged:Fire(State.Trade)
	end)
	Net.Event("Notify").OnClientEvent:Connect(function(kind: string, data: any)
		if type(kind) ~= "string" then
			return
		end
		State.Notify:Fire(kind, if type(data) == "table" then data else {})
	end)
end

return State
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="78">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client boot: starts every controller (each in its own pcall so one failure
-- can't take the whole UI down), then tells the server the UI is ready.

local StarterGui = game:GetService("StarterGui")

local State = require("./Core/State")
local Sounds = require("./Core/Sounds")
local Breakables = require("./Core/Breakables")
local Remote = require("./Core/Remote")

local Hud = require("./Controllers/Hud")
local World = require("./Controllers/World")
local Farming = require("./Controllers/Farming")
local PetRenderer = require("./Controllers/PetRenderer")
local Shop = require("./Controllers/Shop")
local Hatch = require("./Controllers/Hatch")
local Inventory = require("./Controllers/Inventory")
local Craft = require("./Controllers/Craft")
local Expeditions = require("./Controllers/Expeditions")
local Quests = require("./Controllers/Quests")
local IndexMenu = require("./Controllers/IndexMenu")
local Rebirth = require("./Controllers/Rebirth")
local Settings = require("./Controllers/Settings")
local Trade = require("./Controllers/Trade")
local Notifications = require("./Controllers/Notifications")
local Tutorial = require("./Controllers/Tutorial")
local DevPanel = require("./Controllers/DevPanel")

-- the game has no tools, so hide the empty backpack bar
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local function start(name: string, init: () -> ())
	local ok, err = pcall(init :: any)
	if not ok then
		warn("[Client] " .. name .. " failed to start: " .. tostring(err))
	end
end

-- State first so nothing misses the first snapshot.
start("State", State.Init)
start("Sounds", Sounds.Init)
start("Breakables", Breakables.Init)
start("Hud", Hud.Init)
start("World", World.Init)
start("Farming", Farming.Init)
start("PetRenderer", PetRenderer.Init)
start("Shop", Shop.Init)
start("Hatch", Hatch.Init)
start("Inventory", Inventory.Init)
start("Craft", Craft.Init)
start("Expeditions", Expeditions.Init)
start("Quests", Quests.Init)
start("IndexMenu", IndexMenu.Init)
start("Rebirth", Rebirth.Init)
start("Settings", Settings.Init)
start("Trade", Trade.Init)
start("Notifications", Notifications.Init)
start("Tutorial", Tutorial.Init)
start("DevPanel", DevPanel.Init)

Remote.Fire("ClientReady")

-- If the first snapshot is lost (e.g. the server was still loading the
-- profile), ask again a few times.
task.spawn(function()
	for _ = 1, 5 do
		task.wait(5)
		if State.Data then
			return
		end
		Remote.Fire("ClientReady")
	end
end)
]]></string>
