      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--!strict
-- Robux catalogue. Id = 0 means "not created yet": the buy button shows
-- "Coming soon" in live servers. In Studio, purchases of unconfigured items
-- are simulated so every flow can be tested (PurchaseService). Create each
-- item in Creator Hub and paste its id here (docs/SETUP.md).
--
-- Price is the suggested Robux price (documentation; the real price is read
-- live with MarketplaceService so regional pricing is respected).

export type Pass = { Key: string, Id: number, Price: number, Name: string, Blurb: string }
export type Product = {
	Key: string,
	Id: number,
	Price: number,
	Name: string,
	Kind: string, -- "Gems" | "Boost" | "ServerLuck"
	Amount: number?, -- gems
	Boost: string?, -- Config.Boosts key
}

local Products = {}

Products.Passes = {
	{ Key = "VIP", Id = 0, Price = 199, Name = "VIP", Blurb = "+20% coins, VIP chat tag and a golden name." },
	{ Key = "Lucky", Id = 0, Price = 349, Name = "Lucky", Blurb = "1.5x chance for rarer pets from every egg." },
	{ Key = "TripleHatch", Id = 0, Price = 299, Name = "Triple Hatch", Blurb = "Open 3 eggs at once." },
	{ Key = "FastHatch", Id = 0, Price = 99, Name = "Fast Hatch", Blurb = "Much faster egg opening animation." },
	{ Key = "MoreEquip", Id = 0, Price = 249, Name = "+3 Pets Equipped", Blurb = "Take 3 more pets with you." },
	{ Key = "MoreExpeditions", Id = 0, Price = 199, Name = "+2 Expedition Slots", Blurb = "Run 2 more expeditions at the same time." },
	{ Key = "AutoFarm", Id = 0, Price = 249, Name = "Auto Farm", Blurb = "Your pets attack the nearest coins on their own." },
	{ Key = "BigBackpack", Id = 0, Price = 99, Name = "Big Backpack", Blurb = "+150 pet storage." },
	{ Key = "RingChampion", Id = 0, Price = 299, Name = "Ring Champion", Blurb = "+1 pet fights for you in the Pet Ring." },
} :: { Pass }

Products.Products = {
	{ Key = "Gems250", Id = 0, Price = 49, Name = "250 Gems", Kind = "Gems", Amount = 250 },
	{ Key = "Gems550", Id = 0, Price = 99, Name = "550 Gems", Kind = "Gems", Amount = 550 },
	{ Key = "Gems1500", Id = 0, Price = 249, Name = "1,500 Gems", Kind = "Gems", Amount = 1500 },
	{ Key = "Gems3300", Id = 0, Price = 499, Name = "3,300 Gems", Kind = "Gems", Amount = 3300 },
	{ Key = "Gems7000", Id = 0, Price = 999, Name = "7,000 Gems", Kind = "Gems", Amount = 7000 },
	{ Key = "Gems19000", Id = 0, Price = 2499, Name = "19,000 Gems", Kind = "Gems", Amount = 19000 },
	{ Key = "BoostCoins", Id = 0, Price = 49, Name = "2x Coins (30 min)", Kind = "Boost", Boost = "Coins2x" },
	{ Key = "BoostXp", Id = 0, Price = 49, Name = "2x Pet XP (30 min)", Kind = "Boost", Boost = "Xp2x" },
	{ Key = "BoostLuck", Id = 0, Price = 79, Name = "2x Luck (30 min)", Kind = "Boost", Boost = "Luck2x" },
	{ Key = "ServerLuck", Id = 0, Price = 199, Name = "Server Luck (15 min)", Kind = "ServerLuck" },
} :: { Product }

Products.PassByKey = {} :: { [string]: Pass }
Products.PassById = {} :: { [number]: Pass }
for _, p in Products.Passes do
	Products.PassByKey[p.Key] = p
	if p.Id ~= 0 then
		Products.PassById[p.Id] = p
	end
end

Products.ByKey = {} :: { [string]: Product }
Products.ById = {} :: { [number]: Product }
for _, p in Products.Products do
	Products.ByKey[p.Key] = p
	if p.Id ~= 0 then
		assert(Products.ById[p.Id] == nil, "duplicate product id " .. p.Id)
		Products.ById[p.Id] = p
	end
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared data shapes (see docs/CONTRACTS.md for the full contract).

export type PetInstance = {
	Uid: string, -- unique per pet, never reused
	Id: string, -- Pets id
	Variant: string, -- "Normal" | "Golden" | "Rainbow"
	Shiny: boolean,
	Level: number,
	Xp: number,
	Locked: boolean, -- locked pets can't be deleted, crafted or traded
}

export type Expedition = {
	Area: string,
	Duration: string, -- Config.ExpeditionDurations[i].Key
	Pets: { string }, -- uids (busy until claimed)
	StartAt: number, -- os.time()
	EndAt: number,
	Seed: number, -- reward roll seed fixed at start (no re-roll by re-claiming)
}

export type Reward = {
	Coins: number?,
	Gems: number?,
	Pets: { PetInstance }?,
	Boost: string?,
	Equip: number?,
	Storage: number?,
}

export type Quest = {
	Kind: string,
	Goal: number,
	Progress: number,
	Gems: number,
	Claimed: boolean,
}

-- What the client receives (Net "State"). Server-only fields are stripped.
export type PlayerState = {
	Coins: number,
	Gems: number,
	Rebirths: number,
	CoinMult: number, -- current total coin multiplier (for UI)
	LuckMult: number, -- current luck multiplier (for UI)
	Areas: { [string]: boolean }, -- opened areas
	Pets: { PetInstance },
	Equipped: { string }, -- uids
	MaxEquip: number,
	MaxStorage: number,
	Expeditions: { [string]: Expedition }, -- key = tostring(slot), slots 1..ExpeditionSlots
	ExpeditionSlots: number,
	Passes: { [string]: boolean },
	Boosts: { [string]: number }, -- key -> expires at (os.time)
	ServerLuckUntil: number, -- os.time, 0 if none
	Index: { [string]: boolean }, -- species discovered
	IndexClaimed: { [string]: boolean }, -- tostring(tier)
	Daily: { Streak: number, LastDay: number, CanClaim: boolean },
	Quests: { Quest },
	Playtime: { SessionMinutes: number, Claimed: { [string]: boolean } }, -- tostring(index)
	Stats: { Hatched: number, Broken: number, Expeditions: number, CoinsEarned: number, Crafted: number, Trophies: number, RingKOs: number, BestStreak: number },
	Settings: { [string]: any },
	RebirthCost: number,
	CanBuyGemEggs: boolean, -- false when PolicyService restricts paid random items
	CanTrade: boolean,
	ServerTime: number, -- os.time when sent (client clock offset)
}

export type TradeSide = { UserId: number, Name: string, Pets: { PetInstance }, Gems: number, Ready: boolean }
export type TradeView = {
	Id: string,
	Me: TradeSide,
	Them: TradeSide,
	Countdown: number?, -- seconds left once both ready, nil otherwise
	Status: string, -- "Open" | "Confirming" | "Done" | "Cancelled"
}

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="27">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="28">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Server entry point. Creates the remotes, then loads every service in order:
-- each gets the shared `ctx` table (ctx.<ServiceName>) in Init, and Start
-- (if any) runs in its own thread once every service is initialised.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

Net.Init()

local Services = script.Parent:WaitForChild("Services")

local ORDER = {
	"Util",
	"WorldService", -- first: DataService.Init yields on a DataStore probe and the map must exist before characters spawn
	"DataService",
	"StateService",
	"BoostService",
	"PetService",
	"HatchService",
	"BreakableService",
	"ExpeditionService",
	"RewardService",
	"RebirthService",
	"PurchaseService",
	"TradeService",
	"DevService", -- Studio-only test shortcuts; refuses everything on live servers
}

local ctx: any = {
	IsStudio = RunService:IsStudio(),
}

for _, name in ORDER do
	ctx[name] = require(Services:WaitForChild(name))
end

for _, name in ORDER do
	local service = ctx[name]
	if type(service.Init) == "function" then
		local ok, err = pcall(service.Init, ctx)
		if not ok then
			warn(string.format("[Main] %s.Init failed: %s", name, tostring(err)))
		end
	end
end

for _, name in ORDER do
	local service = ctx[name]
	if type(service.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(service.Start)
			if not ok then
				warn(string.format("[Main] %s.Start failed: %s", name, tostring(err)))
			end
		end)
	end
end

print("[PetExpedition] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">BoostService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Personal boosts (2x Coins, 2x Luck) stored in the profile, and the
-- server-wide luck boost (this server only), broadcast to everyone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))

local BoostService = {}

local ctx: any
local serverLuckUntil = 0
local serverLuckAnnounced = false

function BoostService.Init(c)
	ctx = c
end

function BoostService.Start()
	-- Refresh everyone once when server luck runs out, so multipliers update.
	while true do
		task.wait(5)
		if serverLuckAnnounced and os.time() >= serverLuckUntil then
			serverLuckAnnounced = false
			ctx.StateService.DirtyAll()
		end
	end
end

function BoostService.ServerLuckUntil(): number
	return serverLuckUntil
end

-- Starts or extends a personal boost. Returns the new expiry (0 if unknown).
function BoostService.Apply(player: Player, s, key: string): number
	if not Config.Boosts[key] then
		return 0
	end
	local expires = Economy.ApplyBoost(s.Profile, key, os.time())
	ctx.StateService.Dirty(player)
	return expires
end

-- Starts or extends server luck and tells everyone who bought it.
function BoostService.ServerLuck(byName: string)
	serverLuckUntil = Economy.ExtendServerLuck(serverLuckUntil, os.time())
	serverLuckAnnounced = true
	ctx.Util.NotifyAll("ServerLuck", { By = byName, Until = serverLuckUntil })
	for _, p in Players:GetPlayers() do
		ctx.StateService.Dirty(p)
	end
end

return BoostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BreakableService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Breakables: coin piles, crates, chests, gem rocks and big chests spawned in
-- each island's zones (up to Area.MaxBreakables). Players aim their equipped
-- pets at one with SetTarget; every Config.PetDamageInterval each player's
-- pets deal (total power * Config.PetDamagePerPower) damage. When a breakable
-- breaks, coins and gems are split by damage dealt, pets earn XP, and the
-- model respawns somewhere in the island after Config.BreakableRespawn.
-- Auto Farm (pass + setting) picks the nearest breakable on an opened island.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Areas = require(Shared:WaitForChild("Areas"))
local Models = require(Shared:WaitForChild("Models"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))
local Inventory = require(Logic:WaitForChild("Inventory"))
local Rewards = require(Logic:WaitForChild("Rewards"))
local Schema = require(Logic:WaitForChild("Schema"))

local BreakableService = {}

local ctx: any
local folder: Folder
local random = Random.new()
local nextId = 0
local breakables: { [string]: any } = {}
local countByArea: { [string]: number } = {}
local targets: { [Player]: string } = {}

-- Footprint radius per kind (studs, from the model's width). Two breakables
-- spawn at least radiusA + radiusB + GAP apart so they never overlap.
local RADIUS: { [string]: number } = {
	CoinPile = 2,
	Crate = 2.5,
	Chest = 3,
	GemRock = 2.5,
	BigChest = 4.5,
}
local DEFAULT_RADIUS = 3
local GAP = 1
local PICK_TRIES = 10 -- retry cap per spawn

local function radiusOf(kind: string): number
	return RADIUS[kind] or DEFAULT_RADIUS
end
local EDGE = 4 -- keep this far inside a zone's edge
local BROKEN_RADIUS = 250 -- players this close see the break effect
local LEASH = 25 -- extra studs past MaxTargetDistance before pets are recalled

function BreakableService.Init(c)
	ctx = c
	local existing = workspace:FindFirstChild("Breakables")
	if existing then
		existing:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "Breakables"
	folder.Parent = workspace

	ctx.Util.OnPlayerRemoving(function(p)
		targets[p] = nil
		for _, b in breakables do
			b.Damage[p] = nil
		end
	end)

	ctx.Util.Event("SetTarget", function(player, s, id)
		if id == nil or id == "" then
			BreakableService.ClearTarget(player)
			return
		end
		if not ctx.Util.IsStr(id, 32) then
			return
		end
		local b = breakables[id]
		if not b then
			return
		end
		if not s.Profile.Areas[b.Area] then
			ctx.Util.Toast(player, "Open this island first", "bad")
			return
		end
		if ctx.Util.DistTo(player, b.Position) > Config.MaxTargetDistance then
			return
		end
		BreakableService.SetTarget(player, id)
	end)
end

function BreakableService.Start()
	for _, area in Areas.List do
		countByArea[area.Id] = 0
		for _ = 1, area.MaxBreakables do
			BreakableService._spawn(area.Id)
		end
	end
	while true do
		task.wait(Config.PetDamageInterval)
		local ok, err = pcall(BreakableService._tick)
		if not ok then
			warn("[BreakableService] tick failed:", err)
		end
	end
end

function BreakableService.SetTarget(player: Player, id: string)
	targets[player] = id
	player:SetAttribute("Target", id)
end

function BreakableService.ClearTarget(player: Player)
	if targets[player] ~= nil then
		targets[player] = nil
	end
	if player.Parent ~= nil and player:GetAttribute("Target") ~= "" then
		player:SetAttribute("Target", "")
	end
end

function BreakableService.Get(id: string): any
	return breakables[id]
end

-- Spawning ----------------------------------------------------------------------

local function pickKind(area: Areas.Area): Areas.Breakable
	local total = 0
	for _, k in area.Breakables do
		total += k.Weight
	end
	local roll = random:NextNumber() * total
	for _, k in area.Breakables do
		roll -= k.Weight
		if roll < 0 then
			return k
		end
	end
	return area.Breakables[1]
end

local function pickPosition(areaId: string, kind: string): Vector3?
	local zones = ctx.WorldService.Info.Zones[areaId]
	if not zones or #zones == 0 then
		return nil
	end
	local totalArea = 0
	for _, z in zones do
		totalArea += math.max(1, z.Size.X * z.Size.Z)
	end
	local radius = radiusOf(kind)
	for _ = 1, PICK_TRIES do
		local roll = random:NextNumber() * totalArea
		local zone = zones[1]
		for _, z in zones do
			roll -= math.max(1, z.Size.X * z.Size.Z)
			if roll < 0 then
				zone = z
				break
			end
		end
		local inset = math.max(EDGE, radius + GAP)
		local hx = math.max(0, zone.Size.X / 2 - inset)
		local hz = math.max(0, zone.Size.Z / 2 - inset)
		local pos = zone.Center + Vector3.new(random:NextNumber(-hx, hx), 0, random:NextNumber(-hz, hz))
		local clear = true
		for _, b in breakables do
			if b.Area == areaId and (b.Position - pos).Magnitude < radius + radiusOf(b.Kind) + GAP then
				clear = false
				break
			end
		end
		if clear then
			return pos
		end
	end
	return nil
end

function BreakableService._spawn(areaId: string)
	local area = Areas.ById[areaId]
	if not area or (countByArea[areaId] or 0) >= area.MaxBreakables then
		return
	end
	local kind = pickKind(area)
	local pos = pickPosition(areaId, kind.Kind)
	if not pos then
		-- Zone crowded right now: try again later (only if the island has zones).
		local zones = ctx.WorldService.Info.Zones[areaId]
		if zones and #zones > 0 then
			task.delay(random:NextNumber(5, 10), BreakableService._spawn, areaId)
		end
		return
	end
	local ok, model = pcall(Models.Breakable, kind.Kind, areaId)
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		warn("[BreakableService] Models.Breakable failed:", model)
		return
	end
	nextId += 1
	local id = "B" .. nextId
	local hp = math.max(1, math.floor(kind.Hp * area.CoinMult))
	model.Name = kind.Kind
	model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, random:NextNumber(0, math.pi * 2), 0))
	model:SetAttribute("Id", id)
	model:SetAttribute("Kind", kind.Kind)
	model:SetAttribute("Area", areaId)
	model:SetAttribute("Hp", hp)
	model:SetAttribute("MaxHp", hp)
	CollectionService:AddTag(model, "Breakable")
	model.Parent = folder
	breakables[id] = {
		Id = id,
		Kind = kind.Kind,
		Area = areaId,
		Model = model,
		Position = pos,
		Hp = hp,
		MaxHp = hp,
		Coins = kind.Coins * area.CoinMult,
		Gems = kind.Gems or 0,
		Damage = {},
	}
	countByArea[areaId] = (countByArea[areaId] or 0) + 1
end

-- Damage ------------------------------------------------------------------------

local function nearest(player: Player, s): string?
	local pos = ctx.Util.Position(player)
	if not pos then
		return nil
	end
	local best, bestDist = nil, Config.MaxTargetDistance
	for id, b in breakables do
		if s.Profile.Areas[b.Area] then
			local d = (b.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = id, d
			end
		end
	end
	return best
end

function BreakableService._tick()
	local hit: { [string]: boolean } = {}
	for _, player in Players:GetPlayers() do
		local s = ctx.DataService.Get(player)
		if not s then
			continue
		end
		local id = targets[player]
		local b = id and breakables[id]
		if id and (not b or not s.Profile.Areas[b.Area]
			or ctx.Util.DistTo(player, b.Position) > Config.MaxTargetDistance + LEASH) then
			BreakableService.ClearTarget(player)
			b = nil
		end
		if not b and s.Profile.Passes.AutoFarm and s.Profile.Settings.AutoFarm == true then
			local auto = nearest(player, s)
			if auto then
				BreakableService.SetTarget(player, auto)
				b = breakables[auto]
			end
		end
		if not b or b.Hp <= 0 then
			continue
		end
		local damage = Inventory.EquippedPower(s.Profile) * Config.PetDamagePerPower
		if not Schema.IsFinite(damage) or damage <= 0 then
			continue
		end
		local applied = math.min(damage, b.Hp)
		b.Hp -= applied
		b.Damage[player] = (b.Damage[player] or 0) + applied
		hit[b.Id] = true
	end
	for id in hit do
		local b = breakables[id]
		if b then
			if b.Hp <= 0 then
				BreakableService._break(b)
			else
				b.Model:SetAttribute("Hp", math.ceil(b.Hp))
			end
		end
	end
end

function BreakableService._break(b)
	breakables[b.Id] = nil
	countByArea[b.Area] = math.max(0, (countByArea[b.Area] or 1) - 1)
	-- Split by damage among contributors still here (Logic/Economy.SplitBreak:
	-- exact gem total, credit only for >= 5% of the damage).
	local who: { Player } = {}
	local damage: { number } = {}
	for player, dmg in b.Damage do
		if player.Parent ~= nil and ctx.DataService.Get(player) then
			table.insert(who, player)
			table.insert(damage, dmg)
		end
	end
	local shares = Economy.SplitBreak(damage, b.Coins, b.Gems)
	local now = os.time()
	for i, player in who do
		local s = ctx.DataService.Get(player)
		local share = shares[i]
		local p = s.Profile
		local coins = Economy.AddCoins(p, share.Coins * ctx.StateService.CoinMult(s), true)
		-- Breakable gems are capped per player per rolling hour (Auto Farm
		-- must not turn into a gem printer).
		local gemsAllowed = Economy.CapRolling(s.BreakGemLog, os.clock(), share.Gems, Config.BreakGemsPerHour, 3600)
		local gems = Economy.AddGems(p, gemsAllowed)
		if share.Credit then
			p.Stats.Broken = math.min(Schema.MaxStat, p.Stats.Broken + 1)
			Rewards.AddQuestProgress(p, "Break", 1, now)
			ctx.PetService.GiveXp(player, s, Config.XpPerBreak)
		end
		Rewards.AddQuestProgress(p, "Coins", coins, now)
		if coins > 0 or gems > 0 then
			ctx.Util.Notify(player, "Reward", {
				Coins = if coins > 0 then coins else nil,
				Gems = if gems > 0 then gems else nil,
				Position = b.Position,
			})
		end
		ctx.StateService.Dirty(player)
	end
	local info = { Id = b.Id, Kind = b.Kind, Position = b.Position }
	for _, player in Players:GetPlayers() do
		if b.Damage[player] or ctx.Util.DistTo(player, b.Position) <= BROKEN_RADIUS then
			ctx.Util.Notify(player, "Broken", info)
		end
		if targets[player] == b.Id then
			BreakableService.ClearTarget(player)
		end
	end
	b.Model:Destroy()
	local lo, hi = Config.BreakableRespawn[1], Config.BreakableRespawn[2]
	task.delay(random:NextNumber(lo, hi), BreakableService._spawn, b.Area)
end

return BreakableService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player profiles in a DataStore with session locking.
--
-- Stored record under key "p_<UserId>": { Profile = <Logic/Schema.Profile>, Lock = { JobId, Time } | nil }
-- Trade journals under key "t_<TradeId>" (see Logic/Trade and TradeService).
--
-- Safety rules:
--   * Only the server holding a record's lock writes it (UpdateAsync checks).
--     A lock older than Config.SessionLockSeconds is treated as dead.
--   * If loading fails, or a live server has no DataStore at all, the session
--     is "Failed": the player can play but nothing is saved, purchases answer
--     NotProcessedYet and trading is off. "Memory" sessions exist only in Studio.
--   * Every change that must persist bumps the session's ChangeSeq (Touch).
--     A save records the ChangeSeq it captured; Save / SaveNow report success
--     only when a completed write captured the caller's ChangeSeq or later.
--   * Writes are serialised per player. Once a player is leaving, only the
--     final release save writes, so the lock can never be re-taken after it.
--   * A profile that loads with PendingTrade set replays its side of that
--     trade from the journal before anything else happens.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = Shared:WaitForChild("Logic")
local Profile = require(Logic:WaitForChild("Profile"))
local Trade = require(Logic:WaitForChild("Trade"))

local DataService = {}

local ctx: any
local store: DataStore? = nil
local persistence = false
local sessions: { [Player]: any } = {}
local loadedHooks: { (Player, any) -> () } = {}
local memoryJournals: { [string]: any } = {} -- Studio memory mode only
local closing = false

local LOAD_RETRIES = 5
local RELEASE_RETRIES = 4
local JOURNAL_RETRIES = 5

local function key(userId: number): string
	return "p_" .. userId
end

local function journalKey(tradeId: string): string
	return "t_" .. tradeId
end

-- Studio uses its own DataStore so test saves (dev panel, test purchases,
-- "reset my data") can never touch real players' live data.
function DataService.StoreName(): string
	if ctx and ctx.IsStudio then
		return Config.DataStoreName .. "_Studio"
	end
	return Config.DataStoreName
end

function DataService.Init(c)
	ctx = c
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DataService.StoreName())
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable:", result)
	end
	persistence = store ~= nil
	if persistence and ctx.IsStudio then
		-- Studio without "Enable Studio Access to API Services" throws here.
		local okProbe = pcall(function()
			(store :: DataStore):GetAsync("__probe")
		end)
		if not okProbe then
			persistence = false
			warn("[DataService] Studio has no DataStore access: profiles are kept in memory only")
		end
	end
	if not persistence and not ctx.IsStudio then
		warn("[DataService] no DataStore on a live server: every session will be read-only (Failed)")
	end
	ctx.Util.OnPlayerAdded(DataService._onJoin)
	ctx.Util.OnPlayerRemoving(DataService._onLeave)
	game:BindToClose(DataService._onClose)
end

function DataService.Start()
	while true do
		task.wait(Config.AutosaveSeconds)
		for _, s in sessions do
			if s.State == "Loaded" and not s.Released and not s.Leaving then
				task.spawn(DataService._save, s, false)
			end
		end
	end
end

-- Runs after a player's profile is ready (in registration order).
function DataService.OnLoaded(fn: (Player, any) -> ())
	table.insert(loadedHooks, fn)
end

-- The session once the profile is usable (loaded, memory or failed), else nil.
function DataService.Get(player: Player): any
	local s = sessions[player]
	if s and s.Ready and not s.Released and not s.Leaving then
		return s
	end
	return nil
end

-- Waits until the profile is usable (or the player left / timeout).
function DataService.WaitFor(player: Player, timeout: number?): any
	local deadline = os.clock() + (timeout or 30)
	while player.Parent ~= nil and os.clock() < deadline do
		local s = DataService.Get(player)
		if s then
			return s
		end
		task.wait(0.25)
	end
	return DataService.Get(player)
end

function DataService.All(): { [Player]: any }
	return sessions
end

-- Marks the profile as changed (call for anything that must persist).
function DataService.Touch(s)
	if s then
		s.ChangeSeq += 1
	end
end

-- True when this session can't keep changes (trading / purchases refuse).
function DataService.ReadOnly(s): boolean
	return s == nil or s.State == "Failed" or s.LockLost == true
end

-- Trade journals ------------------------------------------------------------------

-- Writes a journal once. Returns "written" when the stored record is this
-- journal, "unknown" when every attempt failed (it may or may not exist).
function DataService.WriteJournal(tradeId: string, journal: any): string
	if not persistence then
		if ctx.IsStudio then
			memoryJournals[tradeId] = journal
			return "written"
		end
		return "unknown"
	end
	for attempt = 1, JOURNAL_RETRIES do
		local stored = nil
		local ok, err = pcall(function()
			stored = (store :: DataStore):UpdateAsync(journalKey(tradeId), function(old)
				if type(old) == "table" then
					return nil -- keep whatever is already there
				end
				return journal
			end)
		end)
		if ok then
			if type(stored) == "table" and stored.Id == tradeId then
				return "written"
			end
			-- UpdateAsync returns nil when the transform kept the old value: read it.
			local okGet, existing = pcall(function()
				return (store :: DataStore):GetAsync(journalKey(tradeId))
			end)
			if okGet and type(existing) == "table" and existing.Id == tradeId then
				return "written"
			end
		else
			warn("[DataService] journal write failed (attempt " .. attempt .. "):", err)
		end
		task.wait(attempt)
	end
	return "unknown"
end

-- Returns ok, journal-or-nil. ok = false means the read itself failed.
function DataService.ReadJournal(tradeId: string): (boolean, any)
	if not persistence then
		return ctx.IsStudio, memoryJournals[tradeId]
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync(journalKey(tradeId))
		end)
		if ok then
			return true, result
		end
		task.wait(attempt)
	end
	return false, nil
end

function DataService.RemoveJournal(tradeId: string)
	if not persistence then
		memoryJournals[tradeId] = nil
		return
	end
	pcall(function()
		(store :: DataStore):RemoveAsync(journalKey(tradeId))
	end)
end

-- Replays (or clears) a pending trade on a freshly loaded profile.
-- Returns false if the journal couldn't be read (session must not save).
local function resolvePendingTrade(userId: number, s): boolean
	local id = s.Profile.PendingTrade
	if not id then
		return true
	end
	local ok, journal = DataService.ReadJournal(id)
	if not ok then
		return false
	end
	if type(journal) == "table" and type(journal.Sides) == "table" then
		local side = Trade.SanitizeSide(journal.Sides[tostring(userId)])
		if side then
			Trade.ApplySide(s.Profile, side, id)
		end
	end
	-- No journal: the trade never got past its first step, nothing changed.
	s.Profile.PendingTrade = nil
	DataService.Touch(s)
	return true
end

-- Loading -------------------------------------------------------------------------

local function tryLoad(userId: number): (string, any)
	-- Returns "ok", rawProfile | "locked", nil | "error", message.
	local now = os.time()
	local lockedBy: string? = nil
	local captured: any = nil
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key(userId), function(old)
			-- The transform may run more than once; the last run is what commits.
			lockedBy = nil
			captured = nil
			local rec = if type(old) == "table" then old else {}
			local lock = rec.Lock
			if type(lock) == "table" and lock.JobId ~= game.JobId and type(lock.Time) == "number"
				and now - lock.Time < Config.SessionLockSeconds then
				lockedBy = tostring(lock.JobId)
				return nil -- abort: another live server owns this profile
			end
			rec.Lock = { JobId = game.JobId, Time = now }
			captured = rec.Profile
			return rec
		end)
	end)
	if not ok then
		return "error", err
	end
	if lockedBy then
		return "locked", nil
	end
	return "ok", captured
end

function DataService._onJoin(player: Player)
	local s = {
		Player = player,
		UserId = player.UserId,
		Profile = Profile.Default(),
		State = "Loading",
		Persist = persistence,
		Ready = false,
		Released = false,
		Leaving = false,
		Closed = false,
		Saving = false,
		LockLost = false,
		ChangeSeq = 0,
		SavedSeq = -1,
		JoinClock = os.clock(),
		LastPlayClock = nil,
		BreakGemLog = {}, -- recent breakable gem grants (Config.BreakGemsPerHour)
		Premium = false,
		InGroup = false,
		-- Off until PolicyService answers (StateService), so nothing restricted
		-- slips through in the first seconds.
		CanBuyGemEggs = false,
		CanTrade = false,
		LastHatch = 0,
		TradeBusy = false,
	}
	sessions[player] = s

	if not s.Persist then
		if ctx.IsStudio then
			s.State = "Memory"
		else
			s.State = "Failed"
		end
	else
		local result, data
		for attempt = 1, LOAD_RETRIES do
			result, data = tryLoad(player.UserId)
			if result == "ok" or s.Leaving or player.Parent == nil then
				break
			end
			if result == "error" then
				warn(string.format("[DataService] load error for %d (attempt %d): %s", player.UserId, attempt, tostring(data)))
			end
			-- The previous server releases the lock when the player leaves it.
			task.wait(math.min(2 + attempt * 2, 10))
		end
		if result == "ok" then
			s.Profile = Profile.Sanitize(data)
			s.State = "Loaded"
			if not resolvePendingTrade(player.UserId, s) then
				-- Can't tell whether a trade went through: play without saving
				-- and keep the lock short-lived (it expires on its own).
				s.State = "Failed"
				s.Persist = false
				warn("[DataService] couldn't read a pending trade journal for", player.UserId)
			end
		else
			s.State = "Failed"
			s.Persist = false
			warn("[DataService] profile load failed; playing without saving for", player.UserId)
		end
	end

	if s.Leaving or player.Parent == nil then
		-- Left while loading: release the lock we may hold, using this session
		-- object (the session map entry is already gone).
		if s.State == "Loaded" then
			DataService._release(s)
		end
		s.Closed = true
		if sessions[player] == s then
			sessions[player] = nil
		end
		return
	end
	s.JoinClock = os.clock()
	s.Ready = true
	if s.ChangeSeq > 0 then
		task.spawn(DataService._save, s, false)
	end
	for _, fn in loadedHooks do
		local ok, err = pcall(fn, player, s)
		if not ok then
			warn("[DataService] loaded hook error:", err)
		end
	end
	if s.State == "Failed" then
		ctx.Util.Toast(player, "Your saved data couldn't be loaded. Progress won't be saved this time - please rejoin later.", "bad")
	end
end

-- Saving --------------------------------------------------------------------------

-- One write. Returns true when a completed write captured ChangeSeq >= the
-- value it had when this call started. `release` drops the lock.
function DataService._save(s, release: boolean?): boolean
	if not s then
		return false
	end
	if s.State == "Memory" then
		return true
	end
	if not s.Persist or s.State ~= "Loaded" then
		return false
	end
	local target = s.ChangeSeq
	-- One write at a time; a later call waits for the earlier one.
	while s.Saving do
		task.wait(0.1)
	end
	if s.SavedSeq >= target and not release then
		return true -- someone else's write already covered our change
	end
	if s.LockLost or s.Released then
		return s.SavedSeq >= target
	end
	if s.Leaving and not release then
		-- Only the release save may write now; report what it achieves.
		while not s.Closed and not s.Released and not s.LockLost do
			task.wait(0.1)
		end
		return s.SavedSeq >= target
	end
	s.Saving = true
	local captured = s.ChangeSeq
	local data = s.Profile
	local lost = false
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key(s.UserId), function(old)
			lost = false
			local rec = if type(old) == "table" then old else {}
			local lock = rec.Lock
			if type(lock) == "table" and lock.JobId ~= game.JobId and type(lock.Time) == "number"
				and os.time() - lock.Time < Config.SessionLockSeconds then
				lost = true
				return nil
			end
			rec.Profile = data
			rec.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
			return rec
		end)
	end)
	s.Saving = false
	if not ok then
		warn("[DataService] save failed for", s.UserId, err)
		return false
	end
	if lost then
		s.LockLost = true
		warn("[DataService] session lock taken by another server; stopped saving for", s.UserId)
		return false
	end
	s.SavedSeq = math.max(s.SavedSeq, captured)
	if release then
		s.Released = true
	end
	return s.SavedSeq >= target
end

-- Final save that releases the lock, retried a few times.
function DataService._release(s)
	for attempt = 1, RELEASE_RETRIES do
		if DataService._save(s, true) or s.LockLost then
			return
		end
		task.wait(attempt)
	end
	warn("[DataService] could not release profile for", s.UserId, "- the lock will expire on its own")
end

function DataService.Save(player: Player, release: boolean?): boolean
	return DataService._save(sessions[player], release)
end

-- Saves right away (purchases, trades), retrying. True only if the player's
-- changes up to now are stored.
function DataService.SaveNow(player: Player): boolean
	return DataService.SaveSession(sessions[player])
end

function DataService.SaveSession(s): boolean
	if not s then
		return false
	end
	for attempt = 1, 3 do
		if DataService._save(s, false) then
			return true
		end
		if s.LockLost or not s.Persist or s.Released or s.Closed then
			return false
		end
		task.wait(attempt)
	end
	return false
end

function DataService._onLeave(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	s.Leaving = true
	sessions[player] = nil
	if s.State == "Loading" then
		return -- the join thread releases once loading finishes
	end
	if s.State == "Loaded" and not s.Released then
		DataService._release(s)
	end
	s.Closed = true
end

function DataService._onClose()
	if closing then
		return
	end
	closing = true
	local pending = 0
	for _, s in sessions do
		if s.State == "Loaded" and not s.Released then
			pending += 1
			s.Leaving = true
			task.spawn(function()
				DataService._release(s)
				s.Closed = true
				pending -= 1
			end)
		end
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.2)
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Studio-only test shortcuts for the client's DEV panel (remote "DevAction").
-- Every call is refused outside Studio, and Studio saves go to a separate
-- DataStore (DataService.StoreName), so none of this can touch live data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared:WaitForChild("Areas"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))
local Profile = require(Logic:WaitForChild("Profile"))
local Rewards = require(Logic:WaitForChild("Rewards"))

local DevService = {}

local ctx: any

-- action -> handler(player, session) -> (ok, message?)
local ACTIONS: { [string]: (Player, any) -> (boolean, string?) } = {
	Coins1M = function(_player, s)
		Economy.AddCoins(s.Profile, 1e6, false)
		return true, "+1M coins"
	end,
	CoinsX1000 = function(_player, s)
		local p = s.Profile
		Economy.AddCoins(p, math.max(1000, p.Coins * 999), false)
		return true, "Coins x1000"
	end,
	Gems1000 = function(_player, s)
		Economy.AddGems(s.Profile, 1000)
		return true, "+1000 gems"
	end,
	FinishExpeditions = function(_player, s)
		local now = os.time()
		local n = 0
		for _, e in s.Profile.Expeditions do
			if e.EndAt > now then
				e.EndAt = now
				e.StartAt = math.min(e.StartAt, now - 1)
				n += 1
			end
		end
		return true, n .. " expedition(s) finished"
	end,
	OpenGates = function(_player, s)
		for _, a in Areas.List do
			s.Profile.Areas[a.Id] = true
		end
		return true, "All gates open"
	end,
	ResetData = function(player, s)
		if ctx.TradeService.InTrade(player) then
			return false, "Cancel your trade first"
		end
		ctx.BreakableService.ClearTarget(player)
		s.Profile = Profile.Default()
		Rewards.EnsureQuests(s.Profile, Rewards.DayNumber(os.time()))
		return true, "Data reset"
	end,
}

function DevService.Init(c)
	ctx = c
	ctx.Util.Function("DevAction", function(player, s, action)
		if not RunService:IsStudio() then
			return ctx.Util.Fail("Only available in Studio")
		end
		if not ctx.Util.IsStr(action, 32) or not ACTIONS[action] then
			return ctx.Util.Fail("Unknown dev action")
		end
		local ok, message = ACTIONS[action](player, s)
		if not ok then
			return ctx.Util.Fail(message or "Not possible right now")
		end
		ctx.DataService.Touch(s)
		ctx.StateService.Dirty(player)
		return { ok = true, message = message }
	end)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Expedition remotes. Timers use os.time(), so expeditions finish while the
-- player is offline; the reward seed is fixed at start (Logic/Expedition).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Areas = require(Shared:WaitForChild("Areas"))
local Logic = Shared:WaitForChild("Logic")
local Expedition = require(Logic:WaitForChild("Expedition"))
local Profile = require(Logic:WaitForChild("Profile"))
local Rewards = require(Logic:WaitForChild("Rewards"))
local Schema = require(Logic:WaitForChild("Schema"))

local ExpeditionService = {}

local ctx: any
local random = Random.new()
local MAX_SLOT = Config.BaseExpeditionSlots + 2

function ExpeditionService.Init(c)
	ctx = c
	local U = ctx.Util

	U.Function("StartExpedition", function(player, s, areaId, durationKey, uids)
		if not U.IsStr(areaId, 32) or not Areas.ById[areaId] then
			return U.Fail("Unknown island")
		end
		if not U.IsStr(durationKey, 16) or not Expedition.Duration(durationKey) then
			return U.Fail("Unknown duration")
		end
		local list, err = Schema.UidList(uids, Config.MaxPetsPerExpedition)
		if not list then
			return U.Fail(err or "Bad pet list")
		end
		local seed = random:NextInteger(1, 2147483646)
		local slot, _, err2 = Expedition.Start(s.Profile, areaId, durationKey, list, os.time(), seed, ctx.TradeService.OfferedSet(player), ctx.StateService.CoinMult(s))
		if not slot then
			return U.Fail(err2 or "Can't start that expedition")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, slot = tonumber(slot) }
	end)

	U.Function("ClaimExpedition", function(player, s, slot)
		if not U.IsInt(slot, 1, MAX_SLOT) then
			return U.Fail("Unknown slot")
		end
		local p = s.Profile
		local claimed, err = Expedition.Claim(p, tostring(slot), os.time(), ctx.StateService.CoinMult(s))
		if not claimed then
			return U.Fail(err or "Can't claim that")
		end
		local now = os.time()
		Rewards.AddQuestProgress(p, "Expedition", 1, now)
		Rewards.AddQuestProgress(p, "Coins", claimed.Coins, now)
		for _, id in claimed.Discovered do
			ctx.RewardService.Discovered(player, id)
		end
		local pets = {}
		for _, pet in claimed.Pets do
			table.insert(pets, Profile.CopyPet(pet))
		end
		ctx.StateService.Dirty(player)
		return {
			ok = true,
			reward = {
				Coins = if claimed.Coins > 0 then claimed.Coins else nil,
				Gems = if claimed.Gems > 0 then claimed.Gems else nil,
				Pets = pets,
			},
		}
	end)

	U.Function("SkipExpedition", function(player, s, slot)
		if not U.IsInt(slot, 1, MAX_SLOT) then
			return U.Fail("Unknown slot")
		end
		local cost, err = Expedition.Skip(s.Profile, tostring(slot), os.time())
		if not cost then
			return U.Fail(err or "Can't skip that")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, gems = cost }
	end)
end

return ExpeditionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">HatchService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Egg hatching. The server checks the egg, the island, the player's distance
-- to the egg stand (when the map has one), cooldown, triple-hatch pass,
-- PolicyService (gem eggs), storage room and price, then rolls with the
-- player's current luck. Odds come only from shared Eggs data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Eggs = require(Shared:WaitForChild("Eggs"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))
local Hatch = require(Logic:WaitForChild("Hatch"))
local Inventory = require(Logic:WaitForChild("Inventory"))
local Profile = require(Logic:WaitForChild("Profile"))
local Rewards = require(Logic:WaitForChild("Rewards"))
local Schema = require(Logic:WaitForChild("Schema"))

local HatchService = {}

local ctx: any
local random = Random.new()

local MAX_STAND_DISTANCE = 45 -- studs from the egg stand

function HatchService.Init(c)
	ctx = c
	ctx.Util.Function("HatchEgg", HatchService._hatch)
end

function HatchService._hatch(player: Player, s, eggId: any, count: any)
	local U = ctx.Util
	if not U.IsStr(eggId, 32) then
		return U.Fail("Unknown egg")
	end
	local egg = Eggs.ById[eggId]
	if not egg then
		return U.Fail("Unknown egg")
	end
	if count == nil then
		count = 1
	end
	if count ~= 1 and count ~= 3 then
		return U.Fail("You can open 1 or 3 eggs")
	end
	local p = s.Profile
	if count == 3 and not Economy.HasPass(p, "TripleHatch") then
		return U.Fail("Triple Hatch needs the Triple Hatch pass")
	end
	local now = os.clock()
	if now - (s.LastHatch or 0) < Config.HatchCooldown then
		return U.Fail("Slow down a little")
	end
	if not p.Areas[egg.Area] then
		return U.Fail("Open that island first")
	end
	if egg.Currency == "Gems" and not s.CanBuyGemEggs then
		return U.Fail("This egg isn't available for your account")
	end
	local standPos = ctx.WorldService.TaggedPosition("EggStand", "EggId", egg.Id)
	if standPos and U.DistTo(player, standPos) > MAX_STAND_DISTANCE then
		return U.Fail("Walk up to the egg first")
	end
	if Inventory.FreeSpace(p) < count then
		return U.Fail("Your pet storage is full")
	end
	local cost = egg.Cost * count
	if not Economy.Spend(p, egg.Currency, cost) then
		return U.Fail(if egg.Currency == "Gems" then "Not enough gems" else "Not enough coins")
	end
	s.LastHatch = now

	local luck = ctx.StateService.LuckMult(s)
	local results = {}
	for _ = 1, count do
		local id = Hatch.Pick(egg, luck, random:NextNumber())
		local shiny = random:NextNumber() < Config.ShinyChance
		local pet, discovered = Inventory.Add(p, { Id = id, Shiny = shiny })
		if pet then
			table.insert(results, Profile.CopyPet(pet))
			if discovered then
				ctx.RewardService.Discovered(player, pet.Id)
			end
			-- New players' first pets go straight to work.
			if #p.Equipped < Economy.MaxEquip(p) then
				Inventory.Equip(p, pet.Uid, true)
			end
		end
	end
	p.Stats.Hatched = math.min(Schema.MaxStat, p.Stats.Hatched + #results)
	Rewards.AddQuestProgress(p, "Hatch", #results, os.time())
	ctx.StateService.Dirty(player)
	return { ok = true, pets = results }
end

return HatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pet management remotes (equip, equip best, unequip all, delete, lock,
-- craft) and pet XP / levels. Pets offered in an open trade can't be deleted,
-- crafted or sent away until the trade ends.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = Shared:WaitForChild("Logic")
local Inventory = require(Logic:WaitForChild("Inventory"))
local PetMath = require(Logic:WaitForChild("PetMath"))
local Profile = require(Logic:WaitForChild("Profile"))
local Rewards = require(Logic:WaitForChild("Rewards"))
local Schema = require(Logic:WaitForChild("Schema"))

local PetService = {}

local ctx: any
local MAX_DELETE = 500

function PetService.Init(c)
	ctx = c
	local U = ctx.Util

	U.Function("EquipPet", function(player, s, uid, equip)
		if not U.IsStr(uid, Schema.MaxUidLength) or not U.IsBool(equip) then
			return U.Fail("Bad request")
		end
		local ok, err = Inventory.Equip(s.Profile, uid, equip)
		if not ok then
			return U.Fail(err or "Can't do that")
		end
		ctx.StateService.Dirty(player)
		return { ok = true }
	end)

	U.Function("EquipBest", function(player, s)
		Inventory.EquipBest(s.Profile)
		ctx.StateService.Dirty(player)
		return { ok = true }
	end)

	U.Function("UnequipAll", function(player, s)
		Inventory.UnequipAll(s.Profile)
		ctx.BreakableService.ClearTarget(player)
		ctx.StateService.Dirty(player)
		return { ok = true }
	end)

	U.Function("DeletePets", function(player, s, uids)
		local list, err = Schema.UidList(uids, MAX_DELETE)
		if not list then
			return U.Fail(err or "Bad pet list")
		end
		if s.Profile.PendingTrade then
			return U.Fail("A trade is still being settled - rejoin to finish it")
		end
		local coins, err2 = Inventory.Delete(s.Profile, list, ctx.TradeService.OfferedSet(player))
		if not coins then
			return U.Fail(err2 or "Can't delete those pets")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, coins = coins }
	end)

	U.Function("LockPet", function(player, s, uid, locked)
		if not U.IsStr(uid, Schema.MaxUidLength) or not U.IsBool(locked) then
			return U.Fail("Bad request")
		end
		local ok, err = Inventory.Lock(s.Profile, uid, locked)
		if not ok then
			return U.Fail(err or "Can't do that")
		end
		ctx.StateService.Dirty(player)
		return { ok = true }
	end)

	U.Function("CraftPet", function(player, s, uid)
		if not U.IsStr(uid, Schema.MaxUidLength) then
			return U.Fail("Bad request")
		end
		if s.Profile.PendingTrade then
			return U.Fail("A trade is still being settled - rejoin to finish it")
		end
		local made, err = Inventory.Craft(s.Profile, uid, ctx.TradeService.OfferedSet(player))
		if not made then
			return U.Fail(err or "Can't craft that")
		end
		Rewards.AddQuestProgress(s.Profile, "Craft", 1, os.time())
		ctx.Util.Toast(player, string.format("Made a %s pet!", made.Variant), "good")
		ctx.StateService.Dirty(player)
		return { ok = true, pet = Profile.CopyPet(made) }
	end)
end

-- Gives XP to every equipped pet of a player. Sends LevelUp notifications.
function PetService.GiveXp(player: Player, s, xp: number)
	for _, pet in Inventory.EquippedPets(s.Profile) do
		local gained = PetMath.AddXp(pet, xp)
		if gained > 0 then
			ctx.Util.Notify(player, "LevelUp", { Uid = pet.Uid, Level = pet.Level })
		end
	end
end

PetService.MaxLevel = Config.PetMaxLevel

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Robux purchases.
--   * Developer products: MarketplaceService.ProcessReceipt. Each PurchaseId
--     is granted once (stored in the profile) and only reported as granted
--     after the profile is saved, so a failed save means Roblox retries
--     instead of the player losing the purchase.
--   * Game passes: checked with UserOwnsGamePassAsync on join; after
--     PromptGamePassPurchaseFinished the purchase is confirmed with
--     UserOwnsGamePassAsync (retried) before granting.
--   * DevPurchase: Studio only, for items whose Id is still 0.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))
local Profile = require(Logic:WaitForChild("Profile"))

local PurchaseService = {}

-- Luck items are paid random-item boosts. Players whose policy restricts paid
-- random items can't buy them; if a receipt still arrives (bought before the
-- policy answered, or from another device) they get gems instead so nobody
-- pays for nothing.
PurchaseService.LuckPass = "Lucky"
PurchaseService.LuckProductGems = {
	BoostLuck = 400,
	ServerLuck = 1000,
} :: { [string]: number }

function PurchaseService.IsLuckItem(key: string): boolean
	return key == PurchaseService.LuckPass or PurchaseService.LuckProductGems[key] ~= nil
end

local ctx: any
local granting: { [string]: boolean } = {} -- PurchaseIds being processed right now

function PurchaseService.Init(c)
	ctx = c
	ctx.DataService.OnLoaded(PurchaseService._onLoaded)
	MarketplaceService.ProcessReceipt = PurchaseService._processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local pass = Products.PassById[passId]
		if not pass then
			return
		end
		-- Don't trust the event alone: confirm ownership with Roblox.
		for attempt = 1, 4 do
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok then
				local s = ctx.DataService.Get(player)
				if owns and s then
					PurchaseService.GrantPass(player, s, pass.Key)
				end
				return
			end
			task.wait(attempt * 2)
		end
		warn("[PurchaseService] couldn't confirm pass", pass.Key, "for", player.UserId, "- it will be checked on next join")
	end)

	ctx.Util.Function("DevPurchase", function(player, s, key)
		if not RunService:IsStudio() then
			return ctx.Util.Fail("Only available in Studio")
		end
		if not ctx.Util.IsStr(key, 32) then
			return ctx.Util.Fail("Unknown item")
		end
		if PurchaseService.IsLuckItem(key) and ctx.StateService.PaidRandomRestricted(s) then
			return ctx.Util.Fail("Luck items aren't available for your account")
		end
		local pass = Products.PassByKey[key]
		if pass then
			if pass.Id ~= 0 then
				return ctx.Util.Fail("This pass has a real id: buy it normally")
			end
			PurchaseService.GrantPass(player, s, pass.Key)
			return { ok = true }
		end
		local product = Products.ByKey[key]
		if product then
			if product.Id ~= 0 then
				return ctx.Util.Fail("This product has a real id: buy it normally")
			end
			PurchaseService.GrantProduct(player, s, product)
			return { ok = true }
		end
		return ctx.Util.Fail("Unknown item")
	end)
end

function PurchaseService._onLoaded(player: Player, s)
	task.spawn(function()
		local changed = false
		for _, pass in Products.Passes do
			if pass.Id ~= 0 and not s.Profile.Passes[pass.Key] then
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
				end)
				if ok and owns then
					s.Profile.Passes[pass.Key] = true
					ctx.DataService.Touch(s)
					changed = true
				end
			end
		end
		if changed then
			ctx.StateService.Dirty(player)
		end
	end)
end

function PurchaseService.GrantPass(player: Player, s, key: string)
	if s.Profile.Passes[key] then
		return
	end
	s.Profile.Passes[key] = true
	ctx.DataService.Touch(s)
	local pass = Products.PassByKey[key]
	ctx.Util.Notify(player, "Purchased", { Name = if pass then pass.Name else key })
	ctx.StateService.Dirty(player)
	task.spawn(ctx.DataService.SaveNow, player)
end

-- Gives a product's contents (no dedupe here; see _processReceipt).
function PurchaseService.GrantProduct(player: Player, s, product: Products.Product)
	local swapGems = PurchaseService.LuckProductGems[product.Key]
	if swapGems and ctx.StateService.PaidRandomRestricted(s) then
		Economy.AddGems(s.Profile, swapGems)
		ctx.Util.Notify(player, "Purchased", { Name = tostring(swapGems) .. " Gems (luck items aren't available for your account)" })
		ctx.StateService.Dirty(player)
		return
	end
	if product.Kind == "Gems" then
		Economy.AddGems(s.Profile, product.Amount or 0)
	elseif product.Kind == "Boost" and product.Boost then
		ctx.BoostService.Apply(player, s, product.Boost)
	elseif product.Kind == "ServerLuck" then
		ctx.BoostService.ServerLuck(player.DisplayName)
	else
		warn("[PurchaseService] unknown product kind", product.Kind)
	end
	ctx.Util.Notify(player, "Purchased", { Name = product.Name })
	ctx.StateService.Dirty(player)
end

function PurchaseService._processReceipt(receipt)
	local NotYet = Enum.ProductPurchaseDecision.NotProcessedYet
	local Granted = Enum.ProductPurchaseDecision.PurchaseGranted
	local product = Products.ById[receipt.ProductId]
	if not product then
		warn("[PurchaseService] receipt for unknown product id", receipt.ProductId)
		return NotYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return NotYet -- granted when they next join
	end
	local s = ctx.DataService.WaitFor(player, 30)
	if not s or ctx.DataService.ReadOnly(s) then
		return NotYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	-- Luck products depend on the player's policy: don't decide (gems vs the
	-- boost) before PolicyService has answered.
	if PurchaseService.LuckProductGems[product.Key] then
		local deadline = os.clock() + 20
		while not s.PolicyKnown and os.clock() < deadline and player.Parent ~= nil do
			task.wait(0.5)
		end
		if not s.PolicyKnown then
			return NotYet
		end
	end
	-- The same receipt can arrive again while we're still saving it.
	if granting[purchaseId] then
		return NotYet
	end
	granting[purchaseId] = true
	local ok, result = pcall(function()
		if not Profile.HasReceipt(s.Profile, purchaseId) then
			PurchaseService.GrantProduct(player, s, product)
			Profile.RecordReceipt(s.Profile, purchaseId, os.time())
			ctx.DataService.Touch(s)
		end
		if s.State == "Memory" then
			return Granted
		end
		-- True only if a completed write includes this receipt.
		return if ctx.DataService.SaveSession(s) then Granted else NotYet
	end)
	granting[purchaseId] = nil
	if not ok then
		warn("[PurchaseService] receipt error:", result)
		return NotYet
	end
	return result
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Rebirth: resets coins and gates for a permanent coin bonus and gems
-- (Logic/Economy.Rebirth). Players standing on a now-locked island are sent
-- back to the Meadow.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))
local Schema = require(Logic:WaitForChild("Schema"))

local RebirthService = {}

local ctx: any

function RebirthService.Init(c)
	ctx = c
	ctx.Util.Function("Rebirth", function(player, s)
		local ok, err = Economy.Rebirth(s.Profile)
		if not ok then
			return ctx.Util.Fail(err or "Can't rebirth yet")
		end
		ctx.BreakableService.ClearTarget(player)
		local area = ctx.WorldService.AreaOf(player)
		if area and area ~= Schema.StartArea then
			ctx.WorldService.TeleportTo(player, Schema.StartArea)
		end
		ctx.Util.Toast(player, string.format("Rebirth %d! +%d gems and a permanent coin bonus.", s.Profile.Rebirths, Config.RebirthGems), "good")
		ctx.StateService.Dirty(player)
		task.spawn(ctx.DataService.SaveNow, player)
		return { ok = true, rebirths = s.Profile.Rebirths }
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Daily streak, playtime gifts (per server session), daily quests and Index
-- rewards. All checks live in Logic/Rewards; this file wires the remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Pets = require(Shared:WaitForChild("Pets"))
local Logic = Shared:WaitForChild("Logic")
local Rewards = require(Logic:WaitForChild("Rewards"))

local RewardService = {}

local ctx: any

function RewardService.Init(c)
	ctx = c
	local U = ctx.Util

	ctx.DataService.OnLoaded(function(_, s)
		s.LastPlayClock = os.clock()
		Rewards.EnsurePlaytimeDay(s.Profile, os.time())
	end)
	-- Count the last partial minute before the leave save.
	U.OnPlayerRemoving(function(p)
		local s = ctx.DataService.Get(p)
		if s then
			RewardService.AccruePlaytime(s)
			ctx.DataService.Touch(s)
		end
	end, true)

	U.Function("ClaimDaily", function(player, s)
		local reward, streak, err = Rewards.ClaimDaily(s.Profile, os.time())
		if not reward then
			return U.Fail(err or "Not ready")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, reward = reward, streak = streak }
	end)

	U.Function("ClaimPlaytime", function(player, s, index)
		if not U.IsInt(index, 1, #Config.PlaytimeGifts) then
			return U.Fail("Unknown gift")
		end
		RewardService.AccruePlaytime(s)
		local reward, err = Rewards.ClaimPlaytime(s.Profile, index, os.time())
		if not reward then
			return U.Fail(err or "Not ready")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, reward = reward }
	end)

	U.Function("ClaimQuest", function(player, s, index)
		if not U.IsInt(index, 1, Config.QuestsPerDay) then
			return U.Fail("Unknown quest")
		end
		local reward, err = Rewards.ClaimQuest(s.Profile, index, os.time())
		if not reward then
			return U.Fail(err or "Not ready")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, reward = reward }
	end)

	U.Function("ClaimIndex", function(player, s, tier)
		if not U.IsInt(tier, 1, #Config.IndexRewards) then
			return U.Fail("Unknown reward")
		end
		local reward, err = Rewards.ClaimIndex(s.Profile, tier, os.time())
		if not reward then
			return U.Fail(err or "Not ready")
		end
		ctx.StateService.Dirty(player)
		return { ok = true, reward = reward }
	end)
end

-- Adds the time since the last accrual to today's minutes (profile field,
-- so it carries over between sessions and servers within a UTC day).
function RewardService.AccruePlaytime(s)
	local now = os.clock()
	local last = s.LastPlayClock or now
	s.LastPlayClock = now
	Rewards.AddPlaytime(s.Profile, now - last, os.time())
end

function RewardService.Start()
	while true do
		task.wait(30)
		for p, s in ctx.DataService.All() do
			if s.Ready and not s.Released and not s.Leaving then
				RewardService.AccruePlaytime(s)
				ctx.StateService.Dirty(p)
			end
		end
	end
end

-- Tells the player a species just entered their Index.
function RewardService.Discovered(player: Player, petId: string)
	if Pets.ById[petId] then
		ctx.Util.Notify(player, "Discovered", { PetId = petId })
	end
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">StateService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Sends each player their PlayerState snapshot (coalesced to ~5 per second),
-- keeps the replicated player attributes (Pets / Vip) and leaderstats in sync,
-- and owns the per-player flags that come from Roblox services: Premium,
-- group membership and PolicyService rules. Also handles SetSetting and
-- ClientReady.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Logic = Shared:WaitForChild("Logic")
local Profile = require(Logic:WaitForChild("Profile"))
local Economy = require(Logic:WaitForChild("Economy"))
local Inventory = require(Logic:WaitForChild("Inventory"))
local Rewards = require(Logic:WaitForChild("Rewards"))

local StateService = {}

local ctx: any
local dirty: { [Player]: boolean } = {}
local PUSH_INTERVAL = 0.2

function StateService.Init(c)
	ctx = c
	ctx.DataService.OnLoaded(StateService._onLoaded)
	ctx.Util.OnPlayerRemoving(function(p)
		dirty[p] = nil
	end)
	Players.PlayerMembershipChanged:Connect(function(p)
		local s = ctx.DataService.Get(p)
		if s then
			s.Premium = p.MembershipType == Enum.MembershipType.Premium
			StateService.Dirty(p)
		end
	end)

	ctx.Util.Event("ClientReady", function(player)
		StateService.Push(player)
		ctx.TradeService.PushView(player)
	end)

	ctx.Util.Function("SetSetting", function(player, s, key, value)
		local ok, err = Profile.SetSetting(s.Profile, key, value)
		if not ok then
			return ctx.Util.Fail(err or "Bad setting")
		end
		if key == "AutoFarm" and value == false then
			ctx.BreakableService.ClearTarget(player)
		end
		StateService.Dirty(player)
		return { ok = true }
	end)
end

function StateService.Start()
	task.spawn(function()
		while true do
			task.wait(PUSH_INTERVAL)
			local list = dirty
			dirty = {}
			for p in list do
				if p.Parent ~= nil then
					local ok, err = pcall(StateService.Push, p)
					if not ok then
						warn("[StateService] push failed:", err)
					end
				end
			end
		end
	end)
	-- Housekeeping once a minute: playtime minutes, expired boosts, new quest day.
	while true do
		task.wait(60)
		local now = os.time()
		for p, s in ctx.DataService.All() do
			if s.Ready and not s.Released then
				Economy.PruneBoosts(s.Profile, now)
				Rewards.EnsureQuests(s.Profile, Rewards.DayNumber(now))
				StateService.Dirty(p)
			end
		end
	end
end

local function fetchPolicy(player: Player, s)
	for attempt = 1, 3 do
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(info) == "table" then
			s.CanBuyGemEggs = info.ArePaidRandomItemsRestricted ~= true
			s.CanTrade = info.IsPaidItemTradingAllowed ~= false
			s.PolicyKnown = true
			return
		end
		task.wait(attempt)
	end
	if ctx.IsStudio then
		-- Studio test players (negative UserIds) may not get an answer; allow
		-- everything so every flow can be tested.
		s.CanBuyGemEggs = true
		s.CanTrade = true
		s.PolicyKnown = true
		return
	end
	-- Unknown policy: stay on the safe side for paid random items and trading.
	s.CanBuyGemEggs = false
	s.CanTrade = false
	s.PolicyKnown = true
	warn("[StateService] PolicyService failed for", player.UserId, "- gem eggs and trading disabled")
end

function StateService._onLoaded(player: Player, s)
	s.Premium = player.MembershipType == Enum.MembershipType.Premium
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
	s.Leaderstats = { Coins = coins, Rebirths = rebirths }
	Rewards.EnsureQuests(s.Profile, Rewards.DayNumber(os.time()))
	StateService.Push(player)
	-- Slow lookups after the first push so the player isn't kept waiting.
	task.spawn(function()
		fetchPolicy(player, s)
		if Config.GroupId ~= 0 then
			local ok, inGroup = pcall(function()
				return player:IsInGroup(Config.GroupId)
			end)
			s.InGroup = ok and inGroup == true
		end
		StateService.Dirty(player)
	end)
end

-- Coin / luck multiplier inputs for a session right now.
function StateService.MultContext(s): Economy.MultContext
	return {
		Now = os.time(),
		Premium = s.Premium,
		InGroup = s.InGroup,
		ServerLuckUntil = ctx.BoostService.ServerLuckUntil(),
		NoPaidLuck = StateService.PaidRandomRestricted(s),
	}
end

-- True while paid random items are (or may be) restricted for this player:
-- PolicyService said so, failed, or hasn't answered yet. Such players can't
-- buy luck products, and paid luck (Lucky pass, Luck boost, server luck)
-- doesn't apply to their hatches.
function StateService.PaidRandomRestricted(s): boolean
	return s.CanBuyGemEggs ~= true
end

function StateService.CoinMult(s): number
	return Economy.CoinMult(s.Profile, StateService.MultContext(s))
end

function StateService.LuckMult(s): number
	return Economy.LuckMult(s.Profile, StateService.MultContext(s))
end

-- Marks a player's state as changed; it is sent within PUSH_INTERVAL. Also
-- bumps the profile's change counter so the next save counts it.
function StateService.Dirty(player: Player)
	dirty[player] = true
	ctx.DataService.Touch(ctx.DataService.Get(player))
end

function StateService.DirtyAll()
	for _, p in Players:GetPlayers() do
		dirty[p] = true
	end
end

local function syncReplicated(player: Player, s)
	local p = s.Profile
	local list = {}
	for _, pet in Inventory.EquippedPets(p) do
		table.insert(list, { Uid = pet.Uid, Id = pet.Id, Variant = pet.Variant, Shiny = pet.Shiny })
	end
	local json = HttpService:JSONEncode(list)
	if player:GetAttribute("Pets") ~= json then
		player:SetAttribute("Pets", json)
	end
	local vip = p.Passes.VIP == true
	if player:GetAttribute("Vip") ~= vip then
		player:SetAttribute("Vip", vip)
	end
	if player:GetAttribute("Target") == nil then
		player:SetAttribute("Target", "")
	end
	local ls = s.Leaderstats
	if ls then
		ls.Coins.Value = math.clamp(math.floor(p.Coins), 0, 2 ^ 53)
		ls.Rebirths.Value = p.Rebirths
	end
end

-- Sends the snapshot now.
function StateService.Push(player: Player)
	local s = ctx.DataService.Get(player)
	if not s or player.Parent == nil then
		return
	end
	dirty[player] = nil
	syncReplicated(player, s)
	local state = Profile.BuildState(s.Profile, {
		Now = os.time(),
		Premium = s.Premium,
		InGroup = s.InGroup,
		ServerLuckUntil = ctx.BoostService.ServerLuckUntil(),
		NoPaidLuck = StateService.PaidRandomRestricted(s),
		CanBuyGemEggs = s.CanBuyGemEggs,
		CanTrade = s.CanTrade,
	})
	Net.Event("State"):FireClient(player, state)
end

return StateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player-to-player trading.
--   Request -> target accepts -> both edit offers -> both ready ->
--   Config.TradeConfirmSeconds countdown -> journaled swap.
-- Any offer change un-readies both sides. Trades need PolicyService's
-- IsPaidItemTradingAllowed for both players, accounts at least
-- Config.TradeMinAccountAgeDays old (skipped in Studio), and a cooldown
-- between requests. Leaving before the swap starts cancels the trade.
--
-- The swap can't duplicate items even if the server dies half-way:
--   1. both profiles get PendingTrade = id and must save successfully
--      (otherwise the trade is cancelled and nothing happened);
--   2. the journal (both sides' changes) is written under its own key
--      (if that can't be confirmed, both keep PendingTrade and the trade is
--      settled from the journal - or dropped - on their next join);
--   3. both sides are applied in memory (Logic/Trade.ApplySide) and saved,
--      retrying; the journal is removed once both saves succeeded.
-- A profile that loads with PendingTrade set replays its side (DataService).
-- While a swap runs, both players' remotes are refused (session.TradeBusy).
-- Pure rules: Logic/Trade.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Logic = Shared:WaitForChild("Logic")
local Trade = require(Logic:WaitForChild("Trade"))

local TradeService = {}

local ctx: any
local trades: { [Player]: Trade.TradeState } = {}
-- pending[target][fromUserId] = os.clock() when the request expires
local pending: { [Player]: { [number]: number } } = {}
local lastRequest: { [Player]: number } = {}
local lastCountdown: { [string]: number } = {}
local executing: { [Trade.TradeState]: boolean } = {}

local TICK = 0.25

local function profileOf(userId: number)
	local p = Players:GetPlayerByUserId(userId)
	local s = p and ctx.DataService.Get(p)
	return s and s.Profile
end

local function sendView(player: Player, t: Trade.TradeState?)
	if player.Parent == nil then
		return
	end
	local view = if t then Trade.View(t, player.UserId, os.clock(), profileOf) else nil
	Net.Event("Trade"):FireClient(player, view)
end

local function playersOf(t: Trade.TradeState): { Player }
	local out = {}
	for p, tt in trades do
		if tt == t then
			table.insert(out, p)
		end
	end
	return out
end

local function pushBoth(t: Trade.TradeState)
	for _, p in playersOf(t) do
		sendView(p, t)
	end
end

local function close(t: Trade.TradeState, message: string?, tone: string?)
	lastCountdown[t.Id] = nil
	for _, p in playersOf(t) do
		trades[p] = nil
		sendView(p, t) -- final status (Done / Cancelled)
		sendView(p, nil)
		if message then
			ctx.Util.Toast(p, message, tone)
		end
	end
end

-- Why a player can't trade right now, or nil.
local function blockedReason(player: Player, s): string?
	if not s then
		return "still loading"
	end
	if not s.CanTrade then
		return "trading isn't available for this account"
	end
	if ctx.DataService.ReadOnly(s) then
		return "data didn't load, so trading is off"
	end
	if s.TradeBusy or s.Profile.PendingTrade ~= nil then
		return "a previous trade is still being saved - try again after rejoining"
	end
	if not RunService:IsStudio() and player.AccountAge < Config.TradeMinAccountAgeDays then
		return string.format("accounts must be %d days old to trade", Config.TradeMinAccountAgeDays)
	end
	return nil
end

function TradeService.Init(c)
	ctx = c
	local U = ctx.Util

	U.OnPlayerRemoving(function(p)
		local t = trades[p]
		if t and executing[t] then
			-- The swap is already running; it finishes (or is settled from the
			-- journal on next join). close() tidies up the mapping.
			t = nil
		end
		if t then
			Trade.Cancel(t)
			close(t, p.DisplayName .. " left, trade cancelled", "bad")
			trades[p] = nil
		end
		pending[p] = nil
		lastRequest[p] = nil
		for _, list in pending do
			list[p.UserId] = nil
		end
	end, true)

	U.Function("TradeRequest", function(player, s, targetUserId)
		if not U.IsInt(targetUserId) then
			return U.Fail("Unknown player")
		end
		if targetUserId == player.UserId then
			return U.Fail("You can't trade with yourself")
		end
		local target = Players:GetPlayerByUserId(targetUserId)
		if not target then
			return U.Fail("That player isn't in this server")
		end
		local why = blockedReason(player, s)
		if why then
			return U.Fail("You can't trade: " .. why)
		end
		local ts = ctx.DataService.Get(target)
		local whyTarget = blockedReason(target, ts)
		if whyTarget then
			return U.Fail(target.DisplayName .. " can't trade: " .. whyTarget)
		end
		if trades[player] then
			return U.Fail("Finish your current trade first")
		end
		if trades[target] then
			return U.Fail(target.DisplayName .. " is already trading")
		end
		local now = os.clock()
		if lastRequest[player] and now - lastRequest[player] < Config.TradeCooldown then
			return U.Fail("Wait a few seconds before sending another request")
		end
		lastRequest[player] = now
		pending[target] = pending[target] or {}
		pending[target][player.UserId] = now + Config.TradeRequestTimeout
		U.Notify(target, "TradeRequest", { FromUserId = player.UserId, FromName = player.DisplayName })
		return { ok = true }
	end)

	U.Function("TradeRespond", function(player, s, fromUserId, accept)
		if not U.IsInt(fromUserId) or not U.IsBool(accept) then
			return U.Fail("Bad request")
		end
		local list = pending[player]
		local expires = list and list[fromUserId]
		if list then
			list[fromUserId] = nil
		end
		if not expires or os.clock() > expires then
			return U.Fail("That request expired")
		end
		local from = Players:GetPlayerByUserId(fromUserId)
		if not from then
			return U.Fail("That player left")
		end
		if not accept then
			U.Toast(from, player.DisplayName .. " declined your trade", "info")
			return { ok = true }
		end
		local why = blockedReason(player, s)
		if why then
			return U.Fail("You can't trade: " .. why)
		end
		local fs = ctx.DataService.Get(from)
		local whyFrom = blockedReason(from, fs)
		if whyFrom then
			return U.Fail(from.DisplayName .. " can't trade: " .. whyFrom)
		end
		if trades[player] or trades[from] then
			return U.Fail("One of you is already trading")
		end
		local t = Trade.New(HttpService:GenerateGUID(false), from.UserId, from.DisplayName, player.UserId, player.DisplayName)
		trades[from] = t
		trades[player] = t
		pushBoth(t)
		return { ok = true }
	end)

	U.Function("TradeSetOffer", function(player, s, uids, gems)
		local t = trades[player]
		if not t then
			return U.Fail("You're not trading")
		end
		if type(uids) ~= "table" or #uids > Config.TradeMaxPets then
			return U.Fail(string.format("At most %d pets per trade", Config.TradeMaxPets))
		end
		local ok, err = Trade.SetOffer(t, player.UserId, s.Profile, uids, gems)
		if not ok then
			return U.Fail(err or "Can't offer that")
		end
		lastCountdown[t.Id] = nil
		pushBoth(t)
		return { ok = true }
	end)

	U.Function("TradeReady", function(player, s, ready)
		local t = trades[player]
		if not t then
			return U.Fail("You're not trading")
		end
		if not U.IsBool(ready) then
			return U.Fail("Bad request")
		end
		if ready then
			-- Re-check this side's offer now so problems show before the countdown.
			local i = Trade.SideIndex(t, player.UserId)
			local side = i and t.Sides[i]
			if side then
				local ok, err = Trade.ValidateOffer(s.Profile, side.Pets, side.Gems)
				if not ok then
					return U.Fail(err or "Your offer changed")
				end
			end
		end
		local ok, err = Trade.SetReady(t, player.UserId, ready, os.clock())
		if not ok then
			return U.Fail(err or "Can't do that")
		end
		pushBoth(t)
		return { ok = true }
	end)

	U.Function("TradeCancel", function(player)
		local t = trades[player]
		if not t then
			return { ok = true }
		end
		Trade.Cancel(t)
		close(t, player.DisplayName .. " cancelled the trade", "info")
		return { ok = true }
	end)
end

function TradeService.Start()
	while true do
		task.wait(TICK)
		local seen: { [Trade.TradeState]: boolean } = {}
		for _, t in trades do
			if seen[t] or executing[t] then
				continue
			end
			seen[t] = true
			local ok, err = pcall(TradeService._tickTrade, t)
			if not ok then
				warn("[TradeService] tick error:", err)
				Trade.Cancel(t)
				close(t, "Trade cancelled (server error)", "bad")
			end
		end
		-- Drop expired requests.
		local now = os.clock()
		for _, list in pending do
			for from, expires in list do
				if now > expires then
					list[from] = nil
				end
			end
		end
	end
end

function TradeService._tickTrade(t: Trade.TradeState)
	if t.Status ~= "Confirming" then
		return
	end
	local now = os.clock()
	if not Trade.Due(t, now) then
		local left = math.ceil((t.ConfirmAt or now) - now)
		if lastCountdown[t.Id] ~= left then
			lastCountdown[t.Id] = left
			pushBoth(t)
		end
		return
	end
	-- The swap yields (saves), so it runs on its own thread; the tick skips it.
	executing[t] = true
	task.spawn(function()
		local ok, err = pcall(TradeService._execute, t)
		executing[t] = nil
		if not ok then
			warn("[TradeService] execute error:", err)
			Trade.Cancel(t)
			close(t, "Trade cancelled", "bad")
		end
	end)
end

function TradeService._execute(t: Trade.TradeState)
	local pa = Players:GetPlayerByUserId(t.Sides[1].UserId)
	local pb = Players:GetPlayerByUserId(t.Sides[2].UserId)
	local sa = pa and ctx.DataService.Get(pa)
	local sb = pb and ctx.DataService.Get(pb)
	if not sa or not sb or trades[pa] ~= t or trades[pb] ~= t
		or blockedReason(pa, sa) or blockedReason(pb, sb) then
		Trade.Cancel(t)
		close(t, "Trade cancelled", "bad")
		return
	end
	local plan, err = Trade.Plan(t, sa.Profile, sb.Profile)
	if not plan then
		Trade.Cancel(t)
		close(t, "Trade cancelled: " .. (err or "something changed"), "bad")
		return
	end
	sa.TradeBusy = true
	sb.TradeBusy = true
	local ok, result = pcall(TradeService._swap, t, pa, pb, sa, sb)
	sa.TradeBusy = false
	sb.TradeBusy = false
	if not ok then
		warn("[TradeService] swap error:", result)
	end
	if t.Status ~= "Done" then
		Trade.Cancel(t)
		close(t, if ok and type(result) == "string" then result else "Trade cancelled", "bad")
	end
end

-- Steps 1-3 of the journaled swap. Returns a message when the trade did not
-- happen (the caller cancels), nil when it is Done.
function TradeService._swap(t: Trade.TradeState, pa: Player, pb: Player, sa, sb): string?
	local D = ctx.DataService
	local id = t.Id
	local function clearPending()
		for _, s in { sa, sb } do
			if s.Profile.PendingTrade == id then
				s.Profile.PendingTrade = nil
				D.Touch(s)
				task.spawn(D.SaveSession, s)
			end
		end
	end

	-- 1. Mark both profiles and make sure the marks are stored.
	sa.Profile.PendingTrade = id
	sb.Profile.PendingTrade = id
	D.Touch(sa)
	D.Touch(sb)
	local saved = D.SaveSession(sa) and D.SaveSession(sb)
	if not saved then
		clearPending()
		return "Trade cancelled: couldn't save, nothing was exchanged"
	end

	-- Offers can't have changed (remotes were blocked), but check again.
	local plan, err = Trade.Plan(t, sa.Profile, sb.Profile)
	if not plan then
		clearPending()
		return "Trade cancelled: " .. (err or "something changed")
	end

	-- 2. Journal.
	local journal = Trade.Journal(t, plan)
	if D.WriteJournal(id, journal) ~= "written" then
		-- Unknown outcome: both keep PendingTrade (already saved), so their next
		-- join settles it the same way for both. Trading stays off until then.
		return "Trade couldn't be confirmed. It will be settled when you rejoin."
	end

	-- 3. Apply both sides and save.
	local newFor = {}
	for i in t.Sides do
		local receiver = if i == 1 then sb.Profile else sa.Profile
		local list = {}
		for _, pet in journal.Sides[tostring(t.Sides[3 - i].UserId)].Get do
			if not receiver.Index[pet.Id] then
				list[pet.Id] = true
			end
		end
		newFor[3 - i] = list
	end
	Trade.ApplySide(sa.Profile, journal.Sides[tostring(t.Sides[1].UserId)], id)
	Trade.ApplySide(sb.Profile, journal.Sides[tostring(t.Sides[2].UserId)], id)
	t.Status = "Done"
	t.ConfirmAt = nil
	D.Touch(sa)
	D.Touch(sb)
	for i, p in { pa, pb } do
		if p.Parent ~= nil then
			for petId in newFor[i] do
				ctx.RewardService.Discovered(p, petId)
			end
			ctx.StateService.Dirty(p)
		end
	end
	close(t, "Trade complete!", "good")
	task.spawn(TradeService._saveAfter, id, sa, sb)
	return nil
end

-- Saves both sides until stored; removes the journal once both are.
function TradeService._saveAfter(id: string, sa, sb)
	local D = ctx.DataService
	local doneA, doneB = false, false
	for attempt = 1, 8 do
		doneA = doneA or D.SaveSession(sa)
		doneB = doneB or D.SaveSession(sb)
		if doneA and doneB then
			D.RemoveJournal(id)
			return
		end
		-- A side that left before its final save replays from the journal on
		-- its next join, so the journal must stay.
		if (not doneA and (sa.Closed or sa.LockLost)) or (not doneB and (sb.Closed or sb.LockLost)) then
			return
		end
		task.wait(math.min(2 ^ attempt, 30))
	end
	warn("[TradeService] trade", id, "saved only partly; the journal settles it on next join")
end

-- uids the player currently offers in an open trade (blocked from delete,
-- craft and expeditions).
function TradeService.OfferedSet(player: Player): { [string]: boolean }
	local set = {}
	local t = trades[player]
	if t and Trade.IsActive(t) then
		local i = Trade.SideIndex(t, player.UserId)
		if i then
			for _, uid in t.Sides[i].Pets do
				set[uid] = true
			end
		end
	end
	return set
end

-- True while the player has an open trade.
function TradeService.InTrade(player: Player): boolean
	local t = trades[player]
	return t ~= nil and Trade.IsActive(t)
end

-- Sends the current trade window (or nil) to one player.
function TradeService.PushView(player: Player)
	sendView(player, trades[player])
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Shared server helpers: player join / leave hooks, the remote wrapper
-- (rate limit + loaded-profile check + pcall + uniform error results),
-- argument validation, notifications and character queries.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Logic = Shared:WaitForChild("Logic")
local RateLimiter = require(Logic:WaitForChild("RateLimiter"))

local Util = {}

local ctx: any
local joinHooks: { (Player) -> () } = {}
local leaveHooks: { (Player) -> () } = {}
local joined: { [Player]: boolean } = {}
local limiter = RateLimiter.New()

-- Calls per second (Rate) and burst size (Burst) for each remote. Anything
-- not listed uses DEFAULT_LIMIT.
local DEFAULT_LIMIT = { Rate = 4, Burst = 8 }
Util.Limits = {
	HatchEgg = { Rate = 3, Burst = 4 },
	EquipPet = { Rate = 10, Burst = 20 },
	LockPet = { Rate = 10, Burst = 20 },
	DeletePets = { Rate = 3, Burst = 6 },
	CraftPet = { Rate = 3, Burst = 6 },
	SetTarget = { Rate = 10, Burst = 20 },
	ClientReady = { Rate = 0.5, Burst = 3 },
	TradeSetOffer = { Rate = 6, Burst = 12 },
	TradeRequest = { Rate = 1, Burst = 3 },
	DevPurchase = { Rate = 1, Burst = 3 },
	DevAction = { Rate = 2, Burst = 5 },
	SetSetting = { Rate = 5, Burst = 10 },
} :: { [string]: { Rate: number, Burst: number } }

function Util.Init(c)
	ctx = c
	Players.PlayerAdded:Connect(Util.FirePlayerAdded)
	Players.PlayerRemoving:Connect(function(p)
		for _, fn in leaveHooks do
			local ok, err = pcall(fn, p)
			if not ok then
				warn("[Util] leave hook error:", err)
			end
		end
		joined[p] = nil
		RateLimiter.Forget(limiter, p)
	end)
end

-- Runs join hooks for players who arrived before the hooks were connected.
function Util.Start()
	for _, p in Players:GetPlayers() do
		Util.FirePlayerAdded(p)
	end
end

function Util.OnPlayerAdded(fn: (Player) -> ())
	table.insert(joinHooks, fn)
end

-- `first`: run before the other leave hooks (e.g. cancel a trade before saving).
function Util.OnPlayerRemoving(fn: (Player) -> (), first: boolean?)
	if first then
		table.insert(leaveHooks, 1, fn)
	else
		table.insert(leaveHooks, fn)
	end
end

function Util.FirePlayerAdded(p: Player)
	if joined[p] then
		return
	end
	joined[p] = true
	for _, fn in joinHooks do
		task.spawn(function()
			local ok, err = pcall(fn, p)
			if not ok then
				warn("[Util] join hook error:", err)
			end
		end)
	end
end

local function allow(player: Player, name: string): boolean
	return RateLimiter.Allow(limiter, player, name, Util.Limits[name] or DEFAULT_LIMIT, os.clock())
end

function Util.Fail(err: string): { ok: boolean, err: string }
	return { ok = false, err = err }
end

-- Connects a RemoteFunction. The handler gets (player, session, ...args) and
-- returns a result table. Players whose profile isn't loaded yet, rate
-- limited calls and handler errors all get { ok = false, err = ... }.
function Util.Function(name: string, handler: (Player, any, ...any) -> any)
	Net.Function(name).OnServerInvoke = function(player: Player, ...)
		if not allow(player, name) then
			return Util.Fail("Slow down a little")
		end
		local session = ctx.DataService.Get(player)
		if not session then
			return Util.Fail("Still loading your data")
		end
		if session.TradeBusy then
			-- A trade swap is saving; nothing may change this profile meanwhile.
			return Util.Fail("Finishing your trade, one moment")
		end
		local ok, result = pcall(handler, player, session, ...)
		if not ok then
			warn(string.format("[%s] error from %s: %s", name, player.Name, tostring(result)))
			return Util.Fail("Something went wrong")
		end
		if type(result) ~= "table" then
			return { ok = true }
		end
		return result
	end
end

-- Connects a client -> server RemoteEvent with the same protections.
function Util.Event(name: string, handler: (Player, any, ...any) -> ())
	Net.Event(name).OnServerEvent:Connect(function(player: Player, ...)
		if not allow(player, name) then
			return
		end
		local session = ctx.DataService.Get(player)
		if not session then
			return
		end
		local ok, err = pcall(handler, player, session, ...)
		if not ok then
			warn(string.format("[%s] error from %s: %s", name, player.Name, tostring(err)))
		end
	end)
end

-- Notifications ---------------------------------------------------------------

function Util.Notify(player: Player, kind: string, data: any)
	if player.Parent == nil then
		return
	end
	Net.Event("Notify"):FireClient(player, kind, data)
end

function Util.Toast(player: Player, text: string, tone: string?)
	Util.Notify(player, "Toast", { Text = text, Tone = tone or "info" })
end

function Util.NotifyAll(kind: string, data: any)
	Net.Event("Notify"):FireAllClients(kind, data)
end

-- Validation ------------------------------------------------------------------

function Util.IsFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function Util.IsInt(n: any, lo: number?, hi: number?): boolean
	if not Util.IsFinite(n) or n ~= math.floor(n) then
		return false
	end
	if lo and n < lo then
		return false
	end
	if hi and n > hi then
		return false
	end
	return true
end

function Util.IsStr(s: any, maxLen: number?): boolean
	return type(s) == "string" and #s > 0 and #s <= (maxLen or 64)
end

function Util.IsBool(b: any): boolean
	return type(b) == "boolean"
end

-- Characters ------------------------------------------------------------------

function Util.Root(player: Player): BasePart?
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Util.Position(player: Player): Vector3?
	local root = Util.Root(player)
	return if root then root.Position else nil
end

function Util.DistTo(player: Player, pos: Vector3): number
	local p = Util.Position(player)
	if not p then
		return math.huge
	end
	return (p - pos).Magnitude
end

return Util
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds the map (Models/World), tracks which island each player stands on,
-- opens gates and teleports between opened islands. A player found inside an
-- island they haven't opened (e.g. a client that removed the gate barrier) is
-- sent back to their furthest opened island.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared:WaitForChild("Areas"))
local Models = Shared:WaitForChild("Models")
local World = require(Models:WaitForChild("World"))
local Logic = Shared:WaitForChild("Logic")
local Economy = require(Logic:WaitForChild("Economy"))

local WorldService = {}

local ctx: any
WorldService.Info = { Spawns = {}, Zones = {}, Bounds = {} } :: World.WorldInfo
local currentArea: { [Player]: string } = {}

local CHECK_INTERVAL = 1
local TELEPORT_COOLDOWN = 2
local LOCKED_MARGIN = 12 -- studs inside a locked island before a player is sent back

function WorldService.Init(c)
	ctx = c
	local ok, result = pcall(World.Build)
	if ok and type(result) == "table" then
		WorldService.Info = result
	else
		warn("[WorldService] World.Build failed:", result)
	end

	ctx.Util.OnPlayerRemoving(function(p)
		currentArea[p] = nil
	end)

	ctx.Util.Function("OpenGate", function(player, s, areaId)
		if not ctx.Util.IsStr(areaId, 32) or not Areas.ById[areaId] then
			return ctx.Util.Fail("Unknown island")
		end
		local ok2, err = Economy.OpenGate(s.Profile, areaId)
		if not ok2 then
			return ctx.Util.Fail(err or "Can't open that gate")
		end
		ctx.Util.Toast(player, Areas.ById[areaId].Name .. " is open!", "good")
		ctx.StateService.Dirty(player)
		return { ok = true }
	end)

	ctx.Util.Function("Teleport", function(player, s, areaId)
		if not ctx.Util.IsStr(areaId, 32) or not Areas.ById[areaId] then
			return ctx.Util.Fail("Unknown island")
		end
		if not s.Profile.Areas[areaId] then
			return ctx.Util.Fail("Open that island first")
		end
		local now = os.clock()
		if s.LastTeleport and now - s.LastTeleport < TELEPORT_COOLDOWN then
			return ctx.Util.Fail("Slow down a little")
		end
		if not WorldService.TeleportTo(player, areaId) then
			return ctx.Util.Fail("Can't teleport right now")
		end
		s.LastTeleport = now
		return { ok = true }
	end)
end

function WorldService.Start()
	while true do
		task.wait(CHECK_INTERVAL)
		for _, p in Players:GetPlayers() do
			local ok, err = pcall(WorldService._check, p)
			if not ok then
				warn("[WorldService] area check failed:", err)
			end
		end
	end
end

-- Island id containing a position, or nil. `margin` shrinks each island's box
-- horizontally (so standing right at a gate never counts as being inside).
function WorldService.AreaAt(pos: Vector3, margin: number?): string?
	local m = margin or 0
	for id, b in WorldService.Info.Bounds do
		local mn, mx = b.Min, b.Max
		if pos.X >= mn.X + m and pos.X <= mx.X - m and pos.Y >= mn.Y and pos.Y <= mx.Y
			and pos.Z >= mn.Z + m and pos.Z <= mx.Z - m then
			return id
		end
	end
	return nil
end

function WorldService.AreaOf(player: Player): string?
	return currentArea[player]
end

function WorldService.TeleportTo(player: Player, areaId: string): boolean
	local spawn = WorldService.Info.Spawns[areaId]
	local char = player.Character
	if not spawn or not char or not ctx.Util.Root(player) then
		return false
	end
	ctx.BreakableService.ClearTarget(player)
	char:PivotTo(spawn + Vector3.new(math.random(-4, 4), 3, math.random(-4, 4)))
	currentArea[player] = areaId
	return true
end

-- Positions of every tagged interactable with a given attribute value.
function WorldService.TaggedPosition(tag: string, attr: string?, value: any): Vector3?
	for _, inst in CollectionService:GetTagged(tag) do
		if attr == nil or inst:GetAttribute(attr) == value then
			if inst:IsA("Model") then
				return inst:GetPivot().Position
			elseif inst:IsA("BasePart") then
				return inst.Position
			end
		end
	end
	return nil
end

function WorldService._check(player: Player)
	local s = ctx.DataService.Get(player)
	local pos = ctx.Util.Position(player)
	if not s or not pos then
		return
	end
	local deep = WorldService.AreaAt(pos, LOCKED_MARGIN)
	if deep and not s.Profile.Areas[deep] then
		local home = Economy.HighestArea(s.Profile)
		if WorldService.TeleportTo(player, home) then
			ctx.Util.Toast(player, "Open the gate to " .. Areas.ById[deep].Name .. " first!", "bad")
		end
		return
	end
	local area = WorldService.AreaAt(pos)
	if area and s.Profile.Areas[area] then
		currentArea[player] = area
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
