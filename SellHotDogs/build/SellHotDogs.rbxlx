				note = "$1.00 label, no multipliers.",
			},
			{
				level = 2,
				output = 1.905,
				status = "hypothesis",
				src = "N 00:48.2",
				note = "$3.81 label / x2 condiment. Single animated read; low confidence.",
			},
			{
				level = 3,
				output = 2.92,
				status = "hypothesis",
				src = "N 00:48.6; N 00:58",
				note = "$5.84/x2 and $17.51/x6 agree (2.92, 2.918).",
