          <string name="Source"><![CDATA[--!nocheck
-- GENERATED by tools/gen_catalog.py from catalog/economy.json. Do not edit by hand.
-- Every value keeps its evidence status (observed/secondary/hypothesis/placeholder).
return {
	_readme = "Single source of truth for every number the game uses. Edit here, then run `python3 tools/gen_catalog.py` to regenerate src/shared/Catalog.luau and docs/CATALOG.md. Every value carries a status: observed (read in dated reference footage, see sources), secondary (third-party wiki/guide claim, not verified), hypothesis (our interpretation of observations), placeholder (UNKNOWN in the reference; a clearly labelled stand-in so the game runs; must be replaced when evidence exists). Money values are dollars; times are seconds; mult values are multipliers.",
	sources = {
		N = {
			title = "narrow, \"Roblox Sell Lemons..\" (uploaded 2026-06-10, 765 s)",
			url = "https://www.youtube.com/watch?v=IJB1f-o7_bk",
			note = "Frames inspected by the earlier research pass (supplied in the handoff). Not re-watched in this session: YouTube is blocked by this environment's egress proxy.",
		},
		B = {
			title = "Bemmy, \"Spending $5000 ROBUX on TIME SKIPS in SELL LEMONS??\" (uploaded 2026-06-25, 806 s)",
			url = "https://www.youtube.com/watch?v=Vu0A1VN1KTs",
			note = "Frames inspected by the earlier research pass (supplied in the handoff). Not re-watched in this session.",
		},
		["W-stand"] = {
			title = "Sell Lemons fandom wiki: Lemon Stand",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Lemon_Stand",
			note = "Secondary. Page fetch blocked here; claims taken from the handoff and from 2026-10-01 web-search summaries.",
		},
		["W-dash"] = {
			title = "Sell Lemons fandom wiki: LemonDash",
			url = "https://sell-lemons-roblox.fandom.com/wiki/LemonDash",
			note = "Secondary.",
		},
		["W-income"] = {
			title = "Sell Lemons fandom wiki: Income Sources (via web-search summary 2026-10-01)",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Income_Sources",
			note = "Secondary. Unlock and automation costs of all eight businesses.",
		},
		["W-depot"] = {
			title = "Sell Lemons fandom wiki: Lemon Depot (via web-search summary 2026-10-01)",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Lemon_Depot",
			note = "Secondary. Some costs look inconsistent (below the unlock price) and are flagged.",
		},
		["W-trading"] = {
			title = "Web-search summary of Sell Lemons Trading upgrades (2026-10-01)",
			url = "https://allthings.how/sell-lemons-money-guide-fastest-ways-to-get-rich-roblox/",
			note = "Secondary, low confidence.",
		},
		["W-rebirth"] = {
			title = "Sell Lemons fandom wiki: Rebirth",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Rebirth",
			note = "Secondary.",
		},
		["W-evo"] = {
			title = "Sell Lemons fandom wiki: Evolution",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Evolution",
			note = "Secondary.",
		},
		["W-asc"] = {
			title = "Sell Lemons fandom wiki: Ascension",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Ascension",
			note = "Secondary.",
		},
		["W-powers"] = {
			title = "Sell Lemons fandom wiki: Powers / Robux; allthings.how powers guide (web-search summary 2026-10-01)",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Powers",
			note = "Secondary. Investor costs for Manage/Run Faster/Stack Upgrade; Robux prices conflict between guides.",
		},
		["W-mini"] = {
			title = "Minigames: sportskeeda / techwiser summaries (web-search 2026-10-01)",
			url = "https://sell-lemons-roblox.fandom.com/wiki/Minigames",
			note = "Secondary. Lemon Dash: four balls, bet on one, press Cheer.",
		},
		["W-phone"] = {
			title = "Phone deals: sportskeeda beginner guide (web-search 2026-10-01)",
			url = "https://www.sportskeeda.com/roblox-news/sell-lemons-a-beginner-s-guide",
			note = "Secondary. Accept or Raise; pushing too hard makes the buyer cancel.",
		},
		D = {
			title = "Official experience description",
			url = "https://www.roblox.com/games/79268393072444/Sell-Lemons",
			note = "Description claim '100% offline income' (not a measured formula).",
		},
		OURS = {
			title = "Sell Hot Dogs design decision",
			url = "",
			note = "No reference value exists; this is a labelled stand-in so the game runs. Listed in docs/CATALOG.md under Unresolved.",
		},
	},
	start = {
		cash = {
			value = 1,
			status = "hypothesis",
			src = "N 00:15; W-stand",
			note = "A $1.00 wallet was visible near N 00:15 and the wiki claims the stand unlocks for $1. Clean new-player balance is unverified.",
		},
	},
	stand_level_shape = {
		_note = "Per-level output of the first business before multipliers, derived from N labels divided by the installed cash multipliers. Levels beyond the observed ones are placeholders.",
