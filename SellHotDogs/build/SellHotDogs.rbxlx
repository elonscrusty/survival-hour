		},
		extrapolate = {
			growth = 1.5,
			status = "placeholder",
			src = "OURS",
			note = "UNRESOLVED. After the 4th upgrade each further upgrade costs x1.5 the previous. The real repeated-upgrade formula, rounding and milestones are unknown.",
		},
	},
	generic_business = {
		_note = "Placeholder rules for every business except the Hot Dog Stand, whose base output and time ARE observed. Nothing about the other businesses' base output, cycle time or level costs is known.",
		outputPerUnlockCost = {
			value = 0.02,
			status = "placeholder",
			src = "OURS",
			note = "UNRESOLVED. Level-1 output per cycle = 2% of the business's unlock price.",
		},
		cycleTime = {
			value = 3,
			status = "placeholder",
			src = "OURS",
			note = "UNRESOLVED. Base cycle time 3 s for every later business.",
		},
		firstLevelCostPerUnlockCost = {
			value = 0.3,
