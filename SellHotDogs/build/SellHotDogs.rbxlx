      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Runtime switches (not economy numbers; those live in catalog/economy.json).
local Config = {
	-- Storage: "mock" keeps saves in server memory only (safe for local Studio tests).
	-- Switch to "datastore" only after the new experience is published and Studio API access
	-- is deliberately enabled for THAT experience (see docs/LIVE_SETUP.md).
	Storage = "mock",
	DataStoreName = "SellHotDogs_Profiles_v1",
	AutosaveSeconds = 60,
	LoadRetries = 3,

	-- Robux: product IDs live in Products.luau. While MockPurchases is on (Studio only),
	-- the shop shows "Test" buttons that run the real receipt handler with fake receipts.
	MockPurchases = true,

	Plots = 4,
	StepSeconds = 0.1, -- production step
	SyncSeconds = 0.2, -- state snapshot rate to the owner
	InteractRange = 40, -- studs from a business to click/upgrade without Manage
	PadRange = 14, -- studs from a pad for a prompt purchase without Remote Buy
	BaseWalkSpeed = 16,
}
return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--!strict
-- Plot geometry in plot-local studs. +Z runs away from the road, X across the plot.
-- Shared so the client can point guidance arrows at the same spots the server builds.
local Layout = {}

Layout.PLOT_SPACING = 240 -- along the road (world X)
Layout.PLOT_HALF_WIDTH = 105
Layout.PLOT_DEPTH = 330
Layout.ROAD_Z = -26 -- road centre line, in front of every plot

-- Lot centre and footprint per business (stand closest to the road, HotDogX at the back).
Layout.lots = ({
	stand = { pos = Vector3.new(0, 0, 34), size = Vector2.new(40, 30) },
	dash = { pos = Vector3.new(-58, 0, 92), size = Vector2.new(46, 40) },
	depot = { pos = Vector3.new(58, 0, 92), size = Vector2.new(46, 40) },
	trading = { pos = Vector3.new(-58, 0, 160), size = Vector2.new(46, 40) },
	labs = { pos = Vector3.new(58, 0, 160), size = Vector2.new(46, 40) },
	robotics = { pos = Vector3.new(-58, 0, 228), size = Vector2.new(46, 40) },
	republic = { pos = Vector3.new(58, 0, 228), size = Vector2.new(46, 40) },
	hotdogx = { pos = Vector3.new(0, 0, 290), size = Vector2.new(56, 40) },
} :: { [string]: { pos: Vector3, size: Vector2 } })

Layout.spawn = Vector3.new(0, 3, 6)
Layout.portal = Vector3.new(0, 0, 196) -- Void Evolution portal in the central plaza
Layout.staircase = Vector3.new(0, 0, 318) -- Ascension staircase behind HotDogX
Layout.investorDesk = Vector3.new(0, 0, 140) -- Alien Investors kiosk

-- Ingredient racks (pickup spots) sit beside the path, never on a pad or doorway.
Layout.racks = {
	Vector3.new(30, 0, 12),
	Vector3.new(-30, 0, 12),
	Vector3.new(-22, 0, 126),
	Vector3.new(22, 0, 126),
}

-- Pad k (1-based) of a business: rows of four in front of the lot, facing the road.
function Layout.padPos(bizId: string, k: number): Vector3
	local lot = Layout.lots[bizId]
	local col = (k - 1) % 4
	local row = (k - 1) // 4
	local front = lot.pos.Z - lot.size.Y / 2 - 7 - row * 9
	if bizId == "stand" then
		-- the stand's pads wrap both sides so the walkway to the road stays clear
		local side = if col < 2 then -1 else 1
		local x = side * (lot.size.X / 2 + 6 + (col % 2) * 9)
		return lot.pos + Vector3.new(x, 0, -8 + row * 10)
	end
	return Vector3.new(lot.pos.X + (col - 1.5) * 10, 0, front)
end

-- Unlock pad of a business: right at the front edge of its lot.
function Layout.unlockPos(bizId: string): Vector3
	local lot = Layout.lots[bizId]
	return lot.pos - Vector3.new(0, 0, lot.size.Y / 2 + 6)
end

-- Where the prop of owned pad k stands (around the lot so it never blocks the front).
function Layout.propPos(bizId: string, k: number, n: number): Vector3
	local lot = Layout.lots[bizId]
	local hw, hd = lot.size.X / 2 - 4, lot.size.Y / 2 - 4
	-- walk the back and side edges
	local t = if n <= 1 then 0.5 else (k - 1) / (n - 1)
	local perim = hd * 2 + hw * 2
	local d = t * perim
	if d < hd then
		return lot.pos + Vector3.new(-hw, 0, -hd * 0.2 + d)
	elseif d < hd + hw * 2 then
		return lot.pos + Vector3.new(-hw + (d - hd), 0, hd)
	else
		return lot.pos + Vector3.new(hw, 0, hd - (d - hd - hw * 2))
	end
end

function Layout.plotOrigin(index: number): CFrame
	return CFrame.new((index - 1) * Layout.PLOT_SPACING, 0, 0)
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">BigNum</string>
            <string name="Source"><![CDATA[--!strict
-- Serializable big numbers for cash and investors: value = m * 10^e with 1 <= |m| < 10
-- (or m = 0, e = 0). Plain tables so they save to a DataStore and cross remotes as-is.
-- Ordinary doubles overflow near 1e308; reference footage shows wallets near 10^564.

export type Big = { m: number, e: number }

local BigNum = {}

local ZERO_EXP_GAP = 17 -- beyond this many orders of magnitude the smaller term is invisible

local function norm(m: number, e: number): Big
	if m ~= m or m == math.huge or m == -math.huge then
		error("BigNum: non-finite mantissa")
	end
	if m == 0 then
		return { m = 0, e = 0 }
	end
	local shift = math.floor(math.log10(math.abs(m)))
	m = m / 10 ^ shift
	e = e + shift
	-- guard float drift (e.g. 9.9999999 or 10.0000001)
	if math.abs(m) >= 10 then
		m /= 10
		e += 1
	elseif math.abs(m) < 1 then
		m *= 10
		e -= 1
	end
	return { m = m, e = e }
end

function BigNum.new(n: number): Big
	return norm(n, 0)
end

function BigNum.fromParts(m: number, e: number): Big
	return norm(m, e)
end

BigNum.zero = table.freeze({ m = 0, e = 0 })

-- Accepts saved/remote data; returns nil if it is not a valid finite big number.
function BigNum.sanitize(v: any): Big?
	if type(v) == "number" then
		if v ~= v or math.abs(v) == math.huge then
			return nil
		end
		return norm(v, 0)
	end
	if type(v) ~= "table" or type(v.m) ~= "number" or type(v.e) ~= "number" then
		return nil
	end
	if v.m ~= v.m or math.abs(v.m) == math.huge or v.e ~= v.e or math.abs(v.e) == math.huge then
		return nil
	end
	return norm(v.m, math.floor(v.e))
end

function BigNum.copy(a: Big): Big
	return { m = a.m, e = a.e }
end

function BigNum.isZero(a: Big): boolean
	return a.m == 0
end

function BigNum.add(a: Big, b: Big): Big
	if a.m == 0 then
		return BigNum.copy(b)
	end
	if b.m == 0 then
		return BigNum.copy(a)
	end
	if a.e < b.e then
		a, b = b, a
	end
	local gap = a.e - b.e
	if gap > ZERO_EXP_GAP then
		return BigNum.copy(a)
	end
	return norm(a.m + b.m / 10 ^ gap, a.e)
end

function BigNum.neg(a: Big): Big
	return { m = -a.m, e = a.e }
end

function BigNum.sub(a: Big, b: Big): Big
	return BigNum.add(a, BigNum.neg(b))
end

function BigNum.mul(a: Big, b: Big): Big
	if a.m == 0 or b.m == 0 then
		return { m = 0, e = 0 }
	end
	return norm(a.m * b.m, a.e + b.e)
end

function BigNum.mulN(a: Big, n: number): Big
	return BigNum.mul(a, norm(n, 0))
end

function BigNum.div(a: Big, b: Big): Big
	if b.m == 0 then
		error("BigNum: divide by zero")
	end
	if a.m == 0 then
		return { m = 0, e = 0 }
	end
	return norm(a.m / b.m, a.e - b.e)
end

-- x^p for a plain number power (used for multiplier stacks like 42^evolutions).
function BigNum.powN(base: number, p: number): Big
	if base <= 0 then
		return p == 0 and norm(1, 0) or { m = 0, e = 0 }
	end
	local l = math.log10(base) * p
	local e = math.floor(l)
	return norm(10 ^ (l - e), e)
end

function BigNum.cmp(a: Big, b: Big): number
	local sa = a.m > 0 and 1 or (a.m < 0 and -1 or 0)
	local sb = b.m > 0 and 1 or (b.m < 0 and -1 or 0)
	if sa ~= sb then
		return sa < sb and -1 or 1
	end
	if sa == 0 then
		return 0
	end
	if a.e ~= b.e then
		local r = a.e < b.e and -1 or 1
		return sa > 0 and r or -r
	end
	if a.m == b.m then
		return 0
	end
	return a.m < b.m and -1 or 1
end

function BigNum.lt(a: Big, b: Big): boolean
	return BigNum.cmp(a, b) < 0
end
function BigNum.gte(a: Big, b: Big): boolean
	return BigNum.cmp(a, b) >= 0
end
function BigNum.eq(a: Big, b: Big): boolean
	return BigNum.cmp(a, b) == 0
end

function BigNum.max(a: Big, b: Big): Big
	return BigNum.cmp(a, b) >= 0 and a or b
end

-- Plain number (may be math.huge for very large values). For ratios and display only.
function BigNum.toNumber(a: Big): number
	if a.e > 308 then
		return a.m > 0 and math.huge or -math.huge
	end
	if a.e < -320 then
		return 0
	end
	return a.m * 10 ^ a.e
end

-- log10 as a plain number; -inf for zero. Safe for any exponent.
function BigNum.log10(a: Big): number
	if a.m <= 0 then
		return -math.huge
	end
	return a.e + math.log10(a.m)
end

function BigNum.floor(a: Big): Big
	if a.e >= 15 or a.m == 0 then
		return BigNum.copy(a)
	end
	if a.e < 0 then
		return { m = 0, e = 0 }
	end
	return norm(math.floor(a.m * 10 ^ a.e + 1e-9), 0)
end

-- Round to whole cents. Settled cash stays cent-exact while it is small.
function BigNum.roundCents(a: Big): Big
	if a.e >= 13 or a.m == 0 then
		return BigNum.copy(a)
	end
	local v = a.m * 10 ^ a.e
	return norm(math.floor(v * 100 + 0.5) / 100, 0)
end

-- Square root (used by placeholder investor award rule).
function BigNum.sqrt(a: Big): Big
	if a.m <= 0 then
		return { m = 0, e = 0 }
	end
	local l = BigNum.log10(a) / 2
	local e = math.floor(l)
	return norm(10 ^ (l - e), e)
end

return BigNum
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Dash</string>
            <string name="Source"><![CDATA[--!strict
-- DogDash the Game: four hot dogs race; the player bets on one and can press Cheer to push it.
-- Shape from secondary guides (four runners, bet, cheer); payout/timing are placeholders.
-- The server simulates the race; the client only animates the positions it is sent.
local BigNum = require("./BigNum")
local Economy = require("./Economy")
type Big = BigNum.Big

local Dash = {}
local C = Economy.Catalog.dash

export type Race = {
	pick: number,
	bet: Big,
	pos: { number }, -- 0..1 per runner
	speed: { number }, -- base speed per runner (track lengths per second)
	t: number,
	cheers: number,
	cheerWindow: number, -- cheers counted in the current second
	windowStart: number,
	winner: number?,
}

Dash.MAX_CHEERS_PER_SEC = 6

function Dash.betAmount(cash: Big, fractionIndex: number): Big?
	local f = C.betFractions.value[fractionIndex]
	if not f then
		return nil
	end
	return BigNum.roundCents(BigNum.mulN(cash, f))
end

function Dash.new(pick: number, bet: Big, rng: () -> number): Race?
	if pick < 1 or pick > C.runners.value or pick ~= math.floor(pick) then
		return nil
	end
	local base = 1 / C.raceSeconds.value
	local speed = {}
	local pos = {}
	for i = 1, C.runners.value do
		speed[i] = base * (0.9 + 0.2 * rng())
		pos[i] = 0
	end
	return { pick = pick, bet = bet, pos = pos, speed = speed, t = 0, cheers = 0, cheerWindow = 0, windowStart = 0, winner = nil }
end

-- Count a cheer if under the per-second cap. Returns whether it counted.
function Dash.cheer(r: Race): boolean
	if r.winner then
		return false
	end
	if r.t - r.windowStart >= 1 then
		r.windowStart = r.t
		r.cheerWindow = 0
	end
	if r.cheerWindow >= Dash.MAX_CHEERS_PER_SEC then
		return false
	end
	r.cheerWindow += 1
	r.cheers += 1
	return true
end

-- Advance the race. Each runner jitters a little; cheers add speed to the picked runner.
function Dash.step(r: Race, dt: number, rng: () -> number): number?
	if r.winner then
		return r.winner
	end
	r.t += dt
	local best, bestPos = nil, -1
	for i = 1, #r.pos do
		local s = r.speed[i] * (0.75 + 0.5 * rng())
		if i == r.pick then
			-- only the last second of cheering counts, so the boost is capped
			s += r.speed[i] * r.cheerWindow * C.cheerBoost.value
		end
		r.pos[i] = math.min(1, r.pos[i] + s * dt)
		if r.pos[i] > bestPos then
			best, bestPos = i, r.pos[i]
		end
	end
	if bestPos >= 1 then
		r.winner = best
	end
	return r.winner
end

-- Cash to pay back on a finished race (bet already deducted at start).
function Dash.payout(r: Race): Big
	if r.winner == r.pick then
		return BigNum.roundCents(BigNum.mulN(r.bet, C.winPays.value))
	end
	return BigNum.zero
end

return Dash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Economy rules built from the evidence catalog. Pure: no Roblox APIs, so the CLI tests run it.
-- Anything marked placeholder in the catalog stays a placeholder here; see docs/CATALOG.md.
local BigNum = require("./BigNum")
local Catalog = require("../Catalog")
type Big = BigNum.Big

export type PadDef = {
	id: string,
	name: string,
	bizId: string,
	kind: string, -- "unlock" | "cash" | "speed" | "auto" | "structure" | "minigame"
	cost: number,
	mult: number?,
	requires: string?, -- pad id
	order: number,
	model: string?,
	status: string,
}

export type BizDef = {
	id: string,
	name: string,
	product: string,
	index: number,
	unlockPad: string,
	baseOutput: number,
	cycleTime: number,
	pads: { PadDef }, -- upgrade pads, excludes the unlock pad
}

local Economy = {}

Economy.Catalog = Catalog
Economy.businesses = {} :: { BizDef }
Economy.bizById = {} :: { [string]: BizDef }
Economy.pads = {} :: { PadDef } -- every pad in plot order (unlock pads included)
Economy.padById = {} :: { [string]: PadDef }

local generic = Catalog.generic_business
local prestige = Catalog.prestige

do
	local order = 0
	local prevUnlock: string? = nil
	for i, b in Catalog.businesses do
		local unlockId = "biz:" .. b.id
		order += 1
		local unlockPad: PadDef = {
			id = unlockId,
			name = b.name,
			bizId = b.id,
			kind = "unlock",
			cost = b.unlock.value,
			requires = prevUnlock,
			order = order,
			model = nil,
			status = b.unlock.status,
		}
		table.insert(Economy.pads, unlockPad)
		Economy.padById[unlockId] = unlockPad
		prevUnlock = unlockId

		local def: BizDef = {
			id = b.id,
			name = b.name,
			product = b.product,
			index = i,
			unlockPad = unlockId,
			baseOutput = if b.baseOutput then b.baseOutput.value else b.unlock.value * generic.outputPerUnlockCost.value,
			cycleTime = if b.cycleTime then b.cycleTime.value else generic.cycleTime.value,
			pads = {},
		}
		for _, p in b.pads do
			order += 1
			local pad: PadDef = {
				id = b.id .. ":" .. p.id,
				name = p.name,
				bizId = b.id,
				kind = p.kind,
				cost = p.cost,
				mult = p.mult,
				requires = if p.requires then b.id .. ":" .. p.requires else unlockId,
				order = order,
				model = p.model,
				status = p.status,
			}
			table.insert(def.pads, pad)
			table.insert(Economy.pads, pad)
			Economy.padById[pad.id] = pad
		end
		table.insert(Economy.businesses, def)
		Economy.bizById[b.id] = def
	end
end

-- Stand-shaped output curve (level 1 = 1.0). Observed/derived for levels 1-4, placeholder after.
local shapeCache: { number } = {}
for _, o in Catalog.stand_level_shape.observed do
	shapeCache[o.level] = o.output
end
local INC_GROWTH = Catalog.stand_level_shape.extrapolate.incrementGrowth

function Economy.levelShape(level: number): number
	if level <= 0 then
		return 0
	end
	local cached = shapeCache[level]
	if cached then
		return cached
	end
	-- closed form of increments growing by INC_GROWTH beyond the last observed level
	local n = #shapeCache
	local lastInc = shapeCache[n] - shapeCache[n - 1]
	local k = level - n
	local sum = lastInc * INC_GROWTH * (INC_GROWTH ^ k - 1) / (INC_GROWTH - 1)
	return shapeCache[n] + sum
end

-- Base output per cycle at a level (before multipliers).
function Economy.baseOutput(biz: BizDef, level: number): number
	return biz.baseOutput * Economy.levelShape(level)
end

local standCosts: { number } = {}
for _, o in Catalog.level_costs_stand.observed do
	standCosts[o.index + 1] = o.cost
end
local COST_GROWTH = Catalog.level_costs_stand.extrapolate.growth

-- Cost of the next level when `bought` level upgrades are already owned (bought = level - 1).
-- Returned as a log10 to stay safe for very deep levels; use levelCost for a Big.
local function levelCostLog(biz: BizDef, bought: number): number
	if biz.id == "stand" then
		local c = standCosts[bought + 1]
		if c then
			return math.log10(c)
		end
		local n = #standCosts
		return math.log10(standCosts[n]) + (bought + 1 - n) * math.log10(COST_GROWTH)
	end
	local first = biz.baseOutput / generic.outputPerUnlockCost.value * generic.firstLevelCostPerUnlockCost.value
	return math.log10(first) + bought * math.log10(COST_GROWTH)
end

local function fromLog(l: number): Big
	local e = math.floor(l)
	return BigNum.fromParts(10 ^ (l - e), e)
end

function Economy.priceMult(ascensions: number): Big
	return BigNum.powN(prestige.ascensionPriceMult.value, ascensions)
end

function Economy.levelCost(biz: BizDef, bought: number, ascensions: number): Big
	return BigNum.roundCents(BigNum.mul(fromLog(levelCostLog(biz, bought)), Economy.priceMult(ascensions)))
end

-- Total cost of the next `count` levels.
function Economy.levelCostRange(biz: BizDef, bought: number, count: number, ascensions: number): Big
	local total = BigNum.zero
	for i = 0, count - 1 do
		total = BigNum.add(total, Economy.levelCost(biz, bought + i, ascensions))
	end
	return total
end

function Economy.padCost(pad: PadDef, ascensions: number): Big
	return BigNum.roundCents(BigNum.mul(BigNum.new(pad.cost), Economy.priceMult(ascensions)))
end

export type MultState = {
	pads: { [string]: boolean },
	forever: { [string]: boolean },
	investors: Big,
	evolutions: number,
	ascensions: number,
	speedUp: boolean,
}

function Economy.ownsPad(s: MultState, padId: string): boolean
	return s.pads[padId] == true or s.forever[padId] == true
end

function Economy.investorBonus(investors: Big): Big
	-- 1 + investors * bonusPerInvestor
	return BigNum.add(BigNum.new(1), BigNum.mulN(investors, prestige.cashBonusPerInvestor.value))
end

function Economy.cashMult(s: MultState, biz: BizDef): Big
	local m = 1
	for _, p in biz.pads do
		if p.kind == "cash" and Economy.ownsPad(s, p.id) then
			m *= p.mult or 1
		end
	end
	local big = BigNum.new(m)
	big = BigNum.mul(big, Economy.investorBonus(s.investors))
	big = BigNum.mul(big, BigNum.powN(prestige.ascensionCashMult.value, s.ascensions))
	return big
end

function Economy.speedMult(s: MultState, biz: BizDef): Big
	local m = 1
	for _, p in biz.pads do
		if p.kind == "speed" and Economy.ownsPad(s, p.id) then
			m *= p.mult or 1
		end
	end
	if s.speedUp then
		m *= 2
	end
	return BigNum.mul(BigNum.new(m), BigNum.powN(prestige.evolutionSpeedMult.value, s.evolutions))
end

function Economy.isAutomated(s: MultState, biz: BizDef): boolean
	for _, p in biz.pads do
		if p.kind == "auto" and Economy.ownsPad(s, p.id) then
			return true
		end
	end
	return false
end

-- Output of one completed cycle, rounded to cents while small.
function Economy.cycleOutput(s: MultState, biz: BizDef, level: number): Big
	return BigNum.roundCents(BigNum.mulN(Economy.cashMult(s, biz), Economy.baseOutput(biz, level)))
end

-- Cycles per second as a Big.
function Economy.cyclesPerSecond(s: MultState, biz: BizDef): Big
	return BigNum.mulN(Economy.speedMult(s, biz), 1 / biz.cycleTime)
end

-- Investors offered for a rebirth from lifetime cash this run (placeholder award rule).
function Economy.investorsOffered(lifetime: Big, doubled: boolean): Big
	local minCash = BigNum.new(prestige.rebirthMinCash.value)
	if BigNum.lt(lifetime, minCash) then
		return BigNum.zero
	end
	local n = BigNum.floor(BigNum.sqrt(BigNum.div(lifetime, minCash)))
	if doubled then
		n = BigNum.mulN(n, 2)
	end
	return n
end

function Economy.evolutionThreshold(evolutions: number): Big
	return BigNum.mul(BigNum.new(prestige.evolutionFirstInvestors.value), BigNum.powN(prestige.evolutionGrowth.value, evolutions))
end

function Economy.recipeName(evolutions: number): string
	local list = prestige.recipes.value
	local n = #list
	if evolutions < n then
		return list[evolutions + 1]
	end
	return list[n] .. "+" .. tostring(evolutions - n + 1)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Player-facing number text. Display only: never feed these strings back into arithmetic.
-- Style follows the reference HUD: "$3.24", "$4,772", "$296.102 trillion".
local BigNum = require("./BigNum")
type Big = BigNum.Big

local Format = {}

local UNITS = { "", "un", "duo", "tre", "quattuor", "quin", "sex", "septen", "octo", "novem" }
local SMALL = { "m", "b", "tr", "quadr", "quint", "sext", "sept", "oct", "non" }
local TENS = { "dec", "vigint", "trigint", "quadragint", "quinquagint", "sexagint", "septuagint", "octogint", "nonagint" }

-- Name of 10^(3n+3), n >= 1: 1 = million, 2 = billion, 10 = decillion, 26 = sexvigintillion.
function Format.illion(n: number): string?
	if n < 1 then
		return nil
	end
	if n < 10 then
		return SMALL[n] .. "illion"
	end
	if n == 100 then
		return "centillion"
	end
	if n > 100 then
		return nil
	end
	local u, t = n % 10, n // 10
	return UNITS[u + 1] .. TENS[t] .. "illion"
end

local function commas(int: number): string
	local s = string.format("%d", int)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local function trim(s: string): string
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	return s
end

-- Plain amount without a currency sign.
function Format.amount(v: Big | number, decimalsUnder1000: number?): string
	local a: Big = if type(v) == "number" then BigNum.new(v) else v
	if a.m < 0 then
		return "-" .. Format.amount(BigNum.neg(a), decimalsUnder1000)
	end
	if a.m == 0 then
		return decimalsUnder1000 == 0 and "0" or "0.00"
	end
	if a.e < 3 then
		local n = a.m * 10 ^ a.e
		local d = decimalsUnder1000 or 2
		local s = string.format("%." .. d .. "f", n)
		-- rounding can carry into the thousands
		if (tonumber(s) :: number) < 1000 then
			return s
		end
		return commas(1000)
	end
	if a.e < 6 then
		return commas(math.floor(a.m * 10 ^ a.e + 1e-6))
	end
	local group = a.e // 3 -- 2 = millions
	local name = Format.illion(group - 1)
	if not name then
		return trim(string.format("%.2f", a.m)) .. "e" .. tostring(a.e)
	end
	local lead = a.m * 10 ^ (a.e - group * 3)
	return trim(string.format("%.3f", lead)) .. " " .. name
end

function Format.cash(v: Big | number): string
	return "$" .. Format.amount(v)
end

-- Compact form for tight spots (buttons, pads): "$1.1M", "$296.1T", "$2.85e276".
local SHORT = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
function Format.short(v: Big | number): string
	local a: Big = if type(v) == "number" then BigNum.new(v) else v
	if a.m == 0 then
		return "$0"
	end
	if a.e < 3 then
		return Format.cash(a)
	end
	local group = a.e // 3
	local lead = a.m * 10 ^ (a.e - group * 3)
	local suffix = SHORT[group]
	if not suffix then
		return "$" .. trim(string.format("%.2f", a.m)) .. "e" .. tostring(a.e)
	end
	return "$" .. trim(string.format("%.2f", lead)) .. suffix
end

-- Seconds shown on the production bar: "1s", "0.8s", "12s", "3m 20s".
function Format.timer(sec: number): string
	if sec < 0 then
		sec = 0
	end
	if sec < 10 then
		local s = string.format("%.1f", sec)
		s = trim(s)
		return s .. "s"
	end
	if sec < 60 then
		return string.format("%ds", math.floor(sec))
	end
	if sec < 3600 then
		return string.format("%dm %ds", sec // 60, math.floor(sec % 60))
	end
	return string.format("%dh %dm", sec // 3600, math.floor(sec % 3600) // 60)
end

function Format.duration(sec: number): string
	sec = math.max(0, math.floor(sec))
	if sec < 60 then
		return sec .. " seconds"
	end
	local d, h, m = sec // 86400, (sec % 86400) // 3600, (sec % 3600) // 60
	local parts = {}
	if d > 0 then
		table.insert(parts, d .. "d")
	end
	if h > 0 then
		table.insert(parts, h .. "h")
	end
	if m > 0 and d == 0 then
		table.insert(parts, m .. "m")
	end
	return table.concat(parts, " ")
end

function Format.mult(n: number): string
	return "x" .. trim(string.format("%.2f", n))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[--!strict
-- Every server-side rule a player action can trigger, as pure functions over a Profile.
-- Services call these after validating who is asking; the client never computes grants.
-- Each action returns (ok, code, data?) where code is a short reason shown as a toast.
local BigNum = require("./BigNum")
local Economy = require("./Economy")
local Profile = require("./Profile")
type Big = BigNum.Big
type Profile = Profile.Profile

local Game = {}

local Catalog = Economy.Catalog
local POWERS: { [string]: any } = {}
for _, pw in Catalog.powers do
	POWERS[pw.id] = pw
end
Game.POWERS = POWERS

-- Above this many cycles per second a business is treated as continuous (no per-cycle events).
Game.CONTINUOUS_CPS = 1e6
-- Upper bound of levels bought by one Max request (keeps a request's work bounded).
Game.MAX_BULK = 1000

function Game.multState(p: Profile): Economy.MultState
	return {
		pads = p.pads,
		forever = p.forever,
		investors = p.investors,
		evolutions = p.evolutions,
		ascensions = p.ascensions,
		speedUp = p.robux.passes.speedUp == true,
	}
end

function Game.owns(p: Profile, padId: string): boolean
	return p.pads[padId] == true or p.forever[padId] == true
end

function Game.bizOwned(p: Profile, bizId: string): boolean
	return Game.owns(p, "biz:" .. bizId)
end

function Game.powerTier(p: Profile, id: string): number
	local def = POWERS[id]
	if not def then
		return 0
	end
	return math.min(def.tiers, (p.powers[id] or 0) + (p.robux.tiers[id] or 0))
end

-- Bulk sizes the Stack Upgrade tier allows ("max" only at the top tier; placeholder gate).
function Game.bulkOptions(p: Profile): { any }
	local opts: { any } = { 1 }
	local tier = Game.powerTier(p, "stack")
	for i = 1, tier do
		table.insert(opts, POWERS.stack.bulk[i])
	end
	if tier >= POWERS.stack.tiers then
		table.insert(opts, "max")
	end
	return opts
end

local function earn(p: Profile, amount: Big)
	if amount.m <= 0 then
		return
	end
	p.cash = BigNum.roundCents(BigNum.add(p.cash, amount))
	p.lifetime = BigNum.add(p.lifetime, amount)
	p.totalEarned = BigNum.add(p.totalEarned, amount)
end
Game.earn = earn

local function spend(p: Profile, cost: Big): boolean
	if BigNum.lt(p.cash, cost) then
		return false
	end
	p.cash = BigNum.roundCents(BigNum.sub(p.cash, cost))
	if p.cash.m < 0 then -- float dust
		p.cash = BigNum.zero
	end
	return true
end

-- Pad visibility: its prerequisite pad is owned (unlock pads chain business to business).
function Game.padVisible(p: Profile, pad: Economy.PadDef): boolean
	if pad.requires and not Game.owns(p, pad.requires) then
		return false
	end
	if pad.kind ~= "unlock" and not Game.bizOwned(p, pad.bizId) then
		return false
	end
	return true
end

function Game.padCost(p: Profile, pad: Economy.PadDef): Big
	return Economy.padCost(pad, p.ascensions)
end

function Game.buyPad(p: Profile, padId: string): (boolean, string)
	local pad = Economy.padById[padId]
	if not pad then
		return false, "Unknown purchase"
	end
	if Game.owns(p, padId) then
		return false, "Already owned"
	end
	if not Game.padVisible(p, pad) then
		return false, "Locked"
	end
	if not spend(p, Game.padCost(p, pad)) then
		return false, "Not enough cash"
	end
	p.pads[padId] = true
	if pad.kind == "unlock" then
		local st = p.biz[pad.bizId]
		st.level, st.progress, st.running = 1, 0, false
	end
	return true, "Bought " .. pad.name
end

-- Cheapest visible pad the player does not own (Remote Buy target / guidance arrow).
function Game.nextPad(p: Profile): Economy.PadDef?
	local best: Economy.PadDef? = nil
	local bestCost: Big? = nil
	for _, pad in Economy.pads do
		if not Game.owns(p, pad.id) and Game.padVisible(p, pad) then
			local c = Game.padCost(p, pad)
			if not bestCost or BigNum.lt(c, bestCost) then
				best, bestCost = pad, c
			end
		end
	end
	return best
end

function Game.levelCost(p: Profile, bizId: string, count: number): Big
	local biz = Economy.bizById[bizId]
	local st = p.biz[bizId]
	return Economy.levelCostRange(biz, st.level - 1, count, p.ascensions)
end

-- How many levels "max" would buy right now (bounded by MAX_BULK).
function Game.maxAffordable(p: Profile, bizId: string): (number, Big)
	local biz = Economy.bizById[bizId]
	local st = p.biz[bizId]
	local total = BigNum.zero
	local n = 0
	while n < Game.MAX_BULK do
		local c = Economy.levelCost(biz, st.level - 1 + n, p.ascensions)
		local nt = BigNum.add(total, c)
		if BigNum.lt(p.cash, nt) then
			break
		end
		total = nt
		n += 1
	end
	return n, total
end

-- Buy level upgrades. `count` must be one of bulkOptions; xN buys all N or nothing.
function Game.upgradeLevel(p: Profile, bizId: string, count: any): (boolean, string, number?)
	local biz = Economy.bizById[bizId]
	if not biz then
		return false, "Unknown business"
	end
	if not Game.bizOwned(p, bizId) then
		return false, "Locked"
	end
	local allowed = false
	for _, o in Game.bulkOptions(p) do
		if o == count then
			allowed = true
		end
	end
	if not allowed then
		return false, "Bulk size locked"
	end
	local st = p.biz[bizId]
	local n: number, cost: Big
	if count == "max" then
		n, cost = Game.maxAffordable(p, bizId)
		if n == 0 then
			return false, "Not enough cash"
		end
	else
		n = count
		cost = Game.levelCost(p, bizId, n)
	end
	if not spend(p, cost) then
		return false, "Not enough cash"
	end
	st.level += n
	return true, "Upgraded", n
end

-- Manual production: start one cycle (the CLICK control). Automated businesses run themselves.
function Game.click(p: Profile, bizId: string): (boolean, string)
	local biz = Economy.bizById[bizId]
	if not biz or not Game.bizOwned(p, bizId) then
		return false, "Locked"
	end
	local st = p.biz[bizId]
	if Economy.isAutomated(Game.multState(p), biz) then
		return false, "Already automatic"
	end
	if st.running then
		return false, "Busy"
	end
	st.running = true
	st.progress = 0
	p.stats.clicks = (p.stats.clicks or 0) + 1
	return true, "Started"
end

export type Grant = { bizId: string, amount: Big, cycles: number }

-- Advance production by dt seconds. Returns one aggregated grant per business that paid out.
function Game.step(p: Profile, dt: number): { Grant }
	local grants: { Grant } = {}
	if dt <= 0 then
		return grants
	end
	local ms = Game.multState(p)
	for _, biz in Economy.businesses do
		local st = p.biz[biz.id]
		if st.level < 1 or not Game.bizOwned(p, biz.id) then
			continue
		end
		local auto = Economy.isAutomated(ms, biz)
		if not auto and not st.running then
			continue
		end
		local cpsBig = Economy.cyclesPerSecond(ms, biz)
		local out = Economy.cycleOutput(ms, biz, st.level)
		if auto and BigNum.toNumber(cpsBig) > Game.CONTINUOUS_CPS then
			-- continuous: income rate x dt, no per-cycle accounting
			local amount = BigNum.mulN(BigNum.mul(out, cpsBig), dt)
			earn(p, amount)
			st.progress, st.running = 0, true
			table.insert(grants, { bizId = biz.id, amount = amount, cycles = -1 })
			continue
		end
		local cps = BigNum.toNumber(cpsBig)
		st.progress += dt * cps
		if auto then
			st.running = true
			local n = math.floor(st.progress)
			if n >= 1 then
				st.progress -= n
				local amount = BigNum.mulN(out, n)
				earn(p, amount)
				table.insert(grants, { bizId = biz.id, amount = amount, cycles = n })
			end
		elseif st.progress >= 1 then
			st.progress, st.running = 0, false
			earn(p, out)
			table.insert(grants, { bizId = biz.id, amount = out, cycles = 1 })
		end
	end
	return grants
end

-- Income per second of one business if it ran continuously.
function Game.bizRate(p: Profile, bizId: string): Big
	local biz = Economy.bizById[bizId]
	local st = p.biz[bizId]
	if st.level < 1 or not Game.bizOwned(p, bizId) then
		return BigNum.zero
	end
	local ms = Game.multState(p)
	return BigNum.mul(Economy.cycleOutput(ms, biz, st.level), Economy.cyclesPerSecond(ms, biz))
end

-- Total income per second. autoOnly = only automated businesses (offline income).
function Game.incomeRate(p: Profile, autoOnly: boolean): Big
	local ms = Game.multState(p)
	local total = BigNum.zero
	for _, biz in Economy.businesses do
		if not autoOnly or Economy.isAutomated(ms, biz) then
			total = BigNum.add(total, Game.bizRate(p, biz.id))
		end
	end
	return total
end

-- Offline earnings for `elapsed` seconds away. 100% of automated income, no cap (none evidenced).
function Game.offlineEarnings(p: Profile, elapsed: number): Big
	if elapsed <= 0 or elapsed ~= elapsed then
		return BigNum.zero
	end
	local rate = Catalog.offline.rate.value
	return BigNum.roundCents(BigNum.mulN(Game.incomeRate(p, true), elapsed * rate))
end

-- Called when a returning player's profile loads: bank offline income for the claim popup.
function Game.applyReturn(p: Profile, now: number): Big
	local elapsed = now - p.lastSeen
	local amount = Game.offlineEarnings(p, elapsed)
	p.pendingOffline = BigNum.add(p.pendingOffline, amount)
	p.lastSeen = now
	return amount
end

function Game.claimOffline(p: Profile): (boolean, string, Big?)
	local a = p.pendingOffline
	if a.m <= 0 then
		return false, "Nothing to collect"
	end
	p.pendingOffline = BigNum.zero
	earn(p, a)
	return true, "Collected", a
end

-- Ingredient crate / money bag pickup value (placeholder rule; see catalog pickups).
function Game.pickupValue(p: Profile): Big
	local secs = Catalog.pickups.valueSeconds.value
	local v = BigNum.mulN(Game.incomeRate(p, false), secs)
	local tier = Game.powerTier(p, "expertPicker")
	if tier > 0 then
		v = BigNum.mulN(v, POWERS.expertPicker.pickupMult[tier])
	end
	return BigNum.roundCents(BigNum.max(v, BigNum.new(1)))
end

-- mult: 2 for money bags (placeholder), 1 for crates.
function Game.collectPickup(p: Profile, mult: number?): Big
	local v = BigNum.mulN(Game.pickupValue(p), mult or 1)
	earn(p, v)
	p.stats.pickups = (p.stats.pickups or 0) + 1
	return v
end

-- Powers bought with investors (spent investors reduce the cash bonus).
function Game.powerCost(p: Profile, id: string): Big?
	local def = POWERS[id]
	if not def then
		return nil
	end
	local owned = p.powers[id] or 0
	if Game.powerTier(p, id) >= def.tiers or owned >= def.tiers then
		return nil
	end
	return BigNum.new(def.investorCost[owned + 1])
end

function Game.buyPower(p: Profile, id: string): (boolean, string)
	local cost = Game.powerCost(p, id)
	if not cost then
		return false, POWERS[id] and "Max level" or "Unknown power"
	end
	if BigNum.lt(p.investors, cost) then
		return false, "Not enough investors"
	end
	p.investors = BigNum.sub(p.investors, cost)
	p.powers[id] = (p.powers[id] or 0) + 1
	return true, POWERS[id].name .. " unlocked"
end

---------------------------------------------------------------------------
-- Prestige and resets
---------------------------------------------------------------------------

function Game.investorsOffered(p: Profile): Big
	return Economy.investorsOffered(p.lifetime, p.robux.passes.x2investors == true)
end

-- Wipe the run: cash, businesses, pads. Forever pads (and any business they need) survive.
local function resetRun(p: Profile)
	p.cash = BigNum.new(Catalog.start.cash.value)
	p.lifetime = BigNum.zero
	p.pads = {}
	p.biz = Profile.freshBiz()
	for padId in p.forever do
		local pad = Economy.padById[padId]
		if pad and pad.kind == "unlock" then
			p.biz[pad.bizId].level = 1
		end
	end
end
Game._resetRun = resetRun

function Game.rebirth(p: Profile): (boolean, string, Big?)
	local award = Game.investorsOffered(p)
	if BigNum.lt(award, BigNum.new(1)) then
		return false, "No investors yet"
	end
	resetRun(p)
	p.investors = BigNum.add(p.investors, award)
	p.stats.rebirths = (p.stats.rebirths or 0) + 1
	return true, "Rebirthed", award
end

-- Rebirth Without Reset (Robux credit): take the offered investors and keep everything.
function Game.rebirthNoReset(p: Profile): (boolean, string, Big?)
	if p.robux.rebirthCredits < 1 then
		return false, "No credits"
	end
	local award = Game.investorsOffered(p)
	if BigNum.lt(award, BigNum.new(1)) then
		return false, "No investors yet"
	end
	p.robux.rebirthCredits -= 1
	p.investors = BigNum.add(p.investors, award)
	p.lifetime = BigNum.zero -- the same run cannot be cashed in twice
	return true, "Investors joined", award
end

function Game.evolutionProgress(p: Profile): number
	local need = Economy.evolutionThreshold(p.evolutions)
	return math.clamp(BigNum.toNumber(BigNum.div(p.investors, need)), 0, 1)
end

function Game.evolve(p: Profile): (boolean, string)
	if BigNum.lt(p.investors, Economy.evolutionThreshold(p.evolutions)) then
		return false, "Not enough investors"
	end
	resetRun(p)
	p.investors = BigNum.zero
	p.powers = {} -- investor-bought powers reset; Robux tiers are kept
	p.evolutions += 1
	return true, "Evolved to " .. Economy.recipeName(p.evolutions)
end

function Game.canAscend(p: Profile): (boolean, number, number)
	local owned, total = 0, 0
	for _, pad in Economy.pads do
		total += 1
		if Game.owns(p, pad.id) then
			owned += 1
		end
	end
	return owned == total, owned, total
end

function Game.ascend(p: Profile): (boolean, string)
	if not (Game.canAscend(p)) then
		return false, "Buy everything first"
	end
	resetRun(p)
	p.investors = BigNum.zero
	p.powers = {}
	p.evolutions = 0
	p.ascensions += 1
	p.foreverTokens += Catalog.prestige.ascensionForeverTokens.value
	return true, "Ascended"
end

---------------------------------------------------------------------------
-- Forever Purchase: pick a pad that stays owned through every reset.
---------------------------------------------------------------------------

function Game.foreverEligible(p: Profile, padId: string): boolean
	local pad = Economy.padById[padId]
	return pad ~= nil and pad.kind ~= "unlock" and not p.forever[padId]
end

-- Consumes exactly one token, only on a valid confirmed target.
function Game.useForever(p: Profile, padId: string): (boolean, string)
	if p.foreverTokens < 1 then
		return false, "No Forever Purchases left"
	end
	if not Game.foreverEligible(p, padId) then
		return false, "Can't pick that"
	end
	p.foreverTokens -= 1
	p.forever[padId] = true
	p.pads[padId] = nil -- now covered by forever
	return true, Economy.padById[padId].name .. " is yours forever"
end

---------------------------------------------------------------------------
-- Robux grants (called from the receipt handler, after the PurchaseId check)
---------------------------------------------------------------------------

function Game.hasReceipt(p: Profile, purchaseId: string): boolean
	return table.find(p.robux.receipts, purchaseId) ~= nil
end

local function remember(p: Profile, purchaseId: string)
	table.insert(p.robux.receipts, purchaseId)
	while #p.robux.receipts > Profile.MAX_RECEIPTS do
		table.remove(p.robux.receipts, 1)
	end
end

local function grantSkip(p: Profile, seconds: number): Big
	local rate = Game.incomeRate(p, false)
	if rate.m <= 0 then
		p.robux.skipSeconds += seconds
		return BigNum.zero
	end
	local amount = BigNum.roundCents(BigNum.mulN(rate, seconds))
	earn(p, amount)
	return amount
end

-- Pay out banked time-skip seconds once the player has income.
function Game.flushSkips(p: Profile): Big?
	if p.robux.skipSeconds > 0 and Game.incomeRate(p, false).m > 0 then
		local s = p.robux.skipSeconds
		p.robux.skipSeconds = 0
		return grantSkip(p, s)
	end
	return nil
end

local POWER_PRODUCTS = { expertPicker = true, manage = true, runFaster = true, stack = true, remoteBuy = true }
local SKIPS = { cash1h = 3600, cash24h = 86400, cash7d = 604800 }

-- Returns ok, message. ok=false means "do not record the receipt" (e.g. unknown product).
function Game.grantProduct(p: Profile, productKey: string, purchaseId: string): (boolean, string)
	if Game.hasReceipt(p, purchaseId) then
		return true, "Already granted" -- duplicate delivery: no second grant
	end
	if POWER_PRODUCTS[productKey] then
		local def = POWERS[productKey]
		p.robux.tiers[productKey] = math.min(def.tiers, (p.robux.tiers[productKey] or 0) + 1)
	elseif productKey == "speedUp" or productKey == "x2investors" then
		p.robux.passes[productKey] = true
	elseif productKey == "forever" then
		p.foreverTokens += 1
	elseif productKey == "rebirthNoReset" then
		p.robux.rebirthCredits += 1
	elseif SKIPS[productKey] then
		grantSkip(p, SKIPS[productKey])
	else
		return false, "Unknown product"
	end
	remember(p, purchaseId)
	return true, "Thanks for your purchase!"
end

-- Products that are one-time permanent unlocks and therefore "owned" once bought.
function Game.productOwned(p: Profile, productKey: string): boolean
	if productKey == "speedUp" or productKey == "x2investors" then
		return p.robux.passes[productKey] == true
	end
	local def = POWERS[productKey]
	if def then
		return (p.robux.tiers[productKey] or 0) >= def.tiers
	end
	return false
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Names</string>
            <string name="Source"><![CDATA[--!strict
-- Business name rules checked before Roblox text filtering (the server also filters with
-- TextService and fails closed if filtering errors).
local Economy = require("./Economy")

local Names = {}
local C = Economy.Catalog.names

Names.MAX = C.maxLength.value
Names.MIN = C.minLength.value

-- Returns the cleaned name, or nil and a player-facing reason.
function Names.clean(raw: any): (string?, string?)
	if type(raw) ~= "string" then
		return nil, "Type a name"
	end
	if #raw > 200 then
		return nil, "That name is too long"
	end
	-- letters, digits, spaces and a little punctuation; collapse runs of spaces
	local s = raw:gsub("[%c]", ""):gsub("%s+", " "):gsub("^ ", ""):gsub(" $", "")
	if s:find("[^%w '&%-%.!]") then
		return nil, "Use letters, numbers and ' & - . ! only"
	end
	if utf8.len(s) == nil then
		return nil, "That name has odd characters"
	end
	local n = #s
	if n < Names.MIN then
		return nil, "At least " .. Names.MIN .. " characters"
	end
	if n > Names.MAX then
		return nil, "At most " .. Names.MAX .. " characters"
	end
	return s, nil
end

function Names.default(displayName: string): string
	local base = displayName:sub(1, Names.MAX - 12)
	return base .. "'s Hot Dogs"
end

return Names
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Phone</string>
            <string name="Source"><![CDATA[--!strict
-- Phone offers: a buyer texts a cash offer; the player can Accept, Raise or Decline.
-- Raising can bring a better offer, a final offer, or the buyer walking away.
-- All odds/amounts are catalog placeholders (the reference's rules are unknown).
local BigNum = require("./BigNum")
local Economy = require("./Economy")
type Big = BigNum.Big

local Phone = {}
local C = Economy.Catalog.phone

export type Offer = {
	id: number,
	buyer: string,
	amount: Big,
	round: number,
	final: boolean,
	expires: number,
	state: string, -- "open" | "accepted" | "declined" | "walked" | "expired"
}

Phone.BUYERS = {
	"Big Sal from the Ballpark",
	"Mayor Mustard",
	"Coach Relish",
	"Food Truck Fran",
	"Ziggy (from space)",
	"Grandma Bun",
	"Captain Ketchup",
}

-- rng(): number in [0, 1)
function Phone.newOffer(id: number, incomeRate: Big, now: number, rng: () -> number): Offer?
	if incomeRate.m <= 0 then
		return nil
	end
	local lo, hi = C.offerSeconds.value[1], C.offerSeconds.value[2]
	local secs = lo + (hi - lo) * rng()
	local amount = BigNum.roundCents(BigNum.max(BigNum.mulN(incomeRate, secs), BigNum.new(1)))
	return {
		id = id,
		buyer = Phone.BUYERS[1 + math.floor(rng() * #Phone.BUYERS) % #Phone.BUYERS],
		amount = amount,
		round = 1,
		final = false,
		expires = now + C.expires.value,
		state = "open",
	}
end

-- action: "accept" | "raise" | "decline". Returns outcome and (for accept) the cash to grant.
function Phone.respond(o: Offer, action: string, now: number, rng: () -> number): (string, Big?)
	if o.state ~= "open" then
		return "closed", nil
	end
	if now > o.expires then
		o.state = "expired"
		return "expired", nil
	end
	if action == "accept" then
		o.state = "accepted"
		return "accepted", o.amount
	elseif action == "decline" then
		o.state = "declined"
		return "declined", nil
	elseif action == "raise" then
		if o.final then
			o.state = "walked" -- pushing past a final offer ends the deal
			return "walked", nil
		end
		local odds = C.raiseOdds.value
		local r = rng()
		if r < odds.walk then
			o.state = "walked"
			return "walked", nil
		end
		o.amount = BigNum.roundCents(BigNum.mulN(o.amount, C.raiseStep.value))
		o.round += 1
		o.expires = now + C.expires.value
		if r < odds.walk + odds.final then
			o.final = true
			return "final", nil
		end
		return "better", nil
	end
	return "invalid", nil
end

return Phone
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
-- Versioned save data: creation, validation and migration. Pure.
-- A profile that fails validation is never "repaired" into an empty one silently: migrate()
-- returns nil plus a reason, and the caller must not save over the stored data.
local BigNum = require("./BigNum")
local Economy = require("./Economy")
type Big = BigNum.Big

export type BizState = { level: number, progress: number, running: boolean }

export type Profile = {
	v: number,
	cash: Big,
	lifetime: Big, -- earned since the last rebirth (drives investors offered)
	totalEarned: Big,
	biz: { [string]: BizState },
	pads: { [string]: boolean },
	forever: { [string]: boolean },
	foreverTokens: number,
	investors: Big,
	evolutions: number,
	ascensions: number,
	powers: { [string]: number }, -- bought with investors (reset by evolution)
	robux: {
		passes: { [string]: boolean },
		tiers: { [string]: number }, -- permanent power tiers from Robux
		receipts: { string }, -- recent PurchaseIds (idempotency)
		rebirthCredits: number,
		skipSeconds: number, -- time-skip seconds waiting for income to exist
	},
	name: string?,
	lastSeen: number,
	pendingOffline: Big,
	stats: { [string]: number },
}

local Profile = {}

Profile.VERSION = 2
Profile.MAX_RECEIPTS = 200

local function freshBiz(): { [string]: BizState }
	local t = {}
	for _, b in Economy.businesses do
		t[b.id] = { level = 0, progress = 0, running = false }
	end
	return t
end

function Profile.new(now: number): Profile
	return {
		v = Profile.VERSION,
		cash = BigNum.new(Economy.Catalog.start.cash.value),
		lifetime = BigNum.zero,
		totalEarned = BigNum.zero,
		biz = freshBiz(),
		pads = {},
		forever = {},
		foreverTokens = 0,
		investors = BigNum.zero,
		evolutions = 0,
		ascensions = 0,
		powers = {},
		robux = { passes = {}, tiers = {}, receipts = {}, rebirthCredits = 0, skipSeconds = 0 },
		name = nil,
		lastSeen = now,
		pendingOffline = BigNum.zero,
		stats = { rebirths = 0, clicks = 0, pickups = 0, deals = 0, races = 0 },
	}
end

Profile.freshBiz = freshBiz

local function int(v: any, lo: number, hi: number): number?
	if type(v) ~= "number" or v ~= v then
		return nil
	end
	return math.clamp(math.floor(v), lo, hi)
end

local function big(v: any): Big?
	local b = BigNum.sanitize(v)
	if b and b.m < 0 then
		return nil
	end
	return b
end

local function padSet(v: any): { [string]: boolean }
	local out = {}
	if type(v) == "table" then
		for k, on in v do
			if type(k) == "string" and on == true and Economy.padById[k] then
				out[k] = true
			end
		end
	end
	return out
end

-- Version 1 stored cash as a plain number and had no forever tokens.
local MIGRATIONS: { [number]: (any) -> any } = {
	[1] = function(d)
		d.v = 2
		if type(d.cash) == "number" then
			d.cash = BigNum.new(d.cash)
		end
		d.foreverTokens = d.foreverTokens or 0
		return d
	end,
}

-- Returns a validated profile, or nil + reason. `raw` may be any decoded DataStore value.
function Profile.migrate(raw: any, now: number): (Profile?, string?)
	if raw == nil then
		return Profile.new(now), "new"
	end
	if type(raw) ~= "table" or type(raw.v) ~= "number" then
		return nil, "unrecognised save format"
	end
	if raw.v > Profile.VERSION then
		return nil, "save is from a newer game version"
	end
	local d = raw
	while d.v < Profile.VERSION do
		local step = MIGRATIONS[d.v]
		if not step then
			return nil, "no migration from version " .. tostring(d.v)
		end
		d = step(d)
	end

	local p = Profile.new(now)
	local cash = big(d.cash)
	if not cash then
		return nil, "cash is invalid"
	end
	p.cash = cash
	p.lifetime = big(d.lifetime) or BigNum.zero
	p.totalEarned = big(d.totalEarned) or BigNum.zero
	p.investors = big(d.investors) or BigNum.zero
	p.pendingOffline = big(d.pendingOffline) or BigNum.zero
	p.pads = padSet(d.pads)
	p.forever = padSet(d.forever)
	p.foreverTokens = int(d.foreverTokens, 0, 1e6) or 0
	p.evolutions = int(d.evolutions, 0, 1e6) or 0
	p.ascensions = int(d.ascensions, 0, 1e6) or 0
	p.lastSeen = if type(d.lastSeen) == "number" and d.lastSeen == d.lastSeen then d.lastSeen else now
	if type(d.name) == "string" and #d.name <= 64 then
		p.name = d.name
	end

	if type(d.biz) == "table" then
		for id, st in p.biz do
			local s = d.biz[id]
			if type(s) == "table" then
				st.level = int(s.level, 0, 1e7) or 0
				st.progress = if type(s.progress) == "number" and s.progress == s.progress then math.clamp(s.progress, 0, 1) else 0
				st.running = s.running == true
			end
			-- a business level without its unlock pad is inconsistent: trust the pad
			if not (p.pads["biz:" .. id] or p.forever["biz:" .. id]) then
				st.level, st.progress, st.running = 0, 0, false
			elseif st.level < 1 then
				st.level = 1
			end
		end
	end

	if type(d.powers) == "table" then
		for _, pw in Economy.Catalog.powers do
			p.powers[pw.id] = int(d.powers[pw.id], 0, pw.tiers) or nil :: any
		end
	end
	local r = d.robux
	if type(r) == "table" then
		if type(r.passes) == "table" then
			for k, v in r.passes do
				if type(k) == "string" and v == true then
					p.robux.passes[k] = true
				end
			end
		end
		if type(r.tiers) == "table" then
			for _, pw in Economy.Catalog.powers do
				p.robux.tiers[pw.id] = int(r.tiers[pw.id], 0, pw.tiers) or nil :: any
			end
		end
		if type(r.receipts) == "table" then
			for _, id in r.receipts do
				if type(id) == "string" then
					table.insert(p.robux.receipts, id)
				end
			end
		end
		p.robux.rebirthCredits = int(r.rebirthCredits, 0, 1e6) or 0
		p.robux.skipSeconds = if type(r.skipSeconds) == "number" and r.skipSeconds == r.skipSeconds then math.max(0, r.skipSeconds) else 0
	end
	if type(d.stats) == "table" then
		for k, v in d.stats do
			if type(k) == "string" and type(v) == "number" and v == v then
				p.stats[k] = v
			end
		end
	end
	return p, nil
end

-- Deep copy into plain tables (for saving / sending).
function Profile.serialize(p: Profile): any
	local function copy(v: any): any
		if type(v) ~= "table" then
			return v
		end
		local t = {}
		for k, x in v do
			t[k] = copy(x)
		end
		return t
	end
	return copy(p)
end

return Profile
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote names in one place. The server creates them; clients wait for them.
--   Action   (client -> server)  Action:FireServer(name, ...)
--   State    (server -> owner)   full snapshot of the player's own game state
--   Notify   (server -> owner)   toasts, effects, phone and race updates: (kind, data)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local NAMES = { "Action", "State", "Notify" }

local folder: Folder
if RunService:IsServer() then
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
	end
	folder = f :: Folder
	for _, n in NAMES do
		if not folder:FindFirstChild(n) then
			local r = Instance.new("RemoteEvent")
			r.Name = n
			r.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.get(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--!strict
-- The new game's own Robux products. IDs are nil until Carter creates them on the Creator
-- Dashboard for the published Sell Hot Dogs experience (docs/LIVE_SETUP.md). Never reuse the
-- reference game's IDs. Live prices come from MarketplaceService:GetProductInfo at runtime.
-- key = Game.grantProduct key; kind "pass" = Game Pass (one-time), "product" = Developer Product.
export type Product = { key: string, kind: string, id: number?, icon: string, blurb: string }

local Products: { Product } = {
	{ key = "speedUp", kind = "pass", id = nil, icon = "⏩", blurb = "Every business runs x2 faster, forever." },
	{ key = "x2investors", kind = "pass", id = nil, icon = "👽", blurb = "Twice the Alien Investors every rebirth." },
	{ key = "manage", kind = "pass", id = nil, icon = "📋", blurb = "Manage every business from one menu." },
	{ key = "remoteBuy", kind = "pass", id = nil, icon = "📡", blurb = "Buy the next upgrade from anywhere." },
	{ key = "expertPicker", kind = "product", id = nil, icon = "🧺", blurb = "Permanent Expert Collector level." },
	{ key = "runFaster", kind = "product", id = nil, icon = "👟", blurb = "Permanent Run Faster level." },
	{ key = "stack", kind = "product", id = nil, icon = "📚", blurb = "Permanent Stack Upgrade level." },
	{ key = "forever", kind = "product", id = nil, icon = "♾️", blurb = "Pick one upgrade to keep through every reset." },
	{ key = "rebirthNoReset", kind = "product", id = nil, icon = "🛸", blurb = "Collect your investors without resetting." },
	{ key = "cash1h", kind = "product", id = nil, icon = "💵", blurb = "1 hour of profit instantly." },
	{ key = "cash24h", kind = "product", id = nil, icon = "💰", blurb = "24 hours of profit instantly." },
	{ key = "cash7d", kind = "product", id = nil, icon = "🏦", blurb = "7 days of profit instantly." },
}

local byKey: { [string]: Product } = {}
for _, p in Products do
	byKey[p.key] = p
end

return {
	list = Products,
	byKey = byKey,
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="18">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Sell Hot Dogs server entry. Init order matters: World before GameService (plots exist),
-- GameService before Extras (Extras registers actions on it), Data last (starts loading players).
local Services = script.Parent:WaitForChild("Services")

local World = require(Services.World)
local GameService = require(Services.GameService)
local Extras = require(Services.Extras)
local Data = require(Services.Data)

game:GetService("Players").CharacterAutoLoads = true
World.init()
GameService.init()
Extras.init()
Data.init()
print("[SellHotDogs] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player sessions: load, autosave, save on leave/shutdown.
-- A failed load never creates a profile that could overwrite the stored save: the player gets
-- a temporary profile with saving disabled and is told so.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Config = require(Shared.Config)
local Profile = require(Shared.Logic.Profile)
local Game = require(Shared.Logic.Game)
local Store = require("./Store")

export type Session = {
	player: Player,
	profile: Profile.Profile,
	canSave: boolean,
	dirty: boolean,
	saving: boolean,
	lastSave: number,
	offlineFound: any?,
	-- runtime (not saved)
	rt: { [string]: any },
}

local Data = {}
Data.sessions = {} :: { [number]: Session } -- keyed by UserId
local loadedSignal = Instance.new("BindableEvent")
Data.Loaded = loadedSignal.Event
local leavingSignal = Instance.new("BindableEvent")
Data.Leaving = leavingSignal.Event

local function now(): number
	return os.time()
end

function Data.get(player: Player): Session?
	return Data.sessions[player.UserId]
end

function Data.save(s: Session, release: boolean): boolean
	if not s.canSave then
		return false
	end
	if s.saving then
		-- one save at a time; wait for the running one
		while s.saving do
			task.wait()
		end
	end
	s.saving = true
	s.profile.lastSeen = now()
	local ok = Store.save(s.player.UserId, Profile.serialize(s.profile), release)
	s.saving = false
	if ok then
		s.dirty = false
		s.lastSave = os.clock()
	end
	return ok
end

local function onJoin(player: Player)
	local ok, raw = Store.load(player.UserId)
	if not player.Parent then
		return
	end
	local session: Session
	if not ok then
		warn("[Data] could not load", player.Name, "- playing without saving")
		session = { player = player, profile = Profile.new(now()), canSave = false, dirty = false, saving = false, lastSave = 0, rt = { loadError = "Your save couldn't be loaded, so progress this visit won't be saved. Rejoin to try again." } }
	else
		local profile, why = Profile.migrate(raw, now())
		if not profile then
			warn("[Data] save for", player.Name, "rejected:", why)
			session = { player = player, profile = Profile.new(now()), canSave = false, dirty = false, saving = false, lastSave = 0, rt = { loadError = "Your save couldn't be read (" .. tostring(why) .. "). Progress this visit won't be saved." } }
		else
			session = { player = player, profile = profile, canSave = true, dirty = false, saving = false, lastSave = os.clock(), rt = {} }
			if why ~= "new" then
				session.offlineFound = Game.applyReturn(profile, now())
				Game.flushSkips(profile)
			end
		end
	end
	Data.sessions[player.UserId] = session
	loadedSignal:Fire(session)
end

local function onLeave(player: Player)
	local s = Data.sessions[player.UserId]
	if not s then
		return
	end
	leavingSignal:Fire(s)
	Data.save(s, true)
	Data.sessions[player.UserId] = nil
end

function Data.init()
	Store.init()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	task.spawn(function()
		while true do
			task.wait(5)
			for _, s in Data.sessions do
				if s.canSave and os.clock() - s.lastSave >= Config.AutosaveSeconds then
					task.spawn(Data.save, s, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for _, s in Data.sessions do
			pending += 1
			task.spawn(function()
				Data.save(s, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Extras</string>
            <string name="Source"><![CDATA[--!strict
-- Side systems: ingredient pickups, phone offers, DogDash races, business names, Robux shop.
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Config = require(Shared.Config)
local Dash = require(Shared.Logic.Dash)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Game = require(Shared.Logic.Game)
local Layout = require(Shared.Layout)
local Names = require(Shared.Logic.Names)
local Phone = require(Shared.Logic.Phone)
local Products = require(Shared.Products)
local Data = require("./Data")
local GameService = require("./GameService")
local Models = require("./Models")
local World = require("./World")

local Extras = {}
local Cat = Economy.Catalog
local rng = Random.new()
local function roll(): number
	return rng:NextNumber()
end

---------------------------------------------------------------------------
-- Ingredient pickups: crates appear at the owner's racks; only the owner collects them.
---------------------------------------------------------------------------
local function spawnPickups()
	local cap = Cat.pickups.rackCapacity.value
	while true do
		task.wait(Cat.pickups.spawnEvery.value)
		for _, plot in World.plots do
			local owner = plot.owner
			local s = owner and Data.get(owner)
			if not s or not Game.bizOwned(s.profile, "stand") then
				continue
			end
			local folder = plot.folder:FindFirstChild("Pickups") :: Folder?
			if not folder then
				local f = Instance.new("Folder")
				f.Name = "Pickups"
				f.Parent = plot.folder
				folder = f
			end
			local f = folder :: Folder
			if #f:GetChildren() >= cap then
				continue
			end
			local rack = Layout.racks[rng:NextInteger(1, #Layout.racks)]
			local off = Vector3.new(rng:NextNumber(-3, 3), 0, if rack.X > 0 then -5 else 5)
			local bag = rng:NextNumber() < 0.2
			local m = Models.build(if bag then "MoneyBag" else "IngredientCrate")
			Models.place(m, plot.origin * CFrame.new(rack + Vector3.new(off.Z, 0, off.X)), f)
			local hit = Models.part(m, Vector3.new(4, 4, 4), plot.origin * CFrame.new(rack + Vector3.new(off.Z, 2, off.X)), Color3.new(1, 1, 1), { transparency = 1, collide = false, name = "Hit" })
			local taken = false
			hit.Touched:Connect(function(other)
				if taken then
					return
				end
				local pl = Players:GetPlayerFromCharacter(other.Parent)
				if pl ~= plot.owner or not pl then
					return
				end
				local ss = Data.get(pl)
				local root = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not ss or not root or (root.Position - hit.Position).Magnitude > Cat.pickups.pickupRange.value then
					return
				end
				taken = true
				local v = Game.collectPickup(ss.profile, if bag then 2 else 1) -- bags pay double
				GameService.notify(pl, "cash", { amount = v, source = "pickup", pos = hit.Position })
				m:Destroy()
				GameService.afterChange(ss)
				GameService.sync(ss)
			end)
		end
	end
end

---------------------------------------------------------------------------
-- Phone offers
---------------------------------------------------------------------------
local offerSeq = 0
local function phoneLoop()
	while true do
		task.wait(1)
		local now = os.time()
		for _, s in Data.sessions do
			local rt = s.rt
			rt.phoneNext = rt.phoneNext or now + Cat.phone.firstAfter.value
			local o = rt.offer
			if o and o.state == "open" and now > o.expires then
				o.state = "expired"
				GameService.notify(s.player, "phone", { offer = o, outcome = "expired" })
				rt.offer = nil
				rt.phoneNext = now + Cat.phone.every.value
			end
			if not rt.offer and now >= rt.phoneNext then
				offerSeq += 1
				local offer = Phone.newOffer(offerSeq, Game.incomeRate(s.profile, false), now, roll)
				rt.phoneNext = now + Cat.phone.every.value
				if offer then
					rt.offer = offer
					GameService.notify(s.player, "phone", { offer = offer, outcome = "new" })
				end
			end
		end
	end
end

GameService.register("phone", 0.3, function(s, id, action)
	local o = s.rt.offer
	if not o or o.id ~= id or type(action) ~= "string" then
		return
	end
	local outcome, amount = Phone.respond(o, action, os.time(), roll)
	if outcome == "invalid" then
		return
	end
	if outcome == "accepted" and amount then
		Game.earn(s.profile, amount)
		s.profile.stats.deals = (s.profile.stats.deals or 0) + 1
		GameService.notify(s.player, "cash", { amount = amount, source = "deal" })
		GameService.afterChange(s)
	end
	if o.state ~= "open" then
		s.rt.offer = nil
	end
	GameService.notify(s.player, "phone", { offer = o, outcome = outcome })
	GameService.sync(s)
end)

---------------------------------------------------------------------------
-- DogDash races (server-simulated)
---------------------------------------------------------------------------
GameService.register("dashStart", 1, function(s, pick, fraction)
	local p = s.profile
	if not Game.owns(p, "dash:dashgame") then
		return GameService.toast(s.player, "Buy DogDash the Game first", "error")
	end
	if s.rt.race then
		return
	end
	if os.clock() < (s.rt.raceCooldown or 0) then
		return GameService.toast(s.player, "The racers are resting", "error")
	end
	if type(pick) ~= "number" or type(fraction) ~= "number" then
		return
	end
	local bet = Dash.betAmount(p.cash, fraction)
	if not bet or bet.m <= 0 then
		return GameService.toast(s.player, "You need cash to bet", "error")
	end
	local race = Dash.new(pick, bet, roll)
	if not race then
		return
	end
	p.cash = BigNum.roundCents(BigNum.sub(p.cash, bet))
	s.rt.race = race
	s.rt.raceCooldown = os.clock() + Cat.dash.cooldown.value
	GameService.afterChange(s)
	GameService.sync(s)
	task.spawn(function()
		while s.rt.race == race and not race.winner and s.player.Parent do
			task.wait(0.1)
			Dash.step(race, 0.1, roll)
			GameService.notify(s.player, "race", { pos = race.pos, pick = race.pick, winner = race.winner, cheers = race.cheers })
		end
		if race.winner then
			local pay = Dash.payout(race)
			if pay.m > 0 then
				Game.earn(p, pay)
			end
			p.stats.races = (p.stats.races or 0) + 1
			GameService.notify(s.player, "raceEnd", { winner = race.winner, pick = race.pick, payout = pay, bet = race.bet })
			GameService.afterChange(s)
			GameService.sync(s)
		end
		s.rt.race = nil
	end)
end)

GameService.register("dashCheer", 0.08, function(s)
	local race = s.rt.race
	if race then
		Dash.cheer(race)
	end
end)

---------------------------------------------------------------------------
-- Business name (rule check + Roblox text filter; fails closed)
---------------------------------------------------------------------------
GameService.register("setName", 2, function(s, raw)
	if s.rt.naming then
		return
	end
	local clean, why = Names.clean(raw)
	if not clean then
		GameService.notify(s.player, "nameResult", { ok = false, msg = why })
		return
	end
	s.rt.naming = true
	local ok, filtered = pcall(function()
		local res = TextService:FilterStringAsync(clean, s.player.UserId, Enum.TextFilterContext.PublicChat)
		return res:GetNonChatStringForBroadcastAsync()
	end)
	s.rt.naming = false
	if not s.player.Parent then
		return
	end
	if not ok then
		GameService.notify(s.player, "nameResult", { ok = false, msg = "Couldn't check that name right now. Try again soon." })
		return
	end
	if filtered ~= clean then
		GameService.notify(s.player, "nameResult", { ok = false, msg = "That name isn't allowed. Try another!" })
		return
	end
	s.profile.name = clean
	GameService.notify(s.player, "nameResult", { ok = true, msg = "Renamed to " .. clean })
	GameService.afterChange(s)
	GameService.sync(s)
end)

---------------------------------------------------------------------------
-- Robux: receipts are idempotent (PurchaseId stored in the profile, saved before granting
-- is acknowledged). Mock purchases (Studio only) run the same handler with fake receipts.
---------------------------------------------------------------------------
local productByKey = Products.byKey
local keyByProductId: { [number]: string } = {}
local keyByPassId: { [number]: string } = {}
for _, p in Products.list do
	if p.id then
		if p.kind == "pass" then
			keyByPassId[p.id] = p.key
		else
			keyByProductId[p.id] = p.key
		end
	end
end

-- Shared grant path. Returns "granted" | "retry".
local function deliver(s: Data.Session, key: string, purchaseId: string): string
	local already = Game.hasReceipt(s.profile, purchaseId)
	local ok, msg = Game.grantProduct(s.profile, key, purchaseId)
	if not ok then
		warn("[Shop] could not grant", key, msg)
		return "retry"
	end
	if not already then
		GameService.notify(s.player, "purchase", { key = key, msg = msg })
		GameService.afterChange(s)
		GameService.sync(s)
	end
	-- the receipt is only acknowledged once it is safely stored
	if s.canSave and not Data.save(s, false) then
		return "retry"
	end
	if not s.canSave then
		-- save is disabled (load failed); do not acknowledge, Roblox will retry next visit
		return "retry"
	end
	return "granted"
end
Extras.deliver = deliver

MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local s = player and Data.get(player)
	local key = keyByProductId[info.ProductId]
	if not s or not key then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local r = deliver(s, key, tostring(info.PurchaseId))
	return if r == "granted" then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
end

local function checkPasses(s: Data.Session)
	for passId, key in keyByPassId do
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(s.player.UserId, passId)
		end)
		if ok and owns then
			deliver(s, key, "pass:" .. passId)
		end
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, bought)
	local s = Data.get(player)
	local key = keyByPassId[passId]
	if s and key and bought then
		deliver(s, key, "pass:" .. passId)
	end
end)

GameService.register("buyProduct", 1, function(s, key)
	local prod = if type(key) == "string" then productByKey[key] else nil
	if not prod then
		return
	end
	if Game.productOwned(s.profile, prod.key) then
		return GameService.toast(s.player, "You already own this", "info")
	end
	if not prod.id then
		return GameService.toast(s.player, "This item isn't on sale yet", "info")
	end
	if prod.kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(s.player, prod.id)
	else
		MarketplaceService:PromptProductPurchase(s.player, prod.id)
	end
end)

local lastMock: { [number]: string } = {}
-- Studio-only test purchases. replay=true re-sends the previous receipt id (duplicate delivery);
-- fail=true simulates a failed grant (nothing changes, receipt not stored).
GameService.register("mockBuy", 0.3, function(s, key, replay, fail)
	if not (Config.MockPurchases and RunService:IsStudio()) then
		return
	end
	local prod = if type(key) == "string" then productByKey[key] else nil
	if not prod then
		return
	end
	if fail == true then
		GameService.toast(s.player, "Test purchase cancelled - nothing was charged or granted", "info")
		return
	end
	if Game.productOwned(s.profile, prod.key) and replay ~= true then
		return GameService.toast(s.player, "You already own this", "info")
	end
	local id = if replay == true and lastMock[s.player.UserId] then lastMock[s.player.UserId] else "mock-" .. HttpService:GenerateGUID(false)
	lastMock[s.player.UserId] = id
	local r = deliver(s, prod.key, id)
	print(string.format("[Shop][mock] %s key=%s receipt=%s -> %s", s.player.Name, prod.key, id, r))
	if replay == true then
		GameService.toast(s.player, "Duplicate receipt delivered - no second grant", "info")
	end
end)

function Extras.init()
	task.spawn(spawnPickups)
	task.spawn(phoneLoop)
	GameService.onSessionLoaded(function(s)
		checkPasses(s)
	end)
	-- keep Format referenced for future toasts
	local _ = Format
end

return Extras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns the production loop, player actions and state sync. Every action re-validates the
-- request (ownership, range, prerequisites, affordability, rate) and runs without yielding,
-- so repeated or simultaneous requests cannot double-spend or double-grant.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Config = require(Shared.Config)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Game = require(Shared.Logic.Game)
local Layout = require(Shared.Layout)
local Names = require(Shared.Logic.Names)
local Net = require(Shared.Net)
local Products = require(Shared.Products)
local Data = require("./Data")
local World = require("./World")

local GameService = {}

local Action = Net.get("Action")
local StateRemote = Net.get("State")
local Notify = Net.get("Notify")

type Handler = (Data.Session, ...any) -> ()
local handlers: { [string]: { fn: Handler, gap: number } } = {}

function GameService.register(name: string, gap: number, fn: Handler)
	handlers[name] = { fn = fn, gap = gap }
end

function GameService.notify(player: Player, kind: string, data: any)
	Notify:FireClient(player, kind, data)
end

function GameService.toast(player: Player, text: string, kind: string?)
	Notify:FireClient(player, "toast", { text = text, kind = kind or "info" })
end

function GameService.markDirty(s: Data.Session)
	s.rt.dirty = true
end

-- range helpers --------------------------------------------------------------

local function rootPos(player: Player): Vector3?
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

local function nearLot(s: Data.Session, bizId: string): boolean
	local plot = World.plotOf(s.player)
	local pos = rootPos(s.player)
	if not plot or not pos then
		return false
	end
	local lot = Layout.lots[bizId]
	local centre = (plot.origin * CFrame.new(lot.pos)).Position
	return (pos - centre).Magnitude <= Config.InteractRange + lot.size.Magnitude / 2
end

local function nearPad(s: Data.Session, padId: string): boolean
	local plot = World.plotOf(s.player)
	local pos = rootPos(s.player)
	local part = plot and plot.pads[padId]
	if not part or not pos then
		return false
	end
	return (pos - part.Position).Magnitude <= Config.PadRange
end

-- movement power ---------------------------------------------------------------

local function applyWalkSpeed(s: Data.Session)
	local ch = s.player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		local tier = Game.powerTier(s.profile, "runFaster")
		local mult = if tier > 0 then Game.POWERS.runFaster.walkMult[tier] else 1
		hum.WalkSpeed = Config.BaseWalkSpeed * mult
	end
end
GameService.applyWalkSpeed = applyWalkSpeed

-- after any purchase or reset ---------------------------------------------------

local function afterChange(s: Data.Session)
	s.dirty = true
	s.rt.dirty = true
	local plot = World.plotOf(s.player)
	if plot then
		local appeared = World.sync(plot, s.profile, s.profile.name or Names.default(s.player.DisplayName))
		if #appeared > 0 then
			GameService.notify(s.player, "built", appeared)
		end
	end
	local skip = Game.flushSkips(s.profile)
	if skip then
		GameService.toast(s.player, "Time skip paid out " .. Format.cash(skip), "cash")
	end
	applyWalkSpeed(s)
end
GameService.afterChange = afterChange

-- snapshot ---------------------------------------------------------------------

local function bigOrNil(b: any): any
	return b
end

function GameService.snapshot(s: Data.Session): any
	local p = s.profile
	local ms = Game.multState(p)
	local biz = {}
	for _, def in Economy.businesses do
		local st = p.biz[def.id]
		local owned = Game.bizOwned(p, def.id)
		local entry: any = { owned = owned }
		if owned then
			local cps = Economy.cyclesPerSecond(ms, def)
			local n1 = Game.levelCost(p, def.id, 1)
			local maxN, maxCost = 0, BigNum.zero
			if table.find(Game.bulkOptions(p), "max") then
				maxN, maxCost = Game.maxAffordable(p, def.id)
			end
			local bulk = {}
			for _, o in Game.bulkOptions(p) do
				if type(o) == "number" and o > 1 then
					bulk[tostring(o)] = Game.levelCost(p, def.id, o)
				end
			end
			entry.level = st.level
			entry.auto = Economy.isAutomated(ms, def)
			entry.running = st.running
			entry.progress = st.progress
			entry.cps = BigNum.toNumber(cps)
			entry.output = Economy.cycleOutput(ms, def, st.level)
			entry.rate = Game.bizRate(p, def.id)
			entry.cost1 = n1
			entry.bulk = bulk
			entry.maxN = maxN
			entry.maxCost = maxCost
			entry.cashMult = Economy.cashMult(ms, def)
			entry.speedMult = Economy.speedMult(ms, def)
		end
		biz[def.id] = entry
	end
	local pads = {}
	for _, pad in Economy.pads do
		local state = 0
		if p.forever[pad.id] then
			state = 3
		elseif p.pads[pad.id] then
			state = 2
		elseif Game.padVisible(p, pad) then
			state = 1
		end
		pads[pad.id] = { s = state, c = if state == 1 then Game.padCost(p, pad) else nil }
	end
	local powers = {}
	for _, pw in Economy.Catalog.powers do
		powers[pw.id] = { tier = Game.powerTier(p, pw.id), bought = p.powers[pw.id] or 0, robux = p.robux.tiers[pw.id] or 0, cost = Game.powerCost(p, pw.id) }
	end
	local owned = {}
	for _, prod in Products.list do
		owned[prod.key] = Game.productOwned(p, prod.key)
	end
	local canAsc, padsOwned, padsTotal = Game.canAscend(p)
	local next = Game.nextPad(p)
	return {
		t = workspace:GetServerTimeNow(),
		cash = p.cash,
		investors = p.investors,
		offered = Game.investorsOffered(p),
		x2 = p.robux.passes.x2investors == true,
		bonusPer = Economy.Catalog.prestige.cashBonusPerInvestor.value,
		rate = Game.incomeRate(p, false),
		autoRate = Game.incomeRate(p, true),
		evo = { n = p.evolutions, recipe = Economy.recipeName(p.evolutions), nextRecipe = Economy.recipeName(p.evolutions + 1), can = not BigNum.lt(p.investors, Economy.evolutionThreshold(p.evolutions)), progress = Game.evolutionProgress(p), need = Economy.evolutionThreshold(p.evolutions), mult = Economy.Catalog.prestige.evolutionSpeedMult.value },
		asc = { n = p.ascensions, can = canAsc, owned = padsOwned, total = padsTotal, cash = Economy.Catalog.prestige.ascensionCashMult.value, price = Economy.Catalog.prestige.ascensionPriceMult.value },
		tokens = p.foreverTokens,
		credits = p.robux.rebirthCredits,
		pendingOffline = p.pendingOffline,
		name = p.name or Names.default(s.player.DisplayName),
		canSave = s.canSave,
		loadError = s.rt.loadError,
		bulk = Game.bulkOptions(p),
		powers = powers,
		owned = owned,
		biz = biz,
		pads = pads,
		nextPad = next and next.id,
		dash = Game.owns(p, "dash:dashgame"),
		earned = s.rt.earned,
		mock = Config.MockPurchases and game:GetService("RunService"):IsStudio(),
	}
end

local function sync(s: Data.Session)
	StateRemote:FireClient(s.player, GameService.snapshot(s))
	s.rt.earned = nil
	s.rt.dirty = false
end
GameService.sync = sync

-- actions ------------------------------------------------------------------------

local function result(s: Data.Session, ok: boolean, msg: string)
	if ok then
		afterChange(s)
	else
		GameService.toast(s.player, msg, "error")
	end
	sync(s)
end

GameService.register("click", 0.05, function(s, bizId)
	if type(bizId) ~= "string" or not Economy.bizById[bizId] then
		return
	end
	if Game.powerTier(s.profile, "manage") < 1 and not nearLot(s, bizId) then
		return GameService.toast(s.player, "Walk closer, or unlock Manage", "error")
	end
	local ok = Game.click(s.profile, bizId)
	if ok then
		s.rt.dirty = true
		sync(s)
	end
end)

GameService.register("upgrade", 0.05, function(s, bizId, count)
	if type(bizId) ~= "string" or not Economy.bizById[bizId] then
		return
	end
	if not (count == "max" or type(count) == "number") then
		return
	end
	if Game.powerTier(s.profile, "manage") < 1 and not nearLot(s, bizId) then
		return GameService.toast(s.player, "Walk closer, or unlock Manage", "error")
	end
	local ok, msg = Game.upgradeLevel(s.profile, bizId, count)
	result(s, ok, msg)
end)

local function tryPad(s: Data.Session, padId: string, how: string)
	local pad = Economy.padById[padId]
	if not pad then
		return
	end
	if how == "remote" and Game.powerTier(s.profile, "remoteBuy") < 1 and not nearPad(s, padId) then
		return GameService.toast(s.player, "Step on the circle, or unlock Remote Buy", "error")
	end
	local ok, msg = Game.buyPad(s.profile, padId)
	if ok then
		GameService.notify(s.player, "bought", { padId = padId, name = pad.name })
	end
	result(s, ok, msg)
end

GameService.register("buyPad", 0.1, function(s, padId)
	if type(padId) == "string" then
		tryPad(s, padId, "remote")
	end
end)

GameService.register("buyNext", 0.15, function(s)
	if Game.powerTier(s.profile, "remoteBuy") < 1 then
		return GameService.toast(s.player, "Remote Buy is locked", "error")
	end
	local nextPad = Game.nextPad(s.profile)
	if nextPad then
		tryPad(s, nextPad.id, "remote")
	end
end)

GameService.register("buyPower", 0.2, function(s, id)
	if type(id) ~= "string" then
		return
	end
	local ok, msg = Game.buyPower(s.profile, id)
	if ok then
		GameService.toast(s.player, msg, "good")
	end
	result(s, ok, msg)
end)

GameService.register("rebirth", 1, function(s)
	local ok, msg, award = Game.rebirth(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "rebirth", amount = award })
	end
	result(s, ok, msg)
end)

GameService.register("rebirthNoReset", 1, function(s)
	local ok, msg, award = Game.rebirthNoReset(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "rebirthNoReset", amount = award })
	end
	result(s, ok, msg)
end)

GameService.register("evolve", 1, function(s)
	local ok, msg = Game.evolve(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "evolve", recipe = Economy.recipeName(s.profile.evolutions) })
	end
	result(s, ok, msg)
end)

GameService.register("ascend", 1, function(s)
	local ok, msg = Game.ascend(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "ascend", n = s.profile.ascensions })
	end
	result(s, ok, msg)
end)

GameService.register("forever", 0.5, function(s, padId)
	if type(padId) ~= "string" then
		return
	end
	local ok, msg = Game.useForever(s.profile, padId)
	if ok then
		GameService.toast(s.player, msg, "good")
	end
	result(s, ok, msg)
end)

GameService.register("claimOffline", 0.5, function(s)
	local ok, msg, amount = Game.claimOffline(s.profile)
	if ok then
		GameService.notify(s.player, "cash", { amount = amount, source = "offline" })
	end
	result(s, ok, msg)
end)

GameService.register("sync", 0.5, function(s)
	sync(s)
end)

-- incoming ------------------------------------------------------------------------

local lastCall: { [number]: { [string]: number } } = {} -- keyed by UserId
local burst: { [number]: { n: number, t: number } } = {}

Action.OnServerEvent:Connect(function(player: Player, name: any, ...)
	if type(name) ~= "string" then
		return
	end
	local h = handlers[name]
	local s = Data.get(player)
	if not h or not s then
		return
	end
	local now = os.clock()
	-- global burst cap: 40 requests per second per player
	local b: { n: number, t: number } = burst[player.UserId] or { n = 0, t = now }
	if now - b.t >= 1 then
		b = { n = 0, t = now }
	end
	burst[player.UserId] = b
	b.n += 1
	if b.n > 40 then
		return
	end
	local calls = lastCall[player.UserId]
	if not calls then
		calls = {}
		lastCall[player.UserId] = calls
	end
	if now - (calls[name] or 0) < h.gap then
		return
	end
	calls[name] = now
	local ok, err = pcall(h.fn :: any, s, ...)
	if not ok then
		warn("[GameService] action", name, "failed:", err)
	end
end)

-- world callbacks -------------------------------------------------------------------

local touchGap: { [number]: number } = {}
World.onPadTouched = function(player, padId)
	local s = Data.get(player)
	if not s then
		return
	end
	local now = os.clock()
	if now - (touchGap[player.UserId] or 0) < 0.4 then
		return
	end
	touchGap[player.UserId] = now
	local p = s.profile
	local pad = Economy.padById[padId]
	if not pad or Game.owns(p, padId) or not Game.padVisible(p, pad) then
		return
	end
	if BigNum.lt(p.cash, Game.padCost(p, pad)) then
		GameService.toast(player, "Need " .. Format.cash(Game.padCost(p, pad)) .. " for " .. pad.name, "error")
		return
	end
	tryPad(s, padId, "touch")
end

World.onBizPrompt = function(player, bizId)
	local h = handlers.click
	local s = Data.get(player)
	if s then
		h.fn(s, bizId)
	end
end

World.onExtraPrompt = function(player, action)
	GameService.notify(player, "open", action)
end

-- lifecycle ---------------------------------------------------------------------------

local function spawnAtPlot(player: Player, character: Model)
	local plot = World.plotOf(player)
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if plot and root then
		task.wait()
		character:PivotTo(plot.origin * CFrame.new(Layout.spawn) * CFrame.Angles(0, math.pi, 0))
	end
	local s = Data.get(player)
	if s then
		applyWalkSpeed(s)
	end
end

local onLoaded: { (Data.Session) -> () } = {}
function GameService.onSessionLoaded(fn: (Data.Session) -> ())
	table.insert(onLoaded, fn)
end

function GameService.init()
	Data.Loaded:Connect(function(s: Data.Session)
		local plot = World.assign(s.player)
		if not plot then
			s.player:Kick("This server is full. Please try another server!")
			return
		end
		afterChange(s)
		sync(s)
		if s.offlineFound and BigNum.toNumber(s.profile.pendingOffline) > 0 then
			GameService.notify(s.player, "offline", { amount = s.profile.pendingOffline, seconds = nil })
		end
		if s.rt.loadError then
			GameService.notify(s.player, "loadError", s.rt.loadError)
		end
		if s.player.Character then
			task.spawn(spawnAtPlot, s.player, s.player.Character)
		end
		for _, fn in onLoaded do
			task.spawn(fn, s)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(ch)
			spawnAtPlot(player, ch)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function(ch)
			spawnAtPlot(player, ch)
		end)
	end
	Data.Leaving:Connect(function(s: Data.Session)
		World.release(s.player)
		lastCall[s.player.UserId] = nil
		burst[s.player.UserId] = nil
		touchGap[s.player.UserId] = nil
	end)

	-- production loop: fixed steps, aggregated grants, snapshots at SyncSeconds
	task.spawn(function()
		local acc, syncAcc = 0, 0
		local last = os.clock()
		while true do
			task.wait(Config.StepSeconds)
			local now = os.clock()
			local dt = math.min(now - last, 1)
			last = now
			acc += dt
			syncAcc += dt
			for _, s in Data.sessions do
				if not World.plotOf(s.player) then
					continue
				end
				local grants = Game.step(s.profile, dt)
				if #grants > 0 then
					s.dirty = true
					s.rt.dirty = true
					local earned = s.rt.earned or {}
					for _, g in grants do
						local e = earned[g.bizId]
						if e then
							e.amount = BigNum.add(e.amount, g.amount)
							e.cycles += math.max(g.cycles, 0)
						else
							earned[g.bizId] = { amount = g.amount, cycles = math.max(g.cycles, 0) }
						end
					end
					s.rt.earned = earned
					if s.rt.prevCanSee == nil or s.rt.prevPadsTick ~= nil then
						-- pads become affordable as cash grows; plot visuals don't depend on cash
					end
				end
			end
			if syncAcc >= Config.SyncSeconds then
				syncAcc = 0
				for _, s in Data.sessions do
					if s.rt.dirty and World.plotOf(s.player) then
						sync(s)
					end
				end
			end
		end
	end)
end

GameService.handlers = handlers
GameService._bigOrNil = bigOrNil
return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Models</string>
            <string name="Source"><![CDATA[--!strict
-- Native-part stand-ins for every model. Each builder returns a Model whose pivot is the
-- centre of its footprint on the ground. If Carter imports the Blender meshes into
-- ReplicatedStorage.Assets.<Name> (see assets/ASSETS.md), Models.build uses those instead.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Models = {}

local C = {
	bun = Color3.fromRGB(232, 184, 107),
	bunDark = Color3.fromRGB(201, 138, 75),
	sausage = Color3.fromRGB(181, 84, 58),
	sausageDark = Color3.fromRGB(142, 59, 38),
	mustard = Color3.fromRGB(242, 194, 48),
	ketchup = Color3.fromRGB(216, 58, 46),
	relish = Color3.fromRGB(109, 190, 69),
	cream = Color3.fromRGB(255, 246, 229),
	teal = Color3.fromRGB(63, 182, 201),
	wood = Color3.fromRGB(196, 140, 86),
	woodDark = Color3.fromRGB(150, 100, 60),
	white = Color3.fromRGB(250, 250, 250),
	steel = Color3.fromRGB(200, 205, 212),
	dark = Color3.fromRGB(60, 62, 70),
	glass = Color3.fromRGB(170, 225, 240),
	violet = Color3.fromRGB(150, 90, 230),
	alien = Color3.fromRGB(120, 220, 110),
	sky = Color3.fromRGB(120, 200, 255),
}
Models.Colors = C

type Opts = { shape: Enum.PartType?, material: Enum.Material?, transparency: number?, neon: boolean?, collide: boolean?, name: string? }

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, o: Opts?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CastShadow = true
	if o then
		if o.shape then
			p.Shape = o.shape
		end
		if o.material then
			p.Material = o.material
		end
		if o.neon then
			p.Material = Enum.Material.Neon
		end
		if o.transparency then
			p.Transparency = o.transparency
		end
		if o.collide == false then
			p.CanCollide = false
		end
		if o.name then
			p.Name = o.name
		end
	end
	p.Parent = parent
	return p
end
Models.part = part

local function cyl(parent: Instance, len: number, dia: number, cf: CFrame, color: Color3, o: Opts?): Part
	-- Roblox cylinders run along X
	local opts: Opts = o or {}
	opts.shape = Enum.PartType.Cylinder
	return part(parent, Vector3.new(len, dia, dia), cf, color, opts)
end

local function ball(parent: Instance, d: number, cf: CFrame, color: Color3, o: Opts?): Part
	local opts: Opts = o or {}
	opts.shape = Enum.PartType.Ball
	return part(parent, Vector3.new(d, d, d), cf, color, opts)
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns an X-axis cylinder upright

-- A hot dog lying along X, centred at cf.
function Models.hotDog(parent: Instance, cf: CFrame, scale: number, bunColor: Color3?, sausageColor: Color3?)
	local s = scale
	local bunL, bunD = 2.0 * s, 0.75 * s
	part(parent, Vector3.new(bunL, bunD * 0.55, bunD), cf * at(0, -0.12 * s, 0), bunColor or C.bun, { collide = false })
	cyl(parent, bunL, bunD * 0.6, cf * at(0, 0.05 * s, 0.22 * s), bunColor or C.bun, { collide = false })
	cyl(parent, bunL, bunD * 0.6, cf * at(0, 0.05 * s, -0.22 * s), bunColor or C.bun, { collide = false })
	cyl(parent, bunL * 1.15, 0.42 * s, cf * at(0, 0.28 * s, 0), sausageColor or C.sausage, { collide = false })
	-- mustard zigzag
	for i = -3, 3 do
		local seg = part(parent, Vector3.new(0.34 * s, 0.07 * s, 0.09 * s), cf * at(i * 0.27 * s, 0.5 * s, 0) * CFrame.Angles(0, math.rad(if i % 2 == 0 then 35 else -35), 0), C.mustard, { collide = false })
		seg.CastShadow = false
	end
end

local function sign(parent: Instance, size: Vector3, cf: CFrame, bg: Color3, text: string, textColor: Color3?): Part
	local board = part(parent, size, cf, bg, { name = "Sign" })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Parent = board
	local tl = Instance.new("TextLabel")
	tl.Name = "Text"
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(0.94, 0.9)
	tl.Position = UDim2.fromScale(0.03, 0.05)
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.TextColor3 = textColor or C.white
	tl.Text = text
	tl.Parent = sg
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(80, 40, 20)
	stroke.Transparency = 0.3
	stroke.Parent = tl
	return board
end
Models.sign = sign

-- Striped awning made of alternating slats.
local function awning(parent: Instance, width: number, depth: number, cf: CFrame, a: Color3, b: Color3)
	local n = math.max(3, math.floor(width / 1.6))
	local w = width / n
	for i = 0, n - 1 do
		local x = -width / 2 + w * (i + 0.5)
		part(parent, Vector3.new(w, 0.3, depth), cf * at(x, 0, 0) * CFrame.Angles(math.rad(-18), 0, 0), if i % 2 == 0 then a else b)
	end
end

local B: { [string]: (Model) -> () } = {}

B.HotDogStand = function(m)
	-- counter
	part(m, Vector3.new(12, 3.6, 5), at(0, 1.8, 0), C.ketchup)
	part(m, Vector3.new(12.4, 0.4, 5.4), at(0, 3.8, 0), C.cream)
	part(m, Vector3.new(11, 1.1, 0.2), at(0, 2.2, -2.55), C.mustard)
	-- wheels
	for _, x in { -4.5, 4.5 } do
		cyl(m, 0.6, 2.4, at(x, 1.2, -2.7) * CFrame.Angles(0, math.rad(90), 0), C.dark)
		cyl(m, 0.7, 1.0, at(x, 1.2, -2.75) * CFrame.Angles(0, math.rad(90), 0), C.steel)
	end
	-- grill with sausages
	part(m, Vector3.new(4, 0.3, 2.4), at(3, 4.1, 0.6), C.dark)
	for i = 0, 3 do
		cyl(m, 2.2, 0.45, at(3, 4.45, -0.2 + i * 0.55), C.sausage)
	end
	-- buns pile and bottles
	for i = 0, 2 do
		Models.hotDog(m, at(-3 + i * 0.3, 4.3 + i * 0.5, 0.4), 0.9)
	end
	cyl(m, 1.5, 0.7, at(-0.6, 4.75, -1.4) * UP, C.mustard)
	cyl(m, 1.5, 0.7, at(0.4, 4.75, -1.4) * UP, C.ketchup)
	-- posts and awning
	for _, x in { -5.6, 5.6 } do
		cyl(m, 6.5, 0.4, at(x, 7, 2.2) * UP, C.white)
		cyl(m, 3, 0.4, at(x, 5.5, -2.2) * UP, C.white)
	end
	awning(m, 13.5, 6, at(0, 8.4, 0), C.ketchup, C.cream)
	local s = sign(m, Vector3.new(10, 2.4, 0.4), at(0, 10.6, 2.2), C.mustard, "HOT DOGS", C.ketchup)
	s.Name = "NameSign"
	-- giant mascot hot dog on the roof
	Models.hotDog(m, at(0, 12.6, 2.2), 3)
end

B.CondimentStation = function(m)
	part(m, Vector3.new(5, 0.4, 3), at(0, 2.6, 0), C.wood)
	for _, x in { -2.2, 2.2 } do
		for _, z in { -1.2, 1.2 } do
			part(m, Vector3.new(0.35, 2.4, 0.35), at(x, 1.2, z), C.woodDark)
		end
	end
