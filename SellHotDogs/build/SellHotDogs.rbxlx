-- Upgrades without their own stand-in reuse the closest one until the meshes load.
local ALIAS: { [string]: string } = {
	RelishMixer = "CondimentStation", FlyerStand = "Flyers", FlameGrill = "Grill", BogoSign = "Sign",
	DashFloor = "Floor", DashWalls = "Walls", FeeBoard = "Sign", DispatchDesk = "CashRegister", DashArcade = "Arcade",
	FridgeTruck = "DepotTruck", LoadingConveyor = "Conveyor", DepotOffice = "CashRegister", BoxingMachine = "Crates",
	GpsTower = "Antenna", ExpressSign = "Sign", InsuranceBooth = "CashRegister", BigVan = "DeliveryVan",
	PalletStack = "Crates", LedDisplay = "TradingTicker", TurboEngine = "Grill", RobotTruck = "DepotTruck",
	FuelTank = "Conveyor", BrokerDesk = "TradingTicker", SauceVault = "CashRegister", BullStatue = "HotDogStatue",
	ClockBoard = "TradingTicker", ScientistBot = "KitchenRobot", MissionConsole = "TradingTicker",
}
Models.ALIAS = ALIAS

Models.BUILDING_FOR = {
	stand = "HotDogStand",
	dash = "DashShop",
	depot = "DepotBuilding",
	trading = "TradingFloor",
	labs = "LabBuilding",
	robotics = "RoboticsFactory",
	republic = "RepublicCapitol",
	hotdogx = "LaunchSite",
}

-- Build a model by name. Imported meshes in ReplicatedStorage.Assets win over stand-ins.
function Models.has(name: string): boolean
	return B[name] ~= nil or ALIAS[name] ~= nil
end

-- True once the uploaded mesh for `name` has been loaded into ReplicatedStorage.Assets.
function Models.hasMesh(name: string): boolean
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	return assets ~= nil and assets:FindFirstChild(name) ~= nil
end

function Models.build(name: string): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local imported = assets and assets:FindFirstChild(name)
	if imported and imported:IsA("Model") then
		local m = imported:Clone()
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		return m
	end
	local m = Instance.new("Model")
	m.Name = name
	local f = B[name] or B[ALIAS[name] or ""] or B.Sign
	f(m)
	m.WorldPivot = CFrame.new()
	return m
end

-- Shrink a model (about its pivot) so its footprint fits a square of `maxSize` studs.
-- Works on freshly built models (pivot at the origin); heights scale with it.
function Models.fit(m: Model, maxSize: number)
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local p, s = d.CFrame.Position, d.Size
			local r = math.max(s.X, s.Z) / 2
			minX, maxX = math.min(minX, p.X - r), math.max(maxX, p.X + r)
			minZ, maxZ = math.min(minZ, p.Z - r), math.max(maxZ, p.Z + r)
		end
	end
	local extent = math.max(maxX - minX, maxZ - minZ)
	if extent <= maxSize or extent == -math.huge then
		return
	end
	local k = maxSize / extent
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local cf = d.CFrame
			d.Size = d.Size * k
			d.CFrame = CFrame.new(cf.Position * k) * cf.Rotation
		elseif d:IsA("Fire") then
			d.Size = math.max(2, d.Size * k)
		end
	end
end

function Models.place(m: Model, cf: CFrame, parent: Instance): Model
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote names in one place. The server creates them; clients wait for them.
--   Action   (client -> server)  Action:FireServer(name, ...)
--   State    (server -> owner)   full snapshot of the player's own game state
--   Notify   (server -> owner)   toasts, effects, phone and race updates: (kind, data)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local NAMES = { "Action", "State", "Notify" }

local folder: Folder
if RunService:IsServer() then
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
	end
	folder = f :: Folder
	for _, n in NAMES do
		if not folder:FindFirstChild(n) then
			local r = Instance.new("RemoteEvent")
			r.Name = n
			r.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.get(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--!strict
-- The new game's own Robux products. IDs are nil until Carter creates them on the Creator
-- Dashboard for the published Sell Hot Dogs experience (docs/LIVE_SETUP.md). Never reuse the
-- reference game's IDs. Live prices come from MarketplaceService:GetProductInfo at runtime.
-- key = Game.grantProduct key; kind "pass" = Game Pass (one-time), "product" = Developer Product.
export type Product = { key: string, kind: string, id: number?, icon: string, blurb: string }

local Products: { Product } = {
	{ key = "speedUp", kind = "pass", id = nil, icon = "⏩", blurb = "Every business runs x2 faster, forever." },
	{ key = "x2investors", kind = "pass", id = nil, icon = "👽", blurb = "Twice the Alien Investors every rebirth." },
	{ key = "manage", kind = "pass", id = nil, icon = "📋", blurb = "Manage every business from one menu." },
	{ key = "remoteBuy", kind = "pass", id = nil, icon = "📡", blurb = "Buy the next upgrade from anywhere." },
	{ key = "expertPicker", kind = "product", id = nil, icon = "🧺", blurb = "Permanent Expert Collector level." },
	{ key = "runFaster", kind = "product", id = nil, icon = "👟", blurb = "Permanent Run Faster level." },
	{ key = "stack", kind = "product", id = nil, icon = "📚", blurb = "Permanent Stack Upgrade level." },
	{ key = "forever", kind = "product", id = nil, icon = "♾️", blurb = "Pick one upgrade to keep through every reset." },
	{ key = "rebirthNoReset", kind = "product", id = nil, icon = "🛸", blurb = "Collect your investors without resetting." },
	{ key = "cash1h", kind = "product", id = nil, icon = "💵", blurb = "1 hour of profit instantly." },
	{ key = "cash24h", kind = "product", id = nil, icon = "💰", blurb = "24 hours of profit instantly." },
	{ key = "cash7d", kind = "product", id = nil, icon = "🏦", blurb = "7 days of profit instantly." },
}

local byKey: { [string]: Product } = {}
for _, p in Products do
	byKey[p.key] = p
end

return {
	list = Products,
	byKey = byKey,
}
]]></string>
