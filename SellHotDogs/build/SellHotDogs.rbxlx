  <Item class="ServerScriptService" referent="21">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Sell Hot Dogs server entry. Init order matters: World before GameService (plots exist),
-- GameService before Extras (Extras registers actions on it), Data last (starts loading players).
local Services = script.Parent:WaitForChild("Services")

local World = require(Services.World)
local GameService = require(Services.GameService)
local Extras = require(Services.Extras)
local Data = require(Services.Data)
local AssetLoader = require(Services.AssetLoader)

game:GetService("Players").CharacterAutoLoads = true
World.init()
GameService.init()
Extras.init()
Data.init()
-- uploaded Blender meshes replace the native-part stand-ins as they arrive
AssetLoader.onLoaded = World.swap
AssetLoader.init()
print("[SellHotDogs] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">AssetLoader</string>
            <string name="Source"><![CDATA[--!strict
-- Loads the uploaded Blender meshes (Shared/AssetIds) with InsertService into
-- ReplicatedStorage.Assets as Models named after the asset (pivot = centre of the footprint on
-- the ground), then asks World to swap the native-part stand-ins for them. Runs in the
-- background; anything that fails keeps its stand-in. InsertService only loads assets owned by
-- the experience's owner, so upload with the publishing account (tools/upload_assets.py).
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local AssetIds = require(Shared.AssetIds)
local Config = require(Shared.Config)

local AssetLoader = {}
AssetLoader.loaded = 0
AssetLoader.failed = {} :: { string }
AssetLoader.onLoaded = nil :: ((string) -> ())?

-- Rotations to try so the loaded mesh's box matches the manifest box (uploads can come in
-- Z-up or Y-up depending on importer settings).
local ROTS = {
	CFrame.new(),
	CFrame.Angles(math.rad(-90), 0, 0),
	CFrame.Angles(math.rad(90), 0, 0),
	CFrame.Angles(0, 0, math.rad(90)),
}

local function boxError(a: Vector3, b: Vector3): number
	local ra = Vector3.new(a.X / a.Y, a.Z / a.Y, 1)
	local rb = Vector3.new(b.X / b.Y, b.Z / b.Y, 1)
	return math.abs(math.log(ra.X / rb.X)) + math.abs(math.log(ra.Y / rb.Y))
end

local function rotatedSize(s: Vector3, r: CFrame): Vector3
	local v = r:VectorToWorldSpace(s)
	return Vector3.new(math.abs(v.X), math.abs(v.Y), math.abs(v.Z))
end

local function loadOne(name: string, rec: { id: number, size: Vector3 }, folder: Folder)
	local ok, container = pcall(InsertService.LoadAsset, InsertService, rec.id)
	if not ok or not container then
		table.insert(AssetLoader.failed, name)
		warn("[AssetLoader] could not load", name, container)
		return
	end
	local mesh: MeshPart? = nil
	for _, d in (container :: Instance):GetDescendants() do
		if d:IsA("MeshPart") and (not mesh or d.Size.Magnitude > (mesh :: MeshPart).Size.Magnitude) then
			mesh = d
		end
	end
	if not mesh then
		table.insert(AssetLoader.failed, name)
		;(container :: Instance):Destroy()
		return
	end
	local mp = mesh :: MeshPart
	mp.Parent = nil
	;(container :: Instance):Destroy()
	-- pick the orientation whose proportions match the manifest, then force the exact size
	local best, bestErr = ROTS[1], math.huge
	for _, r in ROTS do
		local e = boxError(rotatedSize(mp.Size, r), rec.size)
		if e < bestErr then
			best, bestErr = r, e
		end
	end
	local yaw = CFrame.Angles(0, math.rad(Config.MeshYaw or 0), 0)
	local localSize = rotatedSize(rec.size, best:Inverse())
	mp.Size = localSize
	mp.Anchored = true
	mp.CanCollide = true
	mp.CollisionFidelity = Enum.CollisionFidelity.Box
	mp.CFrame = yaw * CFrame.new(0, rec.size.Y / 2, 0) * best
	mp.Name = "Mesh"
	local model = Instance.new("Model")
	model.Name = name
	mp.Parent = model
	model.PrimaryPart = mp
	model.WorldPivot = CFrame.new()
	model.Parent = folder
	AssetLoader.loaded += 1
	if AssetLoader.onLoaded then
		task.spawn(AssetLoader.onLoaded, name)
	end
end

function AssetLoader.init()
	local folder = ReplicatedStorage:FindFirstChild("Assets") :: Folder?
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "Assets"
		f.Parent = ReplicatedStorage
		folder = f
	end
	local queue = {}
	for name, rec in AssetIds.Models do
		if not (folder :: Folder):FindFirstChild(name) then
			table.insert(queue, { name = name, rec = rec })
		end
	end
	if #queue == 0 then
		return
	end
	print(string.format("[AssetLoader] loading %d meshes in the background", #queue))
	for _ = 1, 6 do
		task.spawn(function()
			while #queue > 0 do
				local job = table.remove(queue)
				if job then
					loadOne(job.name, job.rec, folder :: Folder)
				end
			end
		end)
	end
end

return AssetLoader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player sessions: load, autosave, save on leave/shutdown.
-- A failed load never creates a profile that could overwrite the stored save: the player gets
-- a temporary profile with saving disabled and is told so.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Config = require(Shared.Config)
local Profile = require(Shared.Logic.Profile)
local Game = require(Shared.Logic.Game)
local Store = require("./Store")

export type Session = {
	player: Player,
	profile: Profile.Profile,
	canSave: boolean,
	dirty: boolean,
	saving: boolean,
	lastSave: number,
	offlineFound: any?,
	-- runtime (not saved)
	rt: { [string]: any },
}

local Data = {}
Data.sessions = {} :: { [number]: Session } -- keyed by UserId
local loadedSignal = Instance.new("BindableEvent")
Data.Loaded = loadedSignal.Event
-- Leave callbacks run synchronously BEFORE the final save (so they can settle races etc.).
local leavingFns: { (any) -> () } = {}
function Data.onLeaving(fn: (any) -> ())
	table.insert(leavingFns, fn)
end
local leavingUsers: { [number]: boolean } = {} -- UserIds whose leave save is still running

local function now(): number
	return os.time()
end

function Data.get(player: Player): Session?
	return Data.sessions[player.UserId]
end

function Data.save(s: Session, release: boolean): boolean
	if not s.canSave then
		return false
	end
	if s.rt.closing and not release then
		return false -- the leave save owns the final write (and releases the lock)
	end
	if s.saving then
		-- one save at a time; wait for the running one
		while s.saving do
			task.wait()
		end
	end
	s.saving = true
	s.profile.lastSeen = now()
	local okCall, ok = pcall(Store.save, s.player.UserId, Profile.serialize(s.profile), release)
	s.saving = false
	if not okCall then
		warn("[Data] save errored:", ok)
		ok = false
	end
	if ok then
		s.dirty = false
		s.lastSave = os.clock()
	end
	return ok
end

local function onJoin(player: Player)
	-- a rejoin to this server waits for the previous visit's leave save
	local t0 = os.clock()
	while leavingUsers[player.UserId] and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	local ok, raw = Store.load(player.UserId)
	if not player.Parent then
		if ok then
			Store.release(player.UserId)
		end
		return
	end
	local session: Session
	if not ok then
		warn("[Data] could not load", player.Name, "- playing without saving")
		session = { player = player, profile = Profile.new(now()), canSave = false, dirty = false, saving = false, lastSave = 0, rt = { loadError = "Your save couldn't be loaded, so progress this visit won't be saved. Rejoin to try again." } }
	else
		local profile, why = Profile.migrate(raw, now())
		if not profile then
			warn("[Data] save for", player.Name, "rejected:", why)
			Store.release(player.UserId)
			session = { player = player, profile = Profile.new(now()), canSave = false, dirty = false, saving = false, lastSave = 0, rt = { loadError = "Your save couldn't be read (" .. tostring(why) .. "). Progress this visit won't be saved." } }
		else
			session = { player = player, profile = profile, canSave = true, dirty = false, saving = false, lastSave = os.clock(), rt = {} }
			if profile.stats.milestone == nil then
				Game.newMilestones(profile) -- older saves: mark passed milestones without banners
			end
			if why ~= "new" then
				session.offlineFound = Game.applyReturn(profile, now())
				Game.flushSkips(profile)
			end
		end
	end
	Data.sessions[player.UserId] = session
	loadedSignal:Fire(session)
end

local function onLeave(player: Player)
	local s = Data.sessions[player.UserId]
	if not s then
		return
	end
	s.rt.closing = true
	leavingUsers[player.UserId] = true
	for _, fn in leavingFns do
		local okFn, err = pcall(fn :: any, s)
		if not okFn then
			warn("[Data] leave handler failed:", err)
		end
	end
	Data.save(s, true)
	leavingUsers[player.UserId] = nil
	if Data.sessions[player.UserId] == s then
		Data.sessions[player.UserId] = nil
	end
end

function Data.init()
	Store.init()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	task.spawn(function()
		while true do
			task.wait(5)
			for _, s in Data.sessions do
				if s.canSave and os.clock() - s.lastSave >= Config.AutosaveSeconds then
					task.spawn(Data.save, s, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for _, s in Data.sessions do
			pending += 1
			task.spawn(function()
				Data.save(s, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Extras</string>
            <string name="Source"><![CDATA[--!strict
-- Side systems: ingredient pickups, phone offers, DogDash races, business names, Robux shop.
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Config = require(Shared.Config)
local Dash = require(Shared.Logic.Dash)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Game = require(Shared.Logic.Game)
local Layout = require(Shared.Layout)
local Names = require(Shared.Logic.Names)
local Phone = require(Shared.Logic.Phone)
local Products = require(Shared.Products)
local Data = require("./Data")
local GameService = require("./GameService")
local Models = require(Shared.Models)
local World = require("./World")

local Extras = {}
local Cat = Economy.Catalog
local rng = Random.new()
local function roll(): number
	return rng:NextNumber()
end

---------------------------------------------------------------------------
-- Ingredient pickups: crates appear at the owner's racks; only the owner collects them.
---------------------------------------------------------------------------
local function spawnPickups()
	local cap = Cat.pickups.rackCapacity.value
	while true do
		task.wait(Cat.pickups.spawnEvery.value)
		for _, plot in World.plots do
			local owner = plot.owner
			local s = owner and Data.get(owner)
			if not s or not Game.bizOwned(s.profile, "stand") then
				continue
			end
			local folder = plot.folder:FindFirstChild("Pickups") :: Folder?
			if not folder then
				local f = Instance.new("Folder")
				f.Name = "Pickups"
				f.Parent = plot.folder
				folder = f
			end
			local f = folder :: Folder
			if #f:GetChildren() >= cap then
				continue
			end
			local rack = Layout.racks[rng:NextInteger(1, #Layout.racks)]
			local off = Vector3.new(rng:NextNumber(-3, 3), 0, if rack.X > 0 then -5 else 5)
			local bag = rng:NextNumber() < 0.2
			local m = Models.build(if bag then "MoneyBag" else "IngredientCrate")
			Models.place(m, plot.origin * CFrame.new(rack + Vector3.new(off.Z, 0, off.X)), f)
			local hit = Models.part(m, Vector3.new(4, 4, 4), plot.origin * CFrame.new(rack + Vector3.new(off.Z, 2, off.X)), Color3.new(1, 1, 1), { transparency = 1, collide = false, name = "Hit" })
			local taken = false
			hit.Touched:Connect(function(other)
				if taken then
					return
				end
				local pl = Players:GetPlayerFromCharacter(other.Parent)
				if pl ~= plot.owner or not pl then
					return
				end
				local ss = Data.get(pl)
				local root = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not ss or not root or (root.Position - hit.Position).Magnitude > Cat.pickups.pickupRange.value then
					return
				end
				taken = true
				local v = Game.collectPickup(ss.profile, if bag then 2 else 1) -- bags pay double
				GameService.notify(pl, "cash", { amount = v, source = "pickup", pos = hit.Position })
				m:Destroy()
				GameService.afterChange(ss)
				GameService.sync(ss)
			end)
		end
	end
end

---------------------------------------------------------------------------
-- Phone offers
---------------------------------------------------------------------------
local offerSeq = 0
local function phoneLoop()
	while true do
		task.wait(1)
		local now = os.time()
		for _, s in Data.sessions do
			local rt = s.rt
			rt.phoneNext = rt.phoneNext or now + Cat.phone.firstAfter.value
			local o = rt.offer
			if o and o.state == "open" and now > o.expires then
				o.state = "expired"
				GameService.notify(s.player, "phone", { offer = o, outcome = "expired" })
				rt.offer = nil
				rt.phoneNext = now + Cat.phone.every.value
			end
			if not rt.offer and now >= rt.phoneNext then
				offerSeq += 1
				local offer = Phone.newOffer(offerSeq, Game.incomeRate(s.profile, false), now, roll)
				rt.phoneNext = now + Cat.phone.every.value
				if offer then
					rt.offer = offer
					GameService.notify(s.player, "phone", { offer = offer, outcome = "new" })
				end
			end
		end
	end
end

GameService.register("phone", 0.3, function(s, id, action)
	local o = s.rt.offer
	if not o or o.id ~= id or type(action) ~= "string" then
		return
	end
	local outcome, amount = Phone.respond(o, action, os.time(), roll)
	if outcome == "invalid" then
		return
	end
	if outcome == "accepted" and amount then
		Game.earn(s.profile, amount)
		s.profile.stats.deals = (s.profile.stats.deals or 0) + 1
		GameService.notify(s.player, "cash", { amount = amount, source = "deal" })
		GameService.afterChange(s)
	end
	if o.state ~= "open" then
		s.rt.offer = nil
	end
	GameService.notify(s.player, "phone", { offer = o, outcome = outcome })
	GameService.sync(s)
end)

---------------------------------------------------------------------------
-- DogDash races (server-simulated)
---------------------------------------------------------------------------
GameService.register("dashStart", 1, function(s, pick, fraction)
	local p = s.profile
	if not Game.owns(p, "dash:dashgame") then
		return GameService.toast(s.player, "Buy DogDash the Game first", "error")
	end
	if s.rt.race then
		return
	end
	if os.clock() < (s.rt.raceCooldown or 0) then
		return GameService.toast(s.player, "The racers are resting", "error")
	end
	if type(pick) ~= "number" or type(fraction) ~= "number" then
		return
	end
	local bet = Dash.betAmount(p.cash, fraction)
	if not bet or bet.m <= 0 then
		return GameService.toast(s.player, "You need cash to bet", "error")
	end
	local race = Dash.new(pick, bet, roll)
	if not race then
		return
	end
	p.cash = BigNum.roundCents(BigNum.sub(p.cash, bet))
	s.rt.race = race
	s.rt.raceCooldown = os.clock() + Cat.dash.cooldown.value
	GameService.afterChange(s)
	GameService.sync(s)
	task.spawn(function()
		while s.rt.race == race and not race.winner and not s.rt.closing do
			task.wait(0.1)
			Dash.step(race, 0.1, roll)
			GameService.notify(s.player, "race", { pos = race.pos, pick = race.pick, winner = race.winner, cheers = race.cheers })
		end
		if s.rt.closing and not race.winner then
			return -- settled by the leave handler
		end
		if race.winner then
			local pay = Dash.payout(race)
			if pay.m > 0 then
				Game.earn(p, pay)
			end
			p.stats.races = (p.stats.races or 0) + 1
			GameService.notify(s.player, "raceEnd", { winner = race.winner, pick = race.pick, payout = pay, bet = race.bet })
			GameService.afterChange(s)
			GameService.sync(s)
		end
		s.rt.race = nil
	end)
end)

GameService.register("dashCheer", 0.08, function(s)
	local race = s.rt.race
	if race then
		Dash.cheer(race)
	end
end)

---------------------------------------------------------------------------
-- Business name (rule check + Roblox text filter; fails closed)
---------------------------------------------------------------------------
GameService.register("setName", 2, function(s, raw)
	if s.rt.naming then
		return
	end
	local clean, why = Names.clean(raw)
	if not clean then
		GameService.notify(s.player, "nameResult", { ok = false, msg = why })
		return
	end
	s.rt.naming = true
	local ok, filtered = pcall(function()
		local res = TextService:FilterStringAsync(clean, s.player.UserId, Enum.TextFilterContext.PublicChat)
		return res:GetNonChatStringForBroadcastAsync()
	end)
	s.rt.naming = false
	if not s.player.Parent then
		return
	end
	if not ok then
		GameService.notify(s.player, "nameResult", { ok = false, msg = "Couldn't check that name right now. Try again soon." })
		return
	end
	if filtered ~= clean then
		GameService.notify(s.player, "nameResult", { ok = false, msg = "That name isn't allowed. Try another!" })
		return
	end
	s.profile.name = clean
	GameService.notify(s.player, "nameResult", { ok = true, msg = "Renamed to " .. clean })
	GameService.afterChange(s)
	GameService.sync(s)
end)

---------------------------------------------------------------------------
-- Robux: receipts are idempotent (PurchaseId stored in the profile, saved before granting
-- is acknowledged). Mock purchases (Studio only) run the same handler with fake receipts.
---------------------------------------------------------------------------
local productByKey = Products.byKey
local keyByProductId: { [number]: string } = {}
local keyByPassId: { [number]: string } = {}
for _, p in Products.list do
	if p.id then
		if p.kind == "pass" then
			keyByPassId[p.id] = p.key
		else
			keyByProductId[p.id] = p.key
		end
	end
end

-- Shared grant path. Returns "granted" | "retry".
local function deliver(s: Data.Session, key: string, purchaseId: string): string
	local already = Game.hasReceipt(s.profile, purchaseId)
	local ok, msg = Game.grantProduct(s.profile, key, purchaseId)
	if not ok then
		warn("[Shop] could not grant", key, msg)
		return "retry"
	end
	if not already then
		GameService.notify(s.player, "purchase", { key = key, msg = msg })
		GameService.afterChange(s)
		GameService.sync(s)
	end
	-- the receipt is only acknowledged once it is safely stored
	if s.canSave and not Data.save(s, false) then
		return "retry"
	end
	if not s.canSave then
		-- save is disabled (load failed); do not acknowledge, Roblox will retry next visit
		return "retry"
	end
	return "granted"
end
Extras.deliver = deliver

MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local s = player and Data.get(player)
	local key = keyByProductId[info.ProductId]
	if not s or not key then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local r = deliver(s, key, tostring(info.PurchaseId))
	return if r == "granted" then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
end

local function checkPasses(s: Data.Session)
	for passId, key in keyByPassId do
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(s.player.UserId, passId)
		end)
		if ok and owns and not Game.hasReceipt(s.profile, "pass:" .. passId) then
			deliver(s, key, "pass:" .. passId)
		end
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, bought)
	local s = Data.get(player)
	local key = keyByPassId[passId]
	if s and key and bought then
		deliver(s, key, "pass:" .. passId)
	end
end)

GameService.register("buyProduct", 1, function(s, key)
	local prod = if type(key) == "string" then productByKey[key] else nil
	if not prod then
		return
	end
	if Game.productOwned(s.profile, prod.key) then
		return GameService.toast(s.player, "You already own this", "info")
	end
	if not prod.id then
		return GameService.toast(s.player, "This item isn't on sale yet", "info")
	end
	if prod.kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(s.player, prod.id)
	else
		MarketplaceService:PromptProductPurchase(s.player, prod.id)
	end
end)

local lastMock: { [number]: string } = {}
-- Studio-only test purchases. replay=true re-sends the previous receipt id (duplicate delivery);
-- fail=true simulates a failed grant (nothing changes, receipt not stored).
GameService.register("mockBuy", 0.3, function(s, key, replay, fail)
	if not (Config.MockPurchases and RunService:IsStudio()) then
		return
	end
	local prod = if type(key) == "string" then productByKey[key] else nil
	if not prod then
		return
	end
	if fail == true then
		GameService.toast(s.player, "Test purchase cancelled - nothing was charged or granted", "info")
		return
	end
	if Game.productOwned(s.profile, prod.key) and replay ~= true then
		return GameService.toast(s.player, "You already own this", "info")
	end
	local id = if replay == true and lastMock[s.player.UserId] then lastMock[s.player.UserId] else "mock-" .. HttpService:GenerateGUID(false)
	lastMock[s.player.UserId] = id
	local r = deliver(s, prod.key, id)
	print(string.format("[Shop][mock] %s key=%s receipt=%s -> %s", s.player.Name, prod.key, id, r))
	if replay == true then
		GameService.toast(s.player, "Duplicate receipt delivered - no second grant", "info")
	end
end)

-- Studio-only fast-forward hook for testers (never created in a live server):
--   game.ServerStorage.SHDDev:Invoke("cash", 1, 120)        -- cash = 1e120 for every player
--   game.ServerStorage.SHDDev:Invoke("lifetime", 3.08, 25)  -- lifetime cash (investors on offer)
--   game.ServerStorage.SHDDev:Invoke("investors", 1.5, 3)
--   game.ServerStorage.SHDDev:Invoke("evolutions", 12)
--   game.ServerStorage.SHDDev:Invoke("phone")               -- next phone offer now
--   game.ServerStorage.SHDDev:Invoke("offline", 3600)       -- run the returning-player flow as if away 1 hour
local function devHook()
	if not RunService:IsStudio() then
		return
	end
	local bf = Instance.new("BindableFunction")
	bf.Name = "SHDDev"
	bf.OnInvoke = function(cmd: string, a: number?, b: number?)
		for _, s in Data.sessions do
			local p = s.profile
			if cmd == "cash" then
				p.cash = BigNum.fromParts(a or 1, b or 0)
			elseif cmd == "lifetime" then
				p.lifetime = BigNum.fromParts(a or 1, b or 0)
			elseif cmd == "investors" then
				p.investors = BigNum.fromParts(a or 1, b or 0)
			elseif cmd == "evolutions" then
				p.evolutions = math.max(0, math.floor(a or 0))
			elseif cmd == "phone" then
				s.rt.offer = nil
				s.rt.phoneNext = os.time()
			elseif cmd == "offline" then
				p.lastSeen = os.time() - (a or 3600)
				Game.applyReturn(p, os.time())
				GameService.notify(s.player, "offline", { amount = p.pendingOffline })
			end
			GameService.afterChange(s)
			GameService.sync(s)
		end
		return "ok"
	end
	bf.Parent = game:GetService("ServerStorage")
end

function Extras.init()
	devHook()
	-- leaving mid-race: run it to the finish instantly and settle before the final save
	Data.onLeaving(function(s)
		local race = s.rt.race
		if race and not race.winner then
			local guard = 0
			while not race.winner and guard < 10000 do
				Dash.step(race, 0.1, roll)
				guard += 1
			end
			local pay = Dash.payout(race)
			if pay.m > 0 then
				Game.earn(s.profile, pay)
			end
			s.profile.stats.races = (s.profile.stats.races or 0) + 1
		end
		s.rt.race = nil
		s.rt.offer = nil
	end)
	task.spawn(spawnPickups)
	task.spawn(phoneLoop)
	GameService.onSessionLoaded(function(s)
		checkPasses(s)
	end)
	-- keep Format referenced for future toasts
	local _ = Format
end

return Extras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns the production loop, player actions and state sync. Every action re-validates the
-- request (ownership, range, prerequisites, affordability, rate) and runs without yielding,
-- so repeated or simultaneous requests cannot double-spend or double-grant.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Config = require(Shared.Config)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Game = require(Shared.Logic.Game)
local Layout = require(Shared.Layout)
local Names = require(Shared.Logic.Names)
local Net = require(Shared.Net)
local Products = require(Shared.Products)
local Data = require("./Data")
local World = require("./World")

local GameService = {}

local Action = Net.get("Action")
local StateRemote = Net.get("State")
local Notify = Net.get("Notify")

type Handler = (Data.Session, ...any) -> ()
local handlers: { [string]: { fn: Handler, gap: number } } = {}

function GameService.register(name: string, gap: number, fn: Handler)
	handlers[name] = { fn = fn, gap = gap }
end

function GameService.notify(player: Player, kind: string, data: any)
	Notify:FireClient(player, kind, data)
end

function GameService.toast(player: Player, text: string, kind: string?)
	Notify:FireClient(player, "toast", { text = text, kind = kind or "info" })
end

function GameService.markDirty(s: Data.Session)
	s.rt.dirty = true
end

-- range helpers --------------------------------------------------------------

local function rootPos(player: Player): Vector3?
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

local function nearLot(s: Data.Session, bizId: string): boolean
	local plot = World.plotOf(s.player)
	local pos = rootPos(s.player)
	if not plot or not pos then
		return false
	end
	local lot = Layout.lots[bizId]
	local centre = (plot.origin * CFrame.new(lot.pos)).Position
	return (pos - centre).Magnitude <= Config.InteractRange + lot.size.Magnitude / 2
end

local function nearPad(s: Data.Session, padId: string): boolean
	local plot = World.plotOf(s.player)
	local pos = rootPos(s.player)
	local part = plot and plot.pads[padId]
	if not part or not pos then
		return false
	end
	return (pos - part.Position).Magnitude <= Config.PadRange
end

-- movement power ---------------------------------------------------------------

local function applyWalkSpeed(s: Data.Session)
	local ch = s.player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		local tier = Game.powerTier(s.profile, "runFaster")
		local mult = if tier > 0 then Game.POWERS.runFaster.walkMult[tier] else 1
		hum.WalkSpeed = Config.BaseWalkSpeed * mult
	end
end
GameService.applyWalkSpeed = applyWalkSpeed

-- after any purchase or reset ---------------------------------------------------

local function afterChange(s: Data.Session)
	s.dirty = true
	s.rt.dirty = true
	local plot = World.plotOf(s.player)
	if plot then
		local appeared = World.sync(plot, s.profile, s.profile.name or Names.default(s.player.DisplayName))
		local quiet = not s.rt.synced -- joining: show the plot as it is, no build fanfare
		s.rt.synced = true
		if #appeared > 0 and not quiet then
			GameService.notify(s.player, "built", appeared)
		end
	end
	for _, amount in Game.newMilestones(s.profile) do
		GameService.notify(s.player, "milestone", { kind = "cash", amount = BigNum.new(amount) })
	end
	local skip = Game.flushSkips(s.profile)
	if skip then
		GameService.toast(s.player, "Time skip paid out " .. Format.cash(skip), "cash")
	end
	applyWalkSpeed(s)
end
GameService.afterChange = afterChange

-- snapshot ---------------------------------------------------------------------

local function bigOrNil(b: any): any
	return b
end

function GameService.snapshot(s: Data.Session): any
	local p = s.profile
	local ms = Game.multState(p)
	local biz = {}
	for _, def in Economy.businesses do
		local st = p.biz[def.id]
		local owned = Game.bizOwned(p, def.id)
		local entry: any = { owned = owned }
		if owned then
			local cps = Economy.cyclesPerSecond(ms, def)
			local n1 = Game.levelCost(p, def.id, 1)
			local maxN, maxCost = 0, BigNum.zero
			if table.find(Game.bulkOptions(p), "max") then
				maxN, maxCost = Game.maxAffordable(p, def.id)
			end
			local bulk = {}
			for _, o in Game.bulkOptions(p) do
				if type(o) == "number" and o > 1 then
					bulk[tostring(o)] = Game.levelCost(p, def.id, o)
				end
			end
			entry.level = st.level
			entry.auto = Economy.isAutomated(ms, def)
			entry.running = st.running
			entry.progress = st.progress
			entry.cps = BigNum.toNumber(cps)
			entry.output = Economy.cycleOutput(ms, def, st.level)
			entry.rate = Game.bizRate(p, def.id)
			entry.cost1 = n1
			entry.bulk = bulk
			entry.maxN = maxN
			entry.maxCost = maxCost
			entry.cashMult = Economy.cashMult(ms, def)
			entry.speedMult = Economy.speedMult(ms, def)
		end
		biz[def.id] = entry
	end
	local pads = {}
	for _, pad in Economy.pads do
		local state = 0
		if p.forever[pad.id] then
			state = 3
		elseif p.pads[pad.id] then
			state = 2
		elseif Game.padVisible(p, pad) then
			state = 1
		end
		pads[pad.id] = { s = state, c = if state == 1 then Game.padCost(p, pad) else nil }
	end
	local powers = {}
	for _, pw in Economy.Catalog.powers do
		powers[pw.id] = { tier = Game.powerTier(p, pw.id), bought = p.powers[pw.id] or 0, robux = p.robux.tiers[pw.id] or 0, cost = Game.powerCost(p, pw.id) }
	end
	local owned = {}
	for _, prod in Products.list do
		owned[prod.key] = Game.productOwned(p, prod.key)
	end
	local canAsc, padsOwned, padsTotal = Game.canAscend(p)
	local next = Game.nextPad(p)
	return {
		t = workspace:GetServerTimeNow(),
		cash = p.cash,
		investors = p.investors,
		offered = Game.investorsOffered(p),
		x2 = p.robux.passes.x2investors == true,
		bonusPer = Economy.Catalog.prestige.cashBonusPerInvestor.value,
		rate = Game.incomeRate(p, false),
		autoRate = Game.incomeRate(p, true),
		evo = { n = p.evolutions, recipe = Economy.recipeName(p.evolutions), nextRecipe = Economy.recipeName(p.evolutions + 1), can = not BigNum.lt(p.investors, Economy.evolutionThreshold(p.evolutions)), progress = Game.evolutionProgress(p), need = Economy.evolutionThreshold(p.evolutions), mult = Economy.Catalog.prestige.evolutionSpeedMult.value },
		asc = { n = p.ascensions, can = canAsc, owned = padsOwned, total = padsTotal, cash = Economy.Catalog.prestige.ascensionCashMult.value, price = Economy.Catalog.prestige.ascensionPriceMult.value },
		tokens = p.foreverTokens,
		credits = p.robux.rebirthCredits,
		pendingOffline = p.pendingOffline,
		name = p.name or Names.default(s.player.DisplayName),
		canSave = s.canSave,
		loadError = s.rt.loadError,
		bulk = Game.bulkOptions(p),
		powers = powers,
		owned = owned,
		biz = biz,
		pads = pads,
		nextPad = next and next.id,
		dash = Game.owns(p, "dash:dashgame"),
		decor = p.decor,
		tiers = (function()
			local t = {}
			for _, def in Economy.businesses do
				t[def.id] = if Game.bizOwned(p, def.id) then Game.levelTier(p, def.id) else 0
			end
			return t
		end)(),
		earned = s.rt.earned,
		mock = Config.MockPurchases and game:GetService("RunService"):IsStudio(),
	}
end

local function sync(s: Data.Session)
	StateRemote:FireClient(s.player, GameService.snapshot(s))
	s.rt.earned = nil
	s.rt.dirty = false
end
GameService.sync = sync

-- actions ------------------------------------------------------------------------

local function result(s: Data.Session, ok: boolean, msg: string)
	if ok then
		afterChange(s)
	else
		GameService.toast(s.player, msg, "error")
	end
	sync(s)
end

GameService.register("click", 0.05, function(s, bizId)
	if type(bizId) ~= "string" or not Economy.bizById[bizId] then
		return
	end
	if Game.powerTier(s.profile, "manage") < 1 and not nearLot(s, bizId) then
		return GameService.toast(s.player, "Walk closer, or unlock Manage", "error")
	end
	local ok = Game.click(s.profile, bizId)
	if ok then
		s.rt.dirty = true
		sync(s)
	end
end)

GameService.register("upgrade", 0.05, function(s, bizId, count)
	if type(bizId) ~= "string" or not Economy.bizById[bizId] then
		return
	end
	if not (count == "max" or type(count) == "number") then
		return
	end
	if Game.powerTier(s.profile, "manage") < 1 and not nearLot(s, bizId) then
		return GameService.toast(s.player, "Walk closer, or unlock Manage", "error")
	end
	local tierBefore = Game.levelTier(s.profile, bizId)
	local ok, msg, n = Game.upgradeLevel(s.profile, bizId, count)
	if ok then
		GameService.notify(s.player, "leveled", { bizId = bizId, n = n, level = s.profile.biz[bizId].level })
		if Game.levelTier(s.profile, bizId) > tierBefore then
			GameService.notify(s.player, "milestone", { kind = "level", bizId = bizId, level = s.profile.biz[bizId].level })
		end
	end
	result(s, ok, msg)
end)

local function tryPad(s: Data.Session, padId: string, how: string)
	local pad = Economy.padById[padId]
	if not pad then
		return
	end
	if how == "remote" and Game.powerTier(s.profile, "remoteBuy") < 1 and not nearPad(s, padId) then
		return GameService.toast(s.player, "Step on the circle, or unlock Remote Buy", "error")
	end
	local ok, msg = Game.buyPad(s.profile, padId)
	if ok then
		GameService.notify(s.player, "bought", { padId = padId, name = pad.name, kind = pad.kind, mult = pad.mult, bizId = pad.bizId })
		if pad.kind == "unlock" then
			GameService.notify(s.player, "milestone", { kind = "unlock", name = pad.name })
		end
	end
	result(s, ok, msg)
end

GameService.register("buyPad", 0.1, function(s, padId)
	if type(padId) == "string" then
		tryPad(s, padId, "remote")
	end
end)

GameService.register("buyNext", 0.15, function(s)
	if Game.powerTier(s.profile, "remoteBuy") < 1 then
		return GameService.toast(s.player, "Remote Buy is locked", "error")
	end
	local nextPad = Game.nextPad(s.profile)
	if nextPad then
		tryPad(s, nextPad.id, "remote")
	end
end)

GameService.register("buyDecor", 0.2, function(s, id)
	if type(id) ~= "string" then
		return
	end
	local ok, msg = Game.buyDecor(s.profile, id)
	if ok then
		GameService.notify(s.player, "decor", { id = id, msg = msg })
	end
	result(s, ok, msg)
end)

GameService.register("buyPower", 0.2, function(s, id)
	if type(id) ~= "string" then
		return
	end
	local ok, msg = Game.buyPower(s.profile, id)
	if ok then
		GameService.toast(s.player, msg, "good")
	end
	result(s, ok, msg)
end)

-- Prestige can't run while value from the current run is still in flight.
local function prestigeBlocked(s: Data.Session): boolean
	if s.rt.race then
		GameService.toast(s.player, "Finish your DogDash race first", "error")
		return true
	end
	if s.rt.offer then
		s.rt.offer.state = "expired"
		GameService.notify(s.player, "phone", { offer = s.rt.offer, outcome = "expired" })
		s.rt.offer = nil
	end
	return false
end

GameService.register("rebirth", 1, function(s)
	if prestigeBlocked(s) then
		return
	end
	local ok, msg, award = Game.rebirth(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "rebirth", amount = award })
	end
	result(s, ok, msg)
end)

GameService.register("rebirthNoReset", 1, function(s)
	if prestigeBlocked(s) then
		return
	end
	local ok, msg, award = Game.rebirthNoReset(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "rebirthNoReset", amount = award })
	end
	result(s, ok, msg)
end)

GameService.register("evolve", 1, function(s)
	if prestigeBlocked(s) then
		return
	end
	local ok, msg = Game.evolve(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "evolve", recipe = Economy.recipeName(s.profile.evolutions) })
	end
	result(s, ok, msg)
end)

GameService.register("ascend", 1, function(s)
	if prestigeBlocked(s) then
		return
	end
	local ok, msg = Game.ascend(s.profile)
	if ok then
		GameService.notify(s.player, "prestige", { kind = "ascend", n = s.profile.ascensions })
	end
	result(s, ok, msg)
end)

GameService.register("forever", 0.5, function(s, padId)
	if type(padId) ~= "string" then
		return
	end
	local ok, msg = Game.useForever(s.profile, padId)
	if ok then
		GameService.toast(s.player, msg, "good")
	end
	result(s, ok, msg)
end)

GameService.register("claimOffline", 0.5, function(s)
	local ok, msg, amount = Game.claimOffline(s.profile)
	if ok then
		GameService.notify(s.player, "cash", { amount = amount, source = "offline" })
	end
	result(s, ok, msg)
end)

GameService.register("sync", 0.5, function(s)
	sync(s)
end)

-- incoming ------------------------------------------------------------------------

local lastCall: { [number]: { [string]: number } } = {} -- keyed by UserId
local burst: { [number]: { n: number, t: number } } = {}

Action.OnServerEvent:Connect(function(player: Player, name: any, ...)
	if type(name) ~= "string" then
		return
	end
	local h = handlers[name]
	local s = Data.get(player)
	if not h or not s then
		return
	end
	local now = os.clock()
	-- global burst cap: 40 requests per second per player
	local b: { n: number, t: number } = burst[player.UserId] or { n = 0, t = now }
	if now - b.t >= 1 then
		b = { n = 0, t = now }
	end
	burst[player.UserId] = b
	b.n += 1
	if b.n > 40 then
		return
	end
	local calls = lastCall[player.UserId]
	if not calls then
		calls = {}
		lastCall[player.UserId] = calls
	end
	if now - (calls[name] or 0) < h.gap then
		return
	end
	calls[name] = now
	local ok, err = pcall(h.fn :: any, s, ...)
	if not ok then
		warn("[GameService] action", name, "failed:", err)
	end
end)

-- world callbacks -------------------------------------------------------------------

local touchGap: { [number]: number } = {}
World.onPadTouched = function(player, padId)
	local s = Data.get(player)
	if not s then
		return
	end
	local now = os.clock()
	if now - (touchGap[player.UserId] or 0) < 0.4 then
		return
	end
	touchGap[player.UserId] = now
	local p = s.profile
	local pad = Economy.padById[padId]
	if not pad or Game.owns(p, padId) or not Game.padVisible(p, pad) then
		return
	end
	if BigNum.lt(p.cash, Game.padCost(p, pad)) then
		GameService.toast(player, "Need " .. Format.cash(Game.padCost(p, pad)) .. " for " .. pad.name, "error")
		return
	end
	tryPad(s, padId, "touch")
end

World.onBizPrompt = function(player, bizId)
	local h = handlers.click
	local s = Data.get(player)
	if s then
		h.fn(s, bizId)
	end
end

World.onExtraPrompt = function(player, action)
	GameService.notify(player, "open", action)
end

-- lifecycle ---------------------------------------------------------------------------

local function spawnAtPlot(player: Player, character: Model)
	local plot = World.plotOf(player)
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if plot and root then
		task.wait()
		character:PivotTo(plot.origin * CFrame.new(Layout.spawn) * CFrame.Angles(0, math.pi, 0))
	end
	local s = Data.get(player)
	if s then
		applyWalkSpeed(s)
	end
end

local onLoaded: { (Data.Session) -> () } = {}
function GameService.onSessionLoaded(fn: (Data.Session) -> ())
	table.insert(onLoaded, fn)
end

function GameService.init()
	Data.Loaded:Connect(function(s: Data.Session)
		local plot = World.assign(s.player)
		if not plot then
			s.player:Kick("This server is full. Please try another server!")
			return
		end
		afterChange(s)
		sync(s)
		if s.offlineFound and BigNum.toNumber(s.profile.pendingOffline) > 0 then
			GameService.notify(s.player, "offline", { amount = s.profile.pendingOffline, seconds = nil })
		end
		if s.rt.loadError then
			GameService.notify(s.player, "loadError", s.rt.loadError)
		end
		if s.player.Character then
			task.spawn(spawnAtPlot, s.player, s.player.Character)
		end
		for _, fn in onLoaded do
			task.spawn(fn, s)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(ch)
			spawnAtPlot(player, ch)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function(ch)
			spawnAtPlot(player, ch)
		end)
	end
	Data.onLeaving(function(s: Data.Session)
		World.release(s.player)
		lastCall[s.player.UserId] = nil
		burst[s.player.UserId] = nil
		touchGap[s.player.UserId] = nil
	end)

	-- production loop: fixed steps, aggregated grants, snapshots at SyncSeconds
	task.spawn(function()
		local acc, syncAcc = 0, 0
		local last = os.clock()
		while true do
			task.wait(Config.StepSeconds)
			local now = os.clock()
			local dt = math.min(now - last, 1)
			last = now
			acc += dt
			syncAcc += dt
			for _, s in Data.sessions do
				if not World.plotOf(s.player) then
					continue
				end
				local grants = Game.step(s.profile, dt)
				if #grants > 0 then
					s.dirty = true
					s.rt.dirty = true
					local earned = s.rt.earned or {}
					for _, g in grants do
						local e = earned[g.bizId]
						if e then
							e.amount = BigNum.add(e.amount, g.amount)
							e.cycles += math.max(g.cycles, 0)
						else
							earned[g.bizId] = { amount = g.amount, cycles = math.max(g.cycles, 0) }
						end
					end
					s.rt.earned = earned
					if s.rt.prevCanSee == nil or s.rt.prevPadsTick ~= nil then
						-- pads become affordable as cash grows; plot visuals don't depend on cash
					end
				end
			end
			if syncAcc >= Config.SyncSeconds then
				syncAcc = 0
				for _, s in Data.sessions do
					for _, amount in Game.newMilestones(s.profile) do
						GameService.notify(s.player, "milestone", { kind = "cash", amount = BigNum.new(amount) })
					end
				end
				for _, s in Data.sessions do
					if s.rt.dirty and World.plotOf(s.player) then
						sync(s)
					end
				end
			end
		end
	end)
end

GameService.handlers = handlers
GameService._bigOrNil = bigOrNil
return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!strict
-- Save storage behind one interface. "mock" = in-memory (default; nothing leaves the server),
-- "datastore" = Roblox DataStore with retries and a simple session lock.
-- Failure injection for tests (Studio): workspace attributes
--   SHD_FailLoads = n   next n loads fail
--   SHD_FailSaves = n   next n saves fail
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Store = {}

local mock: { [string]: string } = {} -- JSON per key, like a real store
local store: GlobalDataStore? = nil
local JOB = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local LOCK_SECONDS = Config.AutosaveSeconds * 3 -- autosave refreshes it; a crash frees it soon

Store.mode = Config.Storage

local function injected(attr: string): boolean
	local n = workspace:GetAttribute(attr)
	if type(n) == "number" and n > 0 then
		workspace:SetAttribute(attr, n - 1)
		return true
	end
	return false
end

function Store.init()
	if Store.mode == "datastore" then
		local ok, res = pcall(function()
			return DataStoreService:GetDataStore(Config.DataStoreName)
		end)
		if ok then
			store = res
		else
			warn("[Store] DataStore unavailable, falling back to mock storage:", res)
			Store.mode = "mock"
		end
	end
	print("[Store] mode =", Store.mode)
end

local function key(userId: number): string
	return "u_" .. tostring(userId)
end

-- Returns ok, data (nil data = no save yet). ok=false means "could not read": never treat as new.
function Store.load(userId: number): (boolean, any)
	for attempt = 1, Config.LoadRetries do
		if injected("SHD_FailLoads") then
			warn(string.format("[Store] load attempt %d failed (injected)", attempt))
			task.wait(0.2 * attempt)
			continue
		end
		if Store.mode == "mock" then
			local raw = mock[key(userId)]
			if raw == nil then
				return true, nil
			end
			return true, HttpService:JSONDecode(raw).data
		end
		local ds = store :: GlobalDataStore
		local result: any = nil
		local locked = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(userId), function(old)
				old = old or {}
				local lock = old.lock
				if type(lock) == "table" and lock.job ~= JOB and os.time() - (lock.t or 0) < LOCK_SECONDS then
					locked = true
					return nil -- cancel: another server still holds this profile
				end
				old.lock = { job = JOB, t = os.time() }
				result = old.data
				return old
			end)
		end)
		if ok and not locked then
			return true, result
		end
		warn(string.format("[Store] load attempt %d failed: %s", attempt, if locked then "session locked by another server" else tostring(err)))
		task.wait(2 ^ attempt)
	end
	return false, nil
end

-- release = true on leave/shutdown (drops the session lock).
function Store.save(userId: number, data: any, release: boolean): boolean
	if injected("SHD_FailSaves") then
		warn("[Store] save failed (injected)")
		return false
	end
	if Store.mode == "mock" then
		mock[key(userId)] = HttpService:JSONEncode({ data = data })
		return true
	end
	local ds = store :: GlobalDataStore
	for attempt = 1, 3 do
		local blocked = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(userId), function(old)
				old = old or {}
				if type(old.lock) == "table" and old.lock.job ~= JOB and os.time() - (old.lock.t or 0) < LOCK_SECONDS then
					blocked = true
					return nil -- someone else owns it now; do not clobber
				end
				old.data = data
				old.lock = if release then nil else { job = JOB, t = os.time() }
				return old
			end)
		end)
		if ok and blocked then
			warn("[Store] save skipped: profile is locked by another server")
			return false
		end
		if ok then
			return true
		end
		warn(string.format("[Store] save attempt %d failed: %s", attempt, tostring(err)))
		task.wait(attempt)
	end
	return false
end

-- Drop our session lock without writing data (load succeeded but the session won't be used).
function Store.release(userId: number)
	if Store.mode ~= "datastore" then
		return
	end
	local ds = store :: GlobalDataStore
	pcall(function()
		ds:UpdateAsync(key(userId), function(old)
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job == JOB then
				old.lock = nil
				return old
			end
			return nil
		end)
	end)
end

-- Test helpers (mock mode only).
function Store._mockRaw(userId: number): string?
	return mock[key(userId)]
end
function Store._mockPut(userId: number, json: string)
	mock[key(userId)] = json
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the roadside world and every plot, then shows/hides each plot's pads, buildings and
-- props to match its owner's profile. Hidden pieces wait in ServerStorage (cheap to toggle).
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Economy = require(Shared.Logic.Economy)
local Game = require(Shared.Logic.Game)
local Format = require(Shared.Logic.Format)
local Models = require(Shared.Models)

local C = Models.Colors
local part = Models.part

local World = {}

export type Plot = {
	index: number,
	origin: CFrame,
	folder: Folder,
	hidden: Folder,
	owner: Player?,
	pads: { [string]: BasePart }, -- pad parts
	padModels: { [string]: Model }, -- prop shown once the pad is owned
	buildings: { [string]: Model },
	anchors: { [string]: BasePart },
	prompts: { [string]: ProximityPrompt },
	extras: { [string]: Model }, -- portal, staircase, investor kiosk
	decor: { [string]: Model }, -- looks-only decorations by decor id
	tiers: { [string]: Model }, -- level-milestone props, key bizId .. ":" .. tier
	sign: BasePart,
	shown: { [string]: boolean? }, -- keyed by "pad:"/"prop:"/"biz:"/"extra:" + id
}

World.plots = {} :: { Plot }
-- callbacks set by GameService
World.onPadTouched = nil :: ((Player, string) -> ())?
World.onBizPrompt = nil :: ((Player, string) -> ())?
World.onExtraPrompt = nil :: ((Player, string) -> ())?
local register: (string, any, string, string, CFrame, number?) -> ()

local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(120, 115, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 145, 140)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.6
	local function ensure(cls: string, name: string): Instance
		local x = Lighting:FindFirstChild(name)
		if not x then
			x = Instance.new(cls)
			x.Name = name
			x.Parent = Lighting
		end
		return x :: Instance
	end
	local atm = ensure("Atmosphere", "Atmosphere") :: Atmosphere
	atm.Density = 0.22
	atm.Haze = 0.6
	atm.Color = Color3.fromRGB(200, 230, 255)
	atm.Decay = Color3.fromRGB(150, 200, 240)
	atm.Glare = 0.15
	local sky = ensure("Sky", "Sky") :: Sky
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 9
	sky.StarCount = 1500
	-- painted original skybox once uploaded (assets/sky/*.png -> AssetIds.Images)
	local AssetIds = require(Shared.AssetIds)
	local faces: { [string]: string } = { SkyboxBk = "sky_bk", SkyboxDn = "sky_dn", SkyboxFt = "sky_ft", SkyboxLf = "sky_lf", SkyboxRt = "sky_rt", SkyboxUp = "sky_up" }
	for prop, img in faces do
		local id = AssetIds.Images[img]
		if id then
			(sky :: any)[prop] = string.format("rbxthumb://type=Asset&id=%d&w=420&h=420", id)
		end
	end
	-- soft 3D clouds (built-in, nothing to upload)
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain and not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.58
		clouds.Density = 0.55
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
	local cc = ensure("ColorCorrectionEffect", "Vibrance") :: ColorCorrectionEffect
	cc.Saturation = 0.18
	cc.Contrast = 0.05
	cc.Brightness = 0.02
	local bloom = ensure("BloomEffect", "Bloom") :: BloomEffect
	bloom.Intensity = 0.35
	bloom.Size = 20
	bloom.Threshold = 1.6
end

local function tree(parent: Instance, pos: Vector3, scale: number)
	local m = Instance.new("Model")
	m.Name = "Tree"
	Models.part(m, Vector3.new(1.4, 6, 1.4) * scale, CFrame.new(pos + Vector3.new(0, 3 * scale, 0)), C.woodDark)
	local leaf = Color3.fromRGB(90, 185, 85)
	local p1 = Models.part(m, Vector3.new(7, 7, 7) * scale, CFrame.new(pos + Vector3.new(0, 8 * scale, 0)), leaf)
	p1.Shape = Enum.PartType.Ball
	local p2 = Models.part(m, Vector3.new(5, 5, 5) * scale, CFrame.new(pos + Vector3.new(1.8, 6.8, 1) * scale), Color3.fromRGB(110, 200, 95))
	p2.Shape = Enum.PartType.Ball
	m.Parent = parent
end

local function flowers(parent: Instance, pos: Vector3, w: number)
	part(parent, Vector3.new(w, 0.6, 3), CFrame.new(pos + Vector3.new(0, 0.3, 0)), C.woodDark)
	local cols = { C.ketchup, C.mustard, C.cream, C.violet }
	for i = 0, math.floor(w / 1.5) - 1 do
		local f = part(parent, Vector3.new(0.9, 0.9, 0.9), CFrame.new(pos + Vector3.new(-w / 2 + 0.75 + i * 1.5, 1, (i % 2) * 0.8 - 0.4)), cols[i % #cols + 1])
		f.Shape = Enum.PartType.Ball
		f.CanCollide = false
	end
end

local function buildEnvironment()
	local env = Instance.new("Folder")
	env.Name = "Environment"
	env.Parent = workspace
	local width = Layout.PLOT_SPACING * Config.Plots + 400
	local cx = Layout.PLOT_SPACING * (Config.Plots - 1) / 2
	local ground = part(env, Vector3.new(width, 2, 900), CFrame.new(cx, -1, 160), Color3.fromRGB(110, 190, 90), { material = Enum.Material.Grass, name = "Ground" })
	ground.CastShadow = false
	-- the road along the front of every plot
	part(env, Vector3.new(width, 0.2, 16), CFrame.new(cx, 0.1, Layout.ROAD_Z), Color3.fromRGB(70, 72, 80), { material = Enum.Material.Asphalt, name = "Road" })
	for x = -width / 2, width / 2, 12 do
		part(env, Vector3.new(6, 0.22, 0.6), CFrame.new(cx + x, 0.12, Layout.ROAD_Z), C.mustard, { collide = false })
	end
	for _, dz in { -9.5, 9.5 } do
		part(env, Vector3.new(width, 0.5, 3), CFrame.new(cx, 0.25, Layout.ROAD_Z + dz), Color3.fromRGB(225, 220, 210), { material = Enum.Material.Concrete })
	end
	-- far side of the road: trees and a little hill line
	for x = -width / 2 + 10, width / 2 - 10, 18 do
		tree(env, Vector3.new(cx + x + (x % 7), 0, Layout.ROAD_Z - 22 - (x % 11)), 1 + (x % 5) / 10)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FallbackSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(cx, 0.5, Layout.ROAD_Z)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Parent = env
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
end

local function label(parent: BasePart, title: string, sub: string, color: Color3)
	local bb = Instance.new("BillboardGui")
	bb.Name = "PadLabel"
	bb.Size = UDim2.fromScale(9, 3.2)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 3.6, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = parent
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 0.55)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = title
	t.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 2.5
	st.Color = Color3.fromRGB(40, 30, 20)
	st.Parent = t
	local p = Instance.new("TextLabel")
	p.Name = "Price"
	p.BackgroundTransparency = 1
	p.Position = UDim2.fromScale(0, 0.55)
	p.Size = UDim2.fromScale(1, 0.45)
	p.Font = Enum.Font.FredokaOne
	p.TextScaled = true
	p.TextColor3 = color
	p.Text = sub
	p.Parent = bb
	local st2 = st:Clone()
	st2.Parent = p
end

local function makePad(plot: Plot, pad: Economy.PadDef, pos: Vector3)
	local cf = plot.origin * CFrame.new(pos + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local isUnlock = pad.kind == "unlock"
	local d = if isUnlock then 10 else 7
	local base = part(plot.hidden, Vector3.new(0.5, d, d), cf, if isUnlock then C.mustard else C.relish, { shape = Enum.PartType.Cylinder, name = pad.id })
	base.CanCollide = false
	base.CastShadow = false
	base:SetAttribute("PadId", pad.id)
	base:SetAttribute("Plot", plot.index)
	local ring = part(base, Vector3.new(0.55, d * 0.78, d * 0.78), cf * CFrame.new(0.02, 0, 0), C.cream, { shape = Enum.PartType.Cylinder, collide = false })
	ring.CastShadow = false
	ring.Name = "Ring"
	local core = part(base, Vector3.new(0.6, d * 0.66, d * 0.66), cf * CFrame.new(0.04, 0, 0), if isUnlock then C.ketchup else C.teal, { shape = Enum.PartType.Cylinder, collide = false, neon = false })
	core.CastShadow = false
	core.Name = "Core"
	label(base, pad.name, Format.cash(pad.cost), Color3.fromRGB(140, 255, 140))
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "NewSparkle"
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Rate = 6
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.SpreadAngle = Vector2.new(30, 30)
	sparkle.Size = NumberSequence.new(0.5)
	sparkle.Color = ColorSequence.new(C.mustard)
	sparkle.EmissionDirection = Enum.NormalId.Right -- local +X is world up for this cylinder
	sparkle.Parent = base
	base.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if player and player == plot.owner and World.onPadTouched then
			World.onPadTouched(player, pad.id)
		end
	end)
	plot.pads[pad.id] = base
end

-- Props that appear as a business reaches its level milestones (catalog progress.levelMilestones).
local TIER_MODELS = { "PicnicTable", "PatioUmbrella", "BalloonBunch", "HotDogStatue" }

-- Every placed model by asset name, so uploaded meshes can replace the stand-ins later.
type Slot = { plot: Plot, kind: string, key: string, cf: CFrame, fit: number? }
local slots: { [string]: { Slot } } = {}
register = function(name: string, plot: Plot, kind: string, key: string, cf: CFrame, fit: number?)
	local list = slots[name]
	if not list then
		list = {}
		slots[name] = list
	end
	table.insert(list, { plot = plot, kind = kind, key = key, cf = cf, fit = fit })
end

-- Swap the stand-ins of `name` for the freshly loaded mesh (keeps signs, prompts and labels).
local KEEP = { NameSign = true, BizSign = true }
function World.swap(name: string)
	local list: { Slot } = slots[name] or {}
	for _, slot in list do
		local plot = slot.plot
		local old: Model?
		if slot.kind == "racks" then
			old = (plot.folder :: any).Decor:FindFirstChild(slot.key) :: Model?
		elseif slot.kind == "decorChild" then
			local id, i = slot.key:match("^(.-)|(%d+)$")
			local container = plot.decor[id :: string]
			old = container and container:FindFirstChild(tostring(id) .. "_" .. tostring(i)) :: Model?
		else
			old = (plot :: any)[slot.kind][slot.key]
		end
		if not old then
			continue
		end
		local m = Models.build(name)
		if slot.fit then
			Models.fit(m, slot.fit)
		end
		m:PivotTo(slot.cf)
		m.Name = old.Name
		for _, child in old:GetChildren() do
			if KEEP[child.Name] or (child:IsA("BasePart") and child:FindFirstChildWhichIsA("ProximityPrompt")) then
				child.Parent = m
			end
		end
		m.Parent = old.Parent
		old:Destroy()
		if slot.kind ~= "racks" and slot.kind ~= "decorChild" then
			(plot :: any)[slot.kind][slot.key] = m
		end
	end
end

local function buildPlot(index: number): Plot
	local origin = Layout.plotOrigin(index)
	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. index
	folder.Parent = workspace:WaitForChild("Plots")
	local hidden = Instance.new("Folder")
	hidden.Name = "Plot" .. index
	hidden.Parent = ServerStorage:WaitForChild("PlotStore")
	local plot: Plot = {
		index = index,
		origin = origin,
		folder = folder,
		hidden = hidden,
		owner = nil,
		pads = {},
		padModels = {},
		buildings = {},
		anchors = {},
		prompts = {},
		extras = {},
		decor = {},
		tiers = {},
		sign = nil :: any,
		shown = {},
	}
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder

	-- driveway, central path and lot bases
	part(decor, Vector3.new(14, 0.3, 370), origin * CFrame.new(0, 0.15, 185), Color3.fromRGB(235, 222, 196), { material = Enum.Material.Pebble, name = "Path" })
	for id, lot in Layout.lots do
		local base = part(decor, Vector3.new(lot.size.X, 0.4, lot.size.Y), origin * CFrame.new(lot.pos + Vector3.new(0, 0.2, 0)), if id == "stand" then Color3.fromRGB(240, 226, 196) else Color3.fromRGB(214, 222, 228), { material = Enum.Material.Concrete, name = id .. "Lot" })
		base.CastShadow = false
		if id ~= "stand" and id ~= "hotdogx" then
			-- spur from the central path (half-width 7) to the lot's inner edge
			local inner = math.abs(lot.pos.X) - lot.size.X / 2
			local sign = if lot.pos.X > 0 then 1 else -1
			part(decor, Vector3.new(inner - 7 + 1, 0.3, 8), origin * CFrame.new(sign * (7 + inner) / 2, 0.16, lot.pos.Z), Color3.fromRGB(235, 222, 196), { material = Enum.Material.Pebble })
		end
	end
	-- round plaza on the path between the first and second rows (fountain spot)
	local plaza = part(decor, Vector3.new(0.32, 26, 26), origin * CFrame.new(Layout.plaza + Vector3.new(0, 0.17, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(232, 214, 186), { shape = Enum.PartType.Cylinder, material = Enum.Material.Pebble, name = "Plaza" })
	plaza.CastShadow = false
	-- plot border hedges with a gap at the road
	for _, x in { -Layout.PLOT_HALF_WIDTH, Layout.PLOT_HALF_WIDTH } do
		part(decor, Vector3.new(3, 3, Layout.PLOT_DEPTH - 20), origin * CFrame.new(x, 1.5, Layout.PLOT_DEPTH / 2 + 4), Color3.fromRGB(80, 160, 70), { material = Enum.Material.Grass })
	end
	-- landscaping kept off lots, pads and the path
	for _, z in { 64, 140, 220, 300, 372 } do
		tree(decor, origin.Position + Vector3.new(-98, 0, z), 1.1)
		tree(decor, origin.Position + Vector3.new(98, 0, z + 8), 1.2)
	end
	for _, z in { 64, 160, 212, 288 } do
		flowers(decor, origin.Position + Vector3.new(-12, 0, z), 6)
		flowers(decor, origin.Position + Vector3.new(12, 0, z), 6)
	end
	-- plot sign by the road
	local signModel = Instance.new("Model")
	signModel.Name = "PlotSign"
	part(signModel, Vector3.new(0.8, 7, 0.8), origin * CFrame.new(-11, 3.5, -8), C.woodDark)
	part(signModel, Vector3.new(0.8, 7, 0.8), origin * CFrame.new(11, 3.5, -8), C.woodDark)
	plot.sign = Models.sign(signModel, Vector3.new(24, 3.4, 0.5), origin * CFrame.new(0, 7.6, -8), C.mustard, "Open plot", C.ketchup)
	signModel.Parent = decor

	-- spawn point
	local spawn = Instance.new("Part")
	spawn.Name = "SpawnPoint"
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.Transparency = 1
	spawn.Size = Vector3.new(4, 1, 4)
	spawn.CFrame = origin * CFrame.new(Layout.spawn)
	spawn.Parent = folder

	-- pads, buildings, props, label anchors
	for _, pad in Economy.pads do
		if pad.kind == "unlock" then
			makePad(plot, pad, Layout.unlockPos(pad.bizId))
		end
	end
	local anchors = Instance.new("Folder")
	anchors.Name = "Anchors"
	anchors.Parent = folder
	for _, biz in Economy.businesses do
		local lot = Layout.lots[biz.id]
		local b = Models.build(Models.BUILDING_FOR[biz.id])
		Models.place(b, origin * CFrame.new(lot.pos), plot.hidden)
		b.Name = biz.id
		plot.buildings[biz.id] = b
		register(Models.BUILDING_FOR[biz.id], plot, "buildings", biz.id, origin * CFrame.new(lot.pos), nil)
		-- extra props that appear as the business reaches level milestones
		for tier, model in TIER_MODELS do
			local cf = origin * CFrame.new(Layout.tierPos(biz.id, tier))
			local tm = Models.build(model)
			Models.fit(tm, 7)
			Models.place(tm, cf, plot.hidden)
			tm.Name = "Tier_" .. biz.id .. "_" .. tier
			plot.tiers[biz.id .. ":" .. tier] = tm
			register(model, plot, "tiers", biz.id .. ":" .. tier, cf, 7)
		end
		local nProps = 0
		for _, pad in biz.pads do
			if pad.kind ~= "structure" then
				nProps += 1
			end
		end
		local slot = 0
		for k, pad in biz.pads do
			makePad(plot, pad, Layout.padPos(biz.id, k))
			local prop = Models.build(pad.model or "Sign")
			if pad.kind == "structure" then
				-- floors and walls belong to the whole lot
				Models.place(prop, origin * CFrame.new(lot.pos), plot.hidden)
				register(pad.model or "Sign", plot, "padModels", pad.id, origin * CFrame.new(lot.pos), nil)
			else
				slot += 1
				Models.fit(prop, Layout.PROP_SLOT)
				local cf = origin * CFrame.new(Layout.propPos(biz.id, slot, nProps))
				Models.place(prop, cf, plot.hidden)
				register(pad.model or "Sign", plot, "padModels", pad.id, cf, Layout.PROP_SLOT)
			end
			prop.Name = "Prop_" .. pad.id
			plot.padModels[pad.id] = prop
		end
		local anchor = part(anchors, Vector3.new(1, 1, 1), origin * CFrame.new(lot.pos + Vector3.new(0, if biz.id == "stand" then 17 else 24, -lot.size.Y / 2 + 2)), C.white, { transparency = 1, collide = false, name = biz.id })
		anchor.CanQuery = false
		anchor:SetAttribute("BizId", biz.id)
		plot.anchors[biz.id] = anchor
		-- Sell/Start prompt on the front of the lot
		local promptPart = part(anchors, Vector3.new(1, 1, 1), origin * CFrame.new(lot.pos + Vector3.new(0, 3, -lot.size.Y / 2 + 4)), C.white, { transparency = 1, collide = false, name = biz.id .. "Prompt" })
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Sell"
		prompt.ObjectText = biz.name
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = promptPart
		prompt.Triggered:Connect(function(player)
			if player == plot.owner and World.onBizPrompt then
				World.onBizPrompt(player, biz.id)
			end
		end)
		plot.prompts[biz.id] = prompt
	end

	-- prestige landmarks (shown when relevant)
	local function extra(name: string, model: string, pos: Vector3, action: string, text: string)
		local m = Models.build(model)
		Models.place(m, origin * CFrame.new(pos), plot.hidden)
		m.Name = name
		local pp = part(m, Vector3.new(1, 1, 1), origin * CFrame.new(pos + Vector3.new(0, 3, -4)), C.white, { transparency = 1, collide = false })
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = text
		prompt.ObjectText = ""
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt.Parent = pp
		prompt.Triggered:Connect(function(player)
			if player == plot.owner and World.onExtraPrompt then
				World.onExtraPrompt(player, action)
			end
		end)
		plot.extras[name] = m
		register(model, plot, "extras", name, origin * CFrame.new(pos), nil)
	end
	extra("InvestorKiosk", "AlienInvestor", Layout.investorDesk + Vector3.new(-10, 0, 0), "investors", "Alien Investors")
	extra("Portal", "CosmicPortal", Layout.portal, "evolve", "Void Evolution")
	extra("Staircase", "Staircase", Layout.staircase, "ascend", "Ascension")

	-- looks-only decorations (shown once bought): one container per item holding every placement
	for _, item in Economy.Catalog.decor.items do
		local spots = Layout.decorSpots[item.id]
		if spots then
			local container = Instance.new("Model")
			container.Name = "Decor_" .. item.id
			for i, sp in spots do
				-- models face -Z; lookAt points -Z at the target, so the front faces `face`
				local cf = origin * CFrame.lookAt(sp.pos, sp.pos + sp.face)
				local m = Models.build(item.model)
				Models.place(m, cf, container)
				m.Name = item.id .. "_" .. i
				register(item.model, plot, "decorChild", item.id .. "|" .. i, cf, nil)
			end
			container.WorldPivot = origin * CFrame.new(spots[1].pos)
			container.Parent = plot.hidden
			plot.decor[item.id] = container
		end
	end

	-- ingredient racks (always there; crates are spawned by the Pickups service)
	for i, pos in Layout.racks do
		local r = Models.build("IngredientRack")
		local cf = origin * CFrame.new(pos) * CFrame.Angles(0, if pos.X > 0 then math.rad(-90) else math.rad(90), 0)
		Models.place(r, cf, decor)
		r.Name = "Rack" .. i
		register("IngredientRack", plot, "racks", "Rack" .. i, cf, nil)
	end
	return plot
end

function World.init()
	setupLighting()
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace
	local store = Instance.new("Folder")
	store.Name = "PlotStore"
	store.Parent = ServerStorage
	buildEnvironment()
	for i = 1, Config.Plots do
		table.insert(World.plots, buildPlot(i))
	end
end

function World.assign(player: Player): Plot?
	for _, plot in World.plots do
		if plot.owner == nil then
			plot.owner = player
			player:SetAttribute("Plot", plot.index)
			return plot
		end
	end
	return nil
end

function World.release(player: Player)
	for _, plot in World.plots do
		if plot.owner == player then
			plot.owner = nil
			player:SetAttribute("Plot", nil)
			local pickups = plot.folder:FindFirstChild("Pickups")
			if pickups then
				pickups:Destroy()
			end
			World.reset(plot)
		end
	end
end

function World.plotOf(player: Player): Plot?
	local i = player:GetAttribute("Plot")
	local plot = if type(i) == "number" then World.plots[i] else nil
	return if plot and plot.owner == player then plot else nil
end

local function show(plot: Plot, key: string, inst: Instance, on: boolean, parent: Instance)
	if (plot.shown[key] == true) == on then
		return
	end
	plot.shown[key] = on or nil
	inst.Parent = if on then parent else plot.hidden
end

function World.reset(plot: Plot)
	for id, inst in plot.pads do
		show(plot, "pad:" .. id, inst, false, plot.folder)
	end
	for id, inst in plot.padModels do
		show(plot, "prop:" .. id, inst, false, plot.folder)
	end
	for id, inst in plot.buildings do
		show(plot, "biz:" .. id, inst, false, plot.folder)
	end
	for id, inst in plot.extras do
		show(plot, "extra:" .. id, inst, false, plot.folder)
	end
	for id, inst in plot.decor do
		show(plot, "decor:" .. id, inst, false, plot.folder)
	end
	for id, inst in plot.tiers do
		show(plot, "tier:" .. id, inst, false, plot.folder)
	end
	for _, pr in plot.prompts do
		pr.Enabled = false
	end
	local tl = plot.sign:FindFirstChild("Text", true) :: TextLabel?
	if tl then
		tl.Text = "Open plot"
	end
end

-- Match the plot to its owner's profile. Returns ids of things that just appeared.
function World.sync(plot: Plot, p: any, name: string): { string }
	local appeared = {}
	local ms = Game.multState(p)
	for _, pad in Economy.pads do
		local owned = Game.owns(p, pad.id)
		local visible = not owned and Game.padVisible(p, pad)
		local padPart = plot.pads[pad.id]
		if visible and not plot.shown["pad:" .. pad.id] then
			local price = padPart:FindFirstChild("PadLabel") and (padPart :: any).PadLabel.Price
			if price then
				price.Text = Format.cash(Game.padCost(p, pad))
			end
		end
		show(plot, "pad:" .. pad.id, padPart, visible, plot.folder)
		if pad.kind == "unlock" then
			local b = plot.buildings[pad.bizId]
			local on = owned
			if on and not plot.shown["biz:" .. pad.bizId] then
				table.insert(appeared, pad.id)
			end
			show(plot, "biz:" .. pad.bizId, b, on, plot.folder)
		else
			local m = plot.padModels[pad.id]
			local on = owned and Game.bizOwned(p, pad.bizId)
			if on and not plot.shown["prop:" .. pad.id] then
				table.insert(appeared, pad.id)
			end
			show(plot, "prop:" .. pad.id, m, on, plot.folder)
		end
	end
	for _, biz in Economy.businesses do
		local owned = Game.bizOwned(p, biz.id)
		plot.prompts[biz.id].Enabled = owned and not Economy.isAutomated(ms, biz)
		local tier = if owned then Game.levelTier(p, biz.id) else 0
		for t = 1, #TIER_MODELS do
			local key = biz.id .. ":" .. t
			local on = t <= tier
			if on and not plot.shown["tier:" .. key] then
				table.insert(appeared, "tier:" .. key)
			end
			show(plot, "tier:" .. key, plot.tiers[key], on, plot.folder)
		end
	end
	for id, m in plot.decor do
		local on = p.decor[id] == true
		if on and not plot.shown["decor:" .. id] then
			table.insert(appeared, "decor:" .. id)
		end
		show(plot, "decor:" .. id, m, on, plot.folder)
	end
	-- landmarks: kiosk once investors are on offer or held, portal once evolution progress shows,
	-- staircase once every pad is owned
	local offered = Game.investorsOffered(p)
	show(plot, "extra:InvestorKiosk", plot.extras.InvestorKiosk, offered.m > 0 or p.investors.m > 0 or (p.stats.rebirths or 0) > 0, plot.folder)
	show(plot, "extra:Portal", plot.extras.Portal, p.investors.m > 0 or p.evolutions > 0, plot.folder)
	show(plot, "extra:Staircase", plot.extras.Staircase, (Game.canAscend(p)) or p.ascensions > 0, plot.folder)
	local tl = plot.sign:FindFirstChild("Text", true) :: TextLabel?
	if tl and tl.Text ~= name then
		tl.Text = name
	end
	local standSign = plot.buildings.stand:FindFirstChild("NameSign")
	local st = standSign and standSign:FindFirstChild("Text", true) :: TextLabel?
	if st then
		local recipe = Economy.recipeName(p.evolutions)
		st.Text = if recipe == "Classic" then "HOT DOGS" else string.upper(recipe) .. " DOGS"
	end
	return appeared
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="31">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  </Item>
  <Item class="SoundService" referent="32">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="33">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="34">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">6</float>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="35">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="37">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Ambient</string>
              <string name="Source"><![CDATA[--!strict
-- Local-only life in the world (each player sees their own copy, so the server and network
-- stay quiet): a hot-dog blimp, hot-air balloons, cloud puffs and birds in the sky; customers
-- that walk up to the player's businesses (more as businesses level up); delivery vehicles on
-- the road; bobbing pickups and a spinning portal. Purely cosmetic: no rewards come from here.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Economy = require(Shared.Logic.Economy)
local Layout = require(Shared.Layout)
local Models = require(Shared.Models)
local State = require(script.Parent.State)

local Ambient = {}
local player = Players.LocalPlayer

local folder: Folder
local movers: { { model: Model, update: (number) -> CFrame } } = {}

local function spawnModel(name: string, scale: number?): Model
	local m = Models.build(name)
	if scale and scale ~= 1 then
		pcall(function()
			m:ScaleTo(scale)
		end)
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		end
	end
	m.Parent = folder
	return m
end

local function addMover(m: Model, update: (number) -> CFrame)
	table.insert(movers, { model = m, update = update })
end

local function plotOrigin(): CFrame?
	local i = player:GetAttribute("Plot")
	return if type(i) == "number" then Layout.plotOrigin(i) else nil
end

---------------------------------------------------------------- sky
local function buildSky()
	local centre = Vector3.new(Layout.PLOT_SPACING * 1.5, 0, 180)
	-- hot-dog blimp on a slow wide loop
	local blimp = spawnModel("Blimp")
	addMover(blimp, function(t)
		local a = t * 0.025
		local pos = centre + Vector3.new(math.cos(a) * 420, 150 + math.sin(t * 0.3) * 4, math.sin(a) * 260)
		local dir = Vector3.new(-math.sin(a), 0, math.cos(a))
		return CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0)
	end)
	-- hot-air balloons drifting
	for i = 1, 4 do
		local b = spawnModel("HotAirBalloon")
		local seed = i * 1.7
		addMover(b, function(t)
			local x = ((t * (3 + i) + i * 300) % 1600) - 400
			return CFrame.new(x, 95 + i * 18 + math.sin(t * 0.5 + seed) * 6, -140 + i * 120) * CFrame.Angles(0, t * 0.05 + seed, 0)
		end)
	end
	-- cloud puffs low on the horizon
	for i = 1, 10 do
		local c = spawnModel("CloudPuff", 1.5 + (i % 3) * 0.5)
		local z = if i % 2 == 0 then -260 - i * 12 else 620 + i * 10
		addMover(c, function(t)
			local x = ((t * 2 + i * 190) % 1800) - 500
			return CFrame.new(x, 120 + (i % 4) * 20, z)
		end)
	end
	-- a few flocks of birds
	for f = 1, 3 do
		for k = 1, 5 do
			local bird = spawnModel("Bird", 1.5)
			local wings = bird:FindFirstChild("Wings", true) :: BasePart?
			addMover(bird, function(t)
				local a = t * 0.12 + f * 2
				local r = 160 + f * 60
				local pos = centre + Vector3.new(math.cos(a) * r + k * 4, 70 + f * 15 + (k % 2) * 3, math.sin(a) * r + (k % 3) * 4)
				if wings then
					wings.Size = Vector3.new(3, 0.15, 0.9 + math.abs(math.sin(t * 8 + k)) * 0.6)
				end
				return CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
			end)
		end
	end
end

---------------------------------------------------------------- road traffic
local function buildTraffic()
	local names = { "DeliveryVan", "DeliveryBike", "DepotTruck", "BigVan", "FridgeTruck" }
	for i = 1, 5 do
		local v = spawnModel(names[i])
		local lane = if i % 2 == 0 then 4 else -4
		local speed = 18 + i * 3
		local span = Layout.PLOT_SPACING * 4 + 400
		addMover(v, function(t)
			local x = ((t * speed + i * 260) % span) - 200
			if lane > 0 then
				x = span - 400 - x
			end
			return CFrame.new(x, 0.3, Layout.ROAD_Z + lane) * CFrame.Angles(0, if lane > 0 then math.pi else 0, 0)
		end)
	end
end

---------------------------------------------------------------- customers
local customers: { Model } = {}
local function rebuildCustomers()
	for _, c in customers do
		c:Destroy()
	end
	customers = {}
	local d = State.data
	local origin = plotOrigin()
	if not d or not origin then
		return
	end
	local kinds = { "CustomerA", "CustomerB", "CustomerC" }
	local n = 0
	for _, biz in Economy.businesses do
		local b = d.biz[biz.id]
		if b and b.owned then
			local count = math.min(5, 1 + (d.tiers and d.tiers[biz.id] or 0))
			local lot = Layout.lots[biz.id]
			for k = 1, count do
				n += 1
				if n > 24 then
					return
				end
				local m = spawnModel(kinds[(n % 3) + 1])
				table.insert(customers, m)
				-- walk from the central path to the front of the business and back
				local from = Vector3.new(if lot.pos.X > 0 then 4 else -4, 0, lot.pos.Z - 4 + k * 2)
				local to = lot.pos + Vector3.new((k - (count + 1) / 2) * 3, 0, -lot.size.Y / 2 + 3)
				if biz.id == "stand" then
					from = Vector3.new((k - 2) * 3, 0, 4)
					to = lot.pos + Vector3.new((k - (count + 1) / 2) * 3, 0, -7)
				end
				local period = 10 + k * 1.3
				local offset = k * 2.1 + n
				addMover(m, function(t)
					local u = ((t + offset) % period) / period
					local walkOut = u < 0.4
					local wait = u >= 0.4 and u < 0.6
					local f = if walkOut then u / 0.4 elseif wait then 1 else 1 - (u - 0.6) / 0.4
					local p = from:Lerp(to, f)
					local bob = if wait then 0 else math.abs(math.sin(t * 8)) * 0.25
					local look = if walkOut or wait then (to - from) else (from - to)
					local wpos = origin * (p + Vector3.new(0, bob, 0))
					return CFrame.lookAt(wpos, wpos + origin:VectorToWorldSpace(Vector3.new(look.X, 0, look.Z)))
				end)
			end
		end
	end
end

---------------------------------------------------------------- loop
function Ambient.init()
	local f = Instance.new("Folder")
	f.Name = "LocalAmbient"
	f.Parent = workspace
	folder = f
	buildSky()
	buildTraffic()
	local lastKey = ""
	State.Changed:Connect(function(d)
		local parts = {}
		for _, biz in Economy.businesses do
			local b = d.biz[biz.id]
			table.insert(parts, (b and b.owned and "1" or "0") .. tostring(d.tiers and d.tiers[biz.id] or 0))
		end
		local key = table.concat(parts) .. tostring(player:GetAttribute("Plot"))
		if key ~= lastKey then
			lastKey = key
			rebuildCustomers()
		end
	end)
	local t = 0
	RunService.RenderStepped:Connect(function(dt: number)
		t += dt
		for i = #movers, 1, -1 do
			local mv = movers[i]
			if mv.model.Parent == nil then
				table.remove(movers, i)
			else
				mv.model:PivotTo(mv.update(t))
			end
		end
		-- bob and spin the player's pickups; spin the portal disc
		local origin = plotOrigin()
		local plots = workspace:FindFirstChild("Plots")
		local plot = plots and plots:FindFirstChild("Plot" .. tostring(player:GetAttribute("Plot")))
		if plot and origin then
			local pickups = plot:FindFirstChild("Pickups")
			if pickups then
				for _, m in pickups:GetChildren() do
					if m:IsA("Model") then
						local base = m:GetAttribute("BaseY")
						local pivot = m:GetPivot()
						if base == nil then
							m:SetAttribute("BaseY", pivot.Position.Y)
							base = pivot.Position.Y
						end
						local p = pivot.Position
						m:PivotTo(CFrame.new(p.X, (base :: number) + 0.6 + math.sin(t * 3 + p.X) * 0.4, p.Z) * CFrame.Angles(0, t * 1.5, 0))
					end
				end
			end
			local portal = plot:FindFirstChild("Portal")
			local disc = portal and portal:FindFirstChild("Disc", true) :: BasePart?
			if disc then
				disc.CFrame = disc.CFrame * CFrame.Angles(dt * 1.5, 0, 0)
			end
		end
	end)
end

return Ambient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Bus</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side message bus so controllers can open each other's screens without cycles.
local Bus = {}
local ev = Instance.new("BindableEvent")
Bus.Opened = ev.Event -- (what, arg)

-- Selected bulk size for level upgrades (1, 5, 25, 100 or "max"); validated by the server.
Bus.bulk = 1 :: any
local bulkEv = Instance.new("BindableEvent")
Bus.BulkChanged = bulkEv.Event

function Bus.open(what: string, arg: any?)
	ev:Fire(what, arg)
end

function Bus.setBulk(v: any)
	Bus.bulk = v
	bulkEv:Fire(v)
end

-- Convert a {m, e} table from the server into a BigNum (tables cross remotes as plain data).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local BigNum = require(Shared.Logic.BigNum)
function Bus.big(v: any): BigNum.Big
	return BigNum.sanitize(v) or BigNum.zero
end

return Bus
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">DashUI</string>
              <string name="Source"><![CDATA[--!strict
-- DogDash the Game: pick one of four racing hot dogs, choose a bet, then mash Cheer.
-- The server runs the race; this screen only shows the positions it sends.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Kit = require(script.Parent.Parent.UI.Kit)
local Bus = require(script.Parent.Bus)
local State = require(script.Parent.State)

local C = Kit.C
local new = Kit.new

local DashUI = {}

local gui: ScreenGui
local runners: { Frame } = {}
local pickButtons: { Kit.Button } = {}
local betButtons: { Kit.Button } = {}
local startBtn: Kit.Button
local cheerBtn: Kit.Button
local status: TextLabel
local pick, bet = 1, 1
local racing = false
local COLORS = { C.ketchup, C.mustard, C.green, C.blue }
local NAMES = { "Ketchup", "Mustard", "Relish", "Blue Bun" }

local function paint()
	for i, b in pickButtons do
		b.setColor(if i == pick then COLORS[i] else C.grey, C.shadow)
	end
	for i, b in betButtons do
		b.setColor(if i == bet then C.gold else C.grey, C.goldDark)
	end
	startBtn.frame.Visible = not racing
	cheerBtn.frame.Visible = racing
	for _, b in pickButtons do
		b.setEnabled(not racing)
	end
	for _, b in betButtons do
		b.setEnabled(not racing)
	end
end

function DashUI.init()
	local g, root = Kit.canvas("DogDash", 25)
	gui = g
	gui.Enabled = false
	new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Parent = root })
	local box = Kit.panel({ size = UDim2.fromOffset(600, 470), pos = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), parent = root })
	Kit.label({ Text = "🏁 DogDash", Size = UDim2.new(1, -90, 0, 44), Position = UDim2.fromOffset(16, 10), Parent = box, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 30 })
	Kit.button({ text = "✕", color = C.red, dark = C.redDark, size = UDim2.fromOffset(48, 48), pos = UDim2.new(1, -12, 0, 10), anchor = Vector2.new(1, 0), parent = box, textSize = 26, onClick = function()
		gui.Enabled = false
	end })
	local track = new("Frame", { Size = UDim2.new(1, -32, 0, 200), Position = UDim2.fromOffset(16, 62), BackgroundColor3 = Color3.fromRGB(120, 200, 100), Parent = box }, { Kit.corner(12) })
	new("Frame", { Size = UDim2.new(0, 6, 1, 0), Position = UDim2.new(1, -40, 0, 0), BackgroundColor3 = C.white, Parent = track })
	for i = 1, 4 do
		local lane = new("Frame", { Size = UDim2.new(1, -8, 0, 44), Position = UDim2.fromOffset(4, 4 + (i - 1) * 49), BackgroundColor3 = Color3.fromRGB(235, 222, 196), Parent = track }, { Kit.corner(10) })
		local r = Kit.label({ Text = "🌭", Size = UDim2.fromOffset(44, 44), Position = UDim2.fromScale(0, 0), Parent = lane, MaxText = 36, BackgroundTransparency = 0, BackgroundColor3 = COLORS[i] })
		Kit.corner(22).Parent = r
		runners[i] = r :: any
	end
	local pickRow = new("Frame", { Size = UDim2.new(1, -32, 0, 46), Position = UDim2.fromOffset(16, 270), BackgroundTransparency = 1, Parent = box }, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) })
	for i = 1, 4 do
		pickButtons[i] = Kit.button({ text = NAMES[i], size = UDim2.fromOffset(136, 44), parent = pickRow, textSize = 18, onClick = function()
			pick = i
			paint()
		end })
	end
	local betRow = new("Frame", { Size = UDim2.new(1, -32, 0, 46), Position = UDim2.fromOffset(16, 320), BackgroundTransparency = 1, Parent = box }, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) })
	for i, f in Economy.Catalog.dash.betFractions.value do
		betButtons[i] = Kit.button({ text = string.format("Bet %d%%", math.floor(f * 100 + 0.5)), size = UDim2.fromOffset(150, 44), parent = betRow, textSize = 18, onClick = function()
			bet = i
			paint()
		end })
	end
	status = Kit.label({ Text = "Pick a racer and a bet!", Size = UDim2.new(1, -32, 0, 26), Position = UDim2.fromOffset(16, 370), Parent = box, TextColor3 = C.ink, MaxText = 20 })
	startBtn = Kit.button({ text = "Start race", color = C.green, dark = C.greenDark, size = UDim2.fromOffset(220, 56), pos = UDim2.new(0.5, 0, 1, -12), anchor = Vector2.new(0.5, 1), parent = box, textSize = 24, onClick = function()
		startBtn.setPending(true)
		State.send("dashStart", pick, bet)
		task.delay(1, function()
			startBtn.setPending(false)
		end)
	end })
	cheerBtn = Kit.button({ text = "📣 CHEER!", color = C.ketchup, dark = C.redDark, size = UDim2.fromOffset(260, 56), pos = UDim2.new(0.5, 0, 1, -12), anchor = Vector2.new(0.5, 1), parent = box, textSize = 26, onClick = function()
		State.send("dashCheer")
	end })
	paint()

	Bus.Opened:Connect(function(what)
		if what == "dash" then
			gui.Enabled = true
			paint()
		end
	end)
	State.Notify:Connect(function(kind, data)
		if kind == "race" then
			if not racing then
				racing = true
				gui.Enabled = true
				paint()
			end
			for i, p in data.pos do
				runners[i].Position = UDim2.new(p * 0.9, 0, 0, 0)
			end
			status.Text = string.format("Go %s! Cheers: %d", NAMES[data.pick], data.cheers)
		elseif kind == "raceEnd" then
			racing = false
			local won = data.winner == data.pick
			status.Text = if won then string.format("%s won! You got %s", NAMES[data.winner], Format.cash(Bus.big(data.payout))) else string.format("%s won. Better luck next time!", NAMES[data.winner])
			paint()
		end
	end)
end

return DashUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Dialogs</string>
              <string name="Source"><![CDATA[--!strict
-- Modal dialogs: Alien Investors / Rebirth, Void Evolution, Ascension, Forever Purchase
-- target selection, welcome-back offline income, business name editing, and confirmations.
-- Every confirm only sends a request; results come back from the server.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Names = require(Shared.Logic.Names)
local Kit = require(script.Parent.Parent.UI.Kit)
local Bus = require(script.Parent.Bus)
local State = require(script.Parent.State)

local C = Kit.C
local new = Kit.new

local Dialogs = {}

local gui: ScreenGui
local root: Frame
local box: Frame
local body: Frame
local titleLabel: TextLabel
local openKind: string? = nil
local selecting = false
local selectBanner: Frame

local function close()
	gui.Enabled = false
	openKind = nil
end
Dialogs.close = close

local function clearBody()
	for _, c in body:GetChildren() do
		c:Destroy()
	end
end

local function show(kind: string, title: string, height: number)
	local fresh = openKind ~= kind or not gui.Enabled
	openKind = kind
	gui.Enabled = true
	if fresh then
		Kit.popIn(box)
	end
	titleLabel.Text = title
	box.Size = UDim2.fromOffset(520, height)
	clearBody()
end

local function text(s: string, y: number, h: number, color: Color3?, font: Enum.Font?, maxText: number?): TextLabel
	return Kit.label({ Text = s, Size = UDim2.new(1, 0, 0, h), Position = UDim2.fromOffset(0, y), Parent = body, TextColor3 = color or C.ink, Font = font or Kit.FONT, TextWrapped = true, MaxText = maxText or 24 })
end

local function buttons(specs: { { text: string, color: Color3, dark: Color3, enabled: boolean?, onClick: () -> () } })
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 58), Position = UDim2.new(0, 0, 1, -58), BackgroundTransparency = 1, Parent = body }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	for i, s in specs do
		local b = Kit.button({ text = s.text, color = s.color, dark = s.dark, size = UDim2.fromOffset(150, 56), parent = row, textSize = 22, onClick = s.onClick })
		b.frame.LayoutOrder = i
		if s.enabled == false then
			b.setEnabled(false)
		end
	end
end

local function progressBar(y: number, p: number, color: Color3, label: string)
	local back, fill = Kit.bar(body, UDim2.new(1, -20, 0, 30), UDim2.fromOffset(10, y), color)
	fill.Size = UDim2.fromScale(math.clamp(p, 0, 1), 1)
	Kit.label({ Text = label, Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), Parent = back, ZIndex = 2, MaxText = 20 })
end

-- second step for every reset: what goes, what stays
local function confirm(title: string, lines: string, yes: string, action: string)
	show("confirm", title, 340)
	text(lines, 0, 200, C.ink, Kit.FONT_BODY, 18)
	buttons({
		{ text = yes, color = C.red, dark = C.redDark, onClick = function()
			State.send(action)
			close()
		end },
		{ text = "Cancel", color = C.grey, dark = Color3.fromRGB(120, 115, 110), onClick = close },
	})
end

---------------------------------------------------------------- Investors / Rebirth
local function investors()
	local d = State.data
	if not d then
		return
	end
	local held = Bus.big(d.investors)
	local offered = Bus.big(d.offered)
	show("investors", "👽 Alien Hot Dog Investors", 430)
	text(string.format("You have %s investors", Format.amount(held, 0)), 0, 34)
	text(string.format("Each investor gives +%s%% cash  (now x%s)", tostring(d.bonusPer * 100), Format.amount(BigNum.add(BigNum.new(1), BigNum.mulN(held, d.bonusPer)))), 36, 26, C.greenDark, Kit.FONT_BODY, 18)
	text(if offered.m > 0 then string.format("Rebirth now to gain %s investors%s", Format.amount(offered, 0), if d.x2 then "  (x2!)" else "") else "Earn more cash this run to attract investors.", 72, 52, C.violet, nil, 24)
	if not d.x2 then
		Kit.button({ text = "x2 Investors", color = C.gold, dark = C.goldDark, size = UDim2.fromOffset(200, 44), pos = UDim2.new(0.5, 0, 0, 132), anchor = Vector2.new(0.5, 0), parent = body, textSize = 20, onClick = function()
			Bus.open("panel", "Shop")
		end })
	end
	if d.credits > 0 then
		Kit.button({ text = string.format("Collect without reset (%d)", d.credits), color = C.teal, dark = Color3.fromRGB(20, 120, 140), size = UDim2.fromOffset(300, 44), pos = UDim2.new(0.5, 0, 0, 184), anchor = Vector2.new(0.5, 0), parent = body, textSize = 20, onClick = function()
			State.send("rebirthNoReset")
			close()
		end }).setEnabled(offered.m > 0)
	end
	buttons({
		{ text = "Rebirth", color = C.green, dark = C.greenDark, enabled = offered.m > 0, onClick = function()
			confirm("Rebirth?", string.format("You'll gain %s investors.\n\nResets: cash, businesses and upgrades.\nKeeps: investors, powers, evolutions, Robux purchases, Forever Purchases and your business name.", Format.amount(offered, 0)), "Rebirth", "rebirth")
		end },
		{ text = "Close", color = C.grey, dark = Color3.fromRGB(120, 115, 110), onClick = close },
	})
end

---------------------------------------------------------------- Evolution
local function evolve()
	local d = State.data
	if not d then
		return
	end
	show("evolve", "🌀 Void Evolution", 400)
	text(string.format("Each evolution gives x%d income speed", d.evo.mult), 0, 30)
	text(string.format("%s Dogs  →  %s Dogs", d.evo.recipe, d.evo.nextRecipe), 36, 34, C.violet)
	progressBar(84, d.evo.progress, C.violet, string.format("%d%%", math.floor(d.evo.progress * 100)))
	text(string.format("Needs %s investors (you have %s)", Format.amount(Bus.big(d.evo.need), 0), Format.amount(Bus.big(d.investors), 0)), 122, 40, C.inkSoft, Kit.FONT_BODY, 17)
	buttons({
		{ text = "Evolve", color = C.violet, dark = Color3.fromRGB(90, 50, 160), enabled = d.evo.can, onClick = function()
			confirm("Evolve?", "Most progress resets, including investors and investor powers.\n\nKeeps: evolutions, ascensions, Robux purchases, Forever Purchases and your business name.", "Evolve", "evolve")
		end },
		{ text = "Close", color = C.grey, dark = Color3.fromRGB(120, 115, 110), onClick = close },
	})
end

---------------------------------------------------------------- Ascension
local function ascend()
	local d = State.data
	if not d then
		return
	end
	show("ascend", "✨ Ascension", 410)
	text(string.format("Climb the staircase: x%s cash, but prices x%s", tostring(d.asc.cash), tostring(d.asc.price)), 0, 50, C.ink, nil, 22)
	text("+1 Forever Purchase", 52, 28, C.teal)
	progressBar(90, d.asc.owned / math.max(1, d.asc.total), C.gold, string.format("%d / %d upgrades owned", d.asc.owned, d.asc.total))
	text(if d.asc.can then "Everything is built. You can ascend!" else "Buy every upgrade on your plot to ascend.", 128, 40, C.inkSoft, Kit.FONT_BODY, 17)
	buttons({
		{ text = "Ascend", color = C.gold, dark = C.goldDark, enabled = d.asc.can, onClick = function()
			confirm("Ascend?", "EVERYTHING resets: cash, businesses, investors, powers and evolutions.\n\nKeeps: ascensions, Robux purchases, Forever Purchases and your business name.", "Ascend", "ascend")
		end },
		{ text = "Close", color = C.grey, dark = Color3.fromRGB(120, 115, 110), onClick = close },
	})
end

---------------------------------------------------------------- Forever Purchase
local function foreverConfirm(padId: string)
	local pad = Economy.padById[padId]
	show("foreverConfirm", "♾️ Forever Purchase", 300)
	text(string.format("Keep %s forever?", pad.name), 0, 60)
	text("It stays owned through every rebirth, evolution and ascension. Uses 1 Forever Purchase.", 64, 60, C.inkSoft, Kit.FONT_BODY, 17)
	buttons({
		{ text = "Yes", color = C.green, dark = C.greenDark, onClick = function()
			State.send("forever", padId)
			selecting = false
			selectBanner.Visible = false
			close()
		end },
		{ text = "nvm", color = C.grey, dark = Color3.fromRGB(120, 115, 110), onClick = function()
			Dialogs.forever()
		end },
	})
end

function Dialogs.forever()
	local d = State.data
	if not d or d.tokens < 1 then
		return
	end
	selecting = true
	selectBanner.Visible = true
	show("forever", "♾️ Pick an upgrade to keep", 520)
	local list = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, -66), BackgroundTransparency = 1, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 8, Parent = body }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 64), CellPadding = UDim2.fromOffset(8, 8) }),
	})
	for _, pad in Economy.pads do
		local ps = d.pads[pad.id]
		if pad.kind ~= "unlock" and ps and ps.s ~= 3 then
			Kit.button({ text = pad.name, color = if ps.s == 2 then C.blue else C.teal, dark = C.blueDark, size = UDim2.fromOffset(150, 64), parent = list, textSize = 16, onClick = function()
				foreverConfirm(pad.id)
			end })
		end
	end
	buttons({
		{ text = "Cancel", color = C.red, dark = C.redDark, onClick = function()
			selecting = false
			selectBanner.Visible = false
			close()
		end },
	})
end

---------------------------------------------------------------- Offline / name / errors
local function offline(amount: any)
	show("offline", "👋 Welcome back!", 300)
	text("While you were away your businesses earned", 0, 50, C.ink, Kit.FONT_BODY, 20)
	text(Format.cash(Bus.big(amount)), 54, 56, C.greenDark, nil, 44)
	buttons({
		{ text = "Collect", color = C.green, dark = C.greenDark, onClick = function()
			State.send("claimOffline")
			close()
		end },
	})
end

local nameStatus: TextLabel? = nil
local function nameEditor()
	local d = State.data
	show("name", "✏️ Name your business", 330)
	local tb = new("TextBox", {
		Size = UDim2.new(1, -20, 0, 56),
		Position = UDim2.fromOffset(10, 0),
		BackgroundColor3 = C.white,
		Font = Kit.FONT,
		TextScaled = true,
		TextColor3 = C.ink,
		PlaceholderText = "Carter's Hot Dogs",
		Text = if d then d.name else "",
		ClearTextOnFocus = false,
		Parent = body,
	}, { Kit.corner(10), Kit.stroke(C.inkSoft, 2), new("UITextSizeConstraint", { MaxTextSize = 30 }) })
	local count = text("", 62, 22, C.inkSoft, Kit.FONT_BODY, 16)
	nameStatus = text("", 90, 50, C.redDark, Kit.FONT_BODY, 17)
	local function upd()
		count.Text = string.format("%d / %d", #tb.Text, Names.MAX)
		count.TextColor3 = if #tb.Text > Names.MAX then C.red else C.inkSoft
	end
	tb:GetPropertyChangedSignal("Text"):Connect(upd)
	upd()
	buttons({
		{ text = "Save", color = C.green, dark = C.greenDark, onClick = function()
			local clean, why = Names.clean(tb.Text)
			if not clean then
				(nameStatus :: TextLabel).Text = why or ""
				return
			end
			(nameStatus :: TextLabel).TextColor3 = C.inkSoft;
			(nameStatus :: TextLabel).Text = "Checking…"
			State.send("setName", clean)
		end },
		{ text = "Cancel", color = C.grey, dark = Color3.fromRGB(120, 115, 110), onClick = close },
	})
end

function Dialogs.init()
	local g, r = Kit.canvas("Dialogs", 30)
	gui, root = g, r
	gui.Enabled = false
	new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false, Parent = root })
	box = Kit.panel({ size = UDim2.fromOffset(520, 400), pos = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), parent = root })
	new("UISizeConstraint", { MaxSize = Vector2.new(560, 580), Parent = box })
	titleLabel = Kit.label({ Text = "", Size = UDim2.new(1, -90, 0, 44), Position = UDim2.fromOffset(16, 12), Parent = box, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 30 })
	Kit.button({ text = "✕", color = C.red, dark = C.redDark, size = UDim2.fromOffset(48, 48), pos = UDim2.new(1, -12, 0, 10), anchor = Vector2.new(1, 0), parent = box, textSize = 26, onClick = function()
		if selecting then
			selecting = false
			selectBanner.Visible = false
		end
		close()
	end })
	body = new("Frame", { Size = UDim2.new(1, -32, 1, -84), Position = UDim2.fromOffset(16, 68), BackgroundTransparency = 1, Parent = box })
	-- selection-mode banner (top of the screen, above the HUD) with its own Cancel
	local _, hudRoot = Kit.canvas("ForeverBanner", 31)
	selectBanner = Kit.panel({ size = UDim2.fromOffset(460, 54), pos = UDim2.new(0.5, 0, 0, 120), anchor = Vector2.new(0.5, 0), parent = hudRoot, color = C.teal })
	selectBanner.Visible = false
	Kit.label({ Text = "Choose an upgrade to keep forever", Size = UDim2.new(1, -130, 1, -10), Position = UDim2.fromOffset(10, 5), Parent = selectBanner, MaxText = 20 })
	Kit.button({ text = "Cancel", color = C.red, dark = C.redDark, size = UDim2.fromOffset(100, 42), pos = UDim2.new(1, -8, 0.5, 0), anchor = Vector2.new(1, 0.5), parent = selectBanner, textSize = 18, onClick = function()
		selecting = false
		selectBanner.Visible = false
		close()
	end })

	Bus.Opened:Connect(function(what, arg)
		if what == "investors" then
			investors()
		elseif what == "evolve" then
			evolve()
		elseif what == "ascend" then
			ascend()
		elseif what == "forever" then
			Dialogs.forever()
		elseif what == "name" then
			nameEditor()
		elseif what == "panel" and gui.Enabled and not selecting then
			close()
		end
	end)
	State.Notify:Connect(function(kind, data)
		if kind == "open" then
			Bus.open(data)
		elseif kind == "offline" then
			offline(data.amount)
		elseif kind == "nameResult" then
			if openKind == "name" and nameStatus then
				nameStatus.TextColor3 = if data.ok then C.greenDark else C.redDark
				nameStatus.Text = data.msg
				if data.ok then
					task.delay(0.8, function()
						if openKind == "name" then
							close()
						end
					end)
				end
			end
		elseif kind == "prestige" then
			local msg = if data.kind == "rebirth" or data.kind == "rebirthNoReset" then "👽 " .. Format.amount(Bus.big(data.amount), 0) .. " investors joined!" elseif data.kind == "evolve" then "🌀 Evolved: " .. data.recipe .. " Dogs!" else "✨ Ascended!"
			show("done", msg, 220)
			buttons({ { text = "Awesome!", color = C.green, dark = C.greenDark, onClick = close } })
		end
	end)
	-- keep an open info dialog fresh (not confirmations or the name editor)
	local lastRefresh = 0
	State.Changed:Connect(function()
		if os.clock() - lastRefresh < 1 then
			return
		end
		lastRefresh = os.clock()
		if openKind == "investors" then
			investors()
		elseif openKind == "evolve" then
			evolve()
		elseif openKind == "ascend" then
			ascend()
		end
	end)
end

return Dialogs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Sounds and short build/cash effects. Repeated effects are throttled so very fast production
-- never floods the screen or speakers. Effects never change timing or grants.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")

local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)

local Effects = {}

-- Engine-bundled sounds (shipped with every Roblox client). Replace with uploaded originals
-- from assets/audio when available (see docs/ASSET_PROVENANCE.md).
local SOUNDS = {
	click = "rbxasset://sounds/clickfast.wav",
	cash = "rbxasset://sounds/electronicpingshort.wav",
	build = "rbxasset://sounds/swoosh.wav",
	error = "rbxasset://sounds/button.wav",
}
local lastPlayed: { [string]: number } = {}

function Effects.play(name: string, volume: number?, minGap: number?)
	local now = os.clock()
	if now - (lastPlayed[name] or 0) < (minGap or 0.08) then
		return
	end
	lastPlayed[name] = now
	local id = SOUNDS[name]
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end

local function myPlot(): Instance?
	local i = Players.LocalPlayer:GetAttribute("Plot")
	local plots = workspace:FindFirstChild("Plots")
	return if plots and i then plots:FindFirstChild("Plot" .. tostring(i)) else nil
end
Effects.myPlot = myPlot

local function modelFor(plot: Instance, id: string): Instance?
	if id:sub(1, 4) == "biz:" then
		return plot:FindFirstChild(id:sub(5))
	elseif id:sub(1, 5) == "tier:" then
		local rest = id:sub(6)
		local biz, t = rest:match("^(.-):(%d+)$")
		return plot:FindFirstChild("Tier_" .. tostring(biz) .. "_" .. tostring(t))
	elseif id:sub(1, 6) == "decor:" then
		return plot:FindFirstChild("Decor_" .. id:sub(7))
	end
	return plot:FindFirstChild("Prop_" .. id)
end

-- Grow a model out of the ground (client-side only; the server copy is untouched).
local function growIn(m: Model)
	local ok = pcall(function()
		m:ScaleTo(0.05)
	end)
	if not ok then
		return
	end
	local v = Instance.new("NumberValue")
	v.Value = 0.05
	v.Changed:Connect(function(x)
		pcall(function()
			m:ScaleTo(math.max(0.05, x))
		end)
	end)
	local tw = Kit.tween(v, 0.55, { Value = 1 }, Enum.EasingStyle.Back)
	tw.Completed:Connect(function()
		pcall(function()
			m:ScaleTo(1)
		end)
		v:Destroy()
	end)
end

local function confetti(at: Vector3, amount: number)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(at)
	p.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Speed = NumberRange.new(14, 26)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Acceleration = Vector3.new(0, -30, 0)
	e.Size = NumberSequence.new(0.9, 0.2)
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Kit.C.ketchup),
		ColorSequenceKeypoint.new(0.5, Kit.C.mustard),
		ColorSequenceKeypoint.new(1, Kit.C.green),
	})
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = p
	e:Emit(amount)
	Debris:AddItem(p, 3)
end
Effects.confetti = confetti

-- Small camera bump so a purchase is felt.
local function bump()
	local ch = Players.LocalPlayer.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	task.spawn(function()
		for i = 1, 6 do
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.5, 0) * (1 - i / 7)
			task.wait(0.03)
		end
		hum.CameraOffset = Vector3.zero
	end)
end

-- Newly built things in the player's plot: grow in, confetti, sound, bump.
function Effects.built(ids: { string })
	local plot = myPlot()
	if not plot then
		return
	end
	Effects.play("build", 0.6, 0.2)
	local count = 0
	for _, id in ids do
		local m = modelFor(plot, id)
		if m and m:IsA("Model") then
			count += 1
			if count > 6 then
				break -- a big catch-up (rejoin/reset) only animates a few
			end
			local pieces = {}
			for _, c in m:GetChildren() do
				if c:IsA("Model") then
					table.insert(pieces, c)
				end
			end
			if #pieces == 0 then
				pieces = { m }
			end
			for i, piece in pieces do
				if i > 12 then
					break
				end
				growIn(piece)
				local okPivot, pivot = pcall(function()
					return piece:GetPivot()
				end)
				if okPivot and i <= 4 then
					confetti(pivot.Position + Vector3.new(0, 4, 0), 30)
				end
			end
			local h = Instance.new("Highlight")
			h.FillColor = Kit.C.mustard
			h.OutlineColor = Kit.C.white
			h.FillTransparency = 0.4
			h.Parent = m
			Kit.tween(h, 1.2, { FillTransparency = 1, OutlineTransparency = 1 })
			Debris:AddItem(h, 1.3)
		end
	end
	if count > 0 then
		bump()
	end
end

function Effects.init()
	State.Notify:Connect(function(kind, data)
		if kind == "built" then
			Effects.built(data)
		elseif kind == "cash" then
			Effects.play("cash", 0.5, 0.15)
		elseif kind == "toast" and data.kind == "error" then
			Effects.play("error", 0.3, 0.3)
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD: compact wallet + business name (top), next-unlock progress bar, toasts,
-- milestone banners, right-side progression buttons, contextual bottom bar, save warning and
-- the guide beam to the next purchase. Everything animates in; nothing here changes numbers.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Kit = require(script.Parent.Parent.UI.Kit)
local Bus = require(script.Parent.Bus)
local State = require(script.Parent.State)

local C = Kit.C
local new = Kit.new

local Hud = {}

local root: Frame
local wallet: Frame
local walletText: TextLabel
local rateText: TextLabel
local nameText: TextLabel
local toastHolder: Frame
local banner: TextLabel
local right: Frame
local nextBar: Frame
local nextFill: Frame
local nextText: TextLabel
local nextIcon: GuiObject? = nil
local nextIconKey = ""
local bannerHolder: Frame
local rightButtons: { [string]: Kit.Button } = {}
local bottomButtons: { [string]: Kit.Button } = {}
local bulkButton: Kit.Button
local wasVisible: { [string]: boolean } = {}

-- wallet count-up animation (display only)
local shownCash = 0.0
local targetCash: BigNum.Big = BigNum.zero
local lastCash: BigNum.Big = BigNum.zero

local function toast(text: string, kind: string?)
	local color = if kind == "error" then C.red elseif kind == "good" then C.green elseif kind == "cash" then C.gold else C.blue
	local t = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = color, Parent = toastHolder }, { Kit.corner(10), Kit.stroke(C.shadow, 2) })
	Kit.label({ Text = text, Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), Parent = t, MaxText = 18 })
	Kit.popIn(t)
	task.delay(2.4, function()
		Kit.tween(t, 0.3, { BackgroundTransparency = 1 })
		for _, d in t:GetDescendants() do
			if d:IsA("TextLabel") then
				Kit.tween(d, 0.3, { TextTransparency = 1 })
			elseif d:IsA("UIStroke") then
				Kit.tween(d, 0.3, { Transparency = 1 })
			end
		end
		task.wait(0.3)
		t:Destroy()
	end)
	local kids = {}
	for _, k in toastHolder:GetChildren() do
		if k:IsA("Frame") then
			table.insert(kids, k)
		end
	end
	if #kids > 3 then
		kids[1]:Destroy()
	end
end
Hud.toast = toast

-- Big celebration banner across the top-middle with confetti.
local function celebrate(title: string, sub: string, color: Color3)
	local b = Kit.panel({ size = UDim2.fromOffset(420, 84), pos = UDim2.new(0.5, 0, 0, 0), anchor = Vector2.new(0.5, 0), parent = bannerHolder, color = color })
	Kit.label({ Text = title, Size = UDim2.new(1, -20, 0, 46), Position = UDim2.fromOffset(10, 6), Parent = b, MaxText = 38 })
	Kit.label({ Text = sub, Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 52), Parent = b, MaxText = 20 })
	Kit.popIn(b)
	-- confetti: little coloured squares falling from the banner
	local cols = { C.ketchup, C.mustard, C.green, C.blue, C.violet }
	for i = 1, 26 do
		local c = new("Frame", { Size = UDim2.fromOffset(8, 12), Position = UDim2.new(0.5, math.random(-200, 200), 0, 40), BackgroundColor3 = cols[i % #cols + 1], BorderSizePixel = 0, Rotation = math.random(0, 360), Parent = bannerHolder })
		Kit.tween(c, 1.4 + math.random() * 0.6, { Position = UDim2.new(0.5, math.random(-320, 320), 0, math.random(260, 420)), Rotation = math.random(-360, 360), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		task.delay(2.2, function()
			c:Destroy()
		end)
	end
	task.delay(2.6, function()
		Kit.tween(b, 0.35, { Position = UDim2.new(0.5, 0, 0, -120) }, Enum.EasingStyle.Back)
		task.wait(0.4)
		b:Destroy()
	end)
end
Hud.celebrate = celebrate

local function sideButton(id: string, text: string, icon: string, color: Color3, dark: Color3, order: number, onClick: () -> ())
	local b = Kit.button({ text = text, icon = icon, color = color, dark = dark, size = UDim2.fromOffset(150, 58), parent = right, onClick = onClick, textSize = 20 })
	b.frame.LayoutOrder = order
	b.frame.Visible = false
	rightButtons[id] = b
end

local function bottomButton(id: string, text: string, icon: string?, color: Color3, dark: Color3, order: number, onClick: () -> ()): Kit.Button
	local b = Kit.button({ text = text, icon = icon, color = color, dark = dark, size = UDim2.fromOffset(if icon then 128 else 84, 64), onClick = onClick, textSize = 20 })
	b.frame.LayoutOrder = order
	bottomButtons[id] = b
	return b
end

local function build()
	local _, r = Kit.canvas("Hud", 5)
	root = r
	-- compact wallet (about a third of the old area) so the world stays visible
	wallet = Kit.panel({ size = UDim2.fromOffset(200, 42), pos = UDim2.new(0.5, 0, 0, 6), anchor = Vector2.new(0.5, 0), parent = root, color = C.green })
	wallet.Name = "Wallet"
	walletText = Kit.label({ Text = "$0.00", Size = UDim2.new(1, -14, 0, 28), Position = UDim2.fromOffset(7, 1), Parent = wallet, MaxText = 26 })
	rateText = Kit.label({ Text = "", Size = UDim2.new(1, -14, 0, 12), Position = UDim2.fromOffset(7, 28), Parent = wallet, MaxText = 11 })
	-- business name pill (tap to rename)
	local namePill = new("TextButton", { Size = UDim2.fromOffset(180, 22), Position = UDim2.new(0.5, 0, 0, 52), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = C.mustard, AutoButtonColor = true, Text = "", Parent = root }, { Kit.corner(11), Kit.stroke(C.shadow, 2) })
	nameText = Kit.label({ Text = "", Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), Parent = namePill, TextColor3 = C.ink, MaxText = 14 })
	namePill.Activated:Connect(function()
		Kit.pulse(namePill)
		Bus.open("name")
	end)
	-- next-unlock progress (top-left, under the Roblox menu buttons)
	nextBar = Kit.panel({ size = UDim2.fromOffset(230, 46), pos = UDim2.fromOffset(12, 8), parent = root, color = C.panel })
	nextBar.Name = "NextUnlock"
	local back, fill = Kit.bar(nextBar, UDim2.new(1, -56, 0, 14), UDim2.fromOffset(50, 26), C.green)
	nextFill = fill
	nextText = Kit.label({ Text = "", Size = UDim2.new(1, -56, 0, 18), Position = UDim2.fromOffset(50, 5), Parent = nextBar, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 14 })
	local _ = back
	-- toasts and banners
	toastHolder = new("Frame", { Size = UDim2.fromOffset(360, 140), Position = UDim2.new(0.5, 0, 0, 80), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = root }, {
		new("UIListLayout", { Padding = UDim.new(0, 5), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	bannerHolder = new("Frame", { Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 90), BackgroundTransparency = 1, Parent = root })
	-- warning banner (save problems)
	banner = Kit.label({ Text = "", Size = UDim2.fromOffset(520, 26), Position = UDim2.new(0.5, 0, 0, 80), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 0, BackgroundColor3 = C.red, Visible = false, Parent = root, MaxText = 16 })
	Kit.corner(10).Parent = banner
	-- right-side progression controls (kept above the mobile jump button area)
	right = new("Frame", { Size = UDim2.fromOffset(150, 330), Position = UDim2.new(1, -12, 0.42, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = root }, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }),
	})
	sideButton("investors", "Investors", "investors", C.green, C.greenDark, 1, function()
		Bus.open("investors")
	end)
	sideButton("evolve", "Evolution", "evolve", C.violet, Color3.fromRGB(90, 50, 160), 2, function()
		Bus.open("evolve")
	end)
	sideButton("ascend", "Ascension", "ascend", C.gold, C.goldDark, 3, function()
		Bus.open("ascend")
	end)
	sideButton("forever", "Forever", "forever", C.teal, Color3.fromRGB(20, 120, 140), 4, function()
		Bus.open("forever")
	end)
	sideButton("dash", "DogDash", "dashgame", C.ketchup, C.redDark, 5, function()
		Bus.open("dash")
	end)
	-- bottom bar
	local bar = new("Frame", { Size = UDim2.fromOffset(700, 66), Position = UDim2.new(0.5, 0, 1, -10), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = root }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	bottomButton("manage", "Manage", "manage", C.blue, C.blueDark, 1, function()
		Bus.open("panel", "Manage")
	end).frame.Parent = bar
	bottomButton("powers", "Powers", "powers", C.violet, Color3.fromRGB(90, 50, 160), 2, function()
		Bus.open("panel", "Powers")
	end).frame.Parent = bar
	bottomButton("decor", "Decor", "decorShop", C.green, C.greenDark, 3, function()
		Bus.open("panel", "Decor")
	end).frame.Parent = bar
	bottomButton("shop", "Shop", "shop", C.gold, C.goldDark, 4, function()
		Bus.open("panel", "Shop")
	end).frame.Parent = bar
	bottomButton("buyNext", "Buy Next", "remoteBuy", C.green, C.greenDark, 5, function()
		State.send("buyNext")
	end).frame.Parent = bar
	bulkButton = bottomButton("bulk", "x1", nil, C.gold, C.goldDark, 6, function()
		local d = State.data
		if not d then
			return
		end
		local opts = d.bulk
		local idx = table.find(opts, Bus.bulk) or 1
		Bus.setBulk(opts[idx % #opts + 1])
		Kit.pulse(bulkButton.frame)
	end)
	bulkButton.frame.Parent = bar
	-- entrance: everything pops in, staggered
	Kit.popIn(wallet, 0.1)
	Kit.popIn(namePill, 0.2)
	Kit.popIn(nextBar, 0.25)
	for i, b in { "manage", "powers", "decor", "shop", "buyNext", "bulk" } do
		Kit.popIn(bottomButtons[b].frame, 0.3 + i * 0.06)
	end
end

local function setSide(id: string, on: boolean)
	local b = rightButtons[id]
	if on and not wasVisible[id] then
		b.frame.Visible = true
		Kit.popIn(b.frame)
		Kit.wiggle(b.frame)
	elseif not on then
		b.frame.Visible = false
	end
	wasVisible[id] = on
end

local function refresh(d: any)
	targetCash = Bus.big(d.cash)
	if BigNum.lt(lastCash, targetCash) and not BigNum.isZero(lastCash) then
		Kit.pulse(wallet, 0.06)
	end
	lastCash = targetCash
	local rate = Bus.big(d.rate)
	rateText.Text = if rate.m > 0 then "+" .. Format.short(rate) .. "/s" else "Click your stand to sell!"
	nameText.Text = d.name .. "  ✏️"
	if d.loadError then
		banner.Text = "⚠ " .. d.loadError
		banner.Visible = true
	elseif not d.canSave then
		banner.Text = "⚠ Saving is off for this visit"
		banner.Visible = true
	else
		banner.Visible = false
	end
	local offered = Bus.big(d.offered)
	local investors = Bus.big(d.investors)
	setSide("investors", offered.m > 0 or investors.m > 0 or d.credits > 0)
	setSide("evolve", investors.m > 0 or d.evo.n > 0)
	setSide("ascend", d.asc.n > 0 or d.asc.owned >= d.asc.total * 0.6)
	setSide("forever", d.tokens > 0)
	rightButtons.forever.setText("Forever x" .. d.tokens)
	setSide("dash", d.dash == true)
	bottomButtons.buyNext.frame.Visible = d.powers.remoteBuy.tier > 0
	bottomButtons.buyNext.setEnabled(d.nextPad ~= nil)
	local opts = d.bulk
	bulkButton.frame.Visible = #opts > 1
	if not table.find(opts, Bus.bulk) then
		Bus.setBulk(1)
	end
	bulkButton.setText(if Bus.bulk == "max" then "MAX" else "x" .. tostring(Bus.bulk))
	-- next unlock: name, % of its price you have, its icon
	local np = d.nextPad and Economy.padById[d.nextPad]
	if np and d.pads[np.id] and d.pads[np.id].c then
		local cost = Bus.big(d.pads[np.id].c)
		local frac = math.clamp(BigNum.toNumber(BigNum.div(targetCash, cost)), 0, 1)
		nextBar.Visible = true
		nextText.Text = string.format("Next: %s  %s", np.name, if frac >= 1 then "READY!" else Format.short(cost))
		Kit.tween(nextFill, 0.25, { Size = UDim2.fromScale(frac, 1) })
		nextFill.BackgroundColor3 = if frac >= 1 then C.gold else C.green
		local key = if np.kind == "unlock" then np.bizId else (np.model or "")
		if key ~= nextIconKey then
			nextIconKey = key
			if nextIcon then
				nextIcon:Destroy()
			end
			local icon = Kit.icon(if np.kind == "unlock" then np.bizId else (np.model or "cash"), 40, nextBar, UDim2.fromOffset(4, 3))
			nextIcon = icon
			Kit.popIn(icon)
		end
	else
		nextBar.Visible = false
	end
end

-- guide beam from the player to the next affordable purchase
local beam: Beam? = nil
local a0: Attachment? = nil
local a1: Attachment? = nil
local function guide()
	local d = State.data
	local ch = Players.LocalPlayer.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	local plotIdx = Players.LocalPlayer:GetAttribute("Plot")
	local plots = workspace:FindFirstChild("Plots")
	local plot = plots and plotIdx and plots:FindFirstChild("Plot" .. tostring(plotIdx))
	local target: BasePart? = nil
	if d and d.nextPad and plot then
		local pad = d.pads[d.nextPad]
		if pad and pad.c and BigNum.gte(Bus.big(d.cash), Bus.big(pad.c)) then
			target = plot:FindFirstChild(d.nextPad) :: BasePart?
		end
	end
	if not root or not target then
		if beam then
			beam.Enabled = false
		end
		return
	end
	if not beam then
		local b = Instance.new("Beam")
		b.Width0, b.Width1 = 0.6, 0.6
		b.FaceCamera = true
		b.Color = ColorSequence.new(C.mustard)
		b.Transparency = NumberSequence.new(0.35)
		b.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		b.TextureSpeed = 2
		b.TextureLength = 2
		b.LightEmission = 0.6
		beam = b
		a1 = Instance.new("Attachment")
	end
	local bm = beam :: Beam
	if not a0 or a0.Parent ~= root then
		a0 = Instance.new("Attachment")
		;(a0 :: Attachment).Position = Vector3.new(0, -2, 0)
		;(a0 :: Attachment).Parent = root
	end
	local att1 = a1 :: Attachment
	if att1.Parent ~= target then
		att1.Parent = target
	end
	bm.Attachment0 = a0
	bm.Attachment1 = att1
	bm.Parent = root
	bm.Enabled = (root.Position - target.Position).Magnitude > 10
end

function Hud.init()
	build()
	State.Changed:Connect(refresh)
	Bus.BulkChanged:Connect(function()
		if State.data then
			refresh(State.data)
		end
	end)
	State.Notify:Connect(function(kind, data)
		if kind == "toast" then
			toast(data.text, data.kind)
		elseif kind == "bought" then
			toast("Bought " .. data.name .. "!", "good")
		elseif kind == "cash" and data.source ~= "pickup" then
			toast("+" .. Format.cash(Bus.big(data.amount)), "cash")
		elseif kind == "purchase" then
			toast(data.msg, "good")
		elseif kind == "decor" then
			toast(data.msg, "good")
		elseif kind == "milestone" then
			if data.kind == "cash" then
				celebrate("🎉 " .. Format.cash(Bus.big(data.amount)) .. " earned!", "Your hot dog empire is growing", C.gold)
			elseif data.kind == "unlock" then
				celebrate("🏪 " .. data.name .. " is open!", "A new business joins your plot", C.green)
			elseif data.kind == "level" then
				local biz = Economy.bizById[data.bizId]
				celebrate("⭐ " .. biz.name .. " level " .. data.level .. "!", "Your plot got busier", C.blue)
			end
		end
	end)
	local acc = 0
	RunService.RenderStepped:Connect(function(dt: number)
		-- smooth count-up for small values; large values snap (no float precision there)
		local target = BigNum.toNumber(targetCash)
		if targetCash.e < 14 and target > shownCash and target - shownCash < 1e13 then
			shownCash += (target - shownCash) * math.min(1, dt * 10)
			if target - shownCash < 0.005 then
				shownCash = target
			end
			walletText.Text = Format.cash(BigNum.roundCents(BigNum.new(shownCash)))
		else
			shownCash = if target == math.huge then 0 else target
			walletText.Text = Format.cash(targetCash)
		end
		acc += dt
		if acc > 0.25 then
			acc = 0
			guide()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- Centred tall, scrollable panel with Manage / Powers / Shop tabs and a red close button.
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Products = require(Shared.Products)
local Kit = require(script.Parent.Parent.UI.Kit)
local Bus = require(script.Parent.Bus)
local State = require(script.Parent.State)

local C = Kit.C
local new = Kit.new

local Panels = {}

local gui: ScreenGui
local panel: Frame
local list: ScrollingFrame
local tabs: { [string]: Kit.Button } = {}
local current = "Manage"
local rows: { [string]: any } = {}
local priceCache: { [string]: string } = {}

local PRODUCT_NAMES: { [string]: string } = {}
for _, p in Economy.Catalog.products do
	PRODUCT_NAMES[p.id] = p.name
end

local function clear()
	for _, c in list:GetChildren() do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	rows = {}
end

local function card(height: number, order: number): Frame
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = C.bg, LayoutOrder = order, Parent = list }, { Kit.corner(14), Kit.stroke(Color3.fromRGB(220, 200, 170), 2) })
	return f
end

local function robuxPrice(key: string): string
	local d = State.data
	if d and d.mock then
		return "TEST BUY"
	end
	if priceCache[key] then
		return priceCache[key]
	end
	local prod = Products.byKey[key]
	if not prod or not prod.id then
		return "Soon"
	end
	priceCache[key] = "…"
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(prod.id :: number, if prod.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
		end)
		priceCache[key] = if ok and info and info.PriceInRobux then "R$ " .. tostring(info.PriceInRobux) else "Soon"
	end)
	return priceCache[key]
end

local function buy(key: string)
	local d = State.data
	if d and d.mock then
		State.send("mockBuy", key)
	else
		State.send("buyProduct", key)
	end
end

---------------------------------------------------------------- Manage
local function buildManage(d: any)
	if d.powers.manage.tier < 1 then
		local f = card(150, 1)
		Kit.label({ Text = "🔒 Manage is locked", Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 10), Parent = f, TextColor3 = C.ink })
		Kit.label({ Text = "Unlock Manage in Powers to run and upgrade every business from here. Until then, walk up to each business.", Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 52), Parent = f, TextColor3 = C.inkSoft, Font = Kit.FONT_BODY, MaxText = 18, TextWrapped = true })
		Kit.button({ text = "Go to Powers", size = UDim2.fromOffset(180, 34), pos = UDim2.new(0.5, 0, 1, -8), anchor = Vector2.new(0.5, 1), parent = f, color = C.violet, dark = Color3.fromRGB(90, 50, 160), onClick = function()
			Bus.open("panel", "Powers")
		end })
		return
	end
	for i, biz in Economy.businesses do
		local b = d.biz[biz.id]
		if not b.owned then
			continue
		end
		local f = card(108, i)
		Kit.icon(biz.id, 34, f, UDim2.fromOffset(8, 3))
		Kit.label({ Text = biz.name, Size = UDim2.new(0.5, -50, 0, 28), Position = UDim2.fromOffset(48, 6), Parent = f, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24 })
		local out = Kit.label({ Text = "", Size = UDim2.new(0.5, -10, 0, 28), Position = UDim2.new(0.5, 0, 0, 6), Parent = f, TextColor3 = C.greenDark, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 24 })
		local barBtn = new("TextButton", { Size = UDim2.new(0.55, -10, 0, 30), Position = UDim2.fromOffset(10, 40), BackgroundColor3 = Color3.fromRGB(40, 70, 40), Text = "", AutoButtonColor = false, Parent = f }, { Kit.corner(8) })
		local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.green, Parent = barBtn }, { Kit.corner(8) })
		local barText = Kit.label({ Text = "", Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), Parent = barBtn, ZIndex = 2, MaxText = 20 })
		barBtn.Activated:Connect(function()
			State.send("click", biz.id)
		end)
		local up = Kit.button({ text = "", color = C.blue, dark = C.blueDark, size = UDim2.new(0.45, -10, 0, 40), pos = UDim2.new(0.55, 0, 0, 36), parent = f, textSize = 20, onClick = function()
			State.send("upgrade", biz.id, Bus.bulk)
		end })
		local info = Kit.label({ Text = "", Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 80), Parent = f, TextColor3 = C.inkSoft, Font = Kit.FONT_BODY, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16 })
		rows[biz.id] = { out = out, fill = fill, barText = barText, up = up, info = info }
	end
end

local function refreshManage(d: any)
	local cash = Bus.big(d.cash)
	for id, r in rows do
		local b = d.biz[id]
		if not b or not b.owned then
			continue
		end
		r.out.Text = Format.cash(Bus.big(b.output))
		local cost = Bus.big(b.cost1)
		local n = "1"
		if Bus.bulk == "max" then
			cost = Bus.big(b.maxCost)
			n = tostring(b.maxN)
			r.up.setEnabled(b.maxN > 0)
		elseif Bus.bulk ~= 1 and b.bulk[tostring(Bus.bulk)] then
			cost = Bus.big(b.bulk[tostring(Bus.bulk)])
			n = tostring(Bus.bulk)
			r.up.setEnabled(BigNum.gte(cash, cost))
		else
			r.up.setEnabled(BigNum.gte(cash, cost))
		end
		r.up.setText(string.format("x%s  %s", n, Format.short(cost)))
		r.info.Text = string.format("Level %d · %s/s · %s cash · %s speed%s", b.level, Format.short(Bus.big(b.rate)), Format.short(Bus.big(b.cashMult)):sub(2), Format.short(Bus.big(b.speedMult)):sub(2), if b.auto then " · automatic" else "")
	end
end

---------------------------------------------------------------- Powers

local function buildPowers(d: any)
	local order = 0
	for _, pw in Economy.Catalog.powers do
		order += 1
		local st = d.powers[pw.id]
		local f = card(120, order)
		Kit.icon(pw.id, 34, f, UDim2.fromOffset(8, 4))
		Kit.label({ Text = pw.name, Size = UDim2.new(1, -190, 0, 30), Position = UDim2.fromOffset(48, 6), Parent = f, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24 })
		Kit.label({ Text = string.format("Level %d / %d", st.tier, pw.tiers), Size = UDim2.fromOffset(130, 26), Position = UDim2.new(1, -140, 0, 8), Parent = f, TextColor3 = C.violet, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 20 })
		Kit.label({ Text = pw.desc, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 38), Parent = f, TextColor3 = C.inkSoft, Font = Kit.FONT_BODY, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, MaxText = 17 })
		local inv = Kit.button({ text = "", color = C.green, dark = C.greenDark, size = UDim2.new(0.5, -15, 0, 38), pos = UDim2.new(0, 10, 1, -44), parent = f, textSize = 18, onClick = function()
			State.send("buyPower", pw.id)
		end })
		local cost = st.cost and Bus.big(st.cost)
		if cost then
			inv.setText("👽 " .. Format.amount(cost, 0) .. " investors")
			inv.setEnabled(BigNum.gte(Bus.big(d.investors), cost))
		else
			inv.setText(if st.tier >= pw.tiers then "Maxed" else "—")
			inv.setEnabled(false)
		end
		if Products.byKey[pw.id] then
			local owned = d.owned[pw.id]
			local rb = Kit.button({ text = if owned then "Owned" else robuxPrice(pw.id), color = C.gold, dark = C.goldDark, size = UDim2.new(0.5, -15, 0, 38), pos = UDim2.new(0.5, 5, 1, -44), parent = f, textSize = 18, onClick = function()
				buy(pw.id)
			end })
			rb.setEnabled(not owned)
		end
	end
end

---------------------------------------------------------------- Shop
local function buildShop(d: any)
	local order = 0
	for _, prod in Products.list do
		order += 1
		local f = card(92, order)
		Kit.icon(prod.key, 64, f, UDim2.fromOffset(6, 14))
		Kit.label({ Text = PRODUCT_NAMES[prod.key] or prod.key, Size = UDim2.new(1, -230, 0, 30), Position = UDim2.fromOffset(74, 8), Parent = f, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22 })
		Kit.label({ Text = prod.blurb, Size = UDim2.new(1, -230, 0, 40), Position = UDim2.fromOffset(74, 40), Parent = f, TextColor3 = C.inkSoft, Font = Kit.FONT_BODY, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, MaxText = 16 })
		local owned = d.owned[prod.key]
		local b = Kit.button({ text = if owned then "Owned" else robuxPrice(prod.key), color = C.gold, dark = C.goldDark, size = UDim2.fromOffset(140, 52), pos = UDim2.new(1, -150, 0.5, 0), anchor = Vector2.new(0, 0.5), parent = f, textSize = 22, onClick = function()
			buy(prod.key)
		end })
		b.setEnabled(not owned)
	end
	if d.mock then
		order += 1
		local f = card(150, order)
		f.BackgroundColor3 = Color3.fromRGB(235, 245, 255)
		Kit.label({ Text = "Studio test tools (not in the live game)", Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 6), Parent = f, TextColor3 = C.blueDark, MaxText = 20 })
		Kit.label({ Text = "TEST buttons run the real receipt code with fake receipts. No Robux is ever charged.", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 34), Parent = f, TextColor3 = C.inkSoft, Font = Kit.FONT_BODY, TextWrapped = true, MaxText = 15 })
		Kit.button({ text = "Resend last receipt", color = C.blue, dark = C.blueDark, size = UDim2.new(0.5, -15, 0, 44), pos = UDim2.new(0, 10, 1, -52), parent = f, textSize = 18, onClick = function()
			State.send("mockBuy", "forever", true)
		end })
		Kit.button({ text = "Cancelled purchase", color = C.red, dark = C.redDark, size = UDim2.new(0.5, -15, 0, 44), pos = UDim2.new(0.5, 5, 1, -52), parent = f, textSize = 18, onClick = function()
			State.send("mockBuy", "cash1h", false, true)
		end })
	end
end

---------------------------------------------------------------- Decor
local function buildDecor(d: any)
	local cash = Bus.big(d.cash)
	local intro = card(56, 0)
	Kit.label({ Text = "Decorate your plot! Decorations are just for looks and stay forever, even after resets.", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Parent = intro, TextColor3 = C.inkSoft, Font = Kit.FONT_BODY, TextWrapped = true, MaxText = 16 })
	for i, item in Economy.Catalog.decor.items do
		local f = card(84, i)
		Kit.icon(item.model, 68, f, UDim2.fromOffset(6, 8))
		Kit.label({ Text = item.name, Size = UDim2.new(1, -240, 0, 30), Position = UDim2.fromOffset(82, 10), Parent = f, TextColor3 = C.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22 })
		Kit.label({ Text = Format.cash(item.price), Size = UDim2.new(1, -240, 0, 24), Position = UDim2.fromOffset(82, 44), Parent = f, TextColor3 = C.greenDark, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20 })
		local owned = d.decor and d.decor[item.id]
		local b = Kit.button({ text = if owned then "Placed ✓" else "Buy", color = C.green, dark = C.greenDark, size = UDim2.fromOffset(140, 52), pos = UDim2.new(1, -150, 0.5, 0), anchor = Vector2.new(0, 0.5), parent = f, textSize = 22, onClick = function()
			State.send("buyDecor", item.id)
		end })
		b.setEnabled(not owned and BigNum.gte(cash, BigNum.new(item.price)))
	end
end

local lastSig = ""
local function tabSignature(d: any): string
	local cash = Bus.big(d.cash)
	local parts = { current }
	if current == "Decor" then
		for _, item in Economy.Catalog.decor.items do
			table.insert(parts, (d.decor and d.decor[item.id] and "o" or "") .. (BigNum.gte(cash, BigNum.new(item.price)) and "a" or "-"))
		end
	elseif current == "Powers" then
		local inv = Bus.big(d.investors)
		for id, st in d.powers do
			table.insert(parts, id .. st.tier .. (st.cost and BigNum.gte(inv, Bus.big(st.cost)) and "a" or "-") .. tostring(d.owned[id]))
		end
		table.sort(parts)
	else
		for k, v in d.owned do
			table.insert(parts, k .. tostring(v))
		end
		table.sort(parts)
	end
	return table.concat(parts, "|")
end

local function rebuild()
	local d = State.data
	if not d or not gui.Enabled then
		return
	end
	clear()
	if current == "Manage" then
		buildManage(d)
		refreshManage(d)
	elseif current == "Powers" then
		buildPowers(d)
	elseif current == "Decor" then
		buildDecor(d)
	else
		buildShop(d)
	end
	-- cards slide in one after another
	local n = 0
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			n += 1
			Kit.popIn(c, math.min(n, 8) * 0.03)
		end
	end
	for name, b in tabs do
		b.setColor(if name == current then C.blue else C.grey, if name == current then C.blueDark else Color3.fromRGB(120, 115, 110))
	end
end

function Panels.open(tab: string)
	current = tab
	lastSig = ""
	local wasOpen = gui.Enabled
	gui.Enabled = true
	panel.Size = UDim2.new(0, 560, 1, -150)
	if not wasOpen then
		Kit.popIn(panel)
	end
	rebuild()
end

function Panels.close()
	gui.Enabled = false
end

function Panels.init()
	local g, root = Kit.canvas("Panels", 20)
	gui = g
	gui.Enabled = false
	-- dim backdrop closes on tap
	local back = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.55, Text = "", AutoButtonColor = false, Parent = root })
	back.Activated:Connect(Panels.close)
	panel = Kit.panel({ size = UDim2.new(0, 560, 1, -150), pos = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), parent = root })
	local tabRow = new("Frame", { Size = UDim2.new(1, -80, 0, 52), Position = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Parent = panel }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
	})
	for i, name in { "Manage", "Powers", "Decor", "Shop" } do
		local b = Kit.button({ text = name, color = C.grey, dark = Color3.fromRGB(120, 115, 110), size = UDim2.fromOffset(108, 50), parent = tabRow, textSize = 20, onClick = function()
			current = name
			rebuild()
		end })
		b.frame.LayoutOrder = i
		tabs[name] = b
	end
	Kit.button({ text = "✕", color = C.red, dark = C.redDark, size = UDim2.fromOffset(52, 52), pos = UDim2.new(1, -12, 0, 12), anchor = Vector2.new(1, 0), parent = panel, textSize = 28, onClick = Panels.close })
	list = new("ScrollingFrame", {
		Size = UDim2.new(1, -24, 1, -84),
		Position = UDim2.fromOffset(12, 74),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.inkSoft,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = panel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8) }),
	})
	Bus.Opened:Connect(function(what, arg)
		if what == "panel" then
			Panels.open(arg)
		elseif gui.Enabled and what ~= "panel" then
			Panels.close()
		end
	end)
	local lastBuild = 0
	State.Changed:Connect(function(d)
		if not gui.Enabled then
			return
		end
		if current == "Manage" then
			-- rebuild only when the set of owned businesses changes
			local count = 0
			for _, b in d.biz do
				if b.owned then
					count += 1
				end
			end
			local have = 0
			for _ in rows do
				have += 1
			end
			if count ~= have and d.powers.manage.tier > 0 then
				rebuild()
			end
			refreshManage(d)
		elseif os.clock() - lastBuild > 0.5 then
			-- rebuild only when something visible changed (owned / affordable / tiers)
			lastBuild = os.clock()
			local sig = tabSignature(d)
			if sig ~= lastSig then
				lastSig = sig
				rebuild()
			end
		end
	end)
	Bus.BulkChanged:Connect(function()
		if gui.Enabled and current == "Manage" and State.data then
			refreshManage(State.data)
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not gui.Enabled or current ~= "Manage" then
			return
		end
		local d = State.data
		if not d then
			return
		end
		for id, r in rows do
			local b = d.biz[id]
			local p = State.progress(b)
			r.fill.Size = UDim2.fromScale(p, 1)
			local cps = b.cps or 1
			r.barText.Text = if b.auto then (if cps > 20 then "MAX SPEED" else Format.timer((1 - p) / cps)) elseif b.running then Format.timer((1 - p) / cps) else "CLICK"
		end
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">PhoneUI</string>
              <string name="Source"><![CDATA[--!strict
-- Lower-left phone: buyer offers with Accept / Raise / Decline, better and final offers,
-- and "no deal" endings. Sits above the mobile thumbstick on touch devices.
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Format = require(Shared.Logic.Format)
local Kit = require(script.Parent.Parent.UI.Kit)
local Bus = require(script.Parent.Bus)
local State = require(script.Parent.State)

local C = Kit.C
local new = Kit.new

local PhoneUI = {}

local phone: Frame
local chat: Frame
local actions: Frame
local offerId: number? = nil
local raiseBtn: Kit.Button
local buttonsAll: { Kit.Button } = {}

local function bubble(text: string, mine: boolean)
	local b = new("Frame", { Size = UDim2.new(0.86, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = if mine then C.blue else Color3.fromRGB(235, 235, 240), LayoutOrder = #chat:GetChildren(), Parent = chat }, { Kit.corner(12), Kit.pad(8) })
	b.Position = UDim2.fromScale(if mine then 0.14 else 0, 0)
	new("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = Kit.FONT_BODY, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = if mine then C.white else C.ink, Text = text, Parent = b })
	-- keep the latest few messages
	local kids = {}
	for _, k in chat:GetChildren() do
		if k:IsA("Frame") then
			table.insert(kids, k)
		end
	end
	if #kids > 4 then
		kids[1]:Destroy()
	end
end

local function setButtons(on: boolean)
	actions.Visible = on
	for _, b in buttonsAll do
		b.setPending(false)
	end
end

local function hideSoon()
	task.delay(2.8, function()
		if offerId == nil then
			Kit.tween(phone, 0.35, { Position = UDim2.new(0, -320, 1, phone.Position.Y.Offset) })
		end
	end)
end

local function showPhone()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local y = if touch then -200 else -96
	phone.Position = UDim2.new(0, -320, 1, y)
	Kit.tween(phone, 0.35, { Position = UDim2.new(0, 12, 1, y) }, Enum.EasingStyle.Back)
end

local function respond(action: string)
	if not offerId then
		return
	end
	for _, b in buttonsAll do
		b.setPending(true)
	end
	bubble(if action == "accept" then "Deal!" elseif action == "raise" then "Can you do better?" else "No thanks.", true)
	State.send("phone", offerId, action)
end

function PhoneUI.init()
	local _, root = Kit.canvas("Phone", 15)
	phone = new("Frame", { Size = UDim2.fromOffset(250, 330), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, -320, 1, -96), BackgroundColor3 = Color3.fromRGB(40, 40, 50), Parent = root }, { Kit.corner(26), Kit.stroke(C.shadow, 3) })
	local screen = new("Frame", { Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.bg, Parent = phone }, { Kit.corner(20) })
	local header = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.mustard, Parent = screen }, { Kit.corner(20) })
	local who = Kit.label({ Text = "📱 Messages", Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = header, TextColor3 = C.ink, MaxText = 20 })
	chat = new("Frame", { Size = UDim2.new(1, -12, 1, -150), Position = UDim2.fromOffset(6, 46), BackgroundTransparency = 1, Parent = screen }, {
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }),
	})
	actions = new("Frame", { Size = UDim2.new(1, -12, 0, 98), Position = UDim2.new(0, 6, 1, -102), BackgroundTransparency = 1, Parent = screen })
	local accept = Kit.button({ text = "Accept", color = C.green, dark = C.greenDark, size = UDim2.new(1, 0, 0, 46), parent = actions, textSize = 22, onClick = function()
		respond("accept")
	end })
	raiseBtn = Kit.button({ text = "Raise", color = C.gold, dark = C.goldDark, size = UDim2.new(0.5, -4, 0, 46), pos = UDim2.fromOffset(0, 52), parent = actions, textSize = 20, onClick = function()
		respond("raise")
	end })
	local decline = Kit.button({ text = "Decline", color = C.red, dark = C.redDark, size = UDim2.new(0.5, -4, 0, 46), pos = UDim2.new(0.5, 4, 0, 52), parent = actions, textSize = 20, onClick = function()
		respond("decline")
	end })
	buttonsAll = { accept, raiseBtn, decline }

	State.Notify:Connect(function(kind, data)
		if kind ~= "phone" then
			return
		end
		local o = data.offer
		local amount = Format.cash(Bus.big(o.amount))
		if data.outcome == "new" then
			for _, k in chat:GetChildren() do
				if k:IsA("Frame") then
					k:Destroy()
				end
			end
			offerId = o.id
			who.Text = "📱 " .. o.buyer
			bubble(string.format("Hey! I'll pay %s for a truckload of your hot dogs. Deal?", amount), false)
			raiseBtn.setText("Raise")
			setButtons(true)
			showPhone()
		elseif data.outcome == "better" then
			bubble(string.format("Okay, okay… %s. How's that?", amount), false)
			setButtons(true)
		elseif data.outcome == "final" then
			bubble(string.format("Final offer: %s. Take it or leave it!", amount), false)
			raiseBtn.setText("Push it")
			setButtons(true)
		elseif data.outcome == "accepted" then
			bubble("Pleasure doing business! 🌭", false)
			offerId = nil
			setButtons(false)
			hideSoon()
		elseif data.outcome == "walked" then
			bubble("No deal. Goodbye!", false)
			offerId = nil
			setButtons(false)
			hideSoon()
		elseif data.outcome == "declined" then
			bubble("Maybe next time!", false)
			offerId = nil
			setButtons(false)
			hideSoon()
		elseif data.outcome == "expired" or data.outcome == "closed" then
			bubble("Guess you're busy. Bye!", false)
			offerId = nil
			setButtons(false)
			hideSoon()
		end
	end)
end

return PhoneUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
-- Latest server snapshot of this player's game. The client only renders it; every number
-- shown as owned/earned comes from here (server-accepted values).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local State = {}
State.data = nil :: any
State.receivedAt = 0
local changed = Instance.new("BindableEvent")
State.Changed = changed.Event
local notify = Instance.new("BindableEvent")
State.Notify = notify.Event -- (kind, data)

local Action = Net.get("Action")

function State.send(name: string, ...: any)
	Action:FireServer(name, ...)
end

-- Live progress (0..1) of a business, interpolated from the last snapshot.
function State.progress(b: any): number
	if not b or not b.owned then
		return 0
	end
	if not b.running and not b.auto then
		return 0
	end
	local cps = b.cps or 1
	if cps > 20 then
		return 1
	end
	local p = b.progress + (os.clock() - State.receivedAt) * cps
	if b.auto then
		return p % 1
	end
	return math.min(p, 1)
end

function State.init()
	Net.get("State").OnClientEvent:Connect(function(snap)
		State.data = snap
		State.receivedAt = os.clock()
		changed:Fire(snap)
	end)
	Net.get("Notify").OnClientEvent:Connect(function(kind, data)
		notify:Fire(kind, data)
	end)
	State.send("sync")
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">WorldUI</string>
              <string name="Source"><![CDATA[--!strict
-- World-space business controls over each owned business in the player's plot:
-- output label, green production bar (CLICK / countdown), blue upgrade button with a gold
-- badge. Also colours pad prices by affordability and floats "+$" pops (throttled).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local BigNum = require(Shared.Logic.BigNum)
local Economy = require(Shared.Logic.Economy)
local Format = require(Shared.Logic.Format)
local Kit = require(script.Parent.Parent.UI.Kit)
local Bus = require(script.Parent.Bus)
local Effects = require(script.Parent.Effects)
local State = require(script.Parent.State)

local C = Kit.C
local new = Kit.new
local player = Players.LocalPlayer

local WorldUI = {}

type Card = {
	gui: BillboardGui,
	output: TextLabel,
	fill: Frame,
	barText: TextLabel,
	barButton: TextButton,
	upgrade: Kit.Button,
	badge: TextLabel,
	pending: boolean,
}
local cards: { [string]: Card } = {}
local lastPop: { [string]: number } = {}

local function makeCard(bizId: string, anchor: BasePart): Card
	local biz = Economy.bizById[bizId]
	local gui = new("BillboardGui", {
		Name = "Biz_" .. bizId,
		Adornee = anchor,
		Size = UDim2.fromOffset(250, 150),
		AlwaysOnTop = false,
		MaxDistance = 140,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Active = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local frame = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	Kit.label({ Text = biz.name, Size = UDim2.new(1, 0, 0, 24), Parent = frame, MaxText = 22 })
	local output = Kit.label({ Text = "$0.00", Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 22), Parent = frame, TextColor3 = C.white, MaxText = 34 })
	-- green production bar: tap to sell when manual
	local barButton = new("TextButton", { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 62), BackgroundColor3 = Color3.fromRGB(40, 70, 40), Text = "", AutoButtonColor = false, Parent = frame }, { Kit.corner(10), Kit.stroke(C.shadow, 3) })
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.green, Parent = barButton }, { Kit.corner(10) })
	local barText = Kit.label({ Text = "CLICK", Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), Parent = barButton, MaxText = 24, ZIndex = 2 })
	local card: Card
	local upgrade = Kit.button({
		text = "Upgrade",
		color = C.blue,
		dark = C.blueDark,
		size = UDim2.new(1, -60, 0, 42),
		pos = UDim2.fromOffset(10, 102),
		parent = frame,
		textSize = 22,
		onClick = function()
			card.pending = true
			card.upgrade.setPending(true)
			State.send("upgrade", bizId, Bus.bulk)
			task.delay(0.6, function()
				card.pending = false
			end)
		end,
	})
	local badge = Kit.label({ Text = "x1", Size = UDim2.fromOffset(44, 42), Position = UDim2.new(1, -54, 0, 100), BackgroundTransparency = 0, BackgroundColor3 = C.gold, Parent = frame, MaxText = 20 })
	Kit.corner(10).Parent = badge
	card = { gui = gui, output = output, fill = fill, barText = barText, barButton = barButton, upgrade = upgrade, badge = badge, pending = false }
	barButton.Activated:Connect(function()
		local d = State.data
		local b = d and d.biz[bizId]
		if b and b.owned and not b.auto and not b.running then
			Effects.play("click", 0.4, 0.05)
			barText.Text = "…"
			State.send("click", bizId)
		end
	end)
	return card
end

local function plotFolder(): Instance?
	local i = player:GetAttribute("Plot")
	local plots = workspace:FindFirstChild("Plots")
	return if plots and i then plots:FindFirstChild("Plot" .. tostring(i)) else nil
end

local function ensureCards()
	local plot = plotFolder()
	local anchors = plot and plot:FindFirstChild("Anchors")
	if not anchors then
		return
	end
	for _, biz in Economy.businesses do
		local a = anchors:FindFirstChild(biz.id) :: BasePart?
		if a and not cards[biz.id] then
			cards[biz.id] = makeCard(biz.id, a)
		elseif a and cards[biz.id].gui.Adornee ~= a then
			cards[biz.id].gui.Adornee = a
		end
	end
end

local function refresh(d: any)
	ensureCards()
	local cash = Bus.big(d.cash)
	for id, card in cards do
		local b = d.biz[id]
		card.gui.Enabled = b ~= nil and b.owned
		if not (b and b.owned) then
			continue
		end
		card.output.Text = Format.cash(Bus.big(b.output))
		local cost: BigNum.Big
		local label: string
		if Bus.bulk == "max" then
			cost = Bus.big(b.maxCost)
			label = if b.maxN > 0 then string.format("Upgrade x%d  %s", b.maxN, Format.short(cost)) else "Upgrade " .. Format.short(Bus.big(b.cost1))
			card.upgrade.setEnabled(b.maxN > 0)
		elseif Bus.bulk ~= 1 and b.bulk[tostring(Bus.bulk)] then
			cost = Bus.big(b.bulk[tostring(Bus.bulk)])
			label = string.format("Upgrade x%s  %s", tostring(Bus.bulk), Format.short(cost))
			card.upgrade.setEnabled(BigNum.gte(cash, cost))
		else
			cost = Bus.big(b.cost1)
			label = "Upgrade " .. Format.short(cost)
			card.upgrade.setEnabled(BigNum.gte(cash, cost))
		end
		card.upgrade.setText(label)
		card.upgrade.setPending(false)
		-- gold badge: number of level upgrades bought so far (hypothesis H-BADGE)
		card.badge.Text = "x" .. tostring(b.level - 1)
		card.badge.Visible = b.level > 1
	end
	-- pads: price colour by affordability, NEW sparkle on available pads
	local plot = plotFolder()
	if plot then
		for padId, ps in d.pads do
			if ps.s == 1 then
				local part = plot:FindFirstChild(padId)
				local lbl = part and part:FindFirstChild("PadLabel")
				local price = lbl and lbl:FindFirstChild("Price") :: TextLabel?
				if price then
					local c = Bus.big(ps.c)
					price.Text = Format.cash(c)
					price.TextColor3 = if BigNum.gte(cash, c) then Color3.fromRGB(140, 255, 140) else Color3.fromRGB(255, 130, 120)
				end
			end
		end
	end
	-- cash pops for this snapshot's earnings (one per business per 0.25 s at most)
	if d.earned and plot then
		for bizId, e in d.earned do
			local now = os.clock()
			if now - (lastPop[bizId] or 0) < 0.25 then
				continue
			end
			lastPop[bizId] = now
			local card = cards[bizId]
			if card then
				local pop = Kit.label({ Text = "+" .. Format.short(Bus.big(e.amount)), Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 0), Parent = card.gui:FindFirstChildOfClass("Frame"), TextColor3 = C.gold, MaxText = 28, ZIndex = 5 })
				Kit.textStroke(2).Parent = pop
				Kit.tween(pop, 0.8, { Position = UDim2.fromOffset(0, -40), TextTransparency = 1 })
				task.delay(0.85, function()
					pop:Destroy()
				end)
			end
			Effects.play("cash", 0.25, 0.3)
		end
	end
end

-- Big floating word over a business card ("x2 CASH!", "LEVEL UP!").
local function burst(bizId: string, text: string, color: Color3)
	local card = cards[bizId]
	if not card then
		return
	end
	local frame = card.gui:FindFirstChildOfClass("Frame")
	local l = Kit.label({ Text = text, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 30), Parent = frame, TextColor3 = color, MaxText = 36, ZIndex = 6 })
	Kit.textStroke(3).Parent = l
	Kit.popIn(l)
	Kit.tween(l, 1.1, { Position = UDim2.fromOffset(0, -50), TextTransparency = 1 })
	task.delay(1.15, function()
		l:Destroy()
	end)
	Kit.pulse(card.output, 0.25)
end

function WorldUI.init()
	State.Notify:Connect(function(kind, data)
		if kind == "bought" and (data.kind == "cash" or data.kind == "speed") then
			burst(data.bizId, string.format("x%s %s!", tostring(data.mult), if data.kind == "cash" then "CASH" else "SPEED"), if data.kind == "cash" then C.gold else C.teal)
		elseif kind == "bought" and data.kind == "auto" then
			burst(data.bizId, "AUTOMATIC!", C.green)
		elseif kind == "leveled" then
			burst(data.bizId, if data.n > 1 then "LEVEL UP x" .. data.n .. "!" else "LEVEL UP!", C.white)
		end
	end)
	State.Changed:Connect(refresh)
	Bus.BulkChanged:Connect(function()
		if State.data then
			refresh(State.data)
		end
	end)
	RunService.RenderStepped:Connect(function()
		local d = State.data
		if not d then
			return
		end
		for id, card in cards do
			local b = d.biz[id]
			if not (b and b.owned) then
				continue
			end
			local p = State.progress(b)
			card.fill.Size = UDim2.fromScale(p, 1)
			local cps = b.cps or 1
			if b.auto then
				card.barText.Text = if cps > 20 then "MAX SPEED" else Format.timer((1 - p) / cps)
			elseif b.running then
				card.barText.Text = Format.timer(math.max(0, (1 - p) / cps))
			elseif card.barText.Text ~= "…" or os.clock() - State.receivedAt > 0.5 then
				card.barText.Text = "CLICK"
			end
		end
	end)
end

return WorldUI
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="48">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Sell Hot Dogs client entry: render server state, send requests. No grants are computed here.
local Controllers = script.Parent:WaitForChild("Controllers")

local State = require(Controllers.State)
local Effects = require(Controllers.Effects)
local Hud = require(Controllers.Hud)
local WorldUI = require(Controllers.WorldUI)
local Panels = require(Controllers.Panels)
local Dialogs = require(Controllers.Dialogs)
local PhoneUI = require(Controllers.PhoneUI)
local DashUI = require(Controllers.DashUI)
local Ambient = require(Controllers.Ambient)

Effects.init()
Hud.init()
WorldUI.init()
Panels.init()
Dialogs.init()
PhoneUI.init()
DashUI.init()
Ambient.init()
State.init()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="49">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Small UI kit: theme colours, instance builder, buttons with pressed/disabled feedback,
-- and a scaled design canvas that respects device safe areas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Kit = {}

Kit.C = {
	bg = Color3.fromRGB(255, 248, 232),
	panel = Color3.fromRGB(255, 252, 244),
	ink = Color3.fromRGB(70, 42, 26),
	inkSoft = Color3.fromRGB(130, 100, 80),
	green = Color3.fromRGB(76, 190, 80),
	greenDark = Color3.fromRGB(46, 140, 54),
	blue = Color3.fromRGB(56, 150, 235),
	blueDark = Color3.fromRGB(32, 100, 180),
	gold = Color3.fromRGB(250, 196, 40),
	goldDark = Color3.fromRGB(200, 140, 20),
	red = Color3.fromRGB(226, 66, 56),
	redDark = Color3.fromRGB(160, 36, 30),
	mustard = Color3.fromRGB(242, 194, 48),
	ketchup = Color3.fromRGB(216, 58, 46),
	violet = Color3.fromRGB(140, 90, 230),
	teal = Color3.fromRGB(40, 175, 195),
	grey = Color3.fromRGB(170, 165, 160),
	white = Color3.new(1, 1, 1),
	shadow = Color3.fromRGB(60, 35, 20),
}
local C = Kit.C
Kit.FONT = Enum.Font.FredokaOne
Kit.FONT_BODY = Enum.Font.GothamBold

function Kit.new(class: string, props: { [string]: any }, children: { any }?): any
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local new = Kit.new

function Kit.corner(r: number?): any
	return new("UICorner", { CornerRadius = UDim.new(0, r or 14) })
end

function Kit.stroke(color: Color3?, t: number?): any
	return new("UIStroke", { Color = color or C.shadow, Thickness = t or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Kit.textStroke(t: number?): UIStroke
	return new("UIStroke", { Color = C.shadow, Thickness = t or 2, Transparency = 0.2 })
end

function Kit.pad(px: number): any
	local u = UDim.new(0, px)
	return new("UIPadding", { PaddingLeft = u, PaddingRight = u, PaddingTop = u, PaddingBottom = u })
end

function Kit.label(props: { [string]: any }): TextLabel
	local base = {
		BackgroundTransparency = 1,
		Font = Kit.FONT,
		TextColor3 = C.white,
		TextScaled = true,
		Text = "",
	}
	for k, v in props do
		if k ~= "MaxText" then
			base[k] = v
		end
	end
	local l = new("TextLabel", base)
	if props.TextColor3 == nil or props.TextColor3 == C.white then
		Kit.textStroke().Parent = l
	end
	local maxSize = props.MaxText or 40
	new("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8, Parent = l })
	return l
end

export type Button = {
	frame: TextButton,
	text: TextLabel,
	setEnabled: (boolean) -> (),
	setPending: (boolean) -> (),
	setText: (string) -> (),
	setColor: (Color3, Color3) -> (),
}

-- Chunky game button: coloured face, dark lip, shrink on press, grey when disabled.
function Kit.button(props: { text: string, color: Color3?, dark: Color3?, size: UDim2, pos: UDim2?, anchor: Vector2?, parent: Instance?, onClick: () -> (), textSize: number?, icon: string? }): Button
	local color, dark = props.color or C.green, props.dark or C.greenDark
	local enabled, pending = true, false
	local holder = new("TextButton", {
		Size = props.size,
		Position = props.pos or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = dark,
		AutoButtonColor = false,
		Text = "",
		Parent = props.parent,
	}, { Kit.corner(12) })
	local face = new("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -5),
		BackgroundColor3 = color,
		Parent = holder,
	}, { Kit.corner(12) })
	new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(225, 225, 225)), Rotation = 90, Parent = face })
	local text: TextLabel
	if props.icon then
		-- icon on the left, label on the right
		local h = props.size.Y.Offset - 13
		Kit.icon(props.icon, math.max(16, h), face, UDim2.new(0, 4, 0.5, 0), Vector2.new(0, 0.5))
		text = Kit.label({ Text = props.text, Size = UDim2.new(1, -(h + 12), 1, -8), Position = UDim2.fromOffset(h + 8, 4), Parent = face, MaxText = props.textSize or 30 })
	else
		text = Kit.label({ Text = props.text, Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Parent = face, MaxText = props.textSize or 30 })
	end
	local scale = new("UIScale", { Parent = holder })
	local function paint()
		local on = enabled and not pending
		face.BackgroundColor3 = if on then color else C.grey
		holder.BackgroundColor3 = if on then dark else Color3.fromRGB(120, 115, 110)
		text.TextTransparency = if pending then 0.4 else 0
	end
	holder.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.93 }):Play()
	end)
	holder.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	holder.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
	end)
	holder.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	holder.Activated:Connect(function()
		if enabled and not pending then
			props.onClick()
		end
	end)
	local b: Button = {
		frame = holder,
		text = text,
		setEnabled = function(on)
			enabled = on
			paint()
		end,
		setPending = function(on)
			pending = on
			paint()
		end,
		setText = function(s)
			if text.Text ~= s then
				text.Text = s
			end
		end,
		setColor = function(c, d)
			color, dark = c, d
			paint()
		end,
	}
	return b
end

function Kit.panel(props: { size: UDim2, pos: UDim2?, anchor: Vector2?, parent: Instance?, color: Color3? }): Frame
	return new("Frame", {
		Size = props.size,
		Position = props.pos or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = props.color or C.panel,
		Parent = props.parent,
	}, { Kit.corner(18), Kit.stroke(C.shadow, 4) })
end

function Kit.bar(parent: Instance, size: UDim2, pos: UDim2, color: Color3): (Frame, Frame)
	local back = new("Frame", { Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(60, 50, 40), Parent = parent }, { Kit.corner(8) })
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color, Parent = back }, { Kit.corner(8) })
	return back, fill
end

-- Design canvas: children are laid out for >= 1100 x 620 "design pixels" and scaled to fit,
-- inside the device safe area (notches, Roblox top bar).
function Kit.canvas(name: string, order: number): (ScreenGui, Frame)
	local gui = new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = gui })
	local s = new("UIScale", { Parent = root })
	local function fit()
		local okSize, abs = pcall(function()
			return gui.AbsoluteSize
		end)
		if not okSize or abs.X < 2 then
			abs = Vector2.new(1280, 720) -- before the first layout pass
		end
		if abs.X < 2 then
			return
		end
		local k = math.clamp(math.min(abs.X / 1100, abs.Y / 620), 0.5, 1.3)
		s.Scale = k
		root.Size = UDim2.fromOffset(abs.X / k, abs.Y / k)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()
	return gui, root
end

---------------------------------------------------------------- icons
local Shared = ReplicatedStorage:WaitForChild("Shared")
local AssetIds = require(Shared.AssetIds)
local Icons = require(Shared.Icons)
local Models = require(Shared.Models)

local function frameCamera(vp: ViewportFrame, m: Model)
	local minV, maxV = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local p, s = d.CFrame.Position, d.Size / 2
			minV = Vector3.new(math.min(minV.X, p.X - s.X), math.min(minV.Y, p.Y - s.Y), math.min(minV.Z, p.Z - s.Z))
			maxV = Vector3.new(math.max(maxV.X, p.X + s.X), math.max(maxV.Y, p.Y + s.Y), math.max(maxV.Z, p.Z + s.Z))
		end
	end
	if minV.X == math.huge then
		return
	end
	local centre = (minV + maxV) / 2
	local radius = (maxV - minV).Magnitude / 2
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local dist = radius / math.tan(math.rad(15)) * 1.05
	cam.CFrame = CFrame.lookAt(centre + Vector3.new(0.75, 0.55, -1).Unit * dist, centre)
	cam.Parent = vp
	vp.CurrentCamera = cam
end

-- A square picture for `key` (see Shared/Icons). Uploaded render > live 3D preview > emoji.
function Kit.icon(key: string, size: number, parent: Instance?, pos: UDim2?, anchor: Vector2?): GuiObject
	local def = Icons[key] or { model = key, emoji = "⭐" }
	local imageId = AssetIds.Images[def.model]
	local base = {
		Size = UDim2.fromOffset(size, size),
		Position = pos or UDim2.new(),
		AnchorPoint = anchor or Vector2.zero,
		BackgroundTransparency = 1,
		Parent = parent,
	}
	if imageId then
		local img = new("ImageLabel", base)
		img.Image = string.format("rbxthumb://type=Asset&id=%d&w=150&h=150", imageId)
		img.ScaleType = Enum.ScaleType.Fit
		return img
	end
	if Models.hasMesh(def.model) or Models.has(def.model) then
		local vp = new("ViewportFrame", base)
		vp.Ambient = Color3.fromRGB(200, 200, 200)
		vp.LightColor = Color3.new(1, 1, 1)
		vp.LightDirection = Vector3.new(-1, -1.5, 1)
		local m = Models.build(def.model)
		m:PivotTo(CFrame.new())
		m.Parent = vp
		frameCamera(vp, m)
		return vp
	end
	local l = Kit.label({ Text = def.emoji, Size = base.Size, Position = base.Position, AnchorPoint = base.AnchorPoint, Parent = parent, MaxText = 80 })
	return l
end

---------------------------------------------------------------- motion
-- Pop a frame in from small with a little overshoot (panels, dialogs, banners).
function Kit.popIn(frame: GuiObject, delay: number?)
	local s = frame:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = frame })
	s.Scale = 0.6
	task.delay(delay or 0, function()
		TweenService:Create(s, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
end

-- Quick bounce (cash gained, button became available).
function Kit.pulse(frame: GuiObject, amount: number?)
	local s = frame:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = frame })
	s.Scale = 1 + (amount or 0.12)
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Gentle continuous wiggle for things that want attention (returns a stop function).
function Kit.wiggle(frame: GuiObject): () -> ()
	local alive = true
	task.spawn(function()
		while alive and frame.Parent do
			TweenService:Create(frame, TweenInfo.new(0.12), { Rotation = 6 }):Play()
			task.wait(0.12)
			TweenService:Create(frame, TweenInfo.new(0.12), { Rotation = -6 }):Play()
			task.wait(0.12)
			TweenService:Create(frame, TweenInfo.new(0.12), { Rotation = 0 }):Play()
			task.wait(1.6)
		end
	end)
	return function()
		alive = false
		frame.Rotation = 0
	end
end

function Kit.tween(inst: Instance, t: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

return Kit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
