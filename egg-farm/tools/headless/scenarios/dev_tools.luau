-- Test-place DEV panel shortcuts: max money, +1 level on everything, max everything.
H.boot()
local a = H.join("Alice")
Lib.waitSnap(a)
Lib.dev(a, "tutorial")
local r = Lib.dev(a, "maxmoney")
H.wait(0.5)
local st = Lib.state(a)
H.check("max money gives plenty of cash and gold", st.cash >= 1e25 and st.gold >= 1e6, { ok = r and r.ok, cash = st.cash, gold = st.gold })
local before = H.json({ h = st.housing[1].tier, v = st.vehicles[1].tier, feed = st.common.feed or 0 })
r = Lib.dev(a, "upgradeall")
H.wait(0.5)
st = Lib.state(a)
H.check("upgrade +1 raised house 1, vehicle 1 and Premium Feed by exactly one", st.housing[1].tier == 2 and st.vehicles[1].tier == 2 and (st.common.feed or 0) == 1 and st.housing[2].tier == 1, { before = before, msg = r and r.message })
r = Lib.dev(a, "maxall")
H.wait(0.5)
st = Lib.state(a)
H.check("max all reaches the egg-1 caps (Red Barn, Egg Hauler, max Premium Feed)", st.housing[4].tier == 4 and st.vehicles[1].tier == 4 and st.common.feed == 25, { msg = r and r.message, houses = st.housing[4].tier, v = st.vehicles[1].tier, feed = st.common.feed })
Lib.dev(a, "egg", 10)
Lib.dev(a, "maxmoney")
r = Lib.dev(a, "maxall")
H.wait(0.5)
st = Lib.state(a)
H.check("on egg 10 max all reaches the top tiers", st.housing[1].tier == 10 and st.vehicles[1].tier == 8 and st.workers[1].tier == 8, { msg = r and r.message })
local s = Lib.snap(a)
H.check("HUD counters split: chickens left, cash right", true, nil)
local hud = a:playerGui():FindFirstChild("EggFarmHud", true)
local left = hud and hud:FindFirstChild("CountersLeft", true)
local right = hud and hud:FindFirstChild("CountersRight", true)
H.check("left and right counter stacks exist at 75% scale", left ~= nil and right ~= nil and left:FindFirstChildOfClass("UIScale").Scale == 0.75, { pop = s and s.population })
