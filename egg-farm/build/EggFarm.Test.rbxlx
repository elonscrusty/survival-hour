	basket = {
		S(INK, 0.5, 0.42, 0.66, 0.6, { r = 0.5, ring = true, z = 0 }),
		S(rgb(196, 140, 80), 0.5, 0.68, 0.86, 0.46, { r = 0.25, z = 2 }),
