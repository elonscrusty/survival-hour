	},
	nest = {
		egg(CREAM, 0.32, 0.46, 0.55),
		egg(CREAM, 0.68, 0.46, 0.55),
		egg(CREAM, 0.5, 0.4, 0.6),
		S(BROWN, 0.5, 0.72, 0.9, 0.36, { r = 0.5, z = 3 }),
	},
	clock = {
		S(WHITE, 0.5, 0.5, 0.86, 0.86, { r = 0.5 }),
		S(INK, 0.5, 0.36, 0.08, 0.3, { stroke = false, grad = false, z = 3 }),
		S(INK, 0.6, 0.5, 0.26, 0.08, { stroke = false, grad = false, z = 3 }),
	},
	bunk = {
		S(BROWN, 0.5, 0.5, 0.8, 0.8, { r = 0.1 }),
		S(BLUE, 0.5, 0.32, 0.66, 0.2, { r = 0.2, z = 2 }),
		S(BLUE, 0.5, 0.7, 0.66, 0.2, { r = 0.2, z = 2 }),
	},
	boot = {
		S(BROWN, 0.4, 0.42, 0.34, 0.6, { r = 0.15 }),
		S(BROWN, 0.55, 0.78, 0.64, 0.26, { r = 0.3 }),
	},
	yolk = {
		S(WHITE, 0.5, 0.5, 0.92, 0.8, { r = 0.5 }),
		S(GOLD, 0.48, 0.5, 0.42, 0.42, { r = 0.5, z = 3 }),
	},
	auto = {
		S(INK, 0.5, 0.5, 0.8, 0.8, { r = 0.5, ring = true }),
		S(GREEN, 0.5, 0.5, 0.6, 0.6, { r = 0.5 }),
		S(WHITE, 0.53, 0.5, 0.5, 0.5, { glyph = "▶", tc = WHITE, z = 3 }),
	},
	combo = {
		S(ORANGE, 0.5, 0.5, 0.86, 0.86, { r = 0.3, rot = 45 }),
		S(WHITE, 0.5, 0.5, 0.7, 0.7, { glyph = "x", tc = WHITE, z = 3 }),
	},
	gift = {
		S(RED, 0.5, 0.64, 0.78, 0.56, { r = 0.12 }),
		S(RED, 0.5, 0.36, 0.88, 0.2, { r = 0.15, z = 2 }),
		S(GOLD, 0.5, 0.6, 0.16, 0.64, { stroke = false, z = 3 }),
		S(GOLD, 0.36, 0.18, 0.22, 0.18, { r = 0.5, rot = -20, z = 1 }),
		S(GOLD, 0.64, 0.18, 0.22, 0.18, { r = 0.5, rot = 20, z = 1 }),
	},
	quest = {
		S(rgb(250, 236, 200), 0.5, 0.52, 0.7, 0.86, { r = 0.1 }),
		S(BROWN, 0.5, 0.12, 0.36, 0.14, { r = 0.3, z = 2 }),
		S(GRAY, 0.5, 0.38, 0.46, 0.06, { stroke = false, grad = false, z = 3 }),
		S(GRAY, 0.5, 0.54, 0.46, 0.06, { stroke = false, grad = false, z = 3 }),
		S(GREEN, 0.42, 0.72, 0.3, 0.06, { stroke = false, grad = false, z = 3 }),
	},
	daily = {
		S(WHITE, 0.5, 0.56, 0.84, 0.74, { r = 0.12 }),
		S(RED, 0.5, 0.26, 0.84, 0.22, { r = 0.12, z = 2 }),
		S(INK, 0.5, 0.62, 0.5, 0.5, { glyph = "7", tc = INK, z = 3 }),
	},
	settings = {
		S(GRAY, 0.5, 0.5, 0.24, 0.92, { r = 0.15 }),
		S(GRAY, 0.5, 0.5, 0.24, 0.92, { r = 0.15, rot = 45 }),
		S(GRAY, 0.5, 0.5, 0.24, 0.92, { r = 0.15, rot = 90 }),
		S(GRAY, 0.5, 0.5, 0.24, 0.92, { r = 0.15, rot = 135 }),
		S(GRAY, 0.5, 0.5, 0.66, 0.66, { r = 0.5, z = 2 }),
		S(rgb(80, 80, 90), 0.5, 0.5, 0.26, 0.26, { r = 0.5, z = 3 }),
	},
	shop = {
		S(INK, 0.5, 0.3, 0.42, 0.4, { r = 0.5, ring = true, z = 0 }),
		S(rgb(255, 120, 150), 0.5, 0.62, 0.78, 0.6, { r = 0.15, z = 2 }),
		S(WHITE, 0.5, 0.64, 0.4, 0.4, { glyph = "$", tc = WHITE, z = 3 }),
	},
	lock = {
		S(INK, 0.5, 0.32, 0.44, 0.46, { r = 0.5, ring = true, z = 0 }),
		S(GOLD, 0.5, 0.66, 0.68, 0.5, { r = 0.15, z = 2 }),
		S(INK, 0.5, 0.64, 0.1, 0.18, { r = 0.5, stroke = false, grad = false, z = 3 }),
	},
	code = {
		S(PURPLE, 0.5, 0.5, 0.9, 0.6, { r = 0.15, rot = -8 }),
		S(WHITE, 0.5, 0.5, 0.5, 0.5, { glyph = "#", tc = WHITE, z = 3, rot = -8 }),
	},
	farm = {
		S(RED, 0.5, 0.44, 0.6, 0.6, { rot = 45, r = 0.08, z = 1 }),
		S(RED, 0.5, 0.7, 0.76, 0.52, { r = 0.06, z = 2 }),
		S(WHITE, 0.5, 0.74, 0.3, 0.38, { r = 0.06, z = 3 }),
	},
	upgrades = {
		S(GREEN, 0.5, 0.36, 0.56, 0.56, { rot = 45, r = 0.1 }),
		S(GREEN, 0.5, 0.7, 0.3, 0.46, { r = 0.1, z = 2 }),
	},
	close = { S(WHITE, 0.5, 0.5, 0.9, 0.9, { glyph = "X", tc = WHITE }) },
	back = { S(WHITE, 0.5, 0.5, 0.9, 0.9, { glyph = "<", tc = WHITE }) },
	check = {
		S(GREEN, 0.36, 0.62, 0.18, 0.42, { rot = -45, r = 0.4 }),
		S(GREEN, 0.6, 0.48, 0.18, 0.74, { rot = 40, r = 0.4 }),
	},
	rebirth = {
		S(INK, 0.5, 0.5, 0.9, 0.9, { r = 0.5, ring = true }),
		egg(GOLD, 0.5, 0.52, 0.7),
	},
	prestige = {
		S(PURPLE, 0.5, 0.5, 0.9, 0.9, { r = 0.5 }),
		S(GOLD, 0.5, 0.5, 0.8, 0.8, { glyph = "★", tc = GOLD, z = 3 }),
	},
	skip = {
		S(BLUE, 0.5, 0.5, 0.9, 0.9, { r = 0.5 }),
		S(WHITE, 0.52, 0.5, 0.7, 0.7, { glyph = "»", tc = WHITE, z = 3 }),
	},
	cart = {
		S(INK, 0.5, 0.3, 0.42, 0.4, { r = 0.5, ring = true, z = 0 }),
		S(rgb(255, 120, 150), 0.5, 0.62, 0.78, 0.6, { r = 0.15, z = 2 }),
	},
	music = {
		S(BLUE, 0.36, 0.74, 0.32, 0.26, { r = 0.5 }),
		S(BLUE, 0.48, 0.42, 0.1, 0.62, { r = 0.3 }),
		S(BLUE, 0.62, 0.18, 0.32, 0.12, { r = 0.3, rot = 20 }),
	},
}
DEFS.house_buy = DEFS.house
DEFS.robux = DEFS.gold

function Icon.Has(kind: string): boolean
	return DEFS[kind] ~= nil
end

-- size: logical px (square). kind: see DEFS; unknown kinds draw a plain egg.
function Icon.new(kind: string, size: number?, parent: Instance?): Frame
	local f = Instance.new("Frame")
	f.Name = "Icon_" .. kind
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromOffset(size or 40, size or 40)
	local shapes = DEFS[kind] or DEFS.egg
	for i, s in shapes do
		local obj: GuiObject
		if s.glyph then
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Text = s.glyph
			t.TextScaled = true
			t.Font = Theme.Font.Number
			t.TextColor3 = s.tc or WHITE
			t.TextStrokeTransparency = 0
			t.TextStrokeColor3 = INK
			obj = t
		else
			local fr = Instance.new("Frame")
			fr.BorderSizePixel = 0
			if s.ring then
				fr.BackgroundTransparency = 1
			else
				fr.BackgroundColor3 = s.c
			end
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(s.r or 0.2, 0)
			c.Parent = fr
			if s.ring then
				local st = Instance.new("UIStroke")
				st.Thickness = 3
				st.Color = s.c
				st.Parent = fr
			elseif s.stroke ~= false then
				local st = Instance.new("UIStroke")
				st.Thickness = 2
				st.Color = INK
				st.Parent = fr
			end
			if not s.ring and s.grad ~= false then
				local g = Instance.new("UIGradient")
				g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200))
				g.Rotation = 90
				g.Parent = fr
			end
			obj = fr
		end
		obj.AnchorPoint = Vector2.new(0.5, 0.5)
		obj.Position = UDim2.fromScale(s.x, s.y)
		obj.Size = UDim2.fromScale(s.w, s.h)
		obj.Rotation = s.rot or 0
		obj.ZIndex = s.z or 1
		obj.LayoutOrder = i
		obj.Parent = f
	end
	if parent then
		f.Parent = parent
	end
	return f
end

return Icon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--!strict
-- Screen layers and the viewport-driven UIScale.
-- Every ScreenGui gets a full-size `Root` frame holding a UIScale. The root is sized 1/scale of
-- the screen so its children are laid out in LOGICAL pixels (a phone ~480 logical px on its short
-- side, a desktop ~830) and then scaled up or down. Safe areas: HUD and menu layers use
-- ScreenInsets.CoreUISafeInsets (notches + Roblox top bar); dimmers use ScreenInsets.None so they
-- cover the whole screen.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Layout = {}

Layout.BASE = 480 -- logical px on the short side of a phone
Layout.MIN_SCALE = 0.72
Layout.MAX_SCALE = 1.3

local scale = 1
local roots: { { root: Frame, ui: UIScale } } = {}
local listeners: { (number, Vector2) -> () } = {}

local function viewport(): Vector2
	local cam = Workspace.CurrentCamera
	return if cam then cam.ViewportSize else Vector2.new(1280, 720)
end

function Layout.ComputeScale(v: Vector2): number
	local short = math.min(v.X, v.Y)
	return math.clamp(short / Layout.BASE, Layout.MIN_SCALE, Layout.MAX_SCALE)
end

function Layout.Scale(): number
	return scale
end

-- Logical size of the screen (what children of a Root see).
function Layout.Logical(): Vector2
	local v = viewport()
	return Vector2.new(v.X / scale, v.Y / scale)
end

function Layout.IsPortrait(): boolean
	local v = viewport()
	return v.Y > v.X
end

local function apply()
	scale = Layout.ComputeScale(viewport())
	for _, r in roots do
		r.ui.Scale = scale
		r.root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	end
	local logical = Layout.Logical()
	for _, fn in table.clone(listeners) do
		task.spawn(fn, scale, logical)
	end
end

function Layout.OnChanged(fn: (number, Vector2) -> ()): () -> ()
	table.insert(listeners, fn)
	return function()
		local i = table.find(listeners, fn)
		if i then
			table.remove(listeners, i)
		end
	end
end

-- Creates a ScreenGui layer and returns (gui, root).
function Layout.Layer(name: string, order: number, fullScreen: boolean?): (ScreenGui, Frame)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.DisplayOrder = order
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = if fullScreen then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	local ui = Instance.new("UIScale")
	ui.Scale = scale
	ui.Parent = root
	root.Parent = gui
	table.insert(roots, { root = root, ui = ui })
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui, root
end

local started = false
function Layout.Start()
	if started then
		return
	end
	started = true
	local conn: RBXScriptConnection? = nil
	local function hook()
		if conn then
			conn:Disconnect()
		end
		local cam = Workspace.CurrentCamera
		if cam then
			conn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		end
		apply()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	hook()
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--!strict
-- Confirm / info modal box: title, optional sections of bullet lines (e.g. "Resets" in red,
-- "Kept" in green, "You get" in gold), and one or two buttons. The Host decides when it shows
-- (MenuRouter allows one modal at a time); this module only draws it.

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Button = require(script.Parent.Button)
local Icon = require(script.Parent.Icon)

local Modal = {}

export type Section = { title: string, items: { string }, color: Color3? }

export type ShowOpts = {
	title: string,
	text: string?,
	icon: string?,
	color: Color3?,
	sections: { Section }?,
	confirmText: string?,
	confirmColor: Color3?,
	cancelText: string?, -- nil = a single-button modal
	onConfirm: (() -> ())?,
	onCancel: (() -> ())?,
}

export type Handle = {
	Frame: Frame,
	Show: (Handle, ShowOpts) -> (),
	Hide: (Handle) -> (),
	Current: ShowOpts?,
}

function Modal.new(parent: Instance): Handle
	local box = Instance.new("Frame")
	box.Name = "Modal"
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Position = UDim2.fromScale(0.5, 0.5)
	box.Size = UDim2.new(1, -32, 1, -40)
	box.BackgroundColor3 = Theme.Color.Panel
	box.Active = true
	box.Visible = false
	box.ZIndex = 2
	Util.Corner(box, 22)
	Util.Stroke(box, 4, Theme.Color.Ink, true)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(560, 520)
	limit.Parent = box
	local pop = Instance.new("UIScale")
	pop.Parent = box

	local header = Instance.new("Frame")
	header.BackgroundColor3 = Theme.Color.Orange
	header.Size = UDim2.new(1, 0, 0, 58)
	header.ZIndex = 2
	Util.Corner(header, 20)
	Util.Stroke(header, 4, Theme.Color.Ink, true)
	Util.Gradient(header)
	header.Parent = box
	local iconHolder = Instance.new("Frame")
	iconHolder.BackgroundTransparency = 1
	iconHolder.Size = UDim2.fromOffset(44, 44)
	iconHolder.Position = UDim2.fromOffset(12, 7)
	iconHolder.ZIndex = 3
	iconHolder.Parent = header
	local title = Util.Text({
		size = UDim2.new(1, -76, 1, -6),
		position = UDim2.fromOffset(64, 2),
		textSize = Theme.Text.L,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		outline = true,
		z = 3,
		parent = header,
	})

	local scroll = Util.Scroll(box, UDim2.new(1, -24, 1, -(66 + 84)), UDim2.fromOffset(12, 66))
	Util.List(scroll, 8, false, Enum.HorizontalAlignment.Left)

	local buttons = Instance.new("Frame")
	buttons.BackgroundTransparency = 1
	buttons.AnchorPoint = Vector2.new(0.5, 1)
	buttons.Position = UDim2.new(0.5, 0, 1, -12)
	buttons.Size = UDim2.new(1, -24, 0, 64)
	buttons.Parent = box
	Util.List(buttons, 14, true, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local h: any = { Frame = box, Current = nil }

	local confirm = Button.new({
		text = "OK",
		color = Theme.Color.Green,
		size = UDim2.new(0.46, 0, 0, 62),
		order = 2,
		parent = buttons,
		onClick = function()
			local cur = h.Current
			if cur and cur.onConfirm then
				cur.onConfirm()
			end
		end,
	})
	local cancel = Button.new({
		text = "Cancel",
		color = Theme.Color.Gray,
		size = UDim2.new(0.46, 0, 0, 62),
		order = 1,
		parent = buttons,
		onClick = function()
			local cur = h.Current
			if cur and cur.onCancel then
				cur.onCancel()
			end
		end,
	})

	function h.Show(self: Handle, o: ShowOpts)
		self.Current = o
		title.Text = o.title
		header.BackgroundColor3 = o.color or Theme.Color.Orange
		Util.Clear(iconHolder)
		local ic = Icon.new(o.icon or "egg", 44)
		ic.ZIndex = 3
		ic.Parent = iconHolder
		Util.Clear(scroll, { "UIListLayout" })
		local order = 0
		if o.text then
			order += 1
			Util.Text({
				text = o.text,
				size = UDim2.new(1, -10, 0, 0),
				textSize = Theme.Text.M,
				color = Theme.Color.TextDark,
				xAlign = Enum.TextXAlignment.Left,
				wrap = true,
				order = order,
				parent = scroll,
			})
		end
		local sections: { Section } = o.sections or {}
		for _, sec in sections do
			order += 1
			Util.Text({
				text = sec.title,
				size = UDim2.new(1, -10, 0, 0),
				textSize = Theme.Text.M,
				color = sec.color or Theme.Color.TextDark,
				font = Theme.Font.Title,
				xAlign = Enum.TextXAlignment.Left,
				wrap = true,
				outline = false,
				order = order,
				parent = scroll,
			})
			for _, line in sec.items do
				order += 1
				Util.Text({
					text = "  •  " .. line,
					size = UDim2.new(1, -10, 0, 0),
					textSize = Theme.Text.S,
					color = Theme.Color.TextDark,
					xAlign = Enum.TextXAlignment.Left,
					wrap = true,
					order = order,
					parent = scroll,
				})
			end
		end
		confirm:SetText(o.confirmText or "OK")
		confirm:SetColor(o.confirmColor or Theme.Color.Green)
		cancel:SetVisible(o.cancelText ~= nil)
		cancel:SetText(o.cancelText or "Cancel")
		confirm.Instance.Size = if o.cancelText then UDim2.new(0.46, 0, 0, 62) else UDim2.new(0.7, 0, 0, 62)
		box.Visible = true
		pop.Scale = 0.85
		Util.Tween(pop, Theme.Tween.Pop, { Scale = 1 })
	end

	function h.Hide(self: Handle)
		self.Current = nil
		box.Visible = false
	end

	box.Parent = parent
	return h :: Handle
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">Num</string>
              <string name="Source"><![CDATA[--!strict
-- Number display that honours the player's notation setting ("short" = 1.23M, "scientific" =
-- 1.23e6). Everything on screen formats numbers through here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))

local Num = {}

local notation = "short"

function Num.SetNotation(n: string?)
	notation = if n == "scientific" then "scientific" else "short"
end

function Num.Short(n: number): string
	if notation == "scientific" and n == n and math.abs(n) >= 1000 and math.abs(n) ~= math.huge then
		-- 1.23e+06 -> 1.23e6
		return (string.format("%.2e", n):gsub("e%+?(%-?)0*(%d)", "e%1%2"))
	end
	return Format.Short(n)
end

function Num.Cash(n: number): string
	return "$" .. Num.Short(n)
end

function Num.Rate(n: number): string
	return Num.Short(n) .. "/s"
end

function Num.Duration(s: number): string
	return Format.Duration(s)
end

return Num
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">Panel</string>
              <string name="Source"><![CDATA[--!strict
-- Main menu panel: coloured header with icon + title, close X, optional back arrow, optional tab
-- strip, and a Body frame for content. Sized relative to the screen with a maximum size, so it
-- fits a 360x640 portrait phone and a widescreen monitor alike.

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Icon = require(script.Parent.Icon)
local Button = require(script.Parent.Button)
local TabStrip = require(script.Parent.TabStrip)

local Panel = {}

export type Handle = {
	Frame: Frame,
	Body: Frame,
	Tabs: TabStrip.Handle?,
	Title: TextLabel,
	SetBack: (Handle, boolean) -> (),
	SetTitle: (Handle, string) -> (),
	Show: (Handle) -> (),
	Hide: (Handle) -> (),
}

export type Opts = {
	name: string,
	title: string,
	icon: string,
	color: Color3,
	tabs: { TabStrip.Tab }?,
	onTab: ((string) -> ())?,
	onClose: () -> (),
	onBack: () -> (),
	maxSize: Vector2?,
	parent: Instance,
}

function Panel.new(o: Opts): Handle
	local frame = Instance.new("Frame")
	frame.Name = o.name
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.new(1, -24, 1, -24)
	frame.BackgroundColor3 = Theme.Color.Panel
	frame.Active = true -- sinks clicks so they never reach the world behind
	frame.Visible = false
	frame.ZIndex = 2
	Util.Corner(frame, 22)
	Util.Stroke(frame, 4, Theme.Color.Ink, true)
	Util.Gradient(frame, Color3.new(1, 1, 1), Color3.fromRGB(236, 226, 206))
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = o.maxSize or Theme.Size.PanelMax
	limit.Parent = frame
	local pop = Instance.new("UIScale")
	pop.Parent = frame

	-- header
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundColor3 = o.color
	header.Size = UDim2.new(1, 0, 0, 62)
	header.ZIndex = 2
	Util.Corner(header, 20)
	Util.Stroke(header, 4, Theme.Color.Ink, true)
	Util.Gradient(header, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200))
	header.Parent = frame
	local ic = Icon.new(o.icon, 46)
	ic.Position = UDim2.fromOffset(14, 8)
	ic.ZIndex = 3
	ic.Parent = header
	local title = Util.Text({
		text = o.title,
		size = UDim2.new(1, -200, 1, -8),
		position = UDim2.fromOffset(68, 2),
		textSize = Theme.Text.XL,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		outline = true,
		z = 3,
		parent = header,
	})

	local close = Button.new({
		name = "Close",
		icon = "close",
		iconSize = 30,
		color = Theme.Color.Red,
		size = UDim2.fromOffset(60, 60),
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, 10, 0, -10),
		z = 5,
		onClick = o.onClose,
		parent = frame,
	})
	close.Instance.ZIndex = 5
	local back = Button.new({
		name = "Back",
		icon = "back",
		iconSize = 30,
		color = Theme.Color.Blue,
		size = UDim2.fromOffset(60, 60),
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, -56, 0, -10),
		z = 5,
		onClick = o.onBack,
		parent = frame,
	})
	back:SetVisible(false)

	local top = 70
	local tabs: TabStrip.Handle? = nil
	if o.tabs then
		local onTab = o.onTab
		tabs = TabStrip.new({
			tabs = o.tabs,
			onSelect = function(id)
				if onTab then
					onTab(id)
				end
			end,
			size = UDim2.new(1, -24, 0, 52),
			position = UDim2.fromOffset(12, 66),
			parent = frame,
		})
		top = 124
	end

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(12, top)
	body.Size = UDim2.new(1, -24, 1, -(top + 12))
	body.ZIndex = 2
	body.Parent = frame

	local h: any = { Frame = frame, Body = body, Tabs = tabs, Title = title }
	function h.SetBack(self: Handle, on: boolean)
		back:SetVisible(on)
	end
	function h.SetTitle(self: Handle, text: string)
		self.Title.Text = text
	end
	function h.Show(self: Handle)
		if not self.Frame.Visible then
			self.Frame.Visible = true
			pop.Scale = 0.88
			Util.Tween(pop, Theme.Tween.Pop, { Scale = 1 })
		end
	end
	function h.Hide(self: Handle)
		self.Frame.Visible = false
	end
	frame.Parent = o.parent
	return h :: Handle
end

return Panel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">ProgressBar</string>
              <string name="Source"><![CDATA[--!strict
-- Rounded progress bar with an outlined track, gradient fill and centred caption.

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)

local ProgressBar = {}

export type Handle = {
	Instance: Frame,
	Fill: Frame,
	Label: TextLabel,
	Set: (Handle, number, string?) -> (),
	SetColor: (Handle, Color3) -> (),
}

function ProgressBar.new(o: {
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	textSize: number?,
	order: number?,
	parent: Instance?,
}): Handle
	local track = Instance.new("Frame")
	track.Name = "ProgressBar"
	track.BackgroundColor3 = Color3.fromRGB(70, 56, 46)
	track.Size = o.size or UDim2.new(1, 0, 0, 28)
	track.Position = o.position or UDim2.new()
	track.AnchorPoint = o.anchor or Vector2.zero
	track.LayoutOrder = o.order or 0
	Util.Corner(track, nil, 0.5)
	Util.Stroke(track, 3, Theme.Color.Ink, true)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = o.color or Theme.Color.Green
	fill.Size = UDim2.fromScale(0, 1)
	Util.Corner(fill, nil, 0.5)
	Util.Gradient(fill, Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190))
	fill.Parent = track

	local label = Util.Text({
		text = "",
		size = UDim2.new(1, -12, 1, 0),
		position = UDim2.fromOffset(6, 0),
		textSize = o.textSize or Theme.Text.S,
		font = Theme.Font.Title,
		outline = true,
		z = 3,
		parent = track,
	})

	local h: any = { Instance = track, Fill = fill, Label = label }
	local last = -1
	function h.Set(self: Handle, frac: number, caption: string?)
		if frac ~= frac then
			frac = 0
		end
		frac = math.clamp(frac, 0, 1)
		if math.abs(frac - last) > 1e-4 then
			last = frac
			Util.Tween(self.Fill, Theme.Tween.Med, { Size = UDim2.fromScale(frac, 1) })
			self.Fill.Visible = frac > 0.001
		end
		if caption then
			self.Label.Text = caption
		end
	end
	function h.SetColor(self: Handle, c: Color3)
		self.Fill.BackgroundColor3 = c
	end
	track.Parent = o.parent
	return h :: Handle
end

return ProgressBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">PurchaseButton</string>
              <string name="Source"><![CDATA[--!strict
-- A Button bound to Logic/PurchaseState. Every Refresh(snapshot) recomputes the state from the
-- live price and balance, so the look is never stale:
--   affordable (green, price) | unaffordable (grey, red price) | owned (OWNED) | max (MAX, gold)
--   locked (LOCKED, dark) | loading ("...", while the request is in flight) | rejected (red +
--   shake + toast with the server's message, then back to the live state).
-- Taps that can't succeed (unaffordable, locked, max) never reach the server: they show the
-- reason locally. Requests go through Store.Request, which also dedupes by key.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PurchaseState = require(Shared:WaitForChild("Logic"):WaitForChild("PurchaseState"))
local Contract = require(Shared:WaitForChild("Contract"))
local Format = require(Shared:WaitForChild("Format"))

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Button = require(script.Parent.Button)
local Num = require(script.Parent.Num)

local PurchaseButton = {}

export type Result = { ok: boolean, code: string, message: string? }

export type Opts = {
	host: any, -- Menus/Host (Toast, Confirm, Sound, Store)
	parent: Instance?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	order: number?,
	textSize: number?,
	currency: string?, -- "cash" | "gold" | "robux" | "free"
	verb: string?, -- caption when the price is free (CLAIM, USE, ...)
	-- returns price (nil = can't buy), reason code, owned flag
	quote: (snap: any) -> (number?, string?, boolean?),
	-- performs the request (yields) and returns the server result
	send: (snap: any) -> Result,
	-- optional confirmation; return nil to skip
	confirm: ((snap: any) -> any?)?,
	onResult: ((Result) -> ())?,
	-- custom text for a local "can't do that" tap (code = PurchaseState code); nil = Contract text
	explain: ((code: string, snap: any) -> string?)?,
	successSound: string?,
}

export type Handle = {
	Button: Button.Handle,
	Instance: TextButton,
	State: string,
	Refresh: (Handle, any) -> (),
	SetVisible: (Handle, boolean) -> (),
}

local function balanceOf(snap: any, currency: string): number
	if currency == "gold" then
		return snap.gold or 0
	end
	return snap.cash or 0
end

local function priceText(price: number, currency: string): string
	if currency == "gold" then
		return Num.Short(price)
	elseif currency == "robux" then
		return "R$ " .. Format.Commas(price)
	end
	return Num.Cash(price)
end

function PurchaseButton.new(o: Opts): Handle
	local currency = o.currency or "cash"
	local busy = false
	local lastRejectAt: number? = nil
	local h: any = { State = "unavailable" }

	local btn = Button.new({
		text = "",
		icon = if currency == "gold" then "gold" elseif currency == "cash" then "cash" else nil,
		iconSize = 30,
		color = Theme.Color.Green,
		size = o.size or UDim2.fromOffset(160, 60),
		position = o.position,
		anchor = o.anchor,
		order = o.order,
		textSize = o.textSize or Theme.Text.M,
		parent = o.parent,
	})
	h.Button = btn
	h.Instance = btn.Instance

	local function paint(state: string, price: number?)
		h.State = state
		local caption = PurchaseState.Caption(state)
		local text: string
		if caption then
			text = caption
		elseif price and price > 0 then
			text = priceText(price, currency)
		else
			text = o.verb or "FREE"
		end
		btn:SetText(text)
		if btn.Icon then
			btn.Icon.Visible = caption == nil and price ~= nil and price > 0
		end
		local color = Theme.Color.Green
		local textColor = Theme.Color.Text
		if state == "unaffordable" then
			color = Theme.Color.Gray
			textColor = Theme.Color.Bad
		elseif state == "owned" then
			color = Theme.Color.GreenDark
		elseif state == "max" then
			color = Theme.Color.Gold
		elseif state == "locked" or state == "unavailable" then
			color = Theme.Color.GrayDark
		elseif state == "rejected" then
			color = Theme.Color.Red
		elseif state == "loading" then
			color = Theme.Color.Gray
		elseif currency == "robux" then
			color = Theme.Color.Blue
		elseif currency == "gold" then
			color = Theme.Color.Orange
		end
		btn:SetColor(color)
		btn.Label.TextColor3 = textColor
		btn:SetEnabled(state == "affordable")
	end

	local function compute(snap: any): (PurchaseState.Output, number?)
		if not snap then
			return { state = "loading", canRequest = false, code = nil }, nil
		end
		local price, reason, owned = o.quote(snap)
		local out = PurchaseState.Compute({
			price = price,
			reason = reason,
			balance = balanceOf(snap, currency),
			currency = currency,
			owned = owned,
			busy = busy,
			lastRejectAt = lastRejectAt,
			now = os.clock(),
		})
		return out, price
	end

	function h.Refresh(self: Handle, snap: any)
		local out, price = compute(snap)
		paint(out.state, price)
	end

	function h.SetVisible(self: Handle, on: boolean)
		btn:SetVisible(on)
	end

	local function reject(message: string?)
		lastRejectAt = os.clock()
		o.host:Sound("error")
		Util.Shake(btn.Instance)
		if message then
			o.host:Toast(message, "bad")
		end
		h:Refresh(o.host.Store.Get())
		task.delay(PurchaseState.REJECT_SHOW + 0.05, function()
			h:Refresh(o.host.Store.Get())
		end)
	end

	local function why(code: string?, snap: any): string?
		if not code then
			return nil
		end
		local custom = if o.explain then o.explain(code, snap) else nil
		return custom or Contract.Messages[code]
	end

	local function run(snap: any)
		busy = true
		h:Refresh(snap)
		local ok, res = pcall(o.send, snap)
		busy = false
		local result: Result = if ok and type(res) == "table"
			then res
			else { ok = false, code = "error", message = "Something went wrong. Try again." }
		if result.ok then
			o.host:Sound(o.successSound or "buy")
			Util.Pop(btn.Instance, 0.1)
			h:Refresh(o.host.Store.Get())
		elseif result.code == "cancelled" then
			o.host:Toast(result.message or "Purchase cancelled.", "info")
			h:Refresh(o.host.Store.Get())
		elseif PurchaseState.IsRejection(result) then
			reject(result.message or Contract.Messages[result.code] or "That didn't work.")
		else
			h:Refresh(o.host.Store.Get())
		end
		if o.onResult then
			o.onResult(result)
		end
	end

	btn.Instance.Activated:Connect(function()
		local snap = o.host.Store.Get()
		local out = compute(snap)
		if out.state == "loading" or out.state == "rejected" then
			return
		end
		if not out.canRequest then
			reject(why(out.code, snap))
			return
		end
		local confirmOpts = if o.confirm then o.confirm(snap) else nil
		if confirmOpts then
			o.host:Confirm(confirmOpts, function()
				local now = o.host.Store.Get()
				local again = compute(now)
				if again.canRequest then
					task.spawn(run, now)
				else
					reject(why(again.code, now))
				end
			end)
		else
			task.spawn(run, snap)
		end
	end)

	h:Refresh(o.host.Store.Get())
	return h :: Handle
end

return PurchaseButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">TabStrip</string>
              <string name="Source"><![CDATA[--!strict
-- Coloured tab strip. Each tab is a button; the selected one is raised and bright.
-- Tabs can be hidden (tutorial reveal) without rebuilding the strip.

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Button = require(script.Parent.Button)

local TabStrip = {}

export type Tab = { id: string, label: string, color: Color3? }

export type Handle = {
	Instance: Frame,
	Selected: string?,
	Select: (Handle, string) -> (),
	SetVisible: (Handle, string, boolean) -> (),
	SetBadge: (Handle, string, string?) -> (),
}

function TabStrip.new(o: {
	tabs: { Tab },
	onSelect: (string) -> (),
	size: UDim2?,
	position: UDim2?,
	parent: Instance?,
}): Handle
	local strip = Instance.new("Frame")
	strip.Name = "Tabs"
	strip.BackgroundTransparency = 1
	strip.Size = o.size or UDim2.new(1, 0, 0, 52)
	strip.Position = o.position or UDim2.new()
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.X
	scroll.ScrollingDirection = Enum.ScrollingDirection.X
	scroll.ScrollBarThickness = 0
	scroll.Parent = strip
	Util.List(scroll, 6, true, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)

	local buttons: { [string]: TextButton } = {}
	local colors: { [string]: Color3 } = {}
	local badges: { [string]: TextLabel } = {}
	local h: any = { Instance = strip, Selected = nil }

	local function paint()
		for id, b in buttons do
			local on = h.Selected == id
			b.BackgroundColor3 = if on then colors[id] else Theme.Darken(colors[id], 0.35)
			b.Size = UDim2.new(0, b.Size.X.Offset, 0, if on then 50 else 44)
			local lbl = b:FindFirstChild("Label") :: TextLabel?
			if lbl then
				lbl.TextTransparency = if on then 0 else 0.2
			end
		end
	end

	for i, t in o.tabs do
		local c = t.color or Theme.Color.Blue
		colors[t.id] = c
		local width = math.max(110, 22 + #t.label * 14)
		local b = Instance.new("TextButton")
		b.Name = t.id
		b.Text = ""
		b.AutoButtonColor = false
		b.LayoutOrder = i
		b.Size = UDim2.fromOffset(width, 44)
		b.BackgroundColor3 = c
		Util.Corner(b, 12)
		Util.Stroke(b, 3, Theme.Color.Ink, true)
		Util.Gradient(b)
		local lbl = Util.Text({
			text = t.label,
			size = UDim2.new(1, -12, 1, -6),
			position = UDim2.fromOffset(6, 0),
			textSize = Theme.Text.M,
			font = Theme.Font.Title,
			outline = true,
			z = 2,
			parent = b,
		})
		lbl.Name = "Label"
		local badge = Util.Text({
			text = "!",
			size = UDim2.fromOffset(26, 26),
			position = UDim2.new(1, -6, 0, -6),
			anchor = Vector2.new(0.5, 0.5),
			textSize = Theme.Text.S,
			font = Theme.Font.Number,
			outline = true,
			z = 4,
			parent = b,
		})
		badge.BackgroundTransparency = 0
		badge.BackgroundColor3 = Theme.Color.Red
		Util.Corner(badge, nil, 0.5)
		badge.Visible = false
		badges[t.id] = badge
		b.Activated:Connect(function()
			local hook = Button.ClickHook
			if hook then
				hook()
			end
			o.onSelect(t.id)
		end)
		b.Parent = scroll
		buttons[t.id] = b
	end

	function h.Select(self: Handle, id: string)
		self.Selected = id
		paint()
	end

	function h.SetVisible(self: Handle, id: string, on: boolean)
		local b = buttons[id]
		if b then
			b.Visible = on
		end
	end

	function h.SetBadge(self: Handle, id: string, text: string?)
		local badge = badges[id]
		if badge then
			badge.Visible = text ~= nil
			badge.Text = text or ""
		end
	end

	strip.Parent = o.parent
	return h :: Handle
end

return TabStrip
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Colours, fonts and sizes for every screen. All sizes are LOGICAL pixels: the UIScale on each
-- root (UI/Layout) turns them into screen pixels, so a 60 px button stays >= 44 px on phones.

local Theme = {}

local rgb = Color3.fromRGB

Theme.Color = {
	Ink = rgb(43, 30, 22), -- outlines and dark text
	Text = rgb(255, 255, 255),
	TextDark = rgb(58, 42, 30),
	TextMuted = rgb(128, 108, 92),
	Panel = rgb(255, 246, 226),
	PanelEdge = rgb(242, 222, 186),
	Card = rgb(255, 255, 255),
	CardAlt = rgb(250, 238, 214),
	Dim = rgb(0, 0, 0),

	Red = rgb(232, 64, 56),
	RedDark = rgb(170, 34, 34),
	Green = rgb(82, 196, 72),
	GreenDark = rgb(46, 138, 46),
	Blue = rgb(64, 156, 240),
	BlueDark = rgb(36, 96, 186),
	Gold = rgb(255, 196, 40),
	GoldDark = rgb(204, 132, 16),
	Orange = rgb(255, 140, 40),
	Purple = rgb(160, 92, 232),
	PurpleDark = rgb(104, 52, 170),
	Pink = rgb(255, 104, 160),
	Teal = rgb(40, 196, 186),
	Gray = rgb(150, 150, 156),
	GrayDark = rgb(96, 96, 104),
	Cash = rgb(98, 210, 86),
	Bad = rgb(255, 90, 80),
	Good = rgb(120, 240, 110),
}

Theme.Font = {
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.FredokaOne,
	Number = Enum.Font.GothamBlack,
}

Theme.Text = {
	Min = 19, -- 19 logical px * 0.75 (smallest phone scale) ~= 14 px on screen
	S = 19,
	M = 22,
	L = 28,
	XL = 40,
	Huge = 56,
}

Theme.Size = {
	Touch = 60, -- minimum button height / width (>= 44 px at the smallest scale)
	Nav = 68,
	Stroke = 3,
	Radius = 14,
	Gap = 8,
	PanelMax = Vector2.new(780, 560),
}

Theme.Tween = {
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Med = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Pop = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
}

-- Lighter / darker variants for gradients and pressed states.
function Theme.Lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

function Theme.Darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">Util</string>
              <string name="Source"><![CDATA[--!strict
-- Small instance helpers used by every component. `New` returns `any` so callers can set any
-- property table without a cast; components keep typed handles for what they expose.

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Util = {}

function Util.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst: any = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Util.Corner(parent: Instance, radius: number?, scale: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = if scale then UDim.new(scale, 0) else UDim.new(0, radius or Theme.Size.Radius)
	c.Parent = parent
	return c
end

function Util.Stroke(parent: Instance, thickness: number?, color: Color3?, border: boolean?): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or Theme.Size.Stroke
	s.Color = color or Theme.Color.Ink
	s.LineJoinMode = Enum.LineJoinMode.Round
	if border then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	s.Parent = parent
	return s
end

-- Vertical two-tone gradient: lighter on top (keeps the base colour on the object).
function Util.Gradient(parent: Instance, top: Color3?, bottom: Color3?, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top or Color3.new(1, 1, 1), bottom or Color3.fromRGB(205, 205, 205))
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Util.Pad(parent: Instance, all: number, top: number?, bottom: number?): UIPadding
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, all)
	p.PaddingRight = UDim.new(0, all)
	p.PaddingTop = UDim.new(0, top or all)
	p.PaddingBottom = UDim.new(0, bottom or all)
	p.Parent = parent
	return p
end

function Util.List(parent: Instance, gap: number?, horizontal: boolean?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap or Theme.Size.Gap)
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = vAlign or Enum.VerticalAlignment.Top
	l.Parent = parent
	return l
end

function Util.Grid(parent: Instance, cell: Vector2, gap: number?): UIGridLayout
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(cell.X, cell.Y)
	g.CellPadding = UDim2.fromOffset(gap or 10, gap or 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = parent
	return g
end

-- A text label. Scaled text keeps a readable minimum; wrapped text grows its height instead.
export type TextOpts = {
	text: string?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	textSize: number?,
	color: Color3?,
	font: Enum.Font?,
	xAlign: Enum.TextXAlignment?,
	yAlign: Enum.TextYAlignment?,
	scaled: boolean?, -- TextScaled with a size constraint (default true)
	wrap: boolean?, -- wrapped + AutomaticSize Y (ignores scaled)
	outline: boolean?, -- dark text stroke (game style)
	z: number?,
	order: number?,
	parent: Instance?,
}

function Util.Text(o: TextOpts): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text = o.text or ""
	t.Size = o.size or UDim2.fromScale(1, 1)
	t.Position = o.position or UDim2.new()
	t.AnchorPoint = o.anchor or Vector2.zero
	t.Font = o.font or Theme.Font.Body
	t.TextColor3 = o.color or Theme.Color.Text
	t.TextXAlignment = o.xAlign or Enum.TextXAlignment.Center
	t.TextYAlignment = o.yAlign or Enum.TextYAlignment.Center
	t.ZIndex = o.z or 1
	t.LayoutOrder = o.order or 0
	local size = math.max(o.textSize or Theme.Text.M, Theme.Text.Min)
	if o.wrap then
		t.TextWrapped = true
		t.TextSize = size
		t.AutomaticSize = Enum.AutomaticSize.Y
	elseif o.scaled ~= false then
		t.TextScaled = true
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = size
		c.MinTextSize = Theme.Text.Min - 4 -- allow a little squeeze for long words, never tiny
		c.Parent = t
	else
		t.TextSize = size
	end
	if o.outline then
		t.TextStrokeTransparency = 0
		t.TextStrokeColor3 = Theme.Color.Ink
	end
	t.Parent = o.parent
	return t
end

function Util.Tween(inst: Instance, info: TweenInfo, goal: { [string]: any }): Tween
	local tw = TweenService:Create(inst, info, goal)
	tw:Play()
	return tw
end

-- Brief horizontal shake (rejected purchase). Uses the object's own position as home.
local shaking: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
function Util.Shake(obj: GuiObject)
	if shaking[obj] then
		return
	end
	shaking[obj] = true
	local home = obj.Position
	task.spawn(function()
		for _, dx in { 8, -8, 6, -6, 3, 0 } do
			obj.Position = home + UDim2.fromOffset(dx, 0)
			task.wait(0.035)
		end
		obj.Position = home
		shaking[obj] = nil
	end)
end

-- Little "pop" on a UIScale (press feedback, counters).
function Util.Pop(obj: GuiObject, amount: number?)
	local sc = obj:FindFirstChildOfClass("UIScale")
	if not sc then
		local made = Instance.new("UIScale")
		made.Parent = obj
		sc = made
	end
	assert(sc)
	sc.Scale = 1 + (amount or 0.12)
	Util.Tween(sc, Theme.Tween.Pop, { Scale = 1 })
end

function Util.Clear(parent: Instance, keepClasses: { string }?)
	for _, c in parent:GetChildren() do
		if keepClasses and table.find(keepClasses, c.ClassName) then
			continue
		end
		c:Destroy()
	end
end

-- Scrolling container that grows with its content (cards / rows).
function Util.Scroll(parent: Instance, size: UDim2?, position: UDim2?): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = size or UDim2.fromScale(1, 1)
	s.Position = position or UDim2.new()
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = Theme.Color.Ink
	s.ScrollBarImageTransparency = 0.4
	s.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
	s.Parent = parent
	return s
end

return Util
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="115">
          <Properties>
            <string name="Name">Visuals</string>
          </Properties>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Small, bounded effects for the local player's own farm:
--   Collected / Deposited  egg burst + floating "+N eggs" at the ring
--   Sold                   floating "+$X" over the vehicle's dock bay
--   Purchased              a puff at whatever was bought (house, bay, worker start, silo)
--   ring pulse             when standing in a ring that has something to do right now
--   "FULL" bubble          over houses whose stored eggs reached their storage
-- Bursts, texts and puffs honour settings.effects; the pulse and FULL bubble are gameplay hints
-- and always show. Every effect is pooled or destroyed when it ends; counts are capped.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Kit = require(Shared:WaitForChild("Models"):WaitForChild("Kit"))

local Effects = {}

local MAX_EGGS = 48
local MAX_TEXTS = 10
local MAX_PUFFS = 6
local GRAVITY = Vector3.new(0, -60, 0)

type Egg = { part: BasePart, vel: Vector3, age: number, life: number }
type Text = { part: BasePart, gui: BillboardGui, label: TextLabel, age: number, life: number }
type Puff = { parts: { BasePart }, age: number, life: number, size: number }

local ctx: any = nil
local own: any = nil
local unsubs: { () -> () } = {}
local eggs: { Egg } = {}
local eggPool: { BasePart } = {}
local texts: { Text } = {}
local puffs: { Puff } = {}
local pulses: { [string]: BasePart } = {}
local bubbles: { [number]: BillboardGui } = {}
local rng = Random.new()
local pulseClock = 0
local checkAcc = 0
local activeRings: { [string]: BasePart } = {}

-- ------------------------------------------------------------------ lookups on the own plot
local function child(root: Instance?, ...: string): Instance?
	local cur = root
	for _, name in { ... } do
		if not cur then
			return nil
		end
		cur = cur:FindFirstChild(name)
	end
	return cur
end

local function ringOf(slot: number): BasePart?
	local r = own and child(own.plot, "Houses", "House" .. slot, "CollectRing")
	return if r and r:IsA("BasePart") then r else nil
end

local function depositRing(): BasePart?
	local r = own and child(own.plot, "Warehouse", "DepositRing")
	return if r and r:IsA("BasePart") then r else nil
end

local function posOf(inst: Instance?): Vector3?
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return nil
end

local function accentOf(ring: BasePart?): Color3
	local glow = ring and ring:FindFirstChild("Glow")
	if glow and glow:IsA("BasePart") then
		return glow.Color
	end
	return Color3.fromRGB(255, 214, 74)
end

-- ------------------------------------------------------------------ primitives
local function burst(at: Vector3, count: number)
	if not ctx or not ctx.effects then
		return
	end
	for _ = 1, count do
		if #eggs >= MAX_EGGS then
			return
		end
		local part = table.remove(eggPool)
		if not part then
			part = Kit.Egg(nil, CFrame.identity, Vector3.new(0.7, 0.95, 0.7), { name = "EggFx", color = Kit.Fixed.cream, collide = false, shadow = false })
		end
		assert(part)
		part.Transparency = 0
		part.CFrame = CFrame.new(at + Vector3.new(0, 1, 0))
		part.Parent = ctx.container
		local a = rng:NextNumber() * math.pi * 2
		local out = 4 + rng:NextNumber() * 6
		table.insert(eggs, {
			part = part,
			vel = Vector3.new(math.cos(a) * out, 16 + rng:NextNumber() * 8, math.sin(a) * out),
			age = 0,
			life = 0.8 + rng:NextNumber() * 0.3,
		})
	end
end

local function floatText(at: Vector3, text: string, color: Color3)
	if not ctx or not ctx.effects then
		return
	end
	if #texts >= MAX_TEXTS then
		local oldest = table.remove(texts, 1) :: Text
		oldest.part:Destroy()
	end
	local part = Kit.Part(ctx.container, {
		name = "TextFx",
		size = Vector3.new(0.2, 0.2, 0.2),
		cf = CFrame.new(at + Vector3.new(0, 4, 0)),
		transparency = 1,
		collide = false,
		shadow = false,
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 56)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(40, 30, 20)
	label.Parent = gui
	table.insert(texts, { part = part, gui = gui, label = label, age = 0, life = 1.4 })
end

local function puff(at: Vector3, size: number, color: Color3)
	if not ctx or not ctx.effects or #puffs >= MAX_PUFFS then
		return
	end
	local parts = {}
	for i = 1, 3 do
		local off = Vector3.new(rng:NextNumber() - 0.5, rng:NextNumber() * 0.5, rng:NextNumber() - 0.5) * size
		parts[i] = Kit.Part(ctx.container, {
			name = "PuffFx",
			size = Vector3.one,
			cf = CFrame.new(at + off),
			shape = "Ball",
			color = if i == 1 then color else Color3.new(1, 1, 1),
			transparency = 0.3,
			collide = false,
			shadow = false,
		})
	end
	table.insert(puffs, { parts = parts, age = 0, life = 0.6, size = size })
end

-- ------------------------------------------------------------------ farm events
local function onCollected(data: any)
	local slot = type(data) == "table" and tonumber(data.slot) or nil
	local ring = slot and ringOf(slot)
	if not ring then
		return
	end
	local amount = tonumber(data.amount) or 0
	burst(ring.Position, math.clamp(math.floor(math.log10(math.max(amount, 1)) + 3), 3, 7))
	floatText(ring.Position, "+" .. Format.Short(amount) .. " eggs", Color3.fromRGB(255, 246, 210))
end

local function onDeposited(data: any)
	local ring = depositRing()
	if not ring then
		return
	end
	local amount = type(data) == "table" and tonumber(data.amount) or 0
	burst(ring.Position, 6)
	floatText(ring.Position, "+" .. Format.Short(amount or 0) .. " stored", Color3.fromRGB(255, 236, 140))
end

local function onSold(data: any)
	local slot = type(data) == "table" and tonumber(data.slot) or 1
	local bay = own and child(own.plot, "Dock", "Bay" .. tostring(slot))
	local at = posOf(bay)
	if not at then
		return
	end
	local cash = type(data) == "table" and tonumber(data.cash) or 0
	floatText(at + Vector3.new(0, 4, 0), "+" .. Format.Cash(cash or 0), Color3.fromRGB(120, 255, 130))
end

local function onPurchased(data: any)
	if type(data) ~= "table" or not own then
		return
	end
	local kind = data.kind
	local at: Vector3? = nil
	local size = 8
	if kind == "house" then
		at = posOf(child(own.plot, "Houses", "House" .. tostring(data.slot), "Building"))
		size = 16
	elseif kind == "vehicle" then
		at = posOf(child(own.plot, "Dock", "Bay" .. tostring(data.slot)))
	elseif kind == "worker" then
		at = posOf(child(own.plot, "WorkerPath", "Start"))
	elseif kind == "silo" then
		at = posOf(child(own.plot, "Silos", "Silo" .. tostring(data.count)))
		if at then
			at += Vector3.new(0, 8, 0)
		end
	end
	if not at then
		local char = Players.LocalPlayer.Character
		at = char and posOf(char)
	end
	if at then
		puff(at + Vector3.new(0, 3, 0), size, accentOf(ringOf(1)))
	end
end

-- ------------------------------------------------------------------ FULL bubbles
local function setBubble(slot: number, show: boolean)
	local b = bubbles[slot]
	if not show then
		if b then
			b.Enabled = false
		end
		return
	end
	local ring = ringOf(slot)
	if not ring then
		return
	end
	if not b then
		local gui = Instance.new("BillboardGui")
		gui.Name = "FullBubble" .. slot
		gui.Size = UDim2.fromOffset(110, 46)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 9, 0)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 220
		gui.ResetOnSpawn = false
		local frame = Instance.new("TextLabel")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(230, 60, 50)
		frame.Font = Enum.Font.FredokaOne
		frame.Text = "FULL"
		frame.TextScaled = true
		frame.TextColor3 = Color3.new(1, 1, 1)
		frame.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Color = Color3.new(1, 1, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = frame
		local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
		gui.Parent = pg
		bubbles[slot] = gui
		b = gui
	end
	assert(b)
	b.Adornee = ring
	b.Enabled = true
end

function Effects.OnSnapshot(snap: any)
	if not snap or type(snap.housing) ~= "table" then
		return
	end
	for slot = 1, 4 do
		local h = snap.housing[slot]
		local full = h ~= nil and (h.tier or 0) > 0 and (h.storage or 0) > 0 and (h.eggs or 0) >= h.storage
		setBubble(slot, full and own ~= nil)
	end
end

-- ------------------------------------------------------------------ ring pulse
local function pulsePart(key: string): BasePart
	local p = pulses[key]
	if not p then
		p = Kit.Part(nil, {
			name = "RingPulse",
			size = Vector3.new(0.1, 14, 14),
			cf = CFrame.identity,
			shape = "Cylinder",
			material = Enum.Material.Neon,
			transparency = 0.5,
			collide = false,
			shadow = false,
		})
		pulses[key] = p
	end
	assert(p)
	return p
end

local function checkRings()
	table.clear(activeRings)
	local snap = ctx and ctx.snapshot
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not own or not snap or not root or not root:IsA("BasePart") then
		return
	end
	local pos = root.Position
	local function inside(ring: BasePart): boolean
		local rel = ring.CFrame:PointToObjectSpace(pos)
		local r = math.max(ring.Size.X, ring.Size.Z) / 2 + 1
		return rel.X * rel.X + rel.Z * rel.Z <= r * r and math.abs(rel.Y) < 9
	end
	local carried = tonumber(snap.carried) or 0
	local cap = tonumber(snap.carryCap) or math.huge
	if type(snap.housing) == "table" and carried < cap then
		for slot = 1, 4 do
			local h = snap.housing[slot]
			local ring = ringOf(slot)
			if h and (h.tier or 0) > 0 and (h.eggs or 0) >= 1 and ring and inside(ring) then
				activeRings["c" .. slot] = ring
			end
		end
	end
	local dep = depositRing()
	if carried > 0 and dep and inside(dep) then
		activeRings.d = dep
	end
end

-- ------------------------------------------------------------------ lifecycle
function Effects.Init(c: any)
	ctx = c
	local Store = c.Store
	table.insert(unsubs, Store.OnEvent("Collected", onCollected))
	table.insert(unsubs, Store.OnEvent("Deposited", onDeposited))
	table.insert(unsubs, Store.OnEvent("Sold", onSold))
	table.insert(unsubs, Store.OnEvent("Purchased", onPurchased))
end

function Effects.SetOwnPlot(info: any)
	own = info
	if not info then
		for slot in bubbles do
			setBubble(slot, false)
		end
		for _, p in pulses do
			p.Parent = nil
		end
	end
end

function Effects.Update(dt: number, _c: any)
	-- eggs: simple ballistic arcs, then back to the pool
	for i = #eggs, 1, -1 do
		local e = eggs[i]
		e.age += dt
		if e.age >= e.life then
			e.part.Parent = nil
			table.insert(eggPool, e.part)
			table.remove(eggs, i)
		else
			e.vel += GRAVITY * dt
			e.part.CFrame = CFrame.new(e.part.Position + e.vel * dt) * CFrame.Angles(e.age * 6, e.age * 4, 0)
			if e.life - e.age < 0.25 then
				e.part.Transparency = 1 - (e.life - e.age) / 0.25
			end
		end
	end
	for i = #texts, 1, -1 do
		local t = texts[i]
		t.age += dt
		if t.age >= t.life then
			t.part:Destroy()
			table.remove(texts, i)
		else
			local f = t.age / t.life
			t.gui.StudsOffset = Vector3.new(0, f * 4, 0)
			t.label.TextTransparency = math.max(0, (f - 0.6) / 0.4)
			t.label.TextStrokeTransparency = 0.2 + 0.8 * math.max(0, (f - 0.6) / 0.4)
		end
	end
	for i = #puffs, 1, -1 do
		local p = puffs[i]
		p.age += dt
		if p.age >= p.life then
			for _, part in p.parts do
				part:Destroy()
			end
			table.remove(puffs, i)
		else
			local f = p.age / p.life
			for _, part in p.parts do
				part.Size = Vector3.one * (p.size * (0.3 + f))
				part.Transparency = 0.3 + 0.7 * f
			end
		end
	end
	-- ring pulse (checked at 10 Hz, animated every frame)
	checkAcc += dt
	if checkAcc >= 0.1 then
		checkAcc = 0
		checkRings()
	end
	pulseClock += dt
	for key, p in pulses do
		local ring = activeRings[key]
		if ring and ctx then
			local d = math.max(ring.Size.X, ring.Size.Z)
			local s = 1 + 0.1 * math.sin(pulseClock * 7)
			p.Size = Vector3.new(0.1, d * s, d * s)
			p.CFrame = ring.CFrame * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2)
			p.Color = accentOf(ring)
			p.Transparency = 0.35 + 0.25 * math.sin(pulseClock * 7)
			if p.Parent ~= ctx.container then
				p.Parent = ctx.container
			end
		elseif p.Parent then
			p.Parent = nil
		end
	end
	for key in activeRings do
		if not pulses[key] then
			pulsePart(key) -- shown from the next frame
		end
	end
end

function Effects.Destroy()
	for _, u in unsubs do
		u()
	end
	table.clear(unsubs)
	for _, e in eggs do
		e.part:Destroy()
	end
	table.clear(eggs)
	for _, p in eggPool do
		p:Destroy()
	end
	table.clear(eggPool)
	for _, t in texts do
		t.part:Destroy()
	end
	table.clear(texts)
	for _, p in puffs do
		for _, part in p.parts do
			part:Destroy()
		end
	end
	table.clear(puffs)
	for _, p in pulses do
		p:Destroy()
	end
	table.clear(pulses)
	for _, b in bubbles do
		b:Destroy()
	end
	table.clear(bubbles)
	own = nil
	ctx = nil
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">FlockView</string>
              <string name="Source"><![CDATA[--!strict
-- Draws the bounded, representative flock: how many birds per house comes from the pure planner
-- (Shared/Logic/Flock: caps per setting, own plot vs others, distance), the birds themselves are
-- pooled chicken rigs wandering inside each house's Anchor yard. Birds far from the camera are
-- re-posed less often (Flock.UpdateInterval); idle far birds cost nothing.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Flock = require(Shared:WaitForChild("Logic"):WaitForChild("Flock"))
local Housing = require(Shared:WaitForChild("Data"):WaitForChild("Housing"))
local ChickenModel = require(Shared:WaitForChild("Models"):WaitForChild("Chicken"))
local Rig = require(script.Parent:WaitForChild("Rig"))

local FlockView = {}

type Bird = {
	state: Flock.Bird,
	rig: Rig.Rig,
	acc: number,
}

type HouseView = {
	anchor: BasePart?,
	birds: { Bird },
}

type PlotView = {
	houses: { HouseView },
	interval: number,
}

local views: { [Model]: PlotView } = {}
local rng = Random.new()
local function rand(): number
	return rng:NextNumber()
end

local function parseTiers(s: any, n: number): { number }
	local out = {}
	local i = 0
	if type(s) == "string" then
		for part in string.gmatch(s, "[^,]+") do
			i += 1
			out[i] = tonumber(part) or 0
		end
	end
	for k = i + 1, n do
		out[k] = 0
	end
	return out
end
FlockView.ParseTiers = parseTiers

local function yard(anchor: BasePart): (number, number)
	return math.max(0.5, anchor.Size.X / 2 - 0.9), math.max(0.5, anchor.Size.Z / 2 - 0.9)
end

local function releaseBird(b: Bird)
	Rig.Release(b.rig)
end

function FlockView.ClearPlot(plot: Model)
	local v = views[plot]
	if not v then
		return
	end
	for _, h in v.houses do
		for _, b in h.birds do
			releaseBird(b)
		end
		table.clear(h.birds)
	end
	views[plot] = nil
end

local function occupantsFor(info: any, snapshot: any): { number }
	local plot: Model = info.plot
	if info.own and snapshot and type(snapshot.housing) == "table" then
		local occ = {}
		for i = 1, Housing.Slots do
			local h = snapshot.housing[i]
			occ[i] = if h and (h.tier or 0) > 0 then tonumber(h.occupants) or 0 else 0
		end
		return occ
	end
	local tiers = parseTiers(plot:GetAttribute("HouseTiers"), Housing.Slots)
	local caps = {}
	for i = 1, Housing.Slots do
		local t = Housing.Tiers[tiers[i]]
		caps[i] = if t then t.capacity else 0
	end
	return Flock.Distribute(tonumber(plot:GetAttribute("Population")) or 0, caps)
end

function FlockView.Replan(ctx: any)
	for plot in views do
		if not ctx.plots[plot] then
			FlockView.ClearPlot(plot)
		end
	end
	for plot, info in ctx.plots do
		local counts = Flock.Plan({
			occupants = occupantsFor(info, ctx.snapshot),
			setting = ctx.flock,
			own = info.own,
			distance = info.dist,
		})
		local v = views[plot]
		if not v then
			v = { houses = {}, interval = 0 }
			views[plot] = v
		end
		assert(v)
		v.interval = Flock.UpdateInterval(info.dist)
		for slot = 1, Housing.Slots do
			local hv = v.houses[slot]
			if not hv then
				hv = { anchor = nil, birds = {} }
				v.houses[slot] = hv
			end
			assert(hv)
			if not hv.anchor or not hv.anchor.Parent then
				local houses = plot:FindFirstChild("Houses")
				local house = houses and houses:FindFirstChild("House" .. slot)
				local a = house and house:FindFirstChild("Anchor")
				hv.anchor = if a and a:IsA("BasePart") then a else nil
			end
			local want = if hv.anchor then counts[slot] or 0 else 0
			while #hv.birds > want do
				releaseBird(table.remove(hv.birds) :: Bird)
			end
			local anchor = hv.anchor
			if anchor then
				local hx, hz = yard(anchor)
				while #hv.birds < want do
					local b: Bird = {
						state = Flock.NewBird(hx, hz, rand),
						rig = Rig.Get("chicken", rng:NextInteger(1, ChickenModel.Variants)),
						acc = 10, -- pose on the next frame
					}
					table.insert(hv.birds, b)
				end
			end
		end
	end
end

local angles: { [string]: number } = { head = 0, legL = 0, legR = 0 } -- reused every pose

function FlockView.Update(dt: number, _ctx: any, parts: { BasePart }, cfs: { CFrame })
	for _, v in views do
		local interval = v.interval
		for _, hv in v.houses do
			local anchor = hv.anchor
			if not anchor or #hv.birds == 0 then
				continue
			end
			local base = anchor.CFrame * CFrame.new(0, -anchor.Size.Y / 2 + 0.05, 0)
			local hx, hz = yard(anchor)
			for _, b in hv.birds do
				b.acc += dt
				if b.acc < interval then
					continue
				end
				local s = Flock.Wander(b.state, math.min(b.acc, 0.5), hx, hz, rand)
				b.acc = 0
				local root = base * CFrame.new(s.x, s.hop, s.z) * CFrame.Angles(0, s.heading, 0)
				local swing = if s.mode == "walk" then math.sin(s.phase * 14) * 0.6 else 0
				angles.head = -s.peck * 0.9
				angles.legL = swing
				angles.legR = -swing
				Rig.Pose(b.rig, root, angles, parts, cfs)
			end
		end
	end
end

return FlockView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">Rig</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side posable models. A Rig wraps one of the shared part models (Models/Chicken, Worker,
-- Vehicle, Crate): every visible part keeps its offset from the model origin, and parts tagged
-- with a "Rig" group (head, legL, armR, tail, ...) can be swung about that group's pivot.
-- Nothing is ever simulated: Visuals poses all rigs once per frame and moves every part with a
-- single workspace:BulkMoveTo call. Rigs are pooled per kind+tier and reused.

local Workspace = game:GetService("Workspace")

local Rig = {}

export type Rig = {
	key: string,
	model: Model,
	parts: { BasePart },
	offsets: { CFrame },
	groups: { string },
	pivots: { [string]: Vector3 },
	attrs: { [string]: any },
	active: boolean,
}

local HIDDEN = CFrame.new(0, -2000, 0)

function Rig.new(key: string, model: Model): Rig
	local origin = model:GetPivot()
	local rig: Rig = {
		key = key,
		model = model,
		parts = {},
		offsets = {},
		groups = {},
		pivots = {},
		attrs = model:GetAttributes(),
		active = false,
	}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			table.insert(rig.parts, d)
			table.insert(rig.offsets, origin:ToObjectSpace(d.CFrame))
			local g = d:GetAttribute("Rig")
			table.insert(rig.groups, if type(g) == "string" then g else "")
		end
	end
	for name, value in rig.attrs do
		if typeof(value) == "Vector3" and string.sub(name, 1, 6) == "Pivot_" then
			rig.pivots[string.sub(name, 7)] = value
		end
	end
	return rig
end

-- Append the parts and target CFrames of `rig` posed at `root` to the bulk-move lists.
-- `angles` swings groups about their pivot (radians about the model's X axis).
function Rig.Pose(rig: Rig, root: CFrame, angles: { [string]: number }?, outParts: { BasePart }, outCFs: { CFrame })
	local parts, offsets, groups, pivots = rig.parts, rig.offsets, rig.groups, rig.pivots
	local swings: { [string]: CFrame }? = nil
	if angles then
		local s: { [string]: CFrame } = {}
		for g, a in angles do
			local pv = pivots[g]
			if pv and a ~= 0 then
				s[g] = CFrame.new(pv) * CFrame.Angles(a, 0, 0) * CFrame.new(-pv)
			end
		end
		swings = s
	end
	for i, part in parts do
		local sw = swings and swings[groups[i]]
		outParts[#outParts + 1] = part
		outCFs[#outCFs + 1] = if sw then root * sw * offsets[i] else root * offsets[i]
	end
end

-- ------------------------------------------------------------------ pool
local free: { [string]: { Rig } } = {}
local builders: { [string]: (number) -> Model } = {}
local container: Instance? = nil
local MAX_FREE = 40

function Rig.SetContainer(c: Instance)
	container = c
end

function Rig.Register(kind: string, build: (number) -> Model)
	builders[kind] = build
end

function Rig.Get(kind: string, variant: number): Rig
	local key = kind .. ":" .. variant
	local list = free[key]
	local rig: Rig
	if list and #list > 0 then
		rig = table.remove(list) :: Rig
	else
		local build = builders[kind]
		assert(build, "no rig builder for " .. kind)
		rig = Rig.new(key, build(variant))
	end
	rig.active = true
	rig.model.Parent = container or Workspace
	return rig
end

-- Return a rig to the pool (hidden, unparented). Excess rigs are destroyed so pools stay bounded.
function Rig.Release(rig: Rig)
	if not rig.active then
		return
	end
	rig.active = false
	rig.model.Parent = nil
	local list = free[rig.key]
	if not list then
		list = {}
		free[rig.key] = list
	end
	if #list < MAX_FREE then
		table.insert(list, rig)
	else
		rig.model:Destroy()
	end
end

-- Park a rig out of sight without returning it to the pool (e.g. a vehicle inside the tunnel).
function Rig.Hide(rig: Rig, outParts: { BasePart }, outCFs: { CFrame })
	Rig.Pose(rig, HIDDEN, nil, outParts, outCFs)
end

function Rig.DestroyPools()
	for _, list in free do
		for _, rig in list do
			rig.model:Destroy()
		end
	end
	table.clear(free)
end

return Rig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">ThemeLighting</string>
              <string name="Source"><![CDATA[--!strict
-- Local theme lighting: tints the sky haze and colour grade to the local player's egg theme
-- (Data/Themes fog / ambient / accent). Client-only changes, tweened, never replicated.

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))
local Kit = require(Shared:WaitForChild("Models"):WaitForChild("Kit"))

local ThemeLighting = {}

local TWEEN = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local current: string? = nil
local tint: ColorCorrectionEffect? = nil
local original: { [string]: any }? = nil

function ThemeLighting.Init()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "ThemeTint"
	cc.Parent = Lighting
	tint = cc
	original = { OutdoorAmbient = Lighting.OutdoorAmbient }
end

function ThemeLighting.Apply(egg: number?)
	local e = Eggs.List[math.clamp(math.floor(tonumber(egg) or 1), 1, Eggs.Count)]
	if not e or e.theme == current then
		return
	end
	current = e.theme
	local pal = Kit.Palette(e.theme)
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		local dark = (pal.fog.R + pal.fog.G + pal.fog.B) / 3 < 0.4
		TweenService:Create(atmo, TWEEN, {
			Color = pal.fog,
			Decay = pal.fog:Lerp(Color3.new(0, 0, 0), 0.3),
			Haze = if dark then 2.2 else 1.2,
			Density = if dark then 0.36 else 0.28,
		}):Play()
	end
	local cc = tint
	if cc then
		TweenService:Create(cc, TWEEN, {
			TintColor = Color3.new(1, 1, 1):Lerp(pal.accent, 0.07),
			Saturation = 0.04,
		}):Play()
	end
	local base = original and original.OutdoorAmbient
	if typeof(base) == "Color3" then
		TweenService:Create(Lighting, TWEEN, { OutdoorAmbient = base:Lerp(pal.ambient, 0.35) }):Play()
	end
end

function ThemeLighting.Destroy()
	if tint then
		tint:Destroy()
		tint = nil
	end
	if original and typeof(original.OutdoorAmbient) == "Color3" then
		Lighting.OutdoorAmbient = original.OutdoorAmbient
	end
	current = nil
end

return ThemeLighting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">Vehicles</string>
              <string name="Source"><![CDATA[--!strict
-- Shipping vehicles. On the local player's plot each owned vehicle follows its snapshot phase:
-- "dock" parked in its bay (crate shown while loaded), "out" driving the bay -> road -> tunnel
-- path (hidden inside the hill), "back" returning and reversing into the bay. Positions are
-- interpolated locally from the snapshot (t + time since the snapshot), so motion is smooth
-- between the 4 Hz server updates. Other plots only park their vehicles (VehicleTiers
-- attribute), posed once, and only within OTHER_RADIUS studs of the camera.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared:WaitForChild("Logic"):WaitForChild("PlotLayout"))
local VehicleData = require(Shared:WaitForChild("Data"):WaitForChild("Vehicles"))
local Rig = require(script.Parent:WaitForChild("Rig"))
local FlockView = require(script.Parent:WaitForChild("FlockView"))

local Vehicles = {}

local OTHER_RADIUS = 350
local SLOTS = VehicleData.MaxSlots

type Slot = {
	rig: Rig.Rig?,
	crate: Rig.Rig?,
	tier: number,
	path: { Layout.Vec },
	len: number,
	tunnel: number,
	hidden: boolean,
	posed: boolean,
}

type View = { slots: { Slot }, own: boolean }

local views: { [Model]: View } = {}

local function releaseSlot(s: Slot)
	if s.rig then
		Rig.Release(s.rig)
		s.rig = nil
	end
	if s.crate then
		Rig.Release(s.crate)
		s.crate = nil
	end
	s.tier = 0
	s.posed = false
	s.hidden = false
end

function Vehicles.ClearPlot(plot: Model)
	local v = views[plot]
	if v then
		for _, s in v.slots do
			releaseSlot(s)
		end
		views[plot] = nil
	end
end

local function newView(): View
	local slots = {}
	for i = 1, SLOTS do
		local path = Layout.VehiclePath(i)
		slots[i] = {
			rig = nil,
			crate = nil,
			tier = 0,
			path = path,
			len = Layout.PolyLength(path),
			tunnel = Layout.TunnelDistance(i),
			hidden = false,
			posed = false,
		}
	end
	return { slots = slots, own = false }
end

function Vehicles.Replan(ctx: any)
	for plot in views do
		if not ctx.plots[plot] then
			Vehicles.ClearPlot(plot)
		end
	end
	local snap = ctx.snapshot
	for plot, info in ctx.plots do
		local tiers: { number }
		if info.own and snap and type(snap.vehicles) == "table" then
			tiers = {}
			for i = 1, SLOTS do
				local v = snap.vehicles[i]
				tiers[i] = if v then tonumber(v.tier) or 0 else 0
			end
		elseif not info.own and info.dist <= OTHER_RADIUS then
			tiers = FlockView.ParseTiers(plot:GetAttribute("VehicleTiers"), SLOTS)
		else
			tiers = table.create(SLOTS, 0)
		end
		local view = views[plot]
		if not view then
			view = newView()
			views[plot] = view
		end
		assert(view)
		if view.own ~= info.own then
			view.own = info.own
			for _, s in view.slots do
				s.posed = false
			end
		end
		for i, s in view.slots do
			local tier = math.clamp(tiers[i] or 0, 0, VehicleData.MaxTier)
			if tier ~= s.tier then
				releaseSlot(s)
				if tier > 0 then
					s.rig = Rig.Get("vehicle", tier)
					s.tier = tier
				end
			end
		end
	end
end

local clock = 0

local function pose(info: any, s: Slot, d: number, out: boolean, loaded: boolean, parts: { BasePart }, cfs: { CFrame })
	local rig = s.rig
	if not rig then
		return
	end
	if d > s.tunnel + 2 then
		if not s.hidden then
			s.hidden = true
			Rig.Hide(rig, parts, cfs)
			if s.crate then
				Rig.Hide(s.crate, parts, cfs)
			end
		end
		return
	end
	s.hidden = false
	local p, dir, seg = Layout.PolyPoint(s.path, d)
	local fx, fz
	if seg <= 2 then
		fx, fz = Layout.BayFacing.x, Layout.BayFacing.z -- nose to the road; reverses into the bay
	elseif out then
		fx, fz = dir.x, dir.z
	else
		fx, fz = -dir.x, -dir.z
	end
	local pos = Vector3.new(p.x, 0, p.z)
	if s.tier >= 7 then
		pos += Vector3.new(0, math.sin(clock * 2 + s.len) * 0.35, 0)
	end
	local root = info.cf * CFrame.lookAt(pos, pos + Vector3.new(fx, 0, fz))
	Rig.Pose(rig, root, nil, parts, cfs)
	if loaded then
		if not s.crate then
			s.crate = Rig.Get("crate", 1)
		end
		local crate = s.crate
		assert(crate)
		local off = rig.attrs.LoadOffset
		Rig.Pose(crate, root * CFrame.new(if typeof(off) == "Vector3" then off else Vector3.new(0, 3, 0)), nil, parts, cfs)
	elseif s.crate then
		Rig.Release(s.crate)
		s.crate = nil
	end
end

function Vehicles.Update(dt: number, ctx: any, parts: { BasePart }, cfs: { CFrame })
	clock += dt
	local snap = ctx.snapshot
	for plot, view in views do
		local info = ctx.plots[plot]
		if not info then
			continue
		end
		if view.own and snap and type(snap.vehicles) == "table" then
			for i, s in view.slots do
				local v = snap.vehicles[i]
				if not s.rig or not v then
					continue
				end
				local trip = tonumber(v.trip) or 0
				if trip <= 0 then
					local t = VehicleData.Tiers[s.tier]
					trip = if t then t.trip else 10
				end
				local half = trip / 2
				local tt = (tonumber(v.t) or 0) + ctx.elapsed
				local f = math.clamp(tt / half, 0, 1)
				local load = tonumber(v.load) or 0
				if v.phase == "out" then
					pose(info, s, f * s.len, true, load > 0, parts, cfs)
				elseif v.phase == "back" then
					pose(info, s, (1 - f) * s.len, false, false, parts, cfs)
				else
					pose(info, s, 0, true, load > 0, parts, cfs)
				end
			end
		else
			for _, s in view.slots do
				if s.rig and not s.posed then
					s.posed = true
					pose(info, s, 0, true, false, parts, cfs)
				end
			end
		end
	end
end

return Vehicles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Visuals</string>
              <string name="Source"><![CDATA[--!strict
-- Client visuals: bounded flock, vehicles, workers, effects and theme lighting.
--   Visuals.Start(Store)   call once from the client bootstrap (after Store.Start()).
--   Visuals.Stop()         tears everything down (also runs when the local player leaves).
-- Everything here is decoration: nothing is sent to the server and no physics runs. All moving
-- parts are anchored and posed by ONE Heartbeat loop that ends in a single BulkMoveTo call.
-- Plots are tracked through Workspace.Plots/Plot<N> attributes (OwnerUserId, Population,
-- HouseTiers, VehicleTiers, WorkerTiers, Egg); the local player's own farm also uses the Store
-- snapshot for exact vehicle/worker phases. A plot whose OwnerUserId becomes 0 is cleared.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Models = Shared:WaitForChild("Models")
local Layout = require(Shared:WaitForChild("Logic"):WaitForChild("PlotLayout"))
local Chicken = require(Models:WaitForChild("Chicken"))
local WorkerModel = require(Models:WaitForChild("Worker"))
local VehicleModel = require(Models:WaitForChild("Vehicle"))
local Crate = require(Models:WaitForChild("Crate"))

local Rig = require(script.Parent:WaitForChild("Rig"))
local FlockView = require(script.Parent:WaitForChild("FlockView"))
local Vehicles = require(script.Parent:WaitForChild("Vehicles"))
local Workers = require(script.Parent:WaitForChild("Workers"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local ThemeLighting = require(script.Parent:WaitForChild("ThemeLighting"))

local Visuals = {}

export type PlotInfo = {
	plot: Model,
	index: number,
	owner: number,
	own: boolean,
	cf: CFrame, -- plot frame (PlotLayout local -> world)
	center: Vector3,
	dist: number, -- studs from the camera to the plot centre (refreshed every replan)
}

export type Ctx = {
	Store: any,
	player: Player,
	container: Folder,
	plots: { [Model]: PlotInfo },
	own: PlotInfo?,
	snapshot: any,
	elapsed: number, -- seconds since the snapshot was taken (server clock estimate)
	effects: boolean,
	flock: string,
}

local ctx: Ctx? = nil
local connections: { RBXScriptConnection } = {}
local unsubs: { () -> () } = {}
local REPLAN_EVERY = 0.5

local function plotCF(index: number): CFrame
	local o, yaw = Layout.Origin(index)
	return CFrame.new(o.x, 0, o.z) * CFrame.Angles(0, yaw, 0)
end

local function cameraPos(): Vector3
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

local function clearPlot(c: Ctx, plot: Model)
	FlockView.ClearPlot(plot)
	Vehicles.ClearPlot(plot)
	Workers.ClearPlot(plot)
	if c.own and c.own.plot == plot then
		c.own = nil
		Effects.SetOwnPlot(nil)
	end
	c.plots[plot] = nil
end

local function refreshPlot(c: Ctx, plot: Model)
	local owner = tonumber(plot:GetAttribute("OwnerUserId")) or 0
	local index = tonumber(plot:GetAttribute("PlotIndex")) or tonumber(string.match(plot.Name, "%d+")) or 0
	if owner == 0 or index < 1 or index > Layout.PlotCount then
		if c.plots[plot] then
			clearPlot(c, plot)
		end
		return
	end
	local info: PlotInfo? = c.plots[plot]
	local own = owner == c.player.UserId
	if info and info.owner ~= owner then
		clearPlot(c, plot) -- new owner: start from scratch
		info = nil
	end
	if not info then
		local cf = plotCF(index)
		local fresh: PlotInfo = { plot = plot, index = index, owner = owner, own = own, cf = cf, center = cf.Position, dist = 0 }
		info = fresh
		c.plots[plot] = fresh
	end
	assert(info)
	info.own = own
	if own then
		c.own = info
		Effects.SetOwnPlot(info)
	end
end

local function replan(c: Ctx)
	local cam = cameraPos()
	for _, info in c.plots do
		info.dist = (Vector3.new(info.center.X, cam.Y, info.center.Z) - cam).Magnitude
	end
	local snap = c.snapshot
	c.effects = not (snap and snap.settings and snap.settings.effects == false)
	c.flock = if snap and snap.settings and type(snap.settings.flock) == "string" then snap.settings.flock else "normal"
	FlockView.Replan(c)
	Vehicles.Replan(c)
	Workers.Replan(c)
end

function Visuals.Start(Store: any)
	if ctx then
		return
	end
	local player = Players.LocalPlayer
	local container = Instance.new("Folder")
	container.Name = "FarmVisuals"
	container.Parent = Workspace
	Rig.SetContainer(container)
	Rig.Register("chicken", Chicken.Build)
	Rig.Register("worker", WorkerModel.Build)
	Rig.Register("vehicle", VehicleModel.Build)
	Rig.Register("crate", function(_v: number)
		return Crate.Build(1)
	end)

	local c: Ctx = {
		Store = Store,
		player = player,
		container = container,
		plots = {},
		own = nil,
		snapshot = Store.Get(),
		elapsed = 0,
		effects = true,
		flock = "normal",
	}
	ctx = c
	Effects.Init(c)
	ThemeLighting.Init()

	local plotsFolder = Workspace:WaitForChild("Plots")
	local function watch(plot: Instance)
		if not plot:IsA("Model") then
			return
		end
		refreshPlot(c, plot)
		table.insert(connections, plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
			refreshPlot(c, plot)
			replan(c)
		end))
		for _, attr in { "HouseTiers", "VehicleTiers", "WorkerTiers", "Population" } do
			table.insert(connections, plot:GetAttributeChangedSignal(attr):Connect(function()
				if c.plots[plot] and not c.plots[plot].own then
					replan(c)
				end
			end))
		end
	end
	for _, p in plotsFolder:GetChildren() do
		watch(p)
	end
	table.insert(connections, plotsFolder.ChildAdded:Connect(watch))
	table.insert(connections, plotsFolder.ChildRemoved:Connect(function(p)
		if p:IsA("Model") and c.plots[p] then
			clearPlot(c, p)
		end
	end))

	table.insert(unsubs, Store.OnChanged(function(snap)
		c.snapshot = snap
		ThemeLighting.Apply(snap and snap.egg)
		Effects.OnSnapshot(snap)
		replan(c)
	end))

	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	local sinceReplan = 0
	table.insert(connections, RunService.Heartbeat:Connect(function(dt)
		local snap = c.snapshot
		c.elapsed = if snap and snap.serverNow then math.clamp(Store.Now() - snap.serverNow, 0, 3) else 0
		sinceReplan += dt
		if sinceReplan >= REPLAN_EVERY then
			sinceReplan = 0
			replan(c)
		end
		table.clear(parts)
		table.clear(cfs)
		FlockView.Update(dt, c, parts, cfs)
		Vehicles.Update(dt, c, parts, cfs)
		Workers.Update(dt, c, parts, cfs)
		Effects.Update(dt, c)
		if #parts > 0 then
			Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end))

	table.insert(connections, Players.PlayerRemoving:Connect(function(p)
		if p == player then
			Visuals.Stop()
		end
	end))
	replan(c)
end

function Visuals.Stop()
	local c = ctx
	if not c then
		return
	end
	ctx = nil
	for _, conn in connections do
		conn:Disconnect()
	end
	table.clear(connections)
	for _, u in unsubs do
		u()
	end
	table.clear(unsubs)
	for plot in table.clone(c.plots) do
		clearPlot(c, plot)
	end
	Effects.Destroy()
	ThemeLighting.Destroy()
	Rig.DestroyPools()
	c.container:Destroy()
end

return Visuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">Workers</string>
              <string name="Source"><![CDATA[--!strict
-- Workers walk between WorkerPath/Start (by the warehouse) and the collect ring of the house they
-- serve. Own plot: driven by snapshot.workers (t within cycle; first half walking to the house,
-- second half walking back carrying a crate when load > 0). Other plots (WorkerTiers attribute):
-- the same loop on a fixed clock, only within OTHER_RADIUS studs and re-posed at 10 Hz.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared:WaitForChild("Logic"):WaitForChild("PlotLayout"))
local WorkerData = require(Shared:WaitForChild("Data"):WaitForChild("Workers"))
local Rig = require(script.Parent:WaitForChild("Rig"))
local FlockView = require(script.Parent:WaitForChild("FlockView"))

local Workers = {}

local OTHER_RADIUS = 220
local OTHER_INTERVAL = 0.1
local SLOTS = WorkerData.MaxSlots

type Slot = { rig: Rig.Rig?, crate: Rig.Rig?, tier: number }
type View = { slots: { Slot }, own: boolean, acc: number, houses: { number } }

local views: { [Model]: View } = {}
local routes: { [number]: { [number]: { Layout.Vec } } } = {} -- [slot][house] -> lane-shifted route
local clock = 0

local function route(slot: number, house: number): ({ Layout.Vec }, number)
	local bySlot = routes[slot]
	if not bySlot then
		bySlot = {}
		routes[slot] = bySlot
	end
	assert(bySlot)
	local cached = bySlot[house]
	if cached then
		return cached, Layout.PolyLength(cached)
	end
	-- spread workers over small lane offsets so they don't walk inside each other
	local shift = ((slot - 1) % 4 - 1.5) * 1.3
	local base = Layout.WorkerRoute(house)
	local r: { Layout.Vec } = {}
	for i, p in base do
		local last = i == #base
		r[i] = { x = p.x + (if last then 0 else shift), y = 0, z = p.z + (if last then shift else 0) }
	end
	bySlot[house] = r
	return r, Layout.PolyLength(r)
end

local function releaseSlot(s: Slot)
	if s.rig then
		Rig.Release(s.rig)
		s.rig = nil
	end
	if s.crate then
		Rig.Release(s.crate)
		s.crate = nil
	end
	s.tier = 0
end

function Workers.ClearPlot(plot: Model)
	local v = views[plot]
	if v then
		for _, s in v.slots do
			releaseSlot(s)
		end
		views[plot] = nil
	end
end

function Workers.Replan(ctx: any)
	for plot in views do
		if not ctx.plots[plot] then
			Workers.ClearPlot(plot)
		end
	end
	local snap = ctx.snapshot
	for plot, info in ctx.plots do
		local tiers: { number }
		if info.own and snap and type(snap.workers) == "table" then
			tiers = {}
			for i = 1, SLOTS do
				local w = snap.workers[i]
				tiers[i] = if w then tonumber(w.tier) or 0 else 0
			end
		elseif not info.own and info.dist <= OTHER_RADIUS then
			tiers = FlockView.ParseTiers(plot:GetAttribute("WorkerTiers"), SLOTS)
		else
			tiers = table.create(SLOTS, 0)
		end
		local view = views[plot]
		if not view then
			local slots = {}
			for i = 1, SLOTS do
				slots[i] = { rig = nil, crate = nil, tier = 0 }
			end
			view = { slots = slots, own = info.own, acc = 0, houses = {} }
			views[plot] = view
		end
		assert(view)
		view.own = info.own
		-- houses that exist on this plot (other plots: workers rotate between them)
		local houseTiers = FlockView.ParseTiers(plot:GetAttribute("HouseTiers"), 4)
		table.clear(view.houses)
		for h, t in houseTiers do
			if t > 0 then
				table.insert(view.houses, h)
			end
		end
		for i, s in view.slots do
			local tier = math.clamp(tiers[i] or 0, 0, WorkerData.MaxTier)
			if tier ~= s.tier then
				releaseSlot(s)
				if tier > 0 then
					s.rig = Rig.Get("worker", tier)
					s.tier = tier
				end
			end
		end
	end
end

local angles: { [string]: number } = { legL = 0, legR = 0, armL = 0, armR = 0 }

local function pose(info: any, slot: number, s: Slot, house: number, f: number, back: boolean, loaded: boolean, parts: { BasePart }, cfs: { CFrame })
	local rig = s.rig
	if not rig then
		return
	end
	local r, len = route(slot, house)
	-- short pauses at both ends (picking up / dropping off) read better than constant walking
	local walkF = math.clamp((f - 0.08) / 0.84, 0, 1)
	local d = if back then (1 - walkF) * len else walkF * len
	local p, dir = Layout.PolyPoint(r, d)
	local fx, fz = dir.x, dir.z
	if back then
		fx, fz = -fx, -fz
	end
	local walking = walkF > 0 and walkF < 1
	local pos = Vector3.new(p.x, 0.1, p.z)
	local root = info.cf * CFrame.lookAt(pos, pos + Vector3.new(fx, 0, fz))
	local swing = if walking then math.sin(clock * 9 + slot) * 0.7 else 0
	if s.tier == 6 or s.tier == 8 then
		root *= CFrame.new(0, 0.4 + math.sin(clock * 3 + slot) * 0.2, 0) -- jetpack / star porter hover
		swing *= 0.4
	end
	if walking then
		root *= CFrame.new(0, math.abs(math.sin(clock * 9 + slot)) * 0.15, 0)
	end
	angles.legL, angles.legR = swing, -swing
	if loaded then
		angles.armL, angles.armR = 1.2, 1.2 -- arms raised forward, holding the crate
	else
		angles.armL, angles.armR = -swing * 0.8, swing * 0.8
	end
	Rig.Pose(rig, root, angles, parts, cfs)
	if loaded then
		if not s.crate then
			s.crate = Rig.Get("crate", 1)
		end
		local crate = s.crate
		assert(crate)
		local off = rig.attrs.CarryOffset
		Rig.Pose(crate, root * CFrame.new(if typeof(off) == "Vector3" then off else Vector3.new(0, 3, -1.5)), nil, parts, cfs)
	elseif s.crate then
		Rig.Release(s.crate)
		s.crate = nil
	end
end

function Workers.Update(dt: number, ctx: any, parts: { BasePart }, cfs: { CFrame })
	clock += dt
	local snap = ctx.snapshot
	for plot, view in views do
		local info = ctx.plots[plot]
		if not info then
			continue
		end
		if view.own and snap and type(snap.workers) == "table" then
			for i, s in view.slots do
				local w = snap.workers[i]
				if not s.rig or not w then
					continue
				end
				local cycle = tonumber(w.cycle) or 0
				if cycle <= 0 then
					local t = WorkerData.Tiers[s.tier]
					cycle = if t then t.cycle else 12
				end
				local half = cycle / 2
				local tt = ((tonumber(w.t) or 0) + ctx.elapsed) % cycle
				local house = math.clamp(math.floor(tonumber(w.house) or 1), 1, 4)
				local load = tonumber(w.load) or 0
				if tt < half then
					pose(info, i, s, house, tt / half, false, false, parts, cfs)
				else
					pose(info, i, s, house, (tt - half) / half, true, load > 0, parts, cfs)
				end
			end
		else
			view.acc += dt
			if view.acc < OTHER_INTERVAL then
				continue
			end
			view.acc = 0
			local nHouses = #view.houses
			for i, s in view.slots do
				if not s.rig then
					continue
				end
				local t = WorkerData.Tiers[s.tier]
				local cycle = if t then t.cycle else 12
				local half = cycle / 2
				local tt = (clock + i * 1.7) % cycle
				local lap = math.floor((clock + i * 1.7) / cycle)
				local house = if nHouses > 0 then view.houses[(lap + i) % nHouses + 1] else 1
				if tt < half then
					pose(info, i, s, house, tt / half, false, false, parts, cfs)
				else
					pose(info, i, s, house, (tt - half) / half, true, nHouses > 0, parts, cfs)
				end
			end
		end
	end
end

return Workers
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="123">
        <Properties>
          <string name="Name">TestClient</string>
        </Properties>
        <Item class="LocalScript" referent="124">
          <Properties>
            <string name="Name">DevPanel</string>
            <string name="Source"><![CDATA[--!nonstrict
-- TEST PLACE ONLY: a small developer panel (toggle with the "DEV" button or F8) that calls the
-- server's DevCommand remote. Lets a tester reach late-game states and exercise saves/checkout
-- without touching production balance. Not part of build/EggFarm.rbxlx.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("DevCommand", 30) :: RemoteFunction?
if not remote then
	return
end

local gui = Instance.new("ScreenGui")
gui.Name = "DevPanel"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
gui.Parent = player:WaitForChild("PlayerGui")

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.fromOffset(56, 28)
toggle.Position = UDim2.new(1, -64, 0, 6)
toggle.Text = "DEV"
toggle.Font = Enum.Font.GothamBlack
toggle.TextSize = 14
toggle.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
toggle.TextColor3 = Color3.fromRGB(255, 220, 80)
toggle.Parent = gui
Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 8)

local panel = Instance.new("ScrollingFrame")
panel.Visible = false
panel.Size = UDim2.fromOffset(220, 360)
panel.Position = UDim2.new(1, -228, 0, 40)
panel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
panel.BackgroundTransparency = 0.1
panel.AutomaticCanvasSize = Enum.AutomaticSize.Y
panel.CanvasSize = UDim2.new()
panel.ScrollBarThickness = 6
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)
local layout = Instance.new("UIListLayout", panel)
layout.Padding = UDim.new(0, 4)
local pad = Instance.new("UIPadding", panel)
pad.PaddingTop, pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 6)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 22)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(180, 255, 180)
status.Font = Enum.Font.GothamBold
status.TextSize = 12
status.Text = "TEST PLACE (memory saves)"
status.Parent = panel

local function button(label: string, cmd: string, arg: any?)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 30)
	b.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.Text = label
	b.Parent = panel
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	b.Activated:Connect(function()
		local r = remote:InvokeServer(cmd, arg)
		status.Text = if type(r) == "table" then tostring(r.message) else "?"
	end)
end

button("+ Cash", "cash")
button("+1000 Gold Eggs", "gold")
button("Finish tutorial", "tutorial")
button("Max current farm", "maxed")
for _, n in { 2, 5, 9, 10 } do
	button("Jump to egg " .. n, "egg", n)
end
button("All boosts x3", "boosts")
button("Quests ready", "quests")
button("Fast-forward 10 min", "forward", 600)
button("Simulate 2h offline", "offline", 7200)
button("Next UTC day", "nextday")
button("Spawn Lucky Fox", "fox")
button("Checkout: success", "checkout", "success")
button("Checkout: cancel", "checkout", "cancel")
button("Checkout: fail", "checkout", "fail")
button("Fail next load", "failload")
button("Fail next save", "failsave")
button("Reset my save", "reset")
button("Kick (test rejoin)", "rejoin")

local function flip()
	panel.Visible = not panel.Visible
end
toggle.Activated:Connect(flip)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.F8 then
		flip()
	end
end)
