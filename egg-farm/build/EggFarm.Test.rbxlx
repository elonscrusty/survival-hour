      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Contract</string>
          <string name="Source"><![CDATA[--!strict
-- Action names, which of them a client may send, and result codes with player-facing text.
-- "collect", "deposit" and "catchFox" are physical interactions: the server triggers them itself
-- after checking where the player's character actually is, so they are not client actions.

local Contract = {}

Contract.ClientActions = {
	spawn = true,
	setAutoSpawn = true,
	buyHouse = true,
	upgradeHouse = true,
	buyVehicle = true,
	upgradeVehicle = true,
	hireWorker = true,
	upgradeWorker = true,
	buildSilo = true,
	buyCommon = true,
	buyEpic = true,
	rebirth = true,
	skip = true,
	prestige = true,
	useBoost = true,
	claimQuest = true,
	claimDaily = true,
	claimGift = true,
	claimAllGifts = true,
	redeemCode = true,
	buyGoldItem = true,
	setSetting = true,
	claimOffline = true,
}

Contract.Messages = {
	ok = "Done!",
	invalid = "That request wasn't valid.",
	stale = "That changed a moment ago. Try again.",
	cant_afford = "Not enough money yet!",
	cant_afford_gold = "Not enough Gold Eggs!",
	locked = "Unlocks on a later egg.",
	max_level = "Already at max level!",
	full = "Housing is full! Upgrade your houses.",
	basket_full = "Your basket is full! Deposit at the warehouse.",
	empty = "Nothing to collect yet.",
	nothing_carried = "You aren't carrying any eggs.",
	not_ready = "Not ready yet.",
	already = "Already claimed!",
	slot_taken = "That slot is already in use.",
	slot_locked = "Buy the slot before it first.",
	tutorial = "Finish the tutorial first!",
	code_invalid = "That code doesn't exist.",
	code_used = "You already redeemed that code!",
	code_expired = "That code has expired.",
	code_ok = "Code redeemed!",
	boost_limit = "Too many boosts active at once!",
	no_boost = "You don't have that boost.",
	rate_limited = "Slow down a little!",
	not_configured = "This item isn't for sale yet.",
	no_silos = "Build a silo to earn while you're away.",
	not_requirement = "Your Farm Value isn't high enough yet.",
	skip_too_early = "Reach at least 25% of the Farm Value goal to skip.",
	last_egg = "This is the last egg. Prestige instead!",
	not_last_egg = "Prestige unlocks on the last egg.",
}

Contract.Settings = {
	music = "boolean",
	sfx = "boolean",
	autoSpawn = "boolean",
	effects = "boolean",
	confirmSpend = "boolean",
	flock = { "low", "normal", "high" },
	notation = { "short", "scientific" },
}

-- Tutorial steps (server decides when each is done; see Logic/Tutorial.luau).
Contract.Tutorial = {
	{ key = "spawn", text = "Tap SPAWN to hatch 20 chickens!" },
	{ key = "collect", text = "Walk into the glowing ring at your coop to collect eggs." },
	{ key = "deposit", text = "Carry the eggs to the warehouse ring to deposit them." },
	{ key = "sell", text = "Your vehicle will sell these eggs to give you cash. Watch it go!" },
	{ key = "vehicle", text = "Upgrade your vehicle to sell eggs faster. Open SHIPPING at the dock." },
	{ key = "earn", text = "Keep the eggs flowing until you have $500." },
	{ key = "housing", text = "Increase your housing! Open HOUSING at a coop and upgrade it." },
}

return Contract
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="4">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Boosts</string>
            <string name="Source"><![CDATA[--!strict
-- Boost potions. The reference REPORTS boosts such as 3x Earnings for 20 min, 10x Internal
-- Hatchery for 10 min, 10x Earnings, 50x Earnings for 2 h, "2x All Active Boosts", and a limit of
-- 5 active boosts with VIP. Which boosts exist here and their sizes are DESIGN VALUES.
-- Rules (design, tested in Boosts.spec): boosts run on server real time (they keep counting while
-- offline); using a boost that is already active adds its duration (capped); different boosts
-- multiply; "Boost Booster" doubles the bonus part of every other active boost.

export type Boost = {
	id: string,
	name: string,
	desc: string,
	icon: string,
	stat: string, -- "earn" | "lay" | "hatch" | "booster"
	mult: number,
	duration: number, -- seconds
}

local list: { Boost } = {
	{ id = "earn3", name = "Cash x3", desc = "Triple cash from sales for 20 min", icon = "cash", stat = "earn", mult = 3, duration = 20 * 60 },
	{ id = "earn10", name = "Cash x10", desc = "10x cash from sales for 10 min", icon = "cash", stat = "earn", mult = 10, duration = 10 * 60 },
	{ id = "lay2", name = "Laying x2", desc = "Chickens lay twice as fast for 15 min", icon = "feed", stat = "lay", mult = 2, duration = 15 * 60 },
	{ id = "hatch10", name = "Hatchery x10", desc = "Coop Hatchery 10x faster for 10 min", icon = "hatch", stat = "hatch", mult = 10, duration = 10 * 60 },
	{ id = "booster", name = "Boost Booster", desc = "Doubles every other active boost for 10 min", icon = "booster", stat = "booster", mult = 2, duration = 10 * 60 },
}

local byId: { [string]: Boost } = {}
for _, b in list do
	byId[b.id] = b
end

return {
	List = list,
	ById = byId,
	MaxActive = 3,
	MaxActiveVip = 5,
	MaxDuration = 6 * 3600, -- one boost can be stacked up to 6 hours
	MaxInventory = 999,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--!strict
-- Egg progression. Each egg is one "farm": REBIRTH moves to the next egg and starts a new farm.
-- STRUCTURE follows the reference (a starting egg plus 9 unlockable eggs, each with its own farm
-- theme, unlocked by Farm Value). NAMES, THEMES AND ALL NUMBERS ARE ORIGINAL DESIGN VALUES:
-- the reference's egg values, thresholds and formulas are unknown (docs/REFERENCE_COVERAGE.md).

export type Egg = {
	id: string,
	name: string,
	theme: string, -- key into Data/Themes
	value: number, -- cash per egg sold, before multipliers
	costScale: number, -- every cash price on this farm is multiplied by this
	requirement: number, -- Farm Value needed to REBIRTH into the next egg (or PRESTIGE on the last)
	rebirthGold: number, -- Gold Eggs granted when you rebirth INTO this egg
}

local VALUE_STEP = 40 -- each egg sells for 40x the previous one
local COST_STEP = 30 -- prices grow 30x per egg (values grow 40x), so each new farm earns faster
-- Farm Value needed to leave each farm. Tuned with tools/sim.luau (a plain greedy player with no
-- boosts or passes) so each farm takes a little longer than the last: ~20 min for the first,
-- growing ~5 min per egg. DESIGN VALUES.
local REQUIREMENTS = { 1e5, 3e7, 2.5e11, 1e14, 7e15, 1.2e18, 7e19, 6e21, 3e23, 1.5e25 }

local defs = {
	{ "farm", "Farm Egg", "meadow" },
	{ "clover", "Clover Egg", "clover" },
	{ "honey", "Honey Egg", "honey" },
	{ "seashell", "Seashell Egg", "beach" },
	{ "frost", "Frost Egg", "snow" },
	{ "cactus", "Cactus Egg", "desert" },
	{ "magma", "Magma Egg", "volcano" },
	{ "crystal", "Crystal Egg", "crystal" },
	{ "nebula", "Nebula Egg", "space" },
	{ "sunburst", "Sunburst Egg", "golden" },
}

local list: { Egg } = {}
for i, d in defs do
	list[i] = {
		id = d[1],
		name = d[2],
		theme = d[3],
		value = VALUE_STEP ^ (i - 1),
		costScale = COST_STEP ^ (i - 1),
		requirement = REQUIREMENTS[i],
		rebirthGold = if i == 1 then 0 else 15 * i,
	}
end

return {
	List = list,
	Count = #list,
	VALUE_STEP = VALUE_STEP,
	COST_STEP = COST_STEP,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Housing</string>
            <string name="Source"><![CDATA[--!strict
-- Housing: owned slots on each farm, each upgraded through tiers. A house holds chickens
-- (capacity) and stores the eggs they lay until the player (or a worker) collects them.
-- STRUCTURE from the reference (several plots, each upgradeable through named tiers).
-- NAMES AND NUMBERS ARE ORIGINAL DESIGN VALUES. The historical "Shack 250 / Super Shack 500 /
-- Long House 1,000 / Barn 2,000" figures could not be confirmed for the reference and are NOT used.
-- Cash prices are multiplied by the current egg's costScale.

export type Tier = {
	name: string,
	capacity: number, -- chickens
	cost: number, -- price to upgrade INTO this tier (tier 1 comes with the slot)
	unlockEgg: number, -- egg index needed before this tier can be bought
}

local tiers: { Tier } = {
	{ name = "Little Coop", capacity = 100, cost = 0, unlockEgg = 1 },
	{ name = "Twin Coop", capacity = 250, cost = 250, unlockEgg = 1 },
	{ name = "Hen House", capacity = 600, cost = 2500, unlockEgg = 1 },
	{ name = "Red Barn", capacity = 1500, cost = 18000, unlockEgg = 1 },
	{ name = "Big Barn", capacity = 4000, cost = 120000, unlockEgg = 2 },
	{ name = "Poultry Hall", capacity = 10000, cost = 800000, unlockEgg = 3 },
	{ name = "Egg Factory", capacity = 25000, cost = 5e6, unlockEgg = 4 },
	{ name = "Hen Tower", capacity = 60000, cost = 3e7, unlockEgg = 5 },
	{ name = "Sky Roost", capacity = 150000, cost = 2e8, unlockEgg = 7 },
	{ name = "Mega Dome", capacity = 400000, cost = 1.2e9, unlockEgg = 9 },
}

return {
	Tiers = tiers,
	MaxTier = #tiers,
	Slots = 4,
	-- price of buying slot n (slot 1 is free and owned from the start)
	SlotCost = { 0, 400, 6000, 60000 },
	StoragePerChicken = 8, -- eggs a house can hold per chicken of capacity, before upgrades
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
-- Shop catalog: this game's OWN products. Robux IDs are deliberately empty (nil): live commerce is
-- NOT configured. Fill in `robuxId` with your own game pass / developer product IDs after you
-- create them on the Creator Dashboard (README "Setting up the shop"). Never reuse another game's IDs.
-- Pass roles mirror reference pass categories (docs/REFERENCE_RESEARCH.md section 10); names,
-- prices and effects are DESIGN VALUES.
--
-- kind = "pass" (one-time, permanent) | "product" (consumable) | "gold" (buy with Gold Eggs)
-- tab  = "Featured" | "Passes" | "Gold" | "Cash"

export type Product = {
	id: string,
	kind: string,
	tab: string,
	name: string,
	desc: string,
	icon: string,
	robux: number?, -- display price for Robux items
	robuxId: number?, -- YOUR game pass / developer product id (nil = not configured)
	goldPrice: number?, -- price in Gold Eggs for kind = "gold"
	grant: { gold: number?, cashMinutes: number?, boosts: { [string]: number }?, pass: string? },
	featured: boolean?,
}

local list: { Product } = {
	-- Passes (permanent)
	{ id = "vip", kind = "pass", tab = "Passes", name = "VIP", desc = "Use 5 boosts at once and get a VIP chat tag", icon = "crown", robux = 249, grant = { pass = "vip" }, featured = true },
	{ id = "x2cash", kind = "pass", tab = "Passes", name = "x2 Cash", desc = "Double cash from every sale", icon = "cash", robux = 249, grant = { pass = "x2cash" }, featured = true },
	{ id = "x2chickens", kind = "pass", tab = "Passes", name = "x2 Chickens", desc = "Every spawn gives twice the chickens", icon = "chick", robux = 199, grant = { pass = "x2chickens" } },
	{ id = "x2gold", kind = "pass", tab = "Passes", name = "x2 Gold Eggs", desc = "Double Gold Eggs from quests, gifts and rebirths", icon = "gold", robux = 199, grant = { pass = "x2gold" } },
	{ id = "x2offline", kind = "pass", tab = "Passes", name = "x2 Offline Earnings", desc = "Silos earn twice as much while you're away", icon = "silo", robux = 79, grant = { pass = "x2offline" } },
	{ id = "cheap_upgrades", kind = "pass", tab = "Passes", name = "Cheap Upgrades", desc = "Common upgrades cost 50% less", icon = "lab", robux = 299, grant = { pass = "cheap_upgrades" } },
	{ id = "perma_silos", kind = "pass", tab = "Passes", name = "10 Permanent Silos", desc = "10 silos that survive every rebirth", icon = "silo", robux = 249, grant = { pass = "perma_silos" } },
	{ id = "worker_slots", kind = "pass", tab = "Passes", name = "+2 Worker Slots", desc = "Hire two extra workers", icon = "worker", robux = 349, grant = { pass = "worker_slots" } },
	{ id = "x2housing", kind = "pass", tab = "Passes", name = "x2 Housing Capacity", desc = "Every house holds twice the chickens", icon = "house", robux = 349, grant = { pass = "x2housing" } },
	{ id = "x2shipping", kind = "pass", tab = "Passes", name = "x2 Shipping Speed", desc = "Vehicles finish trips twice as fast", icon = "truck", robux = 199, grant = { pass = "x2shipping" } },
	{ id = "x2workers", kind = "pass", tab = "Passes", name = "x2 Worker Capacity", desc = "Workers carry twice the eggs", icon = "worker", robux = 249, grant = { pass = "x2workers" } },
	-- Gold Egg packs (Robux)
	{ id = "gold_small", kind = "product", tab = "Gold", name = "Handful of Gold Eggs", desc = "50 Gold Eggs", icon = "gold", robux = 49, grant = { gold = 50 } },
	{ id = "gold_medium", kind = "product", tab = "Gold", name = "Basket of Gold Eggs", desc = "275 Gold Eggs", icon = "gold", robux = 199, grant = { gold = 275 }, featured = true },
	{ id = "gold_large", kind = "product", tab = "Gold", name = "Crate of Gold Eggs", desc = "800 Gold Eggs", icon = "gold", robux = 499, grant = { gold = 800 } },
	-- Cash packs (Robux): scale with your farm's steady cash rate
	{ id = "cash_small", kind = "product", tab = "Cash", name = "Stack of Cash", desc = "30 minutes of farm earnings", icon = "cash", robux = 29, grant = { cashMinutes = 30 } },
	{ id = "cash_medium", kind = "product", tab = "Cash", name = "Bag of Cash", desc = "3 hours of farm earnings", icon = "cash", robux = 99, grant = { cashMinutes = 180 } },
	{ id = "cash_large", kind = "product", tab = "Cash", name = "Vault of Cash", desc = "12 hours of farm earnings", icon = "cash", robux = 299, grant = { cashMinutes = 720 } },
	-- Boosts for Gold Eggs (the Boosts menu SHOP tab and the Featured tab)
	{ id = "buy_earn3", kind = "gold", tab = "Featured", name = "Cash x3 Boost", desc = "20 min of triple cash", icon = "cash", goldPrice = 20, grant = { boosts = { earn3 = 1 } } },
	{ id = "buy_lay2", kind = "gold", tab = "Featured", name = "Laying x2 Boost", desc = "15 min of double laying", icon = "feed", goldPrice = 15, grant = { boosts = { lay2 = 1 } } },
	{ id = "buy_hatch10", kind = "gold", tab = "Featured", name = "Hatchery x10 Boost", desc = "10 min of 10x hatching", icon = "hatch", goldPrice = 15, grant = { boosts = { hatch10 = 1 } } },
	{ id = "buy_earn10", kind = "gold", tab = "Featured", name = "Cash x10 Boost", desc = "10 min of 10x cash", icon = "cash", goldPrice = 60, grant = { boosts = { earn10 = 1 } } },
	{ id = "buy_booster", kind = "gold", tab = "Featured", name = "Boost Booster", desc = "Doubles your other boosts for 10 min", icon = "booster", goldPrice = 45, grant = { boosts = { booster = 1 } } },
}

local byId: { [string]: Product } = {}
for _, p in list do
	byId[p.id] = p
end

return {
	List = list,
	ById = byId,
	Tabs = { "Featured", "Passes", "Gold", "Cash" },
	TabLabels = { Featured = "Featured", Passes = "Passes", Gold = "Gold Eggs", Cash = "Cash" },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Quests, daily rewards and playtime gifts. The reference REPORTS quests with Gold Egg rewards,
-- daily/playtime "gift ready" rewards with Claim All. Lists, targets and rewards here are
-- DESIGN VALUES. All timing uses the server clock (UTC day = floor(serverTime / 86400)).
--
-- A Reward is { gold = n?, cashMinutes = n?, boosts = { [boostId] = count }? }.
-- cashMinutes pays that many minutes of the farm's steady cash rate (at least $100 x egg value),
-- so a reward stays useful on every farm.

export type Reward = { gold: number?, cashMinutes: number?, boosts: { [string]: number }? }
export type Quest = { id: string, text: string, stat: string, target: number, reward: Reward }

local questPool: { Quest } = {
	{ id = "spawn_200", text = "Spawn 200 chickens", stat = "spawned", target = 200, reward = { gold = 5 } },
	{ id = "spawn_1000", text = "Spawn 1,000 chickens", stat = "spawned", target = 1000, reward = { gold = 10 } },
	{ id = "collect_500", text = "Collect 500 eggs from houses", stat = "collected", target = 500, reward = { gold = 5 } },
	{ id = "collect_5000", text = "Collect 5,000 eggs from houses", stat = "collected", target = 5000, reward = { gold = 10, boosts = { lay2 = 1 } } },
	{ id = "deposit_1000", text = "Deposit 1,000 eggs at the warehouse", stat = "deposited", target = 1000, reward = { gold = 8 } },
	{ id = "sell_2000", text = "Sell 2,000 eggs", stat = "sold", target = 2000, reward = { cashMinutes = 5 } },
	{ id = "sell_20000", text = "Sell 20,000 eggs", stat = "sold", target = 20000, reward = { gold = 15 } },
	{ id = "upgrade_5", text = "Buy 5 upgrades", stat = "upgrades", target = 5, reward = { gold = 8 } },
	{ id = "upgrade_15", text = "Buy 15 upgrades", stat = "upgrades", target = 15, reward = { boosts = { earn3 = 1 } } },
	{ id = "play_15", text = "Play for 15 minutes", stat = "playtime", target = 15 * 60, reward = { gold = 10 } },
	{ id = "boost_1", text = "Use a boost", stat = "boostsUsed", target = 1, reward = { gold = 5 } },
	{ id = "fox_1", text = "Catch the Lucky Fox", stat = "foxes", target = 1, reward = { gold = 6 } },
}

-- Each UTC day shows QuestsPerDay quests, picked by rotating through the pool.
local QuestsPerDay = 5

local daily: { Reward } = { -- day 1..7 of a streak; day 7 repeats after that
	{ gold = 5 },
	{ cashMinutes = 10 },
	{ gold = 10 },
	{ boosts = { earn3 = 1 } },
	{ gold = 15 },
	{ boosts = { lay2 = 1, hatch10 = 1 } },
	{ gold = 30, boosts = { earn10 = 1 } },
}

local gifts: { { minutes: number, reward: Reward } } = { -- playtime today
	{ minutes = 3, reward = { gold = 2 } },
	{ minutes = 8, reward = { cashMinutes = 3 } },
	{ minutes = 15, reward = { gold = 4 } },
	{ minutes = 25, reward = { boosts = { lay2 = 1 } } },
	{ minutes = 40, reward = { gold = 8 } },
	{ minutes = 60, reward = { boosts = { earn3 = 1 } } },
}

return {
	QuestPool = questPool,
	QuestsPerDay = QuestsPerDay,
	Daily = daily,
	Gifts = gifts,
	MinCashReward = 100, -- x egg value
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Silos</string>
            <string name="Source"><![CDATA[--!strict
-- Silos store earnings while the player is away (offline earnings). The reference's UI text
-- "Silos allow you to earn while you're away" and the "10 Permanent Silos" pass confirm the role;
-- that normal silos reset on rebirth is INFERRED from that pass. Numbers are DESIGN VALUES.

return {
	Max = 10,
	BaseCost = 5000, -- x egg costScale, x CostGrowth per silo already built
	CostGrowth = 2.2,
	MinutesPerSilo = 30, -- offline time covered by each silo (Epic upgrade adds more)
	OfflineRate = 0.5, -- fraction of the farm's steady cash rate earned while away
	MinAwaySeconds = 60, -- shorter absences pay nothing
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Themes</string>
            <string name="Source"><![CDATA[--!strict
-- Farm themes, one per egg. Colours are RGB 0-255 (shared code cannot use Color3 in tests).
-- The palette keeps the same grass/wood/roof structure across themes so every farm reads as the
-- same low-poly world: ground, path, wood, roof, accent, sky tint, decoration kind.

export type Theme = {
	name: string,
	ground: { number },
	groundEdge: { number },
	path: { number },
	wood: { number },
	roof: { number },
	accent: { number },
	fog: { number },
	ambient: { number },
	decor: string, -- "trees" | "clover" | "hives" | "palms" | "pines" | "cacti" | "rocks" | "crystals" | "orbs" | "spires"
}

return {
	meadow = { name = "Sunny Meadow", ground = { 108, 186, 82 }, groundEdge = { 86, 158, 66 }, path = { 214, 186, 132 }, wood = { 168, 112, 70 }, roof = { 206, 64, 52 }, accent = { 255, 214, 74 }, fog = { 196, 228, 255 }, ambient = { 128, 128, 140 }, decor = "trees" },
	clover = { name = "Clover Hills", ground = { 76, 176, 96 }, groundEdge = { 58, 146, 78 }, path = { 222, 200, 150 }, wood = { 150, 104, 72 }, roof = { 46, 140, 92 }, accent = { 255, 255, 255 }, fog = { 200, 240, 220 }, ambient = { 120, 140, 128 }, decor = "clover" },
	honey = { name = "Honey Grove", ground = { 150, 182, 70 }, groundEdge = { 124, 156, 58 }, path = { 232, 196, 110 }, wood = { 160, 100, 52 }, roof = { 236, 160, 36 }, accent = { 255, 196, 40 }, fog = { 255, 236, 190 }, ambient = { 150, 136, 110 }, decor = "hives" },
	beach = { name = "Seashell Shore", ground = { 236, 214, 156 }, groundEdge = { 218, 192, 132 }, path = { 250, 236, 200 }, wood = { 186, 140, 96 }, roof = { 54, 170, 196 }, accent = { 255, 120, 110 }, fog = { 190, 236, 255 }, ambient = { 140, 150, 160 }, decor = "palms" },
	snow = { name = "Frosty Peaks", ground = { 234, 242, 250 }, groundEdge = { 206, 220, 236 }, path = { 170, 196, 220 }, wood = { 132, 96, 72 }, roof = { 70, 120, 200 }, accent = { 140, 220, 255 }, fog = { 220, 232, 250 }, ambient = { 150, 160, 180 }, decor = "pines" },
	desert = { name = "Cactus Mesa", ground = { 226, 168, 104 }, groundEdge = { 200, 140, 84 }, path = { 246, 214, 160 }, wood = { 150, 94, 60 }, roof = { 196, 84, 52 }, accent = { 90, 170, 90 }, fog = { 255, 222, 180 }, ambient = { 160, 136, 110 }, decor = "cacti" },
	volcano = { name = "Magma Ridge", ground = { 82, 72, 72 }, groundEdge = { 60, 52, 54 }, path = { 140, 110, 100 }, wood = { 96, 70, 60 }, roof = { 220, 80, 30 }, accent = { 255, 140, 40 }, fog = { 120, 90, 80 }, ambient = { 140, 100, 90 }, decor = "rocks" },
	crystal = { name = "Crystal Caverns", ground = { 120, 96, 170 }, groundEdge = { 96, 74, 146 }, path = { 196, 180, 236 }, wood = { 110, 90, 130 }, roof = { 80, 200, 220 }, accent = { 200, 120, 255 }, fog = { 170, 150, 220 }, ambient = { 130, 120, 170 }, decor = "crystals" },
	space = { name = "Nebula Fields", ground = { 52, 58, 96 }, groundEdge = { 40, 44, 76 }, path = { 120, 130, 190 }, wood = { 90, 96, 130 }, roof = { 230, 90, 200 }, accent = { 120, 240, 255 }, fog = { 40, 40, 80 }, ambient = { 110, 110, 160 }, decor = "orbs" },
	golden = { name = "Sunburst Kingdom", ground = { 246, 210, 96 }, groundEdge = { 224, 184, 70 }, path = { 255, 240, 196 }, wood = { 176, 120, 60 }, roof = { 255, 255, 255 }, accent = { 255, 170, 30 }, fog = { 255, 236, 180 }, ambient = { 170, 150, 110 }, decor = "spires" },
} :: { [string]: Theme }
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--!strict
-- Upgrades ("research"). COMMON upgrades cost Cash and reset on rebirth; EPIC upgrades cost
-- Gold Eggs and are kept forever. Both groups and the reset rule are REPORTED for the reference
-- (docs/REFERENCE_RESEARCH.md section 8); several roles are named after reported upgrades
-- (laying rate, egg value, house extension, internal hatchery, fleet size, auto clicker,
-- lab discount, silo capacity). NAMES, EFFECT SIZES, PRICES AND LEVEL CAPS ARE DESIGN VALUES.
--
-- price(level) = base * growth ^ level   (level = levels already owned; Common also x costScale)
-- `stat` is the modifier the upgrade feeds (see Logic/Modifiers.luau); `per` is the amount per level.

export type Upgrade = {
	id: string,
	name: string,
	desc: string,
	icon: string,
	stat: string,
	per: number,
	max: number,
	base: number,
	growth: number,
	unlockEgg: number,
}

local common: { Upgrade } = {
	{ id = "feed", name = "Premium Feed", desc = "+10% laying rate per level", icon = "feed", stat = "layPct", per = 0.10, max = 25, base = 60, growth = 1.45, unlockEgg = 1 },
	{ id = "polish", name = "Polished Shells", desc = "+25% egg value per level", icon = "shine", stat = "valuePct", per = 0.25, max = 25, base = 120, growth = 1.5, unlockEgg = 1 },
	{ id = "basket", name = "Bigger Basket", desc = "Carry twice as many eggs per level", icon = "basket", stat = "carryMul", per = 2, max = 12, base = 80, growth = 2.6, unlockEgg = 1 },
	{ id = "nestbox", name = "Roomy Nest Boxes", desc = "+50% egg storage in every house", icon = "nest", stat = "storagePct", per = 0.5, max = 15, base = 150, growth = 2.0, unlockEgg = 1 },
	{ id = "hatchery", name = "Coop Hatchery", desc = "Each house hatches +2 chickens/min", icon = "hatch", stat = "hatchPerHouse", per = 2 / 60, max = 20, base = 300, growth = 1.7, unlockEgg = 1 },
	{ id = "spawner", name = "Bigger Clutch", desc = "+1 chicken per Spawn tap", icon = "chick", stat = "spawnPerTap", per = 1, max = 9, base = 500, growth = 3.2, unlockEgg = 1 },
	{ id = "extension", name = "House Extension", desc = "+5% housing capacity per level", icon = "house", stat = "capacityPct", per = 0.05, max = 20, base = 2000, growth = 1.9, unlockEgg = 1 },
	{ id = "loading", name = "Quick Loading", desc = "-5% vehicle trip time per level", icon = "clock", stat = "tripPct", per = 0.05, max = 8, base = 1500, growth = 2.2, unlockEgg = 1 },
	{ id = "training", name = "Worker Training", desc = "+25% worker carry per level", icon = "worker", stat = "workerPct", per = 0.25, max = 12, base = 2500, growth = 2.1, unlockEgg = 1 },
	{ id = "fleet", name = "Fleet Permit", desc = "+1 vehicle slot", icon = "truck", stat = "vehicleSlots", per = 1, max = 4, base = 25000, growth = 12, unlockEgg = 1 },
	{ id = "bunkhouse", name = "Bunkhouse", desc = "+1 worker slot", icon = "bunk", stat = "workerSlots", per = 1, max = 4, base = 40000, growth = 10, unlockEgg = 2 },
	{ id = "shoes", name = "Running Boots", desc = "+6% walk speed per level", icon = "boot", stat = "speedPct", per = 0.06, max = 5, base = 1000, growth = 3, unlockEgg = 1 },
	{ id = "golden_yolk", name = "Golden Yolk", desc = "Double egg value", icon = "yolk", stat = "valueMul", per = 2, max = 1, base = 500000, growth = 1, unlockEgg = 2 },
	{ id = "super_nest", name = "Super Nest", desc = "+15% laying rate and egg value", icon = "star", stat = "layValuePct", per = 0.15, max = 10, base = 2e6, growth = 2.5, unlockEgg = 4 },
}

local epic: { Upgrade } = {
	{ id = "auto_clicker", name = "Auto Clicker", desc = "Auto Spawn +1 chicken/sec per level", icon = "auto", stat = "autoSpawnRate", per = 1, max = 20, base = 25, growth = 1.5, unlockEgg = 1 },
	{ id = "golden_touch", name = "Golden Touch", desc = "+10% egg value per level (kept forever)", icon = "shine", stat = "epicValuePct", per = 0.10, max = 50, base = 15, growth = 1.25, unlockEgg = 1 },
	{ id = "hen_whisperer", name = "Hen Whisperer", desc = "+10% laying rate per level (kept forever)", icon = "feed", stat = "epicLayPct", per = 0.10, max = 50, base = 15, growth = 1.25, unlockEgg = 1 },
	{ id = "hatch_overdrive", name = "Hatch Overdrive", desc = "+50% Coop Hatchery speed per level", icon = "hatch", stat = "hatchPct", per = 0.5, max = 10, base = 30, growth = 1.6, unlockEgg = 1 },
	{ id = "lab_discount", name = "Lab Discount", desc = "-4% Common upgrade prices per level", icon = "lab", stat = "commonDiscount", per = 0.04, max = 10, base = 40, growth = 1.7, unlockEgg = 1 },
	{ id = "silo_capacity", name = "Silo Capacity", desc = "+15 min offline time per silo per level", icon = "silo", stat = "siloMinutes", per = 15, max = 8, base = 35, growth = 1.8, unlockEgg = 1 },
	{ id = "combo_master", name = "Combo Master", desc = "+1 max Cash Multiplier per level", icon = "combo", stat = "comboMax", per = 1, max = 10, base = 50, growth = 1.6, unlockEgg = 1 },
	{ id = "pack_mule", name = "Pack Mule", desc = "+50% carry capacity per level", icon = "basket", stat = "epicCarryPct", per = 0.5, max = 10, base = 20, growth = 1.5, unlockEgg = 1 },
}

local byId: { [string]: Upgrade } = {}
for _, u in common do
	byId[u.id] = u
end
for _, u in epic do
	byId[u.id] = u
end

return {
	Common = common,
	Epic = epic,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[--!strict
-- Shipping vehicles. Each owned vehicle loads eggs from the warehouse (shipping stock), drives
-- off the farm, sells the load at the market and returns. The reference confirms the flow
-- ("Your vehicle will sell these eggs to give you cash", fleet slots, fleet-size upgrade).
-- NAMES AND NUMBERS ARE ORIGINAL DESIGN VALUES. Cash prices x egg costScale.

export type Tier = {
	name: string,
	capacity: number, -- eggs per trip
	trip: number, -- seconds for a full round trip (sale happens halfway)
	cost: number, -- price to upgrade INTO this tier (buying a slot gives tier 1)
	unlockEgg: number,
}

local tiers: { Tier } = {
	{ name = "Farm Pickup", capacity = 40, trip = 10, cost = 0, unlockEgg = 1 },
	{ name = "Delivery Van", capacity = 120, trip = 10, cost = 300, unlockEgg = 1 },
	{ name = "Box Truck", capacity = 400, trip = 12, cost = 3500, unlockEgg = 1 },
	{ name = "Egg Hauler", capacity = 1500, trip = 12, cost = 40000, unlockEgg = 1 },
	{ name = "Double Trailer", capacity = 5000, trip = 14, cost = 400000, unlockEgg = 2 },
	{ name = "Road Train", capacity = 18000, trip = 14, cost = 4e6, unlockEgg = 4 },
	{ name = "Hover Freighter", capacity = 60000, trip = 12, cost = 4e7, unlockEgg = 6 },
	{ name = "Sky Barge", capacity = 200000, trip = 12, cost = 4e8, unlockEgg = 8 },
}

return {
	Tiers = tiers,
	MaxTier = #tiers,
	BaseSlots = 4, -- slots available without upgrades (the Fleet Permit upgrade adds more)
	MaxSlots = 8,
	SlotCost = { 0, 600, 8000, 90000, 900000, 9e6, 9e7, 9e8 },
	LoadWait = 3, -- seconds a vehicle waits at the dock for a fuller load before leaving
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Workers</string>
            <string name="Source"><![CDATA[--!strict
-- Workers walk between the houses and the warehouse, carrying eggs automatically.
-- The reference confirms the role ("hire workers to move eggs automatically") and named tiers.
-- NAMES AND NUMBERS ARE ORIGINAL DESIGN VALUES. Cash prices x egg costScale.

export type Tier = {
	name: string,
	carry: number, -- eggs per trip
	cycle: number, -- seconds per round trip (pick-up halfway, drop-off at the end)
	cost: number, -- price to upgrade INTO this tier (hiring gives tier 1)
	unlockEgg: number,
}

local tiers: { Tier } = {
	{ name = "Farmhand", carry = 25, cycle = 12, cost = 0, unlockEgg = 1 },
	{ name = "Egg Runner", carry = 80, cycle = 12, cost = 2000, unlockEgg = 1 },
	{ name = "Rancher", carry = 250, cycle = 12, cost = 20000, unlockEgg = 1 },
	{ name = "Foreman", carry = 800, cycle = 12, cost = 250000, unlockEgg = 2 },
	{ name = "Robo Picker", carry = 3000, cycle = 10, cost = 2.5e6, unlockEgg = 3 },
	{ name = "Jet Courier", carry = 10000, cycle = 10, cost = 2.5e7, unlockEgg = 5 },
	{ name = "Mech Hauler", carry = 35000, cycle = 10, cost = 2.5e8, unlockEgg = 7 },
	{ name = "Star Porter", carry = 120000, cycle = 10, cost = 2.5e9, unlockEgg = 9 },
}

return {
	Tiers = tiers,
	MaxTier = #tiers,
	BaseSlots = 2, -- the Bunkhouse upgrade and the +2 Worker Slots pass add more
	MaxSlots = 8,
	HireCost = { 1500, 6000, 40000, 300000, 2e6, 1.5e7, 1e8, 7e8 },
	TutorialEgg = 1,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting shared by the HUD, menus and server messages.
-- Values up to 1e303 get a short suffix; anything larger falls back to scientific notation.

local Format = {}

local SUFFIXES = {
	"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No",
	"Dc", "UDc", "DDc", "TDc", "QaDc", "QiDc", "SxDc", "SpDc", "OcDc", "NoDc",
	"Vg", "UVg", "DVg", "TVg", "QaVg", "QiVg", "SxVg", "SpVg", "OcVg", "NoVg",
	"Tg", "UTg", "DTg", "TTg", "QaTg", "QiTg", "SxTg", "SpTg", "OcTg", "NoTg",
	"Qd", "UQd", "DQd", "TQd", "QaQd", "QiQd", "SxQd", "SpQd", "OcQd", "NoQd",
	"Qq", "UQq", "DQq", "TQq", "QaQq", "QiQq", "SxQq", "SpQq", "OcQq", "NoQq",
	"Sg", "USg", "DSg", "TSg", "QaSg", "QiSg", "SxSg", "SpSg", "OcSg", "NoSg",
	"St", "USt", "DSt", "TSt", "QaSt", "QiSt", "SxSt", "SpSt", "OcSt", "NoSt",
	"Og", "UOg", "DOg", "TOg", "QaOg", "QiOg", "SxOg", "SpOg", "OcOg", "NoOg",
	"Nn", "UNn", "DNn", "TNn", "QaNn", "QiNn", "SxNn", "SpNn", "OcNn", "NoNn",
	"Ce",
}

local function isBad(n: number): boolean
	return n ~= n or n == math.huge or n == -math.huge
end

-- Group digits: 1234567 -> "1,234,567" (integers below 1e15 only).
function Format.Commas(n: number): string
	if isBad(n) then
		return "0"
	end
	local neg = n < 0
	local s = string.format("%d", math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (neg and "-" or "") .. out
end

-- Short form: 999 -> "999", 1234 -> "1.23K", 5.6e9 -> "5.6B". At most 3 significant digits, truncated.
function Format.Short(n: number): string
	if isBad(n) then
		return n ~= n and "0" or (n > 0 and "∞" or "-∞")
	end
	local neg = n < 0
	local a = math.abs(n)
	local sign = neg and "-" or ""
	if a < 1000 then
		if a == math.floor(a) then
			return sign .. string.format("%d", a)
		end
		return sign .. (string.format("%.2f", a):gsub("%.?0+$", ""))
	end
	local exp = math.floor(math.log10(a) / 3)
	-- digits are truncated (never rounded up), so a shown balance is never more than the real one
	local scaled = a / 10 ^ (exp * 3)
	if scaled < 1 then -- float error in log10 just below a power of 1000
		exp -= 1
		scaled = a / 10 ^ (exp * 3)
	elseif scaled >= 1000 then
		exp += 1
		scaled = a / 10 ^ (exp * 3)
	end
	local suffix = SUFFIXES[exp + 1]
	if not suffix then
		return sign .. (string.format("%.2e", a):gsub("e%+?", "e"))
	end
	local digits
	if scaled >= 100 then
		digits = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		digits = (string.format("%.1f", math.floor(scaled * 10) / 10):gsub("%.0$", ""))
	else
		digits = (string.format("%.2f", math.floor(scaled * 100) / 100):gsub("%.?0+$", ""))
	end
	return sign .. digits .. suffix
end

function Format.Cash(n: number): string
	return "$" .. Format.Short(n)
end

-- "1h 02m", "4m 05s", "12s"
function Format.Duration(seconds: number): string
	if isBad(seconds) or seconds < 0 then
		seconds = 0
	end
	local s = math.floor(seconds)
	local d = s // 86400
	local h = (s % 86400) // 3600
	local m = (s % 3600) // 60
	local sec = s % 60
	if d > 0 then
		return string.format("%dd %02dh", d, h)
	elseif h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, sec)
	end
	return string.format("%ds", sec)
end

-- Rate per second, e.g. "12.5K/s"
function Format.Rate(n: number): string
	return Format.Short(n) .. "/s"
end

-- Multiplier, e.g. "x2.5"
function Format.Mult(n: number): string
	return "x" .. Format.Short(n)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">GameInfo</string>
          <string name="Source"><![CDATA[--!strict
-- Rename the game here. Every player-facing mention of the game name reads from this module.
-- (Also change "name" in default.project.json / test.project.json if you want the place
-- file names to match; see README "Renaming".)

return {
	Name = "Egg Farm",
	ShortName = "Egg Farm",
	Tagline = "Spawn chickens. Collect eggs. Ship them out. Build an egg empire of your own!",
	SaveStoreName = "EggFarm_Profiles_v1", -- DataStore name. Changing it starts every player fresh!
	Currency = {
		Cash = "Cash",
		Gold = "Gold Eggs",
		Star = "Star Eggs",
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- The farm economy: one Farm per player, wrapping that player's FarmState.
--   farm:Apply(action, now)  -> ActionResult    every state change goes through here
--   farm:Step(dt, now)                           production, hatching, workers, vehicles, timers
--   farm:Snapshot(now)       -> FarmSnapshot     what the owner's client is shown
-- Pure Luau with no Roblox APIs: the server owns the clock and passes `now` (server time, seconds).
-- Egg conservation: eggs only appear when hens lay (stats.laid) and only leave by being sold
-- (stats.sold) or discarded by a new farm (stats.discarded). Every other move takes exactly what
-- it adds. Spec: tests/Conservation.spec.luau.

local Eggs = require("../Data/Eggs")
local Housing = require("../Data/Housing")
local Vehicles = require("../Data/Vehicles")
local Workers = require("../Data/Workers")
local Upgrades = require("../Data/Upgrades")
local Boosts = require("../Data/Boosts")
local Silos = require("../Data/Silos")
local RewardData = require("../Data/Rewards")
local Products = require("../Data/Products")
local Contract = require("../Contract")
local Modifiers = require("./Modifiers")
local Prices = require("./Prices")
local Rewards = require("./Rewards")
local State = require("./State")
local Tutorial = require("./Tutorial")
local Validate = require("./Validate")

local CAP = Modifiers.CAP
local MAX_STEP = 5 -- longest single simulation slice (seconds); longer gaps are split

export type Event = { name: string, data: { [string]: any } }
export type Context = {
	premium: boolean?,
	codes: { [string]: any }?, -- server-only code table (Data lives in src/server)
	rng: (() -> number)?,
}

local Economy = {}
Economy.__index = Economy

export type Farm = typeof(setmetatable(
	{} :: {
		state: any,
		ctx: Context,
		events: { Event },
		dirty: boolean,
		combo: number,
		lastTap: number,
		lastSeq: number,
		mods: Modifiers.Mods?,
		modsAt: number,
		notice: { [string]: number },
	},
	Economy
))

function Economy.new(state: any, ctx: Context?): Farm
	local self = setmetatable({
		state = state,
		ctx = ctx or {},
		events = {},
		dirty = true,
		combo = 1,
		lastTap = -math.huge,
		lastSeq = 0,
		mods = nil,
		modsAt = -math.huge,
		notice = {},
	}, Economy)
	return self
end

local function result(code: string, message: string?): { ok: boolean, code: string, message: string? }
	return { ok = code == "ok" or code == "code_ok", code = code, message = message or Contract.Messages[code] }
end

function Economy.Emit(self: Farm, name: string, data: { [string]: any }?)
	table.insert(self.events, { name = name, data = data or {} })
end

-- Throttled one-off notices (e.g. "housing full") so they don't spam the client.
function Economy.Notice(self: Farm, key: string, now: number, every: number, data: { [string]: any }?)
	if (self.notice[key] or -math.huge) + every <= now then
		self.notice[key] = now
		self:Emit(key, data)
	end
end

function Economy.DrainEvents(self: Farm): { Event }
	local e = self.events
	self.events = {}
	return e
end

function Economy.Mods(self: Farm, now: number): Modifiers.Mods
	-- recomputed every call: cheap, and never stale after a purchase or boost
	local m = Modifiers.Compute(self.state, now, self.ctx)
	self.mods = m
	self.modsAt = now
	return m
end

function Economy.FarmValue(self: Farm): number
	return math.min(CAP, self.state.cash + self.state.invested)
end

local function spend(self: Farm, amount: number): boolean
	local s = self.state
	if not Validate.Finite(amount) or amount < 0 or s.cash < amount then
		return false
	end
	s.cash -= amount
	s.invested = math.min(CAP, s.invested + amount)
	return true
end

local function spendGold(self: Farm, amount: number): boolean
	local s = self.state
	if not Validate.Finite(amount) or amount < 0 or s.gold < amount then
		return false
	end
	s.gold -= amount
	return true
end

------------------------------------------------------------------------------------------------
-- Physical interactions (server calls these only after checking the player's position)
------------------------------------------------------------------------------------------------

-- Move stored eggs from house `slot` into the basket, up to the basket's free space.
function Economy.Collect(self: Farm, slot: number, now: number): { ok: boolean, code: string, message: string? }
	local s = self.state
	if not Validate.Int(slot, 1, Housing.Slots) then
		return result("invalid")
	end
	local h = s.housing[slot]
	if h.tier == 0 then
		return result("invalid")
	end
	local m = self:Mods(now)
	local space = m.carryCap - s.carried
	if space <= 0 then
		self:Notice("BasketFull", now, 3)
		return result("basket_full")
	end
	if h.eggs <= 0 then
		return result("empty")
	end
	local take = math.min(h.eggs, space)
	h.eggs -= take
	s.carried += take
	Rewards.Track(s, "collected", take)
	self:Emit("Collected", { slot = slot, amount = take, full = s.carried >= m.carryCap })
	self.dirty = true
	Tutorial.Update(s)
	return result("ok")
end

-- Move the whole basket into the warehouse (shipping stock).
function Economy.Deposit(self: Farm, now: number): { ok: boolean, code: string, message: string? }
	local s = self.state
	if s.carried <= 0 then
		return result("nothing_carried")
	end
	local amount = s.carried
	s.carried = 0
	s.warehouse += amount
	Rewards.Track(s, "deposited", amount)
	self:Emit("Deposited", { amount = amount })
	self.dirty = true
	Tutorial.Update(s)
	return result("ok")
end

-- Lucky Fox caught (server validated the fox and the distance). Pays some seconds of earnings.
function Economy.CatchFox(self: Farm, now: number): { ok: boolean, code: string, message: string? }
	local s = self.state
	local roll = if self.ctx.rng then self.ctx.rng() else 0.5
	local seconds = 30 + math.floor(roll * 90)
	local egg = Eggs.List[s.egg]
	local cash = math.floor(math.max(Modifiers.SteadyCashRate(s, now, self.ctx) * seconds, 50 * egg.value))
	s.cash = math.min(CAP, s.cash + cash)
	Rewards.Track(s, "foxes", 1)
	self:Emit("Fox", { cash = cash })
	self.dirty = true
	return result("ok")
end

------------------------------------------------------------------------------------------------
-- Client actions
------------------------------------------------------------------------------------------------

local handlers: { [string]: (self: Farm, a: any, now: number) -> { ok: boolean, code: string, message: string? } } = {}

local function slotArg(a: any, max: number): number?
	if Validate.Int(a.slot, 1, max) then
		return a.slot
	end
	return nil
end

-- `expect` guards against double taps and stale menus: the request names the level it saw.
local function expectOk(a: any, current: number): boolean
	return a.expect == nil or (Validate.Int(a.expect, 0, 1e6) and a.expect == current)
end

local function purchased(self: Farm, kind: string, data: { [string]: any })
	Rewards.Track(self.state, "upgrades", 1)
	self:Emit("Purchased", data)
	self.dirty = true
	Tutorial.Update(self.state)
end

handlers.spawn = function(self, a, now)
	local s = self.state
	local m = self:Mods(now)
	local cap = Modifiers.TotalCapacity(s, m)
	if s.population >= cap then
		self:Notice("HousingFull", now, 2)
		return result("full")
	end
	local add = math.min(m.spawnPerTap, cap - s.population)
	s.population += add
	Rewards.Track(s, "spawned", add)
	-- tap combo: every accepted tap raises the Cash Multiplier a little; it decays when idle
	self.combo = math.min(m.comboMax, self.combo + Modifiers.COMBO_PER_TAP)
	self.lastTap = now
	self.dirty = true
	Tutorial.Update(s)
	return result("ok")
end

handlers.setAutoSpawn = function(self, a, now)
	if not Validate.Bool(a.value) then
		return result("invalid")
	end
	if a.value and not self.state.tutorial.done then
		return result("tutorial")
	end
	self.state.settings.autoSpawn = a.value
	self.dirty = true
	return result("ok")
end

handlers.buyHouse = function(self, a, now)
	local slot = slotArg(a, Housing.Slots)
	if not slot then
		return result("invalid")
	end
	local price, code = Prices.BuyHouse(self.state, slot)
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	local h = self.state.housing[slot]
	h.tier, h.eggs, h.partial = 1, 0, 0
	purchased(self, "house", { kind = "house", slot = slot, tier = 1 })
	return result("ok")
end

handlers.upgradeHouse = function(self, a, now)
	local slot = slotArg(a, Housing.Slots)
	if not slot then
		return result("invalid")
	end
	local h = self.state.housing[slot]
	if not expectOk(a, h.tier) then
		return result("stale")
	end
	local price, code = Prices.UpgradeHouse(self.state, slot)
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	h.tier += 1
	purchased(self, "house", { kind = "house", slot = slot, tier = h.tier })
	return result("ok")
end

handlers.buyVehicle = function(self, a, now)
	local slot = slotArg(a, Vehicles.MaxSlots)
	if not slot then
		return result("invalid")
	end
	local price, code = Prices.BuyVehicle(self.state, slot, self:Mods(now))
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	local v = self.state.vehicles[slot]
	v.tier, v.load, v.phase, v.t = 1, 0, "dock", 0
	purchased(self, "vehicle", { kind = "vehicle", slot = slot, tier = 1 })
	return result("ok")
end

handlers.upgradeVehicle = function(self, a, now)
	local slot = slotArg(a, Vehicles.MaxSlots)
	if not slot then
		return result("invalid")
	end
	local v = self.state.vehicles[slot]
	if not expectOk(a, v.tier) then
		return result("stale")
	end
	local price, code = Prices.UpgradeVehicle(self.state, slot)
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	v.tier += 1 -- a vehicle out on a trip keeps its load; the new size applies from the next load
	purchased(self, "vehicle", { kind = "vehicle", slot = slot, tier = v.tier })
	return result("ok")
end

handlers.hireWorker = function(self, a, now)
	local slot = slotArg(a, Workers.MaxSlots)
	if not slot then
		return result("invalid")
	end
	local price, code = Prices.HireWorker(self.state, slot, self:Mods(now))
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	local w = self.state.workers[slot]
	w.tier, w.load, w.t, w.house = 1, 0, 0, 1
	purchased(self, "worker", { kind = "worker", slot = slot, tier = 1 })
	return result("ok")
end

handlers.upgradeWorker = function(self, a, now)
	local slot = slotArg(a, Workers.MaxSlots)
	if not slot then
		return result("invalid")
	end
	local w = self.state.workers[slot]
	if not expectOk(a, w.tier) then
		return result("stale")
	end
	local price, code = Prices.UpgradeWorker(self.state, slot)
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	w.tier += 1
	purchased(self, "worker", { kind = "worker", slot = slot, tier = w.tier })
	return result("ok")
end

handlers.buildSilo = function(self, a, now)
	if not expectOk(a, self.state.silos) then
		return result("stale")
	end
	local price, code = Prices.Silo(self.state)
	if not price then
		return result(code)
	end
	if not spend(self, price) then
		return result("cant_afford")
	end
	self.state.silos += 1
	purchased(self, "silo", { kind = "silo", count = self.state.silos })
	return result("ok")
end

local function buyUpgrade(self: Farm, a: any, now: number, wantEpic: boolean)
	if not Validate.Id(a.id) then
		return result("invalid")
	end
	local u = Upgrades.ById[a.id]
	if not u or (table.find(Upgrades.Epic, u) ~= nil) ~= wantEpic then
		return result("invalid")
	end
	local levels = if wantEpic then self.state.epic else self.state.common
	local level = levels[a.id] or 0
	if not expectOk(a, level) then
		return result("stale")
	end
	local price, code, currency = Prices.Upgrade(self.state, a.id, self:Mods(now))
	if not price then
		return result(code)
	end
	if currency == "gold" then
		if not spendGold(self, price) then
			return result("cant_afford_gold")
		end
	elseif not spend(self, price) then
		return result("cant_afford")
	end
	levels[a.id] = level + 1
	purchased(self, "upgrade", { kind = if wantEpic then "epic" else "common", id = a.id, level = level + 1 })
	return result("ok")
end

handlers.buyCommon = function(self, a, now)
	return buyUpgrade(self, a, now, false)
end

handlers.buyEpic = function(self, a, now)
	return buyUpgrade(self, a, now, true)
end

-- Starts the next farm. Fields in State.RESET_FIELDS are cleared; eggs still on the farm are
-- counted as discarded so the conservation ledger stays exact.
local function newFarm(self: Farm, nextEgg: number)
	local s = self.state
	Rewards.Track(s, "discarded", State.EggsOnFarm(s))
	State.ApplyFreshFarm(s)
	s.egg = nextEgg
	self.combo = 1
	self.dirty = true
end

handlers.rebirth = function(self, a, now)
	local s = self.state
	if not expectOk(a, s.egg) then
		return result("stale")
	end
	if s.egg >= Eggs.Count then
		return result("last_egg")
	end
	if self:FarmValue() < Eggs.List[s.egg].requirement then
		return result("not_requirement")
	end
	local from = s.egg
	newFarm(self, from + 1)
	s.rebirths += 1
	local granted = Rewards.Grant(s, { gold = Eggs.List[s.egg].rebirthGold }, now, self.ctx, true)
	self:Emit("Rebirth", { from = from, to = s.egg, gold = granted.gold or 0 })
	return result("ok")
end

handlers.skip = function(self, a, now)
	local s = self.state
	if not expectOk(a, s.egg) then
		return result("stale")
	end
	local cost, code = Prices.Skip(s, self:FarmValue())
	if not cost then
		return result(code)
	end
	if not spendGold(self, cost) then
		return result("cant_afford_gold")
	end
	local from = s.egg
	newFarm(self, from + 1)
	s.rebirths += 1
	local granted = Rewards.Grant(s, { gold = Eggs.List[s.egg].rebirthGold }, now, self.ctx, true)
	self:Emit("Rebirth", { from = from, to = s.egg, gold = granted.gold or 0, skipped = true, cost = cost })
	return result("ok")
end

-- Stars granted by a prestige (DESIGN rule; the reference's prestige rules are unknown).
function Economy.PrestigeStars(state: any): number
	return 10 + 5 * state.prestiges
end

handlers.prestige = function(self, a, now)
	local s = self.state
	if not expectOk(a, s.egg) then
		return result("stale")
	end
	if s.egg < Eggs.Count then
		return result("not_last_egg")
	end
	if self:FarmValue() < Eggs.List[s.egg].requirement then
		return result("not_requirement")
	end
	local stars = Economy.PrestigeStars(s)
	newFarm(self, 1)
	s.prestiges += 1
	s.stars += stars
	self:Emit("Prestige", { stars = stars, total = s.stars })
	return result("ok")
end

handlers.useBoost = function(self, a, now)
	local s = self.state
	if not Validate.Id(a.id) or not Boosts.ById[a.id] then
		return result("invalid")
	end
	local have = s.boosts.inventory[a.id] or 0
	if have <= 0 then
		return result("no_boost")
	end
	local b = Boosts.ById[a.id]
	local existing
	for _, act in s.boosts.active do
		if act.id == a.id then
			existing = act
		end
	end
	if existing then
		if existing.endsAt - now >= Boosts.MaxDuration then
			return result("max_level")
		end
		existing.endsAt = math.min(now + Boosts.MaxDuration, existing.endsAt + b.duration)
	else
		if #s.boosts.active >= self:Mods(now).maxBoosts then
			return result("boost_limit")
		end
		table.insert(s.boosts.active, { id = a.id, endsAt = now + b.duration })
	end
	s.boosts.inventory[a.id] = have - 1
	if s.boosts.inventory[a.id] == 0 then
		s.boosts.inventory[a.id] = nil
	end
	Rewards.Track(s, "boostsUsed", 1)
	self:Emit("BoostUsed", { id = a.id })
	self.dirty = true
	return result("ok")
end

handlers.claimQuest = function(self, a, now)
	local s = self.state
	if not Validate.Id(a.id) then
		return result("invalid")
	end
	Rewards.RollDay(s, now)
	local q = Rewards.FindQuest(s.quests.day, a.id)
	if not q then
		return result("invalid")
	end
	if s.quests.claimed[q.id] then
		return result("already")
	end
	if (s.quests.progress[q.stat] or 0) < q.target then
		return result("not_ready")
	end
	s.quests.claimed[q.id] = true
	local granted = Rewards.Grant(s, q.reward, now, self.ctx, true)
	self:Emit("Reward", { source = "quest", id = q.id, granted = granted })
	self.dirty = true
	return result("ok")
end

handlers.claimDaily = function(self, a, now)
	local s = self.state
	local today = Rewards.Day(now)
	if not Rewards.DailyCanClaim(s, now) then
		return result("already")
	end
	local dayIndex = Rewards.DailyNextDay(s, now)
	s.daily.streak = if s.daily.lastDay == today - 1 then s.daily.streak + 1 else 1
	s.daily.lastDay = today
	local granted = Rewards.Grant(s, RewardData.Daily[dayIndex], now, self.ctx, true)
	self:Emit("Reward", { source = "daily", day = dayIndex, granted = granted })
	self.dirty = true
	return result("ok")
end

local function claimGift(self: Farm, i: number, now: number): string
	local s = self.state
	local g = RewardData.Gifts[i]
	if not g then
		return "invalid"
	end
	local key = tostring(i) -- string keys: DataStores reject sparse numeric tables
	if s.gifts.claimed[key] then
		return "already"
	end
	if s.gifts.playtime < g.minutes * 60 then
		return "not_ready"
	end
	s.gifts.claimed[key] = true
	local granted = Rewards.Grant(s, g.reward, now, self.ctx, true)
	self:Emit("Reward", { source = "gift", index = i, granted = granted })
	self.dirty = true
	return "ok"
end

handlers.claimGift = function(self, a, now)
	if not Validate.Int(a.index, 1, #RewardData.Gifts) then
		return result("invalid")
	end
	Rewards.RollDay(self.state, now)
	return result(claimGift(self, a.index, now))
end

handlers.claimAllGifts = function(self, a, now)
	Rewards.RollDay(self.state, now)
	local any = false
	for i in RewardData.Gifts do
		if claimGift(self, i, now) == "ok" then
			any = true
		end
	end
	return result(if any then "ok" else "not_ready")
end

-- Codes are matched case-insensitively. The code table lives on the server only.
handlers.redeemCode = function(self, a, now)
	local s = self.state
	if not Validate.Text(a.text, 32) then
		return result("code_invalid")
	end
	if not s.tutorial.done then
		return result("tutorial")
	end
	local key = string.upper(a.text)
	local def = self.ctx.codes and self.ctx.codes[key]
	if not def then
		return result("code_invalid")
	end
	if s.codes[key] then
		return result("code_used")
	end
	if def.expires and now >= def.expires then
		return result("code_expired")
	end
	s.codes[key] = true
	local granted = Rewards.Grant(s, def.reward, now, self.ctx, false)
	self:Emit("Reward", { source = "code", code = key, granted = granted })
	self.dirty = true
	return result("code_ok")
end

-- Items bought with Gold Eggs (boost shop). Robux items never come through here.
handlers.buyGoldItem = function(self, a, now)
	if not Validate.Id(a.id) then
		return result("invalid")
	end
	local p = Products.ById[a.id]
	if not p or p.kind ~= "gold" or not p.goldPrice then
		return result("invalid")
	end
	if not spendGold(self, p.goldPrice) then
		return result("cant_afford_gold")
	end
	local granted = Rewards.Grant(self.state, p.grant, now, self.ctx, false)
	self:Emit("Reward", { source = "shop", id = p.id, granted = granted })
	self.dirty = true
	return result("ok")
end

handlers.setSetting = function(self, a, now)
	if not Validate.Id(a.id) then
		return result("invalid")
	end
	local rule = Contract.Settings[a.id]
	if rule == nil then
		return result("invalid")
	end
	if rule == "boolean" then
		if not Validate.Bool(a.value) then
			return result("invalid")
		end
		if a.id == "autoSpawn" then
			return handlers.setAutoSpawn(self, { value = a.value }, now)
		end
	elseif type(rule) == "table" then
		if not Validate.OneOf(a.value, rule) then
			return result("invalid")
		end
	end
	self.state.settings[a.id] = a.value
	self.dirty = true
	return result("ok")
end

handlers.claimOffline = function(self, a, now)
	local s = self.state
	if s.offline.pending <= 0 then
		return result("not_ready")
	end
	local cash = s.offline.pending
	s.cash = math.min(CAP, s.cash + cash)
	s.offline.pending = 0
	s.offline.seconds = 0
	Rewards.Track(s, "cashEarned", cash)
	self:Emit("Reward", { source = "offline", granted = { cash = cash } })
	self.dirty = true
	return result("ok")
end

-- Entry point for client requests. Rejects unknown/server-only actions, malformed tables and
-- replayed sequence numbers before any handler runs. Handlers never yield, so each one is atomic.
function Economy.Apply(self: Farm, action: any, now: number): { ok: boolean, code: string, message: string? }
	if type(action) ~= "table" or type(action.type) ~= "string" then
		return result("invalid")
	end
	if not Contract.ClientActions[action.type] then
		return result("invalid")
	end
	if action.seq ~= nil then
		if not Validate.Int(action.seq, 1, 2 ^ 52) or action.seq <= self.lastSeq then
			return result("stale")
		end
		self.lastSeq = action.seq
	end
	Rewards.RollDay(self.state, now)
	local h = handlers[action.type]
	return h(self, action, now)
end

------------------------------------------------------------------------------------------------
-- Simulation
------------------------------------------------------------------------------------------------

-- Splits the population over the owned houses in proportion to their capacity.
function Economy.Occupants(self: Farm, m: Modifiers.Mods): { number }
	local s = self.state
	local cap = Modifiers.TotalCapacity(s, m)
	local out = {}
	for i, h in s.housing do
		local c = Modifiers.HouseCapacity(h.tier, m)
		out[i] = if cap > 0 then s.population * c / cap else 0
	end
	return out
end

local function stepSlice(self: Farm, dt: number, now: number)
	local s = self.state
	local m = self:Mods(now)

	-- 1. hatching: Coop Hatchery (per owned house) + Auto Spawn, capped by housing capacity
	local cap = Modifiers.TotalCapacity(s, m)
	local owned = 0
	for _, h in s.housing do
		if h.tier > 0 then
			owned += 1
		end
	end
	local rate = m.hatchPerHouse * owned
	if s.settings.autoSpawn and s.tutorial.done then
		rate += m.autoSpawnRate
	end
	if rate > 0 and s.population < cap then
		s.hatchPartial += rate * dt
		local whole = math.floor(s.hatchPartial)
		if whole > 0 then
			local add = math.min(whole, cap - s.population)
			s.population += add
			s.hatchPartial -= whole
			Rewards.Track(s, "spawned", add)
			self.dirty = true
		end
	elseif s.population >= cap then
		s.hatchPartial = 0
	end
	if s.population > cap then
		s.population = cap -- only if capacity ever shrinks (e.g. a pass removed in testing)
	end

	-- 2. laying: whole eggs go into each house's storage until it's full
	local occ = Economy.Occupants(self, m)
	local anyFull = false
	for i, h in s.housing do
		if h.tier > 0 and occ[i] > 0 then
			local storage = Modifiers.HouseStorage(h.tier, m)
			if h.eggs >= storage then
				anyFull = true
				h.partial = 0
			else
				h.partial += occ[i] * m.layRate * dt
				local whole = math.floor(h.partial)
				if whole > 0 then
					h.partial -= whole
					local add = math.min(whole, storage - h.eggs)
					h.eggs += add
					Rewards.Track(s, "laid", add)
					self.dirty = true
					if h.eggs >= storage then
						anyFull = true
					end
				end
			end
		end
	end
	if anyFull then
		self:Notice("StorageFull", now, 20)
	end

	-- 3. workers: pick up halfway through the cycle, drop at the warehouse at the end
	for _, w in s.workers do
		if w.tier > 0 then
			local cycle = Modifiers.WorkerCycle(w.tier)
			local before = w.t
			w.t += dt
			if before < cycle / 2 and w.t >= cycle / 2 and w.load == 0 then
				local best, bestEggs = 0, 0
				for i, h in s.housing do
					if h.tier > 0 and h.eggs > bestEggs then
						best, bestEggs = i, h.eggs
					end
				end
				if best > 0 then
					local take = math.min(Modifiers.WorkerCarry(w.tier, m), bestEggs)
					s.housing[best].eggs -= take
					w.load = take
					w.house = best
					self.dirty = true
				end
			end
			if w.t >= cycle then
				w.t -= cycle
				if w.t >= cycle then
					w.t = 0
				end
				if w.load > 0 then
					s.warehouse += w.load
					Rewards.Track(s, "workerDeposited", w.load)
					w.load = 0
					self.dirty = true
				end
			end
		end
	end

	-- 4. vehicles: load at the dock, sell halfway through the trip, come back
	for i, v in s.vehicles do
		if v.tier > 0 then
			local capV = Modifiers.VehicleCap(v.tier)
			local half = Modifiers.VehicleTrip(v.tier, m) / 2
			if v.phase == "dock" then
				if v.load < capV and s.warehouse > 0 then
					local take = math.min(capV - v.load, s.warehouse)
					s.warehouse -= take
					v.load += take
					self.dirty = true
				end
				if v.load > 0 then
					v.t += dt
					if v.load >= capV or v.t >= Vehicles.LoadWait then
						v.phase, v.t = "out", 0
						self:Emit("VehicleLeft", { slot = i })
						self.dirty = true
					end
				else
					v.t = 0
				end
			elseif v.phase == "out" then
				v.t += dt
				if v.t >= half then
					local combo = self.combo
					local cash = math.min(CAP, v.load * m.eggValue * m.saleMult * combo)
					s.cash = math.min(CAP, s.cash + cash)
					Rewards.Track(s, "sold", v.load)
					Rewards.Track(s, "cashEarned", cash)
					self:Emit("Sold", { slot = i, eggs = v.load, cash = cash })
					v.load = 0
					v.phase, v.t = "back", 0
					self.dirty = true
				end
			elseif v.phase == "back" then
				v.t += dt
				if v.t >= half then
					v.phase, v.t = "dock", 0
					self:Emit("VehicleBack", { slot = i })
					self.dirty = true
				end
			end
		end
	end

	-- 5. tap combo decays after a short pause
	if self.combo > 1 and now - self.lastTap > 1.5 then
		self.combo = math.max(1, self.combo - 0.75 * dt)
		self.dirty = true
	end

	-- 6. playtime for gifts and quests
	s.gifts.playtime += dt
	Rewards.Track(s, "playtime", dt)
end

function Economy.Step(self: Farm, dt: number, now: number)
	if not Validate.Finite(dt) or dt <= 0 then
		return
	end
	local s = self.state
	Rewards.RollDay(s, now)
	-- expire boosts (server real time)
	local active = s.boosts.active
	for i = #active, 1, -1 do
		if active[i].endsAt <= now then
			self:Emit("BoostEnded", { id = active[i].id })
			table.remove(active, i)
			self.dirty = true
		end
	end
	local remaining = dt
	local sliceStart = now - dt
	while remaining > 0 do
		local slice = math.min(remaining, MAX_STEP)
		remaining -= slice
		sliceStart += slice
		stepSlice(self, slice, sliceStart)
	end
	s.lastSeen = now
	if Tutorial.Update(s) then
		self.dirty = true
	end
end

-- Silo earnings for time spent away. Called once when a save loads. Boosts don't count and the
-- farm itself doesn't run while you're away; only silos earn (DESIGN rule; docs/DESIGN.md).
function Economy.ComputeOffline(self: Farm, now: number)
	local s = self.state
	local away = now - (s.lastSeen or now)
	s.lastSeen = now
	local silos = s.silos + (if s.passes.perma_silos then Silos.Max else 0)
	if away < Silos.MinAwaySeconds or silos <= 0 or not Validate.Finite(away) then
		return
	end
	local m = Modifiers.Compute(s, now, self.ctx, true)
	local seconds = math.min(away, silos * m.siloMinutes * 60)
	local cash = math.floor(Modifiers.SteadyCashRate(s, now, self.ctx) * Silos.OfflineRate * m.offlineMult * seconds)
	if cash > 0 then
		s.offline.pending = math.min(CAP, s.offline.pending + cash)
		s.offline.seconds = seconds
		self.dirty = true
	end
end

-- Keeps the newest `keep` one-off receipt ids (Roblox stops re-delivering a receipt once it is
-- acknowledged, so old ids are safe to drop). PASS- keys are fixed per pass and always kept.
function Economy.TrimReceipts(s: any, keep: number)
	local ids = {}
	for id, t in s.receipts do
		if string.sub(id, 1, 5) ~= "PASS-" then
			table.insert(ids, { id = id, t = t })
		end
	end
	if #ids <= keep then
		return
	end
	table.sort(ids, function(a, b)
		return a.t > b.t
	end)
	for i = keep + 1, #ids do
		s.receipts[ids[i].id] = nil
	end
end

-- Robux purchase fulfilment (called by the server's commerce layer after a confirmed receipt).
-- Idempotent per purchase id: a replayed receipt grants nothing the second time.
function Economy.GrantProduct(self: Farm, productId: string, purchaseId: string, now: number): (boolean, string)
	local s = self.state
	local p = Products.ById[productId]
	if not p or (p.kind ~= "pass" and p.kind ~= "product") then
		return false, "invalid"
	end
	if type(purchaseId) ~= "string" or #purchaseId == 0 or #purchaseId > 64 then
		return false, "invalid"
	end
	if s.receipts[purchaseId] then
		return true, "already"
	end
	s.receipts[purchaseId] = now
	Economy.TrimReceipts(s, 200)
	if p.grant.pass then
		s.passes[p.grant.pass] = true
	end
	local granted = Rewards.Grant(s, p.grant, now, self.ctx, false)
	self:Emit("Reward", { source = "purchase", id = productId, granted = granted })
	self.dirty = true
	return true, "ok"
end

------------------------------------------------------------------------------------------------
-- Snapshot
------------------------------------------------------------------------------------------------

function Economy.Snapshot(self: Farm, now: number): any
	local s = self.state
	local m = self:Mods(now)
	local rates = Modifiers.Rates(s, m)
	local occ = Economy.Occupants(self, m)
	local fv = self:FarmValue()
	local egg = Eggs.List[s.egg]
	local skip = Prices.Skip(s, fv)

	local housing = {}
	for i, h in s.housing do
		housing[i] = {
			tier = h.tier,
			eggs = h.eggs,
			storage = Modifiers.HouseStorage(h.tier, m),
			capacity = Modifiers.HouseCapacity(h.tier, m),
			occupants = math.floor(occ[i] + 0.5),
		}
	end
	local vehicles = {}
	for i, v in s.vehicles do
		vehicles[i] = {
			tier = v.tier,
			load = v.load,
			phase = v.phase,
			t = v.t,
			trip = if v.tier > 0 then Modifiers.VehicleTrip(v.tier, m) else 0,
			cap = Modifiers.VehicleCap(v.tier),
		}
	end
	local workers = {}
	for i, w in s.workers do
		workers[i] = {
			tier = w.tier,
			load = w.load,
			t = w.t,
			cycle = if w.tier > 0 then Modifiers.WorkerCycle(w.tier) else 0,
			house = w.house,
		}
	end
	local quests = {}
	local day = Rewards.Day(now)
	for _, q in Rewards.QuestsForDay(day) do
		table.insert(quests, {
			id = q.id,
			progress = math.min(q.target, if s.quests.day == day then s.quests.progress[q.stat] or 0 else 0),
			target = q.target,
			claimed = s.quests.day == day and s.quests.claimed[q.id] == true,
		})
	end

	local flow = math.min(rates.lay, rates.ship)
	return {
		serverNow = now,
		cash = s.cash,
		gold = s.gold,
		stars = s.stars,
		population = s.population,
		capacity = Modifiers.TotalCapacity(s, m),
		egg = s.egg,
		eggValue = m.eggValue,
		farmValue = fv,
		nextRequirement = egg.requirement,
		canRebirth = s.egg < Eggs.Count and fv >= egg.requirement,
		canPrestige = s.egg == Eggs.Count and fv >= egg.requirement,
		skipCost = skip or -1,
		rebirths = s.rebirths,
		prestiges = s.prestiges,
		combo = self.combo,
		comboMax = m.comboMax,
		spawnPerTap = m.spawnPerTap,
		autoSpawnRate = m.autoSpawnRate,
		rates = {
			lay = rates.lay,
			hatch = m.hatchPerHouse,
			ship = rates.ship,
			workers = rates.workers,
			cash = flow * m.eggValue * m.saleMult * self.combo,
		},
		mods = {
			layRate = m.layRate,
			saleMult = m.saleMult,
			capacityMult = m.capacityMult,
			tripMult = m.tripMult,
			workerMult = m.workerMult,
			commonPriceMult = m.commonPriceMult,
			siloMinutes = m.siloMinutes,
		},
		housing = housing,
		carried = s.carried,
		carryCap = m.carryCap,
		warehouse = s.warehouse,
		vehicles = vehicles,
		vehicleSlots = m.vehicleSlots,
		workers = workers,
		workerSlots = m.workerSlots,
		silos = s.silos,
		permanentSilos = if s.passes.perma_silos then Silos.Max else 0,
		common = table.clone(s.common),
		epic = table.clone(s.epic),
		boosts = {
			inventory = table.clone(s.boosts.inventory),
			active = table.clone(s.boosts.active),
			maxActive = m.maxBoosts,
		},
		quests = { day = day, list = quests },
		daily = {
			streak = s.daily.streak,
			canClaim = Rewards.DailyCanClaim(s, now),
			nextDay = Rewards.DailyNextDay(s, now),
			resetsIn = (day + 1) * 86400 - now,
		},
		gifts = { playtime = if s.gifts.day == day then s.gifts.playtime else 0, claimed = table.clone(s.gifts.claimed) },
		settings = table.clone(s.settings),
		tutorial = { step = s.tutorial.step, done = s.tutorial.done },
		passes = table.clone(s.passes),
		offline = { pending = s.offline.pending, seconds = s.offline.seconds },
		walkSpeed = m.walkSpeed,
	}
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Flock</string>
            <string name="Source"><![CDATA[--!strict
-- Visual flock planner. PURE (no Roblox APIs): the client asks how many chicken models to show
-- per house, and steps each chicken's wander state here. Chickens are decoration only; the real
-- population lives in the snapshot and can be astronomically large (1e9+), so what is drawn is a
-- bounded, representative sample.
--
-- Cap (documented contract, tested in tests/Flock.spec.luau):
--   own plot  low:    up to  6 per house, 24 per plot
--             normal: up to 15 per house, 60 per plot
--             high:   up to 30 per house, 120 per plot
--   other players' plots: 1 per occupied house (4 per plot), only within OTHER_RADIUS studs.
--   Any occupied house always shows at least 1 chicken (within range).
--   Growth is logarithmic: 1 chicken at 1 occupant, the per-house cap at FULL_AT occupants
--   (1e5, a full late-game house), so every 10x in population adds the same number of birds.
-- Why these numbers: a fully upgraded own plot at "high" is 120 chickens x 7 parts = 840 moving
-- parts, moved in one BulkMoveTo per frame (cheap on phones); "low" stays under 200 parts.
-- Others' plots are only a hint of life, so 4 birds each keeps 7 neighbours under 200 parts.

local Flock = {}

export type Cap = { house: number, plot: number }

Flock.Caps = {
	low = { house = 6, plot = 24 },
	normal = { house = 15, plot = 60 },
	high = { house = 30, plot = 120 },
} :: { [string]: Cap }
Flock.Other = { house = 1, plot = 4 } :: Cap
Flock.OTHER_RADIUS = 200
Flock.FULL_AT = 1e5

local function finite(n: any): number
	if type(n) ~= "number" or n ~= n then
		return 0
	end
	if n == math.huge then
		return 1e308
	end
	return math.max(0, n)
end

function Flock.CapFor(setting: string?, own: boolean): Cap
	if not own then
		return Flock.Other
	end
	return Flock.Caps[setting or "normal"] or Flock.Caps.normal
end

-- Chickens shown for one house with `occupants` real chickens, before the per-plot cap.
function Flock.ForHouse(occupants: number, houseCap: number): number
	local occ = math.floor(finite(occupants) + 0.5)
	if occ < 1 or houseCap < 1 then
		return 0
	end
	local f = math.clamp(math.log10(occ) / math.log10(Flock.FULL_AT), 0, 1)
	return math.min(houseCap, 1 + math.floor((houseCap - 1) * f + 1e-9))
end

export type PlanInput = {
	occupants: { number },
	setting: string?,
	own: boolean,
	distance: number?, -- studs from the camera/character to the plot (others' plots only)
}

-- Count of chickens to draw per house.
function Flock.Plan(input: PlanInput): { number }
	local out = {}
	local n = #input.occupants
	for i = 1, n do
		out[i] = 0
	end
	if not input.own and finite(input.distance or 0) > Flock.OTHER_RADIUS then
		return out
	end
	local cap = Flock.CapFor(input.setting, input.own)
	local total = 0
	local occupied = {}
	for i = 1, n do
		out[i] = Flock.ForHouse(input.occupants[i], cap.house)
		total += out[i]
		if out[i] > 0 then
			table.insert(occupied, i)
		end
	end
	if total <= cap.plot then
		return out
	end
	-- Over the plot cap: every occupied house keeps 1 (largest houses first if even that is too
	-- many), the remaining budget is shared in proportion to each house's extra birds.
	table.sort(occupied, function(a, b)
		return finite(input.occupants[a]) > finite(input.occupants[b])
	end)
	local base = math.min(#occupied, cap.plot)
	local extraTotal = 0
	for k, i in occupied do
		if k <= base then
			extraTotal += out[i] - 1
		end
	end
	local budget = cap.plot - base
	local result = {}
	local rema: { { i: number, r: number } } = {}
	local used = 0
	for i = 1, n do
		result[i] = 0
	end
	for k, i in occupied do
		if k > base then
			continue
		end
		local share = if extraTotal > 0 then (out[i] - 1) * budget / extraTotal else 0
		local whole = math.floor(share)
		result[i] = 1 + whole
		used += whole
		table.insert(rema, { i = i, r = share - whole })
	end
	table.sort(rema, function(a, b)
		if a.r == b.r then
			return a.i < b.i
		end
		return a.r > b.r
	end)
	local left = budget - used
	for _, e in rema do
		if left <= 0 then
			break
		end
		if result[e.i] < out[e.i] then
			result[e.i] += 1
			left -= 1
		end
	end
	return result
end

-- Spread a plot's population over its houses in proportion to house capacity (for other
-- players' plots, where only the Population and HouseTiers attributes are known).
function Flock.Distribute(population: number, capacities: { number }): { number }
	local pop = finite(population)
	local sum = 0
	for _, c in capacities do
		sum += finite(c)
	end
	local out = {}
	for i, c in capacities do
		out[i] = if sum > 0 then pop * finite(c) / sum else 0
	end
	return out
end

-- How often (seconds) a chicken at `distance` studs should be re-posed. 0 = every frame.
function Flock.UpdateInterval(distance: number): number
	if distance < 70 then
		return 0
	elseif distance < 140 then
		return 1 / 15
	end
	return 1 / 6
end

-- ------------------------------------------------------------------ wander state machine
export type Bird = {
	x: number, -- offset from the yard centre (plot axes)
	z: number,
	tx: number,
	tz: number,
	heading: number, -- radians about +y (0 = facing -z)
	mode: string, -- "walk" | "peck" | "idle"
	timer: number,
	phase: number,
	speed: number,
	hop: number, -- output: body lift (studs)
	peck: number, -- output: 0..1 head dip
}

function Flock.NewBird(hx: number, hz: number, rand: () -> number): Bird
	local x = (rand() * 2 - 1) * hx
	local z = (rand() * 2 - 1) * hz
	return {
		x = x,
		z = z,
		tx = x,
		tz = z,
		heading = rand() * math.pi * 2,
		mode = "idle",
		timer = rand() * 1.5,
		phase = rand() * 10,
		speed = 3 + rand() * 2.5,
		hop = 0,
		peck = 0,
	}
end

-- Advance one bird by dt inside the yard box [-hx, hx] x [-hz, hz]. Mutates and returns it.
function Flock.Wander(b: Bird, dt: number, hx: number, hz: number, rand: () -> number): Bird
	dt = math.clamp(finite(dt), 0, 1)
	b.phase += dt
	b.timer -= dt
	if b.mode == "walk" then
		local dx, dz = b.tx - b.x, b.tz - b.z
		local dist = math.sqrt(dx * dx + dz * dz)
		local step = b.speed * dt
		if dist <= step or dist < 0.05 then
			b.x, b.z = b.tx, b.tz
			if rand() < 0.6 then
				b.mode, b.timer = "peck", 0.6 + rand() * 1.4
			else
				b.mode, b.timer = "idle", 0.4 + rand() * 1.6
			end
		else
			b.x += dx / dist * step
			b.z += dz / dist * step
			b.heading = math.atan2(-dx, -dz)
		end
		b.hop = math.abs(math.sin(b.phase * 14)) * 0.22
		b.peck = 0
	else
		b.hop = 0
		if b.mode == "peck" then
			b.peck = math.max(0, math.sin(b.phase * 9))
		else
			b.peck = 0
		end
		if b.timer <= 0 then
			b.mode = "walk"
			b.tx = (rand() * 2 - 1) * hx
			b.tz = (rand() * 2 - 1) * hz
		end
	end
	b.x = math.clamp(b.x, -hx, hx)
	b.z = math.clamp(b.z, -hz, hz)
	return b
end

return Flock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">MenuRouter</string>
            <string name="Source"><![CDATA[--!strict
-- Which menu is open. PURE (no Roblox APIs) so the rules are unit-tested (tests/MenuRouter.spec).
-- Rules:
--   * At most one main panel is open. Opening another replaces it (no stacking of panels).
--   * At most one confirm modal sits on top. A second modal is refused while one is open.
--     Modals may also open with no panel (e.g. the offline "Welcome back" modal).
--   * Every panel remembers its last tab; reopening it shows that tab. Unknown tabs are ignored.
--   * Back(): closes the modal if there is one; otherwise returns to the panel this one was
--     opened from (only when opened with returnTo, e.g. Shop -> Codes); otherwise closes.
--   * Opening or closing a panel also closes the modal (a modal belongs to what was on screen).
--   * IsBlockingWorld() is true while any panel or modal is open: the HUD disables Spawn, world
--     prompts are disabled locally and a full-screen dimmer sinks clicks.

export type PanelDef = { tabs: { string }? }

export type Router = {
	defs: { [string]: PanelDef },
	panel: string?,
	modal: string?,
	modalData: any,
	returnTo: string?,
	tabs: { [string]: string },
	listeners: { () -> () },
	Open: (self: Router, name: string, tab: string?, returnTo: boolean?) -> boolean,
	Toggle: (self: Router, name: string, tab: string?) -> boolean,
	Close: (self: Router) -> (),
	CloseAll: (self: Router) -> (),
	Back: (self: Router) -> (),
	SetTab: (self: Router, tab: string) -> boolean,
	GetTab: (self: Router, name: string) -> string?,
	OpenModal: (self: Router, id: string, data: any?) -> boolean,
	CloseModal: (self: Router) -> (),
	Current: (self: Router) -> string?,
	Modal: (self: Router) -> string?,
	IsOpen: (self: Router, name: string) -> boolean,
	IsBlockingWorld: (self: Router) -> boolean,
	Subscribe: (self: Router, fn: () -> ()) -> () -> (),
}

local MenuRouter = {}

local function notify(self: Router)
	for _, fn in table.clone(self.listeners) do
		fn()
	end
end

local function validTab(def: PanelDef?, tab: string?): boolean
	return def ~= nil and def.tabs ~= nil and tab ~= nil and table.find(def.tabs, tab) ~= nil
end

function MenuRouter.new(defs: { [string]: PanelDef }): Router
	local self = {
		defs = defs,
		panel = nil,
		modal = nil,
		modalData = nil,
		returnTo = nil,
		tabs = {},
		listeners = {},
	} :: any

	function self.GetTab(r: Router, name: string): string?
		local def = r.defs[name]
		if not def or not def.tabs then
			return nil
		end
		return r.tabs[name] or def.tabs[1]
	end

	function self.Open(r: Router, name: string, tab: string?, returnTo: boolean?): boolean
		local def = r.defs[name]
		if not def then
			return false
		end
		if validTab(def, tab) then
			r.tabs[name] = tab :: string
		end
		local prev = r.panel
		if prev == name and r.modal == nil and (tab == nil or not validTab(def, tab)) then
			return true -- already showing; nothing changes
		end
		r.returnTo = if returnTo and prev and prev ~= name then prev else nil
		r.panel = name
		r.modal = nil
		r.modalData = nil
		notify(r)
		return true
	end

	function self.Toggle(r: Router, name: string, tab: string?): boolean
		if r.panel == name then
			r:Close()
			return false
		end
		return r:Open(name, tab)
	end

	function self.Close(r: Router)
		if r.panel == nil and r.modal == nil then
			return
		end
		r.panel = nil
		r.returnTo = nil
		r.modal = nil
		r.modalData = nil
		notify(r)
	end

	function self.CloseAll(r: Router)
		r:Close()
	end

	function self.Back(r: Router)
		if r.modal then
			r:CloseModal()
		elseif r.returnTo and r.defs[r.returnTo] then
			local to = r.returnTo
			r.returnTo = nil
			r.panel = to
			notify(r)
		else
			r:Close()
		end
	end

	function self.SetTab(r: Router, tab: string): boolean
		local name = r.panel
		if not name then
			return false
		end
		local def = r.defs[name]
		if not validTab(def, tab) then
			return false
		end
		if r.tabs[name] == tab then
			return true
		end
		r.tabs[name] = tab
		notify(r)
		return true
	end

	function self.OpenModal(r: Router, id: string, data: any?): boolean
		if r.modal ~= nil then
			return false
		end
		r.modal = id
		r.modalData = data
		notify(r)
		return true
	end

	function self.CloseModal(r: Router)
		if r.modal == nil then
			return
		end
		r.modal = nil
		r.modalData = nil
		notify(r)
	end

	function self.Current(r: Router): string?
		return r.panel
	end

	function self.Modal(r: Router): string?
		return r.modal
	end

	function self.IsOpen(r: Router, name: string): boolean
		return r.panel == name
	end

	function self.IsBlockingWorld(r: Router): boolean
		return r.panel ~= nil or r.modal ~= nil
	end

	function self.Subscribe(r: Router, fn: () -> ()): () -> ()
		table.insert(r.listeners, fn)
		return function()
			local i = table.find(r.listeners, fn)
			if i then
				table.remove(r.listeners, i)
			end
		end
	end

	return self :: Router
end

return MenuRouter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Migrations</string>
            <string name="Source"><![CDATA[--!strict
-- Upgrades saved data to the current FarmState version, fills in fields added since it was saved,
-- and repairs impossible numbers (NaN, infinity, negatives) instead of letting them spread.
-- Never downgrades: data written by a NEWER version of the game is refused (the player is asked to
-- rejoin a newer server) so an old server can't overwrite fields it doesn't understand.

local State = require("./State")
local Housing = require("../Data/Housing")
local Vehicles = require("../Data/Vehicles")
local Workers = require("../Data/Workers")
local Eggs = require("../Data/Eggs")

local Migrations = {}

Migrations.CURRENT = State.VERSION

-- steps[n] upgrades a version-n record to version n+1.
-- Version 0 = records saved before the version field existed (pre-release test saves).
local steps: { [number]: (any) -> () } = {
	[0] = function(d)
		-- v0 stored the shipping stock as `stock` and had no workers list
		if d.stock ~= nil and d.warehouse == nil then
			d.warehouse = d.stock
		end
		d.stock = nil
	end,
}

local function fill(target: any, template: any)
	for k, v in template do
		if target[k] == nil then
			if type(v) == "table" then
				target[k] = {}
				fill(target[k], v)
			else
				target[k] = v
			end
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil and #v == 0 then
			fill(target[k], v) -- records: fill nested defaults (not lists)
		end
	end
end

local function num(v: any, lo: number, hi: number, default: number): number
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return math.clamp(v, lo, hi)
end

local function whole(v: any, lo: number, hi: number, default: number): number
	return math.floor(num(v, lo, hi, default))
end

local function fixSlots(list: any, count: number, make: () -> { any }, maxTier: number): { any }
	local fresh = make()
	if type(list) ~= "table" then
		return fresh
	end
	for i = 1, count do
		local e = list[i]
		if type(e) ~= "table" then
			list[i] = fresh[i]
		else
			for k, v in fresh[i] do
				if e[k] == nil or type(e[k]) ~= type(v) then
					e[k] = v
				end
			end
			e.tier = whole(e.tier, 0, maxTier, fresh[i].tier)
			if e.load ~= nil then
				e.load = whole(e.load, 0, 1e15, 0)
			end
			if e.eggs ~= nil then
				e.eggs = whole(e.eggs, 0, 1e15, 0)
				e.partial = num(e.partial, 0, 0.999999, 0)
			end
			if e.t ~= nil then
				e.t = num(e.t, 0, 1e6, 0)
			end
		end
	end
	for i = #list, count + 1, -1 do
		list[i] = nil
	end
	return list
end

function Migrations.Sanitize(d: any)
	local CAP = 1e300
	d.cash = num(d.cash, 0, CAP, 0)
	d.gold = num(d.gold, 0, CAP, 0)
	d.stars = num(d.stars, 0, CAP, 0)
	d.invested = num(d.invested, 0, CAP, 0)
	d.population = whole(d.population, 0, 1e15, 0)
	d.hatchPartial = num(d.hatchPartial, 0, 0.999999, 0)
	d.carried = whole(d.carried, 0, 1e15, 0)
	d.warehouse = whole(d.warehouse, 0, 1e15, 0)
	d.silos = whole(d.silos, 0, 10, 0)
	d.egg = whole(d.egg, 1, Eggs.Count, 1)
	d.rebirths = whole(d.rebirths, 0, 1e9, 0)
	d.prestiges = whole(d.prestiges, 0, 1e9, 0)
	d.housing = fixSlots(d.housing, Housing.Slots, State.EmptyHousing, Housing.MaxTier)
	if d.housing[1].tier == 0 then
		d.housing[1].tier = 1 -- the first coop is always owned
	end
	d.vehicles = fixSlots(d.vehicles, Vehicles.MaxSlots, State.EmptyVehicles, Vehicles.MaxTier)
	d.workers = fixSlots(d.workers, Workers.MaxSlots, State.EmptyWorkers, Workers.MaxTier)
	for _, group in { d.common, d.epic, d.boosts.inventory, d.stats } do
		for k, v in group do
			group[k] = num(v, 0, CAP, 0)
		end
	end
	local active = {}
	for _, a in d.boosts.active do
		if type(a) == "table" and type(a.id) == "string" and type(a.endsAt) == "number" and a.endsAt == a.endsAt then
			table.insert(active, a)
		end
	end
	d.boosts.active = active
end

-- Returns ok, data (migrated in place) or ok=false, reason.
function Migrations.Migrate(d: any, now: number): (boolean, any)
	if type(d) ~= "table" then
		return false, "corrupt"
	end
	local v = d.version
	if v == nil then
		v = 0
	end
	if type(v) ~= "number" or v ~= math.floor(v) or v < 0 then
		return false, "corrupt"
	end
	if v > Migrations.CURRENT then
		return false, "newer"
	end
	while v < Migrations.CURRENT do
		local step = steps[v]
		if not step then
			return false, "no_migration"
		end
		step(d)
		v += 1
	end
	d.version = Migrations.CURRENT
	fill(d, State.New(now))
	Migrations.Sanitize(d)
	return true, d
end

return Migrations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Modifiers</string>
            <string name="Source"><![CDATA[--!strict
-- Turns a FarmState (plus passes, active boosts and the session context) into the numbers the
-- economy runs on. Pure: the same inputs always give the same outputs, so the client can show
-- exactly what the server will charge and produce.

local Eggs = require("../Data/Eggs")
local Housing = require("../Data/Housing")
local Vehicles = require("../Data/Vehicles")
local Workers = require("../Data/Workers")
local Upgrades = require("../Data/Upgrades")
local Boosts = require("../Data/Boosts")
local Silos = require("../Data/Silos")

local Modifiers = {}

Modifiers.BASE_LAY = 0.1 -- eggs per chicken per second
Modifiers.BASE_CARRY = 100
Modifiers.BASE_WALK = 20
Modifiers.BASE_AUTOSPAWN = 0.5 -- chickens per second with Auto Spawn on and no Auto Clicker levels
Modifiers.BASE_COMBO_MAX = 5
Modifiers.COMBO_PER_TAP = 0.08
Modifiers.PREMIUM_CASH = 1.2 -- verified for the reference: Premium players get +20% cash
Modifiers.STAR_BONUS = 0.05 -- +5% cash per Star Egg
Modifiers.CAP = 1e300 -- currencies are clamped here so arithmetic never reaches infinity

export type Mods = {
	layRate: number, -- eggs per chicken per second
	eggValue: number, -- cash per egg before the sale multiplier
	saleMult: number, -- every multiplier applied at sale time except the tap combo
	capacityMult: number,
	storageMult: number,
	carryCap: number,
	hatchPerHouse: number, -- chickens per second per owned house
	spawnPerTap: number,
	autoSpawnRate: number,
	tripMult: number,
	workerMult: number,
	vehicleSlots: number,
	workerSlots: number,
	comboMax: number,
	commonPriceMult: number,
	siloMinutes: number,
	walkSpeed: number,
	maxBoosts: number,
	goldMult: number,
	offlineMult: number,
}

local function lvl(t: { [string]: number }, id: string): number
	return t[id] or 0
end

local function stat(state: any, group: { Upgrades.Upgrade }, levels: { [string]: number }, name: string): number
	local total = 0
	for _, u in group do
		if u.stat == name then
			total += u.per * lvl(levels, u.id)
		end
	end
	return total
end

-- Boost multipliers by stat. "booster" doubles the bonus part (mult - 1) of the others.
function Modifiers.BoostMults(active: { { id: string, endsAt: number } }, now: number): { [string]: number }
	local out = { earn = 1, lay = 1, hatch = 1 }
	local booster = 1
	for _, a in active do
		local b = Boosts.ById[a.id]
		if b and a.endsAt > now and b.stat == "booster" then
			booster = b.mult
		end
	end
	for _, a in active do
		local b = Boosts.ById[a.id]
		if b and a.endsAt > now and b.stat ~= "booster" then
			out[b.stat] = (out[b.stat] or 1) * (1 + (b.mult - 1) * booster)
		end
	end
	return out
end

function Modifiers.Compute(state: any, now: number, ctx: { premium: boolean? }?, noBoosts: boolean?): Mods
	local common, epic, passes = state.common, state.epic, state.passes
	local egg = Eggs.List[state.egg] or Eggs.List[1]
	local boosts = if noBoosts then { earn = 1, lay = 1, hatch = 1 } else Modifiers.BoostMults(state.boosts.active, now)

	local layValue = stat(state, Upgrades.Common, common, "layValuePct")
	local layRate = Modifiers.BASE_LAY
		* (1 + stat(state, Upgrades.Common, common, "layPct") + layValue)
		* (1 + stat(state, Upgrades.Epic, epic, "epicLayPct"))
		* boosts.lay

	local valueMul = 1
	for _, u in Upgrades.Common do
		if u.stat == "valueMul" and lvl(common, u.id) > 0 then
			valueMul *= u.per ^ lvl(common, u.id)
		end
	end
	local eggValue = egg.value
		* (1 + stat(state, Upgrades.Common, common, "valuePct") + layValue)
		* valueMul
		* (1 + stat(state, Upgrades.Epic, epic, "epicValuePct"))

	local saleMult = boosts.earn
		* (if passes.x2cash then 2 else 1)
		* (if ctx and ctx.premium then Modifiers.PREMIUM_CASH else 1)
		* (1 + Modifiers.STAR_BONUS * (state.stars or 0))

	local carryLevels = lvl(common, "basket")
	local carryCap = Modifiers.BASE_CARRY * 2 ^ carryLevels * (1 + stat(state, Upgrades.Epic, epic, "epicCarryPct"))

	return {
		layRate = layRate,
		eggValue = eggValue,
		saleMult = saleMult,
		capacityMult = (1 + stat(state, Upgrades.Common, common, "capacityPct")) * (if passes.x2housing then 2 else 1),
		storageMult = 1 + stat(state, Upgrades.Common, common, "storagePct"),
		carryCap = math.floor(carryCap),
		hatchPerHouse = stat(state, Upgrades.Common, common, "hatchPerHouse")
			* (1 + stat(state, Upgrades.Epic, epic, "hatchPct"))
			* boosts.hatch,
		spawnPerTap = (1 + stat(state, Upgrades.Common, common, "spawnPerTap")) * (if passes.x2chickens then 2 else 1),
		autoSpawnRate = (Modifiers.BASE_AUTOSPAWN + stat(state, Upgrades.Epic, epic, "autoSpawnRate"))
			* (if passes.x2chickens then 2 else 1),
		tripMult = (1 - stat(state, Upgrades.Common, common, "tripPct")) * (if passes.x2shipping then 0.5 else 1),
		workerMult = (1 + stat(state, Upgrades.Common, common, "workerPct")) * (if passes.x2workers then 2 else 1),
		vehicleSlots = math.min(Vehicles.MaxSlots, Vehicles.BaseSlots + stat(state, Upgrades.Common, common, "vehicleSlots")),
		workerSlots = math.min(
			Workers.MaxSlots,
			Workers.BaseSlots + stat(state, Upgrades.Common, common, "workerSlots") + (if passes.worker_slots then 2 else 0)
		),
		comboMax = Modifiers.BASE_COMBO_MAX + stat(state, Upgrades.Epic, epic, "comboMax"),
		commonPriceMult = egg.costScale
			* (1 - stat(state, Upgrades.Epic, epic, "commonDiscount"))
			* (if passes.cheap_upgrades then 0.5 else 1),
		siloMinutes = Silos.MinutesPerSilo + stat(state, Upgrades.Epic, epic, "siloMinutes"),
		walkSpeed = Modifiers.BASE_WALK * (1 + stat(state, Upgrades.Common, common, "speedPct")),
		maxBoosts = if passes.vip then Boosts.MaxActiveVip else Boosts.MaxActive,
		goldMult = if passes.x2gold then 2 else 1,
		offlineMult = if passes.x2offline then 2 else 1,
	}
end

-- Chickens a house of `tier` holds.
function Modifiers.HouseCapacity(tier: number, m: Mods): number
	local t = Housing.Tiers[tier]
	return if t then math.floor(t.capacity * m.capacityMult) else 0
end

function Modifiers.HouseStorage(tier: number, m: Mods): number
	local t = Housing.Tiers[tier]
	return if t then math.floor(t.capacity * Housing.StoragePerChicken * m.storageMult) else 0
end

function Modifiers.TotalCapacity(state: any, m: Mods): number
	local total = 0
	for _, h in state.housing do
		total += Modifiers.HouseCapacity(h.tier, m)
	end
	return total
end

function Modifiers.VehicleCap(tier: number): number
	local t = Vehicles.Tiers[tier]
	return if t then t.capacity else 0
end

function Modifiers.VehicleTrip(tier: number, m: Mods): number
	local t = Vehicles.Tiers[tier]
	return if t then t.trip * m.tripMult else math.huge
end

function Modifiers.WorkerCarry(tier: number, m: Mods): number
	local t = Workers.Tiers[tier]
	return if t then math.floor(t.carry * m.workerMult) else 0
end

function Modifiers.WorkerCycle(tier: number): number
	local t = Workers.Tiers[tier]
	return if t then t.cycle else math.huge
end

-- Eggs per second each part of the chain can handle (for the HUD and the steady cash rate).
function Modifiers.Rates(state: any, m: Mods): { lay: number, ship: number, workers: number }
	local ship, workers = 0, 0
	for _, v in state.vehicles do
		if v.tier > 0 then
			ship += Modifiers.VehicleCap(v.tier) / Modifiers.VehicleTrip(v.tier, m)
		end
	end
	for _, w in state.workers do
		if w.tier > 0 then
			workers += Modifiers.WorkerCarry(w.tier, m) / Modifiers.WorkerCycle(w.tier)
		end
	end
	return { lay = state.population * m.layRate, ship = ship, workers = workers }
end

-- Cash per second the farm sustains (laying limited by shipping), with no temporary boosts and
-- no tap combo. Used for offline earnings and "minutes of earnings" rewards.
function Modifiers.SteadyCashRate(state: any, now: number, ctx: any?): number
	local m = Modifiers.Compute(state, now, ctx, true)
	local r = Modifiers.Rates(state, m)
	local flow = math.min(r.lay, r.ship)
	return flow * m.eggValue * m.saleMult
end

return Modifiers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlotLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Plot layout math: where every farm piece sits. PURE (plain {x, y, z} tables, no Roblox types),
-- so the CLI tests can check the layout invariants (tests/Plots.spec.luau). World.luau turns these
-- into CFrames.
--
-- Plot-local frame: origin at the plot centre on the ground (y = 0), +z points to the plot FRONT
-- (the boulevard and the entrance), -z to the back (dock, road, tunnel). x is left/right as seen
-- from the back looking at the front. A plot is PLOT_W (x) by PLOT_D (z) studs.
--
-- Collection route (front to back): spawn -> central path with the 4 collect rings on both
-- sides -> deposit ring at the warehouse door -> the dock behind the warehouse loads the vehicles,
-- which drive along the back road out of the plot into a tunnel in the hills.
--
-- World: 8 plots in two rows of 4 facing a central boulevard (along x) with the hub at the
-- origin. Plots 1-4 are the north row (world +z, rotated 180 degrees so their front faces the
-- boulevard), plots 5-8 the south row (world -z, not rotated).

export type Vec = { x: number, y: number, z: number }
export type Rect = { x0: number, z0: number, x1: number, z1: number } -- plot-local, x0 < x1, z0 < z1

export type House = {
	slot: number,
	side: number, -- -1 left column, +1 right column
	lot: Rect, -- the whole slot (pad)
	building: Vec, -- centre of the tier model footprint
	buildingMax: { w: number, d: number }, -- largest footprint a tier model may use: w across the facing, d along it
	facing: Vec, -- unit direction the building's door faces (towards the central path)
	anchor: Vec, -- centre of the flock yard
	anchorSize: { x: number, z: number }, -- yard extents (plot axes)
	ring: Vec,
	ringRadius: number,
	board: Vec,
}

export type Board = { name: string, menu: string, slot: number?, pos: Vec, look: Vec }

local V = function(x: number, y: number, z: number): Vec
	return { x = x, y = y, z = z }
end

local PlotLayout = {}

PlotLayout.PlotCount = 8
PlotLayout.PLOT_W = 180
PlotLayout.PLOT_D = 220
PlotLayout.HALF_W = 90
PlotLayout.HALF_D = 110
PlotLayout.COLUMN_SPACING = 200 -- plot centres along x (20 stud gap between plots)
PlotLayout.ROW_Z = 150 -- |z| of each row's plot centre (front edges at |z| = 40)
PlotLayout.BOULEVARD_HALF = 40 -- boulevard spans |z| < 40
PlotLayout.RIDGE_LOCAL_Z = -130 -- plot-local z of the hill face holding the road tunnel
PlotLayout.RIDGE_DEPTH = 70

-- ---------------------------------------------------------------- houses
local HOUSE_X = 44
local HOUSE_Z = { 58, 0 } -- front row, back row
PlotLayout.RING_RADIUS = 7

local houses: { House } = {}
for slot = 1, 4 do
	local side = if slot % 2 == 1 then -1 else 1
	local cz = HOUSE_Z[if slot <= 2 then 1 else 2]
	local cx = side * HOUSE_X
	houses[slot] = {
		slot = slot,
		side = side,
		lot = { x0 = cx - 22, z0 = cz - 24, x1 = cx + 22, z1 = cz + 24 },
		building = V(side * 50, 0, cz - 2),
		buildingMax = { w = 34, d = 28 },
		facing = V(-side, 0, 0),
		anchor = V(side * 28.5, 0, cz),
		anchorSize = { x = 9, z = 36 },
		ring = V(side * 13, 0, cz),
		ringRadius = PlotLayout.RING_RADIUS,
		board = V(side * 20, 0, cz + 19),
	}
end
PlotLayout.Houses = houses

-- ---------------------------------------------------------------- warehouse, dock, road
PlotLayout.Warehouse = { center = V(0, 0, -54), w = 48, d = 26 }
PlotLayout.Deposit = { pos = V(0, 0, -31), radius = 8 }
PlotLayout.Dock = { center = V(0, 0, -73), w = 100, d = 6 }
PlotLayout.ROAD_Z = -101
PlotLayout.ROAD_WIDTH = 12
PlotLayout.ROAD_X = 80 -- the exit lane runs along x = 80 out of the back of the plot

local bays: { Vec } = {}
for i = 1, 8 do
	bays[i] = V(-42 + 12 * (i - 1), 0, -83)
end
PlotLayout.Bays = bays
PlotLayout.BayFacing = V(0, 0, -1) -- parked vehicles face the road (they back into the dock)
PlotLayout.BayWidth = 10

-- Ordered waypoints after a vehicle has pulled out of its bay onto the road.
PlotLayout.Road = {
	V(56, 0, -101),
	V(74, 0, -101),
	V(80, 0, -107),
	V(80, 0, -120),
	V(80, 0, -140), -- inside the hill tunnel from here on
	V(80, 0, -175),
}
PlotLayout.TunnelAt = 5 -- index of the first waypoint inside the hill (vehicles are hidden past it)

-- Road surface rectangles (asphalt).
PlotLayout.RoadRects = {
	{ x0 = -56, z0 = -107, x1 = 86, z1 = -95 },
	{ x0 = 74, z0 = -132, x1 = 86, z1 = -107 },
}

-- ---------------------------------------------------------------- workers, silos, shed
PlotLayout.WorkerStart = V(14, 0, -34)
PlotLayout.Shed = { center = V(78, 0, -38), w = 18, d = 16 }
PlotLayout.SiloCount = 10
PlotLayout.SiloRadius = 4
local silos: { Vec } = {}
for i = 1, 10 do
	silos[i] = V(-79, 0, -56 + 11 * (i - 1))
end
PlotLayout.Silos = silos

-- ---------------------------------------------------------------- front: spawn, gate, boards
PlotLayout.Spawn = V(0, 0, 92)
PlotLayout.Gate = { pos = V(0, 0, 108), width = 24 }

local boards: { Board } = {}
for _, h in houses do
	table.insert(boards, {
		name = "Housing" .. h.slot,
		menu = "Housing",
		slot = h.slot,
		pos = h.board,
		look = V(0, 0, h.board.z),
	})
end
table.insert(boards, { name = "Shipping", menu = "Shipping", pos = V(58, 0, -80), look = V(30, 0, -60) })
table.insert(boards, { name = "Workers", menu = "Workers", pos = V(70, 0, -24), look = V(30, 0, -28) })
table.insert(boards, { name = "Silos", menu = "Silos", pos = V(-66, 0, -64), look = V(-30, 0, -40) })
table.insert(boards, { name = "Upgrades", menu = "Upgrades", pos = V(-22, 0, 94), look = V(0, 0, 88) })
table.insert(boards, { name = "Eggs", menu = "Eggs", pos = V(22, 0, 94), look = V(0, 0, 88) })
PlotLayout.Boards = boards

PlotLayout.FoxSpots = {
	V(-44, 0, 100),
	V(44, 0, 100),
	V(0, 0, 29),
	V(-80, 0, 72),
	V(80, 0, 10),
	V(80, 0, 62),
}

-- Path rectangles (themed path colour).
PlotLayout.Paths = {
	{ x0 = -8, z0 = -24, x1 = 8, z1 = 110 }, -- central path
	{ x0 = -32, z0 = 84, x1 = 32, z1 = 110 }, -- entrance plaza
	{ x0 = -66, z0 = 25, x1 = 66, z1 = 33 }, -- cross path between the house rows
	{ x0 = -30, z0 = -41, x1 = 30, z1 = -24 }, -- warehouse apron
	{ x0 = 30, z0 = -34, x1 = 69, z1 = -26 }, -- to the worker shed
	{ x0 = -74, z0 = -48, x1 = -24, z1 = -40 }, -- to the silo row
}

-- Decoration spots (trees / props by theme). Kept clear of paths, lots, silos and the road.
PlotLayout.Decor = {
	V(-70, 0, 99),
	V(70, 0, 99),
	V(-56, 0, 104),
	V(56, 0, 104),
	V(-84, 0, 88),
	V(84, 0, 88),
	V(84, 0, 40),
	V(84, 0, -12),
	V(-85, 0, 60),
	V(-84, 0, 100),
	V(-72, 0, -90),
	V(-82, 0, -102),
	V(40, 0, 88),
	V(-40, 0, 88),
}

-- Fence: perimeter segments (plot-local), leaving the entrance and the road exit open.
PlotLayout.Fence = {
	{ a = V(-90, 0, 110), b = V(-12, 0, 110) },
	{ a = V(12, 0, 110), b = V(90, 0, 110) },
	{ a = V(90, 0, 110), b = V(90, 0, -110) },
	{ a = V(-90, 0, -110), b = V(-90, 0, 110) },
	{ a = V(-90, 0, -110), b = V(72, 0, -110) },
	{ a = V(88, 0, -110), b = V(90, 0, -110) },
}

-- ---------------------------------------------------------------- world placement
-- Returns the plot centre and its yaw (radians about +y). Plots 1-4: north row, rotated pi.
function PlotLayout.Origin(index: number): (Vec, number)
	assert(index >= 1 and index <= PlotLayout.PlotCount, "plot index out of range")
	local col = (index - 1) % 4
	local north = index <= 4
	local x = (col - 1.5) * PlotLayout.COLUMN_SPACING
	if north then
		return V(x, 0, PlotLayout.ROW_Z), math.pi
	end
	return V(x, 0, -PlotLayout.ROW_Z), 0
end

-- Plot-local point -> world point (matches CFrame.new(origin) * CFrame.Angles(0, yaw, 0)).
function PlotLayout.ToWorld(index: number, p: Vec): Vec
	local o, yaw = PlotLayout.Origin(index)
	local c, s = math.cos(yaw), math.sin(yaw)
	-- rotation about +y: x' = x c + z s, z' = -x s + z c
	local x = p.x * c + p.z * s
	local z = -p.x * s + p.z * c
	return V(o.x + x, o.y + p.y, o.z + z)
end

-- World-space axis-aligned bounds of a plot.
function PlotLayout.Bounds(index: number): Rect
	local o = PlotLayout.Origin(index)
	return {
		x0 = o.x - PlotLayout.HALF_W,
		z0 = o.z - PlotLayout.HALF_D,
		x1 = o.x + PlotLayout.HALF_W,
		z1 = o.z + PlotLayout.HALF_D,
	}
end

function PlotLayout.InsideLocal(p: Vec, margin: number?): boolean
	local m = margin or 0
	return math.abs(p.x) <= PlotLayout.HALF_W - m and math.abs(p.z) <= PlotLayout.HALF_D - m
end

-- Polyline a vehicle in `bay` follows when it leaves: bay -> road -> waypoints (plot-local).
function PlotLayout.VehiclePath(bay: number): { Vec }
	local b = bays[bay] or bays[1]
	local path = { b, V(b.x, 0, PlotLayout.ROAD_Z) }
	for _, p in PlotLayout.Road do
		table.insert(path, p)
	end
	return path
end

-- Polyline a worker walks from WorkerPath/Start to a house's collect ring (plot-local).
function PlotLayout.WorkerRoute(slot: number): { Vec }
	local h = houses[slot] or houses[1]
	local s = PlotLayout.WorkerStart
	local lane = h.side * 4
	return { s, V(lane, 0, -22), V(lane, 0, h.ring.z), V(h.ring.x, 0, h.ring.z) }
end

-- Length of a polyline and the point/direction at distance d along it (clamped).
function PlotLayout.PolyLength(path: { Vec }): number
	local len = 0
	for i = 2, #path do
		local a, b = path[i - 1], path[i]
		len += math.sqrt((b.x - a.x) ^ 2 + (b.z - a.z) ^ 2)
	end
	return len
end

function PlotLayout.PolyPoint(path: { Vec }, d: number): (Vec, Vec, number)
	-- returns point, unit direction of the segment, and the segment index (2..#path)
	local rest = math.max(0, d)
	for i = 2, #path do
		local a, b = path[i - 1], path[i]
		local dx, dz = b.x - a.x, b.z - a.z
		local seg = math.sqrt(dx * dx + dz * dz)
		if seg > 0 and (rest <= seg or i == #path) then
			local f = math.min(1, rest / seg)
			return V(a.x + dx * f, 0, a.z + dz * f), V(dx / seg, 0, dz / seg), i
		end
		rest -= seg
	end
	local last = path[#path]
	return V(last.x, 0, last.z), V(0, 0, -1), #path
end

-- Distance along a vehicle path where the tunnel starts (vehicles are hidden beyond it).
function PlotLayout.TunnelDistance(bay: number): number
	local path = PlotLayout.VehiclePath(bay)
	local upto = {}
	for i = 1, PlotLayout.TunnelAt + 2 do -- bay + road point + waypoints up to TunnelAt
		upto[i] = path[i]
	end
	-- stop at the hill face, a little before the TunnelAt waypoint
	return PlotLayout.PolyLength(upto) - (PlotLayout.RIDGE_LOCAL_Z - PlotLayout.Road[PlotLayout.TunnelAt].z)
end

return PlotLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PlotRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Which player owns which plot. Pure bookkeeping so ownership rules are unit-tested:
-- one plot per player, one player per plot, released plots are reusable, and an action on a
-- plot is allowed only for its owner.

export type Registry = {
	count: number,
	owner: { [number]: number }, -- plot -> userId
	plotOf: { [number]: number }, -- userId -> plot
}

local PlotRegistry = {}

function PlotRegistry.new(count: number): Registry
	return { count = count, owner = {}, plotOf = {} }
end

-- Returns the plot index, or nil when the server is full.
function PlotRegistry.Claim(r: Registry, userId: number): number?
	if r.plotOf[userId] then
		return r.plotOf[userId]
	end
	for i = 1, r.count do
		if r.owner[i] == nil then
			r.owner[i] = userId
			r.plotOf[userId] = i
			return i
		end
	end
	return nil
end

function PlotRegistry.Release(r: Registry, userId: number): number?
	local i = r.plotOf[userId]
	if i then
		r.plotOf[userId] = nil
		r.owner[i] = nil
	end
	return i
end

function PlotRegistry.Owns(r: Registry, userId: number, plot: number): boolean
	return r.owner[plot] == userId
end

return PlotRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Prices</string>
            <string name="Source"><![CDATA[--!strict
-- Every price in the game, computed from state + modifiers. The client uses the same functions to
-- show prices and affordability; the server uses them to charge. Returns nil when the thing
-- can't be bought (locked, maxed, missing slot) together with the reason code.

local Eggs = require("../Data/Eggs")
local Housing = require("../Data/Housing")
local Vehicles = require("../Data/Vehicles")
local Workers = require("../Data/Workers")
local Upgrades = require("../Data/Upgrades")
local Silos = require("../Data/Silos")
local Modifiers = require("./Modifiers")

local Prices = {}

local function scale(state: any): number
	return (Eggs.List[state.egg] or Eggs.List[1]).costScale
end

local function round(n: number): number
	return math.max(1, math.floor(n + 0.5))
end

-- Buying an empty housing slot. Slots must be bought in order.
function Prices.BuyHouse(state: any, slot: number): (number?, string)
	local h = state.housing[slot]
	if not h then
		return nil, "invalid"
	elseif h.tier > 0 then
		return nil, "slot_taken"
	elseif slot > 1 and state.housing[slot - 1].tier == 0 then
		return nil, "slot_locked"
	end
	return round(Housing.SlotCost[slot] * scale(state)), "ok"
end

function Prices.UpgradeHouse(state: any, slot: number): (number?, string)
	local h = state.housing[slot]
	if not h or h.tier == 0 then
		return nil, "invalid"
	elseif h.tier >= Housing.MaxTier then
		return nil, "max_level"
	end
	local nextTier = Housing.Tiers[h.tier + 1]
	if state.egg < nextTier.unlockEgg then
		return nil, "locked"
	end
	return round(nextTier.cost * scale(state)), "ok"
end

function Prices.BuyVehicle(state: any, slot: number, m: Modifiers.Mods): (number?, string)
	local v = state.vehicles[slot]
	if not v or slot > m.vehicleSlots then
		return nil, if v then "locked" else "invalid"
	elseif v.tier > 0 then
		return nil, "slot_taken"
	elseif slot > 1 and state.vehicles[slot - 1].tier == 0 then
		return nil, "slot_locked"
	end
	return round(Vehicles.SlotCost[slot] * scale(state)), "ok"
end

function Prices.UpgradeVehicle(state: any, slot: number): (number?, string)
	local v = state.vehicles[slot]
	if not v or v.tier == 0 then
		return nil, "invalid"
	elseif v.tier >= Vehicles.MaxTier then
		return nil, "max_level"
	end
	local nextTier = Vehicles.Tiers[v.tier + 1]
	if state.egg < nextTier.unlockEgg then
		return nil, "locked"
	end
	return round(nextTier.cost * scale(state)), "ok"
end

function Prices.HireWorker(state: any, slot: number, m: Modifiers.Mods): (number?, string)
	local w = state.workers[slot]
	if not w or slot > m.workerSlots then
		return nil, if w then "locked" else "invalid"
	elseif w.tier > 0 then
		return nil, "slot_taken"
	elseif slot > 1 and state.workers[slot - 1].tier == 0 then
		return nil, "slot_locked"
	end
	return round(Workers.HireCost[slot] * scale(state)), "ok"
end

function Prices.UpgradeWorker(state: any, slot: number): (number?, string)
	local w = state.workers[slot]
	if not w or w.tier == 0 then
		return nil, "invalid"
	elseif w.tier >= Workers.MaxTier then
		return nil, "max_level"
	end
	local nextTier = Workers.Tiers[w.tier + 1]
	if state.egg < nextTier.unlockEgg then
		return nil, "locked"
	end
	return round(nextTier.cost * scale(state)), "ok"
end

function Prices.Silo(state: any): (number?, string)
	if state.silos >= Silos.Max then
		return nil, "max_level"
	end
	return round(Silos.BaseCost * scale(state) * Silos.CostGrowth ^ state.silos), "ok"
end

-- Common upgrades: cash. Epic upgrades: Gold Eggs (never discounted by cash discounts).
function Prices.Upgrade(state: any, id: string, m: Modifiers.Mods): (number?, string, string)
	local u = Upgrades.ById[id]
	if not u then
		return nil, "invalid", "cash"
	end
	local isEpic = table.find(Upgrades.Epic, u) ~= nil
	local levels = if isEpic then state.epic else state.common
	local level = levels[id] or 0
	if level >= u.max then
		return nil, "max_level", if isEpic then "gold" else "cash"
	elseif state.egg < u.unlockEgg then
		return nil, "locked", if isEpic then "gold" else "cash"
	end
	if isEpic then
		return round(u.base * u.growth ^ level), "ok", "gold"
	end
	return round(u.base * u.growth ^ level * m.commonPriceMult), "ok", "cash"
end

-- Gold Egg cost of SKIP: pay to rebirth before reaching the Farm Value goal (DESIGN rule; the
-- reference shows a SKIP button but its rule is unknown). Allowed from 25% of the goal.
function Prices.Skip(state: any, farmValue: number): (number?, string)
	if state.egg >= Eggs.Count then
		return nil, "last_egg"
	end
	local req = Eggs.List[state.egg].requirement
	if farmValue >= req then
		return 0, "ok"
	elseif farmValue < req * 0.25 then
		return nil, "skip_too_early"
	end
	return math.max(1, math.ceil((1 - farmValue / req) * 30 * state.egg)), "ok"
end

return Prices
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PurchaseState</string>
            <string name="Source"><![CDATA[--!strict
-- What a purchase / claim button shows. PURE (no Roblox APIs) so it is unit-tested
-- (tests/PurchaseState.spec). The UI recomputes this on every snapshot and timer tick, so
-- affordability is never stale.
--
-- Input:
--   price        number? : the cost (from Logic/Prices), or nil when it can't be bought
--   reason       string? : the reason code when price is nil (Prices codes: "max_level", "locked",
--                          "slot_locked", "slot_taken", "invalid", ...; plus "owned", "claimed",
--                          "not_ready", "tutorial")
--   balance      number  : what the player has in the matching currency
--   currency     string? : "cash" (default) | "gold" | "robux" | "free"
--   owned        boolean?: a one-time thing already owned (passes)
--   busy         boolean?: a request for this button is in flight
--   lastRejectAt number? : when the server (or a local check) last rejected this button
--   now          number  : clock used for lastRejectAt (any monotonic clock, seconds)
--
-- Output: { state, canRequest, code? }
--   state      : "loading" | "rejected" | "owned" | "max" | "locked" | "unavailable"
--                | "affordable" | "unaffordable"
--   canRequest : true only when a tap should contact the server
--   code       : Contract.Messages key explaining why a tap does nothing (for a toast)

export type Input = {
	price: number?,
	reason: string?,
	balance: number,
	currency: string?,
	owned: boolean?,
	busy: boolean?,
	lastRejectAt: number?,
	now: number,
}

export type Output = { state: string, canRequest: boolean, code: string? }

local PurchaseState = {}

PurchaseState.REJECT_SHOW = 1.2 -- seconds the red "rejected" look stays before the live state returns

local LOCKED = {
	locked = true,
	slot_locked = true,
	tutorial = true,
	not_last_egg = true,
	skip_too_early = true,
	not_requirement = true,
}

function PurchaseState.Compute(i: Input): Output
	if i.busy then
		return { state = "loading", canRequest = false, code = nil }
	end
	if i.lastRejectAt and i.now >= i.lastRejectAt and i.now - i.lastRejectAt < PurchaseState.REJECT_SHOW then
		return { state = "rejected", canRequest = false, code = nil }
	end
	if i.owned or i.reason == "owned" or i.reason == "slot_taken" or i.reason == "claimed" or i.reason == "already" then
		return { state = "owned", canRequest = false, code = "already" }
	end
	local price = i.price
	if price == nil then
		local reason = i.reason or "invalid"
		if reason == "max_level" then
			return { state = "max", canRequest = false, code = "max_level" }
		elseif LOCKED[reason] then
			return { state = "locked", canRequest = false, code = reason }
		end
		return { state = "unavailable", canRequest = false, code = reason }
	end
	-- Robux prices are paid through Roblox's own prompt: the balance isn't known here.
	if i.currency == "robux" or i.currency == "free" or price <= 0 then
		return { state = "affordable", canRequest = true, code = nil }
	end
	if i.balance >= price then
		return { state = "affordable", canRequest = true, code = nil }
	end
	return {
		state = "unaffordable",
		canRequest = false,
		code = if i.currency == "gold" then "cant_afford_gold" else "cant_afford",
	}
end

-- Short button caption for states that replace the price text (nil = show the price).
function PurchaseState.Caption(state: string): string?
	if state == "loading" then
		return "..."
	elseif state == "owned" then
		return "OWNED"
	elseif state == "max" then
		return "MAX"
	elseif state == "locked" then
		return "LOCKED"
	elseif state == "unavailable" then
		return "N/A"
	end
	return nil
end

-- Whether a failed result should show the red "rejected" state. Our own in-flight dedupe
-- ("busy") and a checkout the player cancelled themselves are not rejections.
function PurchaseState.IsRejection(result: { ok: boolean, code: string }?): boolean
	return result ~= nil and not result.ok and result.code ~= "busy" and result.code ~= "cancelled"
end

return PurchaseState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token bucket per key. The server owns the clock (`now` is always passed in by the caller),
-- so a client can never speed up its own refill.

export type Bucket = { tokens: number, last: number }
export type Limiter = {
	capacity: number,
	refillPerSecond: number,
	buckets: { [any]: Bucket },
	Allow: (self: Limiter, key: any, now: number, cost: number?) -> boolean,
	Forget: (self: Limiter, key: any) -> (),
}

local RateLimiter = {}

local function allow(self: Limiter, key: any, now: number, cost: number?): boolean
	local c = cost or 1
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.capacity, last = now }
		self.buckets[key] = b
	end
	local dt = now - b.last
	if dt > 0 then
		b.tokens = math.min(self.capacity, b.tokens + dt * self.refillPerSecond)
		b.last = now
	end
	if b.tokens >= c then
		b.tokens -= c
		return true
	end
	return false
end

local function forget(self: Limiter, key: any)
	self.buckets[key] = nil
end

function RateLimiter.new(capacity: number, refillPerSecond: number): Limiter
	return {
		capacity = capacity,
		refillPerSecond = refillPerSecond,
		buckets = {},
		Allow = allow,
		Forget = forget,
	}
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Granting rewards, and the daily/quest/gift bookkeeping. All "day" values are UTC day numbers
-- computed from the SERVER clock that the caller passes in.

local Data = require("../Data/Rewards")
local Boosts = require("../Data/Boosts")
local Eggs = require("../Data/Eggs")
local Modifiers = require("./Modifiers")

local Rewards = {}

function Rewards.Day(now: number): number
	return math.floor(now / 86400)
end

local function clampAdd(a: number, b: number): number
	return math.min(Modifiers.CAP, a + b)
end

-- Cash value of `minutes` of steady earnings (never less than the floor for the current egg).
function Rewards.CashFor(state: any, minutes: number, now: number, ctx: any?): number
	local egg = Eggs.List[state.egg] or Eggs.List[1]
	local rate = Modifiers.SteadyCashRate(state, now, ctx)
	return math.floor(math.max(rate * 60 * minutes, Data.MinCashReward * egg.value))
end

-- Adds a reward to the state. `goldBonus` = true applies the x2 Gold Eggs pass (earned gold only;
-- purchased and code gold are exact). Returns what was actually granted, for the UI.
function Rewards.Grant(state: any, reward: any, now: number, ctx: any?, goldBonus: boolean?): { [string]: any }
	local granted: { [string]: any } = {}
	if reward.gold and reward.gold > 0 then
		local g = reward.gold * (if goldBonus and state.passes.x2gold then 2 else 1)
		state.gold = clampAdd(state.gold, g)
		granted.gold = g
	end
	if reward.cashMinutes and reward.cashMinutes > 0 then
		local c = Rewards.CashFor(state, reward.cashMinutes, now, ctx)
		state.cash = clampAdd(state.cash, c)
		granted.cash = c
	end
	if reward.boosts then
		granted.boosts = {}
		for id, n in reward.boosts do
			if Boosts.ById[id] then
				local have = state.boosts.inventory[id] or 0
				local add = math.min(n, Boosts.MaxInventory - have)
				if add > 0 then
					state.boosts.inventory[id] = have + add
					granted.boosts[id] = add
				end
			end
		end
	end
	return granted
end

-- Resets per-day quest progress and gift playtime when the UTC day changes.
function Rewards.RollDay(state: any, now: number)
	local day = Rewards.Day(now)
	if state.quests.day ~= day then
		state.quests.day = day
		state.quests.progress = {}
		state.quests.claimed = {}
	end
	if state.gifts.day ~= day then
		state.gifts.day = day
		state.gifts.playtime = 0
		state.gifts.claimed = {}
	end
end

-- The quests shown on `day` (rotates through the pool; same list for everyone that day).
function Rewards.QuestsForDay(day: number): { Data.Quest }
	local pool = Data.QuestPool
	local out = {}
	local start = (day * Data.QuestsPerDay) % #pool
	for i = 0, Data.QuestsPerDay - 1 do
		table.insert(out, pool[(start + i) % #pool + 1])
	end
	return out
end

function Rewards.FindQuest(day: number, id: string): Data.Quest?
	for _, q in Rewards.QuestsForDay(day) do
		if q.id == id then
			return q
		end
	end
	return nil
end

function Rewards.Track(state: any, statName: string, amount: number)
	if amount <= 0 then
		return
	end
	state.stats[statName] = math.min(Modifiers.CAP, (state.stats[statName] or 0) + amount)
	local p = state.quests.progress
	p[statName] = math.min(Modifiers.CAP, (p[statName] or 0) + amount)
end

function Rewards.DailyCanClaim(state: any, now: number): boolean
	return state.daily.lastDay < Rewards.Day(now)
end

-- The streak day the NEXT claim would pay (1..7).
function Rewards.DailyNextDay(state: any, now: number): number
	local today = Rewards.Day(now)
	local streak = if state.daily.lastDay == today - 1 or state.daily.lastDay == today then state.daily.streak else 0
	return math.min(streak + 1, #Data.Daily) -- if already claimed today, this is tomorrow's reward
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Default FarmState and the farm reset used by rebirth and prestige.
-- RESET_FIELDS / KEPT_FIELDS are the single source of truth for what a new farm clears; the
-- Progression spec checks every FarmState field is in exactly one list.

local Housing = require("../Data/Housing")
local Vehicles = require("../Data/Vehicles")
local Workers = require("../Data/Workers")

local State = {}

State.VERSION = 1

-- Cleared when a new farm starts (rebirth, skip, prestige).
State.RESET_FIELDS = {
	"cash", "population", "hatchPartial", "invested", "housing", "carried", "warehouse",
	"vehicles", "workers", "silos", "common",
}
-- Kept across every new farm. (`egg`, `rebirths`, `prestiges` and `stars` are changed by the
-- action itself, not reset.)
State.KEPT_FIELDS = {
	"version", "createdAt", "lastSeen", "gold", "stars", "egg", "rebirths", "prestiges", "epic",
	"boosts", "quests", "daily", "gifts", "codes", "settings", "tutorial", "passes", "receipts",
	"offline", "stats",
}

function State.EmptyHousing(): { any }
	local list = {}
	for i = 1, Housing.Slots do
		list[i] = { tier = if i == 1 then 1 else 0, eggs = 0, partial = 0 }
	end
	return list
end

function State.EmptyVehicles(): { any }
	local list = {}
	for i = 1, Vehicles.MaxSlots do
		list[i] = { tier = if i == 1 then 1 else 0, load = 0, phase = "dock", t = 0 }
	end
	return list
end

function State.EmptyWorkers(): { any }
	local list = {}
	for i = 1, Workers.MaxSlots do
		list[i] = { tier = 0, load = 0, t = 0, house = 1 }
	end
	return list
end

-- Fields of a brand-new farm.
function State.ApplyFreshFarm(s: any)
	s.cash = 0
	s.population = 0
	s.hatchPartial = 0
	s.invested = 0
	s.housing = State.EmptyHousing()
	s.carried = 0
	s.warehouse = 0
	s.vehicles = State.EmptyVehicles()
	s.workers = State.EmptyWorkers()
	s.silos = 0
	s.common = {}
end

function State.New(now: number): any
	local s: any = {
		version = State.VERSION,
		createdAt = now,
		lastSeen = now,
		gold = 0,
		stars = 0,
		egg = 1,
		rebirths = 0,
		prestiges = 0,
		epic = {},
		boosts = { inventory = {}, active = {} },
		quests = { day = -1, progress = {}, claimed = {} },
		daily = { streak = 0, lastDay = -1 },
		gifts = { day = -1, playtime = 0, claimed = {} },
		codes = {},
		settings = {
			music = true,
			sfx = true,
			autoSpawn = false,
			effects = true,
			flock = "normal",
			notation = "short",
			confirmSpend = true,
		},
		tutorial = { step = 1, done = false },
		passes = {},
		receipts = {},
		offline = { pending = 0, seconds = 0 },
		stats = {},
	}
	State.ApplyFreshFarm(s)
	return s
end

-- Eggs currently anywhere on the farm (houses, basket, warehouse, workers, vehicles).
function State.EggsOnFarm(s: any): number
	local n = s.carried + s.warehouse
	for _, h in s.housing do
		n += h.eggs
	end
	for _, v in s.vehicles do
		n += v.load
	end
	for _, w in s.workers do
		n += w.load
	end
	return n
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!strict
-- Server-side tutorial progress. Each step completes from real farm state, so the tutorial can't
-- be faked from the client and a returning player whose farm already meets later steps moves on.

local Contract = require("../Contract")

local Tutorial = {}

local checks: { (s: any) -> boolean } = {
	function(s) -- spawn 20 chickens
		return s.population >= 20 or (s.stats.spawned or 0) >= 20
	end,
	function(s) -- collect from a house
		return (s.stats.collected or 0) > 0
	end,
	function(s) -- deposit at the warehouse
		return (s.stats.deposited or 0) > 0
	end,
	function(s) -- a vehicle sold eggs
		return (s.stats.sold or 0) > 0
	end,
	function(s) -- upgrade a vehicle
		for _, v in s.vehicles do
			if v.tier >= 2 then
				return true
			end
		end
		return s.rebirths > 0
	end,
	function(s) -- reach $500
		return s.cash >= 500 or s.rebirths > 0
	end,
	function(s) -- upgrade housing (or buy a second house)
		return s.housing[1].tier >= 2 or s.housing[2].tier >= 1 or s.rebirths > 0
	end,
}

Tutorial.Steps = #checks

-- Advances as many steps as are satisfied. Returns true if anything changed.
function Tutorial.Update(s: any): boolean
	if s.tutorial.done then
		return false
	end
	local changed = false
	while not s.tutorial.done and checks[s.tutorial.step] and checks[s.tutorial.step](s) do
		s.tutorial.step += 1
		changed = true
		if s.tutorial.step > #checks then
			s.tutorial.done = true
		end
	end
	return changed
end

-- What the HUD reveals at each step (the tutorial uncovers navigation as it goes).
function Tutorial.Reveals(step: number, done: boolean): { [string]: boolean }
	if done then
		return { spawn = true, counters = true, shipping = true, housing = true, nav = true, workers = true, eggs = true }
	end
	return {
		spawn = true,
		counters = step >= 2,
		shipping = step >= 5,
		housing = step >= 7,
		nav = false,
		workers = false,
		eggs = false,
	}
end

Tutorial.Text = Contract.Tutorial

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--!strict
-- Guards for anything that arrives from a client. Every remote argument passes through here
-- before it reaches game logic: wrong types, NaN, infinity, negatives and oversized strings fail.

local Validate = {}

function Validate.Finite(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Whole number in [lo, hi].
function Validate.Int(v: any, lo: number, hi: number): boolean
	return Validate.Finite(v) and v == math.floor(v) and v >= lo and v <= hi
end

-- Short identifier: letters, digits, underscore, dash. Rejects anything that is not a plain string.
function Validate.Id(v: any, maxLen: number?): boolean
	if type(v) ~= "string" then
		return false
	end
	local n = #v
	return n > 0 and n <= (maxLen or 48) and string.find(v, "^[%w_%-]+$") ~= nil
end

-- Free text (codes, names): printable ASCII only, bounded length.
function Validate.Text(v: any, maxLen: number): boolean
	if type(v) ~= "string" then
		return false
	end
	return #v > 0 and #v <= maxLen and string.find(v, "^[%w _%-!%.]+$") ~= nil
end

function Validate.Bool(v: any): boolean
	return type(v) == "boolean"
end

-- Exact membership in a list of allowed string values.
function Validate.OneOf(v: any, allowed: { string }): boolean
	if type(v) ~= "string" then
		return false
	end
	return table.find(allowed, v) ~= nil
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Models</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Chicken</string>
            <string name="Source"><![CDATA[--!strict
-- Low-poly chicken (visual only, client side). About 2 studs tall, faces -Z, Root at the feet.
-- Rig groups (attribute "Rig" on parts, pivots as model attributes "Pivot_<group>"):
--   head (head, beak, comb) dips to peck; legL / legR swing while walking.

local Kit = require("./Kit")

local Chicken = {}

local VARIANTS = {
	{ body = Color3.fromRGB(250, 250, 245), tail = Color3.fromRGB(235, 235, 228) },
	{ body = Color3.fromRGB(176, 112, 62), tail = Color3.fromRGB(120, 72, 40) },
	{ body = Color3.fromRGB(246, 214, 120), tail = Color3.fromRGB(226, 176, 70) },
	{ body = Color3.fromRGB(70, 70, 78), tail = Color3.fromRGB(40, 44, 60) },
}
Chicken.Variants = #VARIANTS

function Chicken.Build(variant: number?): Model
	local v = VARIANTS[((variant or 1) - 1) % #VARIANTS + 1]
	local m, _root = Kit.Model("Chicken", CFrame.identity, Vector3.new(0.2, 0.2, 0.2))
	local function p(name: string, size: Vector3, pos: Vector3, color: Color3, rig: string?, shape: string?): BasePart
		local part = Kit.Part(m, {
			name = name,
			size = size,
			cf = CFrame.new(pos),
			color = color,
			shape = shape,
			collide = false,
			shadow = false,
		})
		if rig then
			part:SetAttribute("Rig", rig)
		end
		return part
	end
	p("Body", Vector3.new(1.2, 1.0, 1.5), Vector3.new(0, 1.0, 0.05), v.body)
	p("Tail", Vector3.new(0.9, 0.8, 0.55), Vector3.new(0, 1.55, 0.95), v.tail, nil, "Wedge")
	p("Head", Vector3.new(0.72, 0.78, 0.72), Vector3.new(0, 1.8, -0.62), v.body, "head")
	p("Beak", Vector3.new(0.26, 0.2, 0.34), Vector3.new(0, 1.72, -1.12), Kit.Fixed.orange, "head")
	p("Comb", Vector3.new(0.16, 0.32, 0.5), Vector3.new(0, 2.33, -0.62), Kit.Fixed.red, "head")
	p("LegL", Vector3.new(0.16, 0.55, 0.16), Vector3.new(-0.27, 0.27, 0.05), Kit.Fixed.orange, "legL")
	p("LegR", Vector3.new(0.16, 0.55, 0.16), Vector3.new(0.27, 0.27, 0.05), Kit.Fixed.orange, "legR")
	m:SetAttribute("Pivot_head", Vector3.new(0, 1.35, -0.45))
	m:SetAttribute("Pivot_legL", Vector3.new(-0.27, 0.55, 0.05))
	m:SetAttribute("Pivot_legR", Vector3.new(0.27, 0.55, 0.05))
	return m
end

return Chicken
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Crate</string>
            <string name="Source"><![CDATA[--!strict
-- Egg crate carried by workers and loaded on vehicles: a wooden box with three eggs on top.
-- PrimaryPart "Root" is the box, centred; the model's bottom is 0.7 studs below the pivot.

local Kit = require("./Kit")

local Crate = {}

function Crate.Build(scale: number?): Model
	local s = scale or 1
	local m = Instance.new("Model")
	m.Name = "EggCrate"
	local box = Kit.Part(m, {
		name = "Root",
		size = Vector3.new(2.4, 1.4, 1.8) * s,
		cf = CFrame.identity,
		color = Color3.fromRGB(176, 120, 70),
		material = Enum.Material.Wood,
		collide = false,
		shadow = false,
	})
	m.PrimaryPart = box
	Kit.Part(m, {
		name = "Band",
		size = Vector3.new(2.5, 0.3, 1.9) * s,
		cf = CFrame.new(0, 0.2 * s, 0),
		color = Color3.fromRGB(130, 84, 48),
		collide = false,
		shadow = false,
	})
	for i, x in { -0.7, 0, 0.7 } do
		Kit.Egg(m, CFrame.new(x * s, 0.95 * s, (if i == 2 then -0.15 else 0.15) * s), Vector3.new(0.6, 0.8, 0.6) * s, {
			name = "Egg",
			color = Kit.Fixed.cream,
			collide = false,
			shadow = false,
		})
	end
	return m
end

return Crate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Fox</string>
            <string name="Source"><![CDATA[--!strict
-- The Lucky Fox: a small orange low-poly fox, about 2.6 studs tall, faces -Z, Root at the feet.
-- Rig group "tail" (pivot attribute Pivot_tail) can be wagged by whoever animates it.

local Kit = require("./Kit")

local Fox = {}

function Fox.Build(): Model
	local m, root = Kit.Model("LuckyFox", CFrame.identity, Vector3.new(2.4, 2.6, 4))
	root.CanQuery = true -- lets click/tap detection and prompts find the fox
	local orange = Color3.fromRGB(240, 128, 40)
	local white = Kit.Fixed.white
	local dark = Color3.fromRGB(50, 36, 30)
	local function p(name: string, size: Vector3, cf: CFrame, color: Color3, shape: string?, rig: string?)
		local part = Kit.Part(m, { name = name, size = size, cf = cf, color = color, shape = shape, collide = false, shadow = false })
		if rig then
			part:SetAttribute("Rig", rig)
		end
	end
	p("Body", Vector3.new(1.3, 1.1, 2.4), CFrame.new(0, 1.35, 0.1), orange)
	p("Chest", Vector3.new(1.0, 0.8, 0.5), CFrame.new(0, 1.2, -1.0), white)
	p("Head", Vector3.new(1.2, 1.0, 1.0), CFrame.new(0, 2.2, -1.2), orange)
	p("Snout", Vector3.new(0.6, 0.45, 0.7), CFrame.new(0, 2.0, -1.95), white)
	p("Nose", Vector3.new(0.22, 0.2, 0.2), CFrame.new(0, 2.15, -2.32), dark)
	p("EarL", Vector3.new(0.4, 0.55, 0.25), CFrame.new(-0.35, 2.95, -1.2), orange, "Wedge")
	p("EarR", Vector3.new(0.4, 0.55, 0.25), CFrame.new(0.35, 2.95, -1.2), orange, "Wedge")
	for i, pos in { Vector3.new(-0.4, 0.4, -0.8), Vector3.new(0.4, 0.4, -0.8), Vector3.new(-0.4, 0.4, 0.9), Vector3.new(0.4, 0.4, 0.9) } do
		p("Leg" .. i, Vector3.new(0.3, 0.8, 0.3), CFrame.new(pos), dark)
	end
	p("Tail", Vector3.new(0.7, 0.7, 1.6), CFrame.new(0, 1.7, 1.9) * CFrame.Angles(math.rad(25), 0, 0), orange, nil, "tail")
	p("TailTip", Vector3.new(0.55, 0.55, 0.5), CFrame.new(0, 2.05, 2.65) * CFrame.Angles(math.rad(25), 0, 0), white, nil, "tail")
	m:SetAttribute("Pivot_tail", Vector3.new(0, 1.5, 1.2))
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = Color3.fromRGB(255, 220, 90)
	sparkle.Parent = root
	return m
end

return Fox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- Part kit shared by the world builders (server) and the visual models (client).
-- Everything is a native Part/WedgePart/CornerWedgePart with flat colours for a clean low-poly
-- look. Parts are Anchored, CanTouch off and CanQuery off by default; small parts don't cast
-- shadows. A part built with `role` takes its colour from the farm theme palette and keeps the
-- role as an attribute, so Kit.Recolor can repaint a whole farm when the egg (theme) changes.

local Themes = require("../Data/Themes")

local Kit = {}

export type Palette = { [string]: Color3 }

export type Opts = {
	size: Vector3,
	cf: CFrame,
	name: string?,
	role: string?, -- theme role: ground | groundEdge | path | wood | roof | accent
	shade: number?, -- 0..1 darkening applied on top of the role colour
	color: Color3?, -- fixed colour (ignored when role is set and a palette is known)
	material: Enum.Material?,
	shape: string?, -- "Block" (default) | "Ball" | "Cylinder" | "Wedge" | "CornerWedge"
	transparency: number?,
	collide: boolean?, -- default false for small parts, true for big ones
	shadow: boolean?,
	query: boolean?,
	reflect: number?,
}

Kit.Fixed = {
	white = Color3.fromRGB(245, 245, 240),
	cream = Color3.fromRGB(250, 238, 210),
	stone = Color3.fromRGB(160, 162, 168),
	darkStone = Color3.fromRGB(96, 98, 106),
	metal = Color3.fromRGB(190, 196, 204),
	darkMetal = Color3.fromRGB(70, 74, 82),
	asphalt = Color3.fromRGB(64, 66, 72),
	glass = Color3.fromRGB(170, 220, 255),
	black = Color3.fromRGB(28, 28, 32),
	orange = Color3.fromRGB(255, 150, 40),
	red = Color3.fromRGB(220, 52, 46),
	yellow = Color3.fromRGB(255, 212, 60),
	hay = Color3.fromRGB(232, 200, 110),
	leaf = Color3.fromRGB(70, 150, 70),
	trunk = Color3.fromRGB(120, 82, 52),
	skin = Color3.fromRGB(236, 190, 150),
}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Palette for a theme key (Data/Themes). Unknown keys fall back to the meadow.
function Kit.Palette(themeKey: string?): Palette
	local th = (Themes :: any)[themeKey or "meadow"] or (Themes :: any).meadow
	return {
		ground = rgb(th.ground),
		groundEdge = rgb(th.groundEdge),
		path = rgb(th.path),
		wood = rgb(th.wood),
		roof = rgb(th.roof),
		accent = rgb(th.accent),
		fog = rgb(th.fog),
		ambient = rgb(th.ambient),
	}
end

function Kit.Decor(themeKey: string?): string
	local th = (Themes :: any)[themeKey or "meadow"] or (Themes :: any).meadow
	return th.decor
end

local function shaded(c: Color3, shade: number?): Color3
	if not shade or shade == 0 then
		return c
	end
	return c:Lerp(Color3.new(0, 0, 0), math.clamp(shade, -1, 1))
end

local current: Palette = Kit.Palette("meadow")

-- Palette used for parts built with a role until the next SetPalette (builders call this first).
function Kit.SetPalette(p: Palette)
	current = p
end

function Kit.Part(parent: Instance?, o: Opts): BasePart
	local p: BasePart
	local shape = o.shape or "Block"
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	elseif shape == "CornerWedge" then
		p = Instance.new("CornerWedgePart")
	else
		local part = Instance.new("Part")
		local sz = o.size
		if shape == "Ball" and (sz.X ~= sz.Y or sz.Y ~= sz.Z) then
			-- Ball parts are forced uniform; a stretched sphere is a block with a Sphere mesh
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		elseif shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		end
		p = part
	end
	p.Name = o.name or "Part"
	p.Anchored = true
	p.Size = o.size
	p.CFrame = o.cf
	p.Material = o.material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local big = o.size.X * o.size.Y * o.size.Z > 60 or math.max(o.size.X, o.size.Y, o.size.Z) > 12
	p.CanCollide = if o.collide == nil then big else o.collide
	p.CastShadow = if o.shadow == nil then big else o.shadow
	p.CanTouch = false
	p.CanQuery = o.query == true
	p.Transparency = o.transparency or 0
	p.Reflectance = o.reflect or 0
	if o.role then
		p:SetAttribute("Role", o.role)
		if o.shade then
			p:SetAttribute("Shade", o.shade)
		end
		p.Color = shaded(current[o.role] or o.color or Kit.Fixed.white, o.shade)
	else
		p.Color = shaded(o.color or Kit.Fixed.white, o.shade)
	end
	p.Parent = parent
	return p
end

-- Vertical cylinder standing on `base` (centre of its bottom face).
function Kit.Column(parent: Instance?, base: CFrame, height: number, diameter: number, o: { [string]: any }?): BasePart
	local opts: any = table.clone(o or {})
	opts.shape = "Cylinder"
	opts.size = Vector3.new(height, diameter, diameter)
	opts.cf = base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.pi / 2)
	return Kit.Part(parent, opts :: Opts)
end

-- Gable roof over a box of width w (x) and depth d (z), ridge along x, eaves at `cf` height.
-- Returns the two wedges.
function Kit.Gable(parent: Instance?, cf: CFrame, w: number, d: number, h: number, o: { [string]: any }?)
	local base: any = o or {}
	local a: any = table.clone(base)
	a.shape, a.size, a.cf = "Wedge", Vector3.new(w, h, d / 2), cf * CFrame.new(0, h / 2, -d / 4)
	local b: any = table.clone(base)
	b.shape, b.size, b.cf = "Wedge", Vector3.new(w, h, d / 2), cf * CFrame.new(0, h / 2, d / 4) * CFrame.Angles(0, math.pi, 0)
	return Kit.Part(parent, a :: Opts), Kit.Part(parent, b :: Opts)
end

-- Ellipsoid: a block part with a Sphere SpecialMesh (that mesh type stretches to the part's Size).
function Kit.Egg(parent: Instance?, cf: CFrame, size: Vector3, o: { [string]: any }?): BasePart
	local opts: any = table.clone(o or {})
	opts.shape = "Block"
	opts.size = size
	opts.cf = cf
	local p = Kit.Part(parent, opts :: Opts)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Repaint every role-tagged part under `root` with `palette`.
function Kit.Recolor(root: Instance, palette: Palette)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local role = d:GetAttribute("Role")
			if type(role) == "string" and palette[role] then
				local shade = d:GetAttribute("Shade")
				d.Color = shaded(palette[role], if type(shade) == "number" then shade else nil)
			end
		end
	end
end

-- New Model with an invisible Root part (PrimaryPart) at `cf`.
function Kit.Model(name: string, cf: CFrame?, rootSize: Vector3?): (Model, BasePart)
	local m = Instance.new("Model")
	m.Name = name
	local root = Kit.Part(m, {
		name = "Root",
		size = rootSize or Vector3.new(1, 1, 1),
		cf = cf or CFrame.identity,
		transparency = 1,
		collide = false,
		shadow = false,
	})
	m.PrimaryPart = root
	return m, root
end

-- A SurfaceGui text label on one face of a part.
function Kit.Label(part: BasePart, text: string, face: Enum.NormalId?, color: Color3?, ppu: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label" .. (face and face.Name or "Front")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppu or 30
	gui.LightInfluence = 0
	gui.Parent = part
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.6
	l.Text = text
	l.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = l
	return l
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Vehicle</string>
            <string name="Source"><![CDATA[--!strict
-- Shipping vehicles, one model per tier (Data/Vehicles): Farm Pickup, Delivery Van, Box Truck,
-- Egg Hauler, Double Trailer, Road Train, Hover Freighter, Sky Barge. Front faces -Z, Root at
-- ground level in the middle. Fixed colours (vehicles are not themed). Model attributes:
--   Length      overall length in studs (<= 24, fits a dock bay lane)
--   LoadOffset  Vector3 (Root space) where the egg crate sits when the vehicle is loaded
-- Max width is 8 studs so neighbouring bays (12 studs apart) never overlap.

local Kit = require("./Kit")

local Vehicle = {}

local F = Kit.Fixed
local TIRE = Color3.fromRGB(34, 34, 38)

function Vehicle.Build(tier: number?): Model
	local t = math.clamp(tier or 1, 1, 8)
	local m, _root = Kit.Model("Vehicle", CFrame.identity, Vector3.new(0.2, 0.2, 0.2))
	local function p(name: string, size: Vector3, pos: Vector3, color: Color3, opts: { [string]: any }?): BasePart
		local o: any = table.clone(opts or {})
		o.name, o.size, o.cf, o.color = name, size, CFrame.new(pos), color
		o.collide = false
		o.shadow = if o.shadow == nil then size.Magnitude > 8 else o.shadow
		return Kit.Part(m, o)
	end
	local function wheel(x: number, z: number, d: number)
		p("Wheel", Vector3.new(0.9, d, d), Vector3.new(x, d / 2, z), TIRE, { shape = "Cylinder", shadow = false })
	end
	local function wheels(halfW: number, zs: { number }, d: number)
		for _, z in zs do
			wheel(-halfW, z, d)
			wheel(halfW, z, d)
		end
	end
	local function lights(halfW: number, y: number, z: number)
		p("Light", Vector3.new(0.8, 0.5, 0.15), Vector3.new(-halfW + 0.7, y, z), Color3.fromRGB(255, 246, 200), { material = Enum.Material.Neon })
		p("Light", Vector3.new(0.8, 0.5, 0.15), Vector3.new(halfW - 0.7, y, z), Color3.fromRGB(255, 246, 200), { material = Enum.Material.Neon })
	end
	local function cab(z: number, len: number, h: number, w: number, color: Color3)
		p("Cab", Vector3.new(w, h, len), Vector3.new(0, 1.6 + h / 2, z), color)
		p("Windshield", Vector3.new(w - 0.6, h * 0.4, 0.2), Vector3.new(0, 1.6 + h * 0.68, z - len / 2 - 0.05), F.glass, { transparency = 0.15 })
		lights(w / 2, 2.2, z - len / 2 - 0.05)
	end
	local length, load = 12, Vector3.new(0, 2.5, 3)
	if t == 1 then -- Farm Pickup
		local red = Color3.fromRGB(214, 58, 48)
		p("Chassis", Vector3.new(6, 1, 12), Vector3.new(0, 1.3, 0), red)
		cab(-2.4, 4.6, 2.8, 5.6, red)
		p("BedL", Vector3.new(0.4, 1.2, 6.6), Vector3.new(-2.8, 2.4, 2.7), red)
		p("BedR", Vector3.new(0.4, 1.2, 6.6), Vector3.new(2.8, 2.4, 2.7), red)
		p("Tailgate", Vector3.new(6, 1.2, 0.4), Vector3.new(0, 2.4, 5.8), red)
		wheels(2.9, { -3.8, 3.8 }, 2.2)
	elseif t == 2 then -- Delivery Van
		length, load = 13, Vector3.new(0, 6.5, 1.5)
		p("Body", Vector3.new(6, 4.6, 9.5), Vector3.new(0, 3.5, 1.6), F.white)
		p("Hood", Vector3.new(6, 2.2, 3.2), Vector3.new(0, 2.3, -4.7), F.white)
		p("Windshield", Vector3.new(5.4, 1.8, 0.2), Vector3.new(0, 4.4, -3.2), F.glass, { transparency = 0.15 })
		p("Stripe", Vector3.new(6.1, 0.7, 9.6), Vector3.new(0, 3.2, 1.6), Color3.fromRGB(60, 150, 230))
		p("Rack", Vector3.new(5, 0.3, 6), Vector3.new(0, 5.95, 1.5), F.darkMetal)
		lights(3, 2.4, -6.35)
		wheels(2.9, { -4, 4 }, 2.2)
	elseif t == 3 then -- Box Truck
		length, load = 16, Vector3.new(0, 8.4, 2.4)
		p("Chassis", Vector3.new(6, 1, 15.5), Vector3.new(0, 1.3, 0), F.darkMetal)
		cab(-5.8, 4, 3.6, 6.6, Color3.fromRGB(56, 112, 210))
		p("Box", Vector3.new(7, 6, 11), Vector3.new(0, 4.8, 2.2), F.yellow)
		Kit.Egg(m, CFrame.new(-3.55, 4.8, 2.2), Vector3.new(0.2, 3.4, 2.6), { name = "Logo", color = F.white, collide = false, shadow = false })
		Kit.Egg(m, CFrame.new(3.55, 4.8, 2.2), Vector3.new(0.2, 3.4, 2.6), { name = "Logo", color = F.white, collide = false, shadow = false })
		wheels(3.1, { -5.6, 3.2, 6.2 }, 2.4)
	elseif t == 4 then -- Egg Hauler (semi with a giant egg on the flatbed)
		length, load = 18, Vector3.new(0, 3.1, -1.6)
		cab(-6.5, 5, 4.2, 6.6, Color3.fromRGB(200, 40, 40))
		p("Stack", Vector3.new(0.5, 3, 0.5), Vector3.new(-3.0, 6.6, -4.4), F.metal, { shape = "Block" })
		p("Stack", Vector3.new(0.5, 3, 0.5), Vector3.new(3.0, 6.6, -4.4), F.metal)
		p("Flatbed", Vector3.new(7, 0.8, 13), Vector3.new(0, 2.0, 2.4), Color3.fromRGB(150, 100, 60), { material = Enum.Material.Wood })
		Kit.Egg(m, CFrame.new(0, 5.4, 4.6), Vector3.new(5.2, 6.4, 5.2), { name = "BigEgg", color = F.cream, collide = false, shadow = true })
		wheels(3.1, { -6.5, 3.5, 6.8 }, 2.4)
	elseif t == 5 then -- Double Trailer
		length, load = 22, Vector3.new(0, 7.7, -2)
		cab(-8.6, 4.6, 4.2, 6.6, Color3.fromRGB(40, 150, 90))
		p("Trailer1", Vector3.new(7, 5.4, 8), Vector3.new(0, 4.6, -2), F.white)
		p("Trailer2", Vector3.new(7, 5.4, 8), Vector3.new(0, 4.6, 7), F.white)
		p("Band1", Vector3.new(7.1, 1, 8.1), Vector3.new(0, 3.2, -2), Color3.fromRGB(40, 150, 90))
		p("Band2", Vector3.new(7.1, 1, 8.1), Vector3.new(0, 3.2, 7), Color3.fromRGB(40, 150, 90))
		p("Hitch", Vector3.new(1, 0.6, 1.2), Vector3.new(0, 2.2, 2.5), F.darkMetal)
		wheels(3.1, { -8.6, -0.5, 4.5, 9.5 }, 2.2)
	elseif t == 6 then -- Road Train
		length, load = 24, Vector3.new(0, 7.2, -3.6)
		cab(-9.5, 5, 4.4, 6.8, Color3.fromRGB(240, 150, 30))
		p("Bullbar", Vector3.new(6.8, 1.6, 0.4), Vector3.new(0, 2.2, -12.2), F.metal)
		local colors = { Color3.fromRGB(200, 60, 50), Color3.fromRGB(60, 120, 210), Color3.fromRGB(250, 200, 50) }
		for i, z in { -3.6, 2.6, 8.8 } do
			p("Trailer", Vector3.new(6.8, 4.6, 5.6), Vector3.new(0, 4.3, z), colors[i])
		end
		wheels(3.2, { -9.5, -3.6, 2.6, 8.8 }, 2.2)
	elseif t == 7 then -- Hover Freighter
		length, load = 18, Vector3.new(0, 5.6, 2.5)
		p("Hull", Vector3.new(7, 3, 13), Vector3.new(0, 3.4, 1.5), F.metal)
		p("Nose", Vector3.new(7, 3, 4), Vector3.new(0, 3.4, -7), F.metal, { shape = "Wedge" })
		p("Canopy", Vector3.new(4.5, 1.4, 3), Vector3.new(0, 5.6, -3.5), F.glass, { transparency = 0.1, reflect = 0.2 })
		p("Stripe", Vector3.new(7.1, 0.5, 13.1), Vector3.new(0, 3.0, 1.5), Color3.fromRGB(120, 240, 255), { material = Enum.Material.Neon })
		for _, x in { -2.6, 2.6 } do
			for _, z in { -3.5, 6 } do
				Kit.Column(m, CFrame.new(x, 1.0, z), 0.6, 2.4, { name = "HoverPad", color = Color3.fromRGB(120, 240, 255), material = Enum.Material.Neon, collide = false, shadow = false })
			end
		end
		p("Fin", Vector3.new(0.4, 2.5, 2.5), Vector3.new(0, 6, 7.2), F.darkMetal, { shape = "Wedge" })
	else -- Sky Barge
		length, load = 20, Vector3.new(0, 8.4, 2)
		local hull = Color3.fromRGB(150, 96, 60)
		p("Hull", Vector3.new(7.5, 3, 14), Vector3.new(0, 6.2, 1), hull, { material = Enum.Material.Wood })
		p("Bow", Vector3.new(7.5, 3, 4), Vector3.new(0, 6.2, -8), hull, { shape = "Wedge", material = Enum.Material.Wood })
		p("Deck", Vector3.new(7, 0.3, 14), Vector3.new(0, 7.75, 1), Color3.fromRGB(190, 140, 90), { material = Enum.Material.Wood })
		Kit.Egg(m, CFrame.new(0, 15, 1), Vector3.new(7.5, 6, 15), { name = "Balloon", color = Color3.fromRGB(230, 90, 200), collide = false, shadow = true })
		for _, x in { -3, 3 } do
			for _, z in { -4, 6 } do
				p("Rope", Vector3.new(0.15, 4.6, 0.15), Vector3.new(x, 10, z), Color3.fromRGB(230, 220, 190))
			end
		end
		p("PropHub", Vector3.new(0.8, 0.8, 0.8), Vector3.new(0, 6.5, 8.3), F.darkMetal)
		p("Prop", Vector3.new(5, 0.6, 0.2), Vector3.new(0, 6.5, 8.75), F.metal)
		p("Glow", Vector3.new(5, 0.4, 10), Vector3.new(0, 4.6, 1), Color3.fromRGB(255, 200, 90), { material = Enum.Material.Neon, transparency = 0.3 })
	end
	m:SetAttribute("Length", length)
	m:SetAttribute("LoadOffset", load)
	m:SetAttribute("Tier", t)
	return m
end

return Vehicle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Worker</string>
            <string name="Source"><![CDATA[--!strict
-- Farm workers, one look per tier (Data/Workers): Farmhand, Egg Runner, Rancher, Foreman,
-- Robo Picker, Jet Courier, Mech Hauler, Star Porter. Blocky figures about 5 studs tall, facing -Z,
-- Root at the feet. Rig groups for the walk cycle: legL, legR, armL, armR (pivots as model
-- attributes Pivot_<group>). Model attribute CarryOffset: where a carried crate sits (Root space).

local Kit = require("./Kit")

local Worker = {}

type Look = {
	shirt: Color3,
	pants: Color3,
	skin: Color3,
	hat: string,
	hatColor: Color3,
	extra: string?,
	scale: number?,
}

local F = Kit.Fixed
local LOOKS: { Look } = {
	{ shirt = Color3.fromRGB(206, 64, 54), pants = Color3.fromRGB(62, 96, 168), skin = F.skin, hat = "straw", hatColor = F.hay },
	{ shirt = Color3.fromRGB(255, 196, 50), pants = Color3.fromRGB(60, 60, 70), skin = Color3.fromRGB(198, 150, 110), hat = "cap", hatColor = Color3.fromRGB(230, 70, 60) },
	{ shirt = Color3.fromRGB(120, 84, 170), pants = Color3.fromRGB(70, 80, 110), skin = F.skin, hat = "cowboy", hatColor = Color3.fromRGB(130, 86, 50), extra = "bandana" },
	{ shirt = Color3.fromRGB(255, 140, 30), pants = Color3.fromRGB(50, 64, 90), skin = Color3.fromRGB(150, 104, 74), hat = "hardhat", hatColor = F.yellow, extra = "clipboard" },
	{ shirt = F.metal, pants = F.darkMetal, skin = F.metal, hat = "robot", hatColor = Color3.fromRGB(80, 230, 255) },
	{ shirt = Color3.fromRGB(40, 170, 170), pants = Color3.fromRGB(40, 50, 70), skin = F.skin, hat = "helmet", hatColor = F.white, extra = "jetpack" },
	{ shirt = F.darkMetal, pants = Color3.fromRGB(50, 52, 58), skin = F.darkMetal, hat = "mech", hatColor = Color3.fromRGB(255, 170, 40), extra = "mech" },
	{ shirt = F.white, pants = Color3.fromRGB(220, 224, 236), skin = F.white, hat = "astro", hatColor = Color3.fromRGB(255, 200, 60), extra = "star" },
}
Worker.Tiers = #LOOKS

function Worker.Build(tier: number?): Model
	local look = LOOKS[math.clamp(tier or 1, 1, #LOOKS)]
	local s = look.scale or 1
	if look.extra == "mech" then
		s = 1.25
	end
	local m, _root = Kit.Model("Worker", CFrame.identity, Vector3.new(0.2, 0.2, 0.2))
	local function p(name: string, size: Vector3, pos: Vector3, color: Color3, rig: string?, opts: { [string]: any }?): BasePart
		local o: any = table.clone(opts or {})
		o.name, o.size, o.cf, o.color = name, size * s, CFrame.new(pos * s), color
		o.collide = false
		o.shadow = false
		local part = Kit.Part(m, o)
		if rig then
			part:SetAttribute("Rig", rig)
		end
		return part
	end
	-- body
	p("LegL", Vector3.new(0.85, 2, 0.9), Vector3.new(-0.48, 1, 0), look.pants, "legL")
	p("LegR", Vector3.new(0.85, 2, 0.9), Vector3.new(0.48, 1, 0), look.pants, "legR")
	p("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), look.shirt)
	p("ArmL", Vector3.new(0.7, 1.9, 0.75), Vector3.new(-1.38, 3.05, 0), look.shirt, "armL")
	p("ArmR", Vector3.new(0.7, 1.9, 0.75), Vector3.new(1.38, 3.05, 0), look.shirt, "armR")
	p("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), look.skin)
	local hc = look.hatColor
	if look.hat == "straw" then
		p("HatBrim", Vector3.new(2.4, 0.15, 2.4), Vector3.new(0, 5.25, 0), hc)
		p("HatTop", Vector3.new(1.3, 0.55, 1.3), Vector3.new(0, 5.55, 0), hc)
		p("Bib", Vector3.new(1.4, 1.1, 0.12), Vector3.new(0, 2.6, -0.52), look.pants)
	elseif look.hat == "cap" then
		p("Cap", Vector3.new(1.3, 0.45, 1.3), Vector3.new(0, 5.35, 0), hc)
		p("Visor", Vector3.new(1.1, 0.12, 0.7), Vector3.new(0, 5.15, -0.9), hc)
	elseif look.hat == "cowboy" then
		p("HatBrim", Vector3.new(2.6, 0.15, 2.0), Vector3.new(0, 5.25, 0), hc)
		p("HatTop", Vector3.new(1.2, 0.7, 1.2), Vector3.new(0, 5.65, 0), hc)
	elseif look.hat == "hardhat" then
		p("Hard", Vector3.new(1.45, 0.8, 1.45), Vector3.new(0, 5.35, 0), hc, nil, { shape = "Ball" })
		p("HardBrim", Vector3.new(1.6, 0.12, 1.7), Vector3.new(0, 5.2, -0.1), hc)
		p("Stripe", Vector3.new(2.02, 0.25, 1.02), Vector3.new(0, 3.2, 0), Color3.fromRGB(230, 230, 210), nil, { material = Enum.Material.Neon })
	elseif look.hat == "robot" then
		p("Visor", Vector3.new(1.0, 0.35, 0.1), Vector3.new(0, 4.7, -0.62), hc, nil, { material = Enum.Material.Neon })
		p("Antenna", Vector3.new(0.12, 0.7, 0.12), Vector3.new(0, 5.5, 0), F.darkMetal)
		p("AntennaTip", Vector3.new(0.3, 0.3, 0.3), Vector3.new(0, 5.9, 0), hc, nil, { material = Enum.Material.Neon, shape = "Ball" })
	elseif look.hat == "helmet" then
		p("Helmet", Vector3.new(1.5, 1.45, 1.5), Vector3.new(0, 4.75, 0), hc)
		p("Visor", Vector3.new(1.1, 0.5, 0.1), Vector3.new(0, 4.75, -0.76), F.glass, nil, { transparency = 0.2 })
	elseif look.hat == "mech" then
		p("Cockpit", Vector3.new(1.0, 0.5, 0.1), Vector3.new(0, 4.65, -0.62), hc, nil, { material = Enum.Material.Neon })
		p("PadL", Vector3.new(1.0, 0.6, 1.2), Vector3.new(-1.4, 4.1, 0), hc)
		p("PadR", Vector3.new(1.0, 0.6, 1.2), Vector3.new(1.4, 4.1, 0), hc)
	elseif look.hat == "astro" then
		p("Helmet", Vector3.new(1.6, 1.6, 1.6), Vector3.new(0, 4.7, 0), F.white, nil, { shape = "Ball" })
		p("Visor", Vector3.new(1.1, 0.6, 0.15), Vector3.new(0, 4.75, -0.72), hc, nil, { reflect = 0.3 })
	end
	if look.extra == "bandana" then
		p("Bandana", Vector3.new(1.25, 0.35, 1.25), Vector3.new(0, 4.05, 0), Kit.Fixed.red)
	elseif look.extra == "clipboard" then
		p("Clipboard", Vector3.new(0.12, 1.0, 0.8), Vector3.new(-1.78, 2.6, -0.3), F.cream, "armL")
	elseif look.extra == "jetpack" then
		for _, x in { -0.45, 0.45 } do
			p("Jet", Vector3.new(0.7, 1.6, 0.7), Vector3.new(x, 3.1, 0.85), F.metal)
			p("Flame", Vector3.new(0.45, 0.6, 0.45), Vector3.new(x, 2.0, 0.85), F.orange, nil, { material = Enum.Material.Neon })
		end
	elseif look.extra == "star" then
		p("Badge", Vector3.new(0.6, 0.6, 0.1), Vector3.new(-0.5, 3.4, -0.52), hc, nil, { material = Enum.Material.Neon })
		p("Pack", Vector3.new(1.6, 1.8, 0.7), Vector3.new(0, 3.1, 0.85), Color3.fromRGB(200, 204, 216))
		p("PackLight", Vector3.new(0.3, 0.3, 0.1), Vector3.new(0.5, 3.6, 1.22), Color3.fromRGB(120, 240, 255), nil, { material = Enum.Material.Neon })
	end
	m:SetAttribute("Pivot_legL", Vector3.new(-0.48, 2, 0) * s)
	m:SetAttribute("Pivot_legR", Vector3.new(0.48, 2, 0) * s)
	m:SetAttribute("Pivot_armL", Vector3.new(-1.38, 3.9, 0) * s)
	m:SetAttribute("Pivot_armR", Vector3.new(1.38, 3.9, 0) * s)
	m:SetAttribute("CarryOffset", Vector3.new(0, 3.0, -1.5) * s)
	return m
end

return Worker
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote objects. The server creates them; clients wait for them.
--   Action   (RemoteFunction)  client -> server: FarmAction -> ActionResult
--   Snapshot (RemoteEvent)     server -> owner:  FarmSnapshot (throttled, only when changed)
--   FarmEvent(RemoteEvent)     server -> owner:  (name, data) for effects and toasts
--   Commerce (RemoteFunction)  client -> server: { productId } -> result (checkout adapter)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local DEFS: { [string]: string } = {
	Action = "RemoteFunction",
	Commerce = "RemoteFunction",
	Snapshot = "RemoteEvent",
	FarmEvent = "RemoteEvent",
}

local folder: Folder
if RunService:IsServer() then
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
	end
	folder = f :: Folder
	for name, class in DEFS do
		if not folder:FindFirstChild(name) then
			local r = Instance.new(class)
			r.Name = name
			r.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.Get(name: string): Instance
	assert(DEFS[name], "unknown remote " .. name)
	return folder:WaitForChild(name)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- The shared contract between server, client and tests.
--   FarmState    : the saved, server-owned record of one player's farm (plain tables only, so it
--                  can be stored by ProfileStore). Only the server ever writes it.
--   FarmAction   : what a client may ASK for. It names an intent and, where it matters, the level
--                  the client believes is current (`expect`) so double taps and stale menus are
--                  rejected instead of buying twice. It never carries prices, rewards or balances.
--   FarmSnapshot : what the owner's client is shown. Derived from FarmState + modifiers.
-- Field-by-field reset/keep rules for rebirth and prestige are in Logic/Progression.luau.

export type HouseSlot = {
	tier: number, -- 0 = slot not bought yet
	eggs: number, -- whole eggs stored, waiting to be collected
	partial: number, -- fraction of the next egg (0 <= partial < 1)
}

export type VehicleSlot = {
	tier: number, -- 0 = empty slot
	load: number, -- eggs aboard (left the warehouse, not sold yet)
	phase: string, -- "dock" | "out" | "back"
	t: number, -- seconds spent in the current phase
}

export type WorkerSlot = {
	tier: number, -- 0 = not hired
	load: number, -- eggs carried (left a house, not deposited yet)
	t: number, -- seconds into the current cycle
	house: number, -- house slot targeted this cycle
}

export type ActiveBoost = { id: string, endsAt: number }

export type Settings = {
	music: boolean,
	sfx: boolean,
	autoSpawn: boolean,
	effects: boolean,
	flock: string, -- "low" | "normal" | "high" visible chickens
	notation: string, -- "short" | "scientific"
	confirmSpend: boolean, -- ask before Gold Egg purchases
}

export type FarmState = {
	version: number,
	createdAt: number,
	lastSeen: number, -- server time of the last save/step (offline earnings)
	cash: number,
	gold: number,
	stars: number, -- Star Eggs from prestige (permanent multiplier)
	population: number,
	hatchPartial: number,
	egg: number, -- current egg index (Data/Eggs)
	rebirths: number,
	prestiges: number,
	invested: number, -- cash spent on this farm (part of Farm Value)
	housing: { HouseSlot },
	carried: number,
	warehouse: number,
	vehicles: { VehicleSlot },
	workers: { WorkerSlot },
	silos: number,
	common: { [string]: number },
	epic: { [string]: number },
	boosts: { inventory: { [string]: number }, active: { ActiveBoost } },
	quests: { day: number, progress: { [string]: number }, claimed: { [string]: boolean } },
	daily: { streak: number, lastDay: number },
	gifts: { day: number, playtime: number, claimed: { [string]: boolean } }, -- keys "1".."6"
	codes: { [string]: boolean },
	settings: Settings,
	tutorial: { step: number, done: boolean },
	passes: { [string]: boolean },
	receipts: { [string]: number }, -- processed purchase ids -> time (replay protection)
	offline: { pending: number, seconds: number }, -- silo earnings waiting to be claimed
	stats: { [string]: number }, -- lifetime counters (spawned, laid, collected, deposited, sold, cashEarned, discarded, ...)
}

-- Every action a client can request. `seq` is a per-session increasing number: the server drops
-- anything not newer than the last one it handled (replays and duplicates).
export type FarmAction = {
	type: string,
	seq: number?,
	slot: number?, -- housing / vehicle / worker slot
	expect: number?, -- level/tier the client believes is current
	id: string?, -- upgrade / boost / quest / product id
	index: number?, -- gift index
	text: string?, -- code text
	value: any?, -- setting value
}

export type ActionResult = { ok: boolean, code: string, message: string? }

export type FarmSnapshot = {
	serverNow: number,
	cash: number,
	gold: number,
	stars: number,
	population: number,
	capacity: number,
	egg: number,
	eggValue: number,
	farmValue: number,
	nextRequirement: number,
	canRebirth: boolean,
	canPrestige: boolean,
	skipCost: number,
	rebirths: number,
	prestiges: number,
	combo: number, -- cash multiplier from tapping (1 = none)
	comboMax: number,
	spawnPerTap: number,
	autoSpawnRate: number,
	rates: { lay: number, hatch: number, ship: number, workers: number, cash: number },
	mods: { [string]: number },
	housing: { { tier: number, eggs: number, storage: number, capacity: number, occupants: number } },
	carried: number,
	carryCap: number,
	warehouse: number,
	vehicles: { { tier: number, load: number, phase: string, t: number, trip: number, cap: number } },
	vehicleSlots: number,
	workers: { { tier: number, load: number, t: number, cycle: number, house: number } },
	workerSlots: number,
	silos: number,
	permanentSilos: number,
	common: { [string]: number },
	epic: { [string]: number },
	boosts: { inventory: { [string]: number }, active: { ActiveBoost }, maxActive: number },
	quests: { day: number, list: { { id: string, progress: number, target: number, claimed: boolean } } },
	daily: { streak: number, canClaim: boolean, nextDay: number, resetsIn: number },
	gifts: { playtime: number, claimed: { [string]: boolean } },
	settings: Settings,
	tutorial: { step: number, done: boolean },
	passes: { [string]: boolean },
	offline: { pending: number, seconds: number },
	walkSpeed: number,
}

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="41">
      <Properties>
        <string name="Name">TestFixtures</string>
      </Properties>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Fixtures</string>
          <string name="Source"><![CDATA[--!strict
-- SYNTHETIC TEST FIXTURES (test place + unit tests only; never shipped in default.project.json).
-- Each fixture mutates a FarmState to reach a late-game situation quickly. They are not balance.
-- Pure Luau with no requires: callers pass the catalogs in.

local Fixtures = {}

-- Everything bought on the current egg (respecting unlock rules), plenty of cash/gold.
function Fixtures.Maxed(s: any, cat: any)
	s.tutorial.step, s.tutorial.done = 8, true
	for _, h in s.housing do
		local t = 1
		for i, tier in cat.Housing.Tiers do
			if tier.unlockEgg <= s.egg then
				t = i
			end
		end
		h.tier = t
	end
	for i, v in s.vehicles do
		if i <= 4 then
			local t = 1
			for k, tier in cat.Vehicles.Tiers do
				if tier.unlockEgg <= s.egg then
					t = k
				end
			end
			v.tier = t
		end
	end
	for i, w in s.workers do
		if i <= 2 then
			local t = 1
			for k, tier in cat.Workers.Tiers do
				if tier.unlockEgg <= s.egg then
					t = k
				end
			end
			w.tier = t
		end
	end
	for _, u in cat.Upgrades.Common do
		if u.unlockEgg <= s.egg then
			s.common[u.id] = u.max
		end
	end
	s.silos = 5
	s.gold = math.max(s.gold, 5000)
end

-- Jump to egg `n` with enough cash to rebirth from it.
function Fixtures.AtEgg(s: any, n: number, cat: any)
	s.tutorial.step, s.tutorial.done = 8, true
	s.egg = math.clamp(n, 1, cat.Eggs.Count)
	s.cash = cat.Eggs.List[s.egg].requirement
end

-- Every boost in the inventory.
function Fixtures.AllBoosts(s: any, cat: any)
	for _, b in cat.Boosts.List do
		s.boosts.inventory[b.id] = (s.boosts.inventory[b.id] or 0) + 3
	end
end

-- Quest progress complete for today.
function Fixtures.QuestsReady(s: any)
	for _, stat in { "spawned", "collected", "deposited", "sold", "upgrades", "playtime", "boostsUsed", "foxes" } do
		s.quests.progress[stat] = 1e9
	end
end

return Fixtures
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="43">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="44">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Commerce</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">TestCheckout</string>
            <string name="Source"><![CDATA[--!strict
-- SIMULATED checkout used only by the test place (and unit tests). It never contacts Roblox,
-- never opens a paid purchase prompt and never spends Robux. Purchase ids are prefixed "TEST-"
-- and the test place saves to memory only, so simulated entitlements can't reach real profiles.
--   mode "success" -> grants through the same Economy.GrantProduct path real receipts use
--   mode "cancel"  -> nothing granted ("cancelled")
--   mode "fail"    -> nothing granted ("failed")

local TestCheckout = {}
TestCheckout.Kind = "test"

export type Checkout = {
	mode: string,
	products: { ById: { [string]: any } },
	counter: number,
	Buy: (self: Checkout, productId: string, grant: (productId: string, purchaseId: string) -> (boolean, string)) -> { ok: boolean, code: string, message: string? },
}

local function buy(self: Checkout, productId: string, grant: (string, string) -> (boolean, string))
	local p = self.products.ById[productId]
	if not p or p.kind == "gold" then
		return { ok = false, code = "invalid", message = "That item isn't sold for Robux." }
	end
	if self.mode == "cancel" then
		return { ok = false, code = "cancelled", message = "(Test) Purchase cancelled." }
	elseif self.mode == "fail" then
		return { ok = false, code = "failed", message = "(Test) Purchase failed. Nothing was charged." }
	end
	self.counter += 1
	local ok, code = grant(productId, string.format("TEST-%s-%d", productId, self.counter))
	if not ok then
		return { ok = false, code = code, message = "That purchase could not be completed." }
	end
	return { ok = true, code = "ok", message = "(Test) Purchased " .. p.name .. "!" }
end

-- `products` is shared/Data/Products (passed in so this module has no cross-service requires).
function TestCheckout.new(products: any, mode: string?): Checkout
	return { mode = mode or "success", products = products, counter = 0, Buy = buy }
end

return TestCheckout
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict
-- Redeem codes. SERVER ONLY (lives in ServerScriptService, never replicated), so codes can't be
-- read by exploiters before you announce them. Keys must be UPPERCASE; players can type any case.
-- reward uses the Reward shape from Data/Rewards: { gold?, cashMinutes?, boosts? }.
-- expires = optional unix time (server clock) after which the code says "expired".
-- These are this game's own launch codes (DESIGN); the reference's codes are not reused.

return {
	EGGFARM = { reward = { gold = 25 } },
	WELCOME = { reward = { boosts = { earn3 = 1 } } },
	HATCHED = { reward = { boosts = { lay2 = 1 }, gold = 10 } },
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="49">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Egg Farm server bootstrap. Picks production or test adapters, starts services in order, and
-- runs the player lifecycle: claim plot -> load save -> spawn character -> play -> release.
-- The test place is detected by ServerScriptService.TestHarness (only test.project.json has it).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameInfo = require(Shared.GameInfo)
local Net = require(Shared.Net) -- creates the remotes
local _ = Net

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local FarmService = require(Services.FarmService)
local PlotService = require(Services.PlotService)
local ZoneService = require(Services.ZoneService)
local CommerceService = require(Services.CommerceService)
local FoxService = require(Services.FoxService)
local World = require(script.Parent:WaitForChild("World"):WaitForChild("World"))

Players.CharacterAutoLoads = false

local harness = ServerScriptService:FindFirstChild("TestHarness")
local ctx: any = {
	World = World,
	DataService = DataService,
	FarmService = FarmService,
	PlotService = PlotService,
	ZoneService = ZoneService,
	CommerceService = CommerceService,
	FoxService = FoxService,
	IsTest = harness ~= nil,
}

if harness then
	-- TEST PLACE: memory saves + simulated checkout + dev tools. Never used by the real game.
	local setup = require(harness:WaitForChild("TestSetup"))
	setup.Configure(ctx)
	print("[EggFarm] TEST PLACE: in-memory saves, simulated checkout. Nothing here touches real data.")
else
	local Adapter = require(script.Parent.Persistence.ProfileStoreAdapter)
	ctx.PersistenceAdapter = Adapter.new(GameInfo.SaveStoreName, DataService.Template())
end

DataService.Init(ctx)
PlotService.Init(ctx)
FarmService.Init(ctx)
ZoneService.Init(ctx)
CommerceService.Init(ctx)
FoxService.Init(ctx)
if ctx.AfterInit then
	ctx.AfterInit(ctx)
end
FarmService.Start()
ZoneService.Start()

local function spawnCharacter(player: Player)
	if player.Parent ~= Players then
		return
	end
	player:LoadCharacter()
end

local function onCharacter(player: Player, character: Model)
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	local farm = FarmService.Get(player)
	if farm then
		hum.WalkSpeed = farm:Snapshot(FarmService.Now()).walkSpeed
	end
	hum.Died:Connect(function()
		task.delay(3, spawnCharacter, player)
	end)
end

local function onJoin(player: Player)
	player.CharacterAdded:Connect(function(c)
		onCharacter(player, c)
	end)
	local index = PlotService.Claim(player)
	if not index then
		player:Kick("This server is full. Please join another server!")
		return
	end
	local ok = FarmService.Load(player)
	if not ok then
		-- only release if this Player is still here: if they left during the load and already
		-- rejoined, the registry (keyed by UserId) now belongs to the NEW session's plot
		if player.Parent == Players then
			PlotService.Release(player)
		end
		return
	end
	spawnCharacter(player)
	FoxService.StartFor(player)
end

local function onLeave(player: Player)
	FoxService.Cleanup(player)
	FarmService.Unload(player)
	PlotService.Release(player)
end

Players.PlayerAdded:Connect(onJoin)
Players.PlayerRemoving:Connect(onLeave)
for _, p in Players:GetPlayers() do
	task.spawn(onJoin, p)
end

game:BindToClose(function()
	DataService.Closing = true
	-- ProfileStore also flushes on close; releasing here makes the memory adapter consistent too
	for _, p in Players:GetPlayers() do
		pcall(onLeave, p)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Persistence</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">MemoryAdapter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Test-place persistence: wraps MemoryStore with the ProfileStoreAdapter contract. Saves live in
-- server memory only (they survive leaving and rejoining the same running server, which is how the
-- test place exercises reconnects). Never touches DataStores, so test progress and simulated
-- purchases can't reach real profiles. Fault injection: adapter.store.failLoads / failSaves.

local MemoryStore = require(script.Parent:WaitForChild("MemoryStore"))

local Adapter = {}
Adapter.__index = Adapter
Adapter.Kind = "memory"

function Adapter.new(template: () -> { [string]: any }, sessionId: string)
	local self = setmetatable({}, Adapter)
	self.store = MemoryStore.new(template, os.clock)
	self.store.stealAfter = 30
	self.session = sessionId
	return self
end

function Adapter:Load(key: string, cancel: () -> boolean)
	local r = self.store:Load(key, self.session)
	if not r.ok then
		return { ok = false, reason = r.reason }
	end
	return { ok = true, isNew = r.isNew, handle = r.handle }
end

function Adapter:SetData(handle, data)
	handle.data = data
end

function Adapter:IsActive(handle): boolean
	return handle.active
end

function Adapter:Save(handle): (boolean, string?)
	return self.store:Save(handle)
end

function Adapter:WaitForSave(handle, check: (any) -> boolean, timeout: number): boolean
	local ok = self.store:Save(handle)
	return ok and check(handle.data)
end

function Adapter:OnSessionEnd(handle, fn: () -> ()) end

function Adapter:Release(handle): (boolean, string?)
	-- Retry an interrupted final save a few times before giving up the lock. Retries go through
	-- Save (which keeps the lock); MemoryStore.Release clears the lock even when its save fails,
	-- so retrying Release itself could only ever answer "session lost".
	if not handle.active then
		return true, nil
	end
	for _ = 1, 3 do
		local ok, err = self.store:Save(handle)
		if ok then
			return self.store:Release(handle)
		end
		if err == "session lost" then
			handle.active = false
			return false, err
		end
	end
	-- give up: unlock so the player can rejoin; the last good copy stays in the store
	self.store:Release(handle)
	return false, "save failed"
end

return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">MemoryStore</string>
            <string name="Source"><![CDATA[--!strict
-- In-memory persistence adapter with the same contract as ProfileStoreAdapter.
-- Used by the unit tests and the unpublished Studio test place. It models the things that go
-- wrong with real DataStores so the save rules can be tested offline:
--   * session locks held by another server (conflicts), with an optional steal timeout
--   * load failures (the caller must NOT fall back to a default profile)
--   * save failures / interrupted saves (the last good copy stays; the next save retries)
-- Nothing here touches Roblox services. Results from this adapter are NOT DataStore validation.

export type Handle = {
	key: string,
	session: string,
	active: boolean,
	data: { [string]: any },
}

export type LoadResult = {
	ok: boolean,
	reason: string?, -- "error" | "locked" when ok is false
	handle: Handle?,
	isNew: boolean?,
}

export type Store = {
	records: { [string]: { data: any?, lock: string?, lockAt: number } },
	failLoads: number,
	failSaves: number,
	stealAfter: number?,
	clock: () -> number,
	template: () -> { [string]: any },
	saves: number,
	Load: (self: Store, key: string, session: string) -> LoadResult,
	Save: (self: Store, handle: Handle) -> (boolean, string?),
	Release: (self: Store, handle: Handle) -> (boolean, string?),
	Peek: (self: Store, key: string) -> any,
}

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

local MemoryStore = {}
MemoryStore.DeepCopy = deepCopy

local function load(self: Store, key: string, session: string): LoadResult
	if self.failLoads > 0 then
		self.failLoads -= 1
		return { ok = false, reason = "error" }
	end
	local rec = self.records[key]
	if rec and rec.lock and rec.lock ~= session then
		local held = self.clock() - rec.lockAt
		if not self.stealAfter or held < self.stealAfter then
			return { ok = false, reason = "locked" }
		end
	end
	local isNew = rec == nil or rec.data == nil
	if not rec then
		rec = { data = nil, lock = nil, lockAt = 0 }
		self.records[key] = rec
	end
	rec.lock = session
	rec.lockAt = self.clock()
	local data = if isNew then self.template() else deepCopy(rec.data)
	return { ok = true, isNew = isNew, handle = { key = key, session = session, active = true, data = data } }
end

local function save(self: Store, handle: Handle): (boolean, string?)
	local rec = self.records[handle.key]
	if not handle.active or not rec or rec.lock ~= handle.session then
		return false, "session lost"
	end
	if self.failSaves > 0 then
		self.failSaves -= 1
		return false, "save failed"
	end
	rec.data = deepCopy(handle.data)
	rec.lockAt = self.clock()
	self.saves += 1
	return true, nil
end

local function release(self: Store, handle: Handle): (boolean, string?)
	if not handle.active then
		return true, nil
	end
	local ok, err = save(self, handle)
	local rec = self.records[handle.key]
	if rec and rec.lock == handle.session then
		rec.lock = nil
	end
	handle.active = false
	return ok, err
end

function MemoryStore.new(template: () -> { [string]: any }, clock: (() -> number)?): Store
	return {
		records = {},
		failLoads = 0,
		failSaves = 0,
		stealAfter = nil,
		clock = clock or os.clock,
		template = template,
		saves = 0,
		Load = load,
		Save = save,
		Release = release,
		Peek = function(self: Store, key: string)
			local rec = self.records[key]
			return rec and deepCopy(rec.data)
		end,
	}
end

return MemoryStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">ProfileStoreAdapter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Production persistence: ProfileStore (vendored, pinned; see LICENSES.md) with session locking.
-- Same contract as MemoryStore: Load / Save / Release / WaitForSave. A load that fails, is
-- cancelled, or loses a session conflict returns ok = false and NO data, so the caller can never
-- fall back to a default profile that would overwrite real progress.

local ServerScriptService = game:GetService("ServerScriptService")

local ProfileStore = require(ServerScriptService:WaitForChild("Vendor"):WaitForChild("ProfileStore"))

local Adapter = {}
Adapter.__index = Adapter
Adapter.Kind = "profilestore"

-- template: a FarmState with createdAt = 0 (marks "never saved").
function Adapter.new(storeName: string, template: { [string]: any })
	local self = setmetatable({}, Adapter)
	self.store = ProfileStore.New(storeName, template)
	return self
end

-- cancel(): return true to abandon the load (player left).
function Adapter:Load(key: string, cancel: () -> boolean)
	local ok, profileOrErr = pcall(function()
		return self.store:StartSessionAsync(key, { Cancel = cancel })
	end)
	if not ok then
		return { ok = false, reason = "error", detail = tostring(profileOrErr) }
	end
	local profile = profileOrErr
	if profile == nil then
		return { ok = false, reason = if cancel() then "cancelled" else "error" }
	end
	local handle = { key = key, profile = profile, active = true, data = profile.Data }
	return { ok = true, isNew = profile.Data.createdAt == 0, handle = handle }
end

-- Replace the saved table (after migration). Only valid while the session is active.
function Adapter:SetData(handle, data)
	handle.profile.Data = data
	handle.data = data
end

function Adapter:IsActive(handle): boolean
	return handle.active and handle.profile:IsActive()
end

-- Requests a save (ProfileStore saves asynchronously; it also autosaves on its own).
function Adapter:Save(handle): (boolean, string?)
	if not self:IsActive(handle) then
		return false, "session lost"
	end
	handle.profile:Save()
	return true, nil
end

-- Yields until a save that includes `check(lastSavedData)` lands, or timeout. Used by receipts.
function Adapter:WaitForSave(handle, check: (any) -> boolean, timeout: number): boolean
	if not self:IsActive(handle) then
		return false
	end
	local done = false
	local conn = handle.profile.OnAfterSave:Connect(function(lastSaved)
		if check(lastSaved) then
			done = true
		end
	end)
	handle.profile:Save()
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout and self:IsActive(handle) do
		task.wait(0.25)
	end
	conn:Disconnect()
	return done
end

function Adapter:OnSessionEnd(handle, fn: () -> ())
	handle.profile.OnSessionEnd:Connect(fn)
end

-- true once ProfileStore's own BindToClose has started ending sessions
function Adapter:IsClosing(): boolean
	return ProfileStore.IsClosing == true
end

function Adapter:Release(handle): (boolean, string?)
	if handle.active then
		handle.active = false
		handle.profile:EndSession() -- final save happens inside ProfileStore (with retries)
	end
	return true, nil
end

return Adapter
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">CommerceService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Robux checkout. Two adapters:
--   * "roblox": MarketplaceService prompts + ProcessReceipt. Every product in Data/Products has
--     robuxId = nil until the owner creates their own passes/products, so the shop answers
--     "not_configured" and NEVER opens a checkout for an unconfigured item.
--   * "test":   Commerce/TestCheckout simulates success / cancel / fail (test place only). No
--     Roblox purchase prompt, no Robux, purchase ids prefixed "TEST-", memory-only saves.
-- Grants go through Economy.GrantProduct, which records the purchase id so a receipt delivered
-- twice can't grant twice.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Products = require(Shared.Data.Products)
local Validate = require(Shared.Logic.Validate)
local RateLimiter = require(Shared.Logic.RateLimiter)

local CommerceService = {}

local ctx
local testCheckout = nil
local limiter = RateLimiter.new(4, 0.5)
-- pass ids and developer product ids are separate Roblox id spaces: keep separate maps
local passById: { [number]: any } = {}
local productById: { [number]: any } = {}

for _, p in Products.List do
	if p.robuxId then
		if p.kind == "pass" then
			passById[p.robuxId] = p
		else
			productById[p.robuxId] = p
		end
	end
end

function CommerceService.Kind(): string
	return if testCheckout then "test" else "roblox"
end

function CommerceService.SetTestCheckout(checkout)
	testCheckout = checkout
end

local function grant(player: Player, productId: string, purchaseId: string): (boolean, string)
	local farm = ctx.FarmService.Get(player)
	if not farm then
		return false, "not_ready"
	end
	local ok, code = farm:GrantProduct(productId, purchaseId, ctx.FarmService.Now())
	ctx.FarmService.Push(player, true)
	return ok, code
end

local function onRequest(player: Player, req: any)
	if type(req) ~= "table" or not Validate.Id(req.productId) then
		return { ok = false, code = "invalid", message = "That item isn't valid." }
	end
	if not limiter:Allow(player, os.clock()) then
		return { ok = false, code = "rate_limited", message = "Slow down a little!" }
	end
	local p = Products.ById[req.productId]
	if not p or (p.kind ~= "pass" and p.kind ~= "product") then
		return { ok = false, code = "invalid", message = "That item isn't sold for Robux." }
	end
	local farm = ctx.FarmService.Get(player)
	if not farm then
		return { ok = false, code = "not_ready", message = "Your farm is still loading." }
	end
	if p.kind == "pass" and farm.state.passes[p.grant.pass] then
		return { ok = false, code = "owned", message = "You already own this!" }
	end
	if testCheckout then
		return testCheckout:Buy(p.id, function(id, purchaseId)
			return grant(player, id, purchaseId)
		end)
	end
	if not p.robuxId then
		return { ok = false, code = "not_configured", message = "This item isn't for sale yet." }
	end
	local ok = pcall(function()
		if p.kind == "pass" then
			MarketplaceService:PromptGamePassPurchase(player, p.robuxId)
		else
			MarketplaceService:PromptProductPurchase(player, p.robuxId)
		end
	end)
	if not ok then
		return { ok = false, code = "failed", message = "The store couldn't open. Try again later." }
	end
	return { ok = true, code = "prompted", message = "Complete the purchase in the Roblox window." }
end

-- Real receipts (developer products). Only returns PurchaseGranted after a save containing the
-- purchase id is confirmed, so a crash can't lose a paid grant.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local p = productById[receipt.ProductId]
	if not player or not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	local ok = grant(player, p.id, purchaseId)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local saved = ctx.DataService.WaitForSave(player, function(data)
		return data and data.receipts and data.receipts[purchaseId] ~= nil
	end, 20)
	return if saved then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
end

-- Passes the player owns on Roblox (only configured ones; pcall because the API can fail).
function CommerceService.SyncPasses(player: Player)
	if testCheckout then
		return
	end
	for _, p in Products.List do
		if p.kind == "pass" and p.robuxId then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, p.robuxId)
			if ok and owns then
				grant(player, p.id, "PASS-" .. player.UserId .. "-" .. p.robuxId)
			end
		end
	end
end

function CommerceService.Init(c)
	ctx = c
	local remoteCommerce = Net.Get("Commerce") :: RemoteFunction
	remoteCommerce.OnServerInvoke = onRequest
	if not testCheckout then
		MarketplaceService.ProcessReceipt = processReceipt
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
			local p = passById[passId]
			if purchased and p and p.kind == "pass" then
				grant(player, p.id, "PASS-" .. player.UserId .. "-" .. passId)
			end
			local remoteFarmEvent = Net.Get("FarmEvent") :: RemoteEvent
			remoteFarmEvent:FireClient(player, "Checkout", {
				productId = p and p.id,
				status = if purchased then "ok" else "cancelled",
			})
		end)
		-- UI feedback only: the grant itself happens in ProcessReceipt
		MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
			local player = Players:GetPlayerByUserId(userId)
			local p = productById[productId]
			if player and p then
				local remote = Net.Get("FarmEvent") :: RemoteEvent
				remote:FireClient(player, "Checkout", { productId = p.id, status = if purchased then "ok" else "cancelled" })
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		limiter:Forget(player)
	end)
	ctx.FarmService.OnReady(function(player)
		CommerceService.SyncPasses(player)
	end)
end

return CommerceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Loads, migrates, saves and releases each player's FarmState through a persistence adapter.
-- Rules:
--   * A failed, cancelled or conflicting load kicks the player with a friendly message. It never
--     hands out a default profile, so a DataStore outage can't overwrite real progress.
--   * Saved data is migrated on a COPY; only a successful migration replaces the live table.
--   * Data from a newer game version is refused (no downgrade).
--   * Release happens on leave and on shutdown (ProfileStore also flushes on BindToClose).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Migrations = require(Shared.Logic.Migrations)
local State = require(Shared.Logic.State)

local DataService = {}
DataService.Closing = false -- set by Main's BindToClose: sessions ending at shutdown aren't "stolen"

local adapter
local handles: { [Player]: any } = {}

local function deepCopy(v)
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

function DataService.Init(ctx)
	adapter = ctx.PersistenceAdapter
	DataService.Kind = adapter.Kind
end

function DataService.Template(): any
	local s = State.New(0)
	s.createdAt = 0 -- marks "never saved"
	s.lastSeen = 0
	return s
end

-- Yields. Returns the live FarmState table, or nil after kicking the player.
function DataService.Load(player: Player, now: number): any?
	local key = "Player_" .. player.UserId
	local result = adapter:Load(key, function()
		return player.Parent ~= Players
	end)
	if player.Parent ~= Players then
		if result.ok then
			adapter:Release(result.handle)
		end
		return nil
	end
	if not result.ok then
		warn(string.format("[Data] load failed for %d: %s", player.UserId, tostring(result.reason)))
		local msg = if result.reason == "locked"
			then "Your farm is still open on another server. Please wait a moment and rejoin."
			else "We couldn't load your farm safely, so nothing was changed. Please rejoin in a moment."
		player:Kick(msg)
		return nil
	end
	local handle = result.handle
	local data = deepCopy(handle.data)
	if result.isNew or data.createdAt == 0 then
		data = State.New(now)
	end
	local ok, migrated = Migrations.Migrate(data, now)
	if not ok then
		warn(string.format("[Data] migration refused for %d: %s", player.UserId, tostring(migrated)))
		adapter:Release(handle) -- saves the untouched original
		player:Kick(if migrated == "newer"
			then "This server is running an older version of the game. Please rejoin."
			else "Your save needs attention; nothing was changed. Please rejoin.")
		return nil
	end
	adapter:SetData(handle, migrated)
	handles[player] = handle
	adapter:OnSessionEnd(handle, function()
		-- another server took the session (ProfileStore): stop this one from playing on stale data
		if handles[player] == handle and player.Parent == Players and not DataService.Closing
			and not (adapter.IsClosing and adapter:IsClosing())
		then
			handles[player] = nil
			player:Kick("Your farm was opened on another server.")
		end
	end)
	return migrated
end

function DataService.IsActive(player: Player): boolean
	local h = handles[player]
	return h ~= nil and adapter:IsActive(h)
end

function DataService.Save(player: Player): boolean
	local h = handles[player]
	if not h then
		return false
	end
	return (adapter:Save(h))
end

-- Yields until a save that satisfies check(savedData) is confirmed (receipt handling).
function DataService.WaitForSave(player: Player, check: (any) -> boolean, timeout: number): boolean
	local h = handles[player]
	if not h then
		return false
	end
	return adapter:WaitForSave(h, check, timeout)
end

function DataService.Release(player: Player)
	local h = handles[player]
	handles[player] = nil
	if h then
		local ok, err = adapter:Release(h)
		if not ok then
			warn(string.format("[Data] release for %d reported: %s", player.UserId, tostring(err)))
		end
	end
end

function DataService.Adapter()
	return adapter
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">FarmService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Runs one Economy per player: loads it through DataService, steps it at 4 Hz on the server clock,
-- handles the Action remote (validated, rate limited, atomic), and sends the owner throttled
-- snapshots and events. Never trusts anything from the client beyond the intent it names.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Economy = require(Shared.Logic.Economy)
local RateLimiter = require(Shared.Logic.RateLimiter)
local Modifiers = require(Shared.Logic.Modifiers)
local Codes = require(script.Parent.Parent.Data.Codes)

local FarmService = {}

local TICK = 0.25
local SNAPSHOT_EVERY = 0.25

local farms: { [Player]: any } = {}
local lastSnap: { [Player]: number } = {}
local ctx
-- burst of 25 requests, refilling 14/s: enough for held Spawn (8/s) plus menu taps
local limiter = RateLimiter.new(25, 14)
-- codes get their own slow bucket (6 tries, then 1 every 10 s) so they can't be brute-forced
local codeLimiter = RateLimiter.new(6, 0.1)
local readyCallbacks = {}

local timeOffset = 0 -- test place only (dev "next day"); always 0 in the real game

function FarmService.Now(): number
	return workspace:GetServerTimeNow() + timeOffset
end

function FarmService.SetTimeOffset(seconds: number)
	timeOffset = seconds
end

function FarmService.Get(player: Player)
	return farms[player]
end

function FarmService.All()
	return farms
end

function FarmService.OnReady(fn)
	table.insert(readyCallbacks, fn)
end

local function sendEvents(player: Player, farm)
	local events = farm:DrainEvents()
	if #events == 0 then
		return
	end
	local remote = Net.Get("FarmEvent") :: RemoteEvent
	for _, e in events do
		remote:FireClient(player, e.name, e.data)
		ctx.PlotService.OnFarmEvent(player, e.name, e.data)
	end
end

function FarmService.Push(player: Player, force: boolean?)
	local farm = farms[player]
	if not farm then
		return
	end
	sendEvents(player, farm)
	local now = FarmService.Now()
	if farm.dirty and (force or now - (lastSnap[player] or 0) >= SNAPSHOT_EVERY) then
		farm.dirty = false
		lastSnap[player] = now
		local snap = farm:Snapshot(now)
		;(Net.Get("Snapshot") :: RemoteEvent):FireClient(player, snap)
		ctx.PlotService.Sync(player, farm.state, snap)
		local character = player.Character
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = snap.walkSpeed
		end
	end
end

function FarmService.Toast(player: Player, text: string, kind: string?)
	local remoteFarmEvent = Net.Get("FarmEvent") :: RemoteEvent
	remoteFarmEvent:FireClient(player, "Toast", { text = text, kind = kind or "info" })
end

local function onAction(player: Player, action: any)
	local farm = farms[player]
	if not farm then
		return { ok = false, code = "not_ready", message = "Your farm is still loading." }
	end
	if not limiter:Allow(player, os.clock()) then
		return { ok = false, code = "rate_limited", message = "Slow down a little!" }
	end
	if type(action) == "table" and action.type == "redeemCode" and not codeLimiter:Allow(player, os.clock()) then
		return { ok = false, code = "rate_limited", message = "Too many code attempts. Wait a little and try again." }
	end
	local ok, res = pcall(farm.Apply, farm, action, FarmService.Now())
	if not ok then
		warn("[Farm] action error: " .. tostring(res))
		return { ok = false, code = "error", message = "Something went wrong. Try again." }
	end
	FarmService.Push(player, true)
	return res
end

function FarmService.Init(c)
	ctx = c
	local remoteAction = Net.Get("Action") :: RemoteFunction
	remoteAction.OnServerInvoke = onAction
end

-- Called by Main after the player's plot is ready. Yields while the save loads.
function FarmService.Load(player: Player): boolean
	local now = FarmService.Now()
	local state = ctx.DataService.Load(player, now)
	if not state or player.Parent ~= Players then
		return false
	end
	local premium = player.MembershipType == Enum.MembershipType.Premium
	local rng = Random.new()
	local farm = Economy.new(state, {
		premium = premium,
		codes = ctx.Codes or Codes,
		rng = function()
			return rng:NextNumber()
		end,
	})
	farm:ComputeOffline(now)
	farms[player] = farm
	farm.dirty = true
	for _, fn in readyCallbacks do
		task.spawn(fn, player, farm)
	end
	FarmService.Push(player, true)
	return true
end

function FarmService.Unload(player: Player)
	local farm = farms[player]
	if farm then
		farm:Step(math.max(0, FarmService.Now() - farm.state.lastSeen), FarmService.Now())
		farm.state.lastSeen = FarmService.Now()
	end
	farms[player] = nil
	lastSnap[player] = nil
	limiter:Forget(player)
	codeLimiter:Forget(player)
	ctx.DataService.Release(player)
end

function FarmService.Start()
	local acc = 0
	local last = FarmService.Now()
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < TICK then
			return
		end
		acc = 0
		local now = FarmService.Now()
		local step = math.clamp(now - last, 0, 5)
		last = now
		for player, farm in farms do
			local ok, err = pcall(farm.Step, farm, step, now)
			if not ok then
				warn("[Farm] step error: " .. tostring(err))
			end
			FarmService.Push(player)
		end
	end)
end

FarmService.Modifiers = Modifiers
return FarmService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">FoxService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The Lucky Fox (reported in the reference as a random clickable fox that pays cash). Every few
-- minutes a fox appears at one of the owner's FoxSpots for a short time. Only the plot owner can
-- catch it, through a ProximityPrompt (the server checks owner + distance again before paying).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FoxService = {}

local MIN_GAP, MAX_GAP = 150, 300 -- seconds between foxes
local LIFETIME = 40
local CATCH_DISTANCE = 14

local ctx
local active: { [Player]: Model } = {}
local rng = Random.new()

local function buildFox(): Model
	local models = ReplicatedStorage.Shared:FindFirstChild("Models")
	local builder = models and models:FindFirstChild("Fox")
	if builder then
		local ok, m = pcall(function()
			local mod = require(builder)
			return if type(mod) == "function" then mod() elseif type(mod) == "table" and mod.Build then mod.Build() else nil
		end)
		if ok and typeof(m) == "Instance" and m:IsA("Model") then
			return m
		end
	end
	-- simple fallback fox made of parts
	local m = Instance.new("Model")
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(1.6, 1.4, 3)
	body.Color = Color3.fromRGB(232, 120, 40)
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.Parent = m
	local head = body:Clone()
	head.Name = "Head"
	head.Size = Vector3.new(1.4, 1.3, 1.4)
	head.CFrame = body.CFrame * CFrame.new(0, 0.6, -1.9)
	head.Parent = m
	local tail = body:Clone()
	tail.Name = "Tail"
	tail.Size = Vector3.new(0.8, 0.8, 1.8)
	tail.Color = Color3.fromRGB(250, 240, 230)
	tail.CFrame = body.CFrame * CFrame.new(0, 0.4, 2.1) * CFrame.Angles(math.rad(25), 0, 0)
	tail.Parent = m
	m.PrimaryPart = body
	return m
end

local function despawn(player: Player)
	local fox = active[player]
	active[player] = nil
	if fox then
		fox:Destroy()
	end
end

local function spawnFox(player: Player)
	local farm = ctx.FarmService.Get(player)
	local zones = ctx.PlotService.Zones(player)
	if not farm or not farm.state.tutorial.done or not zones or not zones.foxSpots or #zones.foxSpots == 0 then
		return
	end
	despawn(player)
	local spot = zones.foxSpots[rng:NextInteger(1, #zones.foxSpots)]
	local fox = buildFox()
	fox.Name = "LuckyFox"
	for _, d in fox:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	fox:PivotTo(CFrame.new(spot + Vector3.new(0, 1, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Catch!"
	prompt.ObjectText = "Lucky Fox"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Fox", true)
	prompt.Parent = fox.PrimaryPart or fox:FindFirstChildWhichIsA("BasePart")
	fox:SetAttribute("OwnerUserId", player.UserId)
	prompt.Triggered:Connect(function(who: Player)
		if who ~= player or active[player] ~= fox then
			return -- only the owner, only once
		end
		local character = who.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or (root.Position - fox:GetPivot().Position).Magnitude > CATCH_DISTANCE then
			return
		end
		active[player] = nil
		local f = ctx.FarmService.Get(player)
		if f then
			f:CatchFox(ctx.FarmService.Now())
			ctx.FarmService.Push(player, true)
		end
		fox:Destroy()
	end)
	local plot = ctx.PlotService.PlotOf(player)
	fox.Parent = plot or workspace
	active[player] = fox
	task.delay(LIFETIME, function()
		if active[player] == fox then
			despawn(player)
		end
	end)
end

function FoxService.Init(c)
	ctx = c
end

function FoxService.StartFor(player: Player)
	task.spawn(function()
		while player.Parent == Players and ctx.FarmService.Get(player) do
			task.wait(rng:NextNumber(MIN_GAP, MAX_GAP))
			if player.Parent ~= Players then
				break
			end
			spawnFox(player)
		end
	end)
end

function FoxService.SpawnNow(player: Player)
	spawnFox(player)
end

function FoxService.Cleanup(player: Player)
	despawn(player)
end

return FoxService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Assigns each player one plot (PlotRegistry), publishes the plot's public attributes for every
-- client's visuals, asks World to show the right tiers/theme, and cleans the plot when the
-- owner leaves. Only the owner's farm is ever touched by actions on a plot.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlotRegistry = require(Shared.Logic.PlotRegistry)

local PlotService = {}

local World
local registry
local lastApplied: { [Player]: string } = {}

function PlotService.Init(ctx)
	World = ctx.World
	World.Init()
	registry = PlotRegistry.new(World.PlotCount)
end

function PlotService.Claim(player: Player): (number?, Model?)
	local index = PlotRegistry.Claim(registry, player.UserId)
	if not index then
		return nil, nil
	end
	local plot = World.GetPlot(index)
	plot:SetAttribute("OwnerUserId", player.UserId)
	plot:SetAttribute("OwnerName", player.DisplayName)
	player:SetAttribute("PlotIndex", index)
	local zones = World.Zones(plot)
	if zones and zones.spawn then
		player.RespawnLocation = zones.spawn
	end
	return index, plot
end

function PlotService.PlotOf(player: Player): Model?
	local index = registry.plotOf[player.UserId]
	return if index then World.GetPlot(index) else nil
end

function PlotService.IndexOf(player: Player): number?
	return registry.plotOf[player.UserId]
end

function PlotService.Owns(player: Player, index: number): boolean
	return PlotRegistry.Owns(registry, player.UserId, index)
end

function PlotService.Zones(player: Player)
	local plot = PlotService.PlotOf(player)
	return plot and World.Zones(plot)
end

local function tiers(list, field)
	local out = {}
	for i, e in list do
		out[i] = e[field]
	end
	return out
end

-- Publishes public plot info and updates the world models. Cheap when nothing changed.
function PlotService.Sync(player: Player, state, snap)
	local plot = PlotService.PlotOf(player)
	if not plot then
		return
	end
	local houses = tiers(state.housing, "tier")
	local vehicles = tiers(state.vehicles, "tier")
	local workers = tiers(state.workers, "tier")
	plot:SetAttribute("Population", state.population)
	local key = table.concat({
		state.egg,
		table.concat(houses, ","),
		table.concat(vehicles, ","),
		table.concat(workers, ","),
		state.silos,
		snap.permanentSilos,
	}, "|")
	if lastApplied[player] == key then
		return
	end
	lastApplied[player] = key
	plot:SetAttribute("Egg", state.egg)
	plot:SetAttribute("HouseTiers", table.concat(houses, ","))
	plot:SetAttribute("VehicleTiers", table.concat(vehicles, ","))
	plot:SetAttribute("WorkerTiers", table.concat(workers, ","))
	plot:SetAttribute("Silos", state.silos)
	local ok, err = pcall(World.ApplyState, plot, {
		egg = state.egg,
		houses = houses,
		vehicles = vehicles,
		workers = workers,
		silos = state.silos,
		permanentSilos = snap.permanentSilos,
		ownerName = player.DisplayName,
	})
	if not ok then
		warn("[Plot] ApplyState failed: " .. tostring(err))
	end
end

function PlotService.OnFarmEvent(player: Player, name: string, data) end

function PlotService.Release(player: Player)
	lastApplied[player] = nil
	local index = PlotRegistry.Release(registry, player.UserId)
	if index then
		local plot = World.GetPlot(index)
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Population", 0)
		local ok, err = pcall(World.ResetPlot, plot)
		if not ok then
			warn("[Plot] ResetPlot failed: " .. tostring(err))
		end
	end
end

function PlotService.Count(): number
	return World.PlotCount
end

PlotService.Players = Players
return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">ZoneService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Physical interactions, checked on the server from the character's real position:
-- standing in a house's CollectRing collects; standing in the warehouse DepositRing deposits.
-- Only the player's OWN plot's rings are considered, so nobody can collect from another farm.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ZoneService = {}

local CHECK_EVERY = 0.2
local EXTRA_RADIUS = 2 -- forgiveness around the ring's visible edge
local MAX_HEIGHT = 9

local ctx
-- last checked position per player: a jump far beyond walking speed (teleport exploit, or a
-- respawn) skips ring actions for that check, so rings need real presence across two checks
local lastPos: { [Player]: { pos: Vector3, t: number } } = {}
local SPEED_SLACK = 1.6

-- Horizontal distance check against a flat ring part (radius = half its largest X/Z size).
function ZoneService.Inside(part: BasePart, pos: Vector3): boolean
	local rel = part.CFrame:PointToObjectSpace(pos)
	local radius = math.max(part.Size.X, part.Size.Z) / 2 + EXTRA_RADIUS
	return (rel.X * rel.X + rel.Z * rel.Z) <= radius * radius and math.abs(rel.Y) <= MAX_HEIGHT
end

local function check(player: Player)
	local farm = ctx.FarmService.Get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not farm or not root or not hum or hum.Health <= 0 then
		return
	end
	local zones = ctx.PlotService.Zones(player)
	if not zones then
		return
	end
	local now = ctx.FarmService.Now()
	local pos = root.Position
	local prev = lastPos[player]
	lastPos[player] = { pos = pos, t = os.clock() }
	if not prev then
		return
	end
	local flat = Vector3.new(pos.X - prev.pos.X, 0, pos.Z - prev.pos.Z).Magnitude
	if flat > hum.WalkSpeed * SPEED_SLACK * (os.clock() - prev.t) + 6 then
		return
	end
	for slot, ring in zones.collect do
		local h = farm.state.housing[slot]
		if h and h.tier > 0 and h.eggs > 0 and ring.Parent and ZoneService.Inside(ring, pos) then
			farm:Collect(slot, now)
		end
	end
	if farm.state.carried > 0 and zones.deposit and ZoneService.Inside(zones.deposit, pos) then
		farm:Deposit(now)
	end
end

function ZoneService.Init(c)
	ctx = c
end

function ZoneService.Start()
	Players.PlayerRemoving:Connect(function(player)
		lastPos[player] = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < CHECK_EVERY then
			return
		end
		acc = 0
		for _, player in Players:GetPlayers() do
			local ok, err = pcall(check, player)
			if not ok then
				warn("[Zone] " .. tostring(err))
			end
		end
	end)
end

return ZoneService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Houses</string>
            <string name="Source"><![CDATA[--!strict
-- Housing tier models 1..10 (Data/Housing): Little Coop, Twin Coop, Hen House, Red Barn, Big Barn,
-- Poultry Hall, Egg Factory, Hen Tower, Sky Roost, Mega Dome. Tier 0 = the "For Sale" pad.
-- Built at the origin in the "house frame": door faces -Z, ground at y = 0, footprint at most
-- 34 (x) by 28 (z) studs (PlotLayout.Houses[i].buildingMax). World pivots the model into place.
-- Each tier visibly grows and gets more elaborate; colours come from the theme palette (roles)
-- so Kit.Recolor repaints them when the farm's egg changes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kit = require(Shared:WaitForChild("Models"):WaitForChild("Kit"))

local Houses = {}

local F = Kit.Fixed
local NEON = Enum.Material.Neon

type B = {
	m: Model,
	box: (self: B, name: string, size: Vector3, pos: Vector3, look: any, opts: { [string]: any }?) -> BasePart,
	at: (self: B, name: string, size: Vector3, cf: CFrame, look: any, opts: { [string]: any }?) -> BasePart,
}

-- `look` is a theme role (string) or a fixed Color3.
local function make(m: Model): B
	local b = { m = m } :: any
	function b.at(self: B, name: string, size: Vector3, cf: CFrame, look: any, opts: { [string]: any }?): BasePart
		local o: any = table.clone(opts or {})
		o.name, o.size, o.cf = name, size, cf
		if type(look) == "string" then
			o.role = look
		else
			o.color = look
		end
		return Kit.Part(self.m, o)
	end
	function b.box(self: B, name: string, size: Vector3, pos: Vector3, look: any, opts: { [string]: any }?): BasePart
		return self:at(name, size, CFrame.new(pos), look, opts)
	end
	return b :: B
end

local function gable(b: B, cf: CFrame, w: number, d: number, h: number, look: any, opts: { [string]: any }?)
	local o: any = table.clone(opts or {})
	o.shape = "Wedge"
	b:at("Roof", Vector3.new(w, h, d / 2), cf * CFrame.new(0, h / 2, -d / 4), look, o)
	b:at("Roof", Vector3.new(w, h, d / 2), cf * CFrame.new(0, h / 2, d / 4) * CFrame.Angles(0, math.pi, 0), look, o)
end

-- Cross-gable "spire" roof over a w x d base at `cf`: two gables at right angles. Plain wedges
-- only (no CornerWedge orientation guesswork), reads as a pointed roof from every side.
local function pyramid(b: B, cf: CFrame, w: number, d: number, h: number, look: any)
	gable(b, cf, w, d, h, look)
	gable(b, cf * CFrame.Angles(0, math.pi / 2, 0), d, w, h, look)
end

local function door(b: B, pos: Vector3, w: number, h: number, look: any?)
	b:box("Door", Vector3.new(w, h, 0.3), pos + Vector3.new(0, h / 2, 0), look or F.black, { shade = 0.35 })
end

local function window(b: B, pos: Vector3, w: number, h: number, glow: boolean?)
	b:box("Window", Vector3.new(w, h, 0.25), pos, if glow then Color3.fromRGB(255, 236, 170) else F.glass, {
		material = if glow then NEON else Enum.Material.Glass,
		transparency = if glow then 0 else 0.1,
	})
end

-- Small coop used by tiers 1 and 2. Origin at its ground centre, door to -Z.
local function coop(b: B, at: CFrame)
	for _, x in { -3, 3 } do
		for _, z in { -2.2, 2.2 } do
			b:at("Leg", Vector3.new(0.6, 1.2, 0.6), at * CFrame.new(x, 0.6, z), "wood", { shade = 0.25 })
		end
	end
	b:at("Floor", Vector3.new(8, 0.4, 6), at * CFrame.new(0, 1.4, 0), "wood", { shade = 0.15 })
	b:at("Walls", Vector3.new(7.6, 4, 5.6), at * CFrame.new(0, 3.6, 0), "wood")
	b:at("Trim", Vector3.new(8, 0.35, 6), at * CFrame.new(0, 5.55, 0), "accent")
	b:at("Roof", Vector3.new(8.8, 2.4, 3.4), at * CFrame.new(0, 6.9, -1.7), "roof", { shape = "Wedge" })
	b:at("Roof", Vector3.new(8.8, 2.4, 3.4), at * CFrame.new(0, 6.9, 1.7) * CFrame.Angles(0, math.pi, 0), "roof", { shape = "Wedge" })
	b:at("Door", Vector3.new(1.6, 2, 0.3), at * CFrame.new(0, 2.6, -2.85), F.black, { shade = 0.3 })
	b:at("Ramp", Vector3.new(1.6, 1.6, 2.6), at * CFrame.new(0, 0.8, -4.1), "wood", { shape = "Wedge", shade = 0.1 })
end

local builders: { (B) -> () } = {}

builders[1] = function(b) -- Little Coop
	coop(b, CFrame.new(0, 0, 2))
	b:box("Feeder", Vector3.new(2.4, 0.6, 1), Vector3.new(3.5, 0.3, -4), "accent")
end

builders[2] = function(b) -- Twin Coop
	coop(b, CFrame.new(-5.5, 0, 3))
	coop(b, CFrame.new(5.5, 0, 3))
	b:box("Walkway", Vector3.new(3, 0.4, 5), Vector3.new(0, 3.4, 3), "wood", { shade = 0.15 })
	-- small fenced run in front
	b:box("RunRail", Vector3.new(20, 0.3, 0.3), Vector3.new(0, 1.4, -6.5), F.white)
	b:box("RunRailL", Vector3.new(0.3, 0.3, 5), Vector3.new(-10, 1.4, -4), F.white)
	b:box("RunRailR", Vector3.new(0.3, 0.3, 5), Vector3.new(10, 1.4, -4), F.white)
	for _, x in { -10, -5, 5, 10 } do
		b:box("Post", Vector3.new(0.5, 1.8, 0.5), Vector3.new(x, 0.9, -6.5), F.white)
	end
	b:box("Feeder", Vector3.new(3, 0.6, 1), Vector3.new(0, 0.3, -2), "accent")
end

builders[3] = function(b) -- Hen House
	b:box("Base", Vector3.new(15, 0.8, 11), Vector3.new(0, 0.4, 0), F.stone)
	b:box("Walls", Vector3.new(14, 6, 10), Vector3.new(0, 3.8, 0), "wood")
	for _, x in { -7, 7 } do
		for _, z in { -5, 5 } do
			b:box("Corner", Vector3.new(0.6, 6, 0.6), Vector3.new(x, 3.8, z), F.white)
		end
	end
	gable(b, CFrame.new(0, 6.8, 0), 15.4, 11.6, 4.2, "roof")
	b:box("Gable", Vector3.new(14, 0.4, 10.2), Vector3.new(0, 6.9, 0), "accent")
	door(b, Vector3.new(0, 0.8, -5.1), 3, 4)
	b:box("DoorFrame", Vector3.new(3.8, 0.5, 0.35), Vector3.new(0, 5.05, -5.1), F.white)
	window(b, Vector3.new(-4.4, 4.2, -5.1), 2.2, 1.8)
	window(b, Vector3.new(4.4, 4.2, -5.1), 2.2, 1.8)
	b:box("Chimney", Vector3.new(1.4, 3.4, 1.4), Vector3.new(4.5, 9.5, 2.5), F.stone)
	b:box("Step", Vector3.new(4, 0.5, 1.4), Vector3.new(0, 0.25, -6), F.stone)
end

builders[4] = function(b) -- Red Barn (gambrel roof)
	local w, d, h = 18, 14, 8
	b:box("Base", Vector3.new(w + 0.8, 0.8, d + 0.8), Vector3.new(0, 0.4, 0), F.stone)
	b:box("Walls", Vector3.new(w, h, d), Vector3.new(0, 0.8 + h / 2, 0), "roof")
	local top = 0.8 + h
	for _, x in { -w / 2, w / 2 } do
		for _, z in { -d / 2, d / 2 } do
			b:box("Corner", Vector3.new(0.7, h, 0.7), Vector3.new(x, 0.8 + h / 2, z), F.white)
		end
	end
	local rw = w + 0.8
	b:box("RoofCore", Vector3.new(rw, 4, 8), Vector3.new(0, top + 2, 0), "wood", { shade = 0.35 })
	b:at("RoofLow", Vector3.new(rw, 4, 3.4), CFrame.new(0, top + 2, -5.6), "wood", { shape = "Wedge", shade = 0.35 })
	b:at("RoofLow", Vector3.new(rw, 4, 3.4), CFrame.new(0, top + 2, 5.6) * CFrame.Angles(0, math.pi, 0), "wood", { shape = "Wedge", shade = 0.35 })
	b:at("RoofHigh", Vector3.new(rw, 2.2, 4), CFrame.new(0, top + 5.1, -2), "wood", { shape = "Wedge", shade = 0.35 })
	b:at("RoofHigh", Vector3.new(rw, 2.2, 4), CFrame.new(0, top + 5.1, 2) * CFrame.Angles(0, math.pi, 0), "wood", { shape = "Wedge", shade = 0.35 })
	-- big barn door with white X
	local dz = -d / 2 - 0.1
	b:box("Door", Vector3.new(6, 6.5, 0.3), Vector3.new(0, 0.8 + 3.25, dz), "roof", { shade = 0.25 })
	b:box("DoorFrame", Vector3.new(6.8, 0.6, 0.4), Vector3.new(0, 7.35, dz - 0.05), F.white)
	b:at("Brace", Vector3.new(0.5, 8.6, 0.4), CFrame.new(0, 4.05, dz - 0.1) * CFrame.Angles(0, 0, math.atan2(6, 6.5)), F.white)
	b:at("Brace", Vector3.new(0.5, 8.6, 0.4), CFrame.new(0, 4.05, dz - 0.1) * CFrame.Angles(0, 0, -math.atan2(6, 6.5)), F.white)
	b:box("Loft", Vector3.new(3.4, 2.6, 0.3), Vector3.new(0, top + 2, -d / 2 - 1.6), F.black, { shade = 0.2 })
	b:box("Hay", Vector3.new(2.6, 1.2, 0.6), Vector3.new(0, top + 1.2, -d / 2 - 1.9), F.hay)
	window(b, Vector3.new(-6, 5, dz), 2, 2)
	window(b, Vector3.new(6, 5, dz), 2, 2)
	b:box("Vane", Vector3.new(0.2, 2.2, 0.2), Vector3.new(0, top + 7.3, 0), F.darkMetal)
	b:box("VaneArrow", Vector3.new(2, 0.2, 0.2), Vector3.new(0, top + 8.1, 0), "accent")
end

builders[5] = function(b) -- Big Barn: wider barn, silo tower, lean-to and a cupola
	local w, d, h = 22, 16, 9
	b:box("Base", Vector3.new(w + 1, 0.8, d + 1), Vector3.new(-2, 0.4, 0), F.stone)
	b:box("Walls", Vector3.new(w, h, d), Vector3.new(-2, 0.8 + h / 2, 0), "roof")
	local top = 0.8 + h
	for _, x in { -w / 2 - 2, w / 2 - 2 } do
		for _, z in { -d / 2, d / 2 } do
			b:box("Corner", Vector3.new(0.8, h, 0.8), Vector3.new(x, 0.8 + h / 2, z), F.white)
		end
	end
	b:box("Band", Vector3.new(w + 0.2, 0.6, d + 0.2), Vector3.new(-2, 0.8 + h * 0.55, 0), F.white)
	gable(b, CFrame.new(-2, top, 0), w + 1, d + 1.4, 6, "wood", { shade = 0.35 })
	b:box("Cupola", Vector3.new(3, 2.6, 3), Vector3.new(-2, top + 6.6, 0), F.white)
	gable(b, CFrame.new(-2, top + 7.9, 0), 3.6, 3.6, 1.6, "roof")
	local dz = -d / 2 - 0.1
	b:box("Door", Vector3.new(7, 7, 0.3), Vector3.new(-2, 0.8 + 3.5, dz), "roof", { shade = 0.25 })
	b:box("DoorFrame", Vector3.new(7.8, 0.6, 0.4), Vector3.new(-2, 8.1, dz - 0.05), F.white)
	b:at("Brace", Vector3.new(0.5, 9.4, 0.4), CFrame.new(-2, 4.3, dz - 0.1) * CFrame.Angles(0, 0, math.atan2(7, 7)), F.white)
	b:at("Brace", Vector3.new(0.5, 9.4, 0.4), CFrame.new(-2, 4.3, dz - 0.1) * CFrame.Angles(0, 0, -math.atan2(7, 7)), F.white)
	b:box("Loft", Vector3.new(4, 3, 0.3), Vector3.new(-2, top + 2, -d / 2 - 0.9), F.black, { shade = 0.2 })
	window(b, Vector3.new(-9, 5.5, dz), 2.4, 2.2)
	window(b, Vector3.new(5, 5.5, dz), 2.4, 2.2)
	-- silo tower on the right
	Kit.Column(b.m, CFrame.new(13, 0, 2), 18, 7, { role = "wood", shade = 0.05, name = "Tower" })
	Kit.Column(b.m, CFrame.new(13, 6, 2), 0.6, 7.3, { role = "accent", name = "TowerBand" })
	Kit.Column(b.m, CFrame.new(13, 12, 2), 0.6, 7.3, { role = "accent", name = "TowerBand" })
	b:box("TowerCap", Vector3.new(7.2, 7.2, 7.2), Vector3.new(13, 18, 2), "roof", { shape = "Ball" })
	-- lean-to on the left
	b:box("LeanTo", Vector3.new(4, 5, 12), Vector3.new(-14.6, 3.3, 1), "wood", { shade = 0.1 })
	b:at("LeanRoof", Vector3.new(12.6, 2, 4.6), CFrame.new(-14.6, 6.8, 1) * CFrame.Angles(0, math.pi / 2, 0), "roof", { shape = "Wedge", shade = 0.1 })
	b:box("HayStack", Vector3.new(3, 2, 3), Vector3.new(-15, 1, -7.5), F.hay)
end

builders[6] = function(b) -- Poultry Hall: a long hall with a ridge vent, window rows and fans
	local w, d, h = 32, 18, 7.5
	b:box("Base", Vector3.new(w + 1, 1, d + 1), Vector3.new(0, 0.5, 0), F.stone)
	b:box("Walls", Vector3.new(w, h, d), Vector3.new(0, 1 + h / 2, 0), "wood")
	local top = 1 + h
	b:box("Skirt", Vector3.new(w + 0.3, 1.4, d + 0.3), Vector3.new(0, 1.7, 0), "roof", { shade = 0.2 })
	gable(b, CFrame.new(0, top, 0), w + 1.6, d + 2, 5.5, "roof")
	b:box("Vent", Vector3.new(w - 6, 1.6, 3), Vector3.new(0, top + 6.1, 0), "accent")
	gable(b, CFrame.new(0, top + 6.9, 0), w - 5, 4, 1.4, "roof", { shade = 0.15 })
	for i = -3, 3 do
		if i ~= 0 then
			window(b, Vector3.new(i * 4.4, 5.6, -d / 2 - 0.1), 2.6, 2, true)
		end
	end
	door(b, Vector3.new(0, 1, -d / 2 - 0.1), 4.6, 5.2)
	b:box("Sign", Vector3.new(10, 2.2, 0.4), Vector3.new(0, top + 0.3, -d / 2 - 1.2), "accent")
	for _, x in { -w / 2 - 0.2, w / 2 + 0.2 } do
		for _, z in { -4, 4 } do
			b:at("Fan", Vector3.new(0.5, 3.2, 3.2), CFrame.new(x, 5, z), F.darkMetal, { shape = "Cylinder" })
		end
	end
	b:box("Ramp", Vector3.new(6, 1, 3), Vector3.new(0, 0.5, -d / 2 - 2), F.stone)
	b:box("Silo", Vector3.new(4, 9, 4), Vector3.new(-w / 2 + 2, 4.5, d / 2 + 2.4), F.metal)
	b:box("SiloCap", Vector3.new(4.4, 1.2, 4.4), Vector3.new(-w / 2 + 2, 9.6, d / 2 + 2.4), "roof")
end

builders[7] = function(b) -- Egg Factory: industrial block, sawtooth roof, chimneys, conveyor
	local w, d, h = 30, 20, 10
	b:box("Base", Vector3.new(w + 1, 1, d + 1), Vector3.new(0, 0.5, 0), F.darkStone)
	b:box("Walls", Vector3.new(w, h, d), Vector3.new(0, 1 + h / 2, 0), F.stone)
	local top = 1 + h
	b:box("Stripe", Vector3.new(w + 0.2, 1.2, d + 0.2), Vector3.new(0, top - 1.2, 0), "accent")
	b:box("Stripe2", Vector3.new(w + 0.2, 0.6, d + 0.2), Vector3.new(0, 2.2, 0), "roof")
	-- sawtooth roof: 4 wedges across the width, glass faces to the front
	for i = 0, 3 do
		local x = -w / 2 + 3.75 + i * 7.5
		b:at("Saw", Vector3.new(d, 3.2, 7.5), CFrame.new(x, top + 1.6, 0) * CFrame.Angles(0, math.pi / 2, 0), "roof", { shape = "Wedge" })
		b:box("SawGlass", Vector3.new(0.3, 3, d - 1), Vector3.new(x + 3.6, top + 1.5, 0), Color3.fromRGB(255, 236, 170), { material = NEON })
	end
	for _, x in { -10, -4 } do
		Kit.Column(b.m, CFrame.new(x, top, 6), 10, 2.6, { color = F.metal, name = "Chimney" })
		Kit.Column(b.m, CFrame.new(x, top + 8, 6), 1, 2.9, { role = "roof", name = "ChimneyBand" })
	end
	-- roll-up door and lit windows
	b:box("RollDoor", Vector3.new(7, 6.5, 0.3), Vector3.new(-6, 1 + 3.25, -d / 2 - 0.1), F.metal)
	for i = 0, 4 do
		b:box("DoorRib", Vector3.new(7, 0.15, 0.4), Vector3.new(-6, 2 + i * 1.3, -d / 2 - 0.15), F.darkMetal)
	end
	for _, x in { 3, 7.5, 12 } do
		window(b, Vector3.new(x, 7, -d / 2 - 0.1), 3, 2.4, true)
	end
	-- conveyor coming out of the front with eggs on it
	b:box("Conveyor", Vector3.new(3, 0.6, 4), Vector3.new(6, 2.4, -d / 2 - 2), F.darkMetal)
	b:box("ConveyorLegs", Vector3.new(2.6, 2.1, 0.5), Vector3.new(6, 1.05, -d / 2 - 3.5), F.metal)
	for i = 0, 2 do
		Kit.Egg(b.m, CFrame.new(6, 3.15, -d / 2 - 0.9 - i * 1.25), Vector3.new(0.9, 1.2, 0.9), { color = F.cream, name = "Egg" })
	end
	-- big egg sign on the roof
	b:box("SignPost", Vector3.new(0.6, 4, 0.6), Vector3.new(9, top + 4, -4), F.darkMetal)
	Kit.Egg(b.m, CFrame.new(9, top + 8, -4), Vector3.new(4.5, 6, 1.5), { role = "accent", name = "EggSign" })
	b:box("Pipe", Vector3.new(1, 1, d), Vector3.new(w / 2 + 0.6, top - 3, 0), F.metal)
end

builders[8] = function(b) -- Hen Tower: base hall + three stacked floors with balconies, pyramid roof
	b:box("Base", Vector3.new(30, 1, 24), Vector3.new(0, 0.5, 0), F.stone)
	b:box("Hall", Vector3.new(28, 6, 22), Vector3.new(0, 4, 0), "wood")
	b:box("HallTrim", Vector3.new(28.4, 0.8, 22.4), Vector3.new(0, 7.4, 0), "accent")
	door(b, Vector3.new(0, 1, -11.1), 5, 5)
	for _, x in { -9, 9 } do
		window(b, Vector3.new(x, 4.5, -11.1), 3, 2, true)
	end
	local y = 7.8
	local sizes = { 16, 14, 12 }
	for i, s in sizes do
		b:box("Floor" .. i, Vector3.new(s, 7, s), Vector3.new(0, y + 3.5, 1), "wood", { shade = if i % 2 == 0 then 0.08 else 0 })
		b:box("Balcony" .. i, Vector3.new(s + 3, 0.6, s + 3), Vector3.new(0, y + 0.3, 1), "roof", { shade = 0.15 })
		b:box("Rail" .. i, Vector3.new(s + 3, 1, 0.3), Vector3.new(0, y + 1.1, 1 - (s + 3) / 2), "accent")
		window(b, Vector3.new(-s / 4, y + 4, 1 - s / 2 - 0.1), 2.4, 2.4, true)
		window(b, Vector3.new(s / 4, y + 4, 1 - s / 2 - 0.1), 2.4, 2.4, true)
		y += 7
	end
	pyramid(b, CFrame.new(0, y, 1), 13.4, 13.4, 7, "roof")
	b:box("FlagPole", Vector3.new(0.3, 5, 0.3), Vector3.new(0, y + 9.5, 1), F.metal)
	b:box("Flag", Vector3.new(0.15, 1.6, 2.6), Vector3.new(0, y + 11.1, 2.4), "accent")
end

builders[9] = function(b) -- Sky Roost: glass tower with floating roost platforms and a balloon
	b:box("Base", Vector3.new(30, 1, 26), Vector3.new(0, 0.5, 0), F.stone)
	b:box("Hall", Vector3.new(24, 6, 18), Vector3.new(0, 4, 2), "wood")
	b:box("HallTrim", Vector3.new(24.4, 0.8, 18.4), Vector3.new(0, 7.4, 2), "accent")
	door(b, Vector3.new(0, 1, -7.1), 5, 5)
	local y = 7.8
	for i = 1, 4 do
		b:box("Storey" .. i, Vector3.new(12, 6, 12), Vector3.new(0, y + 3, 2), "wood", { shade = if i % 2 == 0 then 0.1 else 0 })
		b:box("Glass" .. i, Vector3.new(12.3, 2, 12.3), Vector3.new(0, y + 3.4, 2), Color3.fromRGB(150, 230, 255), { material = NEON, transparency = 0.25 })
		y += 6
	end
	b:box("TopDeck", Vector3.new(14, 0.8, 14), Vector3.new(0, y + 0.4, 2), "roof")
	pyramid(b, CFrame.new(0, y + 0.8, 2), 10, 10, 5, "roof")
	b:box("Antenna", Vector3.new(0.4, 6, 0.4), Vector3.new(0, y + 8.8, 2), F.metal)
	b:box("Beacon", Vector3.new(1, 1, 1), Vector3.new(0, y + 12, 2), "accent", { material = NEON, shape = "Ball" })
	-- floating roost platforms on both sides with little coops and bridges
	for _, side in { -1, 1 } do
		local px, py = side * 12, 16 + (if side > 0 then 6 else 0)
		Kit.Column(b.m, CFrame.new(px, py - 1, 2), 1, 9, { role = "groundEdge", name = "Platform" })
		Kit.Column(b.m, CFrame.new(px, py - 2.2, 2), 1.2, 4, { color = Color3.fromRGB(150, 230, 255), material = NEON, transparency = 0.3, name = "Hover" })
		b:box("MiniCoop", Vector3.new(4.5, 3, 4), Vector3.new(px, py + 1.5, 2), "wood")
		gable(b, CFrame.new(px, py + 3, 2), 5.2, 4.8, 1.8, "roof")
		b:box("Bridge", Vector3.new(4, 0.4, 2.2), Vector3.new(side * 7.5, py - 0.3, 2), "accent")
	end
	Kit.Egg(b.m, CFrame.new(-11, y + 4, 9), Vector3.new(6, 7, 6), { role = "accent", name = "Balloon", shadow = true })
	b:box("BalloonRope", Vector3.new(0.2, 8, 0.2), Vector3.new(-9, y - 3, 7), F.white)
end

builders[10] = function(b) -- Mega Dome: domed hall, ring of glowing pillars, giant egg on top
	Kit.Column(b.m, CFrame.new(0, 0, 0), 2.2, 28, { color = F.stone, name = "Base" })
	Kit.Column(b.m, CFrame.new(0, 2.2, 0), 0.8, 26.6, { role = "accent", name = "BaseRing" })
	b:box("Dome", Vector3.new(26, 26, 26), Vector3.new(0, 2.2, 0), "roof", { shape = "Ball" })
	Kit.Column(b.m, CFrame.new(0, 7.2, 0), 1.2, 24.6, { role = "accent", name = "Band" })
	Kit.Column(b.m, CFrame.new(0, 11.4, 0), 1, 20.5, { color = Color3.fromRGB(255, 240, 190), material = NEON, name = "LightBand" })
	-- entrance
	b:box("Entrance", Vector3.new(8, 7, 7), Vector3.new(0, 5.7, -10.3), "wood")
	b:at("Arch", Vector3.new(7, 8.2, 8.2), CFrame.new(0, 9.2, -10.3) * CFrame.Angles(0, math.pi / 2, 0), "roof", { shape = "Cylinder" })
	door(b, Vector3.new(0, 2.2, -13.75), 4.4, 5)
	-- pillars with glowing tips around the dome
	for i = 0, 7 do
		local a = (i + 0.5) * math.pi / 4
		local x, z = math.sin(a) * 13.4, math.cos(a) * 13.4
		if z > -9 or math.abs(x) > 6 then
			Kit.Column(b.m, CFrame.new(x, 2.2, z), 9, 1.4, { role = "wood", shade = 0.1, name = "Pillar" })
			b:box("PillarTip", Vector3.new(1.8, 1.8, 1.8), Vector3.new(x, 12.2, z), "accent", { shape = "Ball", material = NEON })
		end
	end
	-- portholes around the dome and two small side domes
	for i = 0, 5 do
		local a = math.rad(-150 + i * 60)
		if math.abs(math.deg(a)) > 40 then
			local x, z = math.sin(a) * 11.9, -math.cos(a) * 11.9
			b:at("Porthole", Vector3.new(2, 2, 0.4), CFrame.lookAt(Vector3.new(x, 7.6, z), Vector3.new(x * 2, 7.6, z * 2)), Color3.fromRGB(255, 236, 170), { material = NEON })
		end
	end
	for _, x in { -10.5, 10.5 } do
		b:box("SideDome", Vector3.new(8, 8, 8), Vector3.new(x, 2.2, 7), "roof", { shape = "Ball", shade = 0.1 })
		Kit.Column(b.m, CFrame.new(x, 2.2, 7), 0.8, 8.4, { role = "accent", name = "SideRing" })
		b:box("SideTip", Vector3.new(1.4, 1.4, 1.4), Vector3.new(x, 6.6, 7), "accent", { shape = "Ball", material = NEON })
	end
	-- the giant egg
	Kit.Column(b.m, CFrame.new(0, 14.6, 0), 1.6, 6, { color = F.metal, name = "EggStand" })
	Kit.Egg(b.m, CFrame.new(0, 20.4, 0), Vector3.new(7, 9.5, 7), { role = "accent", name = "GiantEgg", shadow = true, reflect = 0.15 })
	b:box("Spire", Vector3.new(0.5, 4, 0.5), Vector3.new(0, 27, 0), F.metal)
end

-- "For Sale" pad: a dashed outline and a sign. Lives in the same frame as the tier models.
local function forSale(b: B)
	for _, s in { { Vector3.new(26, 0.25, 1), Vector3.new(0, 0.12, -11) }, { Vector3.new(26, 0.25, 1), Vector3.new(0, 0.12, 11) }, { Vector3.new(1, 0.25, 22), Vector3.new(-13, 0.12, 0) }, { Vector3.new(1, 0.25, 22), Vector3.new(13, 0.12, 0) } } do
		b:box("Outline", s[1], s[2], F.white, { transparency = 0.25 })
	end
	b:box("SignPost", Vector3.new(0.5, 5, 0.5), Vector3.new(-3, 2.5, -9), "wood")
	b:box("SignPost", Vector3.new(0.5, 5, 0.5), Vector3.new(3, 2.5, -9), "wood")
	local board = b:box("SignBoard", Vector3.new(8, 3, 0.4), Vector3.new(0, 4.6, -9), F.white, { shadow = true })
	Kit.Label(board, "FOR SALE", Enum.NormalId.Front, Color3.fromRGB(210, 50, 50), 40)
	Kit.Label(board, "FOR SALE", Enum.NormalId.Back, Color3.fromRGB(210, 50, 50), 40)
	for _, p in { Vector3.new(-13, 1, -11), Vector3.new(13, 1, -11), Vector3.new(-13, 1, 11), Vector3.new(13, 1, 11) } do
		b:box("Stake", Vector3.new(0.3, 2, 0.3), p, "wood")
		b:box("Flag", Vector3.new(0.1, 0.6, 0.9), p + Vector3.new(0, 0.7, 0.5), "accent")
	end
end

-- Build the model for `tier` (0 = for sale) with the given palette. Returns a Model whose pivot is
-- the house-frame origin.
function Houses.Build(tier: number, palette: Kit.Palette): Model
	Kit.SetPalette(palette)
	local m = Instance.new("Model")
	m.Name = if tier > 0 then "Tier" .. tier else "ForSale"
	local b = make(m)
	if tier <= 0 then
		forSale(b)
	else
		local fn = builders[math.clamp(tier, 1, #builders)]
		fn(b)
	end
	m:SetAttribute("Tier", tier)
	m.WorldPivot = CFrame.identity
	return m
end

Houses.MaxTier = #builders

return Houses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Farm props built from native parts: warehouse, dock, road, silos, worker shed, menu boards,
-- gate sign, fences, theme decorations, the hill with the road tunnel. Every builder takes a
-- world CFrame (already placed by World) and parents into `parent`. Colours use theme roles so
-- Kit.Recolor can repaint a farm; decorations are rebuilt when the theme's decor kind changes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kit = require(Shared:WaitForChild("Models"):WaitForChild("Kit"))

local Props = {}

local F = Kit.Fixed
local NEON = Enum.Material.Neon

local function P(parent: Instance, name: string, size: Vector3, cf: CFrame, look: any, opts: { [string]: any }?): BasePart
	local o: any = table.clone(opts or {})
	o.name, o.size, o.cf = name, size, cf
	if type(look) == "string" then
		o.role = look
	else
		o.color = look
	end
	return Kit.Part(parent, o)
end
Props.P = P

local function gable(parent: Instance, cf: CFrame, w: number, d: number, h: number, look: any, opts: { [string]: any }?)
	local o: any = table.clone(opts or {})
	o.shape = "Wedge"
	P(parent, "Roof", Vector3.new(w, h, d / 2), cf * CFrame.new(0, h / 2, -d / 4), look, o)
	P(parent, "Roof", Vector3.new(w, h, d / 2), cf * CFrame.new(0, h / 2, d / 4) * CFrame.Angles(0, math.pi, 0), look, o)
end
Props.Gable = gable

-- A flat glowing ring zone. The returned zone part is an UNROTATED invisible block whose Size.X/Z
-- is the diameter (ZoneService reads it in object space); the visible disc is two child parts.
function Props.Ring(parent: Instance, name: string, cf: CFrame, radius: number): BasePart
	local zone = P(parent, name, Vector3.new(radius * 2, 0.2, radius * 2), cf * CFrame.new(0, 0.25, 0), F.white, {
		transparency = 1,
		collide = false,
		shadow = false,
	})
	zone:SetAttribute("Radius", radius)
	local flat = cf * CFrame.Angles(0, 0, math.pi / 2)
	P(zone, "Glow", Vector3.new(0.12, radius * 2, radius * 2), flat * CFrame.new(0.2, 0, 0), "accent", {
		shape = "Cylinder",
		material = NEON,
		transparency = 0.25,
		collide = false,
		shadow = false,
	})
	P(zone, "Inner", Vector3.new(0.12, radius * 2 - 1.6, radius * 2 - 1.6), flat * CFrame.new(0.24, 0, 0), "path", {
		shape = "Cylinder",
		collide = false,
		shadow = false,
	})
	return zone
end

-- Menu board: two posts and a panel facing -Z of `cf` (use CFrame.lookAt towards the viewer).
function Props.Board(parent: Instance, name: string, cf: CFrame, title: string, menu: string, slot: number?): BasePart
	local model = Instance.new("Model")
	model.Name = "Stand"
	for _, x in { -2.6, 2.6 } do
		P(model, "Post", Vector3.new(0.5, 6, 0.5), cf * CFrame.new(x, 3, 0.3), "wood")
	end
	P(model, "Frame", Vector3.new(6.6, 3.8, 0.35), cf * CFrame.new(0, 4.6, 0.1), "accent", { shadow = true })
	P(model, "Roof", Vector3.new(7.2, 0.4, 1.2), cf * CFrame.new(0, 6.7, 0.2), "roof")
	local panel = P(parent, name, Vector3.new(6, 3.2, 0.3), cf * CFrame.new(0, 4.6, -0.1), F.white, { query = false })
	Kit.Label(panel, title, Enum.NormalId.Front, Color3.fromRGB(60, 50, 40), 40).TextStrokeTransparency = 1
	local hint = Kit.Label(panel, "", Enum.NormalId.Back, Color3.fromRGB(60, 50, 40), 40)
	hint.Text = title
	hint.TextStrokeTransparency = 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Prompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Menu", menu)
	panel:SetAttribute("Menu", menu)
	if slot then
		prompt:SetAttribute("Slot", slot)
		panel:SetAttribute("Slot", slot)
	end
	prompt.Parent = panel
	model.Parent = panel -- decoration lives under the panel, so Boards/* holds only prompt parts
	return panel
end

-- Warehouse: centre `cf` on the ground, door facing -Z of `cf`.
function Props.Warehouse(parent: Instance, cf: CFrame, w: number, d: number): Model
	local m = Instance.new("Model")
	m.Name = "Warehouse"
	local h = 11
	P(m, "Floor", Vector3.new(w + 2, 0.8, d + 2), cf * CFrame.new(0, 0.4, 0), F.stone)
	P(m, "Walls", Vector3.new(w, h, d), cf * CFrame.new(0, 0.8 + h / 2, 0), "wood")
	for _, x in { -w / 2, w / 2 } do
		for _, z in { -d / 2, d / 2 } do
			P(m, "Corner", Vector3.new(1, h, 1), cf * CFrame.new(x, 0.8 + h / 2, z), F.white)
		end
	end
	P(m, "Trim", Vector3.new(w + 0.4, 0.8, d + 0.4), cf * CFrame.new(0, 0.8 + h - 0.4, 0), "accent")
	gable(m, cf * CFrame.new(0, 0.8 + h, 0), w + 2, d + 2, 6, "roof")
	P(m, "Door", Vector3.new(14, 9, 0.4), cf * CFrame.new(0, 0.8 + 4.5, -d / 2 - 0.1), F.black, { shade = 0.2 })
	P(m, "DoorFrame", Vector3.new(15.6, 1, 0.6), cf * CFrame.new(0, 0.8 + 9.5, -d / 2 - 0.2), F.white)
	-- egg crates stacked just inside the door so the deposit point reads at a glance
	for i, x in { -4.5, -1.5, 1.5, 4.5 } do
		P(m, "Crate", Vector3.new(2.6, 1.6, 2), cf * CFrame.new(x, 0.8 + 0.8, -d / 2 + 2), Color3.fromRGB(176, 120, 70), { material = Enum.Material.Wood })
		if i % 2 == 0 then
			P(m, "Crate", Vector3.new(2.6, 1.6, 2), cf * CFrame.new(x - 1.5, 0.8 + 2.4, -d / 2 + 2), Color3.fromRGB(176, 120, 70), { material = Enum.Material.Wood })
		end
	end
	local sign = P(m, "Sign", Vector3.new(16, 3, 0.5), cf * CFrame.new(0, 0.8 + h + 1.2, -d / 2 - 1.1), "accent", { shadow = true })
	Kit.Label(sign, "WAREHOUSE", Enum.NormalId.Front, Color3.new(1, 1, 1), 30)
	Kit.Egg(m, cf * CFrame.new(0, 0.8 + h + 5.2, -d / 2 - 1.1), Vector3.new(3, 4, 1), { name = "EggIcon", color = F.cream })
	m.Parent = parent
	return m
end

-- Loading dock: platform along x at `cf`, bay markers at given world CFrames.
function Props.Dock(parent: Instance, cf: CFrame, w: number, d: number, bays: { CFrame }): Model
	local m = Instance.new("Model")
	m.Name = "Dock"
	P(m, "Platform", Vector3.new(w, 2, d), cf * CFrame.new(0, 1, 0), F.stone)
	P(m, "Edge", Vector3.new(w, 0.4, 0.6), cf * CFrame.new(0, 2.2, -d / 2 + 0.3), F.yellow)
	for i, bcf in bays do
		local bay = P(m, "Bay" .. i, Vector3.new(10, 0.2, 18), bcf * CFrame.new(0, 0.12, 0), F.asphalt, { collide = false, shadow = false })
		bay:SetAttribute("Bay", i)
		for _, x in { -5, 5 } do
			P(bay, "Line", Vector3.new(0.4, 0.06, 18), bcf * CFrame.new(x, 0.25, 0), F.white, { collide = false, shadow = false })
		end
		local lamp = P(bay, "Lamp", Vector3.new(1.2, 1.2, 0.3), bcf * CFrame.new(0, 3.5, -10.6), F.darkStone, {
			material = NEON,
			collide = false,
			shadow = false,
		})
		lamp:SetAttribute("Bay", i)
		local num = P(bay, "Number", Vector3.new(3, 2, 0.2), bcf * CFrame.new(0, 3.6, 9.4), F.darkStone, { collide = false, shadow = false })
		Kit.Label(num, tostring(i), Enum.NormalId.Back, Color3.new(1, 1, 1), 30)
	end
	m.Parent = parent
	return m
end

function Props.Silo(parent: Instance, name: string, cf: CFrame, radius: number, built: boolean, permanent: boolean): Model
	local m = Instance.new("Model")
	m.Name = name
	Kit.Column(m, cf, 0.6, radius * 2 + 1.2, { name = "Pad", color = F.stone })
	if built then
		Kit.Column(m, cf * CFrame.new(0, 0.6, 0), 14, radius * 2, { name = "Body", color = F.metal, shadow = true, collide = true })
		Kit.Column(m, cf * CFrame.new(0, 4, 0), 0.7, radius * 2 + 0.3, { name = "Band", role = "accent" })
		Kit.Column(m, cf * CFrame.new(0, 10, 0), 0.7, radius * 2 + 0.3, { name = "Band", role = "accent" })
		P(m, "Cap", Vector3.new(radius * 2, radius * 2, radius * 2), cf * CFrame.new(0, 14.6, 0), "roof", { shape = "Ball" })
		if permanent then
			Kit.Column(m, cf * CFrame.new(0, 7, 0), 0.9, radius * 2 + 0.4, { name = "Gold", color = Color3.fromRGB(255, 200, 60), material = NEON })
		end
	else
		P(m, "Marker", Vector3.new(0.4, 1.4, 0.4), cf * CFrame.new(0, 1.3, 0), "wood")
	end
	m:SetAttribute("Built", built)
	m.Parent = parent
	return m
end

function Props.Shed(parent: Instance, cf: CFrame, w: number, d: number): Model
	local m = Instance.new("Model")
	m.Name = "WorkerShed"
	P(m, "Walls", Vector3.new(w, 7, d), cf * CFrame.new(0, 3.5, 0), "wood", { shade = 0.08 })
	gable(m, cf * CFrame.new(0, 7, 0), w + 1, d + 1.4, 3.5, "roof")
	P(m, "Door", Vector3.new(3.4, 5, 0.3), cf * CFrame.new(0, 2.5, -d / 2 - 0.1), F.black, { shade = 0.3 })
	P(m, "Window", Vector3.new(2.4, 1.8, 0.25), cf * CFrame.new(-5, 4, -d / 2 - 0.1), Color3.fromRGB(255, 236, 170), { material = NEON })
	P(m, "Bench", Vector3.new(5, 0.5, 1.4), cf * CFrame.new(4.6, 1.2, -d / 2 - 1.2), "wood", { shade = 0.2 })
	P(m, "Barrel", Vector3.new(1.6, 2, 1.6), cf * CFrame.new(-w / 2 - 1.2, 1, -d / 2 + 1.5), "wood", { shade = 0.3 })
	m.Parent = parent
	return m
end

-- Entrance gate with the owner's name. `cf` at the gate centre, facing out (-Z = outside).
function Props.Gate(parent: Instance, cf: CFrame, width: number): (Model, TextLabel, TextLabel)
	local m = Instance.new("Model")
	m.Name = "Gate"
	for _, x in { -width / 2, width / 2 } do
		P(m, "Pillar", Vector3.new(2, 12, 2), cf * CFrame.new(x, 6, 0), "wood", { collide = true })
		P(m, "PillarCap", Vector3.new(2.6, 0.8, 2.6), cf * CFrame.new(x, 12.4, 0), "accent")
	end
	local sign = P(m, "Nameplate", Vector3.new(width + 2, 4, 0.8), cf * CFrame.new(0, 10, 0), "roof", { shadow = true })
	local front = Kit.Label(sign, "Free plot", Enum.NormalId.Front, Color3.new(1, 1, 1), 24)
	local back = Kit.Label(sign, "Free plot", Enum.NormalId.Back, Color3.new(1, 1, 1), 24)
	Kit.Egg(m, cf * CFrame.new(0, 13.6, 0), Vector3.new(2.4, 3.2, 1), { name = "EggTop", role = "accent" })
	m.Parent = parent
	return m, front, back
end

-- Fence along a segment a -> b (world CFrames on the ground), posts every ~14 studs, 2 rails.
function Props.Fence(parent: Instance, a: Vector3, b: Vector3)
	local d = b - a
	local len = d.Magnitude
	if len < 0.5 then
		return
	end
	local n = math.max(1, math.floor(len / 14 + 0.5))
	for i = 0, n do
		local p = a + d * (i / n)
		P(parent, "Post", Vector3.new(0.8, 3.6, 0.8), CFrame.new(p + Vector3.new(0, 1.8, 0)), "wood", { shadow = false })
	end
	local mid = a + d / 2
	local cf = CFrame.lookAt(mid, mid + d)
	P(parent, "Rail", Vector3.new(0.3, 0.4, len), cf + Vector3.new(0, 2.8, 0), "wood", { collide = true, shadow = false, shade = 0.1 })
	P(parent, "Rail", Vector3.new(0.3, 0.4, len), cf + Vector3.new(0, 1.5, 0), "wood", { collide = true, shadow = false, shade = 0.1 })
end

-- One decoration of the theme's decor kind at `cf` (on the ground). `seed` varies size/rotation.
function Props.Decor(parent: Instance, kind: string, cf: CFrame, seed: number)
	local rng = Random.new(seed)
	local s = 0.85 + rng:NextNumber() * 0.4
	local rot = cf * CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0)
	local m = Instance.new("Model")
	m.Name = "Decor"
	if kind == "trees" or kind == "hives" then
		Kit.Column(m, rot, 5 * s, 1.4 * s, { name = "Trunk", color = F.trunk })
		P(m, "Leaves", Vector3.one * 7 * s, rot * CFrame.new(0, 7 * s, 0), F.leaf, { shape = "Ball", shadow = true })
		P(m, "Leaves", Vector3.one * 5 * s, rot * CFrame.new(1.6 * s, 9.6 * s, 0.6 * s), F.leaf:Lerp(Color3.new(1, 1, 0.4), 0.15), { shape = "Ball" })
		if kind == "hives" then
			local hive = rot * CFrame.new(3.5 * s, 0, 2 * s)
			Kit.Column(m, hive, 0.8, 2.2, { name = "HiveBase", color = F.trunk })
			for i = 0, 2 do
				Kit.Column(m, hive * CFrame.new(0, 0.8 + i * 0.9, 0), 0.9, 2.4 - i * 0.5, { name = "Hive", color = Color3.fromRGB(250, 196, 50) })
			end
		end
	elseif kind == "clover" then
		for i = 0, 2 do
			local a = i * math.pi * 2 / 3
			P(m, "Leaf", Vector3.new(2.2, 0.6, 2.2) * s, rot * CFrame.new(math.cos(a) * 1.2 * s, 2.6 * s, math.sin(a) * 1.2 * s), Color3.fromRGB(60, 170, 80), { shape = "Ball" })
		end
		Kit.Column(m, rot, 2.4 * s, 0.4, { name = "Stem", color = Color3.fromRGB(50, 130, 60) })
		P(m, "Flower", Vector3.one * 1.2, rot * CFrame.new(2.5, 0.6, 1), F.white, { shape = "Ball" })
		P(m, "Flower", Vector3.one * 1.0, rot * CFrame.new(-2, 0.5, -1.5), Color3.fromRGB(255, 160, 200), { shape = "Ball" })
	elseif kind == "palms" then
		local top = rot * CFrame.new(0, -1 * s, 0)
		for _ = 0, 3 do
			top = top * CFrame.new(0, 2.2 * s, 0) * CFrame.Angles(0, 0, math.rad(6))
			P(m, "Trunk", Vector3.new(1.2, 2.4, 1.2) * s, top, Color3.fromRGB(170, 130, 80))
		end
		for i = 0, 4 do
			local a = i * math.pi * 2 / 5
			P(m, "Frond", Vector3.new(1.4, 0.3, 6) * s, top * CFrame.Angles(0, a, 0) * CFrame.new(0, 1, -3 * s) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(60, 170, 70), { shadow = true })
		end
	elseif kind == "pines" then
		Kit.Column(m, rot, 3 * s, 1.2 * s, { name = "Trunk", color = F.trunk })
		for i = 0, 2 do
			local w = (7 - i * 2) * s
			P(m, "Needles", Vector3.new(w, 2.6 * s, w), rot * CFrame.new(0, (3.6 + i * 2.4) * s, 0) * CFrame.Angles(0, math.rad(45 * i), 0), Color3.fromRGB(40, 110, 70), { shadow = i == 0 })
		end
		P(m, "Snow", Vector3.new(1.6, 1.4, 1.6) * s, rot * CFrame.new(0, 10.5 * s, 0), F.white)
	elseif kind == "cacti" then
		local g = Color3.fromRGB(70, 150, 80)
		Kit.Column(m, rot, 8 * s, 1.8 * s, { name = "Cactus", color = g, shadow = true })
		P(m, "ArmL", Vector3.new(2.4, 1.2, 1.2) * s, rot * CFrame.new(-1.6 * s, 4 * s, 0), g)
		P(m, "ArmLUp", Vector3.new(1.2, 2.6, 1.2) * s, rot * CFrame.new(-2.6 * s, 5.5 * s, 0), g)
		P(m, "ArmR", Vector3.new(2.4, 1.2, 1.2) * s, rot * CFrame.new(1.6 * s, 5.4 * s, 0), g)
		P(m, "ArmRUp", Vector3.new(1.2, 2, 1.2) * s, rot * CFrame.new(2.6 * s, 6.6 * s, 0), g)
		P(m, "Bloom", Vector3.one * 0.9, rot * CFrame.new(0, 8.2 * s, 0), Color3.fromRGB(255, 110, 150), { shape = "Ball" })
	elseif kind == "rocks" then
		local dark = Color3.fromRGB(58, 50, 52)
		P(m, "Rock", Vector3.new(5, 3.6, 4) * s, rot * CFrame.new(0, 1.4 * s, 0) * CFrame.Angles(0.2, 0.4, 0.1), dark, { shadow = true, collide = true })
		P(m, "Rock", Vector3.new(3, 2.4, 3) * s, rot * CFrame.new(3 * s, 0.9 * s, 1.5 * s) * CFrame.Angles(-0.3, 1, 0.2), dark)
		P(m, "Lava", Vector3.new(0.5, 0.3, 3.6) * s, rot * CFrame.new(0, 3.2 * s, 0) * CFrame.Angles(0.2, 0.4, 0.1), Color3.fromRGB(255, 110, 30), { material = NEON })
	elseif kind == "crystals" then
		local c = Color3.fromRGB(190, 120, 255)
		for i = 0, 2 do
			local tilt = CFrame.Angles(math.rad(-15 + i * 15), 0, math.rad(12 - i * 12))
			P(m, "Crystal", Vector3.new(1.4, 5 - i, 1.4) * s, rot * CFrame.new((i - 1) * 1.4 * s, (2.5 - i * 0.5) * s, 0) * tilt * CFrame.Angles(0, math.rad(45), 0), if i == 1 then Color3.fromRGB(120, 220, 255) else c, {
				material = NEON,
				transparency = 0.15,
			})
		end
		P(m, "Base", Vector3.new(3.6, 0.8, 2.4) * s, rot * CFrame.new(0, 0.4, 0), F.darkStone)
	elseif kind == "orbs" then
		Kit.Column(m, rot, 3 * s, 1.6 * s, { name = "Pedestal", color = F.darkMetal })
		P(m, "Orb", Vector3.one * 2.6 * s, rot * CFrame.new(0, 5.4 * s, 0), Color3.fromRGB(120, 240, 255), { shape = "Ball", material = NEON })
		P(m, "Ring", Vector3.new(0.3, 4 * s, 4 * s), rot * CFrame.new(0, 5.4 * s, 0) * CFrame.Angles(0, 0, math.rad(70)), Color3.fromRGB(230, 90, 200), { shape = "Cylinder", transparency = 0.4 })
	else -- spires
		local gold = Color3.fromRGB(255, 200, 60)
		Kit.Column(m, rot, 1, 3 * s, { name = "Base", color = F.white })
		Kit.Column(m, rot * CFrame.new(0, 1, 0), 6 * s, 1.4 * s, { name = "Spire", color = F.white, shadow = true })
		Kit.Column(m, rot * CFrame.new(0, 1 + 6 * s, 0), 2 * s, 0.8 * s, { name = "Tip", color = gold })
		P(m, "Orb", Vector3.one * 1.4 * s, rot * CFrame.new(0, (3.6 + 8 * s) - 2.4 * s, 0), gold, { shape = "Ball", material = NEON })
	end
	m.Parent = parent
end

-- Hill ridge (with tunnel mouths at the given world positions) along a row of plots.
function Props.Ridge(parent: Instance, cf: CFrame, length: number, depth: number, tunnels: { CFrame })
	local m = Instance.new("Model")
	m.Name = "Ridge"
	local green = Color3.fromRGB(96, 160, 84)
	P(m, "Hill", Vector3.new(length, 26, depth), cf * CFrame.new(0, 13, -depth / 2), green, { material = Enum.Material.Grass, collide = true })
	P(m, "Slope", Vector3.new(length, 26, 30), cf * CFrame.new(0, 13, -depth - 15), green, {
		shape = "Wedge",
		material = Enum.Material.Grass,
		collide = true,
	})
	P(m, "Crest", Vector3.new(length, 8, depth * 0.6), cf * CFrame.new(0, 30, -depth * 0.55), green:Lerp(Color3.new(0, 0, 0), 0.08), {
		material = Enum.Material.Grass,
		collide = true,
	})
	for i, tcf in tunnels do
		local mouth = P(m, "Tunnel" .. i, Vector3.new(14, 11, 1), tcf * CFrame.new(0, 5.5, -0.4), F.black, { collide = false, shadow = false })
		mouth.Material = Enum.Material.SmoothPlastic
		P(m, "Arch", Vector3.new(16, 2, 2), tcf * CFrame.new(0, 12, 0.6), F.stone)
		P(m, "ArchL", Vector3.new(2, 11, 2), tcf * CFrame.new(-8, 5.5, 0.6), F.stone)
		P(m, "ArchR", Vector3.new(2, 11, 2), tcf * CFrame.new(8, 5.5, 0.6), F.stone)
		local sign = P(m, "MarketSign", Vector3.new(12, 2.4, 0.4), tcf * CFrame.new(0, 14.6, 0.6), F.yellow)
		Kit.Label(sign, "TO MARKET", Enum.NormalId.Back, Color3.fromRGB(40, 40, 40), 30).TextStrokeTransparency = 1
	end
	m.Parent = parent
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- The farm world: hub, boulevard, hills, lighting and the 8 player plots, all native parts.
-- Layout numbers live in Shared/Logic/PlotLayout (pure, unit-tested); this module turns them
-- into instances that follow the World contract in docs/ARCHITECTURE.md.
--
--   World.Init()                 once: hub, roads, ridges, lighting, Workspace.Plots/Plot1..Plot8
--   World.PlotCount              8
--   World.GetPlot(index) -> Model
--   World.ApplyState(plot, info) idempotent; info = { egg, houses{4}, vehicles{8}, workers{8},
--                                silos, permanentSilos, ownerName? }. Only changed pieces are
--                                rebuilt: house tier swaps (old model destroyed, build puff),
--                                theme recolour when the egg changes, silos, bay lamps, nameplate.
--   World.ResetPlot(plot)        back to an empty, unowned farm ("Free plot")
--   World.Zones(plot) -> { collect = { [slot]: BasePart }, deposit: BasePart,
--                          foxSpots: { Vector3 }, spawn: SpawnLocation }
-- Ring zone parts are unrotated, invisible blocks: radius = Size.X / 2 (= Size.Z / 2), as
-- ZoneService expects; the glow is drawn by their child parts.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Logic = Shared:WaitForChild("Logic")
local Kit = require(Shared:WaitForChild("Models"):WaitForChild("Kit"))
local Layout = require(Logic:WaitForChild("PlotLayout"))
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))
local GameInfo = require(Shared:WaitForChild("GameInfo"))
local Houses = require(script.Parent:WaitForChild("Houses"))
local Props = require(script.Parent:WaitForChild("Props"))

local World = {}
World.PlotCount = Layout.PlotCount

type Vec = Layout.Vec

type PlotState = {
	index: number,
	cf: CFrame,
	theme: string,
	decor: string,
	houses: { number },
	silos: { string }, -- per silo spot: "" (empty), "b" (built) or "p" (permanent)
	bays: { boolean },
	owner: string?,
	buildings: { Model? },
	houseModels: { Model },
	rings: { [number]: BasePart },
	deposit: BasePart,
	spawn: SpawnLocation,
	gateFront: TextLabel,
	gateBack: TextLabel,
	siloFolder: Folder,
	decorModel: Model,
	dock: Model,
	foxSpots: { Vector3 },
}

local plots: { Model } = {}
local states: { [Model]: PlotState } = {}
local initialized = false

local F = Kit.Fixed

local function v3(p: Vec): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function themeOf(egg: number?): string
	local e = Eggs.List[math.clamp(math.floor(tonumber(egg) or 1), 1, Eggs.Count)]
	return e.theme
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function marker(parent: Instance, name: string, cf: CFrame, size: Vector3?): BasePart
	return Kit.Part(parent, {
		name = name,
		size = size or Vector3.new(1, 1, 1),
		cf = cf,
		transparency = 1,
		collide = false,
		shadow = false,
	})
end

-- ------------------------------------------------------------------ lighting & sky
local function setupLighting()
	local palette = Kit.Palette("meadow")
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.28
	atmo.Offset = 0.2
	atmo.Color = palette.fog
	atmo.Decay = Color3.fromRGB(150, 170, 200)
	atmo.Glare = 0.2
	atmo.Haze = 1.2
	atmo.Parent = Lighting
	local function ensure(class: string, name: string): Instance
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(class)
			e.Name = name
			e.Parent = Lighting
		end
		return e :: Instance
	end
	local bloom = ensure("BloomEffect", "WorldBloom") :: BloomEffect
	bloom.Intensity = 0.35
	bloom.Size = 22
	bloom.Threshold = 1.4
	local cc = ensure("ColorCorrectionEffect", "WorldGrade") :: ColorCorrectionEffect
	cc.Saturation = 0.12
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	local rays = ensure("SunRaysEffect", "WorldSunRays") :: SunRaysEffect
	rays.Intensity = 0.04
	rays.Spread = 0.6
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain and not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.55
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
end

-- ------------------------------------------------------------------ hub, boulevard, hills
local function buildCommons(root: Folder)
	local stone = Color3.fromRGB(196, 190, 176)
	local grass = Color3.fromRGB(104, 176, 80)
	Kit.SetPalette(Kit.Palette("meadow"))
	local P = Props.P
	P(root, "Baseplate", Vector3.new(1100, 4, 860), CFrame.new(0, -2.4, 0), grass, { material = Enum.Material.Grass, collide = true, shadow = false })
	-- boulevard along x with sidewalks and lane dashes
	local half = 4 * Layout.COLUMN_SPACING / 2 + 30
	P(root, "Boulevard", Vector3.new(half * 2, 0.3, 20), CFrame.new(0, -0.1, 0), F.asphalt, { collide = true, shadow = false })
	for _, z in { -14, 14 } do
		P(root, "Sidewalk", Vector3.new(half * 2, 0.5, 8), CFrame.new(0, 0, z), stone, { collide = true, shadow = false })
	end
	for x = -half + 15, half - 15, 30 do
		if math.abs(x) > 34 then
			P(root, "Dash", Vector3.new(8, 0.06, 0.8), CFrame.new(x, 0.08, 0), F.white, { collide = false, shadow = false })
		end
	end
	-- lamp posts
	for x = -half + 40, half - 40, 100 do
		for _, z in { -17, 17 } do
			P(root, "LampPost", Vector3.new(0.6, 10, 0.6), CFrame.new(x, 5, z), F.darkMetal, { collide = true, shadow = false })
			P(root, "Lamp", Vector3.new(1.6, 1.2, 1.6), CFrame.new(x, 10.4, z), Color3.fromRGB(255, 236, 180), { material = Enum.Material.Neon, shadow = false })
		end
	end
	-- side paths between neighbouring plots, from the boulevard to the hills
	for c = 1, 3 do
		local x = (c - 2) * Layout.COLUMN_SPACING
		for _, sign in { -1, 1 } do
			local z0, z1 = 18, Layout.ROW_Z + Layout.HALF_D
			P(root, "SidePath", Vector3.new(10, 0.3, z1 - z0), CFrame.new(x, -0.05, sign * (z0 + z1) / 2), stone, { collide = true, shadow = false })
		end
	end
	-- a short walk from the sidewalk to every plot gate
	for i = 1, Layout.PlotCount do
		local o = Layout.Origin(i)
		local sign = if o.z > 0 then 1 else -1
		local z0, z1 = 18, Layout.ROW_Z - Layout.HALF_D
		P(root, "GatePath", Vector3.new(Layout.Gate.width, 0.3, z1 - z0), CFrame.new(o.x, -0.05, sign * (z0 + z1) / 2), stone, { collide = true, shadow = false })
	end
	-- hub plaza with the hub spawn and a giant egg statue
	Kit.Column(root, CFrame.new(0, -0.2, 0), 0.6, 64, { name = "Plaza", color = stone, collide = true })
	Kit.Column(root, CFrame.new(0, 0.1, 0), 0.4, 50, { name = "PlazaInner", color = Color3.fromRGB(230, 214, 170), collide = true })
	Kit.Column(root, CFrame.new(0, 0.5, 0), 2.4, 16, { name = "Pedestal", color = F.white, collide = true, shadow = true })
	Kit.Column(root, CFrame.new(0, 2.9, 0), 0.6, 16.6, { name = "PedestalRing", color = Color3.fromRGB(255, 200, 60) })
	Kit.Egg(root, CFrame.new(0, 11.5, 0), Vector3.new(10, 14, 10), { name = "GoldenEgg", color = Color3.fromRGB(255, 210, 70), reflect = 0.2, shadow = true, collide = true })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.1, -20)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(255, 214, 74)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = root
	local sign = P(root, "HubSign", Vector3.new(30, 6, 1), CFrame.new(0, 22, 0) * CFrame.Angles(0, 0, 0), Color3.fromRGB(230, 70, 60), { shadow = true })
	Kit.Label(sign, GameInfo.Name, Enum.NormalId.Front, Color3.new(1, 1, 1), 20)
	Kit.Label(sign, GameInfo.Name, Enum.NormalId.Back, Color3.new(1, 1, 1), 20)
	P(root, "SignPole", Vector3.new(0.6, 4, 0.6), CFrame.new(0, 17.6, 0), F.darkMetal)
	for i = 0, 7 do
		local a = i * math.pi / 4
		local x, z = math.cos(a) * 27, math.sin(a) * 27
		if math.abs(z) > 8 then
			P(root, "Planter", Vector3.new(4, 1.6, 4), CFrame.new(x, 0.8, z), F.trunk, { collide = true })
			P(root, "Bush", Vector3.one * 4, CFrame.new(x, 2.6, z), F.leaf, { shape = "Ball" })
		end
	end
	-- hills behind each row, with one tunnel per plot for the market road
	for _, north in { true, false } do
		local dir = if north then 1 else -1
		local faceZ = dir * (Layout.ROW_Z - Layout.RIDGE_LOCAL_Z)
		local face = CFrame.lookAt(Vector3.new(0, 0, faceZ), Vector3.new(0, 0, faceZ + dir))
		local tunnels = {}
		for i = 1, Layout.PlotCount do
			if (i <= 4) == north then
				local p = Layout.ToWorld(i, { x = Layout.ROAD_X, y = 0, z = Layout.RIDGE_LOCAL_Z })
				table.insert(tunnels, CFrame.lookAt(Vector3.new(p.x, 0, p.z), Vector3.new(p.x, 0, p.z + dir)))
			end
		end
		Props.Ridge(root, face, half * 2 + 200, Layout.RIDGE_DEPTH, tunnels)
	end
end

-- ------------------------------------------------------------------ one plot
local function buildDecor(st: PlotState, parent: Instance)
	local m = Instance.new("Model")
	m.Name = "Decor"
	for i, d in Layout.Decor do
		local cf = st.cf * CFrame.new(d.x, 0, d.z)
		Props.Decor(m, st.decor, cf, st.index * 100 + i)
	end
	m.Parent = parent
	st.decorModel = m
end

local function puff(at: Vector3, palette: Kit.Palette, scale: number?)
	local s = scale or 1
	local holder = Kit.Part(Workspace, {
		name = "BuildPuff",
		size = Vector3.new(1, 1, 1),
		cf = CFrame.new(at),
		transparency = 1,
		collide = false,
		shadow = false,
	})
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.new(1, 1, 1), palette.accent)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3 * s), NumberSequenceKeypoint.new(1, 7 * s) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Speed = NumberRange.new(8 * s, 16 * s)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 120
	emitter.Drag = 4
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.Parent = holder
	holder.Size = Vector3.new(14, 2, 14) * s
	task.delay(0.3, function()
		emitter.Enabled = false
	end)
	Debris:AddItem(holder, 2.5)
end

local function houseCF(st: PlotState, slot: number): CFrame
	local h = Layout.Houses[slot]
	local pos = (st.cf * CFrame.new(h.building.x, 0, h.building.z)).Position
	local dir = st.cf:VectorToWorldSpace(v3(h.facing))
	return CFrame.lookAt(pos, pos + dir)
end

local function setHouse(st: PlotState, slot: number, tier: number, palette: Kit.Palette, withPuff: boolean)
	local old = st.buildings[slot]
	if old and st.houses[slot] == tier then
		return
	end
	if old then
		old:Destroy()
	end
	local model = Houses.Build(tier, palette)
	model.Name = "Building"
	model:PivotTo(houseCF(st, slot))
	model.Parent = st.houseModels[slot]
	st.buildings[slot] = model
	st.houses[slot] = tier
	if withPuff and old then
		puff(houseCF(st, slot).Position + Vector3.new(0, 4, 0), palette, if tier >= 6 then 1.6 else 1)
	end
end

local function setSilo(st: PlotState, i: number, code: string, palette: Kit.Palette)
	if st.silos[i] == code then
		return
	end
	local existing = st.siloFolder:FindFirstChild("Silo" .. i)
	if existing then
		existing:Destroy()
	end
	Kit.SetPalette(palette)
	local s = Layout.Silos[i]
	Props.Silo(st.siloFolder, "Silo" .. i, st.cf * CFrame.new(s.x, 0, s.z), Layout.SiloRadius, code ~= "", code == "p")
	st.silos[i] = code
end

local function setBay(st: PlotState, i: number, owned: boolean, palette: Kit.Palette)
	if st.bays[i] == owned then
		return
	end
	st.bays[i] = owned
	local bay = st.dock:FindFirstChild("Bay" .. i)
	local lamp = bay and bay:FindFirstChild("Lamp")
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = if owned then palette.accent else F.darkStone
		lamp:SetAttribute("Role", if owned then "accent" else nil)
	end
end

local function setOwner(st: PlotState, name: string?)
	if st.owner == name then
		return
	end
	st.owner = name
	local text = if name and name ~= "" then name .. "'s Farm" else "Free plot"
	st.gateFront.Text = text
	st.gateBack.Text = text
end

local function buildPlot(index: number, parent: Instance): Model
	local o, yaw = Layout.Origin(index)
	local plotCF = CFrame.new(o.x, 0, o.z) * CFrame.Angles(0, yaw, 0)
	local function L(x: number, z: number, y: number?): CFrame
		return plotCF * CFrame.new(x, y or 0, z)
	end
	local function look(from: Vec, to: Vec): CFrame
		local a = L(from.x, from.z).Position
		local b = L(to.x, to.z).Position
		return CFrame.lookAt(a, b)
	end
	local themeKey = "meadow"
	local palette = Kit.Palette(themeKey)
	Kit.SetPalette(palette)

	local plot = Instance.new("Model")
	plot.Name = "Plot" .. index
	plot:SetAttribute("PlotIndex", index)
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", "")
	plot:SetAttribute("Egg", 1)
	plot:SetAttribute("Population", 0)
	plot:SetAttribute("HouseTiers", "0,0,0,0")
	plot:SetAttribute("VehicleTiers", "0,0,0,0,0,0,0,0")
	plot:SetAttribute("WorkerTiers", "0,0,0,0,0,0,0,0")
	plot:SetAttribute("Silos", 0)

	local P = Props.P
	-- ground, paths, lots and road surfaces
	local ground = Instance.new("Model")
	ground.Name = "Ground"
	P(ground, "Field", Vector3.new(Layout.PLOT_W, 1, Layout.PLOT_D), L(0, 0, -0.5), "ground", { material = Enum.Material.Grass, collide = true, shadow = false })
	P(ground, "Border", Vector3.new(Layout.PLOT_W + 4, 0.6, Layout.PLOT_D + 4), L(0, 0, -0.55), "groundEdge", { collide = true, shadow = false })
	for _, r in Layout.Paths do
		P(ground, "Path", Vector3.new(r.x1 - r.x0, 0.2, r.z1 - r.z0), L((r.x0 + r.x1) / 2, (r.z0 + r.z1) / 2, 0.0), "path", { collide = true, shadow = false })
	end
	for _, r in Layout.RoadRects do
		P(ground, "Road", Vector3.new(r.x1 - r.x0, 0.24, r.z1 - r.z0), L((r.x0 + r.x1) / 2, (r.z0 + r.z1) / 2, 0.0), F.asphalt, { collide = true, shadow = false })
	end
	P(ground, "RoadLine", Vector3.new(120, 0.05, 0.6), L(15, Layout.ROAD_Z, 0.14), F.yellow, { collide = false, shadow = false })
	ground.Parent = plot

	local st: PlotState = {
		index = index,
		cf = plotCF,
		theme = themeKey,
		decor = Kit.Decor(themeKey),
		houses = {},
		silos = {},
		bays = {},
		owner = "\0",
		buildings = {},
		houseModels = {},
		rings = {},
		deposit = nil :: any,
		spawn = nil :: any,
		gateFront = nil :: any,
		gateBack = nil :: any,
		siloFolder = nil :: any,
		decorModel = nil :: any,
		dock = nil :: any,
		foxSpots = {},
	}

	-- houses: lot pad, yard anchor, collect ring; the tier model is added by setHouse
	local housesFolder = folder(plot, "Houses")
	for _, h in Layout.Houses do
		local hm = Instance.new("Model")
		hm.Name = "House" .. h.slot
		hm:SetAttribute("Slot", h.slot)
		local lot = h.lot
		P(hm, "Lot", Vector3.new(lot.x1 - lot.x0, 0.3, lot.z1 - lot.z0), L((lot.x0 + lot.x1) / 2, (lot.z0 + lot.z1) / 2, 0.0), "groundEdge", { collide = true, shadow = false })
		local anchor = marker(hm, "Anchor", L(h.anchor.x, h.anchor.z, 0.2), Vector3.new(h.anchorSize.x, 0.4, h.anchorSize.z))
		anchor:SetAttribute("Slot", h.slot)
		-- a low hay strip marks the yard where the flock wanders
		P(hm, "Yard", Vector3.new(h.anchorSize.x + 1, 0.12, h.anchorSize.z + 1), L(h.anchor.x, h.anchor.z, 0.17), F.hay, { collide = false, shadow = false, transparency = 0.35 })
		local ring = Props.Ring(hm, "CollectRing", L(h.ring.x, h.ring.z, 0.0), h.ringRadius)
		ring:SetAttribute("Slot", h.slot)
		st.rings[h.slot] = ring
		hm.Parent = housesFolder
		st.houseModels[h.slot] = hm
	end

	-- warehouse + deposit ring
	local wh = Layout.Warehouse
	local warehouse = Props.Warehouse(plot, look(wh.center, { x = wh.center.x, y = 0, z = wh.center.z + 1 }), wh.w, wh.d)
	st.deposit = Props.Ring(warehouse, "DepositRing", L(Layout.Deposit.pos.x, Layout.Deposit.pos.z), Layout.Deposit.radius)

	-- dock with bays, road waypoints
	local bayCFs = {}
	for i, b in Layout.Bays do
		bayCFs[i] = look(b, { x = b.x, y = 0, z = b.z - 1 })
	end
	local dc = Layout.Dock.center
	st.dock = Props.Dock(plot, look(dc, { x = dc.x, y = 0, z = dc.z - 1 }), Layout.Dock.w, Layout.Dock.d, bayCFs)
	local road = folder(plot, "Road")
	road:SetAttribute("TunnelAt", Layout.TunnelAt)
	for k, p in Layout.Road do
		local nxt = Layout.Road[k + 1] or { x = p.x, y = 0, z = p.z - 1 }
		local part = marker(road, "P" .. k, look(p, nxt))
		part:SetAttribute("Index", k)
	end

	-- worker shed and path start
	local shed = Layout.Shed
	Props.Shed(plot, look(shed.center, { x = shed.center.x - 1, y = 0, z = shed.center.z }), shed.d, shed.w)
	local wp = Instance.new("Model")
	wp.Name = "WorkerPath"
	local start = marker(wp, "Start", L(Layout.WorkerStart.x, Layout.WorkerStart.z, 0.5))
	wp.PrimaryPart = start
	wp.Parent = plot

	-- silos (spots 1..10, built on demand)
	st.siloFolder = folder(plot, "Silos")
	for i = 1, Layout.SiloCount do
		setSilo(st, i, "", palette)
	end

	-- boards
	local boards = folder(plot, "Boards")
	local titles = { Housing = "HOUSING", Shipping = "SHIPPING", Workers = "WORKERS", Silos = "SILOS", Upgrades = "UPGRADES", Eggs = "EGGS" }
	for _, b in Layout.Boards do
		local title = titles[b.menu] or b.menu
		if b.slot then
			title = "HOUSE " .. b.slot
		end
		Props.Board(boards, b.name, look(b.pos, b.look), title, b.menu, b.slot)
	end

	-- fox spots
	local fox = folder(plot, "FoxSpots")
	for i, p in Layout.FoxSpots do
		local part = marker(fox, "FoxSpot" .. i, L(p.x, p.z, 0.5))
		table.insert(st.foxSpots, part.Position)
	end

	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = look(Layout.Spawn, { x = 0, y = 0, z = Layout.Spawn.z - 1 }) * CFrame.new(0, -0.3, 0)
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.CanTouch = true
	spawn:SetAttribute("Role", "accent")
	spawn.Color = palette.accent
	spawn.Parent = plot
	st.spawn = spawn

	-- gate with nameplate, fences, decor
	local gate, front, back = Props.Gate(plot, look(Layout.Gate.pos, { x = 0, y = 0, z = Layout.Gate.pos.z + 1 }), Layout.Gate.width)
	local _ = gate
	st.gateFront, st.gateBack = front, back
	local fence = Instance.new("Model")
	fence.Name = "Fence"
	for _, seg in Layout.Fence do
		Props.Fence(fence, L(seg.a.x, seg.a.z).Position, L(seg.b.x, seg.b.z).Position)
	end
	fence.Parent = plot
	buildDecor(st, plot)

	plot.WorldPivot = plotCF
	states[plot] = st
	plot.Parent = parent
	return plot
end

-- ------------------------------------------------------------------ public API
function World.Init()
	if initialized then
		return
	end
	initialized = true
	setupLighting()
	local commons = Workspace:FindFirstChild("Commons") or folder(Workspace, "Commons")
	buildCommons(commons :: Folder)
	local root = Workspace:FindFirstChild("Plots") or folder(Workspace, "Plots")
	for i = 1, World.PlotCount do
		plots[i] = buildPlot(i, root)
		World.ResetPlot(plots[i])
	end
end

function World.GetPlot(index: number): Model
	local p = plots[index]
	assert(p, "World.GetPlot: no plot " .. tostring(index))
	return p
end

export type Info = {
	egg: number,
	houses: { number },
	vehicles: { number }?,
	workers: { number }?,
	silos: number?,
	permanentSilos: number?,
	ownerName: string?,
}

local function apply(plot: Model, info: Info, withPuff: boolean)
	local st = states[plot]
	assert(st, "World.ApplyState: unknown plot")
	local themeKey = themeOf(info.egg)
	local palette = Kit.Palette(themeKey)
	Kit.SetPalette(palette)
	if themeKey ~= st.theme then
		st.theme = themeKey
		Kit.Recolor(plot, palette)
		local kind = Kit.Decor(themeKey)
		if kind ~= st.decor then
			st.decor = kind
			if st.decorModel then
				st.decorModel:Destroy()
			end
			buildDecor(st, plot)
		end
	end
	for slot = 1, #Layout.Houses do
		local tier = math.clamp(math.floor(tonumber(info.houses[slot]) or 0), 0, Houses.MaxTier)
		setHouse(st, slot, tier, palette, withPuff)
	end
	local built = math.clamp(math.max(tonumber(info.silos) or 0, tonumber(info.permanentSilos) or 0), 0, Layout.SiloCount)
	local perma = math.clamp(tonumber(info.permanentSilos) or 0, 0, Layout.SiloCount)
	for i = 1, Layout.SiloCount do
		setSilo(st, i, if i <= perma then "p" elseif i <= built then "b" else "", palette)
	end
	local vehicles = info.vehicles or {}
	for i = 1, #Layout.Bays do
		setBay(st, i, (tonumber(vehicles[i]) or 0) > 0, palette)
	end
	setOwner(st, info.ownerName)
end

function World.ApplyState(plot: Model, info: Info)
	apply(plot, info, true)
end

function World.ResetPlot(plot: Model)
	apply(plot, {
		egg = 1,
		houses = { 0, 0, 0, 0 },
		vehicles = { 0, 0, 0, 0, 0, 0, 0, 0 },
		workers = { 0, 0, 0, 0, 0, 0, 0, 0 },
		silos = 0,
		permanentSilos = 0,
		ownerName = nil,
	}, false)
end

function World.Zones(plot: Model)
	local st = states[plot]
	assert(st, "World.Zones: unknown plot")
	return {
		collect = table.clone(st.rings),
		deposit = st.deposit,
		foxSpots = table.clone(st.foxSpots),
		spawn = st.spawn,
	}
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="65">
      <Properties>
        <string name="Name">TestHarness</string>
      </Properties>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">TestSetup</string>
          <string name="Source"><![CDATA[--!nonstrict
-- TEST PLACE ONLY. Swaps in memory persistence and the simulated checkout, adds test-only codes and
-- a DevCommand remote (ReplicatedStorage.DevCommand) used by the test client's dev panel.
-- None of this exists in build/EggFarm.rbxlx.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")
local State = require(Shared.Logic.State)
local Products = require(Shared.Data.Products)
local MemoryAdapter = require(Server.Persistence.MemoryAdapter)
local TestCheckout = require(Server.Commerce.TestCheckout)
local Codes = require(Server.Data.Codes)
local Fixtures = require(ReplicatedStorage:WaitForChild("TestFixtures"):WaitForChild("Fixtures"))

local cat = {
	Eggs = require(Shared.Data.Eggs),
	Housing = require(Shared.Data.Housing),
	Vehicles = require(Shared.Data.Vehicles),
	Workers = require(Shared.Data.Workers),
	Upgrades = require(Shared.Data.Upgrades),
	Boosts = require(Shared.Data.Boosts),
}

local TestSetup = {}

function TestSetup.Configure(ctx)
	ctx.PersistenceAdapter = MemoryAdapter.new(function()
		local s = State.New(0)
		s.createdAt = 0
		return s
	end, "test-" .. game.JobId)
	local checkout = TestCheckout.new(Products, "success")
	ctx.TestCheckout = checkout
	ctx.CommerceService.SetTestCheckout(checkout)
	local codes = table.clone(Codes)
	codes.TESTEXPIRED = { reward = { gold = 1 }, expires = 1 } -- exercises the "expired" response
	ctx.Codes = codes
	ctx.AfterInit = TestSetup.AfterInit
end

local commands = {}

local function farmOf(ctx, player)
	return ctx.FarmService.Get(player)
end

commands.cash = function(ctx, player, f)
	f.state.cash += 1e6 * cat.Eggs.List[f.state.egg].costScale
end
commands.gold = function(ctx, player, f)
	f.state.gold += 1000
end
commands.tutorial = function(ctx, player, f)
	f.state.tutorial.step, f.state.tutorial.done = 8, true
end
commands.maxed = function(ctx, player, f)
	Fixtures.Maxed(f.state, cat)
end
commands.egg = function(ctx, player, f, n)
	Fixtures.AtEgg(f.state, tonumber(n) or 1, cat)
end
commands.boosts = function(ctx, player, f)
	Fixtures.AllBoosts(f.state, cat)
end
commands.quests = function(ctx, player, f)
	Fixtures.QuestsReady(f.state)
end
commands.forward = function(ctx, player, f, seconds)
	local s = math.clamp(tonumber(seconds) or 600, 1, 86400)
	f:Step(s, ctx.FarmService.Now())
end
commands.offline = function(ctx, player, f, seconds)
	f.state.lastSeen = ctx.FarmService.Now() - math.clamp(tonumber(seconds) or 7200, 1, 86400 * 3)
	f:ComputeOffline(ctx.FarmService.Now())
end
commands.nextday = function(ctx, player, f)
	ctx.DayOffset = (ctx.DayOffset or 0) + 86400
	ctx.FarmService.SetTimeOffset(ctx.DayOffset)
end
commands.fox = function(ctx, player, f)
	ctx.FoxService.SpawnNow(player)
end
commands.checkout = function(ctx, player, f, mode)
	if mode == "success" or mode == "cancel" or mode == "fail" then
		ctx.TestCheckout.mode = mode
	end
end
commands.failload = function(ctx)
	ctx.PersistenceAdapter.store.failLoads += 1
end
commands.failsave = function(ctx)
	ctx.PersistenceAdapter.store.failSaves += 1
end
commands.reset = function(ctx, player, f)
	local fresh = State.New(ctx.FarmService.Now())
	for k in f.state do
		f.state[k] = nil
	end
	for k, v in fresh do
		f.state[k] = v
	end
end
commands.rejoin = function(ctx, player)
	player:Kick("(Test) Rejoin to test reconnect: your memory save is kept while this server runs.")
end

function TestSetup.AfterInit(ctx)
	local remote = Instance.new("RemoteFunction")
	remote.Name = "DevCommand"
	remote.OnServerInvoke = function(player: Player, name: any, arg: any)
		if type(name) ~= "string" or not commands[name] then
			return { ok = false, message = "unknown command" }
		end
		local f = farmOf(ctx, player)
		if not f and name ~= "failload" and name ~= "failsave" then
			return { ok = false, message = "farm not loaded" }
		end
		local ok, err = pcall(commands[name], ctx, player, f, arg)
		if f then
			f.dirty = true
			ctx.FarmService.Push(player, true)
		end
		return { ok = ok, message = if ok then name .. " done" else tostring(err) }
	end
	remote.Parent = ReplicatedStorage
	ReplicatedStorage:SetAttribute("TestPlace", true)
	ReplicatedStorage:SetAttribute("CheckoutKind", "test")
end

TestSetup.Players = Players
return TestSetup
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="67">
      <Properties>
        <string name="Name">Vendor</string>
      </Properties>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="69">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="70">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="71">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="EnableMouseLockOption">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="72">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="73">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="74">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Events</string>
              <string name="Source"><![CDATA[--!strict
-- Turns FarmEvents (ARCHITECTURE.md "Remotes") into feedback: toasts, money popups, sounds and
-- the big Rebirth / Prestige banner. Popups honour settings.effects.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))
local Boosts = require(Shared:WaitForChild("Data"):WaitForChild("Boosts"))
local Housing = require(Shared:WaitForChild("Data"):WaitForChild("Housing"))
local Vehicles = require(Shared:WaitForChild("Data"):WaitForChild("Vehicles"))
local Workers = require(Shared:WaitForChild("Data"):WaitForChild("Workers"))
local Upgrades = require(Shared:WaitForChild("Data"):WaitForChild("Upgrades"))
local GameInfo = require(Shared:WaitForChild("GameInfo"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Num = require(UI.Num)
local Toasts = require(script.Parent.Toasts)
local Sound = require(script.Parent.Sound)
local Common = require(script.Parent.Parent.Menus.Common)

local Events = {}

local CASH_AT = UDim2.new(0.5, 0, 0, 96)
local BASKET_AT = UDim2.new(0.5, -80, 0, 120)

function Events.Start(store: any)
	local function effects(): boolean
		local snap = store.Get()
		return snap == nil or snap.settings.effects ~= false
	end

	local handlers: { [string]: (any) -> () } = {}

	handlers.Collected = function(d)
		Sound.Play("collect")
		if effects() and (d.amount or 0) > 0 then
			Toasts.Popup("+" .. Num.Short(d.amount), Color3.fromRGB(255, 244, 220), BASKET_AT, "egg")
		end
		if d.full then
			Toasts.Show("Basket full! Take the eggs to the warehouse.", "warn")
		end
	end
	handlers.Deposited = function(d)
		Sound.Play("deposit")
		if effects() and (d.amount or 0) > 0 then
			Toasts.Popup("+" .. Num.Short(d.amount) .. " stored", Theme.Color.Good, BASKET_AT, "basket")
		end
	end
	handlers.Sold = function(d)
		Sound.Play("coin")
		if effects() and (d.cash or 0) > 0 then
			Toasts.Popup("+" .. Num.Cash(d.cash), Theme.Color.Cash, CASH_AT, "cash")
		end
	end
	handlers.Purchased = function(d)
		Sound.Play("buy")
		local text: string? = nil
		if d.kind == "house" then
			local t = Housing.Tiers[d.tier or 1]
			text = string.format("House %d: %s!", d.slot or 0, t and t.name or "upgraded")
		elseif d.kind == "vehicle" then
			local t = Vehicles.Tiers[d.tier or 1]
			text = string.format("Vehicle %d: %s!", d.slot or 0, t and t.name or "upgraded")
		elseif d.kind == "worker" then
			local t = Workers.Tiers[d.tier or 1]
			text = string.format("Worker %d: %s!", d.slot or 0, t and t.name or "hired")
		elseif d.kind == "silo" then
			text = string.format("Silo built! (%d)", d.count or 0)
		elseif (d.kind == "common" or d.kind == "epic") and d.id then
			local u = Upgrades.ById[d.id]
			text = string.format("%s: level %d", u and u.name or d.id, d.level or 0)
		end
		if text then
			Toasts.Show(text, "good")
		end
	end
	handlers.Rebirth = function(d)
		Sound.Play("rebirth")
		local egg = Eggs.List[d.to or 1]
		local sub = "Welcome to the " .. (egg and egg.name or "next egg") .. "!"
		if (d.gold or 0) > 0 then
			sub ..= "  +" .. Num.Short(d.gold) .. " " .. GameInfo.Currency.Gold
		end
		Toasts.Banner(if d.skipped then "SKIPPED!" else "REBIRTH!", sub, Theme.Color.Purple, "rebirth")
	end
	handlers.Prestige = function(d)
		Sound.Play("rebirth")
		Toasts.Banner("PRESTIGE!", string.format("+%d %s (total %d)", d.stars or 0, GameInfo.Currency.Star, d.total or 0), Theme.Color.PurpleDark, "prestige")
	end
	handlers.BoostUsed = function(d)
		local b = Boosts.ById[d.id]
		Toasts.Show((b and b.name or "Boost") .. " is running!", "good")
	end
	handlers.BoostEnded = function(d)
		local b = Boosts.ById[d.id]
		Toasts.Show((b and b.name or "A boost") .. " ended.", "info")
	end
	handlers.Reward = function(d)
		Sound.Play("claim")
		local text = Common.RewardText(d.granted)
		if text ~= "-" then
			Toasts.Show("You got " .. text .. "!", "gold")
		end
	end
	handlers.Fox = function(d)
		Sound.Play("coin")
		Toasts.Banner("LUCKY FOX!", "+" .. Num.Cash(d.cash or 0), Theme.Color.Orange, "cash")
	end
	handlers.HousingFull = function()
		Toasts.Show("Housing is full! Upgrade your houses.", "warn")
	end
	handlers.BasketFull = function()
		Toasts.Show("Your basket is full! Deposit at the warehouse.", "warn")
	end
	handlers.StorageFull = function()
		Toasts.Show("A house is full of eggs! Collect them.", "warn")
	end
	handlers.Toast = function(d)
		if type(d.text) == "string" then
			Toasts.Show(d.text, d.kind)
		end
	end

	store.OnEvent("*", function(name: string, data: any)
		local fn = handlers[name]
		if fn then
			fn(if type(data) == "table" then data else {})
		end
	end)
end

return Events
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- The always-on HUD.
--   Top centre : Chickens (population / capacity), Cash, Gold Eggs counters (roll + green flash).
--                Below them: basket (carried / carryCap, orange near full, red when full) and a
--                production readout.
--   Left       : Shop, Eggs, Quests.      Right: Settings, Daily, Boosts, Gifts (ready badge).
--   Bottom     : Cash Multiplier (combo / comboMax) above a big red SPAWN button; Auto Spawn
--                toggle beside it; quick "Upgrades" and "Farm" buttons bottom-left.
-- SPAWN: tap = one request; hold repeats ~8/s; keyboard F / gamepad R2 (Controllers/Input).
-- Spawn is disabled while a menu or modal is open (Host blocking). Elements appear as the
-- tutorial reveals them (Logic/Tutorial.Reveals).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tutorial = require(Shared:WaitForChild("Logic"):WaitForChild("Tutorial"))
local Contract = require(Shared:WaitForChild("Contract"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Layout = require(UI.Layout)
local Icon = require(UI.Icon)
local Button = require(UI.Button)
local ProgressBar = require(UI.ProgressBar)
local Num = require(UI.Num)
local Toasts = require(script.Parent.Toasts)
local Sound = require(script.Parent.Sound)
local Common = require(script.Parent.Parent.Menus.Common)

local Hud = {}

Hud.Targets = {} :: { [string]: GuiObject } -- named elements the tutorial can point at
Hud.Root = nil :: Frame?

local REPEAT_RATE = 8 -- spawns per second while held

local store: any
local host: any
local blocked = false
local holding = false
local holdToken = 0
local housingFull = false
local spawnBtn: Button.Handle
local spawnSub: TextLabel
local autoBtn: Button.Handle
local reveal: { [string]: boolean } = Tutorial.Reveals(1, false)

------------------------------------------------------------------------------------------------
-- Counters
------------------------------------------------------------------------------------------------

type Counter = { set: (number, number?) -> (), frame: Frame }

local function counter(parent: Instance, order: number, icon: string, color: Color3, fmt: (number, number?) -> string): Counter
	local f = Instance.new("Frame")
	f.Name = "Counter_" .. icon
	f.LayoutOrder = order
	f.Size = UDim2.fromOffset(146, 52)
	f.BackgroundColor3 = Color3.fromRGB(40, 32, 28)
	f.BackgroundTransparency = 0.15
	Util.Corner(f, nil, 0.5)
	Util.Stroke(f, 3, Theme.Color.Ink, true)
	local ic = Icon.new(icon, 46)
	ic.AnchorPoint = Vector2.new(0, 0.5)
	ic.Position = UDim2.new(0, -6, 0.5, 0)
	ic.ZIndex = 2
	ic.Parent = f
	local label = Util.Text({
		text = "0",
		size = UDim2.new(1, -50, 1, -6),
		position = UDim2.fromOffset(42, 3),
		textSize = Theme.Text.L,
		font = Theme.Font.Number,
		color = color,
		outline = true,
		z = 2,
		parent = f,
	})
	f.Parent = parent

	local nv = Instance.new("NumberValue")
	local extra: number? = nil
	local shown = 0
	nv.Changed:Connect(function(v)
		label.Text = fmt(v, extra)
	end)
	local function set(v: number, ex: number?)
		local changedExtra = ex ~= extra
		extra = ex
		if v == shown then
			if changedExtra then
				label.Text = fmt(v, extra)
			end
			return
		end
		local gained = v > shown
		local first = shown == 0 and nv.Value == 0
		shown = v
		if first or v ~= v then
			nv.Value = v
			label.Text = fmt(v, extra)
			return
		end
		Util.Tween(nv, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = v })
		if gained then
			label.TextColor3 = Theme.Color.Good
			Util.Tween(label, TweenInfo.new(0.6), { TextColor3 = color })
			Util.Pop(f, 0.08)
		end
	end
	return { set = set, frame = f }
end

------------------------------------------------------------------------------------------------
-- Nav buttons
------------------------------------------------------------------------------------------------

type Nav = { button: Button.Handle, badge: TextLabel }

local function navButton(parent: Instance, order: number, label: string, icon: string, color: Color3, onClick: () -> ()): Nav
	local size = Theme.Size.Nav
	local b = Button.new({
		name = label,
		icon = icon,
		iconSize = 38,
		color = color,
		size = UDim2.fromOffset(size, size),
		order = order,
		parent = parent,
		onClick = onClick,
	})
	if b.Icon then
		b.Icon.Position = UDim2.new(0.5, -19, 0, 3)
		b.Icon.AnchorPoint = Vector2.zero
	end
	local cap = Util.Text({
		text = label,
		size = UDim2.new(1, 4, 0, 22),
		position = UDim2.new(0, -2, 1, -26),
		textSize = Theme.Text.S,
		font = Theme.Font.Title,
		outline = true,
		z = 3,
		parent = b.Instance,
	})
	cap.Name = "Caption"
	local badge = Util.Text({
		text = "!",
		size = UDim2.fromOffset(28, 28),
		position = UDim2.new(1, 4, 0, -4),
		anchor = Vector2.new(1, 0),
		textSize = Theme.Text.S,
		font = Theme.Font.Number,
		outline = true,
		z = 4,
		parent = b.Instance,
	})
	badge.BackgroundTransparency = 0
	badge.BackgroundColor3 = Theme.Color.Red
	Util.Corner(badge, nil, 0.5)
	Util.Stroke(badge, 2, Theme.Color.Ink, true)
	badge.Visible = false
	return { button = b, badge = badge }
end

local function setBadge(n: Nav, text: string?)
	local was = n.badge.Visible
	n.badge.Visible = text ~= nil
	n.badge.Text = text or ""
	if text and not was then
		Util.Pop(n.badge, 0.4)
	end
end

------------------------------------------------------------------------------------------------
-- Spawn
------------------------------------------------------------------------------------------------

local function canSpawn(): boolean
	return not blocked and store.Get() ~= nil
end

local function spawnOnce()
	if not canSpawn() then
		return
	end
	local snap = store.Get()
	if housingFull then
		Util.Shake(spawnBtn.Instance)
		Toasts.Show(Contract.Messages.full, "warn")
		return
	end
	if store.IsBusy(store.Key({ type = "spawn" })) then
		return -- one in flight; the next tap/repeat goes after it lands
	end
	task.spawn(function()
		local res = store.Request({ type = "spawn" })
		if res.ok then
			local cur = store.Get() or snap
			if cur.settings.effects ~= false then
				Toasts.Popup("+" .. Num.Short(cur.spawnPerTap), Theme.Color.Gold, UDim2.new(0.5, 0, 1, -170), "chick")
			end
		elseif res.code == "full" then
			housingFull = true
			Hud._paintSpawn()
			Toasts.Show(res.message or Contract.Messages.full, "warn")
		elseif res.code ~= "busy" and res.code ~= "rate_limited" and res.code ~= "stale" then
			Toasts.Show(res.message or "Couldn't spawn.", "bad")
		end
	end)
end

function Hud.SpawnPress()
	if holding then
		return
	end
	holding = true
	holdToken += 1
	local token = holdToken
	spawnOnce()
	task.spawn(function()
		task.wait(0.35) -- a tap is a single spawn; holding starts repeating
		while holding and token == holdToken do
			spawnOnce()
			task.wait(1 / REPEAT_RATE)
		end
	end)
end

function Hud.SpawnRelease()
	holding = false
end

function Hud._paintSpawn()
	if not spawnBtn then
		return
	end
	if blocked then
		spawnBtn:SetColor(Theme.Color.Gray)
		spawnBtn:SetText("SPAWN")
		spawnSub.Text = ""
	elseif housingFull then
		spawnBtn:SetColor(Theme.Color.GrayDark)
		spawnBtn:SetText("HOUSING FULL")
		spawnSub.Text = "Upgrade your houses"
	else
		spawnBtn:SetColor(Theme.Color.Red)
		spawnBtn:SetText("SPAWN")
		spawnSub.Text = ""
	end
	spawnBtn:SetEnabled(not blocked and not housingFull)
end

------------------------------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------------------------------

function Hud.Start(s: any, h: any)
	store = s
	host = h
	local _, root = Layout.Layer("EggFarmHud", 5)
	Hud.Root = root

	-- top counters
	local top = Instance.new("Frame")
	top.Name = "Counters"
	top.BackgroundTransparency = 1
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 6)
	top.Size = UDim2.fromOffset(470, 56)
	top.Parent = root
	Util.List(top, 10, true, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local chickens = counter(top, 1, "chick", Color3.fromRGB(255, 240, 160), function(v, cap)
		return Num.Short(math.floor(v + 0.5)) .. "/" .. Num.Short(cap or 0)
	end)
	local cash = counter(top, 2, "cash", Theme.Color.Cash, function(v)
		return Num.Cash(math.floor(v))
	end)
	local gold = counter(top, 3, "gold", Theme.Color.Gold, function(v)
		return Num.Short(math.floor(v + 0.5))
	end)
	Hud.Targets.counters = top
	Hud.Targets.cash = cash.frame

	-- basket + production row
	local info = Instance.new("Frame")
	info.Name = "Info"
	info.BackgroundTransparency = 1
	info.AnchorPoint = Vector2.new(0.5, 0)
	info.Position = UDim2.new(0.5, 0, 0, 64)
	info.Size = UDim2.fromOffset(470, 40)
	info.Parent = root
	Util.List(info, 8, true, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local basket = Instance.new("Frame")
	basket.Name = "Basket"
	basket.Size = UDim2.fromOffset(150, 38)
	basket.BackgroundColor3 = Color3.fromRGB(40, 32, 28)
	basket.BackgroundTransparency = 0.2
	basket.LayoutOrder = 1
	Util.Corner(basket, nil, 0.5)
	local basketStroke = Util.Stroke(basket, 3, Theme.Color.Ink, true)
	local bic = Icon.new("basket", 34)
	bic.Position = UDim2.fromOffset(4, 2)
	bic.Parent = basket
	local basketText = Util.Text({
		text = "0/0",
		size = UDim2.new(1, -44, 1, -4),
		position = UDim2.fromOffset(40, 2),
		textSize = Theme.Text.M,
		font = Theme.Font.Number,
		outline = true,
		parent = basket,
	})
	basket.Parent = info
	local prod = Instance.new("Frame")
	prod.Name = "Production"
	prod.Size = UDim2.fromOffset(300, 38)
	prod.BackgroundColor3 = Color3.fromRGB(40, 32, 28)
	prod.BackgroundTransparency = 0.35
	prod.LayoutOrder = 2
	Util.Corner(prod, nil, 0.5)
	local prodText = Util.Text({
		text = "",
		size = UDim2.new(1, -16, 1, -4),
		position = UDim2.fromOffset(8, 2),
		textSize = Theme.Text.S,
		font = Theme.Font.Title,
		outline = true,
		parent = prod,
	})
	prod.Parent = info
	Hud.Targets.basket = basket

	-- side navigation
	local function column(name: string, x: number, anchorX: number): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.BackgroundTransparency = 1
		f.AnchorPoint = Vector2.new(anchorX, 0.5)
		f.Position = UDim2.new(x, if anchorX == 0 then 8 else -8, 0.44, 0)
		f.Size = UDim2.fromOffset(Theme.Size.Nav + 8, 4 * (Theme.Size.Nav + 10))
		Util.List(f, 10, false, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		f.Parent = root
		return f
	end
	local left = column("LeftNav", 0, 0)
	local right = column("RightNav", 1, 1)
	local shopNav = navButton(left, 1, "Shop", "shop", Theme.Color.Pink, function()
		host:Toggle("Shop")
	end)
	local eggsNav = navButton(left, 2, "Eggs", "egg", Theme.Color.Gold, function()
		host:Toggle("Eggs")
	end)
	local questNav = navButton(left, 3, "Quests", "quest", Theme.Color.Teal, function()
		host:Toggle("Quests")
	end)
	local settingsNav = navButton(right, 1, "Settings", "settings", Theme.Color.GrayDark, function()
		host:Toggle("Settings")
	end)
	local dailyNav = navButton(right, 2, "Daily", "daily", Theme.Color.Red, function()
		host:Toggle("Daily")
	end)
	local boostNav = navButton(right, 3, "Boosts", "booster", Theme.Color.Purple, function()
		host:Toggle("Boosts")
	end)
	local giftNav = navButton(right, 4, "Gifts", "gift", Theme.Color.Orange, function()
		host:Toggle("Gifts")
	end)
	Hud.Targets.shop = shopNav.button.Instance
	Hud.Targets.eggs = eggsNav.button.Instance
	Hud.Targets.gifts = giftNav.button.Instance

	-- quick access (bottom-left)
	local quick = Instance.new("Frame")
	quick.Name = "Quick"
	quick.BackgroundTransparency = 1
	quick.AnchorPoint = Vector2.new(0, 1)
	quick.Position = UDim2.new(0, 8, 1, -10)
	quick.Size = UDim2.fromOffset(Theme.Size.Nav + 8, 2 * Theme.Size.Nav + 10)
	Util.List(quick, 10, false, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
	quick.Parent = root
	local upgradesNav = navButton(quick, 1, "Upgrades", "upgrades", Theme.Color.Green, function()
		host:Toggle("Upgrades")
	end)
	local farmNav = navButton(quick, 2, "Farm", "farm", Theme.Color.Orange, function()
		local snap = store.Get()
		local rev = if snap then Tutorial.Reveals(snap.tutorial.step, snap.tutorial.done) else reveal
		host:Toggle("Farm", if not rev.housing and rev.shipping then "Shipping" else nil)
	end)
	Hud.Targets.upgrades = upgradesNav.button.Instance
	Hud.Targets.farm = farmNav.button.Instance

	-- bottom centre: multiplier + spawn + auto
	local bottom = Instance.new("Frame")
	bottom.Name = "SpawnArea"
	bottom.BackgroundTransparency = 1
	bottom.AnchorPoint = Vector2.new(0.5, 1)
	bottom.Position = UDim2.new(0.5, 0, 1, -10)
	bottom.Size = UDim2.fromOffset(220, 136)
	bottom.Parent = root

	local comboRow = Instance.new("Frame")
	comboRow.BackgroundTransparency = 1
	comboRow.Size = UDim2.new(1, 0, 0, 40)
	comboRow.Parent = bottom
	local comboIcon = Icon.new("combo", 36)
	comboIcon.Position = UDim2.fromOffset(0, 2)
	comboIcon.ZIndex = 3
	comboIcon.Parent = comboRow
	local combo = ProgressBar.new({
		size = UDim2.new(1, -30, 0, 32),
		position = UDim2.fromOffset(26, 4),
		color = Theme.Color.Orange,
		textSize = Theme.Text.M,
		parent = comboRow,
	})
	Hud.Targets.combo = comboRow

	spawnBtn = Button.new({
		name = "Spawn",
		text = "SPAWN",
		color = Theme.Color.Red,
		size = UDim2.new(1, 0, 0, 86),
		position = UDim2.fromOffset(0, 48),
		textSize = Theme.Text.Huge,
		radius = 22,
		parent = bottom,
	})
	spawnSub = Util.Text({
		text = "",
		size = UDim2.new(1, -16, 0, 22),
		position = UDim2.new(0, 8, 1, -28),
		textSize = Theme.Text.S,
		font = Theme.Font.Title,
		outline = true,
		z = 4,
		parent = spawnBtn.Instance,
	})
	spawnBtn.Label.Size = UDim2.new(1, -16, 1, -24)
	spawnBtn.Instance.MouseButton1Down:Connect(function()
		Hud.SpawnPress()
	end)
	spawnBtn.Instance.MouseButton1Up:Connect(Hud.SpawnRelease)
	spawnBtn.Instance.MouseLeave:Connect(Hud.SpawnRelease)
	spawnBtn.Instance.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Hud.SpawnRelease()
		end
	end)
	spawnBtn.Instance.Activated:Connect(function()
		if housingFull and not blocked then
			local snap = store.Get()
			if snap then
				local rev = Tutorial.Reveals(snap.tutorial.step, snap.tutorial.done)
				if rev.housing then
					host:Open("Farm", "Housing")
				end
			end
		end
	end)
	Hud.Targets.spawn = spawnBtn.Instance

	autoBtn = Button.new({
		name = "Auto",
		text = "AUTO",
		icon = "auto",
		iconSize = 28,
		color = Theme.Color.Gray,
		size = UDim2.fromOffset(112, 60),
		anchor = Vector2.new(0, 1),
		position = UDim2.new(1, 10, 1, 0),
		textSize = Theme.Text.M,
		parent = bottom,
		onClick = function()
			local snap = store.Get()
			if not snap then
				return
			end
			if not snap.tutorial.done then
				Util.Shake(autoBtn.Instance)
				Sound.Play("error")
				Toasts.Show("Auto Spawn unlocks when you finish the tutorial!", "info")
				return
			end
			local want = not snap.settings.autoSpawn
			local res = store.Request({ type = "setAutoSpawn", value = want })
			if not res.ok and res.code ~= "busy" then
				Util.Shake(autoBtn.Instance)
				Sound.Play("error")
				Toasts.Show(res.message or "Couldn't change Auto Spawn.", "bad")
			end
		end,
	})
	Hud.Targets.auto = autoBtn.Instance

	-- blocking: menus open -> no spawning, no world clicks
	host:OnBlockingChanged(function(on: boolean)
		blocked = on
		if on then
			holding = false
		end
		Hud._paintSpawn()
	end)

	-- portrait phones: keep the auto toggle above the spawn button if there's no room beside it
	local function relayout(_, logical: Vector2)
		-- short landscape phones: there's no vertical room for the quick column under the left
		-- column, so it moves beside it (the left nav is vertically centred)
		if logical.Y < 520 and logical.X > logical.Y then
			quick.Position = UDim2.new(0, Theme.Size.Nav + 26, 1, -10)
		else
			quick.Position = UDim2.new(0, 8, 1, -10)
		end
		if logical.X < 500 then
			autoBtn.Instance.AnchorPoint = Vector2.new(1, 1)
			autoBtn.Instance.Position = UDim2.new(1, 0, 0, -6)
			autoBtn.Instance.Size = UDim2.fromOffset(100, 60)
		else
			autoBtn.Instance.AnchorPoint = Vector2.new(0, 1)
			autoBtn.Instance.Position = UDim2.new(1, 10, 1, 0)
			autoBtn.Instance.Size = UDim2.fromOffset(112, 60)
		end
	end
	Layout.OnChanged(relayout)
	relayout(Layout.Scale(), Layout.Logical())

	-- apply reveals
	local function applyReveal(r: { [string]: boolean })
		reveal = r
		top.Visible = r.counters
		info.Visible = r.counters
		left.Visible = r.nav
		right.Visible = r.nav
		eggsNav.button:SetVisible(r.eggs)
		upgradesNav.button:SetVisible(r.nav)
		farmNav.button:SetVisible(r.shipping or r.housing)
		quick.Visible = r.shipping or r.housing or r.nav
		comboRow.Visible = r.counters
		autoBtn:SetVisible(r.nav)
		spawnBtn:SetVisible(r.spawn)
	end
	applyReveal(reveal)

	local giftCount = 0
	store.OnChanged(function(snap: any)
		applyReveal(Tutorial.Reveals(snap.tutorial.step, snap.tutorial.done))
		chickens.set(snap.population, snap.capacity)
		cash.set(snap.cash)
		gold.set(snap.gold)

		local cap = math.max(1, snap.carryCap)
		basketText.Text = Num.Short(snap.carried) .. "/" .. Num.Short(snap.carryCap)
		local frac = snap.carried / cap
		if frac >= 1 then
			basket.BackgroundColor3 = Theme.Color.RedDark
			basketStroke.Color = Theme.Color.Bad
		elseif frac >= 0.75 then
			basket.BackgroundColor3 = Theme.Color.Orange
			basketStroke.Color = Theme.Color.Ink
		else
			basket.BackgroundColor3 = Color3.fromRGB(40, 32, 28)
			basketStroke.Color = Theme.Color.Ink
		end
		prodText.Text = string.format("Laying %s  •  Shipping %s  •  %s", Num.Rate(snap.rates.lay), Num.Rate(snap.rates.ship), "$" .. Num.Rate(snap.rates.cash))

		local m = math.max(snap.comboMax, 1)
		combo:Set((snap.combo - 1) / math.max(m - 1, 0.001), "Cash " .. string.format("x%.1f", snap.combo))

		local full = snap.population >= snap.capacity
		if full ~= housingFull then
			housingFull = full
			Hud._paintSpawn()
		end

		local auto = snap.settings.autoSpawn
		autoBtn:SetColor(if auto then Theme.Color.Green else Theme.Color.Gray)
		autoBtn:SetText(if auto then "AUTO ON" else "AUTO")
		autoBtn.Label.TextTransparency = if snap.tutorial.done then 0 else 0.4

		-- badges
		local claimable = 0
		for _, q in snap.quests.list do
			if not q.claimed and q.progress >= q.target then
				claimable += 1
			end
		end
		setBadge(questNav, if claimable > 0 then tostring(claimable) else nil)
		setBadge(dailyNav, if snap.daily.canClaim then "!" else nil)
		local boosts = 0
		for _, n in snap.boosts.inventory do
			boosts += n
		end
		setBadge(boostNav, if boosts > 0 then (if boosts > 99 then "99+" else tostring(boosts)) else nil)
		setBadge(eggsNav, if snap.canRebirth or snap.canPrestige then "!" else nil)
		setBadge(settingsNav, nil)
		setBadge(shopNav, nil)
	end)

	-- 4 Hz: gift readiness (playtime advances between snapshots)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local snap = store.Get()
		if not snap then
			return
		end
		local n = Common.GiftsReady(snap, store.Now())
		if n ~= giftCount then
			giftCount = n
			setBadge(giftNav, if n > 0 then tostring(n) else nil)
		end
	end)

	Hud._paintSpawn()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!strict
-- Keyboard / gamepad bindings.
--   F (keyboard) or R2 (gamepad): SPAWN. Tap = one spawn, hold = repeat (~8/s).
--     (Space is jump and E is the default ProximityPrompt key, so F is used.)
--   B (gamepad) or Backspace: close the open menu / modal (Back).
-- Touch and mouse go through the on-screen buttons.

local ContextActionService = game:GetService("ContextActionService")

local Input = {}

Input.SpawnKeys = { Enum.KeyCode.F, Enum.KeyCode.ButtonR2 }
Input.BackKeys = { Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace }

function Input.Start(host: any, hud: any)
	ContextActionService:BindAction("EggFarmSpawn", function(_, state: Enum.UserInputState)
		if host:IsBlocking() then
			hud.SpawnRelease()
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			hud.SpawnPress()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			hud.SpawnRelease()
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(Input.SpawnKeys))

	ContextActionService:BindAction("EggFarmBack", function(_, state: Enum.UserInputState)
		if not host:IsBlocking() then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			host.Router:Back()
		end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(Input.BackKeys))
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Offline</string>
              <string name="Source"><![CDATA[--!strict
-- "Welcome back" modal: when snapshot.offline.pending > 0 the silos earned cash while the player
-- was away. One button claims it (claimOffline). If the claim fails the modal comes back on a
-- later snapshot (after a short cooldown) so the cash is never lost to a dropped request.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameInfo = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameInfo"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Num = require(UI.Num)

local Offline = {}

function Offline.Start(store: any, host: any)
	local showing = false
	local nextTry = 0

	-- Back/Escape can close the modal without the button; forget "showing" when it's gone
	host.Router:Subscribe(function()
		if showing and host.Router:Modal() ~= "offline" then
			showing = false
		end
	end)

	store.OnChanged(function(snap: any)
		if showing or snap.offline.pending <= 0 or os.clock() < nextTry then
			return
		end
		local pending = snap.offline.pending
		local opened = host:Notice("offline", {
			title = "Welcome back!",
			icon = "silo",
			color = Theme.Color.GreenDark,
			text = string.format(
				"Your silos kept %s busy for %s while you were away.\n\nYou earned %s!",
				GameInfo.Name,
				Num.Duration(snap.offline.seconds),
				Num.Cash(pending)
			),
			confirmText = "Collect " .. Num.Cash(pending),
			confirmColor = Theme.Color.Green,
		}, function()
			task.spawn(function()
				local res = store.Request({ type = "claimOffline" })
				showing = false
				if res.ok then
					host:Sound("coin")
				else
					nextTry = os.clock() + 5
					if res.code ~= "not_ready" and res.code ~= "busy" then
						host:Toast(res.message or "Couldn't collect. We'll try again.", "bad")
					end
				end
			end)
		end)
		showing = opened
		if not opened then
			nextTry = os.clock() + 2 -- another modal is up; ask again shortly
		end
	end)
end

return Offline
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!strict
-- World boards: ProximityPrompts with attribute Menu ("Housing" | "Shipping" | "Workers" |
-- "Silos" | "Upgrades" | "Eggs") and optional Slot open the matching menu. Only prompts inside
-- the local player's own plot (ancestor Model with attribute OwnerUserId == LocalPlayer.UserId)
-- react; prompts on other plots are disabled locally. While a menu is open the whole
-- ProximityPromptService is disabled locally so nothing in the world can be triggered.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Prompts = {}

local FARM_TABS = { Housing = true, Shipping = true, Workers = true, Silos = true }

local me = Players.LocalPlayer

-- The plot Model (Workspace.Plots.Plot<N>) that contains `inst`, if any.
function Prompts.PlotOf(inst: Instance): Model?
	local cur: Instance? = inst.Parent
	while cur and cur ~= Workspace do
		if cur:IsA("Model") and cur:GetAttribute("OwnerUserId") ~= nil then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

function Prompts.IsMine(inst: Instance): boolean
	local plot = Prompts.PlotOf(inst)
	return plot ~= nil and plot:GetAttribute("OwnerUserId") == me.UserId
end

-- The local player's plot, or nil.
function Prompts.OwnPlot(): Model?
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, p in plots:GetChildren() do
		if p:IsA("Model") and p:GetAttribute("OwnerUserId") == me.UserId then
			return p
		end
	end
	return nil
end

function Prompts.Start(host: any)
	local watched: { [ProximityPrompt]: boolean } = setmetatable({}, { __mode = "k" }) :: any

	local function apply(prompt: ProximityPrompt)
		if prompt:GetAttribute("Fox") then
			-- the Lucky Fox model carries its owner's UserId; only the owner can catch it
			local fox = prompt:FindFirstAncestorOfClass("Model")
			prompt.Enabled = fox ~= nil and fox:GetAttribute("OwnerUserId") == me.UserId
			return
		end
		if prompt:GetAttribute("Menu") == nil then
			return
		end
		prompt.Enabled = Prompts.IsMine(prompt)
	end

	local function watch(prompt: ProximityPrompt)
		if watched[prompt] then
			return
		end
		watched[prompt] = true
		apply(prompt)
		prompt:GetAttributeChangedSignal("Menu"):Connect(function()
			apply(prompt)
		end)
	end

	local function scanPlot(plot: Instance)
		for _, d in plot:GetDescendants() do
			if d:IsA("ProximityPrompt") then
				watch(d)
			end
		end
	end

	-- fox models are parented to plots after their prompt exists; re-check once they land
	Workspace.DescendantAdded:Connect(function(d: Instance)
		if d:IsA("ProximityPrompt") and d:GetAttribute("Fox") then
			local prompt = d :: ProximityPrompt
			task.defer(function()
				apply(prompt)
			end)
		end
	end)

	local function hookPlots(plots: Instance)
		plots.DescendantAdded:Connect(function(d)
			if d:IsA("ProximityPrompt") then
				task.defer(watch, d)
			end
		end)
		local function hookPlot(plot: Instance)
			scanPlot(plot)
			plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
				for _, d in plot:GetDescendants() do
					if d:IsA("ProximityPrompt") then
						apply(d)
					end
				end
			end)
		end
		for _, p in plots:GetChildren() do
			hookPlot(p)
		end
		plots.ChildAdded:Connect(hookPlot)
	end

	task.spawn(function()
		local plots = Workspace:WaitForChild("Plots", 60)
		if plots then
			hookPlots(plots)
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if player ~= me then
			return
		end
		local menu = prompt:GetAttribute("Menu")
		if type(menu) ~= "string" or not Prompts.IsMine(prompt) then
			return
		end
		-- boards for things the tutorial hasn't revealed yet stay quiet
		local rev = host:Reveals()
		local gate = ({ Housing = rev.housing, Shipping = rev.shipping, Workers = rev.workers, Silos = rev.nav, Upgrades = rev.nav, Eggs = rev.eggs })[menu]
		if gate == false then
			host:Toast("Finish the tutorial to unlock this!", "info")
			return
		end
		local slot = prompt:GetAttribute("Slot")
		local opts = if type(slot) == "number" then { slot = slot } else nil
		if FARM_TABS[menu] then
			host:Open("Farm", menu, opts)
		elseif menu == "Upgrades" then
			host:Open("Upgrades", nil, opts)
		elseif menu == "Eggs" then
			host:Open("Eggs", nil, opts)
		end
	end)

	host:OnBlockingChanged(function(blocking: boolean)
		ProximityPromptService.Enabled = not blocking
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- Named sound cues. No licensed audio has been chosen yet, so every id is nil and nothing plays.
-- To add audio: put an asset id you own / have licensed in `Ids` (e.g. click = "rbxassetid://123").
-- Honours the server-confirmed settings: sfx (cues) and music (looping background track).

local SoundService = game:GetService("SoundService")

local Sound = {}

Sound.Ids = {
	click = nil :: string?,
	buy = nil :: string?,
	coin = nil :: string?,
	collect = nil :: string?,
	deposit = nil :: string?,
	error = nil :: string?,
	rebirth = nil :: string?,
	claim = nil :: string?,
	music = nil :: string?,
}

Sound.Volume = {
	click = 0.4,
	buy = 0.6,
	coin = 0.5,
	collect = 0.5,
	deposit = 0.5,
	error = 0.5,
	rebirth = 0.8,
	claim = 0.7,
	music = 0.25,
}

local sfxOn = true
local musicOn = true
local cache: { [string]: Sound } = {}
local musicSound: Sound? = nil
local lastPlayed: { [string]: number } = {}

local function get(name: string): Sound?
	local id = (Sound.Ids :: any)[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local s = cache[name]
	if not s then
		local made = Instance.new("Sound")
		made.Name = "Cue_" .. name
		made.SoundId = id
		made.Volume = (Sound.Volume :: any)[name] or 0.5
		made.Parent = SoundService
		cache[name] = made
		s = made
	end
	return s
end

function Sound.Play(name: string)
	if not sfxOn or name == "music" then
		return
	end
	-- light throttle so fast repeats (hold-to-spawn) don't stack dozens of copies
	local now = os.clock()
	if (lastPlayed[name] or 0) + 0.05 > now then
		return
	end
	lastPlayed[name] = now
	local s = get(name)
	if s then
		SoundService:PlayLocalSound(s)
	end
end

local function updateMusic()
	local s = get("music")
	if not s then
		return
	end
	musicSound = s
	s.Looped = true
	if musicOn and not s.IsPlaying then
		s:Play()
	elseif not musicOn and s.IsPlaying then
		s:Stop()
	end
end

function Sound.Apply(settings: any)
	if type(settings) ~= "table" then
		return
	end
	sfxOn = settings.sfx ~= false
	musicOn = settings.music ~= false
	updateMusic()
end

function Sound.IsMusicPlaying(): boolean
	return musicSound ~= nil and (musicSound :: Sound).IsPlaying
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Toasts (short messages, top centre, up to 3 stacked), the big celebration banner (Rebirth /
-- Prestige) and floating popups ("+5", "+$1.2K") that rise and fade.

local Theme = require(script.Parent.Parent.UI.Theme)
local Util = require(script.Parent.Parent.UI.Util)
local Layout = require(script.Parent.Parent.UI.Layout)
local Icon = require(script.Parent.Parent.UI.Icon)

local Toasts = {}

local MAX = 3
local holder: Frame
local bannerHolder: Frame
local popRoot: Frame
local recent: { [string]: number } = {}

local KIND_COLOR: { [string]: Color3 } = {
	info = Theme.Color.Blue,
	good = Theme.Color.Green,
	bad = Theme.Color.Red,
	gold = Theme.Color.GoldDark,
	cash = Theme.Color.GreenDark,
	warn = Theme.Color.Orange,
}

function Toasts.Start()
	local _, root = Layout.Layer("EggFarmToasts", 30)
	holder = Instance.new("Frame")
	holder.Name = "Toasts"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, 150)
	holder.Size = UDim2.new(1, -40, 0, 220)
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(520, 220)
	lim.Parent = holder
	Util.List(holder, 6)
	holder.Parent = root

	bannerHolder = Instance.new("Frame")
	bannerHolder.Name = "Banner"
	bannerHolder.BackgroundTransparency = 1
	bannerHolder.Size = UDim2.fromScale(1, 1)
	bannerHolder.Parent = root

	popRoot = Instance.new("Frame")
	popRoot.Name = "Popups"
	popRoot.BackgroundTransparency = 1
	popRoot.Size = UDim2.fromScale(1, 1)
	popRoot.Parent = root
end

-- kind: "info" | "good" | "bad" | "gold" | "cash" | "warn"
function Toasts.Show(text: string, kind: string?)
	if not holder or text == "" then
		return
	end
	-- the same message twice within a second is shown once
	local now = os.clock()
	if (recent[text] or 0) + 1 > now then
		return
	end
	recent[text] = now
	local items = {}
	for _, c in holder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items >= MAX then
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		items[1]:Destroy()
	end
	local f = Instance.new("Frame")
	f.Name = "Toast"
	f.BackgroundColor3 = KIND_COLOR[kind or "info"] or Theme.Color.Blue
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.LayoutOrder = math.floor(now * 1000) % 1e9
	Util.Corner(f, 14)
	Util.Stroke(f, 3, Theme.Color.Ink, true)
	Util.Gradient(f)
	Util.Pad(f, 10, 8, 8)
	local t = Util.Text({
		text = text,
		size = UDim2.new(1, 0, 0, 0),
		textSize = Theme.Text.M,
		font = Theme.Font.Title,
		wrap = true,
		outline = true,
		parent = f,
	})
	t.ZIndex = 2
	local sc = Instance.new("UIScale")
	sc.Scale = 0.7
	sc.Parent = f
	f.Parent = holder
	Util.Tween(sc, Theme.Tween.Pop, { Scale = 1 })
	task.delay(2.6, function()
		if f.Parent then
			Util.Tween(sc, Theme.Tween.Med, { Scale = 0.6 })
			Util.Tween(f, Theme.Tween.Med, { BackgroundTransparency = 1 })
			Util.Tween(t, Theme.Tween.Med, { TextTransparency = 1, TextStrokeTransparency = 1 })
			task.wait(0.26)
			f:Destroy()
		end
	end)
end

-- Big centred celebration (Rebirth / Prestige / big rewards).
function Toasts.Banner(title: string, subtitle: string?, color: Color3?, icon: string?)
	if not bannerHolder then
		return
	end
	Util.Clear(bannerHolder)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.36)
	f.Size = UDim2.new(1, -40, 0, 150)
	f.BackgroundColor3 = color or Theme.Color.Purple
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(620, 150)
	lim.Parent = f
	Util.Corner(f, 26)
	Util.Stroke(f, 5, Theme.Color.Ink, true)
	local g = Util.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180))
	local ic = Icon.new(icon or "star", 84)
	ic.AnchorPoint = Vector2.new(0, 0.5)
	ic.Position = UDim2.new(0, 16, 0.5, 0)
	ic.ZIndex = 2
	ic.Parent = f
	Util.Text({
		text = title,
		size = UDim2.new(1, -124, 0, 70),
		position = UDim2.fromOffset(110, 12),
		textSize = Theme.Text.Huge,
		font = Theme.Font.Title,
		outline = true,
		z = 2,
		parent = f,
	})
	if subtitle then
		Util.Text({
			text = subtitle,
			size = UDim2.new(1, -124, 0, 50),
			position = UDim2.fromOffset(110, 84),
			textSize = Theme.Text.L,
			font = Theme.Font.Title,
			outline = true,
			z = 2,
			parent = f,
		})
	end
	local sc = Instance.new("UIScale")
	sc.Scale = 0.3
	sc.Parent = f
	f.Parent = bannerHolder
	Util.Tween(sc, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	task.spawn(function()
		for _ = 1, 30 do
			if not f.Parent then
				return
			end
			g.Rotation = (g.Rotation + 12) % 360
			task.wait(0.1)
		end
		Util.Tween(sc, Theme.Tween.Med, { Scale = 0 })
		task.wait(0.3)
		f:Destroy()
	end)
end

-- Floating text that rises from a point (logical px within the toast layer) and fades out.
function Toasts.Popup(text: string, color: Color3?, at: UDim2?, icon: string?)
	if not popRoot then
		return
	end
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(200, 44)
	local start = at or UDim2.fromScale(0.5, 0.7)
	f.Position = start + UDim2.fromOffset(math.random(-30, 30), 0)
	if icon then
		local ic = Icon.new(icon, 34)
		ic.AnchorPoint = Vector2.new(1, 0.5)
		ic.Position = UDim2.new(0.5, -40, 0.5, 0)
		ic.Parent = f
	end
	local t = Util.Text({
		text = text,
		textSize = Theme.Text.XL,
		font = Theme.Font.Title,
		color = color or Theme.Color.Good,
		outline = true,
		parent = f,
	})
	f.Parent = popRoot
	Util.Tween(f, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = f.Position - UDim2.fromOffset(0, 90),
	})
	task.delay(0.6, function()
		Util.Tween(t, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	task.delay(1.15, function()
		f:Destroy()
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- Tutorial overlay: the current step's text (Contract.Tutorial[snapshot.tutorial.step]), a
-- bouncing arrow over the HUD element to use, and a beam + marker in the world from the player
-- to the place to walk to (own plot only). Progressive reveal of the HUD itself is done by
-- Controllers/Hud via Logic/Tutorial.Reveals. Hidden for good once tutorial.done.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Contract = require(Shared:WaitForChild("Contract"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Layout = require(UI.Layout)
local Icon = require(UI.Icon)
local Prompts = require(script.Parent.Prompts)

local Tutorial = {}

-- Where each step points: a HUD target name (Hud.Targets) and/or a world target finder.
type Hint = { ui: string?, world: ((plot: Model) -> BasePart?)? }

local function find(plot: Model, path: { string }): BasePart?
	local cur: Instance? = plot
	for _, name in path do
		cur = cur and cur:FindFirstChild(name)
	end
	return if cur and cur:IsA("BasePart") then cur else nil
end

local function board(menu: string): (plot: Model) -> BasePart?
	return function(plot)
		local boards = plot:FindFirstChild("Boards")
		if not boards then
			return nil
		end
		for _, d in boards:GetDescendants() do
			if d:IsA("ProximityPrompt") and d:GetAttribute("Menu") == menu then
				local p = d.Parent
				if p and p:IsA("BasePart") then
					return p
				elseif p and p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then
					return p.Parent :: BasePart
				end
			end
		end
		return nil
	end
end

local HINTS: { [string]: Hint } = {
	spawn = { ui = "spawn" },
	collect = {
		world = function(plot)
			return find(plot, { "Houses", "House1", "CollectRing" })
		end,
	},
	deposit = {
		world = function(plot)
			return find(plot, { "Warehouse", "DepositRing" })
		end,
	},
	sell = {
		world = function(plot)
			return find(plot, { "Dock", "Bay1" })
		end,
	},
	vehicle = { ui = "farm", world = board("Shipping") },
	earn = { ui = "cash" },
	housing = { ui = "farm", world = board("Housing") },
}

-- True when the object and every GUI ancestor are visible (hidden HUD parts get no arrow).
local function shown(obj: GuiObject): boolean
	local cur: Instance? = obj
	while cur and cur:IsA("GuiObject") do
		if not cur.Visible then
			return false
		end
		cur = cur.Parent
	end
	if cur and cur:IsA("LayerCollector") then
		return cur.Enabled
	end
	return cur ~= nil
end

function Tutorial.Start(store: any, host: any, hud: any)
	local gui, root = Layout.Layer("EggFarmTutorial", 8)

	local banner = Instance.new("Frame")
	banner.Name = "Banner"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.new(0.5, 0, 0, 112)
	banner.Size = UDim2.new(1, -40, 0, 0)
	banner.AutomaticSize = Enum.AutomaticSize.Y
	banner.BackgroundColor3 = Theme.Color.Panel
	Util.Corner(banner, 18)
	Util.Stroke(banner, 4, Theme.Color.Ink, true)
	Util.Gradient(banner, Color3.new(1, 1, 1), Color3.fromRGB(240, 226, 196))
	Util.Pad(banner, 10)
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(520, 400)
	lim.Parent = banner
	local ic = Icon.new("chick", 48)
	ic.Parent = banner
	local textBox = Instance.new("Frame")
	textBox.BackgroundTransparency = 1
	textBox.Position = UDim2.fromOffset(58, 0)
	textBox.Size = UDim2.new(1, -58, 0, 0)
	textBox.AutomaticSize = Enum.AutomaticSize.Y
	textBox.Parent = banner
	Util.List(textBox, 2, false, Enum.HorizontalAlignment.Left)
	local stepLabel = Util.Text({
		text = "",
		size = UDim2.new(1, 0, 0, 24),
		textSize = Theme.Text.S,
		color = Theme.Color.Orange,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		order = 1,
		parent = textBox,
	})
	local text = Util.Text({
		text = "",
		size = UDim2.new(1, 0, 0, 0),
		textSize = Theme.Text.M,
		color = Theme.Color.TextDark,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		wrap = true,
		order = 2,
		parent = textBox,
	})
	banner.Parent = root

	-- arrow pointing down at a HUD element
	local arrow = Instance.new("Frame")
	arrow.Name = "Arrow"
	arrow.BackgroundTransparency = 1
	arrow.AnchorPoint = Vector2.new(0.5, 1)
	arrow.Size = UDim2.fromOffset(44, 54)
	arrow.Visible = false
	local head = Instance.new("Frame")
	head.AnchorPoint = Vector2.new(0.5, 0.5)
	head.Position = UDim2.new(0.5, 0, 1, -16)
	head.Size = UDim2.fromOffset(30, 30)
	head.Rotation = 45
	head.BackgroundColor3 = Theme.Color.Gold
	Util.Corner(head, 4)
	Util.Stroke(head, 3, Theme.Color.Ink)
	head.Parent = arrow
	local stem = Instance.new("Frame")
	stem.AnchorPoint = Vector2.new(0.5, 0)
	stem.Position = UDim2.new(0.5, 0, 0, 0)
	stem.Size = UDim2.fromOffset(16, 34)
	stem.BackgroundColor3 = Theme.Color.Gold
	Util.Corner(stem, 4)
	Util.Stroke(stem, 3, Theme.Color.Ink)
	stem.ZIndex = 2
	stem.Parent = arrow
	arrow.Parent = root

	-- world beam + marker (local only)
	local me = Players.LocalPlayer
	local beam: Beam? = nil
	local a1: Attachment? = nil
	local marker: BillboardGui? = nil
	local worldTarget: BasePart? = nil

	local function clearWorld()
		if beam then
			beam:Destroy()
		end
		if a1 then
			a1:Destroy()
		end
		if marker then
			marker:Destroy()
		end
		beam, a1, marker, worldTarget = nil, nil, nil, nil
	end

	local function setWorld(part: BasePart?)
		if part == worldTarget then
			return
		end
		clearWorld()
		if not part then
			return
		end
		worldTarget = part
		local att = Instance.new("Attachment")
		att.Name = "EggFarmTutorialTarget"
		att.Position = Vector3.new(0, part.Size.Y / 2 + 0.5, 0)
		att.Parent = part
		a1 = att
		local bb = Instance.new("BillboardGui")
		bb.Name = "EggFarmTutorialMarker"
		bb.AlwaysOnTop = true
		bb.Size = UDim2.fromOffset(64, 80)
		bb.StudsOffset = Vector3.new(0, 5, 0)
		bb.Adornee = part
		bb.LightInfluence = 0
		local mark = Util.Text({
			text = "▼",
			textSize = 64,
			color = Theme.Color.Gold,
			font = Theme.Font.Number,
			outline = true,
			parent = bb,
		})
		mark.Name = "Mark"
		bb.Parent = part
		marker = bb
		local b = Instance.new("Beam")
		b.Name = "EggFarmTutorialBeam"
		b.Color = ColorSequence.new(Theme.Color.Gold)
		b.Transparency = NumberSequence.new(0.2, 0.5)
		b.Width0 = 0.8
		b.Width1 = 0.8
		b.FaceCamera = true
		b.LightEmission = 0.6
		b.Segments = 10
		b.Attachment1 = att
		b.Parent = part
		beam = b
	end

	local function rootAttachment(): Attachment?
		local char = me.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return nil
		end
		local att = hrp:FindFirstChild("EggFarmTutorialFrom")
		if not att then
			local made = Instance.new("Attachment")
			made.Name = "EggFarmTutorialFrom"
			made.Parent = hrp
			att = made
		end
		return att :: Attachment
	end

	local currentKey: string? = nil
	local done = false

	local function update(snap: any)
		done = snap.tutorial.done
		if done then
			gui.Enabled = false
			clearWorld()
			currentKey = nil
			return
		end
		local step = snap.tutorial.step
		local entry = Contract.Tutorial[step]
		if not entry then
			gui.Enabled = false
			return
		end
		gui.Enabled = true
		if currentKey ~= entry.key then
			currentKey = entry.key
			Util.Pop(banner, 0.08)
		end
		stepLabel.Text = string.format("TUTORIAL  %d / %d", step, #Contract.Tutorial)
		text.Text = entry.text
	end

	store.OnChanged(function(snap: any)
		update(snap)
	end)

	-- 10 Hz: follow the HUD target, bounce the arrow, keep the beam attached to the character
	local t = 0
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		t += dt
		acc += dt
		if acc < 0.1 or done or not gui.Enabled then
			return
		end
		acc = 0
		local hint = currentKey and HINTS[currentKey]
		-- HUD arrow (hidden while a menu covers the screen)
		local target: GuiObject? = if hint and hint.ui then hud.Targets[hint.ui] else nil
		if target and shown(target) and not host:IsBlocking() then
			local scale = Layout.Scale()
			local rel = (target.AbsolutePosition - root.AbsolutePosition) / scale
			local size = target.AbsoluteSize / scale
			local bounce = math.abs(math.sin(t * 4)) * 10
			arrow.Position = UDim2.fromOffset(rel.X + size.X / 2, rel.Y - 4 - bounce)
			arrow.Visible = true
		else
			arrow.Visible = false
		end
		banner.Visible = not host:IsBlocking()
		-- world beam
		local plot = Prompts.OwnPlot()
		local part = if plot and hint and hint.world then hint.world(plot) else nil
		setWorld(part)
		if beam then
			local from = rootAttachment()
			beam.Attachment0 = from
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="83">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client bootstrap: snapshot store, UI (layers, menus, HUD, tutorial, prompts, input, feedback)
-- and then the world visuals (written separately; started only if present).
-- Each piece starts inside a pcall so one failure can't take the whole client down.

local Store = require(script.Parent.Store)

local UI = script.Parent.UI
local Controllers = script.Parent.Controllers
local Menus = script.Parent.Menus

local Layout = require(UI.Layout)
local Num = require(UI.Num)
local Button = require(UI.Button)
local Sound = require(Controllers.Sound)
local Toasts = require(Controllers.Toasts)

local function try(label: string, fn: () -> ())
	local ok, err = pcall(fn :: any)
	if not ok then
		warn("[EggFarm] " .. label .. " failed: " .. tostring(err))
	end
end

Store.Start()
Layout.Start()

-- settings that affect every screen
Store.OnChanged(function(snap: any)
	Num.SetNotation(snap.settings.notation)
	Sound.Apply(snap.settings)
end)
Button.ClickHook = function()
	Sound.Play("click")
end

try("toasts", Toasts.Start)

local host: any = nil
try("menus", function()
	local Host = require(Menus.Host)
	host = Host.new(Store, {
		require(Menus.Shop) :: any,
		require(Menus.Codes) :: any,
		require(Menus.Eggs) :: any,
		require(Menus.Quests) :: any,
		require(Menus.Boosts) :: any,
		require(Menus.Daily) :: any,
		require(Menus.Gifts) :: any,
		require(Menus.Settings) :: any,
		require(Menus.Upgrades) :: any,
		require(Menus.Farm) :: any,
	})
end)

if host then
	local Hud = require(Controllers.Hud)
	try("hud", function()
		Hud.Start(Store, host)
	end)
	try("tutorial", function()
		require(Controllers.Tutorial).Start(Store, host, Hud)
	end)
	try("prompts", function()
		require(Controllers.Prompts).Start(host)
	end)
	try("input", function()
		require(Controllers.Input).Start(host, Hud)
	end)
	try("offline", function()
		require(Controllers.Offline).Start(Store, host)
	end)
end
try("events", function()
	require(Controllers.Events).Start(Store)
end)

-- World visuals (flock, vehicles, workers, effects) are a separate module.
local visualsFolder = script.Parent:FindFirstChild("Visuals")
if visualsFolder and visualsFolder:FindFirstChild("Visuals") then
	try("visuals", function()
		(require :: any)(visualsFolder:FindFirstChild("Visuals")).Start(Store)
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="84">
          <Properties>
            <string name="Name">Menus</string>
          </Properties>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Boosts</string>
              <string name="Source"><![CDATA[--!strict
-- Boosts: BOOSTS tab (active boosts with live countdowns from endsAt vs Store.Now(), the max
-- active count, and the inventory with counts + Use buttons -> useBoost) and SHOP tab (Gold Egg
-- boost items from Data/Products kind "gold" -> buyGoldItem, confirm when settings.confirmSpend).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Boosts = require(Shared:WaitForChild("Data"):WaitForChild("Boosts"))
local Products = require(Shared:WaitForChild("Data"):WaitForChild("Products"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Icon = require(UI.Icon)
local Num = require(UI.Num)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local M = {
	Name = "Boosts",
	Title = "Boosts",
	Icon = "booster",
	Color = Theme.Color.Purple,
	Tabs = {
		{ id = "BOOSTS", label = "BOOSTS", color = Theme.Color.Purple },
		{ id = "SHOP", label = "SHOP", color = Theme.Color.Orange },
	},
}

local function activeOf(snap: any, id: string, now: number): any
	for _, a in snap.boosts.active do
		if a.id == id and a.endsAt > now then
			return a
		end
	end
	return nil
end

local function activeCount(snap: any, now: number): number
	local n = 0
	for _, a in snap.boosts.active do
		if a.endsAt > now then
			n += 1
		end
	end
	return n
end

function M.Build(host: any, panel: any)
	-- BOOSTS page
	local mine = Util.Scroll(panel.Body)
	Util.List(mine, 8)
	Util.Pad(mine, 4)
	local activeTitle = Common.Heading(mine, "Active", 1, Theme.Color.PurpleDark)
	local activeBox = Instance.new("Frame")
	activeBox.BackgroundTransparency = 1
	activeBox.Size = UDim2.new(1, -8, 0, 0)
	activeBox.AutomaticSize = Enum.AutomaticSize.Y
	activeBox.LayoutOrder = 2
	activeBox.Parent = mine
	Util.Grid(activeBox, Vector2.new(200, 76), 8)
	local noneActive = Common.Note(mine, "No boosts running. Use one below!", 3)
	Common.Heading(mine, "Your boosts", 4, Theme.Color.PurpleDark)

	local invRows = {}
	for i, b in Boosts.List do
		local row = Card.Row({ icon = b.icon, title = b.name, detail = b.desc, order = 4 + i, parent = mine })
		local id = b.id
		local btn = PurchaseButton.new({
			host = host,
			currency = "free",
			verb = "USE",
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromScale(0, 0.5),
			anchor = Vector2.new(0, 0.5),
			parent = row.Action,
			successSound = "claim",
			quote = function(snap)
				local now = host.Store.Now()
				if (snap.boosts.inventory[id] or 0) <= 0 then
					return nil, "no_boost"
				end
				if not activeOf(snap, id, now) and activeCount(snap, now) >= snap.boosts.maxActive then
					return nil, "boost_limit"
				end
				return 0, "ok"
			end,
			send = function()
				return host.Store.Request({ type = "useBoost", id = id })
			end,
			explain = function(code)
				if code == "no_boost" then
					return "You don't have this boost. Get more in the SHOP tab!"
				end
				return nil
			end,
		})
		invRows[id] = { row = row, btn = btn, def = b }
	end

	-- SHOP page
	local shop = Util.Scroll(panel.Body)
	Util.List(shop, 8)
	Util.Pad(shop, 4)
	local goldLine = Common.Heading(shop, "", 0, Theme.Color.GoldDark)
	local shopButtons = {}
	local order = 0
	for _, p in Products.List do
		if p.kind ~= "gold" then
			continue
		end
		order += 1
		local row = Card.Row({ icon = p.icon, title = p.name, detail = p.desc, order = order, parent = shop })
		local btn = PurchaseButton.new({
			host = host,
			currency = "gold",
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromScale(0, 0.5),
			anchor = Vector2.new(0, 0.5),
			parent = row.Action,
			quote = function()
				return p.goldPrice, nil, false
			end,
			send = function()
				return host.Store.Request({ type = "buyGoldItem", id = p.id })
			end,
			confirm = function(snap)
				if not snap.settings.confirmSpend then
					return nil
				end
				return {
					title = "Spend Gold Eggs?",
					icon = "gold",
					color = Theme.Color.GoldDark,
					text = string.format("Buy %s for %s Gold Eggs?", p.name, Num.Short(p.goldPrice or 0)),
					confirmText = "Buy",
				}
			end,
			onResult = function(res)
				if res.ok then
					host:Toast(p.name .. " added to your boosts!", "gold")
				end
			end,
		})
		table.insert(shopButtons, btn)
	end

	local activeTiles: { [string]: { frame: Frame, label: TextLabel } } = {}
	local activeKey = ""

	local function rebuildActive(snap: any, now: number)
		local ids = {}
		for _, a in snap.boosts.active do
			if a.endsAt > now then
				table.insert(ids, a.id)
			end
		end
		table.sort(ids)
		local key = table.concat(ids, ",")
		if key == activeKey then
			return
		end
		activeKey = key
		for _, t in activeTiles do
			t.frame:Destroy()
		end
		activeTiles = {}
		for i, id in ids do
			local def = Boosts.ById[id]
			local f = Card.new({ order = i, color = Theme.Color.CardAlt, parent = activeBox })
			local ic = Icon.new(def and def.icon or "booster", 48)
			ic.Position = UDim2.fromOffset(8, 14)
			ic.Parent = f
			Util.Text({
				text = def and def.name or id,
				size = UDim2.new(1, -66, 0, 30),
				position = UDim2.fromOffset(62, 6),
				textSize = Theme.Text.S,
				color = Theme.Color.TextDark,
				font = Theme.Font.Title,
				xAlign = Enum.TextXAlignment.Left,
				parent = f,
			})
			local lbl = Util.Text({
				text = "",
				size = UDim2.new(1, -66, 0, 30),
				position = UDim2.fromOffset(62, 38),
				textSize = Theme.Text.M,
				color = Theme.Color.GreenDark,
				font = Theme.Font.Number,
				xAlign = Enum.TextXAlignment.Left,
				parent = f,
			})
			activeTiles[id] = { frame = f, label = lbl }
		end
	end

	local function tick(snap: any, now: number)
		rebuildActive(snap, now)
		local n = 0
		for id, t in activeTiles do
			local a = activeOf(snap, id, now)
			if a then
				n += 1
				t.label.Text = Common.Countdown(a.endsAt - now)
			else
				t.label.Text = "Ended"
			end
		end
		activeTitle.Text = string.format("Active  %d / %d", n, snap.boosts.maxActive)
		noneActive.Visible = n == 0
	end

	local inst = {}
	local function show(tab: string?)
		mine.Visible = tab ~= "SHOP"
		shop.Visible = tab == "SHOP"
	end
	function inst.OnShow(tab: string?)
		show(tab)
	end
	function inst.OnTab(tab: string?)
		show(tab)
	end
	function inst.Refresh(snap: any)
		local now = host.Store.Now()
		tick(snap, now)
		for id, r in invRows do
			local count = snap.boosts.inventory[id] or 0
			r.row.Title.Text = string.format("%s  x%d", r.def.name, count)
			r.btn:Refresh(snap)
		end
		goldLine.Text = "You have " .. Num.Short(snap.gold) .. " Gold Eggs"
		for _, b in shopButtons do
			b:Refresh(snap)
		end
	end
	function inst.Tick(now: number)
		local snap = host.Store.Get()
		if snap then
			tick(snap, now)
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Codes</string>
              <string name="Source"><![CDATA[--!strict
-- Codes: text box + Redeem. Distinct looks for each result: code_ok (green), code_invalid (red),
-- code_used (orange), code_expired (grey), tutorial (blue), rate_limited (orange), busy/loading.
-- Opened from the Shop (Back returns to the Shop).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Contract = require(Shared:WaitForChild("Contract"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Button = require(UI.Button)
local Icon = require(UI.Icon)

local M = {
	Name = "Codes",
	Title = "Codes",
	Icon = "code",
	Color = Theme.Color.Purple,
	MaxSize = Vector2.new(560, 440),
}

local LOOK: { [string]: { color: Color3, icon: string } } = {
	idle = { color = Theme.Color.GrayDark, icon = "code" },
	loading = { color = Theme.Color.Blue, icon = "clock" },
	code_ok = { color = Theme.Color.Green, icon = "check" },
	code_invalid = { color = Theme.Color.Red, icon = "close" },
	code_used = { color = Theme.Color.Orange, icon = "check" },
	code_expired = { color = Theme.Color.Gray, icon = "clock" },
	tutorial = { color = Theme.Color.Blue, icon = "lock" },
	rate_limited = { color = Theme.Color.Orange, icon = "clock" },
	error = { color = Theme.Color.Red, icon = "close" },
}

function M.Build(host: any, panel: any)
	local body = panel.Body
	Util.List(body, 12)

	Util.Text({
		text = "Got a code? Type it here to get free rewards!",
		size = UDim2.new(1, 0, 0, 0),
		textSize = Theme.Text.M,
		color = Theme.Color.TextDark,
		wrap = true,
		order = 1,
		parent = body,
	})

	local box = Instance.new("TextBox")
	box.Name = "CodeBox"
	box.LayoutOrder = 2
	box.Size = UDim2.new(1, 0, 0, 64)
	box.BackgroundColor3 = Theme.Color.Card
	box.PlaceholderText = "Enter code"
	box.PlaceholderColor3 = Theme.Color.TextMuted
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Font = Theme.Font.Title
	box.TextColor3 = Theme.Color.TextDark
	box.TextScaled = true
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = Theme.Text.L
	c.MinTextSize = Theme.Text.Min
	c.Parent = box
	Util.Corner(box, 14)
	local boxStroke = Util.Stroke(box, 3, Theme.Color.Ink, true)
	Util.Pad(box, 12, 6, 6)
	box.Parent = body

	local status = Instance.new("Frame")
	status.LayoutOrder = 4
	status.Size = UDim2.new(1, 0, 0, 56)
	status.BackgroundColor3 = Theme.Color.GrayDark
	Util.Corner(status, 14)
	Util.Stroke(status, 3, Theme.Color.Ink, true)
	status.Parent = body
	local iconHolder = Instance.new("Frame")
	iconHolder.BackgroundTransparency = 1
	iconHolder.Size = UDim2.fromOffset(40, 40)
	iconHolder.Position = UDim2.fromOffset(10, 8)
	iconHolder.Parent = status
	local statusText = Util.Text({
		text = "",
		size = UDim2.new(1, -64, 1, -8),
		position = UDim2.fromOffset(56, 4),
		textSize = Theme.Text.M,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		outline = true,
		parent = status,
	})

	local function setState(state: string, message: string?)
		local look = LOOK[state] or LOOK.error
		status.BackgroundColor3 = look.color
		boxStroke.Color = if state == "idle" or state == "loading" then Theme.Color.Ink else look.color
		Util.Clear(iconHolder)
		Icon.new(look.icon, 40, iconHolder)
		statusText.Text = message or ""
		Util.Pop(status, 0.06)
	end
	setState("idle", "Codes are not case sensitive.")

	local busy = false
	local redeem: any
	redeem = Button.new({
		text = "Redeem",
		color = Theme.Color.Green,
		size = UDim2.new(1, 0, 0, 64),
		order = 3,
		parent = body,
		onClick = function()
			if busy then
				return
			end
			local text = string.gsub(box.Text, "^%s+", "")
			text = string.gsub(text, "%s+$", "")
			if text == "" then
				setState("code_invalid", "Type a code first.")
				Util.Shake(box)
				return
			end
			busy = true
			redeem:SetText("...")
			redeem:SetColor(Theme.Color.Gray)
			setState("loading", "Checking code...")
			local res = host.Store.Request({ type = "redeemCode", text = text })
			busy = false
			redeem:SetText("Redeem")
			redeem:SetColor(Theme.Color.Green)
			if res.code == "busy" then
				setState("loading", "Still checking...")
				return
			end
			local msg = res.message or Contract.Messages[res.code] or "That didn't work."
			setState(res.code, msg)
			if res.ok or res.code == "code_ok" then
				host:Sound("claim")
				box.Text = ""
			else
				host:Sound("error")
				Util.Shake(status)
			end
		end,
	})

	local inst = {}
	function inst.OnShow()
		if not busy then
			setState("idle", "Codes are not case sensitive.")
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Common</string>
              <string name="Source"><![CDATA[--!strict
-- Helpers shared by the menus: reward text, the friendly reset/kept lists for new farms,
-- price quotes from a snapshot (the snapshot carries the same fields Logic/Prices reads), and
-- small layout builders.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Logic = Shared:WaitForChild("Logic")
local Data = Shared:WaitForChild("Data")
local Prices = require(Logic:WaitForChild("Prices"))
local State = require(Logic:WaitForChild("State"))
local Boosts = require(Data:WaitForChild("Boosts"))
local RewardData = require(Data:WaitForChild("Rewards"))
local Eggs = require(Data:WaitForChild("Eggs"))
local GameInfo = require(Shared:WaitForChild("GameInfo"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Num = require(UI.Num)

local Common = {}

-- Prices.* need a Mods-like table; the snapshot already carries the numbers they use.
function Common.Mods(snap: any): any
	return {
		vehicleSlots = snap.vehicleSlots,
		workerSlots = snap.workerSlots,
		commonPriceMult = snap.mods and snap.mods.commonPriceMult or 1,
	}
end

function Common.Quote(kind: string, snap: any, arg: any): (number?, string?)
	if kind == "buyHouse" then
		return Prices.BuyHouse(snap, arg)
	elseif kind == "upgradeHouse" then
		return Prices.UpgradeHouse(snap, arg)
	elseif kind == "buyVehicle" then
		return Prices.BuyVehicle(snap, arg, Common.Mods(snap))
	elseif kind == "upgradeVehicle" then
		return Prices.UpgradeVehicle(snap, arg)
	elseif kind == "hireWorker" then
		return Prices.HireWorker(snap, arg, Common.Mods(snap))
	elseif kind == "upgradeWorker" then
		return Prices.UpgradeWorker(snap, arg)
	elseif kind == "silo" then
		return Prices.Silo(snap)
	elseif kind == "upgrade" then
		local p, code = Prices.Upgrade(snap, arg, Common.Mods(snap))
		return p, code
	end
	return nil, "invalid"
end

-- "5 Gold Eggs", "10 min of earnings", "1x Cash x3"
function Common.RewardLines(reward: any): { string }
	local out = {}
	if not reward then
		return out
	end
	if reward.gold and reward.gold > 0 then
		table.insert(out, Num.Short(reward.gold) .. " " .. GameInfo.Currency.Gold)
	end
	if reward.cashMinutes and reward.cashMinutes > 0 then
		table.insert(out, reward.cashMinutes .. " min of farm cash")
	end
	if reward.cash and reward.cash > 0 then
		table.insert(out, Num.Cash(reward.cash))
	end
	if reward.boosts then
		local ids = {}
		for id in reward.boosts do
			table.insert(ids, id)
		end
		table.sort(ids)
		for _, id in ids do
			local b = Boosts.ById[id]
			table.insert(out, reward.boosts[id] .. "x " .. (if b then b.name else id))
		end
	end
	return out
end

function Common.RewardText(reward: any): string
	local lines = Common.RewardLines(reward)
	return if #lines > 0 then table.concat(lines, " + ") else "-"
end

function Common.RewardIcon(reward: any): string
	if reward and reward.gold then
		return "gold"
	elseif reward and (reward.cashMinutes or reward.cash) then
		return "cash"
	end
	return "booster"
end

-- Friendly names for State.RESET_FIELDS / KEPT_FIELDS. Internal bookkeeping fields map to nil
-- and are left out of the confirmation list.
local FRIENDLY: { [string]: string } = {
	cash = "Your Cash",
	population = "Your chickens",
	invested = "Farm Value (starts again from zero)",
	housing = "Houses (back to one Little Coop)",
	carried = "Eggs in your basket",
	warehouse = "Eggs in the warehouse",
	vehicles = "Vehicles (back to one Farm Pickup)",
	workers = "Workers",
	silos = "Silos you built (Permanent Silos stay)",
	common = "Common upgrades",
	gold = GameInfo.Currency.Gold,
	stars = GameInfo.Currency.Star,
	epic = "Epic upgrades",
	boosts = "Boosts (stored and active)",
	quests = "Today's quest progress",
	daily = "Daily reward streak",
	gifts = "Playtime gifts",
	codes = "Redeemed codes",
	settings = "Settings",
	passes = "Game passes",
	offline = "Unclaimed offline earnings",
	stats = "Lifetime stats",
	rebirths = "Rebirth count",
	prestiges = "Prestige count",
}

function Common.ResetLines(prestige: boolean): { string }
	local out = {}
	for _, f in State.RESET_FIELDS do
		local name = FRIENDLY[f]
		if name then
			table.insert(out, name)
		end
	end
	if prestige then
		table.insert(out, "Your egg goes back to the " .. Eggs.List[1].name)
	end
	return out
end

function Common.KeptLines(prestige: boolean): { string }
	local out = {}
	for _, f in State.KEPT_FIELDS do
		local name = FRIENDLY[f]
		if name then
			table.insert(out, name)
		end
	end
	if not prestige then
		table.insert(out, "Every egg you've unlocked")
	end
	return out
end

-- A small section heading inside a scroll list.
function Common.Heading(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return Util.Text({
		text = text,
		size = UDim2.new(1, -8, 0, 34),
		textSize = Theme.Text.L,
		color = color or Theme.Color.TextDark,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		order = order,
		parent = parent,
	})
end

-- Empty-state line.
function Common.Note(parent: Instance, text: string, order: number): TextLabel
	return Util.Text({
		text = text,
		size = UDim2.new(1, -8, 0, 0),
		textSize = Theme.Text.S,
		color = Theme.Color.TextMuted,
		wrap = true,
		order = order,
		parent = parent,
	})
end

-- Playtime today, advanced locally between snapshots (the server counts it while you play).
function Common.Playtime(snap: any, now: number): number
	return snap.gifts.playtime + math.max(0, now - snap.serverNow)
end

-- Playtime gifts that can be claimed right now.
function Common.GiftsReady(snap: any, now: number): number
	local play = Common.Playtime(snap, now)
	local n = 0
	for i, g in RewardData.Gifts do
		if not snap.gifts.claimed[tostring(i)] and play >= g.minutes * 60 then
			n += 1
		end
	end
	return n
end

function Common.Countdown(seconds: number): string
	return Num.Duration(math.max(0, seconds))
end

return Common
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Daily</string>
              <string name="Source"><![CDATA[--!strict
-- Daily rewards: 7-day ladder (Data/Rewards Daily), current streak, Claim (claimDaily) and the
-- countdown to the next day. snapshot.daily.nextDay is the ladder day the next claim pays.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared:WaitForChild("Data"):WaitForChild("Rewards"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Icon = require(UI.Icon)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local M = {
	Name = "Daily",
	Title = "Daily Rewards",
	Icon = "daily",
	Color = Theme.Color.Red,
}

function M.Build(host: any, panel: any)
	local scroll = Util.Scroll(panel.Body)
	Util.List(scroll, 10)
	Util.Pad(scroll, 4)
	local streak = Common.Heading(scroll, "", 1)

	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Size = UDim2.new(1, -8, 0, 0)
	grid.AutomaticSize = Enum.AutomaticSize.Y
	grid.LayoutOrder = 2
	grid.Parent = scroll
	Util.Grid(grid, Vector2.new(132, 150), 8)

	local tiles = {}
	for day, reward in Rewards.Daily do
		local card = Card.new({ order = day, parent = grid })
		Util.Text({
			text = "Day " .. day,
			size = UDim2.new(1, -8, 0, 28),
			position = UDim2.fromOffset(4, 4),
			textSize = Theme.Text.M,
			color = Theme.Color.TextDark,
			font = Theme.Font.Title,
			parent = card,
		})
		local ic = Icon.new(Common.RewardIcon(reward), 48)
		ic.AnchorPoint = Vector2.new(0.5, 0)
		ic.Position = UDim2.new(0.5, 0, 0, 34)
		ic.Parent = card
		local lbl = Util.Text({
			text = Common.RewardText(reward),
			size = UDim2.new(1, -8, 0, 60),
			position = UDim2.fromOffset(4, 86),
			textSize = Theme.Text.S,
			color = Theme.Color.TextMuted,
			parent = card,
		})
		lbl.TextWrapped = true
		local check = Icon.new("check", 40)
		check.AnchorPoint = Vector2.new(1, 0)
		check.Position = UDim2.new(1, -4, 0, 4)
		check.Visible = false
		check.Parent = card
		tiles[day] = { card = card, check = check }
	end

	local timer = Common.Note(scroll, "", 3)
	local btn = PurchaseButton.new({
		host = host,
		currency = "free",
		verb = "CLAIM",
		size = UDim2.new(1, -8, 0, 64),
		order = 4,
		parent = scroll,
		successSound = "claim",
		quote = function(snap)
			if not snap.daily.canClaim then
				return nil, "claimed"
			end
			return 0, "ok"
		end,
		send = function()
			return host.Store.Request({ type = "claimDaily" })
		end,
	})

	local nextAt = 0
	local inst = {}
	function inst.Refresh(snap: any)
		local d = snap.daily
		local nextDay = d.nextDay
		streak.Text = string.format("Streak: %d day%s", d.streak, if d.streak == 1 then "" else "s")
		for day, t in tiles do
			local isNext = day == nextDay
			-- days before the next claim are done; after a full week day 7 repeats (claimed today)
			local done = day < nextDay or (not d.canClaim and d.streak >= #Rewards.Daily and day == #Rewards.Daily)
			t.check.Visible = done
			t.card.BackgroundColor3 = if isNext and d.canClaim
				then Theme.Color.Gold
				elseif done then Theme.Color.CardAlt
				else Theme.Color.Card
		end
		nextAt = snap.serverNow + d.resetsIn
		btn:Refresh(snap)
	end
	function inst.Tick(now: number)
		local snap = host.Store.Get()
		if snap and snap.daily.canClaim then
			timer.Text = "Your reward is ready!"
		else
			timer.Text = "Next reward in " .. Common.Countdown(nextAt - now)
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Eggs</string>
              <string name="Source"><![CDATA[--!strict
-- Eggs: current egg and the next one (Data/Eggs + Data/Themes), Farm Value vs the requirement,
-- and the new-farm actions:
--   REBIRTH  (enabled when snapshot.canRebirth)            -> { type = "rebirth", expect = egg }
--   SKIP     (Gold Eggs = snapshot.skipCost, -1 = no)      -> { type = "skip", expect = egg }
--   PRESTIGE (last egg only, snapshot.canPrestige)         -> { type = "prestige", expect = egg }
-- Each asks for confirmation listing what resets, what is kept (State.RESET/KEPT_FIELDS) and the
-- rewards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))
local Themes = require(Shared:WaitForChild("Data"):WaitForChild("Themes"))
local Prices = require(Shared:WaitForChild("Logic"):WaitForChild("Prices"))
local Modifiers = require(Shared:WaitForChild("Logic"):WaitForChild("Modifiers"))
local GameInfo = require(Shared:WaitForChild("GameInfo"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Icon = require(UI.Icon)
local Num = require(UI.Num)
local ProgressBar = require(UI.ProgressBar)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local M = {
	Name = "Eggs",
	Title = "Eggs",
	Icon = "egg",
	Color = Theme.Color.Gold,
}

local function themeColor(egg: number): Color3
	local e = Eggs.List[egg]
	local t = e and Themes[e.theme]
	if t then
		return Color3.fromRGB(t.accent[1], t.accent[2], t.accent[3])
	end
	return Theme.Color.Gold
end

-- Stars a prestige would grant (mirrors Economy.PrestigeStars; the server decides).
local function prestigeStars(snap: any): number
	return 10 + 5 * (snap.prestiges or 0)
end

local function eggCard(parent: Instance, order: number, caption: string): (Frame, TextLabel, TextLabel, Frame)
	local card = Card.new({ size = UDim2.new(0.5, -6, 0, 170), order = order, parent = parent })
	Util.Text({
		text = caption,
		size = UDim2.new(1, -12, 0, 26),
		position = UDim2.fromOffset(6, 6),
		textSize = Theme.Text.S,
		color = Theme.Color.TextMuted,
		font = Theme.Font.Title,
		parent = card,
	})
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(64, 64)
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, 32)
	holder.Parent = card
	local name = Util.Text({
		text = "",
		size = UDim2.new(1, -12, 0, 30),
		position = UDim2.fromOffset(6, 98),
		textSize = Theme.Text.M,
		color = Theme.Color.TextDark,
		font = Theme.Font.Title,
		parent = card,
	})
	local sub = Util.Text({
		text = "",
		size = UDim2.new(1, -12, 0, 30),
		position = UDim2.fromOffset(6, 128),
		textSize = Theme.Text.S,
		color = Theme.Color.TextMuted,
		parent = card,
	})
	return card, name, sub, holder
end

function M.Build(host: any, panel: any)
	local scroll = Util.Scroll(panel.Body)
	Util.List(scroll, 10)
	Util.Pad(scroll, 4)

	local pair = Instance.new("Frame")
	pair.BackgroundTransparency = 1
	pair.Size = UDim2.new(1, -8, 0, 170)
	pair.LayoutOrder = 1
	pair.Parent = scroll
	Util.List(pair, 12, true)
	local _, curName, curSub, curIcon = eggCard(pair, 1, "CURRENT EGG")
	local nextCard, nextName, nextSub, nextIcon = eggCard(pair, 2, "NEXT EGG")

	local fvTitle = Common.Heading(scroll, "Farm Value", 2)
	local bar = ProgressBar.new({ size = UDim2.new(1, -8, 0, 36), order = 3, color = Theme.Color.Gold, parent = scroll })
	local hint = Common.Note(scroll, "", 4)

	local buttons = Instance.new("Frame")
	buttons.BackgroundTransparency = 1
	buttons.Size = UDim2.new(1, -8, 0, 0)
	buttons.AutomaticSize = Enum.AutomaticSize.Y
	buttons.LayoutOrder = 5
	buttons.Parent = scroll
	Util.Grid(buttons, Vector2.new(220, 96), 10)

	local function actionTile(order: number, title: string, color: Color3): Frame
		local f = Instance.new("Frame")
		f.BackgroundTransparency = 1
		f.LayoutOrder = order
		f.Parent = buttons
		Util.Text({
			text = title,
			size = UDim2.new(1, 0, 0, 26),
			textSize = Theme.Text.M,
			color = color,
			font = Theme.Font.Title,
			outline = false,
			parent = f,
		})
		return f
	end

	local function confirmFor(kind: string, snap: any): any
		local prestige = kind == "prestige"
		local rewards = {}
		local nextEgg = Eggs.List[snap.egg + 1]
		if prestige then
			local stars = prestigeStars(snap)
			table.insert(rewards, string.format("+%d %s (+%d%% cash each, forever)", stars, GameInfo.Currency.Star, math.floor(Modifiers.STAR_BONUS * 100)))
		elseif nextEgg then
			local gold = nextEgg.rebirthGold * (if snap.passes.x2gold then 2 else 1)
			table.insert(rewards, "A new farm: " .. nextEgg.name .. " (" .. (Themes[nextEgg.theme] and Themes[nextEgg.theme].name or nextEgg.theme) .. ")")
			table.insert(rewards, string.format("Eggs sell for %s each before upgrades (now %s)", Num.Cash(nextEgg.value), Num.Cash(Eggs.List[snap.egg].value)))
			if gold > 0 then
				table.insert(rewards, string.format("+%d %s", gold, GameInfo.Currency.Gold))
			end
		end
		local title, color, verb, text
		if kind == "rebirth" then
			title, color, verb = "Rebirth?", Theme.Color.Purple, "Rebirth"
			text = "Start a brand-new farm on the next egg."
		elseif kind == "skip" then
			title, color, verb = "Skip ahead?", Theme.Color.Blue, "Skip"
			text = string.format("Pay %s Gold Eggs to start the next farm now, before reaching the Farm Value goal.", Num.Short(snap.skipCost))
		else
			title, color, verb = "Prestige?", Theme.Color.Purple, "Prestige"
			text = "Go back to the first egg and earn Star Eggs that boost your cash forever."
		end
		return {
			title = title,
			icon = if prestige then "prestige" else "rebirth",
			color = color,
			text = text,
			sections = {
				{ title = "You get", items = rewards, color = Theme.Color.GoldDark },
				{ title = "Resets", items = Common.ResetLines(prestige), color = Theme.Color.RedDark },
				{ title = "You keep", items = Common.KeptLines(prestige), color = Theme.Color.GreenDark },
			},
			confirmText = verb,
			confirmColor = color,
		}
	end

	local rebirthTile = actionTile(1, "REBIRTH", Theme.Color.PurpleDark)
	local rebirth = PurchaseButton.new({
		host = host,
		currency = "free",
		verb = "REBIRTH",
		size = UDim2.new(1, 0, 0, 62),
		position = UDim2.fromOffset(0, 30),
		parent = rebirthTile,
		successSound = "rebirth",
		quote = function(snap)
			if snap.egg >= Eggs.Count then
				return nil, "last_egg"
			elseif not snap.canRebirth then
				return nil, "not_requirement"
			end
			return 0, "ok"
		end,
		send = function(snap)
			return host.Store.Request({ type = "rebirth", expect = snap.egg })
		end,
		confirm = function(snap)
			return confirmFor("rebirth", snap)
		end,
		onResult = function(res)
			if res.ok then
				host:Close()
			end
		end,
	})

	local skipTile = actionTile(2, "SKIP", Theme.Color.BlueDark)
	local skip = PurchaseButton.new({
		host = host,
		currency = "gold",
		verb = "SKIP",
		size = UDim2.new(1, 0, 0, 62),
		position = UDim2.fromOffset(0, 30),
		parent = skipTile,
		successSound = "rebirth",
		quote = function(snap)
			if snap.egg >= Eggs.Count then
				return nil, "last_egg"
			end
			if snap.skipCost < 0 then
				local _, code = Prices.Skip(snap, snap.farmValue)
				return nil, code
			end
			return snap.skipCost, "ok"
		end,
		send = function(snap)
			return host.Store.Request({ type = "skip", expect = snap.egg })
		end,
		confirm = function(snap)
			return confirmFor("skip", snap)
		end,
		onResult = function(res)
			if res.ok then
				host:Close()
			end
		end,
	})

	local prestigeTile = actionTile(3, "PRESTIGE", Theme.Color.PurpleDark)
	local prestige = PurchaseButton.new({
		host = host,
		currency = "free",
		verb = "PRESTIGE",
		size = UDim2.new(1, 0, 0, 62),
		position = UDim2.fromOffset(0, 30),
		parent = prestigeTile,
		successSound = "rebirth",
		quote = function(snap)
			if snap.egg < Eggs.Count then
				return nil, "not_last_egg"
			elseif not snap.canPrestige then
				return nil, "not_requirement"
			end
			return 0, "ok"
		end,
		send = function(snap)
			return host.Store.Request({ type = "prestige", expect = snap.egg })
		end,
		confirm = function(snap)
			return confirmFor("prestige", snap)
		end,
		onResult = function(res)
			if res.ok then
				host:Close()
			end
		end,
	})

	local stats = Common.Note(scroll, "", 6)

	local shownEgg = -1
	local inst = {}
	function inst.Refresh(snap: any)
		local egg = Eggs.List[snap.egg] or Eggs.List[1]
		local nxt = Eggs.List[snap.egg + 1]
		if shownEgg ~= snap.egg then
			shownEgg = snap.egg
			Util.Clear(curIcon)
			Icon.new("egg", 64, curIcon)
			local ci = curIcon:FindFirstChildWhichIsA("Frame")
			if ci then
				local shape = ci:FindFirstChildWhichIsA("Frame")
				if shape then
					shape.BackgroundColor3 = themeColor(snap.egg)
				end
			end
			Util.Clear(nextIcon)
			Icon.new(if nxt then "egg" else "prestige", 64, nextIcon)
			if nxt then
				local ni = nextIcon:FindFirstChildWhichIsA("Frame")
				local shape = ni and ni:FindFirstChildWhichIsA("Frame")
				if shape then
					shape.BackgroundColor3 = themeColor(snap.egg + 1)
				end
			end
		end
		curName.Text = egg.name
		curSub.Text = (Themes[egg.theme] and Themes[egg.theme].name or "") .. "  •  " .. Num.Cash(snap.eggValue) .. "/egg"
		if nxt then
			nextName.Text = nxt.name
			nextSub.Text = (Themes[nxt.theme] and Themes[nxt.theme].name or "")
		else
			nextName.Text = "Prestige"
			nextSub.Text = "Earn Star Eggs and start over"
		end
		nextCard.Visible = true
		local req = snap.nextRequirement
		fvTitle.Text = string.format("Farm Value: %s / %s", Num.Cash(snap.farmValue), Num.Cash(req))
		bar:Set(snap.farmValue / math.max(req, 1), string.format("%d%%", math.floor(math.min(1, snap.farmValue / math.max(req, 1)) * 100)))
		if snap.canRebirth then
			hint.Text = "Goal reached! Rebirth to unlock the " .. (if nxt then nxt.name else "next egg") .. "."
		elseif snap.canPrestige then
			hint.Text = "Goal reached! Prestige to earn Star Eggs."
		elseif snap.skipCost >= 0 and snap.egg < Eggs.Count then
			hint.Text = "Farm Value = your Cash + everything you've spent on this farm. Or SKIP for Gold Eggs."
		else
			hint.Text = "Farm Value = your Cash + everything you've spent on this farm. SKIP opens at 25% of the goal."
		end
		rebirthTile.Visible = snap.egg < Eggs.Count
		skipTile.Visible = snap.egg < Eggs.Count
		prestigeTile.Visible = snap.egg >= Eggs.Count
		rebirth:Refresh(snap)
		skip:Refresh(snap)
		prestige:Refresh(snap)
		stats.Text = string.format(
			"Rebirths: %d  •  Prestiges: %d  •  %s: %d",
			snap.rebirths,
			snap.prestiges,
			GameInfo.Currency.Star,
			snap.stars
		)
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Farm</string>
              <string name="Source"><![CDATA[--!strict
-- Farm panel: Housing / Shipping / Workers / Silos tabs (one page module each). Opened from the
-- HUD "Farm" button or a world board (ProximityPrompt attribute Menu + optional Slot).
-- Tabs not yet revealed by the tutorial are hidden (Host._applyReveals).

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)

local Housing = require(script.Parent.Housing)
local Shipping = require(script.Parent.Shipping)
local Workers = require(script.Parent.Workers)
local Silos = require(script.Parent.Silos)

local M = {
	Name = "Farm",
	Title = "Farm",
	Icon = "farm",
	Color = Theme.Color.Orange,
	Tabs = {
		{ id = "Housing", label = "Housing", color = Theme.Color.Red },
		{ id = "Shipping", label = "Shipping", color = Theme.Color.Blue },
		{ id = "Workers", label = "Workers", color = Theme.Color.Teal },
		{ id = "Silos", label = "Silos", color = Theme.Color.Purple },
	},
}

function M.Build(host: any, panel: any)
	local pages: { [string]: any } = {
		Housing = Housing.Build(host, panel.Body),
		Shipping = Shipping.Build(host, panel.Body),
		Workers = Workers.Build(host, panel.Body),
		Silos = Silos.Build(host, panel.Body),
	}
	local current = "Housing"
	local inst = {}

	local function show(tab: string?)
		current = if tab and pages[tab] then tab else "Housing"
		for id, p in pages do
			p.Frame.Visible = id == current
		end
		panel:SetTitle(current)
		local snap = host.Store.Get()
		if snap then
			pages[current].Refresh(snap)
		end
	end

	function inst.OnShow(tab: string?, opts: any?)
		show(tab)
		if opts and opts.slot and pages[current].Focus then
			local slot = opts.slot
			task.defer(function()
				pages[current].Focus(slot)
			end)
		end
	end

	function inst.OnTab(tab: string?)
		show(tab)
	end

	function inst.Refresh(snap: any)
		pages[current].Refresh(snap)
	end

	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">Gifts</string>
              <string name="Source"><![CDATA[--!strict
-- Playtime gifts: each unlocks after N minutes played today (Data/Rewards Gifts). Timers count
-- locally between snapshots; claimed keys are the strings "1".."6". Claim (claimGift index) or
-- Claim All (claimAllGifts).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared:WaitForChild("Data"):WaitForChild("Rewards"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local M = {
	Name = "Gifts",
	Title = "Gifts",
	Icon = "gift",
	Color = Theme.Color.Red,
}

function M.Build(host: any, panel: any)
	local scroll = Util.Scroll(panel.Body)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	Common.Note(scroll, "Play to unlock free gifts! They reset every day.", 0)

	local function ready(snap: any, i: number): (number?, string?)
		local g = Rewards.Gifts[i]
		if snap.gifts.claimed[tostring(i)] then
			return nil, "claimed"
		end
		if Common.Playtime(snap, host.Store.Now()) < g.minutes * 60 then
			return nil, "not_ready"
		end
		return 0, "ok"
	end

	local all = PurchaseButton.new({
		host = host,
		currency = "free",
		verb = "CLAIM ALL",
		size = UDim2.new(1, -8, 0, 64),
		order = 1,
		parent = scroll,
		successSound = "claim",
		quote = function(snap)
			for i in Rewards.Gifts do
				local p = ready(snap, i)
				if p then
					return 0, "ok"
				end
			end
			return nil, "not_ready"
		end,
		send = function()
			return host.Store.Request({ type = "claimAllGifts" })
		end,
	})

	local rows = {}
	for i, g in Rewards.Gifts do
		local row = Card.Row({
			icon = "gift",
			title = string.format("Gift %d: %d min", i, g.minutes),
			detail = Common.RewardText(g.reward),
			order = 1 + i,
			parent = scroll,
		})
		local btn = PurchaseButton.new({
			host = host,
			currency = "free",
			verb = "CLAIM",
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromScale(0, 0.5),
			anchor = Vector2.new(0, 0.5),
			parent = row.Action,
			successSound = "claim",
			quote = function(snap)
				return ready(snap, i)
			end,
			send = function()
				return host.Store.Request({ type = "claimGift", index = i })
			end,
		})
		rows[i] = { row = row, btn = btn }
	end

	local inst = {}
	local function update(snap: any, now: number)
		local play = Common.Playtime(snap, now)
		for i, r in rows do
			local g = Rewards.Gifts[i]
			local left = g.minutes * 60 - play
			if snap.gifts.claimed[tostring(i)] then
				r.row.Detail.Text = Common.RewardText(g.reward) .. "\nClaimed"
			elseif left > 0 then
				r.row.Detail.Text = Common.RewardText(g.reward) .. "\nReady in " .. Common.Countdown(left)
			else
				r.row.Detail.Text = Common.RewardText(g.reward) .. "\nReady!"
			end
			r.btn:Refresh(snap)
		end
		all:Refresh(snap)
	end
	function inst.Refresh(snap: any)
		update(snap, host.Store.Now())
	end
	function inst.Tick(now: number)
		local snap = host.Store.Get()
		if snap then
			update(snap, now)
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Host</string>
              <string name="Source"><![CDATA[--!strict
-- Menu host: owns the MenuRouter, builds panels lazily, shows/hides them, draws the dimmers and
-- the single confirm modal, and passes snapshots / 4 Hz ticks to the visible panel only.
--
-- Layers (DisplayOrder): 9 panel dimmer (full screen, sinks clicks), 10 panels (safe area),
-- 11 modal dimmer, 12 modal. While anything is open, Host.IsBlocking() is true and
-- Host.OnBlockingChanged listeners fire (HUD disables Spawn, Prompts disables world prompts).
--
-- Menu modules return { Name, Title, Icon, Color, Tabs?, MaxSize?, Build(host, panel) -> inst }
-- where inst = { Refresh(snap)?, Tick(now)?, OnShow(tab?, opts?)?, OnTab(tab)? }.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MenuRouter = require(Shared:WaitForChild("Logic"):WaitForChild("MenuRouter"))
local Tutorial = require(Shared:WaitForChild("Logic"):WaitForChild("Tutorial"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Layout = require(UI.Layout)
local Panel = require(UI.Panel)
local Modal = require(UI.Modal)

local Toasts = require(script.Parent.Parent.Controllers.Toasts)
local SoundC = require(script.Parent.Parent.Controllers.Sound)

export type MenuModule = {
	Name: string,
	Title: string,
	Icon: string,
	Color: Color3,
	Tabs: { { id: string, label: string, color: Color3? } }?,
	MaxSize: Vector2?,
	Build: (host: any, panel: Panel.Handle) -> any,
}

local Host = {}
Host.__index = Host

function Host.new(store: any, modules: { MenuModule })
	local defs: { [string]: MenuRouter.PanelDef } = {}
	local byName: { [string]: MenuModule } = {}
	for _, m in modules do
		local tabs: { string }? = nil
		if m.Tabs then
			local list = {}
			for _, t in m.Tabs do
				table.insert(list, t.id)
			end
			tabs = list
		end
		defs[m.Name] = { tabs = tabs }
		byName[m.Name] = m
	end

	local self: any = setmetatable({
		Store = store,
		Router = MenuRouter.new(defs),
		modules = byName,
		built = {} :: { [string]: { panel: Panel.Handle, inst: any } },
		shown = nil :: string?,
		openOpts = nil :: any,
		blocking = false,
		blockingListeners = {} :: { (boolean) -> () },
	}, Host)

	-- panel dimmer
	local _, dimRoot = Layout.Layer("EggFarmMenuDim", 9, true)
	local dim = Instance.new("TextButton")
	dim.Name = "Dimmer"
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Active = true
	dim.Modal = true -- frees the mouse in first person while a menu is open
	dim.BackgroundColor3 = Theme.Color.Dim
	dim.BackgroundTransparency = 0.45
	dim.Size = UDim2.fromScale(1, 1)
	dim.Visible = false
	dim.Parent = dimRoot
	dim.Activated:Connect(function()
		if self.Router:Modal() == nil then
			self.Router:Back()
		end
	end)
	self.dim = dim

	local _, panelRoot = Layout.Layer("EggFarmMenus", 10)
	self.panelRoot = panelRoot

	-- modal dimmer + modal
	local _, mdimRoot = Layout.Layer("EggFarmModalDim", 11, true)
	local mdim = Instance.new("TextButton")
	mdim.Name = "ModalDimmer"
	mdim.Text = ""
	mdim.AutoButtonColor = false
	mdim.Active = true
	mdim.Modal = true
	mdim.BackgroundColor3 = Theme.Color.Dim
	mdim.BackgroundTransparency = 0.4
	mdim.Size = UDim2.fromScale(1, 1)
	mdim.Visible = false
	mdim.Parent = mdimRoot
	self.mdim = mdim
	local _, modalRoot = Layout.Layer("EggFarmModal", 12)
	self.modal = Modal.new(modalRoot)
	mdim.Activated:Connect(function()
		local cur = self.modal.Current
		if cur and cur.cancelText then
			if cur.onCancel then
				cur.onCancel()
			end
		end
	end)

	self.Router:Subscribe(function()
		self:_sync()
	end)

	store.OnChanged(function(snap: any)
		self:_refresh(snap)
	end)

	-- 4 Hz timers for the visible panel (countdowns, rejected-state expiry)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local name = self.shown
		local b = name and self.built[name]
		if b and b.inst.Tick then
			b.inst.Tick(store.Now())
		end
	end)
	return self
end

function Host:_build(name: string): { panel: Panel.Handle, inst: any }?
	local b = self.built[name]
	if b then
		return b
	end
	local m: MenuModule? = self.modules[name]
	if not m then
		return nil
	end
	local mod = m :: MenuModule
	local panel = Panel.new({
		name = mod.Name,
		title = mod.Title,
		icon = mod.Icon,
		color = mod.Color,
		tabs = mod.Tabs,
		maxSize = mod.MaxSize,
		onTab = function(id)
			self.Router:SetTab(id)
		end,
		onClose = function()
			self.Router:Close()
		end,
		onBack = function()
			self.Router:Back()
		end,
		parent = self.panelRoot,
	})
	local ok, inst = pcall(mod.Build, self, panel)
	if not ok then
		warn("[EggFarm] menu " .. name .. " failed to build: " .. tostring(inst))
		inst = {}
	end
	b = { panel = panel, inst = inst }
	self.built[name] = b
	return b
end

function Host:_setBlocking(on: boolean)
	if self.blocking == on then
		return
	end
	self.blocking = on
	local list: { (boolean) -> () } = table.clone(self.blockingListeners)
	for _, fn in list do
		task.spawn(fn, on)
	end
end

function Host:_sync()
	local r = self.Router
	local want: string? = r:Current()
	-- hide the old panel
	if self.shown and self.shown ~= want then
		local old = self.built[self.shown]
		if old then
			old.panel:Hide()
		end
		self.shown = nil
	end
	if want then
		local b = self:_build(want)
		if b then
			local snapNow = self.Store.Get()
			if snapNow then
				self:_applyReveals(snapNow) -- hide tutorial-locked tabs before the first frame
			end
			local tab = r:GetTab(want)
			if b.panel.Tabs and tab then
				b.panel.Tabs:Select(tab)
			end
			b.panel:SetBack(r.returnTo ~= nil)
			local first = self.shown ~= want
			self.shown = want
			b.panel:Show()
			if first and b.inst.OnShow then
				b.inst.OnShow(tab, self.openOpts)
			elseif b.inst.OnTab then
				b.inst.OnTab(tab)
			end
			self.openOpts = nil
			local snap = self.Store.Get()
			if snap and b.inst.Refresh then
				b.inst.Refresh(snap)
			end
		end
	end
	self.dim.Visible = want ~= nil
	-- modal
	local modalId = r:Modal()
	if modalId then
		local data = r.modalData
		self.mdim.Visible = true
		if data and self.modal.Current ~= data then
			self.modal:Show(data)
		end
	else
		self.mdim.Visible = false
		if self.modal.Current then
			self.modal:Hide()
		end
	end
	self:_setBlocking(r:IsBlockingWorld())
end

function Host:_refresh(snap: any)
	local name = self.shown
	local b = name and self.built[name]
	if b and b.inst.Refresh then
		b.inst.Refresh(snap)
	end
	-- tabs hidden by the tutorial
	self:_applyReveals(snap)
end

function Host:_applyReveals(snap: any)
	local rev = Tutorial.Reveals(snap.tutorial.step, snap.tutorial.done)
	local farm = self.built.Farm
	if farm and farm.panel.Tabs then
		local tabs = farm.panel.Tabs
		tabs:SetVisible("Housing", rev.housing)
		tabs:SetVisible("Shipping", rev.shipping)
		tabs:SetVisible("Workers", rev.workers)
		tabs:SetVisible("Silos", rev.nav)
	end
end

------------------------------------------------------------------------------------------------
-- Public API used by menus, the HUD and controllers
------------------------------------------------------------------------------------------------

-- opts: { returnTo = true (Back returns to the current panel), slot = n (scroll to a slot) }
function Host:Open(name: string, tab: string?, opts: any?): boolean
	self.openOpts = opts
	local ok = self.Router:Open(name, tab, opts and opts.returnTo)
	if ok and self.shown == name then
		-- reopened with a new tab or slot while already visible
		local b = self.built[name]
		if b and b.inst.OnShow and opts then
			b.inst.OnShow(self.Router:GetTab(name), opts)
		end
	end
	self.openOpts = nil
	return ok
end

function Host:Toggle(name: string, tab: string?)
	if self.Router:IsOpen(name) then
		self.Router:Close()
	else
		self:Open(name, tab)
	end
end

function Host:Close()
	self.Router:Close()
end

function Host:IsOpen(name: string): boolean
	return self.Router:IsOpen(name)
end

function Host:IsBlocking(): boolean
	return self.Router:IsBlockingWorld()
end

function Host:OnBlockingChanged(fn: (boolean) -> ()): () -> ()
	table.insert(self.blockingListeners, fn)
	return function()
		local i = table.find(self.blockingListeners, fn)
		if i then
			table.remove(self.blockingListeners, i)
		end
	end
end

-- Shows the confirm modal. Returns false if another modal is already open.
-- opts: UI/Modal ShowOpts without the callbacks; onYes runs after the modal closes.
function Host:Confirm(opts: any, onYes: () -> (), onNo: (() -> ())?): boolean
	local data = table.clone(opts)
	data.cancelText = data.cancelText or "Cancel"
	data.onConfirm = function()
		self.Router:CloseModal()
		onYes()
	end
	data.onCancel = function()
		self.Router:CloseModal()
		if onNo then
			onNo()
		end
	end
	return self.Router:OpenModal("confirm", data)
end

-- A modal with a single button (Welcome back, info). Returns false if one is already open.
function Host:Notice(id: string, opts: any, onOk: (() -> ())?): boolean
	local data = table.clone(opts)
	data.cancelText = nil
	data.onConfirm = function()
		self.Router:CloseModal()
		if onOk then
			onOk()
		end
	end
	return self.Router:OpenModal(id, data)
end

function Host:Toast(text: string, kind: string?)
	Toasts.Show(text, kind)
end

function Host:Sound(name: string)
	SoundC.Play(name)
end

function Host:Reveals(): { [string]: boolean }
	local snap = self.Store.Get()
	if not snap then
		return Tutorial.Reveals(1, false)
	end
	return Tutorial.Reveals(snap.tutorial.step, snap.tutorial.done)
end

-- Request helper for simple (non-PurchaseButton) actions: toasts the rejection message.
function Host:Request(action: any): any
	local res = self.Store.Request(action)
	if not res.ok and res.code ~= "busy" then
		self:Sound("error")
		self:Toast(res.message or "That didn't work.", "bad")
	end
	return res
end

return Host
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">Housing</string>
              <string name="Source"><![CDATA[--!strict
-- Farm > Housing: the 4 house slots. Each row shows the tier name, chickens (occupants /
-- capacity), eggs stored / storage, a preview of the next tier, and one PurchaseButton that
-- buys the slot (buyHouse) or upgrades it (upgradeHouse, expect = tier). Locked / MAX states come
-- from Logic/Prices through PurchaseState.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Housing = require(Shared:WaitForChild("Data"):WaitForChild("Housing"))
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Num = require(UI.Num)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local Page = {}

function Page.Build(host: any, parent: Instance)
	local scroll = Util.Scroll(parent)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	local summary = Common.Note(scroll, "", 0)
	local rows = {}

	for slot = 1, Housing.Slots do
		local row = Card.Row({ icon = "house", title = "House " .. slot, minHeight = 116, order = slot, parent = scroll })
		local caption = Util.Text({
			text = "",
			size = UDim2.new(1, 0, 0, 24),
			textSize = Theme.Text.S,
			color = Theme.Color.TextDark,
			font = Theme.Font.Title,
			parent = row.Action,
		})
		local btn = PurchaseButton.new({
			host = host,
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromOffset(0, 28),
			parent = row.Action,
			quote = function(snap)
				local h = snap.housing[slot]
				if h.tier == 0 then
					return Common.Quote("buyHouse", snap, slot)
				end
				return Common.Quote("upgradeHouse", snap, slot)
			end,
			send = function(snap)
				local h = snap.housing[slot]
				if h.tier == 0 then
					return host.Store.Request({ type = "buyHouse", slot = slot })
				end
				return host.Store.Request({ type = "upgradeHouse", slot = slot, expect = h.tier })
			end,
			explain = function(code, snap)
				if code == "slot_locked" then
					return "Buy House " .. (slot - 1) .. " first."
				elseif code == "locked" then
					local nextTier = Housing.Tiers[snap.housing[slot].tier + 1]
					if nextTier then
						return "Unlocks on the " .. Eggs.List[nextTier.unlockEgg].name .. "."
					end
				end
				return nil
			end,
		})
		rows[slot] = { row = row, caption = caption, btn = btn }
	end

	local page = { Frame = scroll }

	function page.Refresh(snap: any)
		local total, cap = 0, 0
		for slot, r in rows do
			local h = snap.housing[slot]
			total += h.occupants
			cap += h.capacity
			local tier = Housing.Tiers[h.tier]
			local nextTier = Housing.Tiers[h.tier + 1]
			if h.tier == 0 then
				r.row.Title.Text = "House " .. slot .. ": empty lot"
				r.row.Detail.Text = "Buy this lot to get a " .. Housing.Tiers[1].name .. " for "
					.. Num.Short(math.floor(Housing.Tiers[1].capacity * (snap.mods.capacityMult or 1)))
					.. " more chickens."
				r.caption.Text = "BUY HOUSE"
			else
				r.row.Title.Text = string.format("House %d: %s (Tier %d)", slot, tier.name, h.tier)
				local lines = {
					string.format("Chickens %s / %s", Num.Short(h.occupants), Num.Short(h.capacity)),
					string.format("Eggs stored %s / %s", Num.Short(h.eggs), Num.Short(h.storage)),
				}
				if nextTier then
					local nextCap = math.floor(nextTier.capacity * (snap.mods.capacityMult or 1))
					table.insert(lines, "Next: " .. nextTier.name .. " holds " .. Num.Short(nextCap) .. " chickens")
					if snap.egg < nextTier.unlockEgg then
						table.insert(lines, "Unlocks on the " .. Eggs.List[nextTier.unlockEgg].name)
					end
				else
					table.insert(lines, "Top tier reached!")
				end
				r.row.Detail.Text = table.concat(lines, "\n")
				r.caption.Text = if nextTier then "UPGRADE" else "MAX"
			end
			r.btn:Refresh(snap)
		end
		summary.Text = string.format("Chickens %s / %s  •  More houses = more chickens and more egg storage.", Num.Short(snap.population), Num.Short(snap.capacity))
	end

	function page.Focus(slot: number?)
		local r = slot and rows[slot]
		if r then
			Util.Pop(r.row.Frame, 0.06)
			scroll.CanvasPosition = Vector2.new(0, math.max(0, r.row.Frame.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y - 8))
		end
	end

	return page
end

return Page
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[--!strict
-- Quests: today's list (snapshot.quests.list) with text and reward from Data/Rewards QuestPool,
-- live progress bars, Claim buttons (claimQuest), claimed state and the reset countdown.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared:WaitForChild("Data"):WaitForChild("Rewards"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Num = require(UI.Num)
local ProgressBar = require(UI.ProgressBar)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local M = {
	Name = "Quests",
	Title = "Quests",
	Icon = "quest",
	Color = Theme.Color.Teal,
}

local byId: { [string]: Rewards.Quest } = {}
for _, q in Rewards.QuestPool do
	byId[q.id] = q
end

function M.Build(host: any, panel: any)
	local scroll = Util.Scroll(panel.Body)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	local timer = Common.Heading(scroll, "", 0, Theme.Color.TextDark)
	local rows: { any } = {}
	local shownDay = -1
	local resetsAt = 0

	local function rebuild(snap: any)
		for _, r in rows do
			r.row.Frame:Destroy()
		end
		rows = {}
		for i, q in snap.quests.list do
			local def = byId[q.id]
			local id = q.id
			local row = Card.Row({
				icon = Common.RewardIcon(def and def.reward),
				title = if def then def.text else q.id,
				detail = "Reward: " .. Common.RewardText(def and def.reward),
				minHeight = 130,
				order = i,
				parent = scroll,
			})
			local bar = ProgressBar.new({ size = UDim2.new(1, 0, 0, 26), color = Theme.Color.Teal, order = 3, parent = row.Title.Parent })
			local btn = PurchaseButton.new({
				host = host,
				currency = "free",
				verb = "CLAIM",
				size = UDim2.new(1, 0, 0, 60),
				position = UDim2.fromScale(0, 0.5),
				anchor = Vector2.new(0, 0.5),
				parent = row.Action,
				successSound = "claim",
				quote = function(s)
					for _, cur in s.quests.list do
						if cur.id == id then
							if cur.claimed then
								return nil, "claimed"
							elseif cur.progress < cur.target then
								return nil, "not_ready"
							end
							return 0, "ok"
						end
					end
					return nil, "invalid"
				end,
				send = function()
					return host.Store.Request({ type = "claimQuest", id = id })
				end,
			})
			table.insert(rows, { id = id, row = row, bar = bar, btn = btn })
		end
	end

	local inst = {}
	function inst.Refresh(snap: any)
		if shownDay ~= snap.quests.day or #rows ~= #snap.quests.list then
			shownDay = snap.quests.day
			rebuild(snap)
		end
		resetsAt = snap.serverNow + snap.daily.resetsIn
		for _, r in rows do
			for _, q in snap.quests.list do
				if q.id == r.id then
					local frac = q.progress / math.max(1, q.target)
					local caption = if q.id:match("^play_")
						then string.format("%s / %s", Num.Duration(q.progress), Num.Duration(q.target))
						else string.format("%s / %s", Num.Short(q.progress), Num.Short(q.target))
					r.bar:Set(frac, if q.claimed then "Claimed!" else caption)
					r.bar:SetColor(if q.claimed then Theme.Color.GreenDark elseif frac >= 1 then Theme.Color.Gold else Theme.Color.Teal)
				end
			end
			r.btn:Refresh(snap)
		end
	end
	function inst.Tick(now: number)
		timer.Text = "New quests in " .. Common.Countdown(resetsAt - now)
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--!strict
-- Settings: music, sfx, effects, autoSpawn, confirmSpend toggles; flock low/normal/high;
-- notation short/scientific. Each change is a setSetting request; the switches always show the
-- server-confirmed value from the latest snapshot (a rejected change snaps back).

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Button = require(UI.Button)
local Icon = require(UI.Icon)

local M = {
	Name = "Settings",
	Title = "Settings",
	Icon = "settings",
	Color = Theme.Color.GrayDark,
}

type Choice = { id: string, title: string, detail: string, icon: string, options: { { value: any, label: string } } }

local CHOICES: { Choice } = {
	{ id = "music", title = "Music", detail = "Background music", icon = "music", options = { { value = true, label = "ON" }, { value = false, label = "OFF" } } },
	{ id = "sfx", title = "Sound Effects", detail = "Clicks, coins and cheers", icon = "music", options = { { value = true, label = "ON" }, { value = false, label = "OFF" } } },
	{ id = "effects", title = "Effects", detail = "Popups and particles", icon = "shine", options = { { value = true, label = "ON" }, { value = false, label = "OFF" } } },
	{ id = "autoSpawn", title = "Auto Spawn", detail = "Spawn chickens automatically (after the tutorial)", icon = "auto", options = { { value = true, label = "ON" }, { value = false, label = "OFF" } } },
	{ id = "confirmSpend", title = "Confirm Gold Eggs", detail = "Ask before spending Gold Eggs", icon = "gold", options = { { value = true, label = "ON" }, { value = false, label = "OFF" } } },
	{ id = "flock", title = "Visible Chickens", detail = "Lower is faster on older phones", icon = "chick", options = { { value = "low", label = "LOW" }, { value = "normal", label = "MID" }, { value = "high", label = "HIGH" } } },
	{ id = "notation", title = "Big Numbers", detail = "1.2M or 1.2e6", icon = "cash", options = { { value = "short", label = "1.2M" }, { value = "scientific", label = "1e6" } } },
}

function M.Build(host: any, panel: any)
	local scroll = Util.Scroll(panel.Body)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	local updaters: { (any) -> () } = {}
	local pending: { [string]: boolean } = {}

	for i, c in CHOICES do
		-- title on top, options underneath: fits narrow portrait phones
		local card = Card.new({ size = UDim2.new(1, -8, 0, 0), order = i, parent = scroll })
		card.AutomaticSize = Enum.AutomaticSize.Y
		Util.Pad(card, 10)
		Util.List(card, 6, false, Enum.HorizontalAlignment.Left)
		local head = Instance.new("Frame")
		head.BackgroundTransparency = 1
		head.Size = UDim2.new(1, 0, 0, 0)
		head.AutomaticSize = Enum.AutomaticSize.Y
		head.LayoutOrder = 1
		head.Parent = card
		local ic = Icon.new(c.icon, 44)
		ic.Parent = head
		local texts = Instance.new("Frame")
		texts.BackgroundTransparency = 1
		texts.Position = UDim2.fromOffset(54, 0)
		texts.Size = UDim2.new(1, -54, 0, 0)
		texts.AutomaticSize = Enum.AutomaticSize.Y
		texts.Parent = head
		Util.List(texts, 0, false, Enum.HorizontalAlignment.Left)
		Util.Text({
			text = c.title,
			size = UDim2.new(1, 0, 0, 0),
			textSize = Theme.Text.M,
			color = Theme.Color.TextDark,
			font = Theme.Font.Title,
			xAlign = Enum.TextXAlignment.Left,
			wrap = true,
			order = 1,
			parent = texts,
		})
		local detail = Util.Text({
			text = c.detail,
			size = UDim2.new(1, 0, 0, 0),
			textSize = Theme.Text.S,
			color = Theme.Color.TextMuted,
			xAlign = Enum.TextXAlignment.Left,
			wrap = true,
			order = 2,
			parent = texts,
		})
		local opts = Instance.new("Frame")
		opts.BackgroundTransparency = 1
		opts.Size = UDim2.new(1, 0, 0, 60)
		opts.LayoutOrder = 2
		opts.Parent = card
		Util.List(opts, 6, true, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		local row = { Action = opts, Detail = detail }
		local btns = {}
		for j, opt in c.options do
			local b = Button.new({
				text = opt.label,
				color = Theme.Color.Gray,
				size = UDim2.fromOffset(96, 60),
				textSize = Theme.Text.M,
				order = j,
				parent = row.Action,
				onClick = function()
					local snap = host.Store.Get()
					if not snap or pending[c.id] or snap.settings[c.id] == opt.value then
						return
					end
					pending[c.id] = true
					local action = if c.id == "autoSpawn"
						then { type = "setAutoSpawn", value = opt.value }
						else { type = "setSetting", id = c.id, value = opt.value }
					host:Request(action)
					pending[c.id] = nil
					local now = host.Store.Get()
					if now then
						for _, u in updaters do
							u(now)
						end
					end
				end,
			})
			btns[j] = b
		end
		table.insert(updaters, function(snap)
			local cur = snap.settings[c.id]
			for j, opt in c.options do
				local on = cur == opt.value
				btns[j]:SetColor(if on then (if opt.value == false then Theme.Color.Red else Theme.Color.Green) else Theme.Color.Gray)
				btns[j].Label.TextTransparency = if on then 0 else 0.35
			end
			if c.id == "autoSpawn" then
				row.Detail.Text = if snap.tutorial.done then c.detail else "Unlocks when you finish the tutorial."
			end
		end)
	end

	local inst = {}
	function inst.Refresh(snap: any)
		for _, u in updaters do
			u(snap)
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">Shipping</string>
              <string name="Source"><![CDATA[--!strict
-- Farm > Shipping: vehicle slots. Usable slots = snapshot.vehicleSlots (of Vehicles.MaxSlots);
-- the rest show as locked until the Fleet Permit upgrade. Each row: tier, capacity, trip time,
-- throughput, live status, and a Buy (buyVehicle) / Upgrade (upgradeVehicle, expect = tier) button.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Vehicles = require(Shared:WaitForChild("Data"):WaitForChild("Vehicles"))
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Num = require(UI.Num)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local Page = {}

local PHASE = { dock = "Loading at the dock", out = "Driving to market", back = "Coming back" }

function Page.Build(host: any, parent: Instance)
	local scroll = Util.Scroll(parent)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	local summary = Common.Note(scroll, "", 0)
	local rows = {}

	for slot = 1, Vehicles.MaxSlots do
		local row = Card.Row({ icon = "truck", title = "Vehicle " .. slot, minHeight = 116, order = slot, parent = scroll })
		local caption = Util.Text({
			text = "",
			size = UDim2.new(1, 0, 0, 24),
			textSize = Theme.Text.S,
			color = Theme.Color.TextDark,
			font = Theme.Font.Title,
			parent = row.Action,
		})
		local btn = PurchaseButton.new({
			host = host,
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromOffset(0, 28),
			parent = row.Action,
			quote = function(snap)
				local v = snap.vehicles[slot]
				if v.tier == 0 then
					return Common.Quote("buyVehicle", snap, slot)
				end
				return Common.Quote("upgradeVehicle", snap, slot)
			end,
			send = function(snap)
				local v = snap.vehicles[slot]
				if v.tier == 0 then
					return host.Store.Request({ type = "buyVehicle", slot = slot })
				end
				return host.Store.Request({ type = "upgradeVehicle", slot = slot, expect = v.tier })
			end,
			explain = function(code, snap)
				if code == "locked" and slot > snap.vehicleSlots then
					return "Buy the Fleet Permit upgrade to unlock this slot."
				elseif code == "locked" then
					local nextTier = Vehicles.Tiers[snap.vehicles[slot].tier + 1]
					if nextTier then
						return "Unlocks on the " .. Eggs.List[nextTier.unlockEgg].name .. "."
					end
				elseif code == "slot_locked" then
					return "Buy Vehicle " .. (slot - 1) .. " first."
				end
				return nil
			end,
		})
		rows[slot] = { row = row, caption = caption, btn = btn }
	end

	local page = { Frame = scroll }

	function page.Refresh(snap: any)
		for slot, r in rows do
			local v = snap.vehicles[slot]
			local tier = Vehicles.Tiers[v.tier]
			local nextTier = Vehicles.Tiers[v.tier + 1]
			local tripMult = snap.mods.tripMult or 1
			if slot > snap.vehicleSlots then
				r.row.Title.Text = "Vehicle " .. slot .. ": locked"
				r.row.Detail.Text = "Needs a Fleet Permit (Common upgrade) to unlock this parking bay."
				r.caption.Text = "LOCKED"
			elseif v.tier == 0 then
				local t1 = Vehicles.Tiers[1]
				r.row.Title.Text = "Vehicle " .. slot .. ": empty bay"
				r.row.Detail.Text = string.format("Buy a %s: %s eggs per trip.", t1.name, Num.Short(t1.capacity))
				r.caption.Text = "BUY VEHICLE"
			else
				local trip = v.trip
				r.row.Title.Text = string.format("Vehicle %d: %s (Tier %d)", slot, tier.name, v.tier)
				local lines = {
					string.format("%s eggs/trip  •  %.1fs trip  •  %s eggs/s", Num.Short(v.cap), trip, Num.Short(v.cap / math.max(trip, 0.1))),
					string.format("%s (%s aboard)", PHASE[v.phase] or v.phase, Num.Short(v.load)),
				}
				if nextTier then
					table.insert(lines, string.format("Next: %s, %s eggs in %.1fs", nextTier.name, Num.Short(nextTier.capacity), nextTier.trip * tripMult))
					if snap.egg < nextTier.unlockEgg then
						table.insert(lines, "Unlocks on the " .. Eggs.List[nextTier.unlockEgg].name)
					end
				else
					table.insert(lines, "Top tier reached!")
				end
				r.row.Detail.Text = table.concat(lines, "\n")
				r.caption.Text = if nextTier then "UPGRADE" else "MAX"
			end
			r.btn:Refresh(snap)
		end
		summary.Text = string.format(
			"Shipping %s eggs/s  •  Warehouse %s eggs  •  %d of %d bays open",
			Num.Short(snap.rates.ship),
			Num.Short(snap.warehouse),
			snap.vehicleSlots,
			Vehicles.MaxSlots
		)
	end

	function page.Focus(slot: number?)
		local r = slot and rows[slot]
		if r then
			Util.Pop(r.row.Frame, 0.06)
			scroll.CanvasPosition = Vector2.new(0, math.max(0, r.row.Frame.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y - 8))
		end
	end

	return page
end

return Page
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Shop: Featured / Passes / Gold Eggs / Cash tabs of product cards (Data/Products), a Codes
-- button (opens Codes; Back returns here). Robux items ask the server's Commerce RemoteFunction
-- and show loading until the result (or, for a real Roblox prompt, the Checkout event).
-- Gold Egg items use buyGoldItem, with a confirm dialog when settings.confirmSpend is on.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Data"):WaitForChild("Products"))
local Net = require(Shared:WaitForChild("Net"))
local Contract = require(Shared:WaitForChild("Contract"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Icon = require(UI.Icon)
local Button = require(UI.Button)
local Num = require(UI.Num)
local PurchaseButton = require(UI.PurchaseButton)

local M = {
	Name = "Shop",
	Title = "Shop",
	Icon = "shop",
	Color = Theme.Color.Pink,
	Tabs = {
		{ id = "Featured", label = Products.TabLabels.Featured, color = Theme.Color.Pink },
		{ id = "Passes", label = Products.TabLabels.Passes, color = Theme.Color.Purple },
		{ id = "Gold", label = Products.TabLabels.Gold, color = Theme.Color.GoldDark },
		{ id = "Cash", label = Products.TabLabels.Cash, color = Theme.Color.GreenDark },
	},
}

local CHECKOUT_TIMEOUT = 120

-- Asks the server to start a Robux checkout. Production replies "prompted" and later sends a
-- Checkout FarmEvent; the test checkout replies with the final result straight away.
function M.BuyRobux(host: any, productId: string): any
	local remote = Net.Get("Commerce") :: RemoteFunction
	local final: any = nil
	local off = host.Store.OnEvent("Checkout", function(data: any)
		if type(data) == "table" and data.productId == productId then
			final = data
		end
	end)
	local ok, res = pcall(function()
		return remote:InvokeServer({ productId = productId })
	end)
	if not ok or type(res) ~= "table" then
		off()
		return { ok = false, code = "failed", message = "The store couldn't open. Try again later." }
	end
	if res.code == "prompted" then
		local started = os.clock()
		while final == nil and os.clock() - started < CHECKOUT_TIMEOUT do
			task.wait(0.1)
		end
		off()
		if final == nil then
			return { ok = false, code = "cancelled", message = "Purchase window closed." }
		elseif final.status == "ok" then
			return { ok = true, code = "ok" }
		elseif final.status == "cancelled" then
			return { ok = false, code = "cancelled", message = "Purchase cancelled." }
		end
		return { ok = false, code = "failed", message = "The purchase didn't go through." }
	end
	off()
	if res.code == "cancelled" and not res.message then
		res.message = "Purchase cancelled."
	end
	if not res.ok and not res.message then
		res.message = Contract.Messages[res.code] or "The purchase didn't go through."
	end
	return res
end

local function inTab(p: Products.Product, tab: string): boolean
	if tab == "Featured" then
		return p.featured == true or p.tab == "Featured"
	end
	return p.tab == tab
end

function M.Build(host: any, panel: any)
	local body = panel.Body
	local bar = Instance.new("Frame")
	bar.BackgroundTransparency = 1
	bar.Size = UDim2.new(1, 0, 0, 64)
	bar.Parent = body
	local balance = Util.Text({
		text = "",
		size = UDim2.new(1, -190, 1, 0),
		textSize = Theme.Text.M,
		color = Theme.Color.TextDark,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		parent = bar,
	})
	Button.new({
		text = "Codes",
		icon = "code",
		color = Theme.Color.Purple,
		size = UDim2.fromOffset(170, 60),
		anchor = Vector2.new(1, 0),
		position = UDim2.new(1, 0, 0, 2),
		parent = bar,
		onClick = function()
			host:Open("Codes", nil, { returnTo = true })
		end,
	})

	local pages: { [string]: ScrollingFrame } = {}
	local buttons: { any } = {}

	for _, tab in Products.Tabs do
		local scroll = Util.Scroll(body, UDim2.new(1, 0, 1, -70), UDim2.fromOffset(0, 70))
		Util.Grid(scroll, Vector2.new(214, 268), 10)
		Util.Pad(scroll, 6)
		pages[tab] = scroll
		local order = 0
		for _, p in Products.List do
			if not inTab(p, tab) then
				continue
			end
			order += 1
			local card = Card.new({ order = order, parent = scroll })
			local ic = Icon.new(p.icon, 64)
			ic.AnchorPoint = Vector2.new(0.5, 0)
			ic.Position = UDim2.new(0.5, 0, 0, 8)
			ic.Parent = card
			if p.kind == "pass" then
				local tag = Util.Text({
					text = "PASS",
					size = UDim2.fromOffset(64, 26),
					position = UDim2.fromOffset(8, 8),
					textSize = Theme.Text.S,
					font = Theme.Font.Title,
					outline = true,
					parent = card,
				})
				tag.BackgroundTransparency = 0
				tag.BackgroundColor3 = Theme.Color.Purple
				Util.Corner(tag, 8)
			end
			Util.Text({
				text = p.name,
				size = UDim2.new(1, -16, 0, 30),
				position = UDim2.fromOffset(8, 76),
				textSize = Theme.Text.M,
				color = Theme.Color.TextDark,
				font = Theme.Font.Title,
				parent = card,
			})
			Util.Text({
				text = p.desc,
				size = UDim2.new(1, -16, 0, 74),
				position = UDim2.fromOffset(8, 106),
				textSize = Theme.Text.S,
				color = Theme.Color.TextMuted,
				yAlign = Enum.TextYAlignment.Top,
				parent = card,
			}).TextWrapped = true
			local isGold = p.kind == "gold"
			local btn = PurchaseButton.new({
				host = host,
				currency = if isGold then "gold" else "robux",
				size = UDim2.new(1, -16, 0, 60),
				anchor = Vector2.new(0.5, 1),
				position = UDim2.new(0.5, 0, 1, -10),
				parent = card,
				quote = function(snap)
					local owned = p.kind == "pass" and p.grant.pass ~= nil and snap.passes[p.grant.pass] == true
					if isGold then
						return p.goldPrice, nil, false
					end
					return p.robux, nil, owned
				end,
				send = function(snap)
					if isGold then
						return host.Store.Request({ type = "buyGoldItem", id = p.id })
					end
					return M.BuyRobux(host, p.id)
				end,
				confirm = if isGold
					then function(snap)
						if not snap.settings.confirmSpend then
							return nil
						end
						return {
							title = "Spend Gold Eggs?",
							icon = "gold",
							color = Theme.Color.GoldDark,
							text = string.format("Buy %s for %s Gold Eggs?\n%s", p.name, Num.Short(p.goldPrice or 0), p.desc),
							confirmText = "Buy",
						}
					end
					else nil,
				onResult = function(res)
					if res.ok and not isGold then
						host:Toast("Thank you! " .. p.name .. " is yours.", "good")
					elseif res.ok then
						host:Toast(p.name .. " added to your boosts!", "gold")
					end
				end,
			})
			table.insert(buttons, btn)
		end
	end

	local inst = {}
	local function show(tab: string?)
		for id, s in pages do
			s.Visible = id == (tab or "Featured")
		end
	end
	function inst.OnShow(tab: string?)
		show(tab)
	end
	function inst.OnTab(tab: string?)
		show(tab)
	end
	function inst.Refresh(snap: any)
		balance.Text = string.format("%s Gold Eggs  •  %s", Num.Short(snap.gold), Num.Cash(snap.cash))
		for _, b in buttons do
			b:Refresh(snap)
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Silos</string>
              <string name="Source"><![CDATA[--!strict
-- Farm > Silos: silos earn while you're away. Shows built / max, permanent silos from the pass,
-- offline minutes covered, and a Build button (buildSilo, expect = silos).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Silos = require(Shared:WaitForChild("Data"):WaitForChild("Silos"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Num = require(UI.Num)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local Page = {}

function Page.Build(host: any, parent: Instance)
	local scroll = Util.Scroll(parent)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	Common.Note(scroll, "Silos let you earn while you're away. Each silo covers some offline time; claim the cash when you come back.", 0)

	local row = Card.Row({ icon = "silo", title = "Silos", minHeight = 130, order = 1, parent = scroll })
	Util.Text({
		text = "BUILD SILO",
		size = UDim2.new(1, 0, 0, 24),
		textSize = Theme.Text.S,
		color = Theme.Color.TextDark,
		font = Theme.Font.Title,
		parent = row.Action,
	})
	local btn = PurchaseButton.new({
		host = host,
		size = UDim2.new(1, 0, 0, 60),
		position = UDim2.fromOffset(0, 28),
		parent = row.Action,
		quote = function(snap)
			return Common.Quote("silo", snap, nil)
		end,
		send = function(snap)
			return host.Store.Request({ type = "buildSilo", expect = snap.silos })
		end,
	})

	local perma = Card.Row({ icon = "crown", title = "Permanent Silos", minHeight = 100, order = 2, parent = scroll })
	local shopBtn = PurchaseButton.new({
		host = host,
		currency = "free",
		verb = "SHOP",
		size = UDim2.new(1, 0, 0, 60),
		position = UDim2.fromScale(0, 0.5),
		anchor = Vector2.new(0, 0.5),
		parent = perma.Action,
		successSound = "click",
		quote = function(snap)
			return 0, nil, snap.permanentSilos > 0
		end,
		send = function()
			host:Open("Shop", "Passes", { returnTo = true })
			return { ok = true, code = "ok" }
		end,
	})

	local page = { Frame = scroll }

	function page.Refresh(snap: any)
		local total = snap.silos + snap.permanentSilos
		local minutes = total * (snap.mods.siloMinutes or Silos.MinutesPerSilo)
		row.Title.Text = string.format("Silos: %d / %d built", snap.silos, Silos.Max)
		row.Detail.Text = string.format(
			"Covers %s of offline time (%d min per silo)\nEarns %d%% of your steady cash rate while away\nBuilt silos reset when you start a new farm",
			Num.Duration(minutes * 60),
			snap.mods.siloMinutes or Silos.MinutesPerSilo,
			math.floor(Silos.OfflineRate * 100)
		)
		btn:Refresh(snap)
		if snap.permanentSilos > 0 then
			perma.Detail.Text = string.format("You own %d permanent silos. They never reset.", snap.permanentSilos)
		else
			perma.Detail.Text = "The 10 Permanent Silos pass adds silos that survive every rebirth."
		end
		shopBtn:Refresh(snap)
	end

	return page
end

return Page
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Upgrades</string>
              <string name="Source"><![CDATA[--!strict
-- Upgrades: COMMON (cash, reset on rebirth) and EPIC (Gold Eggs, kept forever) from Data/Upgrades.
-- Each row shows level / max, the effect text and a PurchaseButton (buyCommon / buyEpic with
-- expect = the level shown).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Upgrades = require(Shared:WaitForChild("Data"):WaitForChild("Upgrades"))
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local PurchaseButton = require(UI.PurchaseButton)
local Num = require(UI.Num)
local Common = require(script.Parent.Common)

local M = {
	Name = "Upgrades",
	Title = "Upgrades",
	Icon = "upgrades",
	Color = Theme.Color.Green,
	Tabs = {
		{ id = "COMMON", label = "COMMON", color = Theme.Color.Green },
		{ id = "EPIC", label = "EPIC", color = Theme.Color.Purple },
	},
}

function M.Build(host: any, panel: any)
	local pages: { [string]: ScrollingFrame } = {}
	local rows: { { refresh: (any) -> () } } = {}

	local function page(id: string, list: { Upgrades.Upgrade }, epic: boolean)
		local scroll = Util.Scroll(panel.Body)
		Util.List(scroll, 8)
		Util.Pad(scroll, 4)
		Common.Note(
			scroll,
			if epic
				then "Epic upgrades cost Gold Eggs and are kept forever."
				else "Common upgrades cost Cash and reset when you start a new farm.",
			0
		)
		for i, u in list do
			local row = Card.Row({ icon = u.icon, title = u.name, detail = u.desc, order = i, parent = scroll })
			local btn = PurchaseButton.new({
				host = host,
				currency = if epic then "gold" else "cash",
				size = UDim2.new(1, 0, 0, 60),
				position = UDim2.fromScale(0, 0.5),
				anchor = Vector2.new(0, 0.5),
				parent = row.Action,
				quote = function(snap)
					return Common.Quote("upgrade", snap, u.id)
				end,
				send = function(snap)
					local levels = if epic then snap.epic else snap.common
					return host.Store.Request({
						type = if epic then "buyEpic" else "buyCommon",
						id = u.id,
						expect = levels[u.id] or 0,
					})
				end,
				-- Epic upgrades spend Gold Eggs: honour the "Confirm Gold Eggs" setting like the shops
				confirm = if epic
					then function(snap)
						if not snap.settings.confirmSpend then
							return nil
						end
						local price = Common.Quote("upgrade", snap, u.id)
						return {
							title = "Spend Gold Eggs?",
							icon = "gold",
							color = Theme.Color.GoldDark,
							text = string.format("Upgrade %s for %s Gold Eggs?", u.name, Num.Short(price or 0)),
							confirmText = "Upgrade",
						}
					end
					else nil,
			})
			table.insert(rows, {
				refresh = function(snap)
					local levels = if epic then snap.epic else snap.common
					local lvl = levels[u.id] or 0
					row.Title.Text = string.format("%s  Lv %d/%d", u.name, lvl, u.max)
					if snap.egg < u.unlockEgg then
						row.Detail.Text = u.desc .. "\nUnlocks on the " .. Eggs.List[u.unlockEgg].name .. "."
					else
						row.Detail.Text = u.desc
					end
					btn:Refresh(snap)
				end,
			})
		end
		pages[id] = scroll
	end
	page("COMMON", Upgrades.Common, false)
	page("EPIC", Upgrades.Epic, true)

	local inst = {}
	local function show(tab: string?)
		for id, p in pages do
			p.Visible = id == (tab or "COMMON")
		end
	end
	function inst.OnShow(tab: string?)
		show(tab)
	end
	function inst.OnTab(tab: string?)
		show(tab)
	end
	function inst.Refresh(snap: any)
		for _, r in rows do
			r.refresh(snap)
		end
	end
	return inst
end

return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">Workers</string>
              <string name="Source"><![CDATA[--!strict
-- Farm > Workers: worker slots (snapshot.workerSlots usable of Workers.MaxSlots). Each row shows
-- the worker tier, carry and cycle time, and a Hire (hireWorker) / Upgrade (upgradeWorker,
-- expect = tier) button. Locked slots explain the Bunkhouse upgrade / +2 Worker Slots pass.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Workers = require(Shared:WaitForChild("Data"):WaitForChild("Workers"))
local Eggs = require(Shared:WaitForChild("Data"):WaitForChild("Eggs"))

local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Util = require(UI.Util)
local Card = require(UI.Card)
local Num = require(UI.Num)
local PurchaseButton = require(UI.PurchaseButton)
local Common = require(script.Parent.Common)

local Page = {}

function Page.Build(host: any, parent: Instance)
	local scroll = Util.Scroll(parent)
	Util.List(scroll, 8)
	Util.Pad(scroll, 4)
	local summary = Common.Note(scroll, "", 0)
	local rows = {}

	for slot = 1, Workers.MaxSlots do
		local row = Card.Row({ icon = "worker", title = "Worker " .. slot, minHeight = 116, order = slot, parent = scroll })
		local caption = Util.Text({
			text = "",
			size = UDim2.new(1, 0, 0, 24),
			textSize = Theme.Text.S,
			color = Theme.Color.TextDark,
			font = Theme.Font.Title,
			parent = row.Action,
		})
		local btn = PurchaseButton.new({
			host = host,
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromOffset(0, 28),
			parent = row.Action,
			quote = function(snap)
				local w = snap.workers[slot]
				if w.tier == 0 then
					return Common.Quote("hireWorker", snap, slot)
				end
				return Common.Quote("upgradeWorker", snap, slot)
			end,
			send = function(snap)
				local w = snap.workers[slot]
				if w.tier == 0 then
					return host.Store.Request({ type = "hireWorker", slot = slot })
				end
				return host.Store.Request({ type = "upgradeWorker", slot = slot, expect = w.tier })
			end,
			explain = function(code, snap)
				if code == "locked" and slot > snap.workerSlots then
					return "Buy the Bunkhouse upgrade (or the +2 Worker Slots pass) to unlock this slot."
				elseif code == "locked" then
					local nextTier = Workers.Tiers[snap.workers[slot].tier + 1]
					if nextTier then
						return "Unlocks on the " .. Eggs.List[nextTier.unlockEgg].name .. "."
					end
				elseif code == "slot_locked" then
					return "Hire Worker " .. (slot - 1) .. " first."
				end
				return nil
			end,
		})
		rows[slot] = { row = row, caption = caption, btn = btn }
	end

	local page = { Frame = scroll }

	function page.Refresh(snap: any)
		local mult = snap.mods.workerMult or 1
		for slot, r in rows do
			local w = snap.workers[slot]
			local tier = Workers.Tiers[w.tier]
			local nextTier = Workers.Tiers[w.tier + 1]
			if slot > snap.workerSlots then
				r.row.Title.Text = "Worker " .. slot .. ": locked"
				r.row.Detail.Text = "Unlock more worker slots with the Bunkhouse upgrade or the +2 Worker Slots pass."
				r.caption.Text = "LOCKED"
			elseif w.tier == 0 then
				local t1 = Workers.Tiers[1]
				r.row.Title.Text = "Worker " .. slot .. ": not hired"
				r.row.Detail.Text = string.format(
					"Hire a %s to carry %s eggs from your houses to the warehouse every %ds.",
					t1.name,
					Num.Short(math.floor(t1.carry * mult)),
					t1.cycle
				)
				r.caption.Text = "HIRE"
			else
				r.row.Title.Text = string.format("Worker %d: %s (Tier %d)", slot, tier.name, w.tier)
				local carry = math.floor(tier.carry * mult)
				local lines = {
					string.format("Carries %s eggs every %ds  •  %s eggs/s", Num.Short(carry), tier.cycle, Num.Short(carry / tier.cycle)),
					string.format("Holding %s eggs, working House %d", Num.Short(w.load), w.house),
				}
				if nextTier then
					table.insert(lines, string.format("Next: %s carries %s", nextTier.name, Num.Short(math.floor(nextTier.carry * mult))))
					if snap.egg < nextTier.unlockEgg then
						table.insert(lines, "Unlocks on the " .. Eggs.List[nextTier.unlockEgg].name)
					end
				else
					table.insert(lines, "Top tier reached!")
				end
				r.row.Detail.Text = table.concat(lines, "\n")
				r.caption.Text = if nextTier then "UPGRADE" else "MAX"
			end
			r.btn:Refresh(snap)
		end
		summary.Text = string.format(
			"Workers move %s eggs/s for you  •  %d of %d slots open",
			Num.Short(snap.rates.workers),
			snap.workerSlots,
			Workers.MaxSlots
		)
	end

	function page.Focus(slot: number?)
		local r = slot and rows[slot]
		if r then
			Util.Pop(r.row.Frame, 0.06)
		end
	end

	return page
end

return Page
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side view of the player's farm. Holds the latest server snapshot, lets UI and visuals
-- subscribe to changes and server events, and sends action requests.
--   Store.Get()                    latest FarmSnapshot (nil until the first one arrives)
--   Store.OnChanged(fn)            fn(snapshot) after every new snapshot; returns a disconnect fn
--   Store.OnEvent(name, fn)        fn(data) for FarmEvent `name` ("*" = every event: fn(name, data))
--   Store.Request(action)          yields; returns ActionResult. Adds `seq`; while a request of the
--                                  same key (type+slot+id) is in flight, a duplicate returns
--                                  { ok = false, code = "busy" } without contacting the server.
--   Store.IsBusy(key)              true while a request with that key is in flight
--   Store.Key(action)              the dedupe key for an action
--   Store.Now()                    estimated server time (snapshot clock + local elapsed)
-- Nothing in here is trusted by the server: it only names intents.

local Net = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Net"))

local Store = {}

local snapshot: any = nil
local receivedAt = 0
local changed: { (any) -> () } = {}
local eventFns: { [string]: { (...any) -> () } } = {}
local busy: { [string]: boolean } = {}
local seq = 0

local function remove(list: { any }, fn: any)
	local i = table.find(list, fn)
	if i then
		table.remove(list, i)
	end
end

function Store.Get(): any
	return snapshot
end

function Store.Now(): number
	if not snapshot then
		return os.time()
	end
	return snapshot.serverNow + (os.clock() - receivedAt)
end

function Store.OnChanged(fn: (any) -> ()): () -> ()
	table.insert(changed, fn)
	if snapshot then
		task.spawn(fn, snapshot)
	end
	return function()
		remove(changed, fn)
	end
end

function Store.OnEvent(name: string, fn: (...any) -> ()): () -> ()
	eventFns[name] = eventFns[name] or {}
	table.insert(eventFns[name], fn)
	return function()
		remove(eventFns[name], fn)
	end
end

function Store.Key(action: any): string
	return string.format("%s|%s|%s", tostring(action.type), tostring(action.slot or ""), tostring(action.id or action.index or ""))
end

function Store.IsBusy(key: string): boolean
	return busy[key] == true
end

function Store.Request(action: any): any
	local key = Store.Key(action)
	if busy[key] then
		return { ok = false, code = "busy" }
	end
	busy[key] = true
	seq += 1
	action.seq = seq
	local remote = Net.Get("Action") :: RemoteFunction
	local ok, res = pcall(function()
		return remote:InvokeServer(action)
	end)
	busy[key] = nil
	if not ok or type(res) ~= "table" then
		return { ok = false, code = "error", message = "Couldn't reach the server. Try again." }
	end
	return res
end

function Store.Start()
	local snapRemote = Net.Get("Snapshot") :: RemoteEvent
	local eventRemote = Net.Get("FarmEvent") :: RemoteEvent
	snapRemote.OnClientEvent:Connect(function(snap)
		snapshot = snap
		receivedAt = os.clock()
		for _, fn in table.clone(changed) do
			task.spawn(fn, snap)
		end
	end)
	eventRemote.OnClientEvent:Connect(function(name: string, data: any)
		for _, fn: any in table.clone(eventFns[name] or {}) do
			task.spawn(fn, data)
		end
		for _, fn: any in table.clone(eventFns["*"] or {}) do
			task.spawn(fn, name, data)
		end
	end)
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="102">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">Button</string>
              <string name="Source"><![CDATA[--!strict
-- Chunky game button: rounded, thick outline, top-light gradient, darker "lip" underneath,
-- press squish. Works with touch and mouse (Activated). Minimum size is Theme.Size.Touch.

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Icon = require(script.Parent.Icon)

local Button = {}

-- Set by Controllers/Sound so every button clicks without the kit knowing about audio.
Button.ClickHook = nil :: (() -> ())?

export type Opts = {
	text: string?,
	color: Color3?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	icon: string?,
	iconSize: number?,
	textSize: number?,
	textColor: Color3?,
	order: number?,
	parent: Instance?,
	name: string?,
	onClick: (() -> ())?,
	radius: number?,
	z: number?,
}

export type Handle = {
	Instance: TextButton,
	Label: TextLabel,
	Icon: Frame?,
	SetText: (Handle, string) -> (),
	SetColor: (Handle, Color3) -> (),
	SetEnabled: (Handle, boolean) -> (),
	SetVisible: (Handle, boolean) -> (),
	Enabled: boolean,
	Color: Color3,
}

function Button.new(o: Opts): Handle
	local color = o.color or Theme.Color.Green
	local b = Instance.new("TextButton")
	b.Name = o.name or "Button"
	b.AutoButtonColor = false
	b.Text = ""
	b.Active = true
	b.BackgroundColor3 = color
	b.Size = o.size or UDim2.fromOffset(160, Theme.Size.Touch)
	b.Position = o.position or UDim2.new()
	b.AnchorPoint = o.anchor or Vector2.zero
	b.LayoutOrder = o.order or 0
	b.ZIndex = o.z or 1
	Util.Corner(b, o.radius)
	Util.Stroke(b, Theme.Size.Stroke, Theme.Color.Ink, true)
	Util.Gradient(b, Color3.new(1, 1, 1), Color3.fromRGB(210, 210, 210))
	local min = Instance.new("UISizeConstraint")
	min.MinSize = Vector2.new(Theme.Size.Touch * 0.75, Theme.Size.Touch * 0.75)
	min.Parent = b

	-- darker lip along the bottom edge
	local lip = Instance.new("Frame")
	lip.Name = "Lip"
	lip.BorderSizePixel = 0
	lip.BackgroundColor3 = Theme.Darken(color, 0.3)
	lip.AnchorPoint = Vector2.new(0.5, 1)
	lip.Position = UDim2.new(0.5, 0, 1, 0)
	lip.Size = UDim2.new(1, 0, 0, 6)
	lip.ZIndex = b.ZIndex
	Util.Corner(lip, o.radius)
	lip.Parent = b

	local iconFrame: Frame? = nil
	local hasText = o.text ~= nil and o.text ~= ""
	if o.icon then
		local isz = o.iconSize or 34
		local ic = Icon.new(o.icon, isz)
		ic.AnchorPoint = Vector2.new(0, 0.5)
		ic.Position = if hasText then UDim2.new(0, 8, 0.5, -2) else UDim2.new(0.5, -isz / 2, 0.5, -2)
		ic.ZIndex = b.ZIndex + 1
		ic.Parent = b
		iconFrame = ic
	end
	local textLeft = if o.icon and hasText then (o.iconSize or 34) + 12 else 8
	local label = Util.Text({
		text = o.text or "",
		size = UDim2.new(1, -(textLeft + 8), 1, -10),
		position = UDim2.new(0, textLeft, 0, 2),
		textSize = o.textSize or Theme.Text.L,
		color = o.textColor or Theme.Color.Text,
		font = Theme.Font.Title,
		outline = true,
		z = b.ZIndex + 2,
		parent = b,
	})
	label.Name = "Label"
	label.Visible = hasText

	local h: any = {
		Instance = b,
		Label = label,
		Icon = iconFrame,
		Enabled = true,
		Color = color,
	}

	function h.SetText(self: Handle, text: string)
		self.Label.Text = text
		self.Label.Visible = text ~= ""
	end

	function h.SetColor(self: Handle, c: Color3)
		self.Color = c
		self.Instance.BackgroundColor3 = c
		lip.BackgroundColor3 = Theme.Darken(c, 0.3)
	end

	function h.SetEnabled(self: Handle, on: boolean)
		self.Enabled = on
		self.Instance.Active = true -- still sinks input; taps on a disabled button do nothing
		self.Instance.BackgroundTransparency = if on then 0 else 0.15
	end

	function h.SetVisible(self: Handle, on: boolean)
		self.Instance.Visible = on
	end

	local scaleObj = Instance.new("UIScale")
	scaleObj.Parent = b
	b.MouseButton1Down:Connect(function()
		Util.Tween(scaleObj, Theme.Tween.Fast, { Scale = 0.93 })
	end)
	local function release()
		Util.Tween(scaleObj, Theme.Tween.Pop, { Scale = 1 })
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
	local fn = o.onClick
	b.Activated:Connect(function()
		local hook = Button.ClickHook
		if hook then
			hook()
		end
		if fn then
			fn()
		end
	end)
	b.Parent = o.parent
	return h :: Handle
end

return Button
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">Card</string>
              <string name="Source"><![CDATA[--!strict
-- Card: rounded white tile with an outline and soft gradient, the building block of every grid
-- and list. Card.Row builds a full-width list row (icon | title + detail | action area).

local Theme = require(script.Parent.Theme)
local Util = require(script.Parent.Util)
local Icon = require(script.Parent.Icon)

local Card = {}

function Card.new(o: { size: UDim2?, color: Color3?, order: number?, parent: Instance?, name: string? }): Frame
	local f = Instance.new("Frame")
	f.Name = o.name or "Card"
	f.BackgroundColor3 = o.color or Theme.Color.Card
	f.Size = o.size or UDim2.fromOffset(200, 220)
	f.LayoutOrder = o.order or 0
	Util.Corner(f, 16)
	Util.Stroke(f, 3, Theme.Color.Ink, true)
	Util.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(232, 226, 214))
	f.Parent = o.parent
	return f
end

export type Row = {
	Frame: Frame,
	Icon: Frame,
	Title: TextLabel,
	Detail: TextLabel,
	Action: Frame, -- right-hand area for buttons (width set by actionWidth)
}

-- A full-width row with automatic height: icon on the left, wrapped text in the middle,
-- an action area on the right. Long text grows the row instead of being cut off.
function Card.Row(o: {
	icon: string,
	title: string,
	detail: string?,
	actionWidth: number?,
	minHeight: number?,
	color: Color3?,
	order: number?,
	parent: Instance?,
}): Row
	local aw = o.actionWidth or 170
	local f = Card.new({ size = UDim2.new(1, -8, 0, o.minHeight or 96), color = o.color, order = o.order, parent = nil })
	f.AutomaticSize = Enum.AutomaticSize.Y
	Util.Pad(f, 10)
	local min = Instance.new("UISizeConstraint")
	min.MinSize = Vector2.new(0, o.minHeight or 96)
	min.Parent = f

	local ic = Icon.new(o.icon, 56)
	ic.Position = UDim2.fromOffset(0, 8)
	ic.Parent = f

	local mid = Instance.new("Frame")
	mid.Name = "Text"
	mid.BackgroundTransparency = 1
	mid.Position = UDim2.fromOffset(66, 0)
	mid.Size = UDim2.new(1, -(66 + aw + 8), 0, 0)
	mid.AutomaticSize = Enum.AutomaticSize.Y
	Util.List(mid, 2, false, Enum.HorizontalAlignment.Left)
	mid.Parent = f

	local title = Util.Text({
		text = o.title,
		size = UDim2.new(1, 0, 0, 0),
		textSize = Theme.Text.M,
		color = Theme.Color.TextDark,
		font = Theme.Font.Title,
		xAlign = Enum.TextXAlignment.Left,
		wrap = true,
		order = 1,
		parent = mid,
	})
	local detail = Util.Text({
		text = o.detail or "",
		size = UDim2.new(1, 0, 0, 0),
		textSize = Theme.Text.S,
		color = Theme.Color.TextMuted,
		xAlign = Enum.TextXAlignment.Left,
		wrap = true,
		order = 2,
		parent = mid,
	})

	local action = Instance.new("Frame")
	action.Name = "Action"
	action.BackgroundTransparency = 1
	action.AnchorPoint = Vector2.new(1, 0)
	action.Position = UDim2.new(1, 0, 0, 0)
	action.Size = UDim2.new(0, aw, 0, (o.minHeight or 96) - 20)
	action.Parent = f

	f.Parent = o.parent
	return { Frame = f, Icon = ic, Title = title, Detail = detail, Action = action }
end

return Card
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Icon</string>
              <string name="Source"><![CDATA[--!strict
-- Original icons drawn natively (Frames + UICorner + UIGradient + UIStroke + glyph labels).
-- No uploaded images. Icon.new(kind, size) returns a transparent Frame of `size` logical px;
-- every shape inside is positioned in scale units so the icon resizes cleanly.

local Theme = require(script.Parent.Theme)

local Icon = {}

local rgb = Color3.fromRGB
local INK = Theme.Color.Ink

type Shape = {
	c: Color3, -- colour
	x: number, -- centre x (0..1)
	y: number, -- centre y (0..1)
	w: number,
	h: number,
	r: number?, -- corner radius as scale (0.5 = round), default 0.2
	rot: number?,
	stroke: boolean?, -- default true
	z: number?,
	glyph: string?, -- text drawn instead of a filled shape
	tc: Color3?, -- glyph colour
	ring: boolean?, -- transparent fill with a thick outline (handles, rings)
	grad: boolean?, -- default true
}

local function S(c: Color3, x: number, y: number, w: number, h: number, extra: { [string]: any }?): Shape
	local s: any = { c = c, x = x, y = y, w = w, h = h }
	if extra then
		for k, v in extra do
			s[k] = v
		end
	end
	return s
end

local function egg(c: Color3, x: number?, y: number?, sc: number?): Shape
	local k = sc or 1
	return S(c, x or 0.5, y or 0.52, 0.66 * k, 0.86 * k, { r = 0.5 })
end

local CASH = rgb(98, 200, 80)
local GOLD = rgb(255, 200, 40)
local CREAM = rgb(255, 244, 220)
local BROWN = rgb(150, 98, 58)
local RED = rgb(220, 70, 56)
local BLUE = rgb(70, 150, 235)
local YELLOW = rgb(255, 214, 60)
local ORANGE = rgb(255, 140, 40)
local PURPLE = rgb(168, 96, 236)
local GREEN = rgb(80, 190, 90)
local GRAY = rgb(160, 160, 170)
local WHITE = rgb(255, 255, 255)

local DEFS: { [string]: { Shape } } = {
	egg = { egg(CREAM) },
	gold = { egg(GOLD), S(WHITE, 0.38, 0.34, 0.14, 0.2, { r = 0.5, stroke = false, grad = false, z = 3 }) },
	star = { S(GOLD, 0.5, 0.5, 1, 1, { glyph = "★", tc = GOLD }) },
	cash = {
		S(CASH, 0.5, 0.5, 0.92, 0.62, { r = 0.15, rot = -10 }),
		S(CASH, 0.5, 0.5, 0.5, 0.5, { glyph = "$", tc = WHITE, z = 3, rot = -10 }),
	},
	chick = {
		S(YELLOW, 0.5, 0.56, 0.78, 0.78, { r = 0.5 }),
		S(ORANGE, 0.82, 0.55, 0.2, 0.2, { rot = 45, r = 0.15, z = 1 }),
		S(INK, 0.62, 0.44, 0.1, 0.1, { r = 0.5, stroke = false, grad = false, z = 3 }),
		S(rgb(255, 180, 40), 0.36, 0.64, 0.34, 0.2, { r = 0.5, z = 3 }),
	},
	house = {
		S(RED, 0.5, 0.42, 0.62, 0.62, { rot = 45, r = 0.08, z = 1 }),
		S(rgb(240, 220, 180), 0.5, 0.7, 0.72, 0.5, { r = 0.06, z = 2 }),
		S(BROWN, 0.5, 0.78, 0.22, 0.34, { r = 0.1, z = 3 }),
	},
	truck = {
		S(BLUE, 0.38, 0.48, 0.62, 0.46, { r = 0.1 }),
		S(RED, 0.8, 0.56, 0.3, 0.32, { r = 0.15 }),
		S(rgb(190, 230, 255), 0.84, 0.5, 0.14, 0.12, { r = 0.2, stroke = false, z = 3 }),
