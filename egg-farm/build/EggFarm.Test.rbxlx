		S(RED, 0.5, 0.68, 0.14, 0.14, { r = 0.5, z = 3 }),
	},
	feed = {
		S(rgb(222, 190, 130), 0.5, 0.58, 0.66, 0.74, { r = 0.3 }),
		S(rgb(190, 150, 90), 0.5, 0.22, 0.4, 0.14, { r = 0.4, z = 2 }),
		S(YELLOW, 0.4, 0.62, 0.12, 0.12, { r = 0.5, z = 3 }),
		S(YELLOW, 0.6, 0.56, 0.12, 0.12, { r = 0.5, z = 3 }),
