		S(WHITE, 0.4, 0.56, 0.1, 0.14, { r = 0.5, stroke = false, grad = false, z = 3 }),
	},
	shine = {
		S(GOLD, 0.5, 0.5, 0.2, 0.9, { r = 0.5 }),
