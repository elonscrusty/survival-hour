      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[-- Loaded 3D models (see server AssetLoader and Models.luau). The server puts each
-- model in ReplicatedStorage.PetRaceModels as a Model whose pivot is the bottom
-- centre, so both server and client can clone them. Everything that uses a model
-- has a part-built fallback, so the game works before the models are uploaded.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Assets = {}

local function folder(): Instance?
	return ReplicatedStorage:FindFirstChild("PetRaceModels")
end

function Assets.Has(name: string): boolean
	local f = folder()
	return f ~= nil and f:FindFirstChild(name) ~= nil
end

-- A fresh copy (pivot at the origin, unparented), or nil if it isn't loaded.
function Assets.Clone(name: string): Model?
	local f = folder()
	local src = f and f:FindFirstChild(name)
	if not src or not src:IsA("Model") then
		return nil
	end
	return src:Clone()
end

-- Clones, scales and places a model with its pivot at cf. Returns nil if not loaded.
function Assets.Place(name: string, cf: CFrame, parent: Instance, scale: number?): Model?
	local m = Assets.Clone(name)
	if not m then
		return nil
	end
	if scale and scale ~= 1 then
		m:ScaleTo(scale)
	end
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

return Assets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- All tuning numbers for Pet Race League live here.
local Config = {}

Config.StartCoins = 250
Config.ProfileVersion = 1

Config.Slots = {
	Base = 24, -- pet storage for everyone
	BonusPass = 36, -- extra slots from the "Big Barn" game pass
}

-- Pet stats: Speed, Jump and Stamina each level from 1 to MaxLevel.
Config.Stats = {
	Names = { "Speed", "Jump", "Stamina" },
	MaxLevel = 50,
	XpBase = 20, -- xp needed for level 1 -> 2
	XpGrowth = 1.09, -- each level needs this much more
}

-- Riding numbers. Rarity adds a small bonus on top (see Pets.Rarities), so training
-- matters far more than luck.
Config.Ride = {
	OnFootSpeed = 16,
	OnFootJump = 42,
	BaseSpeed = 20,
	SpeedPerLevel = 0.5,
	BaseJump = 46,
	JumpPerLevel = 0.5,
	DashBoost = 1.6, -- WalkSpeed multiplier while dashing
	DashTime = 1.2,
	DashChargesBase = 1,
	DashChargesEvery = 15, -- +1 charge per this many Stamina levels
	DashChargesMax = 4,
	DashRechargeBase = 6,
	DashRechargePerLevel = 0.06,
	DashRechargeMin = 3,
	SizeBase = 1,
	SizePerLevel = 0.01, -- pets grow as they level (cosmetic only)
}

Config.Training = {
	GateXp = 5, -- per gate passed in order
	GateMinGap = 0.5, -- seconds between gates (anti-spam)
	LapBonusXp = 15,
	PadXp = 3, -- treadmill xp per tick
	PadTick = 1.5,
}

Config.Hatch = {
	PityEvery = 10, -- every 10th hatch of an egg is Rare or better
	RarePlus = 3, -- rarity rank that counts as "Rare or better"
}

Config.Race = {
	QueueTime = 20, -- seconds the portal waits for more racers
	MinPlayers = 1, -- solo races are allowed (race the medal times)
	MaxPlayers = 8,
	Countdown = 3,
	TimeLimit = 150,
	ResultsTime = 6,
	FallDepth = 30, -- studs below the track that count as a fall
	FallPenalty = 1.5, -- seconds of freeze after respawning at a checkpoint
	BoostMult = 1.5, -- speed on boost pads
	MudMult = 0.6, -- speed in mud
	HurryTime = 30, -- after the first finisher, everyone else has this long
	PlaceCoins = { 120, 90, 70, 55, 45, 40, 35, 30 },
	FinishCoins = 25, -- for finishing at all
	DnfCoins = 10,
	MedalCoins = { Gold = 60, Silver = 35, Bronze = 15 },
	-- Trophies only go up. Multiplayer: by place, scaled by how many raced.
	PlaceTrophies = { 12, 9, 7, 5, 4, 3, 2, 2 },
	MedalTrophies = { Gold = 3, Silver = 2, Bronze = 1 },
	SoloTrophyCap = 3, -- solo races give medal trophies only
	-- Anti-cheat. Over the whole race nobody can average more than walk speed times
	-- SustainMult (boost pads and dashes included); between two checkpoints nobody can
	-- beat a full dash on a boost pad. Both allow BurstSlack studs of wiggle room.
	SustainMult = 1.45,
	BurstSlack = 8,
	-- Medal targets: average speeds (studs/s) needed over the whole track.
	MedalSpeeds = { Gold = 34, Silver = 27, Bronze = 20 },
}

Config.Leagues = {
	{ Name = "Bronze", Min = 0, Color = { 205, 127, 50 } },
	{ Name = "Silver", Min = 100, Color = { 192, 192, 200 } },
	{ Name = "Gold", Min = 300, Color = { 255, 205, 60 } },
	{ Name = "Diamond", Min = 700, Color = { 110, 220, 255 } },
	{ Name = "Champion", Min = 1500, Color = { 255, 90, 170 } },
}

Config.AutosaveEvery = 120

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[-- Cosmetics: trails and pet paint. Looks only, never stats.
-- Price = coins; Robux-only items have Price = nil and are unlocked by a product
-- (see Products.luau).
export type Cosmetic = {
	Id: string,
	Kind: string, -- "Trail" | "Paint"
	Name: string,
	Price: number?,
	Colors: { { number } },
}

local Cosmetics = {}

local list: { Cosmetic } = {
	{ Id = "TrailDust", Kind = "Trail", Name = "Dust Trail", Price = 150, Colors = { { 200, 180, 140 }, { 240, 230, 200 } } },
	{ Id = "TrailSky", Kind = "Trail", Name = "Sky Trail", Price = 600, Colors = { { 90, 170, 255 }, { 255, 255, 255 } } },
	{ Id = "TrailFire", Kind = "Trail", Name = "Fire Trail", Price = 1800, Colors = { { 255, 60, 0 }, { 255, 220, 40 } } },
	{ Id = "TrailRainbow", Kind = "Trail", Name = "Rainbow Trail", Price = nil, Colors = { { 255, 0, 0 }, { 255, 200, 0 }, { 0, 200, 80 }, { 0, 120, 255 }, { 170, 0, 255 } } },
	{ Id = "PaintGold", Kind = "Paint", Name = "Gold Paint", Price = 2500, Colors = { { 255, 200, 50 } } },
	{ Id = "PaintShadow", Kind = "Paint", Name = "Shadow Paint", Price = 1200, Colors = { { 40, 40, 55 } } },
	{ Id = "PaintGalaxy", Kind = "Paint", Name = "Galaxy Paint", Price = nil, Colors = { { 80, 40, 160 } } },
}

Cosmetics.List = list
Cosmetics.ById = {} :: { [string]: Cosmetic }
for _, c in list do
	Cosmetics.ById[c.Id] = c
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Eggs</string>
          <string name="Source"><![CDATA[-- Eggs are bought with Coins (earned by racing and training). Weights are relative.
export type Egg = {
	Id: string,
	Name: string,
	Price: number,
	Color: { number },
	Odds: { { Pet: string, W: number } },
}

local Eggs = {}

local list: { Egg } = {
	{
		Id = "Meadow",
		Name = "Meadow Egg",
		Price = 100,
		Color = { 140, 220, 110 },
		Odds = {
			{ Pet = "Pup", W = 30 },
			{ Pet = "Kitty", W = 30 },
			{ Pet = "Bunny", W = 25 },
			{ Pet = "Piggy", W = 8 },
			{ Pet = "Fox", W = 5 },
			{ Pet = "Panda", W = 2 },
		},
	},
	{
		Id = "Forest",
		Name = "Forest Egg",
		Price = 450,
		Color = { 60, 140, 70 },
		Odds = {
			{ Pet = "Fox", W = 30 },
			{ Pet = "Penguin", W = 26 },
			{ Pet = "Deer", W = 20 },
			{ Pet = "Wolf", W = 15 },
			{ Pet = "Tiger", W = 7 },
			{ Pet = "Unicorn", W = 2 },
		},
	},
	{
		Id = "Sky",
		Name = "Sky Egg",
		Price = 1500,
		Color = { 120, 190, 255 },
		Odds = {
			{ Pet = "Wolf", W = 30 },
			{ Pet = "Tiger", W = 28 },
			{ Pet = "Unicorn", W = 24 },
			{ Pet = "Griffin", W = 10 },
			{ Pet = "Dragon", W = 6 },
			{ Pet = "Phoenix", W = 1.5 },
			{ Pet = "Cosmic Cat", W = 0.5 },
		},
	},
}

Eggs.List = list
Eggs.ById = {} :: { [string]: Egg }
for _, e in list do
	Eggs.ById[e.Id] = e
end

return Eggs
]]></string>
