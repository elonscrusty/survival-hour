	["Fence"] = { Id = nil, Category = "Lobby", Size = { 12, 3.8, 0.6 }, Offset = { 0, -1.9, 0 } },
	["Flowers"] = { Id = nil, Category = "Lobby", Size = { 3.844, 1.537, 4.388 }, Offset = { -0.021, -0.768, 0.139 } },
	["LampPost"] = { Id = nil, Category = "Lobby", Size = { 2, 11.1, 2 }, Offset = { 0, -5.55, 0 } },
	["Pedestal"] = { Id = nil, Category = "Lobby", Size = { 10.8, 2.8, 10.8 }, Offset = { 0, -1.4, 0 } },
	["Pet_Bunny"] = { Id = nil, Category = "Pets", Size = { 2.079, 4.509, 5.06 }, Offset = { 0, -2.235, -0.11 } },
	["Pet_CosmicCat"] = { Id = nil, Category = "Pets", Size = { 2.494, 4.682, 7.252 }, Offset = { 0, -2.317, -0.546 } },
	["Pet_Deer"] = { Id = nil, Category = "Pets", Size = { 2.079, 5.52, 5.08 }, Offset = { 0, -2.74, 0.3 } },
	["Pet_Dragon"] = { Id = nil, Category = "Pets", Size = { 7.31, 5.594, 10.7 }, Offset = { 0, -2.767, -1.43 } },
	["Pet_Fox"] = { Id = nil, Category = "Pets", Size = { 2.079, 3.842, 6.18 }, Offset = { 0, -1.901, -0.27 } },
	["Pet_Griffin"] = { Id = nil, Category = "Pets", Size = { 6.337, 5.169, 8.818 }, Offset = { 0, -2.558, -0.785 } },
	["Pet_Kitty"] = { Id = nil, Category = "Pets", Size = { 2.079, 3.642, 6.096 }, Offset = { 0, -1.801, -0.428 } },
	["Pet_Panda"] = { Id = nil, Category = "Pets", Size = { 2.91, 4.28, 5.456 }, Offset = { 0, -2.112, 0.412 } },
	["Pet_Penguin"] = { Id = nil, Category = "Pets", Size = { 3.104, 3.752, 4.113 }, Offset = { 0, -1.854, 0.472 } },
	["Pet_Phoenix"] = { Id = nil, Category = "Pets", Size = { 6.339, 5.432, 8.179 }, Offset = { 0, -2.69, -0.666 } },
	["Pet_Piggy"] = { Id = nil, Category = "Pets", Size = { 2.702, 3.675, 5.004 }, Offset = { 0, -1.811, 0.33 } },
	["Pet_Pup"] = { Id = nil, Category = "Pets", Size = { 2.343, 3.627, 4.884 }, Offset = { -0.028, -1.791, 0.358 } },
	["Pet_Tiger"] = { Id = nil, Category = "Pets", Size = { 2.746, 4.655, 8.299 }, Offset = { 0, -2.302, -0.69 } },
	["Pet_Unicorn"] = { Id = nil, Category = "Pets", Size = { 2.494, 6.157, 8.191 }, Offset = { 0, -3.054, -0.716 } },
	["Pet_Wolf"] = { Id = nil, Category = "Pets", Size = { 2.39, 4.508, 6.865 }, Offset = { 0, -2.231, -0.332 } },
	["Pillar"] = { Id = nil, Category = "Track", Size = { 4, 12, 18 }, Offset = { 0, -6, 0 } },
	["PortalArch"] = { Id = nil, Category = "Lobby", Size = { 34.4, 28.75, 4.4 }, Offset = { 0, -14.375, 0 } },
	["RaceArch"] = { Id = nil, Category = "Track", Size = { 30.283, 20, 2.4 }, Offset = { 0, -10, 0 } },
	["Rock"] = { Id = nil, Category = "Lobby", Size = { 4.686, 2.875, 3.357 }, Offset = { -0.268, -1.404, -0.086 } },
	["SpeedGate"] = { Id = nil, Category = "Lobby", Size = { 15.6, 15.4, 1.6 }, Offset = { 0, -7.7, 0 } },
	["Tree_Blossom"] = { Id = nil, Category = "Lobby", Size = { 8.836, 12.75, 6.5 }, Offset = { -0.176, -6.375, 0 } },
