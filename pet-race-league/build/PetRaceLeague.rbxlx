          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">HatchView</string>
              <string name="Source"><![CDATA[-- Hatch reveal: the egg wobbles, cracks with a flash, and the new pet spins in.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Pets = require(Shared.Pets)
local Eggs = require(Shared.Eggs)
local Net = require(Shared.Net)
local PetModel = require(Shared.PetModel)
local UI = require(script.Parent.Parent.UI)
local Notify = require(script.Parent.Notify)

local HatchView = {}

local overlay: Frame
local busy = false

local function show(species: string, eggId: string, uid: string)
	busy = true
	overlay:ClearAllChildren()
	overlay.Visible = true
	overlay.BackgroundTransparency = 0.35
	local egg = Eggs.ById[eggId]
	local s = Pets.ById[species]
	local rar = Pets.Rarities[s.Rarity]

	local eggFrame = UI.Frame({
		Size = UDim2.fromOffset(160, 210),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		BackgroundColor3 = if egg then UI.Rgb(egg.Color) else Color3.new(1, 1, 1),
		ZIndex = 41,
	}, overlay)
	UI.Corner(eggFrame, 80)
	UI.Stroke(eggFrame, Color3.fromRGB(255, 255, 255), 4)
	for i = 1, 3 do
		local t = TweenService:Create(eggFrame, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true), { Rotation = if i % 2 == 0 then -14 - i * 4 else 14 + i * 4 })
		t:Play()
		t.Completed:Wait()
		task.wait(0.25)
	end
	local flash = UI.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 45 }, overlay)
	eggFrame:Destroy()
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()

	local holder = UI.Frame({ Size = UDim2.fromOffset(320, 320), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), BackgroundTransparency = 1, ZIndex = 41 }, overlay)
	local rays = UI.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.Rgb(rar.Color), BackgroundTransparency = 0.6, ZIndex = 41 }, holder)
	UI.Corner(rays, 160)
	local built = PetModel.Build(species, 1)
	for _, d in built.Model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	UI.Viewport(holder, built.Model, { ZIndex = 42 })
	local spin = 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		spin += dt * 1.5
		built.Model:PivotTo(CFrame.Angles(0, spin, 0))
	end)
	UI.Text({ Text = s.Name, Size = UDim2.fromOffset(400, 56), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.42, 165), ZIndex = 42, TextStrokeTransparency = 0 }, overlay)
	UI.Text({ Text = string.upper(s.Rarity), Size = UDim2.fromOffset(300, 34), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.42, 220), TextColor3 = UI.Rgb(rar.Color), ZIndex = 42, TextStrokeTransparency = 0 }, overlay)

	local function close()
		conn:Disconnect()
		overlay.Visible = false
		overlay:ClearAllChildren()
		busy = false
	end
	local bar = UI.Frame({ Size = UDim2.fromOffset(420, 56), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), BackgroundTransparency = 1, ZIndex = 42 }, overlay)
	UI.Button({ Text = "Ride it!", Size = UDim2.new(1 / 3, -6, 1, 0), BackgroundColor3 = UI.Colors.Green, ZIndex = 43 }, bar, function()
		Net.Event("Equip"):FireServer(uid)
		close()
	end)
	UI.Button({ Text = "OK", Size = UDim2.new(1 / 3, -6, 1, 0), Position = UDim2.new(1 / 3, 3, 0, 0), ZIndex = 43 }, bar, close)
	UI.Button({ Text = "Again", Size = UDim2.new(1 / 3, -6, 1, 0), Position = UDim2.new(2 / 3, 6, 0, 0), BackgroundColor3 = UI.Colors.Gold, ZIndex = 43 }, bar, function()
		close()
		local ok, res = Net.Function("Hatch"):InvokeServer(eggId)
		if not ok then
			Notify.Show(res or "Can't hatch right now.", "Error")
		end
	end)
end

function HatchView.Start()
	overlay = UI.Frame({ Name = "Hatch", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Visible = false, ZIndex = 40 }, UI.Screen())
	local queue = {}
	Net.Event("Hatched").OnClientEvent:Connect(function(species, eggId, uid)
		table.insert(queue, { species, eggId, uid })
		if busy then
			return
		end
		while #queue > 0 do
			local q = table.remove(queue, 1)
			show(q[1], q[2], q[3])
			while busy do
				task.wait(0.1)
			end
		end
	end)
end

return HatchView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-on HUD: coins, trophies, league, and the main buttons (Pets, Shop,
-- Ride/Walk, Dash). Keyboard: Shift or Q = dash, R = ride/walk.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local RaceRules = require(Shared.Logic.RaceRules)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)

local Hud = {}

local player = Players.LocalPlayer
Hud.Buttons = {} :: { [string]: TextButton }
local openers: { [string]: () -> () } = {}

-- Other controllers register their menus here so the buttons can open them.
function Hud.SetOpener(name: string, fn: () -> ())
	openers[name] = fn
end

local function stat(parent: Instance, order: number, icon: string, color: Color3): TextLabel
	local f = UI.Frame({ Size = UDim2.fromOffset(170, 40), BackgroundColor3 = UI.Colors.Panel, BackgroundTransparency = 0.15, LayoutOrder = order }, parent)
	UI.Corner(f, 20)
	UI.Stroke(f, Color3.fromRGB(15, 15, 25), 2)
	UI.Text({ Text = icon, Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(4, 3), TextColor3 = color }, f)
	return UI.Text({ Text = "0", Size = UDim2.new(1, -46, 1, -8), Position = UDim2.fromOffset(40, 4), TextXAlignment = Enum.TextXAlignment.Left }, f)
end

local function fmt(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local function dash()
	Net.Event("Dash"):FireServer()
end

local function toggleRide()
	Net.Event("Ride"):FireServer(not player:GetAttribute("Riding"))
end

function Hud.Start()
	local screen = UI.Screen()

	-- Top-left stats
	local stats = UI.Frame({ Size = UDim2.fromOffset(180, 140), Position = UDim2.fromOffset(10, 10), BackgroundTransparency = 1 }, screen)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = stats
	local coins = stat(stats, 1, "$", UI.Colors.Gold)
	local trophies = stat(stats, 2, "T", Color3.fromRGB(255, 170, 60))
	local league = stat(stats, 3, "L", UI.Colors.Blue)

	State.OnChange(function(d)
		coins.Text = fmt(d.Coins)
		trophies.Text = fmt(d.Trophies)
		local idx, lg = RaceRules.League(d.Trophies)
		local nextL = require(Shared.Config).Leagues[idx + 1]
		league.Text = lg.Name .. if nextL then string.format(" (%d)", nextL.Min - d.Trophies) else ""
		league.TextColor3 = UI.Rgb(lg.Color)
	end)

	-- Bottom-right buttons (thumb reach on phones)
	local pad = UI.Frame({ Size = UDim2.fromOffset(250, 250), Position = UDim2.new(1, -10, 1, -10), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1 }, screen)
	local isTouch = UserInputService.TouchEnabled
	if isTouch then
		-- leave room for Roblox's jump button
		pad.Position = UDim2.new(1, -150, 1, -10)
	end

	local dashBtn = UI.Button({ Text = "DASH", Size = UDim2.fromOffset(110, 110), Position = UDim2.new(1, 0, 1, 0), AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = UI.Colors.Pink }, pad, dash)
	UI.Corner(dashBtn, 55)
	local charges = UI.Text({ Text = "", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -28), TextColor3 = UI.Colors.Gold }, dashBtn)
	local rideBtn = UI.Button({ Text = "WALK", Size = UDim2.fromOffset(110, 56), Position = UDim2.new(1, -120, 1, 0), AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = UI.Colors.Green }, pad, toggleRide)
	local petsBtn = UI.Button({ Text = "PETS", Size = UDim2.fromOffset(110, 56), Position = UDim2.new(1, -120, 1, -64), AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = UI.Colors.Blue }, pad, function()
		if openers.Pets then
			openers.Pets()
		end
	end)
	local shopBtn = UI.Button({ Text = "SHOP", Size = UDim2.fromOffset(110, 56), Position = UDim2.new(1, 0, 1, -120), AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = UI.Colors.Gold }, pad, function()
		if openers.Shop then
			openers.Shop()
		end
	end)
	Hud.Buttons = { Dash = dashBtn, Ride = rideBtn, Pets = petsBtn, Shop = shopBtn }

	local function refreshAttrs()
		local riding = player:GetAttribute("Riding")
		rideBtn.Text = if riding then "WALK" else "RIDE"
		rideBtn.BackgroundColor3 = if riding then UI.Colors.PanelLight else UI.Colors.Green
		local c = player:GetAttribute("DashCharges") or 0
		local m = player:GetAttribute("DashMax") or 0
		charges.Text = string.rep("o", c) .. string.rep(".", math.max(0, m - c))
		dashBtn.BackgroundTransparency = if riding and c > 0 then 0 else 0.5
		local inRace = player:GetAttribute("InRace") == true
		rideBtn.Visible = not inRace
		petsBtn.Visible = not inRace
		shopBtn.Visible = not inRace
	end
	for _, a in { "Riding", "DashCharges", "DashMax", "InRace" } do
		player:GetAttributeChangedSignal(a):Connect(refreshAttrs)
	end
	refreshAttrs()

	ContextActionService:BindAction("PetDash", function(_, st)
		if st == Enum.UserInputState.Begin then
			dash()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	ContextActionService:BindAction("PetRide", function(_, st)
		if st == Enum.UserInputState.Begin and not player:GetAttribute("InRace") then
			toggleRide()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Notify</string>
              <string name="Source"><![CDATA[-- Toasts: short messages from the server. "Xp" pops small above the buttons,
-- "Rare" is a big gold banner, everything else stacks at the top.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.UI)

local Notify = {}

local stack: Frame
local xpArea: Frame

local KIND_COLORS = {
	Info = UI.Colors.PanelLight,
	Error = UI.Colors.Red,
	Coins = Color3.fromRGB(220, 160, 30),
	Level = UI.Colors.Green,
	Rare = UI.Colors.Pink,
}

function Notify.Show(text: string, kind: string?)
	kind = kind or "Info"
	if kind == "Xp" then
		local t = UI.Text({
			Text = text,
			Size = UDim2.fromOffset(160, 30),
			Position = UDim2.new(0.5, math.random(-60, 60), 1, -10),
			AnchorPoint = Vector2.new(0.5, 1),
			TextColor3 = UI.Colors.Gold,
			TextStrokeTransparency = 0.2,
		}, xpArea)
		TweenService:Create(t, TweenInfo.new(1.1), { Position = t.Position - UDim2.fromOffset(0, 80), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(1.2, function()
			t:Destroy()
		end)
		return
	end
	local big = kind == "Rare"
	local f = UI.Frame({
		Size = UDim2.new(1, 0, 0, if big then 54 else 40),
		BackgroundColor3 = KIND_COLORS[kind :: string] or KIND_COLORS.Info,
		BackgroundTransparency = 0.05,
	}, stack)
	UI.Corner(f, 10)
	UI.Stroke(f, Color3.fromRGB(20, 20, 30), 2)
	UI.Pad(f, 6)
	UI.Text({ Text = text, Size = UDim2.fromScale(1, 1) }, f)
	task.delay(if big then 5 else 3, function()
		TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		task.wait(0.3)
		f:Destroy()
	end)
end

function Notify.Start()
	stack = UI.Frame({
		Name = "Toasts",
		Size = UDim2.new(0.5, 0, 0, 300),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 30,
	}, UI.Screen())
	local c = Instance.new("UISizeConstraint")
	c.MinSize = Vector2.new(260, 0)
	c.MaxSize = Vector2.new(520, 300)
	c.Parent = stack
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = stack
	xpArea = UI.Frame({
		Name = "XpArea",
		Size = UDim2.fromOffset(300, 200),
		Position = UDim2.new(0.5, 0, 1, -110),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
	}, UI.Screen())
	Net.Event("Notify").OnClientEvent:Connect(Notify.Show)
end

return Notify
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">PetMenu</string>
              <string name="Source"><![CDATA[-- The Pets menu: every pet you own, its stats, and Ride / Rename / Release.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Pets = require(Shared.Pets)
local Net = require(Shared.Net)
local PetModel = require(Shared.PetModel)
local PetStats = require(Shared.Logic.PetStats)
local Profile = require(Shared.Logic.Profile)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)
local Hud = require(script.Parent.Hud)

local PetMenu = {}

local panel: Frame
local grid: ScrollingFrame
local detail: Frame
local countLabel: TextLabel
local selected: string? = nil
local confirmRelease: string? = nil

local STAT_COLORS = { Speed = UI.Colors.Blue, Jump = Color3.fromRGB(255, 120, 60), Stamina = UI.Colors.Green }

local function petName(p: any): string
	local s = Pets.ById[p.Species]
	return p.Nick or (s and s.Name) or p.Species
end

local function preview(parent: Instance, p: any)
	local built = PetModel.Build(p.Species, 1, p.Paint)
	for _, d in built.Model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	UI.Viewport(parent, built.Model)
end

local function renderDetail()
	detail:ClearAllChildren()
	local d = State.Data
	local p = d and selected and Profile.FindPet(d, selected)
	if not p then
		UI.Text({ Text = "Tap a pet", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UI.Colors.Muted }, detail)
		return
	end
	local s = Pets.ById[p.Species]
	local rar = Pets.Rarities[s.Rarity]
	local view = UI.Frame({ Size = UDim2.new(1, 0, 0.36, 0), BackgroundColor3 = UI.Colors.PanelLight }, detail)
	UI.Corner(view, 12)
	preview(view, p)
	UI.Text({ Text = petName(p), Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.37, 0) }, detail)
	UI.Text({ Text = s.Rarity .. " " .. s.Name, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.37, 30), TextColor3 = UI.Rgb(rar.Color), Font = UI.Body }, detail)
	local ride = PetStats.Ride(p)
	local y = 0.37
	for i, stat in Config.Stats.Names do
		local lvl = p.Levels[stat] or 1
		local xp = p.Xp[stat] or 0
		local need = PetStats.XpToNext(lvl)
		local row = UI.Frame({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, y, 54 + (i - 1) * 30), BackgroundTransparency = 1 }, detail)
		UI.Text({ Text = stat .. " " .. lvl, Size = UDim2.new(0.4, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Font = UI.Body }, row)
		local bar = UI.Frame({ Size = UDim2.new(0.58, 0, 0.6, 0), Position = UDim2.new(0.42, 0, 0.2, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 30) }, row)
		UI.Corner(bar, 6)
		local fill = UI.Frame({ Size = UDim2.new(if lvl >= Config.Stats.MaxLevel then 1 else math.clamp(xp / need, 0, 1), 0, 1, 0), BackgroundColor3 = STAT_COLORS[stat] }, bar)
		UI.Corner(fill, 6)
	end
	UI.Text({
		Text = string.format("Speed %.0f  Jump %.0f  Dashes %d", ride.WalkSpeed, ride.JumpPower, ride.DashCharges),
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, y, 146),
		TextColor3 = UI.Colors.Muted,
		Font = UI.Body,
	}, detail)

	local by = UDim2.new(0, 0, 1, -44)
	if d.Equipped == p.Uid then
		UI.Text({ Text = "RIDING", Size = UDim2.new(0.48, 0, 0, 40), Position = by, TextColor3 = UI.Colors.Green }, detail)
	else
		UI.Button({ Text = "Ride", Size = UDim2.new(0.48, 0, 0, 40), Position = by, BackgroundColor3 = UI.Colors.Green }, detail, function()
			Net.Event("Equip"):FireServer(p.Uid)
		end)
		local refund = rar.Refund
		UI.Button({
			Text = if confirmRelease == p.Uid then "Sure? +" .. refund else "Release",
			Size = UDim2.new(0.48, 0, 0, 40),
			Position = UDim2.new(0.52, 0, 1, -44),
			BackgroundColor3 = UI.Colors.Red,
		}, detail, function()
			if confirmRelease == p.Uid then
				confirmRelease = nil
				selected = d.Equipped
				Net.Event("Release"):FireServer(p.Uid)
			else
				confirmRelease = p.Uid
				renderDetail()
			end
		end)
	end
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.66, 0, 0, 34)
	box.Position = UDim2.new(0, 0, 1, -86)
	box.PlaceholderText = "Nickname..."
	box.Text = ""
	box.Font = UI.Body
	box.TextScaled = true
	box.TextColor3 = Color3.new(1, 1, 1)
	box.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	box.ClearTextOnFocus = false
	UI.Corner(box, 8)
	box.Parent = detail
	UI.Button({ Text = "Name", Size = UDim2.new(0.3, 0, 0, 34), Position = UDim2.new(0.7, 0, 1, -86), BackgroundColor3 = UI.Colors.Purple }, detail, function()
		Net.Event("Rename"):FireServer(p.Uid, string.sub(box.Text, 1, 20))
	end)
end

local function renderGrid()
	for _, c in grid:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local d = State.Data
	if not d then
		return
	end
	countLabel.Text = #d.Pets .. "/" .. Profile.Capacity(d) .. " pets"
	local sorted = table.clone(d.Pets)
	table.sort(sorted, function(a, b)
		if (a.Uid == d.Equipped) ~= (b.Uid == d.Equipped) then
			return a.Uid == d.Equipped
		end
		local ra, rb = Pets.Rank(a.Species), Pets.Rank(b.Species)
		if ra ~= rb then
			return ra > rb
		end
		return PetStats.Power(a) > PetStats.Power(b)
	end)
	for i, p in sorted do
		local s = Pets.ById[p.Species]
		local card = UI.Button({
			Text = "",
			LayoutOrder = i,
			BackgroundColor3 = if p.Uid == selected then UI.Colors.Blue else UI.Colors.PanelLight,
		}, grid, function()
			selected = p.Uid
			confirmRelease = nil
			renderGrid()
			renderDetail()
		end)
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = UI.Rgb(Pets.Rarities[s.Rarity].Color)
			stroke.Thickness = 3
		end
		local vp = UI.Frame({ Size = UDim2.new(1, 0, 0.72, 0), BackgroundTransparency = 1 }, card)
		preview(vp, p)
		UI.Text({ Text = petName(p), Size = UDim2.new(1, -6, 0.16, 0), Position = UDim2.new(0, 3, 0.7, 0), Font = UI.Body }, card)
		UI.Text({ Text = "Lv " .. PetStats.Power(p), Size = UDim2.new(1, -6, 0.13, 0), Position = UDim2.new(0, 3, 0.86, 0), TextColor3 = UI.Colors.Muted, Font = UI.Body }, card)
		if p.Uid == d.Equipped then
			UI.Text({ Text = "RIDING", Size = UDim2.new(1, 0, 0.16, 0), TextColor3 = UI.Colors.Green, Rotation = -8 }, card)
		end
	end
end

function PetMenu.Open()
	panel.Visible = true
	if not selected and State.Data then
		selected = State.Data.Equipped
	end
	renderGrid()
	renderDetail()
end

function PetMenu.Start()
	local body
	panel, body = UI.Modal("My Pets", UDim2.fromScale(0.9, 0.85))
	countLabel = UI.Text({ Text = "", Size = UDim2.fromOffset(160, 30), Position = UDim2.new(1, -230, 0, 14), TextColor3 = UI.Colors.Muted, ZIndex = 11, Font = UI.Body }, panel)
	grid = Instance.new("ScrollingFrame")
	grid.Size = UDim2.new(0.6, -6, 1, 0)
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 8
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.CanvasSize = UDim2.new()
	grid.Parent = body
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(104, 124)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	UI.Pad(grid, 4)
	detail = UI.Frame({ Size = UDim2.new(0.4, -6, 1, 0), Position = UDim2.new(0.6, 6, 0, 0), BackgroundTransparency = 1 }, body)
	Hud.SetOpener("Pets", PetMenu.Open)
	State.OnChange(function()
		if panel.Visible then
			renderGrid()
			renderDetail()
		end
	end)
end

return PetMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">RaceHud</string>
              <string name="Source"><![CDATA[-- Race screens: queue banner, countdown, live place/timer/progress, checkpoint
-- flashes, finish feed and the results board.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local RaceRules = require(Shared.Logic.RaceRules)
local UI = require(script.Parent.Parent.UI)
local Notify = require(script.Parent.Notify)

local RaceHud = {}

local player = Players.LocalPlayer
local MEDAL_COLORS = { Gold = Color3.fromRGB(255, 205, 50), Silver = Color3.fromRGB(205, 210, 220), Bronze = Color3.fromRGB(215, 140, 80) }

local queueBanner: Frame
local queueText: TextLabel
local lastQueue = 0
local race: Frame
local placeText: TextLabel
local timeText: TextLabel
local trackText: TextLabel
local medalText: TextLabel
local progressFill: Frame
local big: TextLabel
local results: Frame
local leaveBtn: TextButton

local function flash(text: string, color: Color3?, hold: number?)
	big.Text = text
	big.TextColor3 = color or Color3.new(1, 1, 1)
	big.TextTransparency = 0
	big.TextStrokeTransparency = 0
	big.Visible = true
	big.Size = UDim2.fromOffset(260, 110)
	TweenService:Create(big, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(340, 140) }):Play()
	local token = {}
	big:SetAttribute("Token", tostring(token))
	task.delay(hold or 0.8, function()
		if big:GetAttribute("Token") == tostring(token) then
			TweenService:Create(big, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

local function showResults(data: any)
	results:ClearAllChildren()
	results.Visible = true
	UI.Corner(results, 16)
	UI.Stroke(results, Color3.fromRGB(15, 15, 25), 3)
	UI.Text({ Text = data.Track .. " - Results", Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 8) }, results)
	for i, r in data.Rows do
		local y = 52 + (i - 1) * 30
		local line = string.format("%s  %s", RaceRules.PlaceText(r.Place), r.Name)
		UI.Text({ Text = line, Size = UDim2.new(0.6, -10, 0, 26), Position = UDim2.fromOffset(16, y), TextXAlignment = Enum.TextXAlignment.Left, Font = UI.Body }, results)
		UI.Text({
			Text = if r.Finished and r.Time then RaceRules.FormatTime(r.Time) else "DNF",
			Size = UDim2.new(0.25, 0, 0, 26),
			Position = UDim2.new(0.6, 0, 0, y),
			Font = UI.Body,
			TextColor3 = if r.Medal then MEDAL_COLORS[r.Medal] else UI.Colors.Muted,
		}, results)
	end
	local m = data.Mine
	if m then
		local parts = { "+" .. m.Coins .. " coins" }
		if m.Trophies > 0 then
			table.insert(parts, "+" .. m.Trophies .. " trophies")
		end
		if m.Medal then
			table.insert(parts, m.Medal .. " medal!")
		end
		if m.NewBest then
			table.insert(parts, "New best time!")
		end
		UI.Text({ Text = table.concat(parts, "   "), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.new(0, 10, 1, -44), TextColor3 = UI.Colors.Gold }, results)
		flash(RaceRules.PlaceText(m.Place), if m.Place == 1 then UI.Colors.Gold else Color3.new(1, 1, 1), 2)
	end
	results.Size = UDim2.fromOffset(420, 110 + #data.Rows * 30)
end

local function onRace(kind: string, data: any)
	if kind == "Queue" then
		lastQueue = os.clock()
		queueBanner.Visible = true
		queueText.Text = string.format("Race starts in %d  -  %d racer%s ready", data.In, data.Count, if data.Count == 1 then "" else "s")
	elseif kind == "Start" then
		queueBanner.Visible = false
		results.Visible = false
		race.Visible = true
		trackText.Text = data.Track
		medalText.Text = string.format("Gold %s   Silver %s   Bronze %s", RaceRules.FormatTime(data.Medals.Gold), RaceRules.FormatTime(data.Medals.Silver), RaceRules.FormatTime(data.Medals.Bronze))
		placeText.Text = ""
		timeText.Text = "0:00.00"
		progressFill.Size = UDim2.fromScale(0, 1)
	elseif kind == "Count" then
		flash(tostring(data), UI.Colors.Gold, 0.7)
	elseif kind == "Go" then
		flash("GO!", UI.Colors.Green, 0.8)
	elseif kind == "Standing" then
		placeText.Text = RaceRules.PlaceText(data.Place) .. " / " .. data.Of
		timeText.Text = RaceRules.FormatTime(math.max(0, data.Time))
		progressFill.Size = UDim2.fromScale(math.clamp(data.Progress, 0, 1), 1)
		if data.EndsIn < 15 then
			timeText.TextColor3 = UI.Colors.Red
		else
			timeText.TextColor3 = Color3.new(1, 1, 1)
		end
	elseif kind == "Checkpoint" then
		Notify.Show("Checkpoint " .. data.Index .. "/" .. data.Total, "Xp")
	elseif kind == "Fell" then
		flash("Oops!", UI.Colors.Red, 0.8)
	elseif kind == "Hurry" then
		Notify.Show(string.format("Someone finished! %d seconds left!", math.floor(data.EndsIn)), "Info")
	elseif kind == "Finished" then
		Notify.Show(string.format("%s finished %s (%s)", data.Name, RaceRules.PlaceText(data.Place), RaceRules.FormatTime(data.Time)), "Level")
	elseif kind == "Results" then
		race.Visible = false
		showResults(data)
	end
end

function RaceHud.Start()
	local screen = UI.Screen()
	queueBanner = UI.Frame({ Size = UDim2.fromOffset(460, 50), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), BackgroundColor3 = UI.Colors.Pink, Visible = false }, screen)
	UI.Corner(queueBanner, 14)
	UI.Stroke(queueBanner, Color3.fromRGB(20, 20, 30), 2)
	UI.Pad(queueBanner, 6)
	queueText = UI.Text({ Size = UDim2.fromScale(1, 1) }, queueBanner)

	race = UI.Frame({ Size = UDim2.fromOffset(420, 110), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), BackgroundColor3 = UI.Colors.Panel, BackgroundTransparency = 0.15, Visible = false }, screen)
	UI.Corner(race, 14)
	trackText = UI.Text({ Size = UDim2.new(0.5, -10, 0, 26), Position = UDim2.fromOffset(10, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Muted }, race)
	placeText = UI.Text({ Size = UDim2.new(0.5, -10, 0, 44), Position = UDim2.fromOffset(10, 32), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Gold }, race)
	timeText = UI.Text({ Size = UDim2.new(0.5, -10, 0, 44), Position = UDim2.new(0.5, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Right }, race)
	medalText = UI.Text({ Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 10, 1, -40), TextColor3 = UI.Colors.Muted, Font = UI.Body }, race)
	local bar = UI.Frame({ Size = UDim2.new(1, -20, 0, 10), Position = UDim2.new(0, 10, 1, -18), BackgroundColor3 = Color3.fromRGB(20, 20, 30) }, race)
	UI.Corner(bar, 5)
	progressFill = UI.Frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = UI.Colors.Green }, bar)
	UI.Corner(progressFill, 5)

	big = UI.Text({ Size = UDim2.fromOffset(340, 140), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.35), Visible = false, TextStrokeTransparency = 0, ZIndex = 20 }, screen)

	results = UI.Frame({ Size = UDim2.fromOffset(420, 300), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Visible = false, ZIndex = 15 }, screen)

	leaveBtn = UI.Button({ Text = "Leave race", Size = UDim2.fromOffset(130, 40), Position = UDim2.new(0, 10, 0, 160), BackgroundColor3 = UI.Colors.Red, Visible = false }, screen, function()
		Net.Event("LeaveRace"):FireServer()
	end)

	Net.Event("Race").OnClientEvent:Connect(onRace)
	player:GetAttributeChangedSignal("InRace"):Connect(function()
		local inRace = player:GetAttribute("InRace") == true
		leaveBtn.Visible = inRace
		if not inRace then
			race.Visible = false
			results.Visible = false
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if queueBanner.Visible and os.clock() - lastQueue > 1.5 then
				queueBanner.Visible = false
			end
		end
	end)
end

return RaceHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">ShopMenu</string>
              <string name="Source"><![CDATA[-- Shop: trails and paint for your ridden pet (coins), plus the Robux tab.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Cosmetics = require(Shared.Cosmetics)
local Products = require(Shared.Products)
local Net = require(Shared.Net)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)
local Hud = require(script.Parent.Hud)

local ShopMenu = {}

local panel: Frame
local list: ScrollingFrame
local tab = "Trail"
local tabButtons: { [string]: TextButton } = {}

local function productFor(cosmeticId: string)
	for _, p in Products.Dev do
		if p.Cosmetic == cosmeticId then
			return p
		end
	end
	return nil
end

local function row(order: number, height: number?): Frame
	local f = UI.Frame({ Size = UDim2.new(1, -10, 0, height or 64), BackgroundColor3 = UI.Colors.PanelLight, LayoutOrder = order }, list)
	UI.Corner(f, 10)
	return f
end

local function render()
	for _, c in list:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for name, b in tabButtons do
		b.BackgroundColor3 = if name == tab then UI.Colors.Blue else UI.Colors.PanelLight
	end
	local d = State.Data
	if not d then
		return
	end
	local pet = State.Equipped()
	if tab == "Robux" then
		local any = false
		for i, p in Products.Dev do
			if p.Id then
				any = true
				local f = row(i)
				UI.Text({ Text = p.Name, Size = UDim2.new(0.6, 0, 0.6, 0), Position = UDim2.new(0, 12, 0.2, 0), TextXAlignment = Enum.TextXAlignment.Left }, f)
				UI.Button({ Text = "R$ " .. p.Robux, Size = UDim2.new(0.3, 0, 0.7, 0), Position = UDim2.new(0.68, 0, 0.15, 0), BackgroundColor3 = UI.Colors.Green }, f, function()
					MarketplaceService:PromptProductPurchase(Players.LocalPlayer, p.Id :: number)
				end)
			end
		end
		for i, pass in Products.Passes do
			if pass.Id then
				any = true
				local f = row(100 + i)
				UI.Text({ Text = pass.Name, Size = UDim2.new(0.6, 0, 0.6, 0), Position = UDim2.new(0, 12, 0.2, 0), TextXAlignment = Enum.TextXAlignment.Left }, f)
				if pass.Key == "BigBarn" and d.BigBarn then
					UI.Text({ Text = "Owned", Size = UDim2.new(0.3, 0, 0.6, 0), Position = UDim2.new(0.68, 0, 0.2, 0), TextColor3 = UI.Colors.Green }, f)
				else
					UI.Button({ Text = "R$ " .. pass.Robux, Size = UDim2.new(0.3, 0, 0.7, 0), Position = UDim2.new(0.68, 0, 0.15, 0), BackgroundColor3 = UI.Colors.Green }, f, function()
						MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.Id :: number)
					end)
				end
			end
		end
		if not any then
			UI.Text({ Text = "Robux shop opens soon!", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UI.Colors.Muted }, list)
		end
		return
	end
	local current = pet and (if tab == "Trail" then pet.Trail else pet.Paint)
	local f0 = row(0, 50)
	UI.Text({ Text = "None", Size = UDim2.new(0.5, 0, 0.6, 0), Position = UDim2.new(0, 12, 0.2, 0), TextXAlignment = Enum.TextXAlignment.Left }, f0)
	if current then
		UI.Button({ Text = "Use", Size = UDim2.new(0.3, 0, 0.7, 0), Position = UDim2.new(0.68, 0, 0.15, 0) }, f0, function()
			Net.Event("SetCosmetic"):FireServer(tab, nil)
		end)
	end
	for i, c in Cosmetics.List do
		if c.Kind == tab then
			local f = row(i)
			local sw = UI.Frame({ Size = UDim2.fromOffset(44, 44), Position = UDim2.new(0, 10, 0.5, -22), BackgroundColor3 = UI.Rgb(c.Colors[1]) }, f)
			UI.Corner(sw, 22)
			if #c.Colors > 1 then
				local g = Instance.new("UIGradient")
				local keys = {}
				for k, col in c.Colors do
					table.insert(keys, ColorSequenceKeypoint.new((k - 1) / (#c.Colors - 1), UI.Rgb(col)))
				end
				g.Color = ColorSequence.new(keys)
				g.Parent = sw
				sw.BackgroundColor3 = Color3.new(1, 1, 1)
			end
			UI.Text({ Text = c.Name, Size = UDim2.new(0.5, -60, 0.6, 0), Position = UDim2.new(0, 64, 0.2, 0), TextXAlignment = Enum.TextXAlignment.Left }, f)
			local btnSize, btnPos = UDim2.new(0.3, 0, 0.7, 0), UDim2.new(0.68, 0, 0.15, 0)
			if d.Owned[c.Id] then
				if current == c.Id then
					UI.Text({ Text = "Using", Size = btnSize, Position = btnPos, TextColor3 = UI.Colors.Green }, f)
				else
					UI.Button({ Text = "Use", Size = btnSize, Position = btnPos }, f, function()
						Net.Event("SetCosmetic"):FireServer(tab, c.Id)
					end)
				end
			elseif c.Price then
				UI.Button({ Text = "$ " .. c.Price, Size = btnSize, Position = btnPos, BackgroundColor3 = if d.Coins >= c.Price then UI.Colors.Gold else UI.Colors.PanelLight }, f, function()
					Net.Event("BuyCosmetic"):FireServer(c.Id)
				end)
			else
				local prod = productFor(c.Id)
				if prod and prod.Id then
					UI.Button({ Text = "R$ " .. prod.Robux, Size = btnSize, Position = btnPos, BackgroundColor3 = UI.Colors.Green }, f, function()
						MarketplaceService:PromptProductPurchase(Players.LocalPlayer, prod.Id :: number)
					end)
				else
					UI.Text({ Text = "Soon", Size = btnSize, Position = btnPos, TextColor3 = UI.Colors.Muted }, f)
				end
			end
		end
	end
end

function ShopMenu.Open()
	panel.Visible = true
	render()
end

function ShopMenu.Start()
	local body
	panel, body = UI.Modal("Shop", UDim2.fromScale(0.8, 0.8))
	local tabs = UI.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, body)
	for i, name in { "Trail", "Paint", "Robux" } do
		tabButtons[name] = UI.Button({ Text = if name == "Trail" then "Trails" else name, Size = UDim2.new(1 / 3, -6, 1, 0), Position = UDim2.new((i - 1) / 3, 3, 0, 0) }, tabs, function()
			tab = name
			render()
		end)
	end
	list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 1, -52)
	list.Position = UDim2.fromOffset(0, 52)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = body
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	Hud.SetOpener("Shop", ShopMenu.Open)
	State.OnChange(function()
		if panel.Visible then
			render()
		end
	end)
end

return ShopMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- First-time tips: four short cards, shown once per player.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.UI)
local State = require(script.Parent.Parent.State)

local Tutorial = {}

local STEPS = {
	{ "Welcome to Pet Race League!", "You're riding your first pet, a Pup. Ride it around!" },
	{ "Train your pet", "SPEED RING: ride through the gates in order.\nJUMP HURDLES: jump over the walls.\nSTAMINA TREADMILL: keep running on the belt." },
	{ "Race!", "Stand on the pink RACE PORTAL. Finish fast for coins, trophies and medals.\nTap DASH for a burst of speed." },
	{ "Hatch new pets", "Spend coins at the EGGS. Rare pets get a small bonus, but training matters most!" },
}

local shown = false

local function show()
	shown = true
	local step = 1
	local card = UI.Frame({ Size = UDim2.fromOffset(440, 220), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 50 }, UI.Screen())
	UI.Corner(card, 18)
	UI.Stroke(card, UI.Colors.Gold, 3)
	local title = UI.Text({ Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 10), TextColor3 = UI.Colors.Gold, ZIndex = 51 }, card)
	local body = UI.Text({ Size = UDim2.new(1, -24, 0, 100), Position = UDim2.fromOffset(12, 54), Font = UI.Body, TextScaled = false, TextSize = 18, TextWrapped = true, ZIndex = 51 }, card)
	local nextBtn: TextButton
	local function render()
		title.Text = STEPS[step][1]
		body.Text = STEPS[step][2]
		nextBtn.Text = if step == #STEPS then "Let's go!" else "Next"
	end
	nextBtn = UI.Button({ Text = "Next", Size = UDim2.fromOffset(160, 46), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), BackgroundColor3 = UI.Colors.Green, ZIndex = 51 }, card, function()
		if step < #STEPS then
			step += 1
			render()
		else
			card:Destroy()
			Net.Event("TutorialDone"):FireServer()
		end
	end)
	render()
end

function Tutorial.Start()
	State.OnChange(function(d)
		if not shown and not d.Tutorial then
			show()
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="44">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry: connects remotes and starts each controller.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

Net.Init()

local State = require(script.Parent:WaitForChild("State"))
Net.Event("State").OnClientEvent:Connect(function(data)
	State.Set(data)
end)

local Controllers = script.Parent:WaitForChild("Controllers")
for _, name in { "Notify", "Hud", "PetMenu", "ShopMenu", "HatchView", "RaceHud", "Tutorial" } do
	local ok, err = pcall(function()
		local c = require(Controllers:WaitForChild(name)) :: any
		c.Start()
	end)
	if not ok then
		warn("[Client] " .. name .. " failed: " .. tostring(err))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Holds the latest profile snapshot from the server and tells listeners when it changes.
local State = {}

State.Data = nil :: any
local listeners: { (any) -> () } = {}

function State.Set(data: any)
	State.Data = data
	for _, fn in listeners do
		task.spawn(fn, data)
	end
end

function State.OnChange(fn: (any) -> ())
	table.insert(listeners, fn)
	if State.Data then
		task.spawn(fn, State.Data)
	end
end

-- The pet the player is riding, or nil.
function State.Equipped(): any
	local d = State.Data
	if not d then
		return nil
	end
	for _, p in d.Pets do
		if p.Uid == d.Equipped then
			return p
		end
	end
	return nil
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Tiny UI kit: everything is built in code with big, phone-friendly buttons.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Panel = Color3.fromRGB(34, 36, 56),
	PanelLight = Color3.fromRGB(52, 55, 84),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(180, 185, 210),
	Gold = Color3.fromRGB(255, 205, 60),
	Green = Color3.fromRGB(80, 200, 110),
	Red = Color3.fromRGB(235, 80, 80),
	Blue = Color3.fromRGB(70, 150, 255),
	Pink = Color3.fromRGB(255, 90, 170),
	Purple = Color3.fromRGB(150, 90, 255),
}

UI.Font = Enum.Font.FredokaOne
UI.Body = Enum.Font.GothamBold

local screen: ScreenGui? = nil

function UI.Screen(): ScreenGui
	if screen then
		return screen
	end
	local g = Instance.new("ScreenGui")
	g.Name = "PetRaceUI"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = false
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	screen = g
	return g
end

function UI.Corner(parent: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = parent
end

function UI.Stroke(parent: Instance, color: Color3?, thick: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thick or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

function UI.Pad(parent: Instance, px: number)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.Parent = parent
end

function UI.Frame(props: { [string]: any }, parent: Instance?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = UI.Colors.Panel
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

function UI.Text(props: { [string]: any }, parent: Instance?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = UI.Font
	t.TextColor3 = UI.Colors.Text
	t.TextScaled = true
	t.BorderSizePixel = 0
	for k, v in props do
		(t :: any)[k] = v
	end
	t.Parent = parent
	return t
end

function UI.Button(props: { [string]: any }, parent: Instance?, onClick: (() -> ())?): TextButton
	local b = Instance.new("TextButton")
	b.Font = UI.Font
	b.TextColor3 = UI.Colors.Text
	b.TextScaled = true
	b.AutoButtonColor = true
	b.BackgroundColor3 = UI.Colors.Blue
	b.BorderSizePixel = 0
	for k, v in props do
		(b :: any)[k] = v
	end
	UI.Corner(b, 10)
	UI.Stroke(b, Color3.fromRGB(20, 20, 30), 2)
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 30
	c.Parent = b
	b.Parent = parent
	if onClick then
		b.Activated:Connect(function()
			local s = b.Size
			local t = TweenService:Create(b, TweenInfo.new(0.06), { Size = UDim2.new(s.X.Scale * 0.94, s.X.Offset * 0.94, s.Y.Scale * 0.94, s.Y.Offset * 0.94) })
			t:Play()
			t.Completed:Once(function()
				TweenService:Create(b, TweenInfo.new(0.08), { Size = s }):Play()
			end)
			onClick()
		end)
	end
	return b
end

-- A centered modal panel with a title and a close button. Returns panel, body.
function UI.Modal(title: string, size: UDim2, onClose: (() -> ())?): (Frame, Frame)
	local panel = UI.Frame({
		Name = title .. "Modal",
		Size = size,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Visible = false,
		ZIndex = 10,
	}, UI.Screen())
	UI.Corner(panel, 18)
	UI.Stroke(panel, Color3.fromRGB(15, 15, 25), 3)
	local ar = Instance.new("UISizeConstraint")
	ar.MaxSize = Vector2.new(760, 560)
	ar.Parent = panel
	UI.Text({ Text = title, Size = UDim2.new(1, -80, 0, 44), Position = UDim2.fromOffset(16, 8), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 }, panel)
	UI.Button({ Text = "X", Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -54, 0, 8), BackgroundColor3 = UI.Colors.Red, ZIndex = 11 }, panel, function()
		panel.Visible = false
		if onClose then
			onClose()
		end
	end)
	local body = UI.Frame({ Size = UDim2.new(1, -24, 1, -68), Position = UDim2.fromOffset(12, 58), BackgroundTransparency = 1, ZIndex = 11 }, panel)
	return panel, body
end

function UI.Rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Spinning 3D preview of a model inside a ViewportFrame.
function UI.Viewport(parent: Instance, model: Model, props: { [string]: any }?): ViewportFrame
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 1)
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	if props then
		for k, v in props do
			(vp :: any)[k] = v
		end
	end
	local world = Instance.new("WorldModel")
	world.Parent = vp
	model.Parent = world
	local cam = Instance.new("Camera")
	local _, size = model:GetBoundingBox()
	local dist = size.Magnitude * 1.1
	local center = Vector3.new(0, size.Y / 2, 0)
	cam.CFrame = CFrame.lookAt(center + Vector3.new(-dist * 0.75, dist * 0.35, -dist * 0.75), center)
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	return vp
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>