        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="898">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Replaces Roblox's default "Health" regeneration script.
-- Survival Hour heals only near your own burning campfire (CampService) or with
-- bandages, so passive regeneration is intentionally disabled.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="899">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="900">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="901">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="902">
            <Properties>
              <string name="Name">Animation</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Procedural character animation layered over the default Roblox animations.
--
-- No KeyframeSequence assets were uploaded for this project (DECISIONS D34),
-- so actions are expressed by pre-multiplying each joint's `Transform` right
-- after the Animator writes it (PreSimulation). That equals offsetting C0, but
-- also works for AnimationConstraint joints (avatar joint upgrade), whose C0
-- doesn't exist. The server replicates `Action`, `ActionAt`, `ActionItem`,
-- `Blocking` and `HeldId` attributes; every client animates every nearby
-- character from them. The local player also gets instant predicted swings.
--
-- Supports R15 (RightShoulder/LeftShoulder/Waist/Neck) and R6 joints, as
-- Motor6D or AnimationConstraint.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local State = require("../State")
local Input = require("./Input")
local Items = require(game:GetService("ReplicatedStorage").Shared.Items)

local Animation = {}

local player = Players.LocalPlayer

-- Motor6D or AnimationConstraint; both expose a writable `Transform`.
type Joint = any

type Rig = {
	Char: Model,
	R: Joint?,
	L: Joint?,
	Waist: Joint?,
	Neck: Joint?,
	R15: boolean,
	Cur: { r: CFrame, l: CFrame, w: CFrame, n: CFrame },
	-- Per joint: the animated Transform we offset last frame, and what we wrote.
	-- If the Animator leaves a joint alone, Transform still holds our write, so
	-- we reuse the stored base instead of stacking offsets.
	Base: { [Joint]: CFrame },
	Wrote: { [Joint]: CFrame },
	-- reaction bookkeeping (client-side only)
	Held: string?,
	EquipAt: number,
	WasAir: boolean,
	LandAt: number,
}

local rigs: { [Model]: Rig } = {}
local localSwingAt = 0
local localSwingItem = "Fists"
local localSwingHeavy = false
local localDraw = false

local ID = CFrame.identity
local rad = math.rad

local function findRig(char: Model): Rig?
	local r15 = char:FindFirstChild("UpperTorso") ~= nil
	local R, L, W, N
	if r15 then
		local rua = char:FindFirstChild("RightUpperArm")
		local lua = char:FindFirstChild("LeftUpperArm")
		local ut = char:FindFirstChild("UpperTorso")
		local head = char:FindFirstChild("Head")
		R = rua and rua:FindFirstChild("RightShoulder")
		L = lua and lua:FindFirstChild("LeftShoulder")
		W = ut and ut:FindFirstChild("Waist")
		N = head and head:FindFirstChild("Neck")
	else
		local torso = char:FindFirstChild("Torso")
		if torso then
			R = torso:FindFirstChild("Right Shoulder")
			L = torso:FindFirstChild("Left Shoulder")
			N = torso:FindFirstChild("Neck")
		end
	end
	if not R or not L then
		return nil
	end
	return {
		Char = char,
		R = R,
		L = L,
		Waist = W,
		Neck = N,
		R15 = r15,
		Cur = { r = ID, l = ID, w = ID, n = ID },
		Base = {},
		Wrote = {},
		Held = char:GetAttribute("HeldId"),
		EquipAt = 0,
		WasAir = false,
		LandAt = 0,
	}
end

local function remoteDraw(owner: Player?, isLocal: boolean, held: string): boolean
	return not isLocal and owner ~= nil and owner:GetAttribute("Drawing") == true and (held == "Bow" or held == "CrudeBow" or held == "HuntingBow" or held == "Crossbow")
end

local function isBow(item: string): boolean
	return item == "Bow" or item == "CrudeBow" or item == "HuntingBow"
end

local function isChopper(item: string): boolean
	return string.find(item, "Axe$") ~= nil or string.find(item, "Pickaxe$") ~= nil or item == "RepairHammer" or item == "Sledgehammer" or item == "Crowbar"
end

-- Returns target offsets for right arm, left arm, waist, neck.
-- Base pose from the current action, then additive reaction layers (hit flinch,
-- block impact, guard break, landing, equip, sprint lean, exhausted breathing).
local function pose(rig: Rig, t: number): (CFrame, CFrame, CFrame, CFrame)
	local char = rig.Char
	local owner = Players:GetPlayerFromCharacter(char)
	local now = workspace:GetServerTimeNow()
	local action = char:GetAttribute("Action") :: string?
	local at = (char:GetAttribute("ActionAt") :: number?) or 0
	local item = (char:GetAttribute("ActionItem") :: string?) or (char:GetAttribute("HeldId") :: string?) or "Fists"
	local heavy = char:GetAttribute("ActionHeavy") == true
	local variant = (char:GetAttribute("ActionVariant") :: number?) or 0
	local elapsed = now - at
	local isLocal = char == player.Character
	local phase = t * 6
	local r, l, w, n = ID, ID, ID, ID
	-- R6 shoulders rotate around Z; convert "forward raise" to the right axis.
	local function raise(deg: number, side: number): CFrame
		if rig.R15 then
			return CFrame.Angles(rad(deg), 0, 0)
		end
		return CFrame.Angles(0, 0, rad(deg) * side)
	end

	-- Local prediction for instant feedback
	if isLocal and os.clock() - localSwingAt < 0.6 then
		action = "Attack"
		item = localSwingItem
		heavy = localSwingHeavy
		elapsed = os.clock() - localSwingAt
	end

	local held = (char:GetAttribute("HeldId") :: string?) or "Fists"
	if held ~= rig.Held then
		rig.Held = held
		rig.EquipAt = t
	end

	if isLocal and localDraw then
		-- bow draw: bow arm out, string hand back to the cheek
		r = raise(85, 1) * CFrame.Angles(0, rad(-35), 0)
		l = raise(90, -1)
		w = CFrame.Angles(0, rad(-30), 0)
		n = CFrame.Angles(0, rad(20), 0)
		return r, l, w, n
	end

	if remoteDraw(owner, isLocal, held) then
		r = raise(85, 1) * CFrame.Angles(0, rad(-35), 0)
		l = raise(90, -1)
		w = CFrame.Angles(0, rad(-30), 0)
		n = CFrame.Angles(0, rad(20), 0)
		return r, l, w, n
	end

	-- Blocking is a Player attribute (set by CombatService's BlockState handler)
	if (owner and owner:GetAttribute("Blocking")) or char:GetAttribute("Blocking") then
		-- guard: weapon across the body, off hand braced
		r = raise(78, 1) * CFrame.Angles(0, rad(40), 0)
		l = raise(55, -1) * CFrame.Angles(0, rad(-25), 0)
		w = CFrame.Angles(0, rad(12), 0)
	elseif held == "Crossbow" or held == "Rifle" or held == "Pistol" then
		-- ranged ready: weapon held low and forward
		r = raise(35, 1)
		l = if held == "Pistol" then ID else raise(30, -1)
	elseif isBow(held) then
		l = raise(25, -1)
	else
		-- weapons are carried at the ready; tools hang relaxed
		local hdef = Items[held]
		if hdef and hdef.Kind == "Weapon" and not hdef.Ranged then
			r = raise(28, 1) * CFrame.Angles(0, rad(15), 0)
			l = raise(12, -1)
		end
	end
	-- crossbow reload: after the shot, pull the string back down
	if action == "Attack" and item == "Crossbow" and elapsed > 0.25 and elapsed < 1.3 then
		local k = math.sin(math.clamp((elapsed - 0.25) / 1.05, 0, 1) * math.pi)
		r = raise(45, 1)
		l = raise(40 + 35 * k, -1) * CFrame.Angles(0, rad(-25 * k), 0)
		w = CFrame.Angles(rad(-12 * k), 0, 0)
		n = CFrame.Angles(rad(-18 * k), 0, 0)
		return r, l, w, n
	end

	local swingLen = if heavy then 0.62 else 0.38
	if action == "Attack" and elapsed < swingLen + 0.08 then
		local k = math.clamp(elapsed / swingLen, 0, 1)
		if item == "Spear" or item == "CrudeSpear" then
			-- thrust (heavy: longer lunge)
			local ext = math.sin(k * math.pi)
			r = raise(70 + (if heavy then 30 else 20) * ext, 1)
			l = raise(50 * ext, -1)
			w = CFrame.Angles(rad(-8 * ext), rad(-15 * ext), 0)
		elseif isBow(item) then
			r = raise(85 * (1 - k), 1)
			l = raise(90, -1)
		elseif item == "Crossbow" or item == "Pistol" or item == "Rifle" then
			local kick = math.max(0, 1 - k * 3)
			r = raise(90 + 15 * kick, 1)
			l = if item == "Pistol" then ID else raise(80, -1)
			n = CFrame.Angles(rad(-4 * kick), 0, 0)
		elseif isChopper(item) then
			-- overhead chop; heavy = bigger wind-up with a waist twist
			local wind = if heavy then 0.45 else 0.3
			local top = if heavy then 170 else 150
			local a = if k < wind then top * (k / wind) else top - (top + 40) * ((k - wind) / (1 - wind))
			r = raise(a, 1)
			l = raise(a * 0.35, -1)
			w = CFrame.Angles(rad(-12 * math.sin(k * math.pi)), rad((if heavy then 25 else 10) * (1 - k)), 0)
		else
			-- horizontal slash; alternates direction, heavy is a wide wind-up
			local dir = if variant == 0 then 1 else -1
			local wind = if heavy then 0.4 else 0.25
			local span = if heavy then 170 else 140
			local a = if k < wind then -60 * dir * (k / wind) else dir * (-60 + span * ((k - wind) / (1 - wind)))
			r = raise(if variant == 0 then 80 else 95, 1) * CFrame.Angles(0, rad(a), 0)
			l = raise(30, -1)
			w = CFrame.Angles(0, rad(-a * (if heavy then 0.45 else 0.3)), 0)
		end
	elseif action == "Chop" or action == "Breach" then
		-- repeated overhead strikes; breaching is slower and heavier
		local rate = if action == "Breach" then 2.4 else 3
		local k = (phase % rate) / rate
		local a = if k < 0.4 then 150 * (k / 0.4) else 150 - 190 * ((k - 0.4) / 0.6)
		r = raise(a, 1)
		l = raise(a * 0.4, -1)
		w = CFrame.Angles(rad(-10 * math.max(0, math.sin(k * math.pi * 2))), rad(12), 0)
	elseif action == "Mine" then
		-- pickaxe: bent over, swinging down at the rock
		local k = (phase % 2.6) / 2.6
		local a = if k < 0.45 then 135 * (k / 0.45) else 135 - 175 * ((k - 0.45) / 0.55)
		r = raise(a, 1)
		l = raise(a * 0.5, -1)
		w = CFrame.Angles(rad(-18), 0, 0)
		n = CFrame.Angles(rad(-15), 0, 0)
	elseif action == "Gather" or action == "Fill" then
		w = CFrame.Angles(rad(-35), 0, 0)
		n = CFrame.Angles(rad(-15), 0, 0)
		r = raise(40 + 25 * math.sin(phase * 1.5), 1)
		l = raise(40 + 25 * math.sin(phase * 1.5 + math.pi), -1)
	elseif action == "Pour" then
		r = raise(95, 1) * CFrame.Angles(0, 0, rad(-40 + 8 * math.sin(phase)))
		w = CFrame.Angles(rad(-12), 0, 0)
		n = CFrame.Angles(rad(-20), 0, 0)
	elseif action == "Bandage" then
		-- wrapping: both hands circle over the forearm, head down to watch
		r = raise(60, 1) * CFrame.Angles(0, rad(40 + 15 * math.sin(phase * 2)), 0)
		l = raise(60, -1) * CFrame.Angles(0, rad(-40 - 15 * math.sin(phase * 2)), 0)
		n = CFrame.Angles(rad(-25), 0, 0)
		w = CFrame.Angles(rad(-6), 0, 0)
	elseif action == "Craft" and elapsed < 1.2 then
		-- quick hammering at the bench
		local k = (phase * 1.4) % 1
		r = raise(70 + 40 * math.max(0, math.sin(k * math.pi * 2)), 1)
		l = raise(55, -1) * CFrame.Angles(0, rad(-20), 0)
		w = CFrame.Angles(rad(-15), 0, 0)
		n = CFrame.Angles(rad(-20), 0, 0)
	elseif action == "Craft" then
		-- long craft channel: hands busy at chest height
		r = raise(55 + 12 * math.sin(phase * 2.2), 1) * CFrame.Angles(0, rad(20), 0)
		l = raise(55 + 12 * math.sin(phase * 2.2 + 1.3), -1) * CFrame.Angles(0, rad(-20), 0)
		w = CFrame.Angles(rad(-12), 0, 0)
		n = CFrame.Angles(rad(-22), 0, 0)
	elseif action == "Build" and elapsed < 0.9 then
		-- two hammer taps
		local k = (elapsed / 0.45) % 1
		r = raise(if k < 0.4 then 120 * (k / 0.4) else 120 - 110 * ((k - 0.4) / 0.6), 1)
		w = CFrame.Angles(rad(-10), 0, 0)
	elseif action == "Feed" and elapsed < 0.7 then
		-- toss wood onto the fire
		local k = elapsed / 0.7
		local a = if k < 0.4 then 20 + 60 * (k / 0.4) else 80 - 40 * ((k - 0.4) / 0.6)
		r = raise(a, 1)
		l = raise(a, -1)
		w = CFrame.Angles(rad(-20 * math.sin(k * math.pi)), 0, 0)
	elseif action == "Eat" and elapsed < 0.9 then
		-- hand to mouth twice
		local k = (elapsed / 0.45) % 1
		r = raise(95 + 25 * math.sin(k * math.pi), 1) * CFrame.Angles(0, rad(35), 0)
		n = CFrame.Angles(rad(-8), 0, 0)
	elseif action == "Open" or action == "Steal" then
		w = CFrame.Angles(rad(-30), 0, 0)
		r = raise(55 + 30 * math.sin(phase * 2), 1)
		l = raise(55 + 30 * math.sin(phase * 2 + 1.5), -1)
	elseif action == "Emote" and elapsed < 2 then
		local k = math.sin(math.clamp(elapsed / 2, 0, 1) * math.pi)
		if item == "EmoteWave" then
			r = raise(150 * k, 1) * CFrame.Angles(0, 0, rad(25 * math.sin(elapsed * 10)))
		elseif item == "EmoteFlex" then
			r = raise(90 * k, 1) * CFrame.Angles(rad(-60 * k), 0, 0)
			l = raise(90 * k, -1) * CFrame.Angles(rad(-60 * k), 0, 0)
		else
			r = raise(70 * k, 1)
			l = raise(70 * k, -1)
			w = CFrame.Angles(rad(-15 * k), 0, 0)
		end
	elseif action == "Victory" and elapsed < 12 then
		if item == "PoseThrone" then
			w = CFrame.Angles(rad(10), 0, 0)
			r = raise(35, 1)
			l = raise(35, -1)
		elseif item == "PoseAxe" then
			r = raise(160, 1) * CFrame.Angles(0, 0, rad(-30))
		else
			r = raise(170, 1)
			n = CFrame.Angles(rad(15), 0, 0)
		end
	end

	-- Reaction layers ---------------------------------------------------------------
	local hum = char:FindFirstChildOfClass("Humanoid")
	-- equip: the new item comes up from the hip
	local eq = t - rig.EquipAt
	if eq < 0.28 and held ~= "Fists" then
		r = raise(-35 * (1 - eq / 0.28), 1) * r
	end
	-- airborne arms lift a little; landing dips the torso
	local air = hum ~= nil and hum.FloorMaterial == Enum.Material.Air
	if air then
		l = raise(18, -1) * l
		r = raise(12, 1) * r
	elseif rig.WasAir then
		rig.LandAt = t
	end
	rig.WasAir = air
	local land = t - rig.LandAt
	if land < 0.25 then
		w = CFrame.Angles(rad(-10 * math.sin(land / 0.25 * math.pi)), 0, 0) * w
	end
	-- sprint lean / exhausted breathing
	if owner and owner:GetAttribute("Sprinting") and hum and hum.MoveDirection.Magnitude > 0.1 then
		w = CFrame.Angles(rad(-7), 0, 0) * w
	elseif owner and owner:GetAttribute("Exhausted") then
		w = CFrame.Angles(rad(-8 + 3 * math.sin(t * 5)), 0, 0) * w
		n = CFrame.Angles(rad(4 * math.sin(t * 5)), 0, 0) * n
	end
	-- guard broken: arms drop and the torso staggers
	if owner and (owner:GetAttribute("GuardBrokenUntil") or 0) > now then
		r = raise(-15, 1)
		l = raise(-15, -1)
		w = CFrame.Angles(rad(8), rad(10 * math.sin(t * 9)), 0) * w
	end
	-- block impact: the guard is knocked back
	local bh = now - ((char:GetAttribute("BlockHitAt") :: number?) or 0)
	if bh < 0.22 then
		local k = math.sin(bh / 0.22 * math.pi)
		r = raise(-18 * k, 1) * r
		w = CFrame.Angles(rad(6 * k), 0, 0) * w
	end
	-- hit flinch: head and torso snap away from the blow
	local hit = now - ((char:GetAttribute("HitAt") :: number?) or 0)
	if hit < 0.3 then
		local k = math.sin(hit / 0.3 * math.pi)
		w = CFrame.Angles(rad(10 * k), 0, rad(4 * k)) * w
		n = CFrame.Angles(rad(12 * k), 0, 0) * n
	end
	return r, l, w, n
end

-- C0 * (off * T) == (C0 * off) * T, so this matches the old C0 offset.
local function offset(rig: Rig, joint: Joint?, off: CFrame)
	if not joint then
		return
	end
	local cur = joint.Transform
	local base = if rig.Wrote[joint] == cur then rig.Base[joint] or cur else cur
	local out = off * base
	rig.Base[joint] = base
	rig.Wrote[joint] = out
	joint.Transform = out
end

local function apply(rig: Rig, dt: number, t: number)
	local r, l, w, n = pose(rig, t)
	local a = math.clamp(dt * 18, 0, 1)
	rig.Cur.r = rig.Cur.r:Lerp(r, a)
	rig.Cur.l = rig.Cur.l:Lerp(l, a)
	rig.Cur.w = rig.Cur.w:Lerp(w, a)
	rig.Cur.n = rig.Cur.n:Lerp(n, a)
	offset(rig, rig.R, rig.Cur.r)
	offset(rig, rig.L, rig.Cur.l)
	offset(rig, rig.Waist, rig.Cur.w)
	offset(rig, rig.Neck, rig.Cur.n)
end

function Animation.Start()
	State.On("LocalAction", function(a)
		if a.Kind == "Attack" or a.Kind == "Heavy" or a.Kind == "Release" then
			localSwingAt = os.clock()
			localSwingItem = a.Item
			localSwingHeavy = a.Kind == "Heavy"
			localDraw = false
		elseif a.Kind == "Draw" then
			localDraw = true
		end
	end)
	-- PreSimulation runs after the Animator has written this frame's Transforms.
	RunService.PreSimulation:Connect(function(dt)
		local cam = workspace.CurrentCamera.CFrame.Position
		local t = os.clock()
		if not Input.Down.Attack then
			localDraw = false
		end
		for _, p in Players:GetPlayers() do
			local char = p.Character
			if char and char.Parent then
				local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and (root.Position - cam).Magnitude < 150 then
					local rig = rigs[char]
					if rig == nil or not rig.R or not rig.R.Parent then
						local found = findRig(char)
						if found then
							rigs[char] = found
							rig = found
						end
					end
					if rig then
						apply(rig, dt, t)
					end
				end
			end
		end
		for char in rigs do
			if not char.Parent then
				rigs[char] = nil
			end
		end
	end)
end

return Animation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="903">
            <Properties>
              <string name="Name">Build</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Free-placement build mode with a live preview.
--   PC: move the mouse to position, R / Q to rotate, LMB place, RMB or B to exit.
--   Touch: aim with the camera centre, on-screen ◀ ▶ PLACE ✖ buttons.
-- Walls, gates and reinforced walls snap end-to-end to nearby clan walls.
-- The preview shows green/red using the same PlacementRules the server uses;
-- the server re-validates everything (plus terrain, characters, cost, limits).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local Net = require(Shared.Net)
local PlacementRules = require(Shared.Logic.PlacementRules)
local Structures = require(Shared.Models.Structures)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")

local Build = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
Build.Active = false
local zoneRing: Part? = nil
local currentId: string? = nil
local ghost: Model? = nil
local yaw = 0
local lastValid = false
local lastReason: string? = nil
local ghostPos: Vector3? = nil
local touchBar: Frame
local statusLabel: TextLabel
local conn: RBXScriptConnection? = nil

-- Structures whose ends snap together (walls, doors, gates; floors snap edge to edge too).
local WALLS = {
	WoodWall = true, Gate = true, ReinforcedWall = true, ReinforcedDoor = true, WindowWall = true,
	ScrapWall = true, MetalWall = true, HeavyGate = true, WoodFloor = true,
}

local function aimPoint(): Vector3?
	local char = player.Character
	local useMouse = not State.Get("IsTouch")
	local ray
	if useMouse then
		local m = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(m.X, m.Y)
	else
		local vp = camera.ViewportSize
		ray = camera:ViewportPointToRay(vp.X / 2, vp.Y * 0.55)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	if char then
		table.insert(ignore, char)
	end
	if ghost then
		table.insert(ignore, ghost)
	end
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 120, params)
	return hit and hit.Position
end

local function existingRects(): { PlacementRules.Rect }
	local out = {}
	local match = workspace:FindFirstChild("Match")
	local folder = match and match:FindFirstChild("Structures")
	if folder then
		for _, m in folder:GetChildren() do
			local root = m:IsA("Model") and m.PrimaryPart
			if root then
				local _, ry = root.CFrame:ToOrientation()
				table.insert(out, { X = root.Position.X, Z = root.Position.Z, HX = root.Size.X / 2, HZ = root.Size.Z / 2, Yaw = -math.deg(ry), Model = m })
			end
		end
	end
	return out
end

-- Snap wall ends together (keeps rotation; moves the ghost so the nearest ends meet).
local function snap(pos: Vector3, id: string, rects: { any }): Vector3
	if not WALLS[id] then
		return pos
	end
	local half = (Items[id].Size :: Vector3).X / 2
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw), 0)
	local myEnds = { (cf * CFrame.new(half, 0, 0)).Position, (cf * CFrame.new(-half, 0, 0)).Position }
	local best, bestD = nil, 3.5
	for _, r in rects do
		local m = r.Model :: Model
		if m and WALLS[m:GetAttribute("Structure") or ""] and m:GetAttribute("Team") == player:GetAttribute("Team") then
			local rc = (m.PrimaryPart :: BasePart).CFrame
			for _, sx in { -r.HX, r.HX } do
				local e = (rc * CFrame.new(sx, 0, 0)).Position
				for _, mine in myEnds do
					local d = Vector3.new(e.X - mine.X, 0, e.Z - mine.Z).Magnitude
					if d < bestD then
						bestD = d
						best = Vector3.new(e.X - mine.X, 0, e.Z - mine.Z)
					end
				end
			end
		end
	end
	return if best then pos + best else pos
end

local function tint(valid: boolean)
	if not ghost then
		return
	end
	for _, d in ghost:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Name ~= "Collider" and d.Name ~= "Hurt" then
			d.Color = if valid then Color3.fromRGB(120, 230, 140) else Color3.fromRGB(240, 90, 80)
		end
	end
end

local function update()
	if not Build.Active or not currentId or not ghost then
		return
	end
	local p = aimPoint()
	if not p then
		return
	end
	local grid = Config.Build.GridSnap
	local pos = Vector3.new(math.floor(p.X / grid + 0.5) * grid, p.Y, math.floor(p.Z / grid + 0.5) * grid)
	local rects = existingRects()
	pos = snap(pos, currentId, rects)
	ghostPos = pos
	-- ease the ghost toward the target so it glides instead of teleporting
	local target = CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw), 0)
	local cur = ghost:GetPivot()
	ghost:PivotTo(if (cur.Position - pos).Magnitude > 12 then target else cur:Lerp(target, 0.45))
	local map = State.Get("Map")
	local camp = map and map.MyCamp
	local valid, reason = false, "No camp"
	if camp then
		local size = Items[currentId].Size :: Vector3
		local existing = {}
		for _, r in camp.StaticRects do
			table.insert(existing, r)
		end
		for _, r in rects do
			table.insert(existing, r)
		end
		valid, reason = PlacementRules.Check({ X = pos.X, Z = pos.Z, HX = size.X / 2, HZ = size.Z / 2, Yaw = -yaw }, {
			Fire = { X = camp.X, Z = camp.Z },
			ZoneRadius = Config.Build.ZoneRadius,
			Clearances = camp.Clearances,
			Existing = existing,
			LimitUsed = 0,
			LimitMax = 999,
		})
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if valid and root and Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z).Magnitude > Config.Build.MaxPlaceDistance then
			valid, reason = false, "Too far away"
		end
	end
	lastValid, lastReason = valid, reason
	tint(valid)
	local recipe = Recipes.ByResult[currentId]
	local costs = {}
	for id, n in recipe.Cost do
		table.insert(costs, n .. " " .. Items[id].Name)
	end
	statusLabel.Text = Items[currentId].Name .. "  ·  " .. table.concat(costs, ", ") .. "\n" .. (if valid then "✓ Valid spot" else "✖ " .. tostring(reason))
	statusLabel.TextColor3 = if valid then Theme.Colors.Good else Theme.Colors.Bad
end

function Build.Begin(id: string)
	if not player:GetAttribute("InMatch") or player:GetAttribute("LifeState") ~= "Alive" then
		return
	end
	Build.Stop()
	currentId = id
	Build.Active = true
	State.Set("Building", true)
	local team = player:GetAttribute("Team") or 1
	local g = Structures.Build(id, CFrame.new(0, -500, 0), Config.Teams[team].Color, workspace.CurrentCamera)
	for _, d in g:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Anchored = true
			d.CastShadow = false
			if d.Transparency < 1 then
				d.Transparency = 0.45
			end
			d.Material = Enum.Material.ForceField
		end
	end
	ghost = g
	-- show the build zone around your fire while placing
	local map = State.Get("Map")
	local camp = map and map.MyCamp
	if camp then
		local rootY = (player.Character and player.Character:GetPivot().Position.Y) or 0
		local ring = Instance.new("Part")
		ring.Name = "BuildZone"
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.3, Config.Build.ZoneRadius * 2, Config.Build.ZoneRadius * 2)
		ring.CFrame = CFrame.new(camp.X, rootY - 2.8, camp.Z) * CFrame.Angles(0, 0, math.rad(90))
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.CastShadow = false
		ring.Material = Enum.Material.ForceField
		ring.Color = Config.Teams[team].Color
		ring.Transparency = 0.2
		ring.Parent = workspace.CurrentCamera
		zoneRing = ring
	end
	touchBar.Visible = true
	conn = RunService.RenderStepped:Connect(update)
end

function Build.Stop()
	Build.Active = false
	State.Set("Building", false)
	currentId = nil
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	if zoneRing then
		zoneRing:Destroy()
		zoneRing = nil
	end
	if touchBar then
		touchBar.Visible = false
	end
end

local function rotate(dir: number)
	yaw = (yaw + dir * Config.Build.RotateStep) % 360
end

local function place()
	if not Build.Active or not currentId or not ghostPos then
		return
	end
	if not lastValid then
		State.Emit("Notify", { Text = lastReason or "Can't build there.", Kind = "error" })
		return
	end
	Net.Event("PlaceStructure"):FireServer({ Id = currentId, Pos = ghostPos, Yaw = yaw })
end

local pickerBody: ScrollingFrame

local function renderPicker()
	UI.clear(pickerBody)
	local team = player:GetAttribute("Team") or 0
	local ms = ReplicatedStorage:FindFirstChild("MatchState")
	local level = ms and ms:GetAttribute("Bench" .. team) or 1
	local order = 0
	for _, r in Recipes.List do
		if r.Kind == "Structure" then
			order += 1
			local def = Items[r.Result]
			local locked = r.Level > level
			local b = UI.button("", { LayoutOrder = order, Size = UDim2.fromOffset(170, 120), BackgroundColor3 = if locked then Theme.Colors.PanelLight else Theme.Colors.PanelLighter, Parent = pickerBody }, function()
				if not locked then
					Panels.Close()
					Build.Begin(r.Result)
				end
			end)
			local ic = UI.icon(def.Icon.Glyph, def.Icon.Color, 48, "Square")
			ic.AnchorPoint = Vector2.new(0.5, 0)
			ic.Position = UDim2.new(0.5, 0, 0, 8)
			ic.Parent = b
			UI.text(def.Name, { Position = UDim2.fromOffset(0, 60), TextSize = 15, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
			UI.text(if locked then "🔒 Workbench Tier " .. ({ "I", "II", "III", "IV", "V" })[r.Level] else ("HP " .. tostring(def.Health) .. (if def.Limit == "Trap" then " · trap" elseif def.Stacks then " · " .. def.Stacks .. " stacks" else "")), { Position = UDim2.fromOffset(0, 84), TextSize = 13, TextColor3 = Theme.Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
		end
	end
end

function Build.Start()
	local gui = UI.new("ScreenGui", { Name = "BuildMode", ResetOnSpawn = false, DisplayOrder = 6, Parent = player:WaitForChild("PlayerGui") })
	touchBar = UI.panel({ Size = UDim2.fromOffset(460, 118), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -96), Visible = false, Parent = gui }, { UI.padding(8) })
	statusLabel = UI.text("", { Size = UDim2.new(1, 0, 0, 40), TextSize = 15, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Parent = touchBar })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 52), Parent = touchBar }, { UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
	UI.button("◀", { Size = UDim2.fromOffset(64, 52), TextSize = 26, Parent = row }, function()
		rotate(-1)
	end)
	UI.button("▶", { Size = UDim2.fromOffset(64, 52), TextSize = 26, Parent = row }, function()
		rotate(1)
	end)
	UI.button("✓ PLACE", { Size = UDim2.fromOffset(140, 52), TextSize = 20, Font = Theme.FontBlack, Tone = "Green", Parent = row }, place)
	UI.button("✖", { Size = UDim2.fromOffset(64, 52), TextSize = 22, Tone = "Red", Parent = row }, Build.Stop)
	UI.text("PC: R/Q rotate · click to place · right-click to exit", { Position = UDim2.new(0, 0, 1, -14), Size = UDim2.new(1, 0, 0, 14), TextSize = 11, TextColor3 = Theme.Colors.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = touchBar })

	pickerBody = Panels.Create("Build", "BUILD", Vector2.new(600, 330), renderPicker)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(176, 126), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = pickerBody })

	State.On("BeginBuild", Build.Begin)
	State.On("Action", function(a)
		if a.Name == "Build" and a.Down then
			if Build.Active then
				Build.Stop()
			elseif player:GetAttribute("InMatch") then
				Panels.Toggle("Build")
			end
			return
		end
		if not Build.Active then
			return
		end
		if a.Down then
			if a.Name == "Rotate" then
				rotate(if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then -1 else 1)
			elseif a.Name == "Swap" then
				rotate(-1) -- Q rotates the other way in build mode
			elseif a.Name == "Attack" and not State.Get("IsTouch") then
				place()
			elseif a.Name == "Aim" then
				Build.Stop()
			end
		end
	end)
	State.On("MatchEvent", function(ev)
		if ev.Name == "BuildResult" and ev.Data.Ok and currentId and not WALLS[currentId] then
			Build.Stop() -- single placement for non-wall structures; walls stay in build mode for chaining
		end
	end)
	player:GetAttributeChangedSignal("LifeState"):Connect(function()
		if player:GetAttribute("LifeState") ~= "Alive" then
			Build.Stop()
		end
	end)
end

return Build
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="904">
            <Properties>
              <string name="Name">Camera</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Third-person camera with limited zoom (StarterPlayer: 6–24 studs), an
-- over-the-shoulder aim mode, a crosshair, and the shared aim-direction helper
-- used by combat and building.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require("../State")
local UI = require("../UI/UI")

local CameraCtl = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

CameraCtl.Aiming = false
local deadUntil = 0

-- Player setting: Reduce motion.
local function calm(): boolean
	local prof = State.Get("Profile")
	return prof ~= nil and prof.Settings ~= nil and prof.Settings.ReduceMotion == true
end
local crosshair: Frame? = nil

local function character(): Model?
	return player.Character
end

function CameraCtl.Start()
	player.CameraMaxZoomDistance = Config.Camera.MaxZoom
	player.CameraMinZoomDistance = Config.Camera.MinZoom
	CameraCtl._feel()
	State.On("MatchEvent", function(ev)
		if ev.Name == "Died" then
			-- the world drains of colour while you wait to respawn
			deadUntil = os.clock() + ((ev.Data and ev.Data.Respawn) or 6)
		elseif ev.Name == "MatchEnded" and ev.Data and ev.Data.Won then
			CameraCtl.Victory(math.max(3, Config.Match.EndScreenLength - 1))
		end
	end)

	local gui = UI.new("ScreenGui", { Name = "Crosshair", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 3, Parent = player:WaitForChild("PlayerGui") })
	local ch = UI.new("Frame", { Size = UDim2.fromOffset(28, 28), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false, Parent = gui })
	for _, spec in { { 0, -9, 2, 7 }, { 0, 9, 2, 7 }, { -9, 0, 7, 2 }, { 9, 0, 7, 2 } } do
		UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, spec[1], 0.5, spec[2]), Size = UDim2.fromOffset(spec[3], spec[4]), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = ch }, { UI.new("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.4 }) })
	end
	UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.fromRGB(255, 200, 120), BorderSizePixel = 0, Parent = ch })
	crosshair = ch

	RunService:BindToRenderStep("SurvivalHourAim", Enum.RenderPriority.Camera.Value + 1, function()
		local char = character()
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hum or not root then
			return
		end
		-- Climber passive: faster upward climbing (the character is client-simulated).
		local bonus = (player:GetAttribute("ClimbBonus") :: number?) or 0
		if bonus > 0 and hum:GetState() == Enum.HumanoidStateType.Climbing then
			local v = root.AssemblyLinearVelocity
			if v.Y > 0.5 then
				local target = hum.WalkSpeed * 0.7 * (1 + bonus)
				if v.Y < target then
					root.AssemblyLinearVelocity = Vector3.new(v.X, target, v.Z)
				end
			end
		end
		if CameraCtl.Aiming and hum.Health > 0 then
			hum.AutoRotate = false
			local look = camera.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
			end
		else
			hum.AutoRotate = true
		end
	end)
end

-- Feel layer: one field-of-view target (aim zoom, a small sprint widen, a brief
-- damage punch) eased every frame, a tiny damage roll, and low-health /
-- exhausted screen tint. Deliberately subtle (no screen shake loops).
local punchAt = -10
local punchRoll = 0
function CameraCtl._feel()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "FeelGrade"
	cc.Parent = game:GetService("Lighting")
	State.On("Hit", function(h)
		if h.Kind == "Hurt" then
			punchAt = os.clock()
			punchRoll = (if math.random() < 0.5 then -1 else 1) * math.clamp((h.Amount or 10) / 40, 0.2, 1)
		end
	end)
	RunService:BindToRenderStep("SurvivalHourFeel", Enum.RenderPriority.Camera.Value + 2, function(dt)
		local char = character()
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local target = Config.Camera.DefaultFov
		if CameraCtl.Aiming then
			target = Config.Camera.AimFov
		elseif calm() then
			-- reduce motion: no sprint widen / damage punch
		elseif hum and player:GetAttribute("Sprinting") and hum.MoveDirection.Magnitude > 0.1 then
			target += Config.Camera.SprintFovBonus
		end
		local since = os.clock() - punchAt
		if since < 0.22 and not calm() then
			local k = 1 - since / 0.22
			target -= 3 * k
			camera.CFrame *= CFrame.Angles(0, 0, math.rad(0.8 * punchRoll * k))
		end
		camera.FieldOfView += (target - camera.FieldOfView) * math.clamp(dt * 10, 0, 1)
		-- grading: drained colour when exhausted, reddish edge of vision when badly hurt
		local inMatch = player:GetAttribute("InMatch") == true
		local low = inMatch and hum ~= nil and hum.Health > 0 and hum.Health < hum.MaxHealth * 0.3
		local tired = inMatch and player:GetAttribute("Exhausted") == true
		local dead = os.clock() < deadUntil or player:GetAttribute("LifeState") == "Eliminated"
		local sat = if dead then -0.85 else (if tired then -0.25 else 0) + (if low then -0.3 else 0)
		cc.Saturation += (sat - cc.Saturation) * math.clamp(dt * 4, 0, 1)
		local tint = if low then Color3.fromRGB(255, 225 + 15 * math.sin(os.clock() * 4), 225) else Color3.new(1, 1, 1)
		cc.TintColor = cc.TintColor:Lerp(tint, math.clamp(dt * 4, 0, 1))
	end)
end

-- Victory: a slow orbit around the winner for the end screen.
function CameraCtl.Victory(duration: number)
	local char = character()
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local center = root.Position
	local t0 = os.clock()
	camera.CameraType = Enum.CameraType.Scriptable
	RunService:BindToRenderStep("SurvivalHourVictory", Enum.RenderPriority.Camera.Value + 3, function()
		local a = (os.clock() - t0) * 0.35
		local eye = center + Vector3.new(math.cos(a) * 12, 5 + math.sin(a * 0.5), math.sin(a) * 12)
		camera.CFrame = CFrame.lookAt(eye, center + Vector3.new(0, 2, 0))
	end)
	task.delay(duration, function()
		RunService:UnbindFromRenderStep("SurvivalHourVictory")
		camera.CameraType = Enum.CameraType.Custom
	end)
end

function CameraCtl.SetAiming(on: boolean)
	if CameraCtl.Aiming == on then
		return
	end
	CameraCtl.Aiming = on
	local char = character()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		TweenService:Create(hum, TweenInfo.new(0.15), { CameraOffset = if on then Vector3.new(2.2, 0.6, 0) else Vector3.zero }):Play()
	end
	if crosshair then
		crosshair.Visible = on
	end
	if not State.Get("IsTouch") then
		UserInputService.MouseBehavior = if on then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	end
end

-- Direction from the character's head toward what the player is aiming at.
-- PC without aim: through the mouse cursor. Aiming / touch / gamepad: screen centre.
function CameraCtl.AimDirection(assist: boolean?): Vector3
	local char = character()
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then
		return camera.CFrame.LookVector
	end
	local ray: Ray
	local useMouse = not CameraCtl.Aiming and not State.Get("IsTouch") and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter
	if useMouse then
		local m = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(m.X, m.Y)
	else
		local vp = camera.ViewportSize
		ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char :: Instance }
	params.IgnoreWater = true
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	local target = if hit then hit.Position else ray.Origin + ray.Direction * 500
	local dir = target - head.Position
	if dir.Magnitude < 0.5 then
		dir = camera.CFrame.LookVector
	end
	dir = dir.Unit
	if assist and State.Get("IsTouch") then
		dir = CameraCtl._assist(head.Position, dir)
	end
	return dir
end

-- Touch aim assist: nudge toward the closest enemy/animal inside a small cone.
function CameraCtl._assist(origin: Vector3, dir: Vector3): Vector3
	local best, bestAngle = nil, math.rad(Config.Combat.AimAssistAngle)
	local myTeam = player:GetAttribute("Team")
	local function consider(part: BasePart?)
		if not part then
			return
		end
		local to = part.Position - origin
		if to.Magnitude > 200 then
			return
		end
		local ang = math.acos(math.clamp(dir:Dot(to.Unit), -1, 1))
		if ang < bestAngle then
			best, bestAngle = to.Unit, ang
		end
	end
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("InMatch") and p:GetAttribute("Team") ~= myTeam and p.Character then
			consider(p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") :: BasePart?)
		end
	end
	local match = workspace:FindFirstChild("Match")
	local wild = match and match:FindFirstChild("Wildlife")
	if wild then
		for _, m in wild:GetChildren() do
			if m:IsA("Model") then
				consider(m.PrimaryPart)
			end
		end
	end
	return best or dir
end

return CameraCtl
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="905">
            <Properties>
              <string name="Name">Combat</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Combat input → server intents. Melee/tools: tap = LIGHT attack, hold and
-- release after the wind-up = HEAVY attack (more damage, more stamina, breaks
-- guards). Aim (RMB / L2) with any melee weapon or tool = BLOCK. Bows and
-- crossbows draw on press and fire on release; guns fire on press (repeat while
-- held). The server re-validates everything (stamina, cooldowns, wind-up).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local CameraCtl = require("./Camera")
local Input = require("./Input")

local Combat = {}

local player = Players.LocalPlayer
local nextAttack = 0
local drawStart: number? = nil
local swingStart: number? = nil -- melee press time (light vs heavy)
local chargeBar: Frame
local chargeSet: (number, string?) -> ()

local function equippedId(): string
	local inv = State.Get("Inventory")
	if not inv or not inv.Equipped then
		return "Fists"
	end
	local st = inv.Slots[inv.Equipped]
	return if st then st.Id else "Fists"
end

local function canAct(): boolean
	return player:GetAttribute("InMatch") == true and player:GetAttribute("LifeState") == "Alive" and not State.Get("Building")
end

local function face(dir: Vector3)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local flat = Vector3.new(dir.X, 0, dir.Z)
		if flat.Magnitude > 0.05 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
		end
	end
end

local function drawTime(def: any): number
	local t = def.DrawTime or 0.6
	return t * ((player:GetAttribute("DrawMult") :: number?) or 1)
end

local function attackOnce(heavy: boolean?)
	local id = equippedId()
	local def = Items[id]
	if not def or def.Kind == "Utility" then
		return
	end
	local t = os.clock()
	if t < nextAttack then
		return
	end
	nextAttack = t + (def.Cooldown or 0.6) * (if heavy then Config.Combat.HeavyCooldownMult else 1)
	local dir = CameraCtl.AimDirection(true)
	if not def.Ranged then
		face(dir)
	end
	State.Emit("LocalAction", { Kind = if heavy then "Heavy" else "Attack", Item = id })
	Net.Event("Attack"):FireServer({ Dir = dir, Heavy = heavy == true })
end

local function isMelee(def: any): boolean
	return def ~= nil and not def.Ranged and (def.Kind == "Weapon" or def.Kind == "Tool")
end

local function releaseBow()
	if not drawStart then
		return
	end
	Net.Event("DrawState"):FireServer(false)
	local id = equippedId()
	local def = Items[id]
	local charge = math.clamp((os.clock() - drawStart) / drawTime(def), 0, 1)
	drawStart = nil
	chargeBar.Visible = false
	if def and def.Ranged == "Arrow" then
		local dir = CameraCtl.AimDirection(true)
		State.Emit("LocalAction", { Kind = "Release", Item = id })
		Net.Event("Attack"):FireServer({ Dir = dir, Charge = charge })
		nextAttack = os.clock() + (def.Cooldown or 0.35)
	end
	if not State.Get("AimHeld") then
		CameraCtl.SetAiming(false)
	end
end

function Combat.Start()
	local gui = UI.new("ScreenGui", { Name = "Charge", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 3, Parent = player:WaitForChild("PlayerGui") })
	chargeBar, chargeSet = UI.bar({ Size = UDim2.fromOffset(120, 10), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 26), Parent = gui }, Theme.Colors.Accent)
	chargeBar.Visible = false

	State.On("Action", function(a)
		if a.Name == "Aim" then
			State.Set("AimHeld", a.Down)
			local id = equippedId()
			if id == "Shield" or isMelee(Items[id]) then
				Net.Event("BlockState"):FireServer(a.Down and canAct())
				State.Emit("LocalAction", { Kind = if a.Down then "BlockOn" else "BlockOff", Item = id })
			elseif Items[id] and Items[id].Ranged then
				CameraCtl.SetAiming(a.Down and canAct())
			elseif not a.Down then
				CameraCtl.SetAiming(false)
			end
			return
		end
		if a.Name ~= "Attack" then
			return
		end
		if not canAct() then
			return
		end
		local id = equippedId()
		local def = Items[id]
		if not def then
			return
		end
		if def.Ranged == "Arrow" then
			if a.Down then
				if os.clock() < nextAttack then
					return
				end
				local inv = State.Get("Inventory")
				local ammo = def.AmmoType or "Arrow"
				if not inv or (inv.Ammo[ammo] or 0) <= 0 then
					State.Emit("Notify", { Text = if ammo == "Bolt" then "No bolts! Craft them at Workbench Tier IV." else "No arrows! Craft them at Workbench Tier II.", Kind = "warn" })
					return
				end
				drawStart = os.clock()
				chargeBar.Visible = true
				CameraCtl.SetAiming(true)
				State.Emit("LocalAction", { Kind = "Draw", Item = id })
				Net.Event("DrawState"):FireServer(true)
			else
				releaseBow()
			end
		elseif isMelee(def) or id == "Fists" then
			-- Melee: measure the hold; release decides light vs heavy.
			if a.Down then
				swingStart = os.clock()
			elseif swingStart then
				local held = os.clock() - swingStart
				swingStart = nil
				chargeBar.Visible = false
				attackOnce(held >= Config.Combat.HeavyWindup)
			end
		elseif a.Down then
			attackOnce()
		end
	end)

	-- Hold-to-repeat for melee/tools/guns; charge bar for bows.
	RunService.Heartbeat:Connect(function()
		if drawStart then
			local def = Items[equippedId()]
			if not def or def.Ranged ~= "Arrow" or not canAct() then
				drawStart = nil
				chargeBar.Visible = false
				CameraCtl.SetAiming(false)
				return
			end
			local c = math.clamp((os.clock() - drawStart) / drawTime(def), 0, 1)
			chargeSet(c, if c >= 1 then "FULL" else "")
		end
		-- Heavy wind-up meter while a melee press is held.
		if swingStart then
			if not canAct() or not Input.Down.Attack then
				swingStart = nil
				chargeBar.Visible = false
			else
				local c = math.clamp((os.clock() - swingStart) / Config.Combat.HeavyWindup, 0, 1)
				if c > 0.3 then
					chargeBar.Visible = true
					chargeSet(c, if c >= 1 then "HEAVY" else "")
				end
			end
		end
		-- Guns repeat while held.
		local held = Input.Down.Attack
		if held and canAct() then
			local def = Items[equippedId()]
			if def and def.Ranged == "Hitscan" then
				attackOnce()
			end
		end
	end)

	player:GetAttributeChangedSignal("LifeState"):Connect(function()
		if player:GetAttribute("LifeState") ~= "Alive" then
			drawStart = nil
			chargeBar.Visible = false
			CameraCtl.SetAiming(false)
			Net.Event("BlockState"):FireServer(false)
		end
	end)
	State.On("Inventory", function()
		local id = equippedId()
		if id ~= "Shield" and not isMelee(Items[id]) and State.Get("AimHeld") then
			Net.Event("BlockState"):FireServer(false)
		end
	end)
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="906">
            <Properties>
              <string name="Name">Craft</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Crafting panel: Workbench Tiers I–V, rope and bandages, and the
-- workbench upgrade. Costs show what you carry (+ team storage for
-- structures and upgrades, which may draw from storage).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local Net = require(Shared.Net)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")

local Craft = {}

local player = Players.LocalPlayer
local body: ScrollingFrame
local C = Theme.Colors
local matchState = ReplicatedStorage:WaitForChild("MatchState")

local function benchLevel(): number
	local team = player:GetAttribute("Team") or 0
	return (matchState:GetAttribute("Bench" .. team) :: number?) or 1
end

local function costChips(parent: Instance, cost: { [string]: number }, useStorage: boolean, x: number, y: number): boolean
	local inv = State.Get("Inventory")
	local craft = State.Get("Craft")
	local storage = craft and craft.Storage or {}
	local okAll = true
	local frame = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(x, y), Size = UDim2.new(1, -x - 130, 0, 24), Parent = parent }, { UI.list(Enum.FillDirection.Horizontal, 4) })
	local ids = {}
	for id in cost do
		table.insert(ids, id)
	end
	table.sort(ids)
	for _, id in ids do
		local need = cost[id]
		local have = (inv and inv.Resources[id] or 0) + (if useStorage then storage[id] or 0 else 0)
		local ok = have >= need
		okAll = okAll and ok
		local def = Items[id]
		UI.new("TextLabel", {
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = if ok then Color3.fromRGB(40, 70, 44) else Color3.fromRGB(80, 36, 32),
			Text = string.format(" %s %s %d/%d ", def.Icon.Glyph, def.Name, have, need),
			TextSize = 12,
			Font = Theme.FontBold,
			TextColor3 = C.Text,
			Parent = frame,
		}, { UI.corner(UDim.new(0, 6)) })
	end
	return okAll
end

local ROMAN = { "I", "II", "III", "IV", "V" }
local function tier(n: number): string
	return ROMAN[n] or tostring(n)
end

function Craft.Render()
	if not body then
		return
	end
	UI.clear(body)
	local level = benchLevel()
	local craft = State.Get("Craft")
	local near = craft and craft.NearBench
	local order = 1
	local head = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 96), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = body }, { UI.corner(UDim.new(0, 8)) })
	order += 1
	UI.text("Workbench Tier " .. tier(level) .. " / " .. tier(Recipes.MaxWorkbenchLevel), { Position = UDim2.fromOffset(10, 6), TextSize = 20, Font = Theme.FontBlack, Parent = head })
	if level < Recipes.MaxWorkbenchLevel then
		local cost = Recipes.WorkbenchUpgrades[level + 1]
		UI.text("Upgrade to Tier " .. tier(level + 1) .. " (uses your pack + your storage):", { Position = UDim2.fromOffset(10, 32), TextSize = 13, TextColor3 = C.TextDim, Parent = head })
		local ok = costChips(head, cost, true, 10, 58)
		UI.button("Upgrade", { Size = UDim2.fromOffset(116, 44), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = if ok then C.AccentDark else C.PanelLighter, Parent = head }, function()
			Net.Event("UpgradeWorkbench"):FireServer()
		end)
	else
		UI.text("Maximum level — every recipe unlocked.", { Position = UDim2.fromOffset(10, 36), TextSize = 14, TextColor3 = C.Good, Parent = head })
	end
	if not near then
		UI.text("Stand at your workbench to craft gear and upgrade. Rope can be twisted anywhere.", { LayoutOrder = order, TextSize = 13, TextColor3 = C.Warn, Parent = body })
		order += 1
	end
	local sorted = table.clone(Recipes.List)
	table.sort(sorted, function(a, b)
		return a.Order < b.Order
	end)
	local lastLevel = -1
	for _, r in sorted do
		if r.Level ~= lastLevel then
			lastLevel = r.Level
			UI.text(if r.Level == 0 then "Anywhere" else ("Tier " .. tier(r.Level) .. (if r.Level > level then "  🔒" else "")), { LayoutOrder = order, TextSize = 17, Font = Theme.FontBlack, TextColor3 = if r.Level > level then C.TextDim else C.Accent, Parent = body })
			order += 1
		end
		local def = Items[r.Result]
		local locked = r.Level > level
		local card = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 74), BackgroundColor3 = C.PanelLight, BackgroundTransparency = if locked then 0.55 else 0.15, BorderSizePixel = 0, Parent = body }, { UI.corner(UDim.new(0, 8)) })
		order += 1
		local ic = UI.icon(def.Icon.Glyph, def.Icon.Color, 46, def.Icon.Shape)
		ic.Position = UDim2.fromOffset(8, 8)
		ic.Parent = card
		UI.text(def.Name .. (if r.Count > 1 then " ×" .. r.Count else "") .. (if r.Kind == "Structure" then "  (structure)" else ""), { Position = UDim2.fromOffset(62, 4), Size = UDim2.new(1, -200, 0, 20), TextSize = 16, Font = Theme.FontBold, Parent = card })
		UI.text(def.Description, { Position = UDim2.fromOffset(62, 24), Size = UDim2.new(1, -200, 0, 18), TextSize = 12, TextColor3 = C.TextDim, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = card })
		local ok = costChips(card, r.Cost, r.Kind == "Structure", 62, 46)
		local label = if locked then "Tier " .. tier(r.Level) elseif r.Kind == "Structure" then "Place" else "Craft"
		UI.button(label, { Size = UDim2.fromOffset(110, 44), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = if locked or not ok then C.PanelLighter else C.AccentDark, Parent = card }, function()
			if locked then
				return
			end
			if r.Kind == "Structure" then
				Panels.Close()
				State.Emit("BeginBuild", r.Result)
			else
				Net.Event("Craft"):FireServer(r.Id)
			end
		end)
	end
end

function Craft.Start()
	body = Panels.Create("Craft", "WORKBENCH", Vector2.new(620, 640), Craft.Render)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = body
	local function rerender()
		if Panels.IsOpen("Craft") then
			Craft.Render()
		end
	end
	State.On("Inventory", rerender)
	State.On("Craft", rerender)
	matchState.AttributeChanged:Connect(function(attr)
		if string.sub(attr, 1, 5) == "Bench" then
			rerender()
		end
	end)
	State.On("Action", function(a)
		if a.Down and a.Name == "Craft" and player:GetAttribute("InMatch") then
			Panels.Toggle("Craft")
		end
	end)
end

return Craft
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="907">
            <Properties>
              <string name="Name">Creatures</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Procedural wildlife animation + attack warnings (client-side, nearby only).
-- Legs cycle with ground speed; telegraphs (Lunge, Roar, Swipe, Swoop) get a
-- distinct pose, a red flash and a "!" marker so players can react.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Creatures = {}

local player = Players.LocalPlayer

type Rig = { Model: Model, Motors: { [string]: Motor6D }, Phase: number, Flash: Highlight?, Warn: BillboardGui? }
local rigs: { [Model]: Rig } = {}

local function getRig(m: Model): Rig
	local r = rigs[m]
	if r then
		return r
	end
	local motors = {}
	for _, d in m:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	r = { Model = m, Motors = motors, Phase = math.random() * 10, Flash = nil, Warn = nil }
	rigs[m] = r
	return r
end

local function warnMarker(r: Rig, show: boolean)
	if show and not r.Warn then
		local root = r.Model.PrimaryPart
		if not root then
			return
		end
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(40, 40)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = root
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Text = "!"
		tl.TextScaled = true
		tl.Font = Enum.Font.GothamBlack
		tl.TextColor3 = Color3.fromRGB(255, 80, 60)
		tl.TextStrokeTransparency = 0
		tl.Parent = bb
		bb.Parent = r.Model
		r.Warn = bb
		local h = Instance.new("Highlight")
		h.FillColor = Color3.fromRGB(255, 60, 40)
		h.FillTransparency = 0.6
		h.OutlineTransparency = 0.2
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Parent = r.Model
		r.Flash = h
	elseif not show and r.Warn then
		r.Warn:Destroy()
		r.Warn = nil
		if r.Flash then
			r.Flash:Destroy()
			r.Flash = nil
		end
	end
end

local function animate(r: Rig, dt: number)
	local m = r.Model
	local root = m.PrimaryPart
	if not root then
		return
	end
	local species = m:GetAttribute("Species")
	local tele = m:GetAttribute("Telegraph") :: string?
	local teleAge = workspace:GetServerTimeNow() - ((m:GetAttribute("TelegraphAt") :: number?) or 0)
	local speed = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
	local M = r.Motors
	local active = tele ~= nil and tele ~= "Dead" and tele ~= "Strike" and teleAge < 1.2
	warnMarker(r, active)

	if species == "Bat" then
		r.Phase += dt * (if tele == "Swoop" and teleAge < 0.6 then 6 else 16)
		local flap = math.sin(r.Phase) * math.rad(55)
		if M.WingL then
			M.WingL.Transform = CFrame.Angles(0, 0, flap)
		end
		if M.WingR then
			M.WingR.Transform = CFrame.Angles(0, 0, -flap)
		end
		return
	end

	r.Phase += dt * math.clamp(speed / 3, 0, 9)
	local amp = math.rad(35) * math.clamp(speed / 10, 0, 1)
	local s = math.sin(r.Phase)
	local legs = { LegFL = s, LegBR = s, LegFR = -s, LegBL = -s }
	for name, v in legs do
		local motor = M[name]
		if motor then
			motor.Transform = CFrame.Angles(v * amp, 0, 0)
		end
	end
	local body = CFrame.identity
	local neck = CFrame.Angles(math.sin(r.Phase * 2) * math.rad(3), 0, 0)
	local t = os.clock()
	if speed < 1 and not active then
		-- idle life: breathing, looking around; prey graze with the head down
		local seed = (m:GetAttribute("AnimalId") or 0) % 7
		local look = math.sin(t * 0.7 + seed) * math.rad(20)
		if (species == "Deer" or species == "Rabbit") and math.sin(t * 0.25 + seed) > 0.3 then
			neck = CFrame.Angles(math.rad(-40), look * 0.3, 0)
		else
			neck = CFrame.Angles(math.sin(t * 1.6) * math.rad(3), look, 0)
		end
		body = CFrame.new(0, math.sin(t * 2.2 + seed) * 0.04, 0)
	end
	if tele == "Dead" then
		-- topple over instead of snapping sideways
		local k = math.clamp(teleAge / 0.6, 0, 1)
		body = CFrame.Angles(0, 0, math.rad(85 * (1 - (1 - k) ^ 2)))
	elseif active then
		if tele == "Lunge" then
			body = CFrame.Angles(math.rad(-10), 0, 0) * CFrame.new(0, -0.4, 0)
			neck = CFrame.Angles(math.rad(-15), 0, 0)
		elseif tele == "Roar" then
			body = CFrame.Angles(math.rad(18), 0, 0)
			neck = CFrame.Angles(math.rad(35), 0, 0)
			if M.LegFL then
				M.LegFL.Transform = CFrame.Angles(math.rad(-40), 0, 0)
			end
			if M.LegFR then
				M.LegFR.Transform = CFrame.Angles(math.rad(-40), 0, 0)
			end
		elseif tele == "Swipe" then
			if M.LegFR then
				M.LegFR.Transform = CFrame.Angles(math.rad(-80 + 60 * math.clamp(teleAge / 0.5, 0, 1)), 0, 0)
			end
			neck = CFrame.Angles(math.rad(-10), math.rad(15), 0)
		end
	elseif tele == "Strike" and teleAge < 0.25 then
		neck = CFrame.Angles(math.rad(-25), 0, 0)
	end
	-- startled: head up, body tense for a moment
	local alertAge = workspace:GetServerTimeNow() - ((m:GetAttribute("AlertAt") :: number?) or 0)
	if alertAge < 0.45 and tele ~= "Dead" then
		local k = math.sin(math.clamp(alertAge / 0.45, 0, 1) * math.pi)
		neck = CFrame.Angles(math.rad(35 * k), 0, 0)
		body = CFrame.Angles(math.rad(6 * k), 0, 0) * body
	end
	-- hit flinch
	local hitAge = workspace:GetServerTimeNow() - ((m:GetAttribute("HitAt") :: number?) or 0)
	if hitAge < 0.25 and tele ~= "Dead" then
		local k = math.sin(hitAge / 0.25 * math.pi)
		body = CFrame.Angles(math.rad(-6 * k), 0, math.rad(8 * k)) * body
		neck = CFrame.Angles(math.rad(15 * k), 0, 0) * neck
	end
	if M.Body then
		M.Body.Transform = body
	end
	if M.Neck then
		M.Neck.Transform = neck
	end
	if M.Tail then
		M.Tail.Transform = CFrame.Angles(0, math.sin(r.Phase * 1.5) * math.rad(20), 0)
	end
end

function Creatures.Start()
	RunService.RenderStepped:Connect(function(dt)
		local match = workspace:FindFirstChild("Match")
		local wild = match and match:FindFirstChild("Wildlife")
		local cam = workspace.CurrentCamera.CFrame.Position
		if wild then
			for _, m in wild:GetChildren() do
				if m:IsA("Model") and m.PrimaryPart and (m.PrimaryPart.Position - cam).Magnitude < 160 then
					animate(getRig(m), dt)
				end
			end
		end
		for m in rigs do
			if not m.Parent then
				rigs[m] = nil
			end
		end
	end)
	local _ = player
end

return Creatures
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="908">
            <Properties>
              <string name="Name">Dev</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Studio-only DEV panel. The server ignores these commands outside Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local Panels = require("./Panels")

local Dev = {}

local player = Players.LocalPlayer

function Dev.Start()
	if not workspace:GetAttribute("DevEnabled") then
		return
	end
	local gui = UI.new("ScreenGui", { Name = "DevButton", ResetOnSpawn = false, DisplayOrder = 30, Parent = player:WaitForChild("PlayerGui") })
	UI.button("⚙ DEV", { Size = UDim2.fromOffset(80, 36), Position = UDim2.new(0, 12, 0, 56), BackgroundColor3 = Color3.fromRGB(90, 50, 120), TextSize = 14, Parent = gui }, function()
		Panels.Toggle("Dev")
	end)
	local body = Panels.Create("Dev", "DEV TOOLS (STUDIO ONLY)", Vector2.new(640, 560))
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(196, 46), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
	local cmds = {
		{ "Start local match", "StartMatch" },
		{ "Skip phase", "SkipPhase" },
		{ "End match (my team wins)", "EndMatch" },
		{ "+20 of every material", "GiveResources" },
		{ "Give Stone Axe", "GiveItem", "StoneAxe" },
		{ "Give Stone Pickaxe", "GiveItem", "StonePickaxe" },
		{ "Give Canteen", "GiveItem", "Canteen" },
		{ "Fill canteen", "FillCanteen" },
		{ "Give Bow", "GiveItem", "Bow" },
		{ "Give Arrows", "GiveItem", "Arrow" },
		{ "Give Sword", "GiveItem", "Sword" },
		{ "Give Shield", "GiveItem", "Shield" },
		{ "Give Pistol", "GiveItem", "Pistol" },
		{ "Give Bullets", "GiveItem", "Bullet" },
		{ "Give Iron Helmet", "GiveItem", "IronHead" },
		{ "Give Iron Chest", "GiveItem", "IronChest" },
		{ "Give Crossbow", "GiveItem", "Crossbow" },
		{ "Give Bolts", "GiveItem", "Bolt" },
		{ "Give Hammer", "GiveItem", "RepairHammer" },
		{ "Give Bandages", "GiveItem", "Bandage" },
		{ "Workbench Lv 2", "BenchLevel", 2 },
		{ "Workbench Lv 3", "BenchLevel", 3 },
		{ "Workbench Lv 5", "BenchLevel", 5 },
		{ "Spawn Wolf", "SpawnAnimal", "Wolf" },
		{ "Spawn Bear", "SpawnAnimal", "Bear" },
		{ "Spawn Deer", "SpawnAnimal", "Deer" },
		{ "Spawn Boar", "SpawnAnimal", "Boar" },
		{ "Spawn Rabbit", "SpawnAnimal", "Rabbit" },
		{ "Drop care package", "DropPackage" },
		{ "Extinguish Fox fire", "Extinguish", 1 },
		{ "Extinguish Owl fire", "Extinguish", 2 },
		{ "Take 25 damage", "Damage" },
		{ "Kill me", "Kill" },
		{ "+100 diamonds", "Diamonds" },
		{ "Complete challenges", "CompleteChallenges" },
	}
	for i, c in cmds do
		UI.button(c[1], { LayoutOrder = i, TextSize = 13, BackgroundColor3 = Theme.Colors.PanelLighter, Parent = body }, function()
			Net.Event("DevCommand"):FireServer(c[2], c[3])
		end)
	end
end

return Dev
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="909">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client visual effects: arrows, gun tracers, impacts, blocks, structure
-- breaks, care-package bursts, water pouring, fire-out steam, damage vignette,
-- hit markers, Trailblazer trails, reveal highlights, Sharpshooter marks,
-- and warmth sparkles at your fire.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local ItemModels = require(Shared.Models.ItemModels)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")

local Effects = {}

local player = Players.LocalPlayer
local fxFolder: Folder
local vignette: Frame
local hitMarker: TextLabel
local arrows: { [number]: { Model: Model, Pos: Vector3, Vel: Vector3, Gravity: number, T: number } } = {}
local pourEmitters: { [Model]: ParticleEmitter } = {}
local marks: { [Player]: Highlight } = {}

local function part(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = fxFolder
	return p
end

local function burst(pos: Vector3, color: Color3, count: number, speed: number, size: number?)
	local a = part({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = pos })
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.Size = NumberSequence.new(size or 0.4, 0)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Lifetime = NumberRange.new(0.3, 0.8)
	pe.Acceleration = Vector3.new(0, -20, 0)
	pe.Rate = 0
	pe.Parent = a
	pe:Emit(count)
	Debris:AddItem(a, 2)
end

-- Pooled particle emitters (one anchored holder per effect kind, moved and
-- re-emitted) so harvesting and combat never create parts per hit.
local FX_KINDS = {
	Bark = { Colors = { Color3.fromRGB(120, 84, 52), Color3.fromRGB(196, 160, 110) }, Size = 0.32, Speed = 16, Life = 0.7, Grav = 45, Shape = "Chip" },
	Splinter = { Colors = { Color3.fromRGB(206, 176, 128), Color3.fromRGB(150, 112, 70) }, Size = 0.26, Speed = 14, Life = 0.6, Grav = 40, Shape = "Chip" },
	Stone = { Colors = { Color3.fromRGB(128, 126, 122), Color3.fromRGB(92, 90, 88) }, Size = 0.34, Speed = 15, Life = 0.6, Grav = 55, Shape = "Chip" },
	Leaves = { Colors = { Color3.fromRGB(96, 150, 70), Color3.fromRGB(150, 180, 80) }, Size = 0.4, Speed = 7, Life = 1.3, Grav = 6, Shape = "Leaf" },
	Berries = { Colors = { Color3.fromRGB(170, 40, 70), Color3.fromRGB(90, 140, 60) }, Size = 0.3, Speed = 8, Life = 0.8, Grav = 30, Shape = "Chip" },
	Spores = { Colors = { Color3.fromRGB(210, 240, 190), Color3.fromRGB(160, 220, 150) }, Size = 0.25, Speed = 3, Life = 1.6, Grav = -2, Shape = "Glow" },
	Dust = { Colors = { Color3.fromRGB(150, 138, 120), Color3.fromRGB(110, 100, 90) }, Size = 1.6, Speed = 5, Life = 1.1, Grav = -1, Shape = "Puff" },
	Water = { Colors = { Color3.fromRGB(170, 210, 255), Color3.fromRGB(230, 240, 255) }, Size = 0.4, Speed = 10, Life = 0.7, Grav = 40, Shape = "Chip" },
	Steam = { Colors = { Color3.fromRGB(230, 232, 236), Color3.fromRGB(180, 184, 190) }, Size = 2.4, Speed = 4, Life = 1.8, Grav = -6, Shape = "Puff" },
	Blood = { Colors = { Color3.fromRGB(150, 20, 20), Color3.fromRGB(90, 10, 10) }, Size = 0.25, Speed = 9, Life = 0.5, Grav = 50, Shape = "Chip" },
	Sparks = { Colors = { Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 150, 60) }, Size = 0.18, Speed = 14, Life = 0.35, Grav = 30, Shape = "Glow" },
}
local pool: { [string]: { Holder: BasePart, Emitter: ParticleEmitter } } = {}

local function emitter(kind: string)
	local e = pool[kind]
	if e and e.Holder.Parent then
		return e
	end
	local spec = FX_KINDS[kind] or FX_KINDS.Dust
	local holder = part({ Name = "Fx_" .. kind, Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Color = ColorSequence.new(spec.Colors[1], spec.Colors[2])
	pe.Lifetime = NumberRange.new(spec.Life * 0.6, spec.Life)
	pe.Speed = NumberRange.new(spec.Speed * 0.4, spec.Speed)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Acceleration = Vector3.new(0, -spec.Grav, 0)
	pe.Drag = if spec.Shape == "Puff" then 2 else 0.5
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-240, 240)
	if spec.Shape == "Puff" then
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, spec.Size * 0.5), NumberSequenceKeypoint.new(1, spec.Size * 1.6) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
		pe.SpreadAngle = Vector2.new(180, 180)
	elseif spec.Shape == "Glow" then
		pe.Size = NumberSequence.new(spec.Size, 0)
		pe.LightEmission = 1
		pe.SpreadAngle = Vector2.new(180, 180)
	else
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, spec.Size), NumberSequenceKeypoint.new(0.8, spec.Size * 0.8), NumberSequenceKeypoint.new(1, 0) })
		pe.Squash = NumberSequence.new(if spec.Shape == "Leaf" then 0.6 else 0.3)
	end
	pe.Parent = holder
	e = { Holder = holder, Emitter = pe }
	pool[kind] = e
	return e
end

-- Emits `count` particles of `kind` at pos, spraying along `dir` (default up).
local function emitAt(kind: string, pos: Vector3, count: number, dir: Vector3?)
	local e = emitter(kind)
	local d = if dir and dir.Magnitude > 0.01 then dir.Unit else Vector3.yAxis
	-- ParticleEmitters spray along the holder's +Y (EmissionDirection Top)
	e.Holder.CFrame = CFrame.lookAt(pos, pos + d) * CFrame.Angles(-math.pi / 2, 0, 0)
	e.Emitter:Emit(count)
end

-- Quick client-side jolt for a struck rock / bush / ore node (visual only).
local jolting: { [Model]: boolean } = {}
local function jolt(m: Model?, from: Vector3?)
	if not m or not m.Parent or jolting[m] then
		return
	end
	jolting[m] = true
	local home = m:GetPivot()
	local away = if from then (home.Position - from) * Vector3.new(1, 0, 1) else Vector3.zero
	local push = if away.Magnitude > 0.01 then away.Unit * 0.18 else Vector3.zero
	task.spawn(function()
		for _, k in { 1, -0.6, 0.3, 0 } do
			if not m.Parent then
				break
			end
			m:PivotTo(home + push * k)
			task.wait(0.03)
		end
		jolting[m] = nil
	end)
end

local function onFx(ev: any)
	local d = ev.Data
	local name = ev.Name
	if name == "Arrow" then
		local m = ItemModels.Held("Arrow")
		if not m then
			return
		end
		for _, x in m:GetDescendants() do
			if x:IsA("BasePart") then
				x.Anchored = true
				x.CanCollide = false
				x.CanQuery = false
			end
		end
		m.Parent = fxFolder
		arrows[d.Id] = { Model = m, Pos = d.Origin, Vel = d.Velocity, Gravity = d.Gravity, T = 0 }
	elseif name == "ArrowStop" then
		local a = arrows[d.Id]
		if a then
			arrows[d.Id] = nil
			a.Model:PivotTo(CFrame.lookAt(d.Pos, d.Pos + a.Vel))
			Debris:AddItem(a.Model, 4)
			burst(d.Pos, Color3.fromRGB(180, 150, 110), 6, 10, 0.25)
		end
	elseif name == "Shot" then
		local len = (d.End - d.Origin).Magnitude
		local beam = part({ Size = Vector3.new(0.12, 0.12, len), CFrame = CFrame.lookAt((d.Origin + d.End) / 2, d.End), Color = Color3.fromRGB(255, 230, 160), Material = Enum.Material.Neon, Transparency = 0.2 })
		TweenService:Create(beam, TweenInfo.new(0.15), { Transparency = 1 }):Play()
		Debris:AddItem(beam, 0.2)
		burst(d.Origin, Color3.fromRGB(255, 200, 120), 8, 12, 0.3)
		burst(d.End, Color3.fromRGB(160, 150, 140), 6, 8, 0.25)
	elseif name == "Impact" then
		emitAt(if d.Kind == "Structure" then "Splinter" else "Blood", d.Pos, if d.Kind == "Structure" then 10 else 6)
	elseif name == "Block" then
		emitAt("Sparks", d.Pos + Vector3.new(0, 1.5, 0), 14)
	elseif name == "StructureBreak" then
		for i = 1, 8 do
			local chunk = part({ Size = Vector3.new(1.2, 0.5, 0.8), Position = d.Pos + Vector3.new(math.random(-3, 3), math.random(1, 6), math.random(-3, 3)), Color = Color3.fromRGB(130, 92, 58), Material = Enum.Material.Wood, Anchored = false })
			chunk.AssemblyLinearVelocity = Vector3.new(math.random(-15, 15), math.random(10, 25), math.random(-15, 15))
			Debris:AddItem(chunk, 3 + i * 0.05)
		end
		burst(d.Pos + Vector3.new(0, 3, 0), Color3.fromRGB(140, 130, 120), 30, 14, 0.8)
	elseif name == "PackageOpen" then
		burst(d.Pos + Vector3.new(0, 2, 0), Color3.fromRGB(255, 170, 70), 40, 20, 0.5)
	elseif name == "Cosmetic" then
		burst(d.Pos, d.Color or Color3.new(1, 1, 1), d.Count or 25, 14, 0.7)
	elseif name == "ResourceHit" then
		-- chips fly back toward the swinger, like a real strike
		local toward = if d.From then (d.From - d.Pos) * Vector3.new(1, 0, 1) + Vector3.new(0, 1.2, 0) else nil
		-- the final blow on a node is noticeably bigger than a normal hit
		local mult = if d.Last then 2.5 else 1
		emitAt(d.Kind or "Dust", d.Pos, math.floor((if d.Kind == "Leaves" or d.Kind == "Spores" then 8 else 12) * mult), toward)
		if d.Last then
			emitAt("Dust", d.Pos, 6)
		end
		if d.Kind == "Stone" then
			emitAt("Dust", d.Pos, 3)
			emitAt("Sparks", d.Pos, 4, toward)
		end
		jolt(d.Model, d.From)
	elseif name == "ResourceBreak" then
		emitAt(d.Kind or "Dust", d.Pos, if d.Big then 40 else 22)
		emitAt("Dust", d.Pos, if d.Big then 10 else 5)
	elseif name == "PourStart" then
		emitAt("Water", d.Pos + Vector3.new(0, 2, 0), 18)
		emitAt("Steam", d.Pos + Vector3.new(0, 2, 0), 8)
	elseif name == "FireFed" then
		-- wood hits the fire: a flare of sparks and embers
		emitAt("Sparks", d.Pos + Vector3.new(0, 2, 0), math.clamp(6 + (d.Amount or 1), 8, 30))
		emitAt("Dust", d.Pos + Vector3.new(0, 1, 0), 3)
	elseif name == "BenchUpgrade" then
		emitAt("Sparks", d.Pos + Vector3.new(0, 3, 0), 30)
		emitAt("Dust", d.Pos + Vector3.new(0, 1, 0), 8)
		burst(d.Pos + Vector3.new(0, 4, 0), Color3.fromRGB(255, 210, 120), 20, 10, 0.5)
	elseif name == "Built" then
		emitAt("Dust", d.Pos + Vector3.new(0, 1, 0), 8)
		emitAt("Splinter", d.Pos + Vector3.new(0, 2, 0), 6)
	elseif name == "ToolBroke" then
		emitAt("Splinter", d.Pos, 14)
		emitAt("Sparks", d.Pos, 6)
	elseif name == "FireUpgraded" then
		-- a column of sparks and a warm burst: the fire just grew
		emitAt("Sparks", d.Pos + Vector3.new(0, 2, 0), 40)
		burst(d.Pos + Vector3.new(0, 4, 0), Color3.fromRGB(255, 170, 70), 30, 12, 0.6)
	elseif name == "Healed" then
		-- soft green motes rising around the healed player
		burst(d.Pos + Vector3.new(0, 1, 0), Color3.fromRGB(120, 240, 140), math.clamp((d.Amount or 20) // 4, 6, 25), 5, 0.35)
	elseif name == "Crafted" then
		emitAt("Sparks", d.Pos + Vector3.new(0, 1.5, 0), 10)
	elseif name == "ChestOpened" then
		local rare = d.Tier == "Rare" or d.Tier == "VeryRare"
		if rare then
			-- rare loot: a golden (very rare: violet) flare so it reads as special
			burst(d.Pos + Vector3.new(0, 2, 0), if d.Tier == "VeryRare" then Color3.fromRGB(190, 130, 255) else Color3.fromRGB(255, 205, 90), 45, 14, 0.5)
		end
		emitAt("Dust", d.Pos + Vector3.new(0, 1, 0), if rare then 6 else 3)
	elseif name == "Blood" then
		emitAt("Blood", d.Pos, 8, d.Dir)
	end
end

-- Floating damage number above what you hit (world space, fades up and out).
local function damageNumber(pos: Vector3, amount: number, color: Color3, big: boolean)
	local anchor = part({ Name = "DmgNum", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = pos + Vector3.new(math.random() - 0.5, 2.5, math.random() - 0.5) })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(if big then 110 else 70, if big then 40 else 30)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 120
	bb.Parent = anchor
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Theme.FontBlack
	tl.TextScaled = true
	tl.Text = tostring(amount)
	tl.TextColor3 = color
	tl.TextStrokeTransparency = 0.2
	tl.Parent = bb
	TweenService:Create(bb, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { StudsOffset = Vector3.new(0, 2.2, 0) }):Play()
	TweenService:Create(tl, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 0.8)
end

local function onHit(h: any)
	if h.Pos and h.Amount and (h.Kind == "Player" or h.Kind == "Animal" or h.Kind == "Headshot") then
		damageNumber(h.Pos, h.Amount, if h.Kind == "Headshot" then Color3.fromRGB(255, 205, 80) elseif h.Kind == "Animal" then Color3.fromRGB(240, 240, 240) else Color3.fromRGB(255, 120, 100), h.Kind == "Headshot")
	end
	if h.Kind == "Hurt" then
		vignette.BackgroundTransparency = 0.55
		TweenService:Create(vignette, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	else
		hitMarker.Text = if h.Kind == "Repair" then "+" .. tostring(h.Amount)
			elseif h.Kind == "Headshot" then "◎ HEADSHOT " .. tostring(h.Amount)
			elseif h.Kind == "GuardBreak" then "GUARD BROKEN"
			else "✖ " .. tostring(h.Amount)
		hitMarker.TextColor3 = if h.Kind == "Repair" then Theme.Colors.Good
			elseif h.Kind == "Structure" then Theme.Colors.Warn
			elseif h.Kind == "Headshot" or h.Kind == "GuardBreak" then Color3.fromRGB(255, 200, 80)
			else Color3.new(1, 1, 1)
		hitMarker.TextTransparency = 0
		TweenService:Create(hitMarker, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
	end
end

local function onReveal(r: any)
	for _, item in r.List do
		local pos = if typeof(item) == "Vector3" then item else item.Pos
		local target: Instance? = nil
		if r.Kind == "Animals" then
			local match = workspace:FindFirstChild("Match")
			local wild = match and match:FindFirstChild("Wildlife")
			if wild then
				for _, m in wild:GetChildren() do
					if m:GetAttribute("AnimalId") == item.Id then
						target = m
					end
				end
			end
		end
		if target then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(255, 90, 60)
			h.OutlineColor = Color3.fromRGB(255, 200, 150)
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.FillTransparency = 0.7
			h.Parent = target
			Debris:AddItem(h, r.Duration or 8)
		else
			-- Beacon pillar at the revealed spot (crates or out-of-stream animals)
			local pillar = part({ Size = Vector3.new(1.2, 40, 1.2), Position = pos + Vector3.new(0, 20, 0), Color = if r.Kind == "Crates" then Theme.Colors.Warn else Theme.Colors.Bad, Material = Enum.Material.Neon, Transparency = 0.45 })
			Debris:AddItem(pillar, r.Duration or 8)
		end
	end
end

-- Class / power-up sight: Night Owl brightens nights a little, Miner sees a
-- little better in caves. Local-only colour correction (no x-ray, no outlines).
local function senseSight()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SenseSight"
	cc.Enabled = false
	cc.Parent = game:GetService("Lighting")
	local ms = ReplicatedStorage:WaitForChild("MatchState")
	RunService.Heartbeat:Connect(function()
		local inMatch = player:GetAttribute("InMatch") == true
		local night = ms:GetAttribute("Phase") == "Night"
		local owl = inMatch and night and player:GetAttribute("Perk") == "NightOwl"
		local miner = inMatch and player:GetAttribute("Class") == "Miner" and player:GetAttribute("InCave") == true
		local b = (if owl then 0.07 else 0) + (if miner then 0.08 else 0)
		cc.Enabled = b > 0
		cc.Brightness = b
		cc.Contrast = if b > 0 then 0.05 else 0
	end)
end

function Effects.Start()
	senseSight()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "ClientFx"
	fxFolder.Parent = workspace
	local gui = UI.new("ScreenGui", { Name = "Fx", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1, Parent = player:WaitForChild("PlayerGui") })
	vignette = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(150, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui })
	hitMarker = UI.new("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 30, 0.5, -30), Size = UDim2.fromOffset(120, 30), BackgroundTransparency = 1, Font = Theme.FontBlack, TextSize = 22, TextStrokeTransparency = 0.3, TextTransparency = 1, Text = "", Parent = gui })

	State.On("Fx", onFx)
	State.On("Hit", onHit)
	State.On("Reveal", onReveal)
	State.On("MatchEvent", function(ev)
		if ev.Name == "FireOut" then
			local match = workspace:FindFirstChild("Match")
			if match then
				for _, fire in match:GetDescendants() do
					if fire.Name == "Campfire" and fire:IsA("Model") and fire:GetAttribute("Team") == ev.Data.Team and fire.PrimaryPart then
						burst(fire.PrimaryPart.Position + Vector3.new(0, 2, 0), Color3.fromRGB(220, 225, 230), 80, 18, 1.4)
					end
				end
			end
		end
	end)

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		-- arrows
		for id, a in arrows do
			a.T += dt
			a.Vel -= Vector3.new(0, a.Gravity * dt, 0)
			a.Pos += a.Vel * dt
			a.Model:PivotTo(CFrame.lookAt(a.Pos, a.Pos + a.Vel))
			if a.T > 4 then
				a.Model:Destroy()
				arrows[id] = nil
			end
		end
		acc += dt
		if acc < 0.15 then
			return
		end
		acc = 0
		-- pouring water streams + Trailblazer trails + Sharpshooter marks
		local now = workspace:GetServerTimeNow()
		local myTeam = player:GetAttribute("Team")
		for _, p in Players:GetPlayers() do
			local char = p.Character
			if char then
				local pouring = char:GetAttribute("Action") == "Pour"
				local held = char:FindFirstChild("HeldItem")
				local em = pourEmitters[char]
				if pouring and held and held:IsA("Model") and held.PrimaryPart and not em then
					local pe = Instance.new("ParticleEmitter")
					pe.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255))
					pe.Size = NumberSequence.new(0.35, 0.1)
					pe.Transparency = NumberSequence.new(0.2, 0.8)
					pe.Speed = NumberRange.new(6, 9)
					pe.Acceleration = Vector3.new(0, -40, 0)
					pe.Lifetime = NumberRange.new(0.5, 0.8)
					pe.Rate = 60
					pe.EmissionDirection = Enum.NormalId.Bottom
					pe.Parent = held.PrimaryPart
					pourEmitters[char] = pe
				elseif not pouring and em then
					em:Destroy()
					pourEmitters[char] = nil
				end
				local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and (p:GetAttribute("Bursting") or 0) > now and not root:FindFirstChild("BurstTrail") then
					local pe = Instance.new("ParticleEmitter")
					pe.Name = "BurstTrail"
					pe.Color = ColorSequence.new(Color3.fromRGB(120, 230, 150))
					pe.Size = NumberSequence.new(0.6, 0)
					pe.Lifetime = NumberRange.new(0.3, 0.5)
					pe.Rate = 40
					pe.Speed = NumberRange.new(0, 1)
					pe.LightEmission = 0.6
					pe.Parent = root
					Debris:AddItem(pe, math.max(0.2, (p:GetAttribute("Bursting") :: number) - now))
				end
				-- spawn / sunrise protection: a soft golden shimmer while it lasts
				local prot = (p:GetAttribute("ProtectedUntil") or 0) > now
				local shield = char:FindFirstChild("ProtectShimmer")
				if prot and not shield then
					local h = Instance.new("Highlight")
					h.Name = "ProtectShimmer"
					h.FillColor = Color3.fromRGB(255, 220, 130)
					h.FillTransparency = 0.82
					h.OutlineColor = Color3.fromRGB(255, 235, 170)
					h.OutlineTransparency = 0.35
					h.DepthMode = Enum.HighlightDepthMode.Occluded
					h.Parent = char
				elseif not prot and shield then
					shield:Destroy()
				end
				local marked = p ~= player and p:GetAttribute("MarkedTeam") == myTeam and (p:GetAttribute("MarkedUntil") or 0) > now
				if marked and not marks[p] then
					local h = Instance.new("Highlight")
					h.FillColor = Color3.fromRGB(255, 60, 60)
					h.FillTransparency = 0.75
					h.OutlineColor = Color3.fromRGB(255, 120, 120)
					h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					h.Parent = char
					marks[p] = h
				elseif not marked and marks[p] then
					marks[p]:Destroy()
					marks[p] = nil
				end
			end
		end
		for char, em in pourEmitters do
			if not char.Parent then
				em:Destroy()
				pourEmitters[char] = nil
			end
		end
	end)
	player:GetAttributeChangedSignal("Warming"):Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			burst(root.Position + Vector3.new(0, 1, 0), Color3.fromRGB(255, 190, 110), 4, 3, 0.3)
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="910">
            <Properties>
              <string name="Name">Guide</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Survival Guide: a compact objective tracker for new players (onboarding).
-- One short line at a time, derived from what the player actually has and has
-- done, so it never blocks play and never shows a wall of text. It hides once
-- the basics are done, for experienced accounts (level 8+), or when dismissed.
-- Contextual one-off tips (first night, Night 3, first death, final life) use
-- the HUD announcer.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")

local Guide = {}

local player = Players.LocalPlayer
local C = Theme.Colors

local frame: Frame
local stepLabel: TextLabel
local textLabel: TextLabel
local dismissed = false
local fed = false
local built = false
local lastFuel: number? = nil
local shownTips: { [string]: boolean } = {}

local function hasItem(inv: any, pattern: string): boolean
	for _, st in inv.Slots or {} do
		if st and type(st.Id) == "string" and string.find(st.Id, pattern) then
			return true
		end
	end
	return false
end

local function res(inv: any, id: string): number
	return (inv.Resources and inv.Resources[id]) or 0
end

-- Steps in order: { text, done() }.
local STEPS = {
	{ "Pick up sticks, stones and fibre by hand (walk up and press E)", function(inv)
		return res(inv, "Stick") + res(inv, "Stone") >= 4 or hasItem(inv, "Axe")
	end },
	{ "Craft a Crude Axe — open CRAFT (C)", function(inv)
		return hasItem(inv, "Axe")
	end },
	{ "Chop trees for Wood (small tree = 4 Wood)", function(inv)
		return res(inv, "Wood") >= 4 or fed
	end },
	{ "Feed your fire: hold E at your Campfire (1 Wood = +2% fuel)", function()
		return fed
	end },
	{ "Upgrade your Workbench to Tier II — CRAFT (C)", function()
		local craft = State.Get("Craft")
		return craft ~= nil and (craft.Level or 1) >= 2
	end },
	{ "Build walls or storage near your fire — BUILD (B)", function()
		return built
	end },
}

local function tip(key: string, title: string, sub: string, color: Color3?)
	if shownTips[key] then
		return
	end
	shownTips[key] = true
	local Hud = require("./Hud")
	Hud.Announce(title, sub, color or C.Accent, 4)
end

local function refresh()
	local inMatch = player:GetAttribute("InMatch") == true
	local profile = State.Get("Profile")
	local veteran = profile ~= nil and ((profile.Level or 1) >= 8 or (profile.Settings and profile.Settings.ShowGuide == false))
	local inv = State.Get("Inventory")
	local step, total = nil, #STEPS
	if inv then
		for i, s in STEPS do
			if not s[2](inv) then
				step = i
				break
			end
		end
	end
	local show = inMatch and not dismissed and not veteran and step ~= nil and player:GetAttribute("LifeState") == "Alive"
	if show and step then
		local text = STEPS[step][1]
		if textLabel.Text ~= text then
			textLabel.Text = text
			stepLabel.Text = string.format("SURVIVAL GUIDE · %d/%d", step, total)
			-- small nudge when the objective changes
			local pop = frame:FindFirstChildOfClass("UIScale") :: UIScale
			pop.Scale = 1.06
			TweenService:Create(pop, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Scale = 1 }):Play()
		end
	end
	frame.Visible = show
end

function Guide.Start()
	local gui = UI.new("ScreenGui", { Name = "Guide", ResetOnSpawn = false, DisplayOrder = 2, Parent = player:WaitForChild("PlayerGui") })
	frame = UI.panel({ Size = UDim2.fromOffset(330, 58), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -190), Visible = false, Parent = gui }, { UI.padding(8), UI.new("UIScale", {}) })
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = C.Accent
	end
	stepLabel = UI.text("SURVIVAL GUIDE", { Size = UDim2.new(1, -30, 0, 14), TextSize = 11, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = frame })
	textLabel = UI.text("", { Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -4, 0, 26), TextSize = 13, Font = Theme.FontBold, TextWrapped = true, Parent = frame })
	UI.Buttons.icon("✖", { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 4, 0, -4), TextSize = 12, Parent = frame }, function()
		dismissed = true
		frame.Visible = false
	end)

	-- progress signals
	player:GetAttributeChangedSignal("FireFuel"):Connect(function()
		local f = player:GetAttribute("FireFuel") :: number?
		if f and lastFuel and f > lastFuel + 0.005 then
			fed = true
		end
		lastFuel = f
	end)
	State.On("Notify", function(n)
		if type(n.Text) == "string" and (string.find(n.Text, "^Built") or string.find(n.Text, "placed")) then
			built = true
		end
	end)
	State.On("Fx", function(ev)
		if ev.Name == "Built" then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and ev.Data and ev.Data.Pos and (root.Position - ev.Data.Pos).Magnitude < 30 then
				built = true
			end
		end
	end)
	State.On("Inventory", refresh)
	State.On("Craft", refresh)

	-- contextual tips (once per session)
	local ms = ReplicatedStorage:WaitForChild("MatchState")
	State.On("MatchEvent", function(ev)
		local d = ev.Data or {}
		if ev.Name == "Phase" and d.Phase == "Night" and d.Day == 1 then
			tip("night1", "🌙 FIRST NIGHT", "Predators hunt at night. Stay near your fire's light and keep it fed.", C.Night)
		elseif ev.Name == "Phase" and d.ProtectionEnded then
			tip("night3", "⚠ FIRES ARE EXPOSED", "Enemies can now snuff your fire with water. Guard it — and raid theirs.", C.Bad)
		elseif ev.Name == "Died" and not d.Final then
			tip("death", "YOU'LL RESPAWN AT YOUR FIRE", "Only materials drop. Tools, armour and your backpack are kept.", C.Warn)
		elseif ev.Name == "FireOut" and d.Team == player:GetAttribute("Team") then
			tip("final", "FINAL LIFE", "Your fire is out. One more death and you're eliminated — play carefully.", C.Bad)
		elseif ev.Name == "ReturnedToLobby" or ev.Name == "Loading" then
			fed, built, lastFuel = false, false, nil
		end
	end)
	player:GetAttributeChangedSignal("InMatch"):Connect(refresh)
	player:GetAttributeChangedSignal("LifeState"):Connect(refresh)
	ms:GetAttributeChangedSignal("Phase"):Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			refresh()
		end
	end)
end

return Guide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="911">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Match HUD: phase/timer, clan fire strip, health/lives/pack/pouches, hotbar,
-- class / power-up badge, channel progress, death / revive / eliminated screens,
-- announcements, kill feed, fire alerts and the victory/defeat screen.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Products = require(Shared.Products)
local Classes = require(Shared.Classes)
local Perks = require(Shared.Perks)
local Net = require(Shared.Net)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")

local Hud = {}

local player = Players.LocalPlayer
local matchState = ReplicatedStorage:WaitForChild("MatchState") :: Folder
local gui: ScreenGui
local C = Theme.Colors

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Live Robux price (regional pricing aware). Cached per session only.
local priceCache: { [number]: string } = {}
function Hud.PriceText(key: string): string
	local p = Products.ByKey[key]
	if not p then
		return "?"
	end
	if p.ProductId == 0 then
		return if workspace:GetAttribute("DevEnabled") then "DEV (free sim)" else "Unavailable"
	end
	if priceCache[p.ProductId] then
		return priceCache[p.ProductId]
	end
	priceCache[p.ProductId] = "…"
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(p.ProductId, Enum.InfoType.Product)
		end)
		if not ok then
			-- Older engine builds only have the deprecated synchronous name.
			ok, info = pcall(function()
				return (MarketplaceService :: any):GetProductInfo(p.ProductId, Enum.InfoType.Product)
			end)
		end
		if ok and info and info.PriceInRobux then
			priceCache[p.ProductId] = "R$ " .. tostring(info.PriceInRobux)
		else
			priceCache[p.ProductId] = "R$ ?"
		end
		State.Emit("PricesUpdated", true)
	end)
	return priceCache[p.ProductId]
end

-- Top: phase + clan strip -----------------------------------------------------------------------

local phaseLabel: TextLabel
local phasePill: Frame
local teamBadges: { Frame } = {}

local function buildTop()
	phasePill = UI.panel({ Name = "Phase", Size = UDim2.fromOffset(250, 40), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Parent = gui })
	phaseLabel = UI.text("", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.FontBlack, TextSize = 22, Parent = phasePill })
	local strip = UI.new("Frame", { Name = "Teams", BackgroundTransparency = 1, Size = UDim2.fromOffset(4 * 92, 34), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50), Parent = gui }, { UI.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center) })
	for t, def in Config.Teams do
		local b = UI.panel({ Name = "T" .. t, LayoutOrder = t, Size = UDim2.fromOffset(88, 32), Parent = strip })
		UI.text(def.Symbol, { Name = "Sym", Size = UDim2.fromOffset(24, 32), Position = UDim2.fromOffset(4, 0), TextColor3 = def.Color, Font = Theme.FontBlack, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
		UI.text("", { Name = "Info", Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(28, 0), TextSize = 14, Font = Theme.FontBold, Parent = b })
		teamBadges[t] = b
	end
end

local function refreshTop()
	local phase = matchState:GetAttribute("Phase") or "Idle"
	local ends = matchState:GetAttribute("PhaseEnds") or 0
	local day = matchState:GetAttribute("Day") or 0
	local remaining = math.max(0, ends - now())
	if phase == "Day" then
		phaseLabel.Text = "☀  DAY " .. day .. "   " .. UI.fmtTime(remaining)
		phaseLabel.TextColor3 = C.Day
	elseif phase == "Night" then
		phaseLabel.Text = "🌙  NIGHT " .. day .. "   " .. UI.fmtTime(remaining)
		phaseLabel.TextColor3 = C.Night
	elseif phase == "Intro" then
		phaseLabel.Text = "GET READY   " .. UI.fmtTime(remaining)
		phaseLabel.TextColor3 = C.Accent
	elseif phase == "Loading" then
		phaseLabel.Text = "PREPARING THE FOREST…"
		phaseLabel.TextColor3 = C.TextDim
	elseif phase == "Ended" then
		phaseLabel.Text = "MATCH OVER"
		phaseLabel.TextColor3 = C.Accent
	else
		phaseLabel.Text = ""
	end
	local myTeam = player:GetAttribute("Team")
	for t, b in teamBadges do
		local fire = matchState:GetAttribute("Fire" .. t)
		local standing = matchState:GetAttribute("Standing" .. t)
		local alive = matchState:GetAttribute("Alive" .. t) or 0
		local info = b:FindFirstChild("Info") :: TextLabel
		if not standing then
			info.Text = "✖ OUT"
			info.TextColor3 = C.TextDim
			b.BackgroundTransparency = 0.5
		else
			info.Text = (if fire then "🔥" else "✖🔥") .. " " .. alive .. "♟"
			info.TextColor3 = if fire then C.Text else C.Bad
			b.BackgroundTransparency = 0.12
		end
		local stroke = b:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if t == myTeam then Config.Teams[t].Color else C.Stroke
			stroke.Thickness = if t == myTeam then 3 else 1.5
		end
	end
end

-- Bottom-left: vitals ------------------------------------------------------------------------------

local healthSet: (number, string?) -> ()
local staminaSet: (number, string?) -> ()
local livesLabel: TextLabel
local packLabel: TextLabel
local pouchLabel: TextLabel
local vitals: Frame

local function buildVitals()
	vitals = UI.panel({ Name = "Vitals", Size = UDim2.fromOffset(270, 132), Position = UDim2.new(0, 12, 1, -144), Parent = gui }, { UI.padding(8) })
	local hb, sb
	hb, healthSet = UI.bar({ Size = UDim2.new(1, 0, 0, 24), Parent = vitals }, Color3.fromRGB(200, 70, 60))
	hb.Name = "Health"
	sb, staminaSet = UI.bar({ Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 14), Parent = vitals }, Color3.fromRGB(90, 170, 90))
	sb.Name = "Stamina"
	livesLabel = UI.text("", { Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 22), Font = Theme.FontBold, TextSize = 16, Parent = vitals })
	packLabel = UI.text("", { Position = UDim2.fromOffset(0, 68), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Parent = vitals })
	pouchLabel = UI.text("", { Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, TextColor3 = C.TextDim, Parent = vitals })
end

local function refreshVitals()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		healthSet(hum.Health / math.max(1, hum.MaxHealth), string.format("♥ %d / %d", math.ceil(hum.Health), hum.MaxHealth))
	end
	local st = player:GetAttribute("Stamina") or 100
	local stMax = player:GetAttribute("MaxStamina") or 100
	staminaSet(st / math.max(1, stMax), if player:GetAttribute("Exhausted") then "EXHAUSTED" else "")
	local free = player:GetAttribute("FreeRespawns") or 0
	local team = player:GetAttribute("Team") or 0
	local fire = matchState:GetAttribute("Fire" .. team)
	if fire and free < 0 then
		-- Unlimited respawns while the fire burns: show the fire's level and fuel instead.
		local fuel = player:GetAttribute("FireFuel") or 0
		local lvl = player:GetAttribute("FireLevel") or 1
		local state = if fuel < 0.05 then "  CRITICAL!" elseif fuel < 0.15 then "  LOW FUEL" else ""
		livesLabel.Text = string.format("🔥 Fire L%d · fuel %d%%", lvl, math.floor(fuel * 100 + 0.5)) .. state
		-- thin fuel bar under the label: ember orange → amber → pulsing red
		local back = livesLabel:FindFirstChild("FuelBack") :: Frame?
		if not back then
			back = UI.new("Frame", { Name = "FuelBack", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 2), Size = UDim2.new(0.9, 0, 0, 4), BackgroundColor3 = Color3.fromRGB(15, 12, 10), BorderSizePixel = 0, Parent = livesLabel }, {
				UI.corner(UDim.new(0, 2)),
				UI.new("Frame", { Name = "FuelBar", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, { UI.corner(UDim.new(0, 2)) }),
			})
		end
		local b = (back :: Frame):FindFirstChild("FuelBar") :: Frame
		b.Size = UDim2.fromScale(math.clamp(fuel, 0, 1), 1)
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 8)
		b.BackgroundColor3 = if fuel < 0.15 then C.Bad:Lerp(Color3.new(1, 1, 1), 0.3 * pulse) elseif fuel < 0.4 then C.Warn else C.Accent
		livesLabel.TextColor3 = if fuel < 0.05 then C.Bad elseif fuel < 0.15 then C.Warn else C.Text
	elseif fire then
		local flames = string.rep("🔥", math.min(free, 10))
		livesLabel.Text = "Respawns: " .. flames .. "  (" .. free .. " left)"
		livesLabel.TextColor3 = C.Text
	else
		livesLabel.Text = "✖ FIRE OUT — FINAL LIFE"
		livesLabel.TextColor3 = C.Bad
	end
	-- Final Life: a thin, slowly breathing red frame round the screen edge (never covers play)
	local finalLife = not fire and player:GetAttribute("LifeState") == "Alive"
	local edge = gui:FindFirstChild("FinalLifeEdge") :: Frame?
	if finalLife and not edge then
		edge = UI.new("Frame", { Name = "FinalLifeEdge", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Active = false, ZIndex = 40, Parent = gui }, {
			UI.new("UIStroke", { Color = C.Bad, Thickness = 6, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		})
	end
	if edge then
		edge.Visible = finalLife
		local stroke = edge:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 0.45 + 0.35 * (0.5 + 0.5 * math.sin(os.clock() * 2.4))
		end
	end
	local inv = State.Get("Inventory")
	if inv then
		local total = 0
		for _, n in inv.Resources do
			total += n
		end
		local used = inv.SlotsUsed or 0
		packLabel.Text = string.format("Pack %d/%d slots   ", used, inv.Capacity) .. (if used >= inv.Capacity then "FULL" else "")
		packLabel.TextColor3 = if used >= inv.Capacity then C.Warn else C.Text
		pouchLabel.Text = string.format("✚ Bandages %d (H)   🏹 %d   • %d", inv.Bandages, inv.Ammo.Arrow or 0, inv.Ammo.Bullet or 0)
	end
end

-- Hotbar -------------------------------------------------------------------------------------------

local hotbar: Frame
local SLOTS = { { "Fists", "`" }, { "Weapon1", "1" }, { "Weapon2", "2" }, { "Tool", "3" }, { "Tool2", "4" }, { "Utility", "5" } }

local function buildHotbar()
	hotbar = UI.new("Frame", { Name = "Hotbar", BackgroundTransparency = 1, Size = UDim2.fromOffset(6 * 70, 78), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Parent = gui }, { UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom) })
end

local function refreshHotbar()
	local inv = State.Get("Inventory")
	UI.clear(hotbar)
	if not inv then
		return
	end
	for i, s in SLOTS do
		local slot, key = s[1], s[2]
		local stack = if slot == "Fists" then { Id = "Fists" } else inv.Slots[slot]
		local equipped = (inv.Equipped == false and slot == "Fists") or inv.Equipped == slot
		local btn = UI.new("TextButton", {
			Name = slot,
			LayoutOrder = i,
			Size = UDim2.fromOffset(64, 72),
			Text = "",
			Parent = hotbar,
		})
		-- kit style: the equipped slot gets the gold "selected" rim and glow
		UI.Buttons.decorate(btn, "Neutral", UDim.new(0, 10))
		if equipped then
			UI.Buttons.setState(btn, "Selected")
		end
		if stack then
			local def = Items[stack.Id]
			local ic = UI.icon(def.Icon.Glyph, def.Icon.Color, 40, def.Icon.Shape)
			ic.Position = UDim2.fromOffset(12, 6)
			ic.Parent = btn
			UI.text(def.Name, { Position = UDim2.fromOffset(2, 48), Size = UDim2.new(1, -4, 0, 14), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.FontBold, Parent = btn })
			if stack.Durability and def.Durability then
				local bar = UI.new("Frame", { Position = UDim2.new(0, 6, 1, -6), Size = UDim2.new((stack.Durability / def.Durability) * 0.83, 0, 0, 3), BackgroundColor3 = if stack.Durability / def.Durability < 0.25 then C.Bad else C.Good, BorderSizePixel = 0, Parent = btn })
				bar.Name = "Durability"
			end
			if stack.Id == "Canteen" then
				UI.text(if stack.Filled then "FULL" else "EMPTY", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 14), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = if stack.Filled then C.Info else C.TextDim, Font = Theme.FontBlack, Parent = btn })
			end
		else
			UI.text("empty", { Position = UDim2.fromOffset(0, 26), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.TextDim, Parent = btn })
		end
		if not State.Get("IsTouch") then
			UI.text(key, { Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(16, 14), TextSize = 12, TextColor3 = C.Accent, Font = Theme.FontBlack, Parent = btn })
		end
		btn.Activated:Connect(function()
			if slot == "Fists" then
				Net.Event("Equip"):FireServer(nil)
			elseif stack then
				Net.Event("Equip"):FireServer(slot)
			end
		end)
	end
end

-- Loadout badge (class + power-up; locked for the match) -------------------------------------------

local abilityFrame: Frame
local abilityText: TextLabel

local function buildAbility()
	abilityFrame = UI.panel({ Name = "Ability", Size = UDim2.fromOffset(150, 60), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 186, 1, -14), Parent = gui })
	abilityText = UI.text("", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.FontBold, TextSize = 13, Parent = abilityFrame })
	abilityText.ZIndex = 3
end

local function refreshAbility()
	local cls = Classes.ById[player:GetAttribute("Class") or ""]
	local perk = Perks.ById[player:GetAttribute("Perk") or ""]
	abilityFrame.Visible = cls ~= nil and player:GetAttribute("LifeState") == "Alive"
	if not cls then
		return
	end
	local burst = (player:GetAttribute("Bursting") or 0) > now()
	abilityText.Text = cls.Glyph .. " " .. cls.Name .. "\n" .. (if perk then perk.Glyph .. " " .. perk.Name else "no power-up") .. (if burst then "  ❤!" else "")
	local stroke = abilityFrame:FindFirstChildOfClass("UIStroke")
	if stroke then
		local col = if burst and perk then perk.Color else cls.Color
		stroke.Color = Color3.fromRGB(col[1], col[2], col[3])
	end
end

-- Channel progress ------------------------------------------------------------------------------------

local channel: { Id: number, Label: string, Duration: number, Start: number, Hold: boolean }? = nil
local channelFrame: Frame
local channelSet: (number, string?) -> ()
local channelHint: TextLabel

local function buildChannel()
	channelFrame = UI.panel({ Name = "Channel", Size = UDim2.fromOffset(360, 64), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -170), Visible = false, Parent = gui }, { UI.padding(8) })
	local bar
	bar, channelSet = UI.bar({ Size = UDim2.new(1, 0, 0, 26), Parent = channelFrame }, C.Accent)
	bar.Name = "Bar"
	channelHint = UI.text("", { Position = UDim2.fromOffset(0, 30), TextSize = 13, TextColor3 = C.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = channelFrame })
end

-- Center overlays -----------------------------------------------------------------------------------------

local announce: TextLabel
local sub: TextLabel

local function buildAnnounce()
	announce = UI.text("", { Name = "Announce", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.new(0.8, 0, 0, 60), TextSize = 42, Font = Theme.FontBlack, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, TextTransparency = 1, Parent = gui })
	sub = UI.text("", { Name = "Sub", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 44), Size = UDim2.new(0.8, 0, 0, 28), TextSize = 20, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, TextTransparency = 1, Parent = gui })
end

function Hud.Announce(text: string, subtext: string?, color: Color3?, hold: number?)
	announce.Text = text
	announce.TextColor3 = color or C.Text
	sub.Text = subtext or ""
	announce.TextTransparency = 0
	sub.TextTransparency = 0
	announce.TextStrokeTransparency = 0.3
	local token = {}
	Hud._announceToken = token
	task.delay(hold or 3, function()
		if Hud._announceToken ~= token then
			return
		end
		local info = TweenInfo.new(0.6)
		TweenService:Create(announce, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(sub, info, { TextTransparency = 1 }):Play()
	end)
end
Hud._announceToken = nil :: any

-- Kill feed -------------------------------------------------------------------------------------------------

local feed: Frame
local function buildFeed()
	feed = UI.new("Frame", { Name = "Feed", BackgroundTransparency = 1, Size = UDim2.fromOffset(330, 200), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 262), Parent = gui }, { UI.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right) })
end

local function teamTag(t: number?): string
	local def = t and Config.Teams[t]
	return if def then def.Symbol .. " " else ""
end

local function pushFeed(text: string, color: Color3?)
	local row = UI.panel({ Size = UDim2.fromOffset(330, 26), LayoutOrder = math.floor(os.clock() * 100), Parent = feed })
	UI.text(text, { Size = UDim2.fromScale(1, 1), TextSize = 14, Font = Theme.FontBold, TextColor3 = color or C.Text, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
	local pad = UI.padding(4)
	pad.Parent = row
	task.delay(7, function()
		row:Destroy()
	end)
	local rows = {}
	for _, c in feed:GetChildren() do
		if c:IsA("Frame") then
			table.insert(rows, c)
		end
	end
	if #rows > 6 then
		table.sort(rows, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		rows[1]:Destroy()
	end
end

-- Death / revive / eliminated ------------------------------------------------------------------------------

local deathFrame: Frame
local deathTitle: TextLabel
local deathSub: TextLabel
local reviveBtn: TextButton
local teamRevive: Frame
local pendingRevives: { [number]: { Name: string, Ends: number } } = {}
local lastKilledBy: string? = nil

local function buildDeath()
	deathFrame = UI.panel({ Name = "Death", Size = UDim2.fromOffset(420, 150), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Visible = false, Parent = gui }, { UI.padding(12) })
	deathTitle = UI.text("", { Size = UDim2.new(1, 0, 0, 34), TextSize = 28, Font = Theme.FontBlack, TextXAlignment = Enum.TextXAlignment.Center, Parent = deathFrame })
	deathSub = UI.text("", { Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 40), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.TextDim, Parent = deathFrame })
	reviveBtn = UI.button("", { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.new(0, 0, 1, -46), BackgroundColor3 = Color3.fromRGB(40, 110, 60), Visible = false, Parent = deathFrame }, function()
		Net.Event("RequestRevive"):FireServer(player.UserId)
	end)
	teamRevive = UI.new("Frame", { Name = "TeamRevive", BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 200), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.45, 0), Parent = gui }, { UI.list(Enum.FillDirection.Vertical, 6) })
end

local function refreshDeath()
	local st = player:GetAttribute("LifeState")
	local inMatch = player:GetAttribute("InMatch")
	if not inMatch or st == "Alive" or st == "Lobby" or matchState:GetAttribute("Phase") == "Ended" then
		deathFrame.Visible = false
	else
		deathFrame.Visible = true
		if st == "Respawning" then
			deathTitle.Text = "YOU DIED"
			deathTitle.TextColor3 = C.Bad
			local free = player:GetAttribute("FreeRespawns") or 0
			local left = math.max(0, math.ceil((player:GetAttribute("RespawnAt") or 0) - now()))
			deathSub.Text = if free < 0 then string.format("Respawning at your campfire in %d s…", left) else "Respawning at your campfire… (" .. free .. " free respawns left)"
			if lastKilledBy then
				deathSub.Text = lastKilledBy .. "\n" .. deathSub.Text
			end
			reviveBtn.Visible = false
		elseif st == "AwaitingRevive" then
			local left = math.max(0, (player:GetAttribute("WindowEnds") or 0) - now())
			local tier = player:GetAttribute("ReviveTier") or 1
			deathTitle.Text = "OUT OF RESPAWNS  " .. UI.fmtTime(left)
			deathTitle.TextColor3 = C.Warn
			local lock = player:GetAttribute("ReviveLockBy") or 0
			local profile = State.Get("Profile")
			local credit = false
			if profile and profile.Credits and profile.Credits.Revive then
				for t = tier, Config.Lives.MaxReviveTier do
					if (profile.Credits.Revive[tostring(t)] or 0) > 0 then
						credit = true
					end
				end
			end
			if lock ~= 0 and lock ~= player.UserId then
				deathSub.Text = "A teammate is buying your revive…"
			else
				deathSub.Text = "Your fire still burns. Revive now or teammates can pay for you. Revive #" .. tier .. " this match."
			end
			reviveBtn.Visible = true
			reviveBtn.Text = if credit then "Revive (use credit)" else "Revive  —  " .. Hud.PriceText(Products.ReviveKey(tier))
		else
			deathTitle.Text = "ELIMINATED"
			deathTitle.TextColor3 = C.Bad
			deathSub.Text = "Spectating. Stay until the end: if your clan wins, you still earn the win reward."
			reviveBtn.Visible = false
		end
	end
	-- Teammate revive cards (created once, text refreshed; buttons aren't rebuilt mid-tap)
	for uid, info in pendingRevives do
		local mate = Players:GetPlayerByUserId(uid)
		local card = teamRevive:FindFirstChild("R" .. uid) :: Frame?
		if not mate or mate:GetAttribute("LifeState") ~= "AwaitingRevive" then
			pendingRevives[uid] = nil
			if card then
				card:Destroy()
			end
		else
			if not card then
				local newCard = UI.panel({ Name = "R" .. uid, Size = UDim2.fromOffset(300, 62), Parent = teamRevive }, { UI.padding(6) })
				UI.text("", { Name = "Title", Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = Theme.FontBold, Parent = newCard })
				UI.button("", { Name = "Pay", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 22), TextSize = 14, BackgroundColor3 = Color3.fromRGB(40, 110, 60), Parent = newCard }, function()
					Net.Event("RequestRevive"):FireServer(uid)
				end)
				card = newCard
			end
			local c = card :: Frame
			local left = math.max(0, (mate:GetAttribute("WindowEnds") or 0) - now())
			local tier = mate:GetAttribute("ReviveTier") or 1
			local lock = mate:GetAttribute("ReviveLockBy") or 0
			;(c:FindFirstChild("Title") :: TextLabel).Text = info.Name .. " needs a revive  " .. UI.fmtTime(left)
			;(c:FindFirstChild("Pay") :: TextButton).Text = if lock ~= 0 and lock ~= player.UserId then "Someone is paying…" else "Pay revive  " .. Hud.PriceText(Products.ReviveKey(tier))
		end
	end
end

-- End screen ------------------------------------------------------------------------------------------------

-- Brief full-screen colour flash (fire out, snuff alarm). Never blocks input.
local flashFrame: Frame? = nil
function Hud.Flash(color: Color3, from: number, duration: number)
	if not flashFrame then
		flashFrame = UI.new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundTransparency = 1, Active = false, ZIndex = 50, Parent = gui })
	end
	local f = flashFrame :: Frame
	f.BackgroundColor3 = color
	f.BackgroundTransparency = from
	TweenService:Create(f, TweenInfo.new(duration, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
end

-- Chest item reveal: a small card listing what was found, framed in the chest's
-- rarity colour. Common chests get a quiet card; rare ones a brighter frame.
local RARITY = {
	Common = Color3.fromRGB(190, 190, 190),
	Uncommon = Color3.fromRGB(110, 200, 110),
	Rare = Color3.fromRGB(90, 150, 240),
	VeryRare = Color3.fromRGB(190, 120, 255),
}
function Hud.LootReveal(d: any)
	local color = RARITY[d.Tier] or RARITY.Common
	local rare = d.Tier == "Rare" or d.Tier == "VeryRare"
	local n = #(d.Items or {})
	local card = UI.panel({ Name = "LootReveal", Size = UDim2.fromOffset(300, 46 + 24 * n), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.58, 0), Parent = gui }, { UI.padding(10) })
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
		stroke.Thickness = if rare then 3 else 1.5
	end
	local label = ({ Common = "COMMON CHEST", Uncommon = "UNCOMMON CHEST", Rare = "RARE CHEST", VeryRare = "VERY RARE CHEST" })[d.Tier] or "CHEST"
	UI.text(label, { Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Theme.FontBlack, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	for i, it in d.Items or {} do
		local def = Items[it.Id]
		UI.text(string.format("%s%s", if (it.Count or 1) > 1 then it.Count .. "× " else "", if def then def.Name else tostring(it.Id)), {
			Position = UDim2.fromOffset(0, 4 + 22 * i), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card,
		})
	end
	local pop = UI.new("UIScale", { Scale = 0.7, Parent = card })
	TweenService:Create(pop, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(if rare then 4 else 2.6, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

local function showEnd(data: any)
	local won = data.Won
	local winner = data.Winner
	local frame = UI.panel({ Name = "EndScreen", Size = UDim2.fromOffset(460, 230), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Parent = gui }, { UI.padding(16) })
	-- the result card lands with a short pop (rewards feel earned, not sluggish)
	local pop = UI.new("UIScale", { Scale = 0.6, Parent = frame })
	TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	UI.text(if won then "VICTORY" else "DEFEAT", { Size = UDim2.new(1, 0, 0, 56), TextSize = 50, Font = Theme.FontBlack, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = if won then C.Accent else C.Bad, Parent = frame })
	local wdef = Config.Teams[winner]
	UI.text(if wdef then (wdef.Symbol .. " " .. wdef.Name .. " clan kept their fire burning!") else "No clan survived.", { Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 26), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Parent = frame })
	local sum = data.Summary or {}
	local ORD = { "1st", "2nd", "3rd" }
	if sum.Place then
		UI.text("Placed " .. (ORD[sum.Place] or (tostring(sum.Place) .. "th")) .. " of " .. tostring(sum.Of or "?"), { Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 22), TextSize = 17, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Parent = frame })
	end
	local bits = { "+" .. tostring(sum.XP or 0) .. " XP", "+" .. tostring(sum.Coins or 0) .. " Coins" }
	if (data.Diamonds or 0) > 0 then
		table.insert(bits, "+" .. data.Diamonds .. " ◆")
	end
	UI.text(table.concat(bits, "   "), { Position = UDim2.fromOffset(0, 116), Size = UDim2.new(1, 0, 0, 32), TextSize = 26, Font = Theme.FontBlack, TextColor3 = if (data.Diamonds or 0) > 0 then C.Diamond else C.Accent, TextXAlignment = Enum.TextXAlignment.Center, Parent = frame })
	if (sum.Levels or 0) > 0 then
		UI.text("LEVEL UP → " .. tostring(sum.Level), { Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 22), TextSize = 18, Font = Theme.FontBold, TextColor3 = C.Good, TextXAlignment = Enum.TextXAlignment.Center, Parent = frame })
	end
	local stats = sum.Stats
	if stats then
		local line = string.format("Day %d  ·  ⚔ %d kills  ·  🐾 %d animals  ·  ◈ %d chests", sum.Nights or 0, stats.Kills or 0, stats.Animals or 0, stats.Chests or 0)
		UI.text(line, { Position = UDim2.fromOffset(0, 176), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = C.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = frame })
	end
	UI.text("Returning to the lobby shortly…", { Position = UDim2.new(0, 0, 1, -24), TextSize = 14, TextColor3 = C.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = frame })
	task.delay(Config.Match.EndScreenLength + 2, function()
		frame:Destroy()
	end)
end

-- Events ---------------------------------------------------------------------------------------------------------

local function onMatchEvent(ev: any)
	local d = ev.Data or {}
	local name = ev.Name
	if name == "Phase" then
		if d.ProtectionEnded then
			Hud.Announce("🔥 NIGHT " .. tostring(d.Day) .. " — FIRES EXPOSED", "Campfire protection is over. Fires can be snuffed day and night.", C.Bad, 5)
		elseif d.Phase == "Night" then
			Hud.Announce("🌙 NIGHT " .. tostring(d.Day), if d.SnuffOpen then "Wildlife roams. Enemy fires can be snuffed." else "Wildlife roams. Fires are protected until Night 3.", C.Night)
		else
			Hud.Announce("☀ DAY " .. tostring(d.Day), "Gather, build, and keep your fire fed.", C.Day)
		end
	elseif name == "Intro" then
		Hud.Announce("SURVIVAL HOUR", "Protect your fire. Last clan with a flame wins.", C.Accent, 5)
	elseif name == "Loading" then
		Hud.Announce("PREPARING THE FOREST…", "Building a new forest layout", C.TextDim, 6)
	elseif name == "FireOut" then
		local def = Config.Teams[d.Team]
		local mine = d.Team == player:GetAttribute("Team")
		if mine then
			-- this is the moment everything changes: a dark-red flash and a lingering banner
			Hud.Announce("YOUR FIRE IS OUT", "No more respawns. One death and you're eliminated.", C.Bad, 6)
			Hud.Flash(Color3.fromRGB(120, 0, 0), 0.35, 1.6)
		else
			Hud.Announce((def and def.Symbol or "") .. " " .. (def and def.Name or "?") .. " FIRE EXTINGUISHED", if d.By then "Put out by " .. d.By else nil, C.Warn, 4)
		end
		pushFeed("✖🔥 " .. teamTag(d.Team) .. (def and def.Name or "") .. " fire is out", C.Warn)
	elseif name == "Death" then
		local killer = if d.Killer then teamTag(d.KillerTeam) .. d.Killer else tostring(d.Cause)
		pushFeed(killer .. "  ⚔  " .. teamTag(d.VictimTeam) .. d.Victim .. (if d.Eliminated then "  [OUT]" else ""), if d.Eliminated then C.Bad else C.Text)
		if d.KillerId == player.UserId and d.Victim ~= player.DisplayName then
			-- kill confirm for the attacker: a quick, punchy centre banner
			Hud.Announce(if d.Eliminated then "✖ ELIMINATED " .. string.upper(d.Victim) else "⚔ YOU DOWNED " .. string.upper(d.Victim), nil, if d.Eliminated then C.Accent else C.Good, 1.8)
		end
	elseif name == "Died" then
		lastKilledBy = if d.Killer then "Killed by " .. d.Killer elseif d.Cause == "Animal" then "Killed by wildlife" elseif d.Cause then "Cause: " .. tostring(d.Cause) else nil
	elseif name == "TeamEliminated" then
		local def = Config.Teams[d.Team]
		pushFeed(teamTag(d.Team) .. (def and def.Name or "") .. " clan eliminated", C.Bad)
	elseif name == "TeammateNeedsRevive" then
		pendingRevives[d.UserId] = { Name = d.Name, Ends = d.Ends }
	elseif name == "FireUnderAttack" then
		local dirs = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
		local dir = if d.Bearing then dirs[math.floor(((d.Bearing + 22.5) % 360) / 45) + 1] else nil
		Hud.Announce("⚠ YOUR FIRE IS BEING SNUFFED!", (if dir then "Raider on the " .. dir .. " side — " else "") .. "hit them or make them move to stop it", C.Bad, 3)
		Hud.Flash(Color3.fromRGB(200, 40, 20), 0.75, 0.6)
	elseif name == "Upgraded" then
		local roman = ({ "I", "II", "III", "IV", "V" })[d.Level or 1] or tostring(d.Level)
		if d.What == "Workbench" then
			Hud.Announce("⚒ WORKBENCH TIER " .. roman, "New recipes unlocked — open CRAFT", C.Good, 3.5)
		else
			Hud.Announce("🔥 CAMPFIRE LEVEL " .. tostring(d.Level), "Burns longer and takes longer to snuff", C.Accent, 3.5)
		end
	elseif name == "ToolBroke" then
		pushFeed("⚒ " .. tostring(d.Name) .. " broke — craft a new one", C.Warn)
	elseif name == "LootReveal" then
		Hud.LootReveal(d)
	elseif name == "StorageRaided" then
		local dirs = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
		local dir = if d.Bearing then dirs[math.floor(((d.Bearing + 22.5) % 360) / 45) + 1] else nil
		Hud.Announce("⚠ STORAGE RAID", "Someone is at your " .. tostring(d.Name or "storage") .. (if dir then " (" .. dir .. " side)" else ""), C.Warn, 2.5)
	elseif name == "RaidNoise" then
		pushFeed(if d.Loud then "💥 An explosion nearby — someone is raiding" else "🔨 Banging nearby — someone is breaching storage", C.TextDim)
	elseif name == "TrapAlert" then
		Hud.Announce("⚠ TRAP", tostring(d.Text), C.Warn, 3)
	elseif name == "CampRevealed" then
		local def = Config.Teams[d.Team]
		pushFeed("🧭 " .. tostring(d.By) .. " found the " .. (def and def.Name or "?") .. " camp", C.Info)
	elseif name == "CarePackage" then
		Hud.Announce("✚ CARE PACKAGE INCOMING", (if d.Source == "Paid" and d.Buyer then "Called in by " .. d.Buyer .. " — " else "") .. "Marked on your map", C.Accent, 3)
	elseif name == "PackageCalled" then
		pushFeed("✚ " .. tostring(d.Buyer) .. " called a care package" .. (if d.AtDawn then " (arrives at dawn)" else ""), C.Accent)
	elseif name == "CarePackageLanded" then
		pushFeed("✚ The care package has landed — race for it!", C.Accent)
	elseif name == "CarePackageOpened" then
		pushFeed("✚ " .. teamTag(d.ByTeam) .. tostring(d.By) .. " opened a care package", C.TextDim)
	elseif name == "MatchEnded" then
		showEnd(d)
	elseif name == "FireCritical" then
		Hud.Announce("🔥 YOUR FIRE IS DYING", "Add Wood now or you lose your respawns", C.Bad, 4)
	elseif name == "Sunset" then
		Hud.Announce("🌅 SUNSET", "Night falls soon — get back to your fire.", C.Warn, 3)
	elseif name == "Reward" then
		pushFeed(string.format("+%d XP%s  %s", d.XP or 0, if (d.Coins or 0) > 0 then "  +" .. d.Coins .. " Coins" else "", tostring(d.Line or "")), C.Accent)
	elseif name == "HurtCue" then
		local dirs = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
		local dir = dirs[math.floor((((d.Bearing or 0) + 22.5) % 360) / 45) + 1]
		pushFeed("👣 Someone got hurt to the " .. dir, C.Warn)
	elseif name == "Eliminated" then
		Hud.Announce("ELIMINATED", if d.Cause == "FireOut" then "Your fire went out while you were down." else "Spectating.", C.Bad, 4)
	elseif name == "ReturnedToLobby" then
		pendingRevives = {}
		lastKilledBy = nil
	end
end

local closingId = 0
local function onChannel(s: any)
	if s.Kind then
		channel = { Id = s.Id, Label = s.Label, Duration = s.Duration, Start = os.clock(), Hold = s.Hold }
		channelFrame.Visible = true
		channelHint.Text = (if s.Hold then "Keep holding · " else "") .. "Taking damage or moving away cancels"
		channelHint.TextColor3 = C.TextDim
	elseif channel and s.Id == channel.Id then
		channel = nil -- stop the live progress update
		closingId = s.Id
		if s.Cancelled then
			channelHint.Text = "✖ " .. tostring(s.Reason)
			channelHint.TextColor3 = C.Bad
			channelSet(0, "Cancelled")
		else
			channelSet(1, "Done ✓")
		end
		local id = s.Id
		task.delay(if s.Cancelled then 1.2 else 0.4, function()
			if channel == nil and closingId == id then
				channelFrame.Visible = false
			end
		end)
	end
end

function Hud.Start()
	gui = UI.new("ScreenGui", { Name = "Hud", ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = 2, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	UI.new("UIScale", { Parent = gui, Name = "Scale" })
	buildTop()
	buildVitals()
	buildHotbar()
	buildAbility()
	buildChannel()
	buildAnnounce()
	buildFeed()
	buildDeath()

	State.On("Inventory", refreshHotbar)
	State.On("IsTouch", refreshHotbar)
	State.On("MatchEvent", onMatchEvent)
	State.On("Channel", onChannel)
	State.On("PricesUpdated", refreshDeath)

	local scale = gui:FindFirstChild("Scale") :: UIScale
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1100, vp.Y / 620), 0.62, 1.2)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	-- Match servers: shown while waiting for every matched player to arrive.
	local waiting = UI.panel({ Name = "Waiting", Size = UDim2.fromOffset(460, 110), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Visible = false, Parent = gui }, { UI.padding(14) })
	UI.text("SURVIVAL HOUR", { Size = UDim2.new(1, 0, 0, 36), TextSize = 30, Font = Theme.FontBlack, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center, Parent = waiting })
	UI.text("Waiting for every clan member to arrive, then building a new forest…", { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 40), TextSize = 15, TextColor3 = C.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = waiting })

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		local inMatch = player:GetAttribute("InMatch") == true
		waiting.Visible = not inMatch and workspace:GetAttribute("ServerMode") == "Match"
		for _, c in gui:GetChildren() do
			if c:IsA("GuiObject") and c.Name ~= "Announce" and c.Name ~= "Sub" and c.Name ~= "EndScreen" then
				if c.Name == "Death" or c.Name == "Channel" or c.Name == "Ability" or c.Name == "Waiting" or c.Name == "FinalLifeEdge" then
					continue
				end
				c.Visible = inMatch
			end
		end
		if channel and channelFrame.Visible then
			local frac = (os.clock() - channel.Start) / channel.Duration
			channelSet(frac, channel.Label .. string.format("  %.1fs", math.max(0, channel.Duration - (os.clock() - channel.Start))))
		end
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		if inMatch then
			refreshTop()
			refreshVitals()
			refreshAbility()
			refreshDeath()
		else
			deathFrame.Visible = false
			abilityFrame.Visible = false
			teamRevive.Visible = false
			local edge = gui:FindFirstChild("FinalLifeEdge") :: GuiObject?
			if edge then
				edge.Visible = false
			end
		end
		teamRevive.Visible = inMatch
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="912">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Unified input: keyboard/mouse, gamepad and on-screen touch controls all map
-- to named actions, emitted as State "Action" events { Name, Down }.
--
-- PC:      LMB attack/draw · RMB aim/block · 1-5 slots · Shift sprint · ` fists · Q swap weapons
--          X ability · H bandage · I inventory · C craft · B build · M map
-- Gamepad: R2 attack · L2 aim/block · R1 swap · L1 bandage · Y ability
--          DPad ←/→ cycle slots · Select map
-- Touch:   on-screen buttons (bottom-right cluster + top-right menu buttons)

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")

local State = require("../State")
local UI = require("../UI/UI")

local Input = {}

local player = Players.LocalPlayer

local KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.One] = "Slot1",
	[Enum.KeyCode.Two] = "Slot2",
	[Enum.KeyCode.Three] = "Slot3",
	[Enum.KeyCode.Four] = "Slot4",
	[Enum.KeyCode.Five] = "Slot5",
	[Enum.KeyCode.LeftShift] = "Sprint",
	[Enum.KeyCode.ButtonL3] = "Sprint",
	[Enum.KeyCode.Backquote] = "Fists",
	[Enum.KeyCode.Q] = "Swap",
	[Enum.KeyCode.H] = "Bandage",
	[Enum.KeyCode.I] = "Inventory",
	[Enum.KeyCode.C] = "Craft",
	[Enum.KeyCode.B] = "Build",
	[Enum.KeyCode.M] = "Map",
	[Enum.KeyCode.R] = "Rotate",
	[Enum.KeyCode.ButtonR2] = "Attack",
	[Enum.KeyCode.ButtonL2] = "Aim",
	[Enum.KeyCode.ButtonR1] = "Swap",
	[Enum.KeyCode.ButtonL1] = "Bandage",
	[Enum.KeyCode.DPadRight] = "NextSlot",
	[Enum.KeyCode.DPadLeft] = "PrevSlot",
	[Enum.KeyCode.ButtonSelect] = "Map",
}

Input.IsTouch = false
Input.Down = {} :: { [string]: boolean }

local function emit(name: string, down: boolean)
	Input.Down[name] = down
	State.Emit("Action", { Name = name, Down = down })
end
Input.Emit = emit

function Input.Start()
	Input.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	State.Set("IsTouch", Input.IsTouch)

	UserInputService.InputBegan:Connect(function(io, processed)
		if io.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			emit("Attack", true)
			return
		elseif io.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
			emit("Aim", true)
			return
		end
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		local name = KEYS[io.KeyCode]
		if name then
			emit(name, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 then
			if Input.Down.Attack then
				emit("Attack", false)
			end
			return
		elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
			if Input.Down.Aim then
				emit("Aim", false)
			end
			return
		end
		local name = KEYS[io.KeyCode]
		if name and Input.Down[name] then
			emit(name, false)
		end
	end)

	UserInputService.LastInputTypeChanged:Connect(function(t)
		local touch = t == Enum.UserInputType.Touch
		if touch ~= Input.IsTouch then
			Input.IsTouch = touch
			State.Set("IsTouch", touch)
		end
	end)

	Input._buildTouch()
end

-- Touch controls ---------------------------------------------------------------------------

function Input._buildTouch()
	if not UserInputService.TouchEnabled then
		return
	end
	local gui = UI.new("ScreenGui", {
		Name = "TouchControls",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local function round(name: string, glyph: string, label: string, size: number, pos: UDim2, action: string, hold: boolean, tone: string)
		local b = UI.Buttons.round(glyph, label, size, tone, { Name = name, Position = pos, AnchorPoint = Vector2.new(0.5, 0.5), Parent = gui })
		b.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				b:SetAttribute("Down", true)
				UI.Buttons.refresh(b)
				emit(action, true)
				if not hold then
					emit(action, false)
				end
			end
		end)
		b.InputEnded:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				b:SetAttribute("Down", nil)
				UI.Buttons.refresh(b)
				if hold and Input.Down[action] then
					emit(action, false)
				end
			end
		end)
		return b
	end
	-- Bottom-right combat cluster (clear of the default jump button, which sits lower-right).
	local attack = round("Attack", "🗡", "ATTACK", 92, UDim2.new(1, -170, 1, -200), "Attack", true, "Red")
	round("Aim", "🛡", "AIM / BLOCK", 66, UDim2.new(1, -275, 1, -155), "Aim", true, "Blue")
	round("Bandage", "✚", "HEAL", 60, UDim2.new(1, -85, 1, -285), "Bandage", false, "Green")
	round("Swap", "⇄", "SWAP", 56, UDim2.new(1, -170, 1, -320), "Swap", false, "Neutral")
	State.Set("TouchAttackButton", attack)

	-- Menu buttons (top right, below the Roblox top bar)
	local menu = UI.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(4 * 62, 58),
		Position = UDim2.new(1, -12, 0, GuiService:GetGuiInset().Y + 196), -- below the minimap
		AnchorPoint = Vector2.new(1, 0),
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right) })
	for i, spec in { { "Inventory", "🎒", "BAG" }, { "Craft", "🔨", "CRAFT" }, { "Build", "🧱", "BUILD" }, { "Map", "🗺", "MAP" } } do
		local b = UI.Buttons.tile(spec[3], nil, spec[2], { Name = spec[1], LayoutOrder = i, Size = UDim2.fromOffset(58, 58), Parent = menu })
		b.Activated:Connect(function()
			emit(spec[1], true)
			emit(spec[1], false)
		end)
	end

	-- Only show combat buttons in a match while alive.
	local function refresh()
		local inMatch = player:GetAttribute("InMatch") == true
		local alive = player:GetAttribute("LifeState") == "Alive"
		for _, c in gui:GetChildren() do
			if c:IsA("GuiObject") and c.Name ~= "Menu" then
				c.Visible = inMatch and alive and Input.IsTouch
			end
		end
		menu.Visible = inMatch and Input.IsTouch
	end
	player:GetAttributeChangedSignal("InMatch"):Connect(refresh)
	player:GetAttributeChangedSignal("LifeState"):Connect(refresh)
	State.On("IsTouch", refresh)
	refresh()
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="913">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Inventory panel + equip/swap/bandage/drop actions.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local InventoryModel = require(Shared.Logic.InventoryModel)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")

local Inventory = {}

local player = Players.LocalPlayer
local body: ScrollingFrame
local C = Theme.Colors
local SLOT_LABEL = { Weapon1 = "Weapon 1", Weapon2 = "Weapon 2", Tool = "Tool 1", Tool2 = "Tool 2", Utility = "Utility", ArmorHead = "Head (worn)", ArmorChest = "Chest (worn)", ArmorLegs = "Legs (worn)", Backpack = "Backpack (worn)" }
local RES = InventoryModel.ResourceIds

local function section(title: string, order: number)
	UI.text(title, { LayoutOrder = order, TextSize = 18, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = body })
end

local function row(order: number, height: number?): Frame
	return UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, height or 54), BackgroundColor3 = C.PanelLight, BackgroundTransparency = 0.2, BorderSizePixel = 0, Parent = body }, { UI.corner(UDim.new(0, 8)) })
end

function Inventory.Render()
	if not body then
		return
	end
	UI.clear(body)
	local inv = State.Get("Inventory")
	if not inv then
		UI.text("No inventory outside a match.", { Parent = body })
		return
	end
	local total = 0
	for _, n in inv.Resources do
		total += n
	end
	section("Equipment", 1)
	local order = 2
	for _, slot in { "Weapon1", "Weapon2", "Tool", "Tool2", "Utility", "ArmorHead", "ArmorChest", "ArmorLegs", "Backpack" } do
		local piece = string.match(slot, "^Armor(%a+)$")
		local stack = if piece then (inv.Armor or {})[piece] elseif slot == "Backpack" then inv.Backpack else inv.Slots[slot]
		local r = row(order)
		order += 1
		UI.text(SLOT_LABEL[slot], { Position = UDim2.fromOffset(62, 4), Size = UDim2.new(0.5, 0, 0, 16), TextSize = 12, TextColor3 = C.TextDim, Parent = r })
		if stack and stack ~= false then
			local def = Items[stack.Id]
			local ic = UI.icon(def.Icon.Glyph, def.Icon.Color, 44, def.Icon.Shape)
			ic.Position = UDim2.fromOffset(6, 5)
			ic.Parent = r
			local extra = ""
			if stack.Durability and def.Durability then
				extra = string.format("  ·  %d/%d", stack.Durability, def.Durability)
			end
			if stack.Id == "Canteen" then
				extra = if stack.Filled then "  ·  FULL" else "  ·  empty"
			end
			UI.text(def.Name .. extra, { Position = UDim2.fromOffset(62, 20), Size = UDim2.new(1, -250, 0, 22), TextSize = 16, Font = Theme.FontBold, Parent = r })
			if def.Slots then
				extra = "  ·  " .. def.Slots .. " slots"
			end
			if not piece and slot ~= "Backpack" then
				UI.button(if inv.Equipped == slot then "Equipped" else "Equip", { Size = UDim2.fromOffset(92, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -104, 0.5, 0), TextSize = 14, BackgroundColor3 = if inv.Equipped == slot then C.AccentDark else C.PanelLighter, Parent = r }, function()
					Net.Event("Equip"):FireServer(slot)
				end)
			end
			UI.button("Drop", { Size = UDim2.fromOffset(88, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), TextSize = 14, BackgroundColor3 = Color3.fromRGB(90, 44, 38), Parent = r }, function()
				Net.Event("DropItem"):FireServer({ Slot = slot })
			end)
		else
			UI.text("— empty —", { Position = UDim2.fromOffset(62, 20), TextSize = 15, TextColor3 = C.TextDim, Parent = r })
		end
	end
	local sw = row(order, 48)
	order += 1
	UI.button("⇄ Swap weapon slots (Q)", { Size = UDim2.new(1, -12, 0, 40), Position = UDim2.fromOffset(6, 4), TextSize = 15, Parent = sw }, function()
		Net.Event("SwapWeapons"):FireServer()
	end)

	section("Pouches", order)
	order += 1
	local pr = row(order, 54)
	order += 1
	UI.text(string.format("✚ Bandages %d/3   🏹 Arrows %d   ➶ Bolts %d   • Bullets %d", inv.Bandages, inv.Ammo.Arrow or 0, inv.Ammo.Bolt or 0, inv.Ammo.Bullet or 0), { Position = UDim2.fromOffset(10, 14), Size = UDim2.new(1, -130, 0, 24), TextSize = 16, Parent = pr })
	UI.button("Use bandage", { Size = UDim2.fromOffset(116, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), TextSize = 14, BackgroundColor3 = Color3.fromRGB(110, 40, 44), Parent = pr }, function()
		Net.Event("UseBandage"):FireServer()
	end)

	local used = inv.SlotsUsed or 0
	section(string.format("Pack  %d / %d slots  (%d items)", used, inv.Capacity, total), order)
	order += 1
	local _, setCap = UI.bar({ Size = UDim2.new(1, -8, 0, 14), LayoutOrder = order, Parent = body }, if used >= inv.Capacity then C.Warn else C.Good)
	order += 1
	setCap(used / math.max(1, inv.Capacity))
	for _, id in RES do
		local n = inv.Resources[id] or 0
		local def = Items[id]
		local r = row(order, 50)
		order += 1
		local ic = UI.icon(def.Icon.Glyph, def.Icon.Color, 38, "Square")
		ic.Position = UDim2.fromOffset(6, 6)
		ic.Parent = r
		UI.text(def.Name .. "  ×" .. n, { Position = UDim2.fromOffset(54, 14), Size = UDim2.new(1, -250, 0, 22), TextSize = 16, Font = Theme.FontBold, TextColor3 = if n > 0 then C.Text else C.TextDim, Parent = r })
		if n > 0 then
			UI.button("Drop 1", { Size = UDim2.fromOffset(80, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -96, 0.5, 0), TextSize = 13, Parent = r }, function()
				Net.Event("DropItem"):FireServer({ Resource = id, Count = 1 })
			end)
			UI.button("Drop all", { Size = UDim2.fromOffset(80, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), TextSize = 13, BackgroundColor3 = Color3.fromRGB(90, 44, 38), Parent = r }, function()
				Net.Event("DropItem"):FireServer({ Resource = id, Count = n })
			end)
		end
		if (def.Food or def.Heal) and n > 0 then
			UI.button(if def.Heal then "Use" else "Eat", { Size = UDim2.fromOffset(80, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -184, 0.5, 0), TextSize = 13, BackgroundColor3 = Color3.fromRGB(60, 110, 60), Parent = r }, function()
				Net.Event("Eat"):FireServer(id)
			end)
		end
		if id == "Rope" then
			UI.button("Twist rope (3 fibre)", { Size = UDim2.fromOffset(150, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -184, 0.5, 0), TextSize = 13, BackgroundColor3 = C.AccentDark, Parent = r }, function()
				Net.Event("Craft"):FireServer("Rope")
			end)
		end
	end
	UI.text("Carried materials drop on death. Tools, weapons, armour, ammo and bandages are kept.", { LayoutOrder = order, TextSize = 13, TextColor3 = C.TextDim, Parent = body })
end

local slotCycle = { "Fists", "Weapon1", "Weapon2", "Tool", "Tool2", "Utility" }

local function equip(slot: string?)
	Net.Event("Equip"):FireServer(slot)
end

function Inventory.Start()
	body = Panels.Create("Inventory", "INVENTORY", Vector2.new(560, 620), Inventory.Render)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = body
	State.On("Inventory", function()
		if Panels.IsOpen("Inventory") then
			Inventory.Render()
		end
	end)
	State.On("Action", function(a)
		if not a.Down or not player:GetAttribute("InMatch") then
			return
		end
		local n = a.Name
		if n == "Inventory" then
			Panels.Toggle("Inventory")
		elseif n == "Slot1" then
			equip("Weapon1")
		elseif n == "Slot2" then
			equip("Weapon2")
		elseif n == "Slot3" then
			equip("Tool")
		elseif n == "Slot4" then
			equip("Tool2")
		elseif n == "Slot5" then
			equip("Utility")
		elseif n == "Fists" then
			equip(nil)
		elseif n == "Swap" then
			if not State.Get("Building") then
				Net.Event("SwapWeapons"):FireServer()
			end
		elseif n == "Bandage" then
			Net.Event("UseBandage"):FireServer()
		elseif n == "NextSlot" or n == "PrevSlot" then
			local inv = State.Get("Inventory")
			if not inv then
				return
			end
			local cur = if inv.Equipped then table.find(slotCycle, inv.Equipped) or 1 else 1
			for step = 1, #slotCycle do
				local i = ((cur - 1 + (if n == "NextSlot" then step else -step)) % #slotCycle) + 1
				local s = slotCycle[i]
				if s == "Fists" or inv.Slots[s] then
					equip(if s == "Fists" then nil else s)
					break
				end
			end
		end
	end)
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="914">
            <Properties>
              <string name="Name">Lobby</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Lobby interface: ready button + matchmaking status, party management,
-- Classes and Power-ups (Diamonds), the cosmetic Locker (Coins), Profile &
-- Rewards (level, daily / weekly bonus, leaderboards), the Coin shop, and a
-- how-to-play page.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Classes = require(Shared.Classes)
local Perks = require(Shared.Perks)
local Cosmetics = require(Shared.Cosmetics)
local Progression = require(Shared.Progression)
local Products = require(Shared.Products)
local Net = require(Shared.Net)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")
local Hud = require("./Hud")
local Buttons = require("../UI/Buttons")

local Lobby = {}

local player = Players.LocalPlayer
local C = Theme.Colors
local gui: ScreenGui
local setReady: (string, string?, string?) -> () = function() end
local statusLabel: TextLabel
local partyStrip: Frame
local diamondsLabel: TextLabel
local levelLabel: TextLabel
local coinPill: TextLabel
local diamondPill: TextLabel
local xpSet: (number, string?) -> () = function() end
local shownCoins, shownDiamonds = -1, -1

-- Counts a currency label up/down to its new value (short, never blocks input).
local function countTo(label: TextLabel, from: number, to: number)
	if from < 0 or from == to then
		label.Text = tostring(to)
		return
	end
	local v = Instance.new("NumberValue")
	v.Value = from
	v.Changed:Connect(function(x)
		label.Text = tostring(math.floor(x + 0.5))
	end)
	local tw = TweenService:Create(v, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Value = to })
	tw.Completed:Once(function()
		label.Text = tostring(to)
		v:Destroy()
	end)
	tw:Play()
	-- a small flash so gains are noticed
	local up = to > from
	label.TextColor3 = if up then Color3.fromRGB(160, 255, 140) else Color3.fromRGB(255, 140, 120)
	task.delay(0.7, function()
		label.TextColor3 = if label == coinPill then Color3.fromRGB(242, 193, 78) else C.Diamond
	end)
end
local partyBody: ScrollingFrame
local classBody: ScrollingFrame
local perkBody: ScrollingFrame
local lockerBody: ScrollingFrame
local profileBody: ScrollingFrame
local shopBody: ScrollingFrame
local lockerType = "Outfit"
local titleUp = false -- lobby HUD stays hidden behind the title screen
local refreshVis: () -> () = function() end
local helpBody: ScrollingFrame

local function send(action: string, extra: { [string]: any }?)
	local req = extra and table.clone(extra) or {}
	req.Action = action
	Net.Event("LobbyAction"):FireServer(req)
end

-- HUD ---------------------------------------------------------------------------------------

local function renderHud()
	local lobby = State.Get("Lobby")
	local profile = State.Get("Profile")
	if profile then
		local cls = Classes.ById[profile.Class]
		local perk = profile.Perk and Perks.ById[profile.Perk]
		diamondsLabel.Text = string.format("%s %s · %s", if cls then cls.Glyph else "", if cls then cls.Name else "?", if perk then perk.Glyph .. " " .. perk.Name else "no power-up")
		levelLabel.Text = tostring(profile.Level or 1)
		if (profile.LevelNeed or 0) > 0 then
			xpSet(profile.LevelInto / profile.LevelNeed, string.format("%d / %d XP", profile.LevelInto, profile.LevelNeed))
		else
			xpSet(1, "MAX LEVEL")
		end
		countTo(coinPill, shownCoins, profile.Coins or 0)
		countTo(diamondPill, shownDiamonds, profile.Diamonds or 0)
		shownCoins, shownDiamonds = profile.Coins or 0, profile.Diamonds or 0
	end
	if not lobby then
		return
	end
	if lobby.Queued then
		setReady("READY UP", "Searching… tap to cancel", "Normal")
	elseif lobby.Ready then
		setReady("READY UP ✓", "Waiting for your party", "Normal")
	else
		setReady("READY UP", nil, "Normal")
	end
	local q = lobby.Queue or {}
	if lobby.Queued then
		statusLabel.Text = string.format("In queue %s · %d searching · matches start at %d players (fills to %d)%s", UI.fmtTime(lobby.QueuedFor or 0), q.Searching or 0, lobby.MinPlayers, lobby.MaxPlayers, if q.Mode == "Local" then " · STUDIO LOCAL MODE" else "")
	else
		statusLabel.Text = "Ready up here or stand in the glowing ring. Parties of up to 4 stay together."
	end
	UI.clear(partyStrip)
	for i, m in lobby.Members do
		UI.text((if m.Ready then "✓ " else "○ ") .. m.Name .. (if m.Leader then " ★" else ""), {
			LayoutOrder = i,
			Size = UDim2.fromOffset(150, 24),
			TextSize = 14,
			Font = Theme.FontBold,
			TextColor3 = if m.Ready then C.Good else C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = partyStrip,
		})
	end
end

-- Party panel ------------------------------------------------------------------------------------

local function renderParty()
	UI.clear(partyBody)
	local lobby = State.Get("Lobby")
	if not lobby then
		return
	end
	UI.text("Your party (" .. #lobby.Members .. "/4)", { LayoutOrder = 1, TextSize = 18, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = partyBody })
	for i, m in lobby.Members do
		local r = UI.new("Frame", { LayoutOrder = 1 + i, Size = UDim2.new(1, -8, 0, 48), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = partyBody }, { UI.corner(UDim.new(0, 8)) })
		UI.text((if m.Leader then "★ " else "") .. m.Name .. (if m.Ready then "   ✓ ready" else "   not ready"), { Position = UDim2.fromOffset(10, 12), Size = UDim2.new(1, -120, 0, 24), TextSize = 16, Parent = r })
		if lobby.IsLeader and m.UserId ~= player.UserId then
			Buttons.action("👤 Kick", { Size = UDim2.fromOffset(100, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Tone = "Red", Parent = r }, function()
				send("Kick", { UserId = m.UserId })
			end)
		end
	end
	if #lobby.Members > 1 then
		Buttons.action("⮌ Leave party", { LayoutOrder = 10, Size = UDim2.new(1, -8, 0, 44), Tone = "Neutral", Parent = partyBody }, function()
			send("Leave")
		end)
	end
	UI.text("Invite players in this lobby", { LayoutOrder = 20, TextSize = 18, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = partyBody })
	if not lobby.IsLeader then
		UI.text("Only the party leader can invite.", { LayoutOrder = 21, TextSize = 13, TextColor3 = C.TextDim, Parent = partyBody })
	end
	local order = 22
	for _, pl in lobby.Players do
		local inMine = false
		for _, m in lobby.Members do
			if m.UserId == pl.UserId then
				inMine = true
			end
		end
		if not inMine then
			local r = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = partyBody }, { UI.corner(UDim.new(0, 8)) })
			order += 1
			UI.text(pl.Name .. (if pl.InParty then "  (in a party)" else ""), { Position = UDim2.fromOffset(10, 12), Size = UDim2.new(1, -120, 0, 22), TextSize = 15, Parent = r })
			if lobby.IsLeader and #lobby.Members < 4 then
				Buttons.action("+ Invite", { Size = UDim2.fromOffset(110, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Tone = "Neutral", Parent = r }, function()
					send("Invite", { UserId = pl.UserId })
				end)
			end
		end
	end
	UI.text("Tip: friends can join your server from the Roblox friends list, then accept your invite here.", { LayoutOrder = 999, TextSize = 12, TextColor3 = C.TextDim, Parent = partyBody })
end

-- Shared bits ------------------------------------------------------------------------------------

local function rgb(c: { number }?): Color3
	return if c then Color3.fromRGB(c[1], c[2], c[3]) else C.Text
end

local function card(parent: Instance, order: number, height: number, color: Color3, selected: boolean): Frame
	return UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = parent }, { UI.corner(UDim.new(0, 10)), UI.stroke(if selected then color else C.Stroke, if selected then 3 else 1, 0.2), UI.padding(10) })
end

local function buttonRow(parent: Instance): Frame
	return UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.new(0.5, 0, 0, 44), Parent = parent }, { UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right) })
end


-- Classes panel ----------------------------------------------------------------------------------

local function renderClasses()
	UI.clear(classBody)
	local profile = State.Get("Profile")
	if not profile then
		UI.text("Loading your profile…", { Parent = classBody })
		return
	end
	UI.text(string.format("◆ %d Diamonds · one class per match, locked when the match starts · a win gives exactly %d ◆, +1 ◆ every 10 levels", profile.Diamonds, Progression.WinDiamonds), { LayoutOrder = 0, Size = UDim2.new(1, -8, 0, 34), TextWrapped = true, TextSize = 13, TextColor3 = C.Diamond, Parent = classBody })
	for i, def in Classes.List do
		local owned = profile.OwnedClasses[def.Id] == true
		local color = rgb(def.Color)
		local sel = profile.Class == def.Id
		local cd = card(classBody, i, 124, color, sel)
		local ic = UI.icon(def.Glyph, color, 56, "Round")
		ic.Parent = cd
		UI.text(def.Name .. (if owned then "" else "   🔒 " .. def.Price .. " ◆"), { Position = UDim2.fromOffset(68, 0), Size = UDim2.new(1, -68, 0, 22), TextSize = 18, Font = Theme.FontBlack, TextColor3 = color, Parent = cd })
		UI.text(def.Summary, { Position = UDim2.fromOffset(68, 22), Size = UDim2.new(1, -68, 0, 18), TextSize = 13, TextColor3 = C.TextDim, Parent = cd })
		UI.text("• " .. table.concat(def.Lines, "\n• "), { Position = UDim2.fromOffset(68, 40), Size = UDim2.new(0.55, -68, 0, 64), TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = cd })
		local row = buttonRow(cd)
		if owned then
			Buttons.action(if sel then "Selected" else "Select", { Size = UDim2.fromOffset(130, 40), Tone = "Green", State = if sel then "Selected" else nil, Parent = row }, function()
				send("EquipClass", { Id = def.Id })
			end)
		else
			Buttons.action("Unlock", { Size = UDim2.fromOffset(150, 40), Tone = "Green", Price = { Kind = "Diamonds", Amount = def.Price }, State = if profile.Diamonds >= def.Price then nil else "Disabled", Parent = row }, function()
				send("BuyClass", { Id = def.Id })
			end)
		end
	end
end

-- Power-ups panel ------------------------------------------------------------------------------------

local function renderPerks()
	UI.clear(perkBody)
	local profile = State.Get("Profile")
	if not profile then
		UI.text("Loading your profile…", { Parent = perkBody })
		return
	end
	UI.text(string.format("◆ %d Diamonds · equip ONE power-up before a match (no swapping mid-match)", profile.Diamonds), { LayoutOrder = 0, TextSize = 13, TextColor3 = C.Diamond, Parent = perkBody })
	for i, def in Perks.List do
		local owned = profile.OwnedPerks[def.Id] == true
		local color = rgb(def.Color)
		local sel = profile.Perk == def.Id
		local cd = card(perkBody, i, 84, color, sel)
		local ic = UI.icon(def.Glyph, color, 48, "Round")
		ic.Parent = cd
		UI.text(def.Name .. (if owned then "" else "   🔒 " .. def.Price .. " ◆"), { Position = UDim2.fromOffset(60, 0), Size = UDim2.new(1, -60, 0, 22), TextSize = 17, Font = Theme.FontBlack, TextColor3 = color, Parent = cd })
		UI.text(def.Text, { Position = UDim2.fromOffset(60, 24), Size = UDim2.new(0.62, -60, 0, 36), TextWrapped = true, TextSize = 13, TextYAlignment = Enum.TextYAlignment.Top, Parent = cd })
		local row = buttonRow(cd)
		if owned then
			Buttons.action(if sel then "Equipped" else "Equip", { Size = UDim2.fromOffset(130, 40), Tone = "Green", State = if sel then "Selected" else nil, Parent = row }, function()
				send("EquipPerk", { Id = if sel then nil else def.Id })
			end)
		else
			Buttons.action("Unlock", { Size = UDim2.fromOffset(150, 40), Tone = "Green", Price = { Kind = "Diamonds", Amount = def.Price }, State = if profile.Diamonds >= def.Price then nil else "Disabled", Parent = row }, function()
				send("BuyPerk", { Id = def.Id })
			end)
		end
	end
end

-- Locker (cosmetics) --------------------------------------------------------------------------------------

local TYPE_LABEL = {
	Outfit = "Outfits", ToolSkin = "Tool skins", BackpackSkin = "Backpacks", CampfireSkin = "Campfire", WorkbenchSkin = "Workbench",
	StorageSkin = "Storage", Nameplate = "Nameplates", Title = "Titles", Emote = "Emotes", EliminationFx = "Elim. effects", VictoryPose = "Victory poses",
}

local TYPE_GLYPH = {
	Outfit = "👕", ToolSkin = "🔨", BackpackSkin = "🎒", CampfireSkin = "🔥", WorkbenchSkin = "⚒", StorageSkin = "📦",
	Nameplate = "🏷", Title = "👑", Emote = "🙌", EliminationFx = "💀", VictoryPose = "🏆",
}

local function renderLocker()
	UI.clear(lockerBody)
	local profile = State.Get("Profile")
	if not profile then
		UI.text("Loading your profile…", { Parent = lockerBody })
		return
	end
	UI.text(string.format("🪙 %d Coins · cosmetics are purely visual — they never change stats", profile.Coins or 0), { LayoutOrder = 0, TextSize = 14, TextColor3 = C.Accent, Parent = lockerBody })
	local tabs = UI.new("Frame", { LayoutOrder = 1, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 190), Parent = lockerBody }, { UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(104, 56), CellPadding = UDim2.fromOffset(6, 6) }) })
	for _, typ in Cosmetics.Types do
		Buttons.tab(TYPE_LABEL[typ] or typ, TYPE_GLYPH[typ], typ == lockerType, { Size = UDim2.fromOffset(104, 56), Parent = tabs }, function()
			lockerType = typ
			renderLocker()
		end)
	end
	local order = 10
	local wearing = profile.Wearing[lockerType]
	if wearing then
		Buttons.action("Remove " .. (TYPE_LABEL[lockerType] or lockerType):lower(), { LayoutOrder = 2, Size = UDim2.new(1, -8, 0, 36), Tone = "Neutral", Parent = lockerBody }, function()
			send("WearCosmetic", { Type = lockerType, Id = nil })
		end)
	end
	for _, def in Cosmetics.List do
		if def.Type == lockerType then
			order += 1
			local owned = profile.Cosmetics[def.Id] == true
			local rarity = rgb(Cosmetics.RarityColor[def.Rarity])
			local sel = wearing == def.Id
			local cd = card(lockerBody, order, 64, rarity, sel)
			local sw = UI.new("Frame", { Size = UDim2.fromOffset(42, 42), BackgroundColor3 = if def.Color then rgb(def.Color) else C.PanelLighter, Parent = cd }, { UI.corner(UDim.new(0, 8)) })
			if def.Text then
				UI.text("✎", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = sw })
			end
			UI.text(def.Name .. (if def.Text then '  "' .. def.Text .. '"' else ""), { Position = UDim2.fromOffset(52, 0), Size = UDim2.new(0.6, -52, 0, 22), TextSize = 15, Font = Theme.FontBold, Parent = cd })
			UI.text(def.Rarity .. (if def.Level then " · level " .. def.Level .. " reward" elseif def.Price > 0 then " · " .. def.Price .. " Coins" else " · bundle"), { Position = UDim2.fromOffset(52, 22), Size = UDim2.new(0.6, -52, 0, 18), TextSize = 12, TextColor3 = rarity, Parent = cd })
			local row = buttonRow(cd)
			if owned then
				if def.Type == "Emote" then
					Buttons.action("▶ Play", { Size = UDim2.fromOffset(90, 40), Tone = "Neutral", Parent = row }, function()
						send("Emote", { Id = def.Id })
					end)
				end
				Buttons.action(if sel then "Wearing" else "Wear", { Size = UDim2.fromOffset(120, 40), Tone = "Green", State = if sel then "Selected" else nil, Parent = row }, function()
					send("WearCosmetic", { Type = def.Type, Id = if sel then nil else def.Id })
				end)
			elseif def.Price > 0 then
				Buttons.action("Buy", { Size = UDim2.fromOffset(150, 40), Tone = "Gold", Price = { Kind = "Coins", Amount = def.Price }, State = if (profile.Coins or 0) >= def.Price then nil else "Disabled", Parent = row }, function()
					send("BuyCosmetic", { Id = def.Id })
				end)
			else
				UI.text(if def.Level then "🔒 Lv " .. def.Level else "🔒 bundle", { Size = UDim2.fromOffset(110, 40), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.TextDim, Parent = row })
			end
		end
	end
end

-- Profile & rewards ------------------------------------------------------------------------------------------

local function renderProfile()
	UI.clear(profileBody)
	local profile = State.Get("Profile")
	if not profile then
		UI.text("Loading your profile…", { Parent = profileBody })
		return
	end
	UI.text("Level " .. tostring(profile.Level or 1), { LayoutOrder = 1, TextSize = 24, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = profileBody })
	local barHolder = UI.new("Frame", { LayoutOrder = 2, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 26), Parent = profileBody })
	local _, set = UI.bar({ Size = UDim2.fromScale(1, 1), Parent = barHolder }, C.Accent)
	if (profile.LevelNeed or 0) > 0 then
		set(profile.LevelInto / profile.LevelNeed, string.format("%d / %d XP to level %d", profile.LevelInto, profile.LevelNeed, (profile.Level or 1) + 1))
	else
		set(1, "MAX LEVEL")
	end
	UI.text(string.format("Matches %d · Wins %d · Kills %d · Eliminations %d · ◆ %d · 🪙 %d", profile.Matches or 0, profile.Wins or 0, profile.Kills or 0, profile.Eliminations or 0, profile.Diamonds or 0, profile.Coins or 0), { LayoutOrder = 3, TextSize = 14, TextColor3 = C.TextDim, Parent = profileBody })
	UI.text("Every 5 levels: +" .. Progression.LevelCoins .. " Coins · every 10 levels: +" .. Progression.MilestoneDiamonds .. " ◆ · titles & nameplates at 5 / 10 / 25 / 50 / 75 / 100", { LayoutOrder = 4, Size = UDim2.new(1, -8, 0, 32), TextWrapped = true, TextSize = 12, TextColor3 = C.TextDim, Parent = profileBody })
	-- Daily
	local daily = profile.Daily or {}
	local dcard = card(profileBody, 10, 64, C.Accent, daily.CanClaim == true)
	UI.text("Daily bonus", { Size = UDim2.new(0.6, 0, 0, 22), TextSize = 16, Font = Theme.FontBold, Parent = dcard })
	UI.text(string.format("Streak %d · +%d Coins (grows each day in a row, max 150)", daily.Streak or 0, daily.Amount or 50), { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(0.6, 0, 0, 20), TextSize = 12, TextColor3 = C.TextDim, Parent = dcard })
	Buttons.action(if daily.CanClaim then "🎁 Claim +" .. (daily.Amount or 50) else "Claimed", { Size = UDim2.fromOffset(150, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Tone = "Green", State = if daily.CanClaim then nil else "Selected", Parent = dcard }, function()
		send("ClaimDaily")
	end)
	-- Weekly
	local wk = profile.Weekly or {}
	local wcard = card(profileBody, 11, 64, C.Accent, wk.CanClaim == true)
	UI.text("Weekly bonus", { Size = UDim2.new(0.6, 0, 0, 22), TextSize = 16, Font = Theme.FontBold, Parent = wcard })
	UI.text(string.format("Matches %d/%d · wins %d → +%d Coins", wk.Matches or 0, wk.Need or 3, wk.Wins or 0, wk.Amount or 300), { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(0.6, 0, 0, 20), TextSize = 12, TextColor3 = C.TextDim, Parent = wcard })
	Buttons.action(if wk.Claimed then "Claimed" elseif wk.CanClaim then "🏆 Claim" else "Keep playing", { Size = UDim2.fromOffset(150, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Tone = if wk.CanClaim then "Gold" else "Green", State = if wk.Claimed then "Selected" elseif wk.CanClaim then nil else "Disabled", Parent = wcard }, function()
		send("ClaimWeekly")
	end)
	-- Leaderboards
	local lobby = State.Get("Lobby")
	local boards = lobby and lobby.Boards or {}
	UI.text("Leaderboards", { LayoutOrder = 20, TextSize = 18, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = profileBody })
	local cols = UI.new("Frame", { LayoutOrder = 21, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 230), Parent = profileBody }, { UI.list(Enum.FillDirection.Horizontal, 8) })
	for _, spec in { { "Wins", "Most wins" }, { "XP", "Highest level" } } do
		local col = UI.new("Frame", { Size = UDim2.new(0.5, -4, 1, 0), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = cols }, { UI.corner(UDim.new(0, 8)), UI.padding(8), UI.list(Enum.FillDirection.Vertical, 2) })
		UI.text(spec[2], { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = Theme.FontBold, Parent = col })
		local list = boards[spec[1]] or {}
		if #list == 0 then
			UI.text("No entries yet (live servers only).", { Size = UDim2.new(1, 0, 0, 18), TextSize = 12, TextColor3 = C.TextDim, Parent = col })
		end
		for rank, e in list do
			local v = if spec[1] == "XP" then "Lv " .. (Progression.LevelFromXP(e.Value)) else tostring(e.Value)
			UI.text(string.format("%d. %s — %s", rank, e.Name, v), { Size = UDim2.new(1, 0, 0, 18), TextSize = 12, TextColor3 = if e.UserId == player.UserId then C.Accent else C.Text, Parent = col })
		end
	end
end

-- Shop panel ------------------------------------------------------------------------------------------

local function renderShop()
	UI.clear(shopBody)
	UI.text("Robux only buys Coins and cosmetics — never gameplay power. Diamonds (classes & power-ups) are earned by playing.", { LayoutOrder = 0, Size = UDim2.new(1, -8, 0, 34), TextWrapped = true, TextSize = 13, TextColor3 = C.TextDim, Parent = shopBody })
	local order = 0
	for _, p in Products.List do
		if Products.OnSale(p.Key) then
			order += 1
			local isBundle = p.Kind == "Bundle"
			local r = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 70), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = shopBody }, { UI.corner(UDim.new(0, 8)), UI.padding(8) })
			local ic = UI.icon(if isBundle then "🎁" else "🪙", if isBundle then C.Dev else C.Accent, 52, "Round")
			ic.Parent = r
			UI.text(p.Title, { Position = UDim2.fromOffset(64, 4), Size = UDim2.new(1, -240, 0, 26), TextSize = 19, Font = Theme.FontBlack, TextColor3 = if isBundle then C.Dev else C.Accent, Parent = r })
			if isBundle then
				local names = {}
				local items: { string } = Cosmetics.Bundles[p.Bundle or ""] or {}
				for _, id in items do
					local d = Cosmetics.ById[id]
					table.insert(names, if d then d.Name else id)
				end
				UI.text(table.concat(names, " · "), { Position = UDim2.fromOffset(64, 32), Size = UDim2.new(1, -240, 0, 18), TextSize = 12, TextColor3 = C.TextDim, Parent = r })
			end
			Buttons.action("Buy " .. Hud.PriceText(p.Key), { Size = UDim2.fromOffset(170, 48), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Tone = "Green", Parent = r }, function()
				send("BuyRobux", { Key = p.Key })
			end)
		end
	end
	UI.text("Prices are shown by Roblox for your region. Purchases are only granted after Roblox confirms them. Bundle items you already own are refunded as Coins.", { LayoutOrder = 100, Size = UDim2.new(1, -8, 0, 34), TextWrapped = true, TextSize = 12, TextColor3 = C.TextDim, Parent = shopBody })
end

-- Settings panel -----------------------------------------------------------------------------------------

local settingsBody: ScrollingFrame

local function renderSettings()
	UI.clear(settingsBody)
	local profile = State.Get("Profile")
	local st = (profile and profile.Settings) or {}
	local function toggle(order: number, key: string, title: string, sub: string)
		local on = st[key] == true
		local row = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 60), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = settingsBody }, { UI.corner(UDim.new(0, 8)), UI.padding(8) })
		UI.text(title, { Size = UDim2.new(0.7, 0, 0, 22), TextSize = 16, Font = Theme.FontBold, Parent = row })
		UI.text(sub, { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(0.7, 0, 0, 18), TextSize = 12, TextColor3 = C.TextDim, Parent = row })
		Buttons.action(if on then "On" else "Off", { Size = UDim2.fromOffset(90, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Tone = if on then "Green" else "Neutral", State = if on then "Selected" else nil, Parent = row }, function()
			Net.Event("SetSetting"):FireServer(key, not on)
		end)
	end
	toggle(1, "ReduceMotion", "Reduce motion", "No camera punch, damage roll or sprint zoom")
	toggle(2, "ShowGuide", "Survival Guide", "Show the objective tracker in matches")
	toggle(3, "UiSounds", "Interface sounds", "Clicks and menu sounds")
	local vol = if type(st.Ambience) == "number" then st.Ambience else 0.8
	local row = UI.new("Frame", { LayoutOrder = 4, Size = UDim2.new(1, -8, 0, 60), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = settingsBody }, { UI.corner(UDim.new(0, 8)), UI.padding(8) })
	UI.text(string.format("Ambience volume · %d%%", math.floor(vol * 100 + 0.5)), { Size = UDim2.new(0.6, 0, 0, 22), TextSize = 16, Font = Theme.FontBold, Parent = row })
	local steps = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(250, 40), Parent = row }, { UI.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right) })
	for _, v in { 0, 0.25, 0.5, 0.75, 1 } do
		Buttons.tab(tostring(math.floor(v * 100)), nil, math.abs(v - vol) < 0.01, { Size = UDim2.fromOffset(46, 36), Parent = steps }, function()
			Net.Event("SetSetting"):FireServer("Ambience", v)
		end)
	end
end

local HELP = {
	{ "Goal", "Solo survival. Every player has their own camp with a Campfire and a Tier I Workbench. PvP is on from the start. Be the last survivor." },
	{ "Day & night", "Day and night each last exactly 2 minutes. At each sunrise, everyone alive gets 15 s of protection (and can't deal damage). At night predators roam." },
	{ "Your fire", "While your fire burns you respawn (8 s, 12 s, 16 s, then 20 s). Feed it Wood (1 Wood = +2% fuel). At 0% it goes out for good and you're on your FINAL LIFE. Upgrade it (L2-L5) to burn longer and take longer to snuff." },
	{ "Snuffing", "Fires are protected during Nights 1-2. From Night 3, enemy fires can be snuffed day or night with a filled canteen: hold 8-20 s by fire level. Taking damage, moving or letting go cancels it." },
	{ "Progression", "Start with nothing. Gather sticks, loose stones, fibre and berries by hand, then craft a Crude Axe, Pickaxe and Spear. Small trees give 4 Wood, large trees 16 (Stone Axe). Upgrade your Workbench (Tiers I-V) with your pack + storage." },
	{ "Health & stamina", "Health 100, stamina 100 (sprint with Shift). There's no fast regen: bandages (+20), First Aid kits (+50) and Medkits (+100) take time and are interrupted by damage." },
	{ "Deaths", "Only materials drop, in one loot bag. You keep tools, weapons, armour, backpack and Workbench progress." },
	{ "Classes & power-ups", "Pick one class and one power-up in the lobby (Diamonds). They're locked for the whole match. They are sidegrades: faster chopping, more pack slots, better senses — never more damage or health." },
	{ "XP, Coins & Diamonds", "Earn XP and Coins by surviving nights, kills, snuffing fires, exploring, hunting, opening chests and placing top 3. Coins buy cosmetics. Diamonds come from wins (exactly 2) and every 10 levels." },
	{ "PC controls", "WASD move · Shift sprint · Click attack · Right-click aim/block · 1-5 slots · ` fists · Q swap · H bandage · I bag · C craft · B build · M map · E/F interact" },
	{ "Mobile", "Use the on-screen buttons: ATTACK, AIM/BLOCK, HEAL, SWAP and RUN. Tap the prompt cards to interact. BAG, CRAFT, BUILD and MAP are at the top right." },
}

local function renderHelp()
	UI.clear(helpBody)
	for i, h in HELP do
		UI.text(h[1], { LayoutOrder = i * 2, TextSize = 17, Font = Theme.FontBlack, TextColor3 = C.Accent, Parent = helpBody })
		UI.text(h[2], { LayoutOrder = i * 2 + 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 14, Parent = helpBody })
	end
end

-- Invites -------------------------------------------------------------------------------------------------

local function showInvite(d: any)
	local card = UI.panel({ Size = UDim2.fromOffset(340, 104), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 90), Parent = gui }, { UI.padding(10) })
	UI.text(tostring(d.From) .. " invited you to their party", { Size = UDim2.new(1, 0, 0, 24), TextSize = 16, Font = Theme.FontBold, Parent = card })
	Buttons.action("✓ Accept", { Size = UDim2.new(0.48, 0, 0, 46), Position = UDim2.new(0, 0, 1, -46), Tone = "Green", Parent = card }, function()
		send("Accept", { PartyId = d.PartyId })
		card:Destroy()
	end)
	Buttons.action("✖ Decline", { Size = UDim2.new(0.48, 0, 0, 46), Position = UDim2.new(0.52, 0, 1, -46), Tone = "Red", Parent = card }, function()
		send("Decline", { PartyId = d.PartyId })
		card:Destroy()
	end)
	task.delay(60, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

-- Title screen: a slow camera orbit over the refuge fire at golden hour,
-- shown once per session in the lobby.
local function titleScreen()
	if workspace:GetAttribute("ServerMode") == "Match" or player:GetAttribute("InMatch") then
		return
	end
	local lobbyFolder = workspace:WaitForChild("Lobby", 20)
	local fire = lobbyFolder and lobbyFolder:WaitForChild("LobbyFire", 10) :: Model?
	if not fire then
		return
	end
	local center = fire:GetPivot().Position
	-- make sure the ground round the fire has streamed in before we look at it
	pcall(function()
		player:RequestStreamAroundAsync(center, 10)
	end)
	local cam = workspace.CurrentCamera
	titleUp = true
	refreshVis()
	local overlay = UI.new("ScreenGui", { Name = "TitleScreen", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20, Parent = player:WaitForChild("PlayerGui") })
	local shade = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = overlay }, {
		UI.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.5, 0.85), NumberSequenceKeypoint.new(1, 0.1) }) }),
	})
	local title = UI.text("SURVIVAL HOUR", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.new(0.9, 0, 0, 90), TextSize = 78, Font = Theme.FontBlack, TextColor3 = C.Accent, TextStrokeTransparency = 0.3, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1, Parent = shade })
	local tag = UI.text("Keep your fire burning. Outlast every other survivor.", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.36, 64), Size = UDim2.new(0.9, 0, 0, 30), TextSize = 22, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1, Parent = shade })
	local done = false
	local _btn, setBtn = Buttons.primary("ENTER THE REFUGE", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromOffset(440, 80), Parent = shade }, function()
		done = true
	end)
	TweenService:Create(title, TweenInfo.new(1.6), { TextTransparency = 0 }):Play()
	TweenService:Create(tag, TweenInfo.new(2.4), { TextTransparency = 0 }):Play()
	local t0 = os.clock()
	cam.CameraType = Enum.CameraType.Scriptable
	RunService:BindToRenderStep("SurvivalHourTitle", Enum.RenderPriority.Camera.Value + 2, function()
		local a = (os.clock() - t0) * 0.08
		local eye = center + Vector3.new(math.cos(a) * 46, 18 + math.sin(a * 0.7) * 3, math.sin(a) * 46)
		cam.CFrame = CFrame.lookAt(eye, center + Vector3.new(0, 4, 0))
	end)
	-- Leave on the button, when a match starts, or after 45 s.
	local deadline = os.clock() + 45
	while not done and os.clock() < deadline and not player:GetAttribute("InMatch") do
		task.wait(0.1)
	end
	-- Don't hand the camera back until the character exists (the server may
	-- still be starting up), otherwise the view looks frozen.
	setBtn("ENTER THE REFUGE", "Loading the forest…", "Disabled")
	local waitUntil = os.clock() + 60
	local hum: Humanoid? = nil
	while os.clock() < waitUntil do
		local char = player.Character
		hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and char:FindFirstChild("HumanoidRootPart") then
			break
		end
		task.wait(0.2)
	end
	RunService:UnbindFromRenderStep("SurvivalHourTitle")
	cam.CameraType = Enum.CameraType.Custom
	if hum then
		cam.CameraSubject = hum
	end
	TweenService:Create(shade, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	for _, d in shade:GetDescendants() do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			TweenService:Create(d, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		end
	end
	titleUp = false
	refreshVis()
	task.delay(0.7, function()
		overlay:Destroy()
	end)
end

function Lobby.Start()
	titleUp = workspace:GetAttribute("ServerMode") ~= "Match" and not player:GetAttribute("InMatch")
	task.spawn(function()
		local ok, err = pcall(titleScreen)
		if not ok then
			warn("[Lobby] title screen:", err)
		end
		titleUp = false -- whatever happened, give the lobby UI back and the camera
		refreshVis()
		RunService:UnbindFromRenderStep("SurvivalHourTitle")
		if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		end
	end)
	gui = UI.new("ScreenGui", { Name = "LobbyHud", ResetOnSpawn = false, DisplayOrder = 3, Parent = player:WaitForChild("PlayerGui") })
	local scale = UI.new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1000, vp.Y / 600), 0.65, 1.2)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	-- Top: profile card (level badge, name, title, XP bar) + animated currency pills.
	local card = UI.panel({ Size = UDim2.fromOffset(420, 80), Position = UDim2.fromOffset(12, 8), Parent = gui })
	local badge = UI.new("Frame", { Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = C.PanelLight, Parent = card }, { UI.corner(UDim.new(0.5, 0)), UI.new("UIStroke", { Color = C.Accent, Thickness = 3 }) })
	UI.text("LVL", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 10), TextSize = 11, Font = Theme.FontBold, TextColor3 = C.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = badge })
	levelLabel = UI.text("1", { Name = "Level", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 24), TextSize = 22, Font = Theme.FontBlack, TextXAlignment = Enum.TextXAlignment.Center, Parent = badge })
	UI.text(player.DisplayName, { Position = UDim2.fromOffset(82, 8), Size = UDim2.new(1, -90, 0, 22), TextSize = 18, Font = Theme.FontBlack, Parent = card })
	diamondsLabel = UI.text("", { Position = UDim2.fromOffset(82, 30), Size = UDim2.new(1, -90, 0, 16), TextSize = 13, Font = Theme.FontBold, TextColor3 = C.Accent, Parent = card })
	local xpHolder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(82, 52), Size = UDim2.new(1, -94, 0, 16), Parent = card })
	Buttons.icon("⚙", { Size = UDim2.fromOffset(32, 32), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), TextSize = 18, Parent = card }, function()
		Panels.Toggle("Settings")
	end)
	local _xpBar
	_xpBar, xpSet = UI.bar({ Size = UDim2.fromScale(1, 1), Parent = xpHolder }, C.Accent)
	local function pill(x: number, glyph: string, color: Color3): TextLabel
		local f = UI.panel({ Size = UDim2.fromOffset(150, 40), Position = UDim2.fromOffset(x, 8), Parent = gui })
		UI.text(glyph, { Size = UDim2.fromOffset(34, 40), TextSize = 20, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
		return UI.text("0", { Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -40, 1, 0), TextSize = 19, Font = Theme.FontBlack, TextColor3 = color, Parent = f })
	end
	coinPill = pill(442, "●", Color3.fromRGB(242, 193, 78))
	diamondPill = pill(600, "◆", C.Diamond)

	-- Bottom centre: the big READY UP plate, status and party strip.
	local bottom = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(460, 140), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Parent = gui })
	partyStrip = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), Parent = bottom }, { UI.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center) })
	statusLabel = UI.text("", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 20), TextSize = 13, TextColor3 = C.Text, TextStrokeTransparency = 0.5, TextXAlignment = Enum.TextXAlignment.Center, Parent = bottom })
	local readyPlate, setReadyFn = Buttons.primary("READY UP", { Size = UDim2.new(1, 0, 0, 84), Position = UDim2.fromOffset(0, 50), Parent = bottom }, function()
		local lobby = State.Get("Lobby")
		if lobby and (lobby.Ready or lobby.Queued) then
			send("Ready", { Value = false })
		else
			send("Ready", { Value = true })
		end
	end)
	setReady = setReadyFn
	-- New players: the READY UP plate breathes (green glow) until their first match.
	task.spawn(function()
		local on = false
		while readyPlate.Parent do
			task.wait(0.8)
			local prof = State.Get("Profile")
			local lobby = State.Get("Lobby")
			local newbie = prof ~= nil and (prof.Matches or 0) == 0 and not (lobby and (lobby.Queued or lobby.Ready))
			on = newbie and not on
			if readyPlate:GetAttribute("Hover") ~= on and not readyPlate:GetAttribute("Down") then
				readyPlate:SetAttribute("Hover", if on then true else nil)
				Buttons.refresh(readyPlate)
			end
		end
	end)

	-- Left: menu tiles (icon + title + subtitle), two columns.
	local nav = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(2 * 104 + 8, 4 * 104 + 24), Position = UDim2.fromOffset(12, 100), Parent = gui }, {
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(104, 104), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local TILES = {
		{ "Party", "PARTY", "Play with friends", "👥" },
		{ "Classes", "CLASS", "Choose your style", "🏠" },
		{ "Perks", "POWER-UP", "Boost your run", "⚡" },
		{ "Locker", "LOCKER", "Customize", "🎒" },
		{ "Profile", "PROFILE", "Stats & rewards", "👤" },
		{ "LobbyShop", "SHOP", "Coins & bundles", "🛒" },
		{ "Help", "HOW TO PLAY", "Learn the basics", "❓" },
		{ "LobbyShop", "BUY COINS", "Get more coins", "🪙" },
	}
	for i, spec in TILES do
		Buttons.tile(spec[2], spec[3], spec[4], { LayoutOrder = i, Parent = nav, Tone = if spec[2] == "BUY COINS" then "Gold" else "Neutral" }, function()
			Panels.Toggle(spec[1])
		end)
	end

	partyBody = Panels.Create("Party", "PARTY", Vector2.new(560, 560), renderParty)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = partyBody
	classBody = Panels.Create("Classes", "CLASSES", Vector2.new(700, 640), renderClasses)
	UI.list(Enum.FillDirection.Vertical, 8).Parent = classBody
	perkBody = Panels.Create("Perks", "POWER-UPS", Vector2.new(640, 640), renderPerks)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = perkBody
	lockerBody = Panels.Create("Locker", "LOCKER", Vector2.new(640, 640), renderLocker)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = lockerBody
	profileBody = Panels.Create("Profile", "PROFILE & REWARDS", Vector2.new(620, 640), renderProfile)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = profileBody
	shopBody = Panels.Create("LobbyShop", "TRADING POST", Vector2.new(600, 520), renderShop)
	settingsBody = Panels.Create("Settings", "SETTINGS", Vector2.new(560, 380), renderSettings)
	UI.list(Enum.FillDirection.Vertical, 8).Parent = settingsBody
	UI.list(Enum.FillDirection.Vertical, 8).Parent = shopBody
	helpBody = Panels.Create("Help", "HOW TO PLAY", Vector2.new(640, 600), renderHelp)
	UI.list(Enum.FillDirection.Vertical, 4).Parent = helpBody

	State.On("Lobby", function()
		renderHud()
		if Panels.IsOpen("Party") then
			renderParty()
		end
	end)
	local RENDER = { Classes = renderClasses, Perks = renderPerks, Locker = renderLocker, Profile = renderProfile, LobbyShop = renderShop, Settings = renderSettings }
	State.On("Profile", function()
		renderHud()
		for name, fn in RENDER do
			if Panels.IsOpen(name) then
				fn()
			end
		end
	end)
	State.On("PricesUpdated", function()
		if Panels.IsOpen("LobbyShop") then
			renderShop()
		end
	end)
	State.On("MatchEvent", function(ev)
		if ev.Name == "PartyInvite" then
			showInvite(ev.Data)
		elseif ev.Name == "OpenStation" then
			local st = ev.Data.Station
			Panels.Open(if st == "Shop" then "LobbyShop" elseif st == "Powerups" or st == "Classes" then "Classes" elseif st == "Locker" then "Locker" elseif st == "Profile" then "Profile" else "Party")
		end
	end)
	local function vis()
		gui.Enabled = not titleUp and not player:GetAttribute("InMatch") and workspace:GetAttribute("ServerMode") ~= "Match"
	end
	refreshVis = vis
	player:GetAttributeChangedSignal("InMatch"):Connect(vis)
	vis()
end

return Lobby
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="915">
            <Properties>
              <string name="Name">Map</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Minimap + full map (M). North-up. Shows paths, streams, landmarks, your
-- camp and build zone, enemy camps your clan has discovered, care package
-- markers, you and your teammates, plus personal class senses (Scavenger
-- containers, Hunter wildlife, Tracker blood trails).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")

local MapCtl = {}

local player = Players.LocalPlayer
local C = Theme.Colors
local mini: Frame
local full: Frame
local canvases: { Frame } = {}
local dynamic: { [Frame]: Frame } = {}
local packages: { [number]: { X: number, Z: number, Landed: boolean } } = {}
local camps: { [number]: { X: number, Z: number } } = {}
local reveals: { { Kind: string, Pos: Vector3, Until: number, Label: string } } = {}

local LANDMARK_GLYPH = {
	Glade = "✿", RockOutcrop = "▲", Ruins = "Π", Pond = "≈", Thicket = "⁂", FallenGiant = "═",
	-- Survival Wars POIs
	Cave = "◖", Waterfall = "≋", Campsite = "⛺", Shed = "⌂", HuntingBlind = "⊼", BrokenVehicle = "⊟", SmallCabin = "⌂",
	Cabin = "⌂", RangerStation = "⚑", LoggingCamp = "≡", AbandonedHouse = "⌂", MineEntrance = "⛏",
	Bunker = "▣", Outpost = "⚑", IndustrialSite = "⚙", LargeMine = "⛏",
}

local function toMap(data: any, x: number, z: number): UDim2
	local H = data.HalfSize
	local u = (x - data.Origin[1] + H) / (2 * H)
	local v = (z - data.Origin[2] + H) / (2 * H)
	return UDim2.fromScale(math.clamp(u, 0, 1), math.clamp(v, 0, 1))
end

local function segment(parent: Frame, size: Vector2, a: UDim2, b: UDim2, color: Color3, thick: number, dotted: boolean?)
	local ax, ay = a.X.Scale * size.X, a.Y.Scale * size.Y
	local bx, by = b.X.Scale * size.X, b.Y.Scale * size.Y
	local len = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
	if len < 0.5 then
		return
	end
	local f = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2),
		Size = UDim2.fromOffset(len + (if dotted then 0 else 1), thick),
		Rotation = math.deg(math.atan2(by - ay, bx - ax)),
		BackgroundColor3 = color,
		BackgroundTransparency = if dotted then 0.25 else 0,
		BorderSizePixel = 0,
		Parent = parent,
	})
	return f
end

local function marker(parent: Instance, glyph: string, color: Color3, size: number, pos: UDim2, z: number?): TextLabel
	return UI.new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Text = glyph,
		TextScaled = true,
		Font = Theme.FontBlack,
		TextColor3 = color,
		TextStrokeTransparency = 0.2,
		ZIndex = z or 3,
		Parent = parent,
	})
end

local function drawStatic(canvas: Frame, px: number)
	UI.clear(canvas)
	local data = State.Get("Map")
	if not data then
		return
	end
	local size = Vector2.new(px, px)
	local thick = math.max(1.5, px / 160)
	for _, s in data.Streams do
		for i = 1, #s - 1 do
			segment(canvas, size, toMap(data, s[i][1], s[i][2]), toMap(data, s[i + 1][1], s[i + 1][2]), Color3.fromRGB(90, 160, 230), thick * 1.6)
		end
	end
	for _, p in data.Paths do
		for i = 1, #p - 1 do
			segment(canvas, size, toMap(data, p[i][1], p[i][2]), toMap(data, p[i + 1][1], p[i + 1][2]), Color3.fromRGB(176, 140, 96), thick, true)
		end
	end
	if px >= 300 then
		for _, l in data.Landmarks do
			marker(canvas, LANDMARK_GLYPH[l.Type] or "•", Color3.fromRGB(220, 230, 200), 16, toMap(data, l.X, l.Z), 2)
		end
	end
	marker(canvas, "◎", Color3.fromRGB(230, 220, 190), if px >= 300 then 22 else 12, toMap(data, data.Origin[1], data.Origin[2]), 2)
	-- build zone ring for own camp
	if data.MyCamp then
		local r = data.BuildRadius / (2 * data.HalfSize) * px * 2
		local ring = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(data, data.MyCamp.X, data.MyCamp.Z), Size = UDim2.fromOffset(r, r), BackgroundTransparency = 1, Parent = canvas }, { UI.corner(UDim.new(0.5, 0)), UI.new("UIStroke", { Color = Config.Teams[data.MyTeam].Color, Thickness = 1.5, Transparency = 0.3 }) })
		ring.ZIndex = 2
	end
end

local function drawDynamic(canvas: Frame, px: number)
	local layer = dynamic[canvas]
	if not layer then
		return
	end
	UI.clear(layer)
	local data = State.Get("Map")
	if not data then
		return
	end
	local big = px >= 300
	local s = if big then 26 else 16
	local myTeam = player:GetAttribute("Team")
	-- camps
	for team, c in camps do
		local def = Config.Teams[team]
		marker(layer, def.Symbol, def.Color, s, toMap(data, c.X, c.Z), 4)
		local ms = ReplicatedStorage:FindFirstChild("MatchState")
		if big and ms and ms:GetAttribute("Fire" .. team) == false then
			marker(layer, "✖", C.Bad, s * 0.8, toMap(data, c.X, c.Z), 5)
		end
		if big then
			local lab = marker(layer, def.Name .. (if team == myTeam then " (you)" else ""), def.Color, 14, toMap(data, c.X, c.Z), 4)
			lab.Size = UDim2.fromOffset(120, 14)
			lab.Position += UDim2.fromOffset(0, 18)
		end
	end
	-- packages
	for _, p in packages do
		marker(layer, "✚", C.Accent, s, toMap(data, p.X, p.Z), 6)
	end
	-- reveals
	local now = os.clock()
	for i = #reveals, 1, -1 do
		local r = reveals[i]
		if now > r.Until then
			table.remove(reveals, i)
		else
			marker(layer, r.Label, if r.Kind == "Crates" then C.Warn elseif r.Kind == "Animals" then C.Info else C.Bad, if r.Kind == "Blood" then s * 0.5 else s * 0.8, toMap(data, r.Pos.X, r.Pos.Z), 6)
		end
	end
	-- players
	for _, p in Players:GetPlayers() do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and p:GetAttribute("InMatch") then
			local sameTeam = p:GetAttribute("Team") == myTeam
			local marked = p:GetAttribute("MarkedTeam") == myTeam and (p:GetAttribute("MarkedUntil") or 0) > workspace:GetServerTimeNow()
			if p == player then
				local look = root.CFrame.LookVector
				local arrow = marker(layer, "▲", Color3.new(1, 1, 1), s, toMap(data, root.Position.X, root.Position.Z), 8)
				arrow.Rotation = math.deg(math.atan2(look.X, -look.Z))
			elseif sameTeam then
				marker(layer, "●", Config.Teams[myTeam].Color, s * 0.6, toMap(data, root.Position.X, root.Position.Z), 7)
			elseif marked then
				marker(layer, "◉", C.Bad, s * 0.8, toMap(data, root.Position.X, root.Position.Z), 7)
			end
		end
	end
end

local function makeCanvas(parent: Instance, px: number): Frame
	local canvas = UI.new("Frame", { Size = UDim2.fromOffset(px, px), BackgroundColor3 = Color3.fromRGB(46, 74, 44), BorderSizePixel = 0, ClipsDescendants = true, Parent = parent }, { UI.corner(UDim.new(0, 8)), UI.stroke(C.Stroke, 2, 0) })
	local static = UI.new("Frame", { Name = "Static", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = canvas })
	local dyn = UI.new("Frame", { Name = "Dynamic", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = canvas })
	dynamic[canvas] = dyn
	canvas:SetAttribute("Px", px)
	table.insert(canvases, canvas)
	static:SetAttribute("Px", px)
	return canvas
end

function MapCtl.Start()
	local gui = UI.new("ScreenGui", { Name = "Minimap", ResetOnSpawn = false, DisplayOrder = 2, Parent = player:WaitForChild("PlayerGui") })
	mini = makeCanvas(gui, 180)
	mini.AnchorPoint = Vector2.new(1, 0)
	mini.Position = UDim2.new(1, -12, 0, 8)
	local body = Panels.Create("Map", "MAP", Vector2.new(600, 660))
	full = makeCanvas(body, 560)
	UI.text("Enemy camps appear once a clanmate spots them. ✚ = care package · ◎ = centre stones · dashed = paths · blue = streams", { Position = UDim2.fromOffset(0, 566), Size = UDim2.new(1, 0, 0, 34), TextSize = 12, TextColor3 = C.TextDim, Parent = body })

	local function redrawStatic()
		for _, cv in canvases do
			drawStatic(cv:FindFirstChild("Static") :: Frame, cv:GetAttribute("Px") :: number)
		end
	end
	State.On("Map", function(data)
		camps = {}
		for _, c in data.Camps do
			camps[c.Team] = { X = c.X, Z = c.Z }
		end
		redrawStatic()
	end)
	State.On("MatchEvent", function(ev)
		local d = ev.Data
		if ev.Name == "CampRevealed" and d.Camp then
			camps[d.Team] = { X = d.Camp.X, Z = d.Camp.Z }
		elseif ev.Name == "CarePackage" then
			packages[d.Id] = { X = d.X, Z = d.Z, Landed = false }
		elseif ev.Name == "CarePackageOpened" then
			packages[d.Id] = nil
		elseif ev.Name == "Loading" or ev.Name == "ReturnedToLobby" then
			packages = {}
			camps = {}
			reveals = {}
		end
	end)
	State.On("Reveal", function(r)
		for _, item in r.List do
			local pos = if typeof(item) == "Vector3" then item else item.Pos
			table.insert(reveals, { Kind = r.Kind, Pos = pos, Until = os.clock() + (r.Duration or 8), Label = if r.Kind == "Crates" then "▣" elseif r.Kind == "Blood" then "•" else "☗" })
		end
	end)
	State.On("Action", function(a)
		if a.Down and a.Name == "Map" and player:GetAttribute("InMatch") then
			Panels.Toggle("Map")
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		mini.Visible = player:GetAttribute("InMatch") == true and State.Get("Map") ~= nil
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		if mini.Visible then
			drawDynamic(mini, 180)
		end
		if Panels.IsOpen("Map") then
			drawDynamic(full, 560)
		end
	end)
end

return MapCtl
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="916">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Sprint input: hold Shift / L3 (PC, gamepad) or tap the on-screen RUN button (touch
-- toggle). The server owns stamina and speed (StaminaService); this only reports intent.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local State = require("../State")
local UI = require("../UI/UI")

local Movement = {}

local player = Players.LocalPlayer
local sprinting = false

local function set(want: boolean)
	if want ~= sprinting then
		sprinting = want
		Net.Event("Sprint"):FireServer(want)
		State.Set("SprintWanted", want)
	end
end

function Movement.Start()
	State.On("Action", function(a)
		if a.Name == "Sprint" then
			set(a.Down)
		elseif a.Name == "SprintToggle" and a.Down then
			set(not sprinting)
		end
	end)
	-- Stop sprinting after death so the next life starts walking.
	player:GetAttributeChangedSignal("LifeState"):Connect(function()
		if player:GetAttribute("LifeState") ~= "Alive" then
			set(false)
		end
	end)
	-- Touch: a RUN toggle next to the jump button.
	local gui = player:WaitForChild("PlayerGui"):WaitForChild("TouchControls", 5)
	if gui then
		local btn = UI.Buttons.round("🏃", "RUN", 56, "Neutral", { Name = "Sprint", Position = UDim2.new(1, -85, 1, -375), AnchorPoint = Vector2.new(0.5, 0.5), Parent = gui })
		btn.Activated:Connect(function()
			State.Emit("Action", { Name = "SprintToggle", Down = true })
		end)
		State.On("SprintWanted", function(v)
			UI.Buttons.setTone(btn, if v then "Green" else "Neutral")
		end)
	end
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="917">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Toast notifications (right side), colour + glyph per kind, auto-stacking.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")

local Notifications = {}

local player = Players.LocalPlayer
local list: Frame
local order = 0
local recent: { [string]: number } = {}

function Notifications.Push(text: string, kind: string?)
	local k = kind or "info"
	-- Collapse spam of identical messages (e.g. "+2 Stick")
	local t = os.clock()
	if recent[text] and t - recent[text] < 0.6 then
		return
	end
	recent[text] = t
	order += 1
	local color = Theme.KindColor[k] or Theme.Colors.Info
	local card = UI.panel({ Size = UDim2.fromOffset(320, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = list }, { UI.padding(8) })
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
	UI.new("TextLabel", {
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = color,
		Text = Theme.KindGlyph[k] or "i",
		Font = Theme.FontBlack,
		TextSize = 14,
		TextColor3 = Color3.new(0, 0, 0),
		Parent = card,
	}, { UI.corner(UDim.new(0.5, 0)) })
	UI.text(text, { Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -30, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 15, Parent = card })
	-- pop in (quick scale from 0.85), fade everything out at the end
	local pop = UI.new("UIScale", { Scale = 0.85, Parent = card })
	TweenService:Create(pop, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local life = if k == "gain" then 1.8 elseif k == "danger" or k == "error" then 5 else 3.5
	task.delay(life, function()
		if not card.Parent then
			return
		end
		local info = TweenInfo.new(0.3)
		TweenService:Create(card, info, { BackgroundTransparency = 1 }):Play()
		for _, d in card:GetDescendants() do
			if d:IsA("TextLabel") then
				TweenService:Create(d, info, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, info, { Transparency = 1 }):Play()
			end
		end
		task.wait(0.3)
		card:Destroy()
	end)
	local cards = {}
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			table.insert(cards, c)
		end
	end
	if #cards > 5 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
end

function Notifications.Start()
	local gui = UI.new("ScreenGui", { Name = "Notifications", ResetOnSpawn = false, DisplayOrder = 20, Parent = player:WaitForChild("PlayerGui") })
	list = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(320, 400),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -150),
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom) })
	UI.new("UIScale", { Parent = list, Scale = 1 })
	State.On("Notify", function(n)
		Notifications.Push(n.Text, n.Kind)
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="918">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Modal panel manager. Only one large panel is open at a time; each has a
-- title bar with a large close button (touch friendly). Panels scale to the
-- screen and scroll when content is taller than the viewport.

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")

local Panels = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local panels: { [string]: { Frame: Frame, Body: ScrollingFrame, OnOpen: (() -> ())?, OnClose: (() -> ())?, Want: Vector2 } } = {}
local uiScale: UIScale

-- Fits a panel inside the screen (phones in landscape are short): the body
-- scrolls, so shrinking the height never hides content.
local function fit(p: { Frame: Frame, Want: Vector2 })
	local vp = workspace.CurrentCamera.ViewportSize
	local inset = GuiService:GetGuiInset()
	local s = if uiScale then uiScale.Scale else 1
	local maxH = math.max(200, (vp.Y - inset.Y - 24) / s)
	local maxW = math.max(260, (vp.X - 24) / s)
	p.Frame.Size = UDim2.fromOffset(math.min(p.Want.X, maxW), math.min(p.Want.Y, maxH))
end
Panels.Current = nil :: string?

function Panels.Start()
	gui = UI.new("ScreenGui", { Name = "Panels", ResetOnSpawn = false, DisplayOrder = 10, IgnoreGuiInset = false, Parent = player:WaitForChild("PlayerGui") })
	local scale = UI.new("UIScale", { Parent = gui })
	uiScale = scale
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 900, vp.Y / 560), 0.6, 1.15)
		for _, p in panels do
			fit(p)
		end
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
	UserInputService.InputBegan:Connect(function(io, processed)
		if io.KeyCode == Enum.KeyCode.Backspace and not processed and Panels.Current then
			Panels.Close()
		end
	end)
	State.On("OpenPanel", function(name)
		Panels.Open(name)
	end)
	player:GetAttributeChangedSignal("InMatch"):Connect(function()
		Panels.Close()
	end)
end

-- Creates (once) and returns the scrolling body of a panel.
function Panels.Create(name: string, title: string, size: Vector2, onOpen: (() -> ())?, onClose: (() -> ())?): ScrollingFrame
	while not gui do
		task.wait()
	end
	local frame = UI.panel({ Name = name, Size = UDim2.fromOffset(size.X, size.Y), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Visible = false, Parent = gui })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(size.X, size.Y), Parent = frame })
	local header = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = Theme.Colors.PanelLight, BorderSizePixel = 0, Parent = frame }, { UI.corner() })
	UI.text(title, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -80, 1, 0), TextSize = 22, Font = Theme.FontBlack, TextColor3 = Theme.Colors.Accent, Parent = header })
	UI.Buttons.icon("✖", { Size = UDim2.fromOffset(40, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Parent = header }, function()
		Panels.Close()
	end, "Red")
	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	}, { UI.padding(10) })
	panels[name] = { Frame = frame, Body = body, OnOpen = onOpen, OnClose = onClose, Want = size }
	fit(panels[name])
	return body
end

function Panels.Open(name: string)
	local p = panels[name]
	if not p then
		return
	end
	if Panels.Current and Panels.Current ~= name then
		Panels.Close()
	end
	Panels.Current = name
	p.Frame.Visible = true
	-- quick pop-in (fast enough to never slow the player down)
	local pop = p.Frame:FindFirstChild("Pop") :: UIScale? or UI.new("UIScale", { Name = "Pop", Parent = p.Frame })
	pop.Scale = 0.93
	TweenService:Create(pop, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if p.OnOpen then
		p.OnOpen()
	end
	GuiService.SelectedObject = nil
end

function Panels.Close()
	local name = Panels.Current
	if not name then
		return
	end
	local p = panels[name]
	Panels.Current = nil
	if p then
		p.Frame.Visible = false
		if p.OnClose then
			p.OnClose()
		end
	end
end

function Panels.Toggle(name: string)
	if Panels.Current == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.IsOpen(name: string): boolean
	return Panels.Current == name
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="919">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Custom ProximityPrompt presentation. Server prompts use Style=Custom; this
-- draws readable, touch-friendly prompt cards and hides prompts that don't
-- apply to the local player (team-only / enemy-only), with context hints
-- ("Night only", "Needs canteen", "Needs axe").

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Items = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Items"))

local Prompts = {}

local player = Players.LocalPlayer
local shown: { [ProximityPrompt]: BillboardGui } = {}

local function applies(prompt: ProximityPrompt): boolean
	local filter = prompt:GetAttribute("Filter")
	if not filter then
		return true
	end
	local team = prompt:GetAttribute("Team")
	local mine = player:GetAttribute("Team")
	if filter == "Team" then
		return team == mine
	elseif filter == "Enemy" then
		return team ~= mine
	end
	return true
end

local function hint(prompt: ProximityPrompt): string?
	local state = ReplicatedStorage:FindFirstChild("MatchState")
	if prompt:GetAttribute("Night") and state and state:GetAttribute("Phase") ~= "Night" then
		return "Night only"
	end
	if prompt:GetAttribute("Snuff") and state and not state:GetAttribute("SnuffOpen") then
		return "Protected until Night 3"
	end
	local inv = State.Get("Inventory")
	if prompt:GetAttribute("NeedsCanteen") then
		local util = inv and inv.Slots and inv.Slots.Utility
		if not util or util.Id ~= "Canteen" then
			return "Needs a canteen"
		end
	end
	if prompt:GetAttribute("Action") == "Pour" then
		local util = inv and inv.Slots and inv.Slots.Utility
		if not util or util.Id ~= "Canteen" then
			return "Needs a filled canteen"
		elseif not util.Filled then
			return "Canteen is empty"
		end
	end
	local need = prompt:GetAttribute("NeedsTool")
	if need then
		local minTier = prompt:GetAttribute("MinTier") or 1
		local ok = false
		for _, st in (inv and inv.Slots or {}) do
			local def = st and Items[st.Id]
			if def and def.ToolType == need and (def.ToolTier or 1) >= minTier then
				ok = true
			end
		end
		if not ok then
			return "Needs " .. ({ "Crude", "Stone", "Iron", "Steel" })[minTier] .. " " .. need .. "+"
		end
	end
	return nil
end

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Touch then
		return "TAP"
	elseif inputType == Enum.ProximityPromptInputType.Gamepad then
		return string.gsub(prompt.GamepadKeyCode.Name, "Button", "")
	end
	return prompt.KeyboardKeyCode.Name
end

local function show(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
		return
	end
	if not applies(prompt) then
		prompt.Enabled = false -- local only; server keeps it enabled for others
		return
	end
	local adornee = prompt.Parent
	if not adornee or not adornee:IsA("BasePart") then
		return
	end
	local hold = prompt:GetAttribute("Action") == "Pour"
	local h = hint(prompt)
	local bb = UI.new("BillboardGui", {
		Name = "Prompt",
		Adornee = adornee,
		Size = UDim2.fromOffset(230, 64),
		StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
		AlwaysOnTop = true,
		Active = true,
		MaxDistance = 40,
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local card = UI.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.12,
		AutoButtonColor = false,
		Text = "",
		Parent = bb,
	}, { UI.corner(UDim.new(0, 12)), UI.stroke(if h then Theme.Colors.Bad else Theme.Colors.Accent, 2, 0.1) })
	UI.new("TextLabel", {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = if h then Theme.Colors.PanelLighter else Theme.Colors.AccentDark,
		Text = keyText(prompt, inputType),
		TextScaled = true,
		Font = Theme.FontBlack,
		TextColor3 = Theme.Colors.Text,
		Parent = card,
	}, { UI.corner(UDim.new(0, 8)), UI.padding(6) })
	UI.text((if hold then "HOLD: " else "") .. prompt.ActionText, { Position = UDim2.fromOffset(66, 6), Size = UDim2.new(1, -72, 0, 28), Font = Theme.FontBold, TextSize = 20, Parent = card })
	UI.text(h or prompt.ObjectText, {
		Position = UDim2.fromOffset(66, 34),
		Size = UDim2.new(1, -72, 0, 22),
		TextSize = 15,
		TextColor3 = if h then Theme.Colors.Bad else Theme.Colors.TextDim,
		Parent = card,
	})
	-- Touch: the whole card is the button (hold for Pour)
	card.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldBegin()
		end
	end)
	card.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldEnd()
		end
	end)
	shown[prompt] = bb
end

local function hide(prompt: ProximityPrompt)
	local bb = shown[prompt]
	if bb then
		bb:Destroy()
		shown[prompt] = nil
	end
end

function Prompts.Start()
	ProximityPromptService.PromptShown:Connect(show)
	ProximityPromptService.PromptHidden:Connect(hide)
	-- Re-render hints when inventory changes (e.g. canteen filled)
	State.On("Inventory", function()
		for prompt, _ in shown do
			local inputType = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then Enum.ProximityPromptInputType.Touch else Enum.ProximityPromptInputType.Keyboard
			hide(prompt)
			if prompt.Parent then
				show(prompt, inputType)
			end
		end
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="920">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!nonstrict
-- In-match shop: public care package calls (paid random item → full odds are
-- shown before purchase, region-restricted players can't buy) and bandages.
-- Also lists stored credits (deferred purchases).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Loot = require(Shared.Loot)
local Products = require(Shared.Products)
local Net = require(Shared.Net)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")
local Hud = require("./Hud")

local Shop = {}

local player = Players.LocalPlayer
local body: ScrollingFrame
local C = Theme.Colors
local matchState = ReplicatedStorage:WaitForChild("MatchState")

local function oddsTable(parent: Instance, order: number)
	local box = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = parent }, { UI.corner(UDim.new(0, 8)), UI.padding(8), UI.list(Enum.FillDirection.Vertical, 2) })
	UI.text("Odds — each of the 3 items is rolled independently from this table:", { TextSize = 13, Font = Theme.FontBold, Parent = box })
	local total = Loot.TotalWeight(Loot.CarePackage)
	for i, e in Loot.CarePackage do
		UI.text(string.format("%-34s %5.1f%%", e.Label, e.Weight / total * 100), { LayoutOrder = i, TextSize = 13, Font = Enum.Font.RobotoMono, Parent = box })
	end
	UI.text("Total 100%. Contents drop on the ground for anyone to pick up.", { LayoutOrder = 99, TextSize = 12, TextColor3 = C.TextDim, Parent = box })
end

function Shop.Render()
	UI.clear(body)
	local profile = State.Get("Profile")
	local credits = profile and profile.Credits or { CarePackage = 0, Bandage = 0, Revive = {} }
	local night = matchState:GetAttribute("Phase") == "Night"
	local restricted = player:GetAttribute("PaidRandomRestricted") == true
	local order = 1
	-- Care package
	local card = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 150), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = body }, { UI.corner(UDim.new(0, 8)), UI.padding(10) })
	order += 1
	local ic = UI.icon("✚", C.Accent, 56, "Square")
	ic.Parent = card
	UI.text("Call a Public Care Package", { Position = UDim2.fromOffset(66, 0), Size = UDim2.new(1, -200, 0, 24), TextSize = 18, Font = Theme.FontBlack, Parent = card })
	UI.text("Everyone is told where it lands, and any clan can open it (3 random items).\n" .. (if night then "It's night: your package will be queued and drop at DAWN." else "Drops shortly after purchase (drops are spaced out)."), { Position = UDim2.fromOffset(66, 26), Size = UDim2.new(1, -200, 0, 60), TextSize = 13, TextColor3 = if night then C.Warn else C.TextDim, Parent = card })
	if restricted then
		UI.text("Paid care packages aren't available in your region. The free daily package still drops for everyone.", { Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 34), TextSize = 13, TextColor3 = C.Warn, Parent = card })
	else
		local label = if (credits.CarePackage or 0) > 0 then "Use credit (" .. credits.CarePackage .. ")" else Hud.PriceText("CarePackage")
		UI.button(label, { Size = UDim2.fromOffset(160, 46), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(40, 110, 60), Parent = card }, function()
			Net.Event("BuyInMatch"):FireServer({ Kind = "CarePackage" })
		end)
		UI.text("Odds are listed below ↓", { Position = UDim2.new(0, 66, 0, 100), TextSize = 13, TextColor3 = C.Info, Parent = card })
	end
	if not restricted then
		oddsTable(body, order)
		order += 1
	end
	-- Bandage
	local bcard = UI.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 86), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = body }, { UI.corner(UDim.new(0, 8)), UI.padding(10) })
	order += 1
	local bic = UI.icon("✚", C.Bad, 56, "Round")
	bic.Parent = bcard
	UI.text("Bandage", { Position = UDim2.fromOffset(66, 0), Size = UDim2.new(1, -200, 0, 24), TextSize = 18, Font = Theme.FontBlack, Parent = bcard })
	UI.text("Heals 45 HP over 3 s. Delivered to your pouch (max 3); extras are stored for later.", { Position = UDim2.fromOffset(66, 26), Size = UDim2.new(1, -240, 0, 40), TextSize = 13, TextColor3 = C.TextDim, Parent = bcard })
	UI.button(Hud.PriceText("Bandage"), { Size = UDim2.fromOffset(160, 46), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(40, 110, 60), Parent = bcard }, function()
		Net.Event("BuyInMatch"):FireServer({ Kind = "Bandage" })
	end)
	-- Credits
	local rev = {}
	for tier, n in credits.Revive or {} do
		table.insert(rev, "tier " .. tier .. " ×" .. n)
	end
	UI.text(string.format("Stored credits — Care packages: %d · Bandages: %d · Revives: %s", credits.CarePackage or 0, credits.Bandage or 0, if #rev > 0 then table.concat(rev, ", ") else "none"), { LayoutOrder = order, TextSize = 13, TextColor3 = C.TextDim, Parent = body })
end

function Shop.Start()
	body = Panels.Create("Shop", "SUPPLY SHOP", Vector2.new(620, 620), Shop.Render)
	UI.list(Enum.FillDirection.Vertical, 8).Parent = body
	local gui = UI.new("ScreenGui", { Name = "ShopButton", ResetOnSpawn = false, DisplayOrder = 4, Parent = player:WaitForChild("PlayerGui") })
	local btn = UI.button("✚ Shop", { Size = UDim2.fromOffset(96, 44), Position = UDim2.new(0, 12, 1, -176), BackgroundColor3 = Color3.fromRGB(60, 90, 50), Parent = gui }, function()
		Panels.Toggle("Shop")
	end)
	local function vis()
		-- Nothing gameplay-affecting is sold (non-pay-to-win), so the in-match shop stays hidden.
		btn.Visible = player:GetAttribute("InMatch") == true and (Products.OnSale("CarePackage") or Products.OnSale("Bandage"))
	end
	player:GetAttributeChangedSignal("InMatch"):Connect(vis)
	vis()
	State.On("PricesUpdated", function()
		if Panels.IsOpen("Shop") then
			Shop.Render()
		end
	end)
	State.On("Profile", function()
		if Panels.IsOpen("Shop") then
			Shop.Render()
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="921">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!nonstrict
-- UI sounds, ambience and event stingers (local-only playback).

local SoundService = game:GetService("SoundService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundLib = require(ReplicatedStorage.Shared.Sounds)
local State = require("../State")
local UI = require("../UI/UI")

local SoundCtl = {}

local cache: { [string]: Sound } = {}
local ambient: Sound? = nil

function SoundCtl.Play(name: string)
	local s = cache[name]
	if not s then
		local made = SoundLib.Make(name)
		if not made then
			return
		end
		made.Parent = SoundService
		cache[name] = made
		s = made
	end
	(s :: Sound):Play()
end

local function settings(): { [string]: any }
	local prof = State.Get("Profile")
	return (prof and prof.Settings) or {}
end

local ambientName: string? = nil
local function setAmbient(name: string)
	if name == ambientName then
		return
	end
	ambientName = name
	if ambient then
		ambient:Stop()
		ambient:Destroy()
		ambient = nil
	end
	local s = SoundLib.Make(name)
	if s then
		s.Looped = true
		s.Parent = SoundService
		s:SetAttribute("BaseVolume", s.Volume)
		local vol = settings().Ambience
		if type(vol) == "number" then
			s.Volume *= vol
		end
		s:Play()
		ambient = s
	end
end


function SoundCtl.Start()
	UI.ClickSound = function()
		if settings().UiSounds ~= false then
			SoundCtl.Play("UiClick")
		end
	end
	State.On("Profile", function()
		local vol = settings().Ambience
		if ambient and type(vol) == "number" then
			local base = ambient:GetAttribute("BaseVolume")
			ambient.Volume = (if type(base) == "number" then base else ambient.Volume) * vol
		end
	end)
	State.On("Notify", function(n)
		if n.Kind == "error" then
			SoundCtl.Play("UiError")
		elseif type(n.Text) == "string" and string.sub(n.Text, 1, 6) == "LEVEL " then
			SoundCtl.Play("LevelUp")
		elseif type(n.Text) == "string" and string.find(n.Text, "Purchase complete", 1, true) then
			SoundCtl.Play("Purchase")
		else
			SoundCtl.Play("Notify")
		end
	end)
	State.On("MatchEvent", function(ev)
		local name = ev.Name
		if name == "Phase" then
			SoundCtl.Play(if ev.Data.Phase == "Night" then "Dusk" else "Dawn")
			setAmbient(if ev.Data.Phase == "Night" then "AmbientNight" else "AmbientDay")
		elseif name == "FireUnderAttack" then
			SoundCtl.Play("Alarm")
		elseif name == "Upgraded" then
			SoundCtl.Play("LevelUp")
		elseif name == "LootReveal" then
			local d = ev.Data or {}
			SoundCtl.Play(if d.Tier == "Rare" or d.Tier == "VeryRare" then "LevelUp" else "Reward")
		elseif name == "FireOut" then
			SoundCtl.Play("FireOut")
		elseif name == "MatchEnded" then
			SoundCtl.Play(if ev.Data.Won then "Victory" else "Defeat")
		elseif name == "Died" or name == "Eliminated" then
			SoundCtl.Play("Death")
		elseif name == "FireCritical" then
			SoundCtl.Play("Alarm")
		elseif name == "Sunset" then
			SoundCtl.Play("Sunset")
		elseif name == "Reward" then
			SoundCtl.Play("Reward")
		elseif name == "HurtCue" then
			SoundCtl.Play("HurtCue")
		elseif name == "ReturnedToLobby" then
			setAmbient("AmbientLobby")
		end
	end)
	-- Context ambience: lobby / cave override the day-night loop.
	local player = Players.LocalPlayer
	local ms = ReplicatedStorage:WaitForChild("MatchState")
	local FOOT = {
		[Enum.Material.Grass] = "FootGrass", [Enum.Material.LeafyGrass] = "FootLeaves", [Enum.Material.Ground] = "FootLeaves",
		[Enum.Material.Mud] = "FootMud", [Enum.Material.Rock] = "FootStone", [Enum.Material.Slate] = "FootStone",
		[Enum.Material.Cobblestone] = "FootStone", [Enum.Material.Wood] = "FootWood", [Enum.Material.WoodPlanks] = "FootWood",
		[Enum.Material.Metal] = "FootMetal", [Enum.Material.DiamondPlate] = "FootMetal",
	}
	local rainLoop: Sound? = nil
	local nextHowl = os.clock() + 25
	local defaultRun: { [Sound]: string } = setmetatable({}, { __mode = "k" }) :: any
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then
			return
		end
		acc = 0
		local inMatch = player:GetAttribute("InMatch") == true
		if not inMatch then
			setAmbient("AmbientLobby")
		elseif player:GetAttribute("InCave") then
			setAmbient("AmbientCave")
		else
			setAmbient(if ms:GetAttribute("Phase") == "Night" then "AmbientNight" else "AmbientDay")
		end
		-- night soundscape: now and then a distant howl or growl from somewhere in the dark
		-- (a random far bearing — atmosphere, never a real position, so it gives nothing away)
		if inMatch and ms:GetAttribute("Phase") == "Night" and os.clock() > nextHowl then
			nextHowl = os.clock() + math.random(20, 45)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local s = SoundLib.Make(if math.random() < 0.7 then "WolfGrowl" else "BearRoar")
			if root and s then
				local a = math.random() * math.pi * 2
				local spot = Instance.new("Part")
				spot.Anchored = true
				spot.CanCollide = false
				spot.CanQuery = false
				spot.Transparency = 1
				spot.Size = Vector3.one
				spot.Position = root.Position + Vector3.new(math.cos(a) * 90, 10, math.sin(a) * 90)
				spot.Parent = workspace.CurrentCamera
				s.RollOffMaxDistance = 400
				s.RollOffMinDistance = 60
				s.Volume *= 0.7
				s.Parent = spot
				s:Play()
				game:GetService("Debris"):AddItem(spot, 6)
			end
		end
		-- rain loop layered over the ambience during showers
		local wantRain = inMatch and ms:GetAttribute("Weather") == "Rain"
		if wantRain and not rainLoop then
			rainLoop = SoundLib.Make("Rain")
			if rainLoop then
				rainLoop.Looped = true
				rainLoop.Parent = SoundService
				rainLoop:Play()
			end
		elseif not wantRain and rainLoop then
			rainLoop:Destroy()
			rainLoop = nil
		end
		-- surface footsteps (only when a licensed clip is configured)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local run = root and root:FindFirstChild("Running") :: Sound?
		if hum and run then
			if not defaultRun[run] then
				defaultRun[run] = run.SoundId
			end
			local id = SoundLib.Resolve(FOOT[hum.FloorMaterial] or "")
			run.SoundId = id or defaultRun[run]
		end
	end)
	State.On("Hit", function(h)
		if h.Kind == "Hurt" then
			SoundCtl.Play("HitFlesh")
		end
	end)
end

return SoundCtl
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="922">
            <Properties>
              <string name="Name">Spectate</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Spectator camera for players who are down or eliminated. Cycles through
-- living clanmates first, then everyone else still alive in the match.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require("../UI/UI")
local Net = require(game:GetService("ReplicatedStorage").Shared.Net)
local Theme = require("../UI/Theme")

local Spectate = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local index = 1
local bar: Frame
local nameLabel: TextLabel

local function candidates(): { Player }
	local mine, others = {}, {}
	local team = player:GetAttribute("Team")
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("InMatch") and p:GetAttribute("LifeState") == "Alive" and p.Character then
			if p:GetAttribute("Team") == team then
				table.insert(mine, p)
			else
				table.insert(others, p)
			end
		end
	end
	for _, p in others do
		table.insert(mine, p)
	end
	return mine
end

local function spectating(): boolean
	local st = player:GetAttribute("LifeState")
	return player:GetAttribute("InMatch") == true and (st == "Eliminated" or st == "AwaitingRevive")
end

function Spectate.Start()
	local gui = UI.new("ScreenGui", { Name = "Spectate", ResetOnSpawn = false, DisplayOrder = 4, Parent = player:WaitForChild("PlayerGui") })
	bar = UI.panel({ Size = UDim2.fromOffset(420, 60), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Visible = false, Parent = gui })
	UI.Buttons.icon("◀", { Size = UDim2.fromOffset(60, 48), Position = UDim2.fromOffset(6, 6), TextSize = 24, Parent = bar }, function()
		index -= 1
	end)
	UI.Buttons.icon("▶", { Size = UDim2.fromOffset(60, 48), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), TextSize = 24, Parent = bar }, function()
		index += 1
	end)
	local leave = UI.Buttons.action("🏠 Return to lobby", { Size = UDim2.fromOffset(220, 42), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -8), Tone = "Neutral", Parent = bar }, function()
		Net.Event("LeaveMatch"):FireServer()
	end)
	leave.Name = "Leave"
	nameLabel = UI.text("", { Position = UDim2.fromOffset(70, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 16, Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Parent = bar })

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		if spectating() then
			local list = candidates()
			bar.Visible = true
			local leaveBtn = bar:FindFirstChild("Leave") :: GuiObject?
			if leaveBtn then
				leaveBtn.Visible = player:GetAttribute("LifeState") == "Eliminated"
			end
			if #list == 0 then
				nameLabel.Text = "No one left to watch"
				return
			end
			index = ((index - 1) % #list) + 1
			local target = list[index]
			local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
			if hum and camera.CameraSubject ~= hum then
				camera.CameraSubject = hum
			end
			nameLabel.Text = "Watching " .. target.DisplayName .. (if target:GetAttribute("Team") == player:GetAttribute("Team") then " (clanmate)" else "")
		else
			bar.Visible = false
			local myHum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if myHum and camera.CameraSubject ~= myHum and player:GetAttribute("LifeState") ~= "Respawning" then
				camera.CameraSubject = myHum
			end
		end
	end)
end

return Spectate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="923">
            <Properties>
              <string name="Name">Storage</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Storage panel. Owners deposit/withdraw; enemies can take anything from a
-- storage they have breached (StorageService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local InventoryModel = require(Shared.Logic.InventoryModel)
local UI = require("../UI/UI")
local Theme = require("../UI/Theme")
local State = require("../State")
local Panels = require("./Panels")

local Storage = {}

local player = Players.LocalPlayer
local body: ScrollingFrame
local C = Theme.Colors
local RES = InventoryModel.ResourceIds

local function act(action: string, resource: string?, count: number?)
	local s = State.Get("Storage")
	if not s or not s.Key then
		return
	end
	Net.Event("StorageAction"):FireServer({ Key = s.Key, Action = action, Resource = resource, Count = count })
end

function Storage.Render()
	UI.clear(body)
	local s = State.Get("Storage")
	local inv = State.Get("Inventory")
	if not s or not s.Items then
		return
	end
	local meta = s.Meta or {}
	local used = meta.SlotsUsed or InventoryModel.SlotsUsedBy(s.Items)
	local owner = s.Mode == "Owner"
	local loot = s.Mode == "Loot"
	local intro = if owner
		then (if meta.Breached then "⚠ BREACHED — enemies can take from it. Hold R at the storage to resecure it." else "Your storage. Everything here can be used to build and upgrade.")
		elseif loot then "BREACHED ENEMY STORAGE — take what fits in your pack."
		else "Locked. Breach it first (hold G at the storage)."
	UI.text((meta.Name or "Storage") .. "  ·  " .. intro, { LayoutOrder = 1, TextSize = 14, TextColor3 = if owner and not meta.Breached then C.TextDim else C.Warn, Size = UDim2.new(1, -8, 0, 40), Parent = body })
	local _, setBar = UI.bar({ LayoutOrder = 2, Size = UDim2.new(1, -8, 0, 20), Parent = body }, C.Info)
	setBar(used / math.max(1, s.Capacity), string.format("%d / %d stack slots", used, s.Capacity))
	if owner then
		UI.button("Deposit everything I carry", { LayoutOrder = 3, Size = UDim2.new(1, -8, 0, 48), BackgroundColor3 = C.AccentDark, Parent = body }, function()
			act("DepositAll")
		end)
	elseif loot then
		UI.button("Take everything that fits", { LayoutOrder = 3, Size = UDim2.new(1, -8, 0, 48), BackgroundColor3 = Color3.fromRGB(120, 60, 30), Parent = body }, function()
			act("TakeAll")
		end)
	end
	for i, id in RES do
		local def = Items[id]
		local have = s.Items[id] or 0
		local carry = inv and inv.Resources[id] or 0
		if not owner and have <= 0 then
			continue
		end
		if owner and have <= 0 and carry <= 0 then
			continue
		end
		local r = UI.new("Frame", { LayoutOrder = 10 + i, Size = UDim2.new(1, -8, 0, 54), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0, Parent = body }, { UI.corner(UDim.new(0, 8)) })
		local ic = UI.icon(def.Icon.Glyph, def.Icon.Color, 40, "Square")
		ic.Position = UDim2.fromOffset(6, 7)
		ic.Parent = r
		UI.text(string.format("%s   stored %d   ·   you carry %d", def.Name, have, carry), { Position = UDim2.fromOffset(54, 16), Size = UDim2.new(1, -330, 0, 22), TextSize = 15, Font = Theme.FontBold, Parent = r })
		if owner then
			UI.button("Put all", { Size = UDim2.fromOffset(70, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -158, 0.5, 0), TextSize = 13, Parent = r }, function()
				act("Deposit", id, math.max(1, carry))
			end)
			UI.button("Take 10", { Size = UDim2.fromOffset(70, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -82, 0.5, 0), TextSize = 13, BackgroundColor3 = Color3.fromRGB(50, 80, 110), Parent = r }, function()
				act("Withdraw", id, 10)
			end)
			UI.button("Take 1", { Size = UDim2.fromOffset(70, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), TextSize = 13, BackgroundColor3 = Color3.fromRGB(50, 80, 110), Parent = r }, function()
				act("Withdraw", id, 1)
			end)
		elseif loot then
			UI.button("Take all", { Size = UDim2.fromOffset(110, 42), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), TextSize = 14, BackgroundColor3 = Color3.fromRGB(120, 60, 30), Parent = r }, function()
				act("Withdraw", id, have)
			end)
		end
	end
end

function Storage.Start()
	body = Panels.Create("Storage", "STORAGE", Vector2.new(620, 560), nil, function()
		act("Close")
	end)
	UI.list(Enum.FillDirection.Vertical, 6).Parent = body
	State.On("Storage", function(s)
		if s.Mode == "Closed" then
			if Panels.IsOpen("Storage") then
				Panels.Close()
			end
			return
		end
		if not Panels.IsOpen("Storage") then
			Panels.Open("Storage")
		end
		Storage.Render()
	end)
	State.On("Inventory", function()
		if Panels.IsOpen("Storage") then
			Storage.Render()
		end
	end)
	local _ = player
end

return Storage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="924">
            <Properties>
              <string name="Name">Weather</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client weather: rain showers chosen by the server (MatchState.Weather).
-- A single rain emitter follows the camera (cheap on mobile), the image gets a
-- little greyer and hazier, and at night distant lightning flashes now and then.
-- Purely visual; gameplay never changes with the weather.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Weather = {}

local player = Players.LocalPlayer

function Weather.Start()
	local ms = ReplicatedStorage:WaitForChild("MatchState")
	local holder = Instance.new("Part")
	holder.Name = "RainHolder"
	holder.Size = Vector3.new(90, 1, 90)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Parent = workspace.CurrentCamera
	local rain = Instance.new("ParticleEmitter")
	rain.Name = "Rain"
	rain.Rate = 0
	rain.Lifetime = NumberRange.new(0.9, 1.2)
	rain.Speed = NumberRange.new(70, 85)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.SpreadAngle = Vector2.new(4, 4)
	rain.Size = NumberSequence.new(0.08)
	rain.Squash = NumberSequence.new(-4) -- long thin streaks
	rain.Transparency = NumberSequence.new(0.55)
	rain.Color = ColorSequence.new(Color3.fromRGB(190, 205, 220))
	rain.LightInfluence = 1
	rain.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
	rain.Parent = holder
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "WeatherGrade"
	grade.Parent = Lighting
	local flash = Instance.new("ColorCorrectionEffect")
	flash.Name = "Lightning"
	flash.Parent = Lighting

	local raining = false
	local function apply()
		local want = ms:GetAttribute("Weather") == "Rain" and player:GetAttribute("InMatch") == true
		if want == raining then
			return
		end
		raining = want
		local info = TweenInfo.new(6)
		TweenService:Create(rain, info, { Rate = if want then 600 else 0 }):Play()
		TweenService:Create(grade, info, { Saturation = if want then -0.18 else 0, Brightness = if want then -0.04 else 0, TintColor = if want then Color3.fromRGB(225, 232, 240) else Color3.new(1, 1, 1) }):Play()
	end
	ms:GetAttributeChangedSignal("Weather"):Connect(apply)
	player:GetAttributeChangedSignal("InMatch"):Connect(apply)
	apply()

	local nextFlash = os.clock() + 10
	RunService.Heartbeat:Connect(function()
		if raining then
			local cam = workspace.CurrentCamera.CFrame.Position
			holder.CFrame = CFrame.new(cam + Vector3.new(0, 45, 0))
			-- distant lightning at night: a brief brightening, no damage, no noise spam
			if ms:GetAttribute("Phase") == "Night" and os.clock() > nextFlash then
				nextFlash = os.clock() + math.random(12, 30)
				flash.Brightness = 0.35
				TweenService:Create(flash, TweenInfo.new(0.4), { Brightness = 0 }):Play()
			end
		end
	end)
end

return Weather
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="925">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Survival Hour client entry point. Presentation only: every gameplay action
-- is a request that the server validates.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end
ReplicatedStorage:WaitForChild("Shared")
ReplicatedStorage:WaitForChild("Remotes")
ReplicatedStorage:WaitForChild("MatchState")

local Net = require(ReplicatedStorage.Shared.Net)
local State = require(script.Parent:WaitForChild("State"))

-- Hide default inventory UI; keep chat, player list and the reset button.
for _, t in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(t, false)
	end)
end

-- Route server pushes into the store.
Net.Event("InventorySync").OnClientEvent:Connect(function(snap)
	State.Set("Inventory", snap)
end)
Net.Event("ProfileSync").OnClientEvent:Connect(function(view)
	State.Set("Profile", view)
end)
Net.Event("LobbySync").OnClientEvent:Connect(function(view)
	State.Set("Lobby", view)
end)
Net.Event("CraftSync").OnClientEvent:Connect(function(view)
	State.Set("Craft", view)
	if view.Open then
		State.Emit("OpenPanel", "Craft")
	end
end)
Net.Event("AbilitySync").OnClientEvent:Connect(function(view)
	State.Set("Ability", view)
end)
Net.Event("MapData").OnClientEvent:Connect(function(data)
	State.Set("Map", data)
end)
Net.Event("StorageSync").OnClientEvent:Connect(function(key, items, mode, capacity, meta)
	State.Set("Storage", { Key = key, Items = items, Mode = mode, Capacity = capacity, Meta = meta or {} })
end)
Net.Event("ChannelState").OnClientEvent:Connect(function(s)
	State.Emit("Channel", s)
end)
Net.Event("Notify").OnClientEvent:Connect(function(text, kind)
	State.Emit("Notify", { Text = text, Kind = kind })
end)
Net.Event("MatchEvent").OnClientEvent:Connect(function(name, payload)
	State.Emit("MatchEvent", { Name = name, Data = payload })
end)
Net.Event("HitFeedback").OnClientEvent:Connect(function(kind, amount, pos)
	State.Emit("Hit", { Kind = kind, Amount = amount, Pos = pos })
end)
Net.Event("Fx").OnClientEvent:Connect(function(name, payload)
	State.Emit("Fx", { Name = name, Data = payload })
end)
Net.Event("Reveal").OnClientEvent:Connect(function(kind, list, duration)
	State.Emit("Reveal", { Kind = kind, List = list, Duration = duration })
end)

-- Start controllers (each module exposes Start()).
local order = {
	"Sound",
	"Camera",
	"Input",
	"Movement",
	"Prompts",
	"Hud",
	"Notifications",
	"Panels",
	"Inventory",
	"Craft",
	"Build",
	"Storage",
	"Shop",
	"Lobby",
	"Map",
	"Combat",
	"Animation",
	"Creatures",
	"Effects",
	"Guide",
	"Weather",
	"Spectate",
	"Dev",
}
local Controllers = script.Parent:WaitForChild("Controllers")
for _, name in order do
	local mod = Controllers:WaitForChild(name, 10)
	if mod then
		local ok, ctrl = pcall(require, mod)
		if ok and type(ctrl) == "table" and ctrl.Start then
			task.spawn(function()
				local ok2, err = pcall(ctrl.Start)
				if not ok2 then
					warn("[Client] " .. name .. " failed to start:", err)
				end
			end)
		elseif not ok then
			warn("[Client] " .. name .. " failed to load:", ctrl)
		end
	end
end

Net.Event("ClientReady"):FireServer()
local _ = Players
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="926">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client-side store for server snapshots with change signals.

local State = {}

type Listener = (any) -> ()
local listeners: { [string]: { Listener } } = {}
local values: { [string]: any } = {}

function State.Set(key: string, value: any)
	values[key] = value
	for _, fn in listeners[key] or {} do
		task.spawn(fn, value)
	end
end

function State.Get(key: string): any
	return values[key]
end

-- Subscribes; calls immediately if a value exists. Returns an unsubscribe fn.
function State.On(key: string, fn: Listener): () -> ()
	listeners[key] = listeners[key] or {}
	table.insert(listeners[key], fn)
	if values[key] ~= nil then
		task.spawn(fn, values[key])
	end
	return function()
		local list = listeners[key]
		local i = list and table.find(list, fn)
		if i then
			table.remove(list, i)
		end
	end
end

-- Fire-and-forget events (no stored value)
function State.Emit(key: string, value: any)
	for _, fn in listeners[key] or {} do
		task.spawn(fn, value)
	end
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="927">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="928">
            <Properties>
              <string name="Name">Buttons</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Survival Hour button kit (docs/ui/button_reference.png).
--
-- Six styles, one look: dark steel plates with a bevel gradient, a coloured
-- rim and a soft outer glow.
--   Buttons.primary  big green call-to-action (ENTER THE REFUGE, READY UP)
--   Buttons.tile     square menu tile: icon + TITLE + subtitle
--   Buttons.round    round mobile action button (ATTACK, AIM/BLOCK, HEAL, SWAP, RUN)
--   Buttons.action   small action button (EQUIP, UNLOCK ◆ 250, BUY ● 500, CLAIM, LOCKED)
--   Buttons.tab      tab (OUTFITS, BACKPACKS...)
--   Buttons.icon     icon-only square (✖, ◀, ▶, +)
-- States (all styles): Normal · Hover/Pressed (green rim + glow) · Disabled
-- (grey, ignores clicks) · Selected/Equipped (gold rim + glow, ✓).
-- Tones pick the resting colour: Neutral, Green, Gold, Red, Blue.

local TweenService = game:GetService("TweenService")

local Theme = require("./Theme")

local Buttons = {}

-- click sound hook (UI.luau points this at UI.ClickSound)
Buttons.GetClickSound = function(): (() -> ())?
	return nil
end

type Tone = { Top: Color3, Rim: Color3, Text: Color3, Glow: number }

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

Buttons.Tones = {
	Neutral = { Top = rgb(44, 53, 61), Rim = rgb(88, 100, 110), Text = rgb(236, 240, 242), Glow = 1 },
	Green = { Top = rgb(58, 150, 40), Rim = rgb(134, 255, 90), Text = rgb(255, 255, 255), Glow = 0.55 },
	Gold = { Top = rgb(66, 54, 26), Rim = rgb(242, 193, 78), Text = rgb(255, 231, 160), Glow = 0.5 },
	Red = { Top = rgb(160, 44, 34), Rim = rgb(255, 106, 90), Text = rgb(255, 240, 236), Glow = 0.6 },
	Blue = { Top = rgb(40, 96, 180), Rim = rgb(106, 184, 255), Text = rgb(240, 248, 255), Glow = 0.6 },
	Disabled = { Top = rgb(58, 62, 66), Rim = rgb(92, 96, 100), Text = rgb(138, 142, 146), Glow = 1 },
} :: { [string]: Tone }

local HOVER_RIM = rgb(134, 255, 90)

local function new(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className :: any)
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Price text: Coins ● gold, Diamonds ◆ cyan, Robux R$.
function Buttons.priceText(kind: string?, amount: number?): string
	if not kind or not amount then
		return ""
	end
	local n = tostring(amount)
	n = string.reverse((string.gsub(string.reverse(n), "(%d%d%d)", "%1,")))
	if string.sub(n, 1, 1) == "," then
		n = string.sub(n, 2)
	end
	if kind == "Coins" then
		return ' <font color="#F2C14E">●</font> ' .. n
	elseif kind == "Diamonds" then
		return ' <font color="#7EE0FF">◆</font> ' .. n
	elseif kind == "Robux" then
		return " R$ " .. n
	end
	return " " .. n
end

-- Applies the kit look to any GuiButton and wires hover/press feedback.
-- Stores Tone/State as attributes so setState/setTone can restyle later.
function Buttons.decorate(b: GuiButton, tone: string?, radius: UDim?)
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b:SetAttribute("Tone", tone or "Neutral")
	b:SetAttribute("State", b:GetAttribute("State") or "Normal")
	if not b:FindFirstChildOfClass("UICorner") then
		new("UICorner", { CornerRadius = radius or UDim.new(0, 8), Parent = b })
	end
	local stroke = b:FindFirstChildOfClass("UIStroke") or new("UIStroke", { Parent = b })
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Thickness = 2
	stroke.Transparency = 0
	if not b:FindFirstChild("Bevel") then
		new("UIGradient", {
			Name = "Bevel",
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
				ColorSequenceKeypoint.new(0.5, rgb(200, 200, 200)),
				ColorSequenceKeypoint.new(1, rgb(120, 120, 120)),
			}),
			Parent = b,
		})
	end
	if not b:FindFirstChild("Glow") then
		-- a ring just outside the plate: reads as a soft glow and never covers content
		local glow = new("Frame", {
			Name = "Glow",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 8, 1, 8),
			Position = UDim2.fromOffset(-4, -4),
			ZIndex = b.ZIndex,
			Active = false,
			Parent = b,
		}, {
			new("UICorner", { CornerRadius = if radius and radius.Scale > 0 then radius else UDim.new(0, (radius and radius.Offset or 8) + 4) }),
			new("UIStroke", { Thickness = 4, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		})
		glow:SetAttribute("Deco", true)
	end
	Buttons.refresh(b)
	if b:GetAttribute("Wired") then
		return
	end
	b:SetAttribute("Wired", true)
	b.MouseEnter:Connect(function()
		b:SetAttribute("Hover", true)
		Buttons.refresh(b)
	end)
	b.MouseLeave:Connect(function()
		b:SetAttribute("Hover", nil)
		b:SetAttribute("Down", nil)
		Buttons.refresh(b)
		local ps = b:FindFirstChild("Press") :: UIScale?
		if ps then
			ps.Scale = 1
		end
	end)
	-- press feedback: a quick squash to 95% and back
	local press = new("UIScale", { Name = "Press", Parent = b })
	local quick = TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	b.MouseButton1Down:Connect(function()
		b:SetAttribute("Down", true)
		Buttons.refresh(b)
		if b:GetAttribute("State") ~= "Disabled" then
			TweenService:Create(press, quick, { Scale = 0.95 }):Play()
		end
	end)
	b.MouseButton1Up:Connect(function()
		b:SetAttribute("Down", nil)
		Buttons.refresh(b)
		TweenService:Create(press, quick, { Scale = 1 }):Play()
	end)
end

-- Recolours a decorated button from its Tone / State / hover attributes.
function Buttons.refresh(b: GuiButton)
	local state = b:GetAttribute("State") or "Normal"
	local toneName = if state == "Disabled" then "Disabled" elseif state == "Selected" then "Gold" else (b:GetAttribute("Tone") or "Neutral")
	local tone = Buttons.Tones[toneName] or Buttons.Tones.Neutral
	local hot = state ~= "Disabled" and (b:GetAttribute("Hover") or b:GetAttribute("Down"))
	local top = tone.Top
	if b:GetAttribute("Down") and state ~= "Disabled" then
		top = top:Lerp(Color3.new(0, 0, 0), 0.25)
	elseif hot then
		top = top:Lerp(Color3.new(1, 1, 1), 0.08)
	end
	b.BackgroundColor3 = top
	b.BackgroundTransparency = 0
	local stroke = b:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if hot and toneName ~= "Red" then HOVER_RIM else tone.Rim
	end
	local glow = b:FindFirstChild("Glow")
	local gs = glow and glow:FindFirstChildOfClass("UIStroke")
	if gs then
		gs.Color = if hot and toneName ~= "Red" then HOVER_RIM else tone.Rim
		gs.Transparency = if hot then 0.45 else tone.Glow
	end
	if b:IsA("TextButton") and b.Text ~= "" then
		b.TextColor3 = tone.Text
	end
	for _, d in b:GetDescendants() do
		if d:IsA("TextLabel") and d:GetAttribute("Tinted") then
			d.TextColor3 = if d:GetAttribute("Sub") then tone.Text:Lerp(tone.Top, 0.35) else tone.Text
		end
	end
	b.Active = state ~= "Disabled"
	local ps = b:FindFirstChild("Press") :: UIScale?
	if ps and state ~= "Disabled" then
		ps.Scale = if b:GetAttribute("Down") then 0.95 else 1
	end
end

function Buttons.setState(b: GuiButton, state: string)
	b:SetAttribute("State", state)
	Buttons.refresh(b)
end

function Buttons.setTone(b: GuiButton, tone: string)
	b:SetAttribute("Tone", tone)
	Buttons.refresh(b)
end

local function wireClick(b: GuiButton, onClick: (() -> ())?)
	if not onClick then
		return
	end
	b.Activated:Connect(function()
		if b:GetAttribute("State") == "Disabled" then
			return
		end
		local sfx = Buttons.GetClickSound()
		if sfx then
			sfx()
		end
		onClick()
	end)
end

local function label(parent: Instance, text: string, props: { [string]: any }): TextLabel
	local p = table.clone(props)
	p.BackgroundTransparency = 1
	p.Text = text
	p.Font = p.Font or Theme.FontBlack
	p.TextScaled = if p.TextScaled == nil then true else p.TextScaled
	p.RichText = true
	p.Parent = parent
	local l = new("TextLabel", p)
	l:SetAttribute("Tinted", true)
	return l
end

local function base(className: string, props: { [string]: any }?): { [string]: any }
	local p = props and table.clone(props) or {}
	p.Tone = nil
	p.State = nil
	p.Price = nil
	p.Sub = nil
	p.Glyph = nil
	return p
end

--- Big primary button. Returns the button and setter(text, sub?, state?).
function Buttons.primary(text: string, props: { [string]: any }?, onClick: (() -> ())?): (TextButton, (string, string?, string?) -> ())
	local p = base("TextButton", props)
	p.Text = ""
	p.Size = p.Size or UDim2.fromOffset(420, 72)
	local b = new("TextButton", p)
	Buttons.decorate(b, (props and props.Tone) or "Green", UDim.new(0, 12))
	-- pine silhouettes at both ends, like the reference plate
	for _, side in { 0, 1 } do
		local trees = label(b, "▲▲", { Name = "Trees" .. side, Size = UDim2.new(0.16, 0, 0.7, 0), Position = UDim2.new(if side == 0 then 0.02 else 0.82, 0, 0.15, 0), TextTransparency = 0.55, Font = Theme.FontBlack })
		trees:SetAttribute("Tinted", nil)
		trees.TextColor3 = rgb(10, 40, 8)
	end
	local main = label(b, text, { Name = "Main", Size = UDim2.new(0.68, 0, 0.62, 0), Position = UDim2.fromScale(0.16, 0.19), TextStrokeTransparency = 0.5 })
	local sub = label(b, "", { Name = "Sub", Size = UDim2.new(0.6, 0, 0.26, 0), Position = UDim2.fromScale(0.2, 0.66), Font = Theme.FontBold, Visible = false })
	sub:SetAttribute("Sub", true)
	local function set(t: string, s: string?, state: string?)
		main.Text = t
		sub.Text = s or ""
		sub.Visible = s ~= nil and s ~= ""
		main.Size = if sub.Visible then UDim2.new(0.68, 0, 0.48, 0) else UDim2.new(0.68, 0, 0.62, 0)
		main.Position = if sub.Visible then UDim2.fromScale(0.16, 0.12) else UDim2.fromScale(0.16, 0.19)
		b:SetAttribute("State", state or "Normal")
		Buttons.refresh(b)
	end
	set(text, props and props.Sub, props and props.State)
	wireClick(b, onClick)
	return b, set
end

--- Square menu tile: glyph + TITLE + subtitle.
function Buttons.tile(title: string, sub: string?, glyph: string, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local p = base("TextButton", props)
	p.Text = ""
	p.Size = p.Size or UDim2.fromOffset(104, 104)
	local b = new("TextButton", p)
	Buttons.decorate(b, (props and props.Tone) or "Neutral", UDim.new(0, 10))
	local hasSub = sub ~= nil and sub ~= ""
	label(b, glyph, { Name = "Glyph", Size = UDim2.fromScale(0.8, if hasSub then 0.42 else 0.5), Position = UDim2.fromScale(0.1, 0.08), Font = Theme.FontBlack })
	label(b, title, { Name = "Title", Size = UDim2.fromScale(0.9, if hasSub then 0.2 else 0.24), Position = UDim2.fromScale(0.05, if hasSub then 0.52 else 0.64) })
	if hasSub then
		local s = label(b, sub :: string, { Name = "Subtitle", Size = UDim2.fromScale(0.9, 0.15), Position = UDim2.fromScale(0.05, 0.74), Font = Theme.FontBold })
		s:SetAttribute("Sub", true)
	end
	if props and props.State then
		Buttons.setState(b, props.State)
	end
	wireClick(b, onClick)
	return b
end

--- Round mobile action button (caller wires touch input). Label sits under the disc.
function Buttons.round(glyph: string, text: string, size: number, tone: string, props: { [string]: any }?): TextButton
	local p = base("TextButton", props)
	p.Text = ""
	p.Size = UDim2.fromOffset(size, size)
	local b = new("TextButton", p)
	Buttons.decorate(b, tone, UDim.new(0.5, 0))
	local stroke = b:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 3
	end
	label(b, glyph, { Name = "Glyph", Size = UDim2.fromScale(0.62, 0.62), Position = UDim2.fromScale(0.19, 0.19) })
	local cap = label(b, text, { Name = "Caption", Size = UDim2.new(1.4, 0, 0, math.max(12, size * 0.2)), Position = UDim2.new(-0.2, 0, 1, 4), Font = Theme.FontBlack, TextStrokeTransparency = 0.3 })
	cap:SetAttribute("Tinted", nil)
	cap.TextColor3 = Color3.new(1, 1, 1)
	return b
end

--- Small action button, optional price: props.Price = { Kind = "Coins"|"Diamonds"|"Robux", Amount = n }.
--- props.State "Selected" adds ✓; "Locked" shows a padlock (and is disabled).
function Buttons.action(text: string, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local p = base("TextButton", props)
	local price = props and props.Price
	local state = props and props.State
	local shown = string.upper(text)
	if price then
		shown ..= Buttons.priceText(price.Kind, price.Amount)
	end
	if state == "Selected" then
		shown ..= " ✓"
	elseif state == "Locked" then
		shown = "🔒 " .. shown
	end
	p.Text = shown
	p.RichText = true
	p.Font = p.Font or Theme.FontBlack
	p.TextSize = p.TextSize or 15
	p.Size = p.Size or UDim2.fromOffset(140, 40)
	local b = new("TextButton", p)
	Buttons.decorate(b, (props and props.Tone) or "Green", UDim.new(0, 8))
	if state then
		Buttons.setState(b, if state == "Locked" then "Disabled" else state)
	end
	wireClick(b, onClick)
	return b
end

--- Tab button; selected tabs are gold.
function Buttons.tab(text: string, glyph: string?, selected: boolean, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local p = base("TextButton", props)
	p.Size = p.Size or UDim2.fromOffset(110, 36)
	if glyph then
		p.Text = ""
	else
		p.Text = string.upper(text)
		p.Font = Theme.FontBlack
		p.TextSize = p.TextSize or 13
	end
	local b = new("TextButton", p)
	Buttons.decorate(b, "Neutral", UDim.new(0, 6))
	if glyph then
		label(b, glyph, { Name = "Glyph", Size = UDim2.fromScale(0.8, 0.52), Position = UDim2.fromScale(0.1, 0.06) })
		local t = label(b, text, { Name = "Title", Size = UDim2.fromScale(0.92, 0.28), Position = UDim2.fromScale(0.04, 0.64), Font = Theme.FontBold })
		t:SetAttribute("Sub", true)
	end
	Buttons.setState(b, if selected then "Selected" else "Normal")
	wireClick(b, onClick)
	return b
end

--- Icon-only square button (✖ ◀ ▶ +). tone "Red" for close/cancel.
function Buttons.icon(glyph: string, props: { [string]: any }?, onClick: (() -> ())?, tone: string?): TextButton
	local p = base("TextButton", props)
	p.Text = glyph
	p.Font = Theme.FontBlack
	p.TextSize = p.TextSize or 22
	p.Size = p.Size or UDim2.fromOffset(44, 44)
	local b = new("TextButton", p)
	Buttons.decorate(b, tone or "Neutral", UDim.new(0, 8))
	wireClick(b, onClick)
	return b
end

-- Picks a tone from a legacy BackgroundColor3 (so older call sites keep their meaning).
function Buttons.toneFor(color: Color3?): string
	if not color then
		return "Neutral"
	end
	local r, g, bl = color.R * 255, color.G * 255, color.B * 255
	if r > g + 30 and r > bl + 20 and g < 90 then
		return "Red"
	elseif g > r + 20 and g > bl then
		return "Green"
	elseif bl > r + 25 then
		return "Blue"
	elseif r > 150 and g > 90 and bl < 90 then
		return "Gold"
	end
	return "Neutral"
end

return Buttons
]]></string>
