        <Item class="ModuleScript" referent="871">
          <Properties>
            <string name="Name">AssetLoaderService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Loads the uploaded mesh models (Shared/AssetIds) with InsertService and adds
-- any that are missing from the mesh library (ReplicatedStorage.SurvivalHourAssets),
-- in the same shape the Studio setup script produces:
--   * props / structures: Model named after the asset, PrimaryPart = the mesh,
--     WorldPivot = the authored pivot (ground anchor, hinge...), sub-parts placed
--   * held items (Equippable): Tool named without "SM_", Handle = the mesh,
--     Grip at the modelled grip point
-- Each mesh is fitted to its catalog size (Logic/AssetFit), which also fixes
-- uploads that came in with the wrong unit scale or a swapped up axis.
--
-- Runs during Init and holds server start for at most BLOCK_FOR seconds (so the
-- lobby usually gets the meshes); anything slower keeps loading in the background
-- and is used by everything built afterwards (Skins re-indexes on AssetsVersion).
-- Assets already in the library (e.g. the Studio-imported pack) are left alone.
-- InsertService can only load assets owned by the experience's owner, so the
-- place must be published by the same account that uploaded the models.
-- Any failure just leaves that asset on its procedural look.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AssetIds = require(Shared:WaitForChild("AssetIds"))
local AssetFit = require(Shared:WaitForChild("Logic"):WaitForChild("AssetFit"))

local AssetLoaderService = {}

local WORKERS = 6
local TIMEOUT = 120 -- give up on the rest after this long
local BLOCK_FOR = 0 -- never hold up server start: meshes load in the background (the lobby has pack fallbacks)

AssetLoaderService.Loaded = 0
AssetLoaderService.Failed = {} :: { string }

local function libraryIndex(lib: Instance): { [string]: boolean }
	local have = {}
	for _, cat in lib:GetChildren() do
		for _, item in cat:GetChildren() do
			have[item.Name] = true
		end
	end
	return have
end

-- Loads one asset id and returns its largest MeshPart (detached), or nil.
local function loadMesh(id: number): MeshPart?
	local ok, container = pcall(InsertService.LoadAsset, InsertService, id)
	if not ok or not container then
		return nil, tostring(container)
	end
	local best: MeshPart? = nil
	for _, d in container:GetDescendants() do
		if d:IsA("MeshPart") and (not best or d.Size.Magnitude > best.Size.Magnitude) then
			best = d
		end
	end
	if best then
		best.Parent = nil
		for _, c in best:GetChildren() do
			if c:IsA("PackageLink") or c:IsA("Weld") or c:IsA("WeldConstraint") then
				c:Destroy()
			end
		end
	end
	container:Destroy()
	return best, if best then nil else "no MeshPart in asset"
end

-- Sizes and orients a mesh so its centre sits at `at * -offset` (pivot at `at`).
local function fit(mesh: MeshPart, size: { number }, offset: { number }, at: CFrame)
	local f = AssetFit.Fit({ mesh.Size.X, mesh.Size.Y, mesh.Size.Z }, size)
	local c = AssetFit.Axes(f)
	local rot = CFrame.fromMatrix(Vector3.zero, Vector3.new(c[1][1], c[1][2], c[1][3]), Vector3.new(c[2][1], c[2][2], c[2][3]), Vector3.new(c[3][1], c[3][2], c[3][3]))
	mesh.Size = Vector3.new(f.LocalSize[1], f.LocalSize[2], f.LocalSize[3])
	mesh.CFrame = at * CFrame.new(-offset[1], -offset[2], -offset[3]) * rot
	-- The upload carries its own pivot offset (possibly in other units): replace it
	-- so the part's pivot is exactly the authored pivot `at` (ground anchor, grip...).
	mesh.PivotOffset = mesh.CFrame:ToObjectSpace(at)
	mesh.Anchored = true
	mesh.CanCollide = false
	mesh.CanQuery = false
	mesh.CanTouch = false
	if f.Error > 0.25 then
		warn(string.format("[AssetLoader] %s: uploaded proportions differ from the catalog by %d%%", mesh.Name, math.floor(f.Error * 100)))
	end
end

local function build(name: string, e: AssetIds.Entry): (Instance?, string?)
	local mesh, err = loadMesh(e.Id)
	if not mesh then
		return nil, err
	end
	local item: Instance
	if e.Kind == "Equippable" then
		local tool = Instance.new("Tool")
		tool.Name = (string.gsub(name, "^SM_", ""))
		tool.CanBeDropped = false
		tool.RequiresHandle = true
		mesh.Name = "Handle"
		fit(mesh, e.Size, e.Offset, CFrame.new())
		mesh.Parent = tool
		tool.Grip = mesh.CFrame:Inverse()
		item = tool
	else
		local m = Instance.new("Model")
		m.Name = name
		mesh.Name = name
		fit(mesh, e.Size, e.Offset, CFrame.new())
		mesh.Parent = m
		m.PrimaryPart = mesh
		m.WorldPivot = CFrame.new()
		item = m
	end
	for _, p in e.Parts do
		local pm = loadMesh(p.Id)
		if pm then
			pm.Name = p.Name
			fit(pm, p.Size, p.Offset, CFrame.new(table.unpack(p.Place)))
			pm.Parent = item
		end
	end
	return item, nil
end

function AssetLoaderService.Init(_ctx)
	local lib = ReplicatedStorage:FindFirstChild("SurvivalHourAssets")
	if not lib then
		lib = Instance.new("Folder")
		lib.Name = "SurvivalHourAssets"
		lib.Parent = ReplicatedStorage
	end
	local have = libraryIndex(lib)
	local queue = {}
	for name, e in AssetIds do
		local libName = if e.Kind == "Equippable" then (string.gsub(name, "^SM_", "")) else name
		if not have[libName] then
			table.insert(queue, name)
		end
	end
	if #queue == 0 then
		return
	end
	table.sort(queue)
	local started = os.clock()
	local nextIndex, running = 1, 0
	for _ = 1, WORKERS do
		running += 1
		task.spawn(function()
			while nextIndex <= #queue and os.clock() - started < TIMEOUT do
				local name = queue[nextIndex]
				nextIndex += 1
				local e = AssetIds[name]
				local ok, item, err = pcall(build, name, e)
				if ok and item then
					local cat = lib:FindFirstChild(e.Category)
					if not cat then
						cat = Instance.new("Folder")
						cat.Name = e.Category
						cat.Parent = lib
					end
					item.Parent = cat
					AssetLoaderService.Loaded += 1
					ReplicatedStorage:SetAttribute("AssetsVersion", (ReplicatedStorage:GetAttribute("AssetsVersion") or 0) + 1)
				else
					table.insert(AssetLoaderService.Failed, name .. ": " .. tostring(if ok then err else item))
				end
			end
			running -= 1
		end)
	end
	while running > 0 and os.clock() - started < BLOCK_FOR do
		task.wait(0.1)
	end
	if running > 0 then
		task.spawn(function()
			while running > 0 and os.clock() - started < TIMEOUT + 5 do
				task.wait(0.5)
			end
			AssetLoaderService._report(#queue, started)
		end)
	else
		AssetLoaderService._report(#queue, started)
	end
end

function AssetLoaderService._report(total: number, started: number)
	print(string.format("[AssetLoader] loaded %d/%d uploaded meshes in %.1fs", AssetLoaderService.Loaded, total, os.clock() - started))
	if #AssetLoaderService.Failed > 0 then
		warn("[AssetLoader] not loaded (they keep their procedural look): " .. table.concat(AssetLoaderService.Failed, "; ", 1, math.min(8, #AssetLoaderService.Failed)))
	end
end

return AssetLoaderService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="872">
          <Properties>
            <string name="Name">BuildService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Free-placement base building with server validation, structure health,
-- damage states, repair, doors, spikes and traps (tripwire, snare, bear trap,
-- advanced alarm). Storage and trap counts are capped by Workbench tier.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Recipes = require(Shared:WaitForChild("Recipes"))
local Logic = Shared:WaitForChild("Logic")
local PlacementRules = require(Logic:WaitForChild("PlacementRules"))
local StorageLedger = require(Logic:WaitForChild("StorageLedger"))
local Models = Shared:WaitForChild("Models")
local Structures = require(Models:WaitForChild("Structures"))

local BuildService = {}

export type Structure = {
	Id: string,
	Team: number,
	Model: Model,
	Health: number,
	Max: number,
	Rect: PlacementRules.Rect,
	EnemyDamage: number, -- repairable HP that came from enemies (Craftsman challenge)
	Builder: number,
	Key: string,
}

local ctx: any
local structures: { [Model]: Structure } = {}
local folder: Folder? = nil
local spikeTouch: { [string]: number } = {}
local alarmCooldown: { [string]: number } = {}
local counter = 0
local STREAM_CLEARANCE = 9 -- studs from a stream's centre line (don't dam rivers)

function BuildService.Init(c)
	ctx = c
	ctx.Util.Connect("PlaceStructure", "Build", BuildService._onPlace)
	ctx.ChannelService.OnPrompt("Gate", BuildService._onGate)
	ctx.MatchService.On("MatchStarting", function(map)
		folder = Instance.new("Folder")
		folder.Name = "Structures"
		folder.Parent = map.Folder
	end)
	ctx.MatchService.On("MatchCleanup", function()
		structures = {}
		folder = nil
		spikeTouch = {}
		alarmCooldown = {}
	end)
end

function BuildService.FromPart(part: Instance): Structure?
	local m = part:FindFirstAncestorOfClass("Model")
	while m do
		local s = structures[m]
		if s then
			return s
		end
		-- (not m.Parent:FindFirstAncestorOfClass: that skips m.Parent itself,
		-- so parts of nested models like a gate's Door never resolved)
		m = m:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function BuildService.TeamStructures(team: number): { Structure }
	local out = {}
	for _, s in structures do
		if s.Team == team then
			table.insert(out, s)
		end
	end
	return out
end

-- Cap for a limit key: Workbench-tier caps (spec: storage 1-5, traps 2-6) else a flat limit.
function BuildService.LimitMax(team: number, limit: string): number
	local tiers = Config.Build.TierLimits[limit]
	if tiers then
		return tiers[math.clamp(ctx.CampService.GetLevel(team), 1, #tiers)]
	end
	return Config.Build.Limits[limit] or 10
end

local function limitUsed(team: number, limit: string): number
	local n = 0
	for _, s in structures do
		if s.Team == team and Items[s.Id].Limit == limit then
			n += 1
		end
	end
	return n
end

-- Placement ---------------------------------------------------------------------------------

function BuildService.Validate(p: Player, id: string, pos: Vector3, yaw: number): (boolean, string?, Vector3?)
	local def = Items[id]
	local recipe = Recipes.ByResult[id]
	if not def or def.Kind ~= "Structure" or not recipe then
		return false, "Unknown structure"
	end
	local team = ctx.Util.Team(p)
	local camp = ctx.CampService.GetCamp(team)
	if not camp then
		return false, "No camp"
	end
	if ctx.CampService.GetLevel(team) < recipe.Level then
		return false, "Requires Workbench Tier " .. ({ "I", "II", "III", "IV", "V" })[recipe.Level]
	end
	local root = ctx.Util.Root(p)
	if not root then
		return false, "Not spawned"
	end
	if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude > Config.Build.MaxPlaceDistance then
		return false, "Too far away"
	end
	local size = def.Size :: Vector3
	local rect: PlacementRules.Rect = { X = pos.X, Z = pos.Z, HX = size.X / 2, HZ = size.Z / 2, Yaw = -yaw }
	local existing = {}
	for _, r in camp.StaticRects do
		table.insert(existing, r)
	end
	for _, s in structures do
		table.insert(existing, s.Rect)
	end
	local limitName = def.Limit or "Wall"
	local ok, why = PlacementRules.Check(rect, {
		Fire = { X = camp.FirePos.X, Z = camp.FirePos.Z },
		ZoneRadius = Config.Build.ZoneRadius,
		Clearances = camp.Clearances,
		Existing = existing,
		LimitUsed = limitUsed(team, limitName),
		LimitMax = BuildService.LimitMax(team, limitName),
	})
	if not ok then
		if why and string.find(why, "limit") and Config.Build.TierLimits[limitName] then
			why = string.format("%s cap reached (%d at this Workbench tier)", limitName, BuildService.LimitMax(team, limitName))
		end
		return false, why
	end
	-- Rivers and streams stay open: no building across the water.
	local map = ctx.MatchService.Map
	if map and map.Layout and map.Layout.Streams then
		local O = map.Origin
		local px, pz = pos.X - O.X, pos.Z - O.Z
		local reach = STREAM_CLEARANCE + math.max(size.X, size.Z) / 2
		for _, st in map.Layout.Streams do
			local pts = st.Points
			for i = 1, #pts - 1 do
				local a, b = pts[i], pts[i + 1]
				local abx, abz = b.X - a.X, b.Z - a.Z
				local len2 = abx * abx + abz * abz
				local tt = if len2 > 0 then math.clamp(((px - a.X) * abx + (pz - a.Z) * abz) / len2, 0, 1) else 0
				local dx, dz = px - (a.X + abx * tt), pz - (a.Z + abz * tt)
				if dx * dx + dz * dz < reach * reach then
					return false, "Too close to the stream (keep waterways open)"
				end
			end
		end
	end
	for _, nb in (map and map.NoBuild) or {} do
		if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(nb.X, 0, nb.Z)).Magnitude < nb.R then
			return false, "You can't build here (" .. (nb.Label or "blocked") .. ")"
		end
	end
	-- Terrain: sample the footprint corners; reject steep or water spots.
	local heights = {}
	for _, c in PlacementRules.Corners(rect) do
		table.insert(heights, ctx.WorldService.GroundY(c[1], c[2]))
	end
	table.insert(heights, ctx.WorldService.GroundY(pos.X, pos.Z))
	local lo, hi = math.huge, -math.huge
	for _, h in heights do
		lo = math.min(lo, h)
		hi = math.max(hi, h)
	end
	if hi - lo > 3 then
		return false, "Ground is too uneven"
	end
	local groundY = lo
	-- Characters / animals inside the footprint
	local cf = CFrame.new(pos.X, groundY + size.Y / 2, pos.Z) * CFrame.Angles(0, math.rad(yaw), 0)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { workspace.Terrain }
	for _, part in workspace:GetPartBoundsInBox(cf, size + Vector3.new(1, 0, 1), params) do
		if ctx.Util.PlayerFromPart(part) then
			return false, "Someone is standing there"
		end
		if ctx.WildlifeService.FromPart(part) then
			return false, "An animal is in the way"
		end
	end
	return true, nil, Vector3.new(pos.X, groundY, pos.Z)
end

function BuildService._onPlace(p: Player, req: any)
	if type(req) ~= "table" or type(req.Id) ~= "string" or not ctx.Util.IsVec3(req.Pos) or not ctx.Util.IsFinite(req.Yaw) then
		return
	end
	if not p:GetAttribute("InMatch") or not ctx.Util.IsAlive(p) or not ctx.MatchService.IsPlaying() then
		return
	end
	local yaw = math.floor(req.Yaw / Config.Build.RotateStep + 0.5) * Config.Build.RotateStep % 360
	local ok, why, ground = BuildService.Validate(p, req.Id, req.Pos, yaw)
	if not ok or not ground then
		ctx.Util.Notify(p, why or "Can't build there.", "error")
		Net.FireClient("MatchEvent", p, "BuildResult", { Ok = false, Reason = why })
		return
	end
	local team = ctx.Util.Team(p)
	local recipe = Recipes.ByResult[req.Id]
	local inv = ctx.InventoryService.Get(p)
	if not inv or not StorageLedger.PayCombined(recipe.Cost, inv, ctx.StorageService.TeamStores(team)) then
		ctx.Util.Notify(p, "Not enough materials (your pack + team storage).", "error")
		Net.FireClient("MatchEvent", p, "BuildResult", { Ok = false, Reason = "Materials" })
		return
	end
	ctx.InventoryService.Sync(p)
	ctx.StorageService.SyncTeam(team)
	BuildService.Spawn(req.Id, team, ground, yaw, p)
	ctx.Util.SetAction(p, "Build")
	Net.FireAll("Fx", "Built", { Pos = ground })
	Net.FireClient("MatchEvent", p, "BuildResult", { Ok = true, Id = req.Id })
end

function BuildService.Spawn(id: string, team: number, ground: Vector3, yaw: number, builder: Player?): Structure
	local def = Items[id]
	local cf = CFrame.new(ground) * CFrame.Angles(0, math.rad(yaw), 0)
	local model = Structures.Build(id, cf, Config.Teams[team].Color, folder)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	counter += 1
	local size = def.Size :: Vector3
	local s: Structure = {
		Id = id,
		Team = team,
		Model = model,
		Health = def.Health :: number,
		Max = def.Health :: number,
		Rect = { X = ground.X, Z = ground.Z, HX = size.X / 2, HZ = size.Z / 2, Yaw = -yaw },
		EnemyDamage = 0,
		Builder = if builder then builder.UserId else 0,
		Key = "S" .. counter,
	}
	structures[model] = s
	model:SetAttribute("Team", team)
	model:SetAttribute("Structure", id)
	model:SetAttribute("Health", s.Health)
	model:SetAttribute("MaxHealth", s.Max)
	ctx.Util.PlaySound("Build", model.PrimaryPart)
	if def.Door then
		local door = model:FindFirstChild("Door") :: Model
		ctx.ChannelService.MakePrompt(door.PrimaryPart :: BasePart, "Gate", "Open / Close", def.Name, 10, "Team", team)
	elseif id == "Spikes" then
		local hurt = model:FindFirstChild("Hurt") :: BasePart
		hurt.Touched:Connect(function(part)
			BuildService._spikeTouch(s, part)
		end)
	elseif def.Limit == "Storage" then
		ctx.StorageService.Register(s)
		if builder then
			ctx.CosmeticService.OnStructurePlaced(builder, model, "Storage")
		end
	elseif id == "TripwireAlarm" or id == "Snare" or id == "BearTrap" then
		local trig = model:FindFirstChild("Trigger") :: BasePart
		trig.Touched:Connect(function(part)
			BuildService._trapTouch(s, part)
		end)
	end
	return s
end

-- Damage / repair -----------------------------------------------------------------------------

function BuildService.Damage(s: Structure, amount: number, attacker: Player?): boolean
	if not structures[s.Model] or amount <= 0 then
		return false
	end
	if attacker and ctx.Util.Team(attacker) == s.Team then
		return false -- friendly fire off for structures
	end
	if attacker and ctx.LivesService.IsProtected(attacker) then
		return false -- protected players can't raid
	end
	local dealt = math.min(s.Health, amount)
	s.Health -= dealt
	s.EnemyDamage += dealt
	s.Model:SetAttribute("Health", math.ceil(s.Health))
	Structures.ApplyDamageState(s.Model, s.Health / s.Max)
	ctx.Util.PlaySound("HitStructure", s.Model.PrimaryPart)
	if attacker then
		Net.FireClient("HitFeedback", attacker, "Structure", math.floor(dealt + 0.5), s.Model:GetPivot().Position)
	end
	if s.Health <= 0 then
		BuildService.Destroy(s, attacker)
	end
	return true
end

function BuildService.Destroy(s: Structure, by: Player?)
	if not structures[s.Model] then
		return
	end
	structures[s.Model] = nil
	local pos = s.Model:GetPivot().Position
	if Items[s.Id].Limit == "Storage" then
		ctx.StorageService.OnDestroyed(s, pos)
	end
	Net.FireAll("Fx", "StructureBreak", { Pos = pos, Id = s.Id })
	ctx.Util.PlaySound("Break", s.Model.PrimaryPart)
	s.Model:Destroy()
	ctx.Util.NotifyTeam(s.Team, "Your " .. Items[s.Id].Name .. " was destroyed" .. (if by then " by " .. by.DisplayName else "") .. "!", "danger")
end

function BuildService.Repair(p: Player, s: Structure)
	if ctx.Util.Team(p) ~= s.Team then
		return
	end
	if s.Health >= s.Max then
		ctx.Util.Notify(p, "Already at full health.", "info")
		return
	end
	local def = Items[s.Id]
	local cost = Recipes.Repair.Cost[def.Material or "Wood"]
	local free = ctx.PowerupService.ConsumeFreeRepair(p)
	if not free then
		local inv = ctx.InventoryService.Get(p)
		if not inv or not StorageLedger.PayCombined(cost, inv, ctx.StorageService.TeamStores(s.Team)) then
			local need = next(cost)
			ctx.Util.Notify(p, "Repairing needs 1 " .. tostring(need) .. " per swing.", "warn")
			return
		end
		ctx.InventoryService.Sync(p)
		ctx.StorageService.SyncTeam(s.Team)
	end
	ctx.Util.SetAction(p, "Build")
	local amount = math.min(s.Max - s.Health, s.Max * Recipes.Repair.RepairFraction * ctx.PowerupService.RepairMult(p))
	s.Health += amount
	local fromEnemy = math.min(amount, s.EnemyDamage)
	s.EnemyDamage -= fromEnemy
	s.Model:SetAttribute("Health", math.ceil(s.Health))
	Structures.ApplyDamageState(s.Model, s.Health / s.Max)
	ctx.Util.PlaySound("Repair", s.Model.PrimaryPart)
	Net.FireClient("HitFeedback", p, "Repair", math.floor(amount + 0.5), s.Model:GetPivot().Position)
	if fromEnemy > 0 then
		ctx.PowerupService.OnRepair(p, fromEnemy)
	end
end

-- Gates -------------------------------------------------------------------------------------------

function BuildService._onGate(p: Player, prompt: ProximityPrompt)
	local s = BuildService.FromPart(prompt)
	if not s or not Items[s.Id].Door or ctx.Util.Team(p) ~= s.Team or not ctx.Util.IsAlive(p) then
		return
	end
	local open = not s.Model:GetAttribute("Open")
	if not open then
		-- Don't close on top of someone.
		local root = s.Model.PrimaryPart :: BasePart
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { s.Model }
		for _, part in workspace:GetPartBoundsInBox(root.CFrame, root.Size, params) do
			if ctx.Util.PlayerFromPart(part) then
				ctx.Util.Notify(p, "Someone is in the gateway.", "warn")
				return
			end
		end
	end
	Structures.SetGateOpen(s.Model, open)
	ctx.Util.PlaySound("Build", s.Model.PrimaryPart)
end

-- Spikes -------------------------------------------------------------------------------------------

function BuildService._spikeTouch(s: Structure, part: BasePart)
	if not structures[s.Model] then
		return
	end
	local victim = ctx.Util.PlayerFromPart(part)
	if victim then
		if ctx.Util.Team(victim) == s.Team then
			return
		end
		local key = s.Key .. ":" .. victim.UserId
		local t = os.clock()
		if t - (spikeTouch[key] or 0) < 1 then
			return
		end
		spikeTouch[key] = t
		local owner = Players:GetPlayerByUserId(s.Builder)
		ctx.CombatService.DamagePlayer(victim, Items.Spikes.Damage :: number, { Kind = "Spike", By = if owner and ctx.Util.Team(owner) == s.Team then owner else nil, Name = "Spikes", Pos = s.Model:GetPivot().Position })
		-- Spikes wear a little each time they bite.
		BuildService.Damage(s, 4, nil)
		return
	end
	local animal = ctx.WildlifeService.FromPart(part)
	if animal then
		local key = s.Key .. ":A" .. tostring(animal.Id)
		local t = os.clock()
		if t - (spikeTouch[key] or 0) < 1 then
			return
		end
		spikeTouch[key] = t
		ctx.WildlifeService.Damage(animal, Items.Spikes.Damage :: number, nil)
	end
end

-- Traps -------------------------------------------------------------------------------------------

-- Compass side (from `from` toward `to`) for warnings without positions.
local function bearing(from: Vector3, to: Vector3): string
	local d = (to - from) * Vector3.new(1, 0, 1)
	if d.Magnitude < 0.1 then
		return "near"
	end
	local deg = math.deg(math.atan2(d.X, -d.Z)) % 360
	local dirs = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
	return dirs[math.floor(((deg + 22.5) % 360) / 45) + 1]
end

local function warnOwner(s: Structure, text: string)
	for _, p in ctx.Util.TeamPlayers(s.Team) do
		Net.FireClient("MatchEvent", p, "TrapAlert", { Text = text, Trap = s.Id })
	end
end

function BuildService._trapTouch(s: Structure, part: BasePart)
	if not structures[s.Model] then
		return
	end
	local victim = ctx.Util.PlayerFromPart(part)
	if not victim or ctx.Util.Team(victim) == s.Team or not ctx.Util.IsAlive(victim) then
		return
	end
	local def = Items[s.Id]
	local fire = ctx.CampService.GetCamp(s.Team)
	local side = if fire then bearing(fire.FirePos, s.Model:GetPivot().Position) else "?"
	if s.Id == "TripwireAlarm" then
		local t = os.clock()
		if t - (alarmCooldown[s.Key] or 0) < 8 then
			return
		end
		alarmCooldown[s.Key] = t
		ctx.Util.PlaySound("Alarm", s.Model.PrimaryPart)
		warnOwner(s, "⚠ Tripwire rattled on the " .. side .. " side of your camp!")
		return
	end
	-- Snare / bear trap: bite once, hold, then the trap is spent.
	local owner = Players:GetPlayerByUserId(s.Builder)
	if def.Damage then
		ctx.CombatService.DamagePlayer(victim, def.Damage, { Kind = "Trap", By = if owner and ctx.Util.Team(owner) == s.Team then owner else nil, Name = def.Name, Pos = s.Model:GetPivot().Position })
	end
	if def.Hold then
		BuildService.HoldPlayer(victim, def.Hold)
	end
	ctx.Util.PlaySound(if s.Id == "BearTrap" then "TrapSnap" else "Gather", s.Model.PrimaryPart)
	ctx.Util.Notify(victim, "Caught in a " .. def.Name .. "!", "danger")
	warnOwner(s, "⚠ Your " .. def.Name .. " caught someone on the " .. side .. " side!")
	BuildService.Destroy(s, nil)
end

-- Holds a player in place (traps). PowerupService's movement loop reads HeldUntil.
function BuildService.HoldPlayer(p: Player, seconds: number)
	local untilT = workspace:GetServerTimeNow() + seconds
	local prev = p:GetAttribute("HeldUntil")
	p:SetAttribute("HeldUntil", math.max(untilT, if type(prev) == "number" then prev else 0))
	ctx.ChannelService.CancelFor(p, "Caught in a trap")
end

function BuildService.IsHeld(p: Player): boolean
	local t = p:GetAttribute("HeldUntil")
	return type(t) == "number" and workspace:GetServerTimeNow() < t
end

-- Advanced alarms watch a radius (checked a few times a second).
function BuildService.Start()
	while true do
		task.wait(0.5)
		if ctx.MatchService.Active then
			local t = os.clock()
			for _, s in structures do
				local detect = Items[s.Id].Detect
				if detect and t - (alarmCooldown[s.Key] or 0) >= 6 then
					local pos = s.Model:GetPivot().Position
					for _, p in ctx.Util.MatchPlayers() do
						if ctx.Util.Team(p) ~= s.Team and ctx.Util.IsAlive(p) and ctx.Util.DistTo(p, pos) <= detect then
							alarmCooldown[s.Key] = t
							local fire = ctx.CampService.GetCamp(s.Team)
							local side = if fire then bearing(fire.FirePos, pos) else "?"
							ctx.Util.PlaySound("Alarm", s.Model.PrimaryPart)
							warnOwner(s, "🚨 Advanced alarm: " .. p.DisplayName .. " is at the " .. side .. " side of your camp!")
							break
						end
					end
				end
			end
		end
	end
end

return BuildService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="873">
          <Properties>
            <string name="Name">CampService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Camps: campfires (fuel, levels, snuffing), workbench level + prompt, enemy camp
-- discovery, healing near your own fire, and fire-light queries for wildlife.
--
-- Fire rules live in Shared/Logic/FireRules (unit-tested). Replicated state:
--   MatchState.FireLevel<team>; owner player attributes FireFuel (0..1), FireLevel,
--   FireNeeds ("Wood 12 · Stone 4" toward the next level, "" when maxed).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Models = Shared:WaitForChild("Models")
local Camp = require(Models:WaitForChild("Camp"))
local Logic = Shared:WaitForChild("Logic")
local FireRules = require(Logic:WaitForChild("FireRules"))
local InventoryModel = require(Logic:WaitForChild("InventoryModel"))
local Items = require(Shared:WaitForChild("Items"))

local CampService = {}

local ctx: any
local camps: { [number]: any } = {}
local levels: { [number]: number } = {}
local revealed: { [number]: { [number]: boolean } } = {} -- team -> discovered camp teams
local lastAlert: { [number]: number } = {}
local lastHurt: { [Player]: number } = {}
local fires: { [number]: FireRules.Fire } = {}
local warned: { [number]: boolean } = {}
local FIRE = Config.Fire :: any

function CampService.Init(c)
	ctx = c
	ctx.MatchService.On("MatchStarting", CampService._setup)
	ctx.MatchService.On("FireOut", function(team: number)
		local camp = camps[team]
		if camp then
			Camp.Extinguish(camp.Fire)
			local prompt = camp.Fire:FindFirstChild("PourPrompt", true) :: ProximityPrompt?
			if prompt then
				prompt.Enabled = false
			end
			for _, name in { "FeedPrompt", "FireUpgradePrompt" } do
				local pr = camp.Fire:FindFirstChild(name, true) :: ProximityPrompt?
				if pr then
					pr.Enabled = false
				end
			end
			ctx.Util.PlaySound("FireOut", camp.Fire.PrimaryPart)
		end
		local fire = fires[team]
		if fire then
			fire.Out = true
			fire.Fuel = 0
			CampService._syncFire(team)
		end
	end)
	ctx.MatchService.On("MatchCleanup", function()
		camps = {}
		levels = {}
		revealed = {}
		fires = {}
		warned = {}
	end)
	ctx.ChannelService.OnPrompt("Feed", CampService._onFeed)
	ctx.ChannelService.OnPrompt("FireUpgrade", CampService._onFireUpgrade)
	ctx.MatchService.On("PlayerJoinedMatch", function(p: Player)
		task.delay(1, CampService.SendMapData, p)
	end)
	ctx.ChannelService.OnPrompt("Pour", CampService._onPour)
	ctx.ChannelService.OnPrompt("Workbench", function(player: Player, prompt: ProximityPrompt)
		local team = prompt:GetAttribute("Team")
		if team ~= ctx.Util.Team(player) or not ctx.Util.IsAlive(player) then
			return
		end
		ctx.CraftService.OpenFor(player)
	end)
end

function CampService.Start()
	-- Discovery, healing and fuel loops
	local tick = 0
	local last = os.clock()
	while true do
		task.wait(0.5)
		tick += 1
		local t = os.clock()
		local dt = t - last
		last = t
		if ctx.MatchService.Active and next(camps) then
			CampService._discover()
			if tick % 2 == 0 then
				CampService._heal()
			end
			local phase = ctx.MatchService.Phase
			if phase == "Day" or phase == "Night" then
				CampService._burn(dt)
			end
		end
	end
end

-- Fuel -------------------------------------------------------------------------------------

local critical: { [number]: boolean } = {}

function CampService._burn(dt: number)
	for team, fire in fires do
		if not fire.Out and ctx.MatchService.FireBurning(team) then
			if FireRules.Burn(fire, dt, FIRE) then
				critical[team] = nil
				ctx.Util.NotifyTeam(team, "Your fire ran out of fuel and died. You're on your FINAL LIFE.", "danger")
				ctx.MatchService.ExtinguishFire(team, nil)
			else
				if fire.Fuel < FIRE.FuelWarning and not warned[team] then
					warned[team] = true
					ctx.Util.NotifyTeam(team, "Your fire is low on fuel! Add Wood before it dies for good.", "warn")
				elseif fire.Fuel >= FIRE.FuelWarning + 0.05 then
					warned[team] = false
					critical[team] = nil
				end
				if fire.Fuel < 0.05 and not critical[team] then
					critical[team] = true
					for _, mate in ctx.Util.TeamPlayers(team) do
						Net.FireClient("MatchEvent", mate, "FireCritical", {})
					end
				end
				CampService._syncFire(team)
			end
		end
	end
end

local function needsText(fire: FireRules.Fire): string
	local parts = {}
	for id, n in FireRules.Remaining(fire, FIRE) do
		local def = Items[id]
		table.insert(parts, string.format("%s %d", if def then def.Name else id, n))
	end
	table.sort(parts)
	return table.concat(parts, " · ")
end

function CampService._syncFire(team: number)
	local fire = fires[team]
	local camp = camps[team]
	if not fire or not camp then
		return
	end
	local fuel = math.floor(fire.Fuel * 200 + 0.5) / 200
	ctx.MatchService.State:SetAttribute("FireLevel" .. team, fire.Level)
	for _, p in ctx.Util.TeamPlayers(team) do
		p:SetAttribute("FireFuel", fuel)
		p:SetAttribute("FireLevel", fire.Level)
		p:SetAttribute("FireNeeds", needsText(fire))
	end
	if not fire.Out then
		Camp.SetFire(camp.Fire, fire.Level, fire.Fuel)
		local feed = camp.Fire:FindFirstChild("FeedPrompt", true) :: ProximityPrompt?
		if feed then
			feed.ObjectText = string.format("Campfire L%d · fuel %d%% (%s)", fire.Level, math.floor(fire.Fuel * 100 + 0.5), string.format("%d:%02d left", FireRules.SecondsLeft(fire, FIRE) // 60, math.floor(FireRules.SecondsLeft(fire, FIRE)) % 60))
		end
		local up = camp.Fire:FindFirstChild("FireUpgradePrompt", true) :: ProximityPrompt?
		if up then
			up.Enabled = FireRules.CanUpgrade(fire, FIRE)
			up.ActionText = "Upgrade Fire → L" .. (fire.Level + 1)
			up.ObjectText = "Needs " .. needsText(fire)
		end
	end
end

function CampService.GetFire(team: number): FireRules.Fire?
	return fires[team]
end

local function ownFire(player: Player, prompt: ProximityPrompt): (number?, FireRules.Fire?, any)
	local team = prompt:GetAttribute("Team") :: number
	if team ~= ctx.Util.Team(player) or not ctx.Util.IsAlive(player) or not ctx.MatchService.Active then
		return nil, nil, nil
	end
	local fire = fires[team]
	if not fire or fire.Out or not ctx.MatchService.FireBurning(team) then
		return nil, nil, nil
	end
	if ctx.Util.DistTo(player, camps[team].FirePos) > Config.Fire.PourRange + 1 then
		return nil, nil, nil
	end
	return team, fire, ctx.InventoryService.Get(player)
end

-- Adds as much Wood from the pack as the fire can take.
function CampService._onFeed(player: Player, prompt: ProximityPrompt)
	local team, fire, inv = ownFire(player, prompt)
	if not team or not fire or not inv then
		return
	end
	local have = inv.Resources.Wood or 0
	if have <= 0 then
		ctx.Util.Notify(player, "You have no Wood. Chop trees to fuel your fire.", "error")
		return
	end
	local fuelMult = ctx.PowerupService.FireFuelMult(player)
	local n = FireRules.WoodAccepted(fire, have, FIRE, fuelMult)
	if n <= 0 then
		ctx.Util.Notify(player, "Your fire is already full.", "info")
		return
	end
	if InventoryModel.TakeResource(inv, "Wood", n) ~= n then
		return
	end
	FireRules.AddWood(fire, n, FIRE, fuelMult)
	ctx.Util.SetAction(player, "Feed")
	ctx.Util.PlaySound("Pickup", camps[team].Fire.PrimaryPart)
	Net.FireAll("Fx", "FireFed", { Pos = camps[team].FirePos, Amount = n })
	ctx.InventoryService.Sync(player)
	CampService._syncFire(team)
	ctx.Util.Notify(player, string.format("Added %d Wood · fuel %d%%", n, math.floor(fire.Fuel * 100 + 0.5)), "success")
end

-- Contributes pack materials toward the next fire level.
function CampService._onFireUpgrade(player: Player, prompt: ProximityPrompt)
	local team, fire, inv = ownFire(player, prompt)
	if not team or not fire or not inv or not FireRules.CanUpgrade(fire, FIRE) then
		return
	end
	local have = {}
	for id in FireRules.Remaining(fire, FIRE) do
		have[id] = inv.Resources[id] or 0
	end
	local before = fire.Level
	local taken, levelled = FireRules.Contribute(fire, have, FIRE)
	if next(taken) == nil then
		ctx.Util.Notify(player, "You don't carry anything this upgrade needs (" .. needsText(fire) .. ").", "error")
		return
	end
	for id, n in taken do
		InventoryModel.TakeResource(inv, id, n)
	end
	ctx.InventoryService.Sync(player)
	CampService._syncFire(team)
	if levelled then
		ctx.Util.NotifyTeam(team, string.format("Campfire upgraded to Level %d! It burns longer and takes %d s to snuff.", fire.Level, FireRules.SnuffTime(fire, FIRE)), "success")
		ctx.Util.PlaySound("Craft", camps[team].Fire.PrimaryPart)
		ctx.Util.SetAction(player, "Feed")
		Net.FireAll("Fx", "FireUpgraded", { Pos = camps[team].FirePos, Level = fire.Level })
		for _, mate in ctx.Util.TeamPlayers(team) do
			Net.FireClient("MatchEvent", mate, "Upgraded", { What = "Campfire", Level = fire.Level })
		end
		print(string.format("[Camp] %s fire L%d -> L%d", Config.Teams[team].Name, before, fire.Level))
	else
		ctx.Util.Notify(player, "Added to the fire upgrade. Still needs " .. needsText(fire) .. ".", "info")
	end
end

function CampService._setup(map: any)
	camps = map.Camps
	for team, camp in camps do
		levels[team] = 1
		revealed[team] = { [team] = true }
		fires[team] = FireRules.New(FIRE)
		warned[team] = false
		local core = camp.Fire:FindFirstChild("FireCore") :: BasePart
		local pour = ctx.ChannelService.MakePrompt(core, "Pour", "Hold: Snuff Fire", Config.Teams[team].Name .. " Campfire", Config.Fire.PourRange, "Enemy", team)
		pour.KeyboardKeyCode = Enum.KeyCode.E
		pour:SetAttribute("Snuff", true)
		local feed = ctx.ChannelService.MakePrompt(core, "Feed", "Add Wood", "Campfire", Config.Fire.PourRange, "Team", team)
		feed.KeyboardKeyCode = Enum.KeyCode.E
		local up = ctx.ChannelService.MakePrompt(core, "FireUpgrade", "Upgrade Fire", "Campfire", Config.Fire.PourRange, "Team", team)
		up.KeyboardKeyCode = Enum.KeyCode.F
		up.UIOffset = Vector2.new(0, 72)
		local top = camp.Workbench.PrimaryPart :: BasePart
		ctx.ChannelService.MakePrompt(top, "Workbench", "Craft", "Workbench", 10, "Team", team)
		local sound = ctx.Util.MakeSound("FireCrackle", core)
		if sound then
			sound:Play()
		end
	end
end

function CampService.GetCamp(team: number): any
	return camps[team]
end

function CampService.GetLevel(team: number): number
	return levels[team] or 1
end

function CampService.SetLevel(team: number, level: number)
	local camp = camps[team]
	if not camp then
		return
	end
	levels[team] = level
	local old = camp.Workbench
	local nb = Camp.Workbench(camp.WorkbenchCF, level, Config.Teams[team].Color, camp.Folder)
	nb.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	nb:SetAttribute("Team", team)
	ctx.ChannelService.MakePrompt(nb.PrimaryPart, "Workbench", "Craft", "Workbench", 10, "Team", team)
	camp.Workbench = nb
	old:Destroy()
	ctx.CosmeticService.OnWorkbenchRebuilt(team)
	ctx.MatchService.State:SetAttribute("Bench" .. team, level)
end

-- True if pos is inside the light of any burning campfire (wildlife avoids it).
function CampService.InFireLight(pos: Vector3, extra: number?): boolean
	for team, camp in camps do
		if ctx.MatchService.FireBurning(team) then
			local d = Vector3.new(pos.X - camp.FirePos.X, 0, pos.Z - camp.FirePos.Z).Magnitude
			if d < Config.Fire.LightRadius + (extra or 0) then
				return true
			end
		end
	end
	return false
end

-- Returns the nearest burning fire position within range, or nil.
function CampService.NearestLitFire(pos: Vector3, range: number): Vector3?
	local best, bestD = nil, range
	for team, camp in camps do
		if ctx.MatchService.FireBurning(team) then
			local d = (camp.FirePos - pos).Magnitude
			if d < bestD then
				best, bestD = camp.FirePos, d
			end
		end
	end
	return best
end

function CampService.InBuildZone(team: number, pos: Vector3): boolean
	local camp = camps[team]
	if not camp then
		return false
	end
	return Vector3.new(pos.X - camp.FirePos.X, 0, pos.Z - camp.FirePos.Z).Magnitude <= Config.Build.ZoneRadius
end

-- Discovery -------------------------------------------------------------------------------

function CampService._discover()
	for _, p in ctx.Util.MatchPlayers() do
		if ctx.Util.IsAlive(p) then
			local root = ctx.Util.Root(p)
			local team = ctx.Util.Team(p)
			if root and revealed[team] then
				for campTeam, camp in camps do
					if not revealed[team][campTeam] and (root.Position - camp.FirePos).Magnitude <= Config.Fire.RevealRadius then
						revealed[team][campTeam] = true
						local info = CampService._campMapInfo(campTeam)
						for _, mate in ctx.Util.TeamPlayers(team) do
							Net.FireClient("MatchEvent", mate, "CampRevealed", { Team = campTeam, By = p.DisplayName, Camp = info })
						end
					end
				end
			end
		end
	end
end

function CampService.IsRevealed(viewerTeam: number, campTeam: number): boolean
	return revealed[viewerTeam] ~= nil and revealed[viewerTeam][campTeam] == true
end

-- Healing ----------------------------------------------------------------------------------

function CampService.NoteHurt(p: Player)
	lastHurt[p] = os.clock()
end

function CampService._heal()
	local t = os.clock()
	for _, p in ctx.Util.MatchPlayers() do
		local team = ctx.Util.Team(p)
		local camp = camps[team]
		local hum = ctx.Util.Humanoid(p)
		local root = ctx.Util.Root(p)
		if camp and hum and root and hum.Health > 0 and hum.Health < hum.MaxHealth and ctx.MatchService.FireBurning(team) then
			if t - (lastHurt[p] or 0) >= Config.Player.FireHealDelayAfterDamage
				and (root.Position - camp.FirePos).Magnitude <= Config.Player.FireHealRadius then
				hum.Health = math.min(hum.MaxHealth, hum.Health + Config.Player.FireHealPerSecond)
				p:SetAttribute("Warming", t)
			end
		end
	end
end

-- Pouring ----------------------------------------------------------------------------------

function CampService._onPour(player: Player, prompt: ProximityPrompt)
	local fireTeam = prompt:GetAttribute("Team") :: number
	local camp = camps[fireTeam]
	if not camp or not ctx.Util.IsAlive(player) or not ctx.MatchService.Active then
		return
	end
	local myTeam = ctx.Util.Team(player)
	local function fail(msg: string)
		ctx.Util.Notify(player, msg, "error")
	end
	if myTeam == fireTeam then
		return fail("You can't put out your own fire.")
	end
	if not FireRules.SnuffAllowed(ctx.MatchService.Phase, ctx.MatchService.Day, FIRE) then
		return fail(string.format("Campfires are protected until Night %d.", FIRE.ProtectedNights + 1))
	end
	local fire = fires[fireTeam]
	if not fire or fire.Out then
		return fail("That fire is already out.")
	end
	if not ctx.MatchService.FireBurning(fireTeam) then
		return fail("That fire is already out.")
	end
	if not ctx.InventoryService.HasFilledCanteen(player) then
		return fail(if ctx.InventoryService.HasCanteen(player) then "Your canteen is empty. Fill it at a stream." else "You need a filled canteen (Workbench Tier II).")
	end
	local other = ctx.ChannelService.AnyOnTarget("Pour", fireTeam)
	if other and other ~= player then
		return fail("Another raider is already pouring on this fire.")
	end
	if ctx.Util.DistTo(player, camp.FirePos) > Config.Fire.PourRange + 1 then
		return fail("Get closer to the fire.")
	end
	ctx.InventoryService.EquipUtility(player)
	ctx.ChannelService.Begin(player, {
		Kind = "Pour",
		Label = "Snuffing the " .. Config.Teams[fireTeam].Name .. " fire",
		Duration = FireRules.SnuffTime(fire, FIRE),
		Range = Config.Fire.PourRange,
		Hold = true,
		InterruptOnDamage = true,
		MoveTolerance = 2.5,
		Prompt = prompt,
		TargetKey = fireTeam,
		Action = "Pour",
		Position = function()
			return camp.FirePos
		end,
		CanContinue = function()
			if not FireRules.SnuffAllowed(ctx.MatchService.Phase, ctx.MatchService.Day, FIRE) then
				return false, "The fire can't be snuffed right now."
			end
			if not ctx.MatchService.FireBurning(fireTeam) then
				return false, "The fire is already out."
			end
			if not ctx.InventoryService.HasFilledCanteen(player) then
				return false, "Your canteen is empty."
			end
			return true
		end,
		OnComplete = function()
			if ctx.MatchService.FireBurning(fireTeam) and ctx.InventoryService.UseCanteen(player) then
				ctx.MatchService.ExtinguishFire(fireTeam, player)
				ctx.PowerupService.OnFireExtinguished(player)
			end
		end,
	})
	-- Alert the defenders (throttled)
	local t = os.clock()
	if t - (lastAlert[fireTeam] or 0) > Config.Fire.AlertCooldown then
		lastAlert[fireTeam] = t
		-- Direction only (from the fire toward the raider), never the raider's position.
		local root = ctx.Util.Root(player)
		local dir = if root then (root.Position - camp.FirePos) * Vector3.new(1, 0, 1) else Vector3.zero
		local bearing = if dir.Magnitude > 0.1 then math.deg(math.atan2(dir.X, -dir.Z)) % 360 else nil
		for _, mate in ctx.Util.TeamPlayers(fireTeam) do
			Net.FireClient("MatchEvent", mate, "FireUnderAttack", { By = myTeam, Pos = camp.FirePos, Bearing = bearing, Seconds = FireRules.SnuffTime(fire, FIRE) })
		end
	end
	Net.FireAll("Fx", "PourStart", { Player = player, Pos = camp.FirePos })
end

-- Map data -----------------------------------------------------------------------------------

function CampService._campMapInfo(team: number)
	local camp = camps[team]
	return { Team = team, X = camp.FirePos.X, Z = camp.FirePos.Z }
end

function CampService.SendMapData(p: Player)
	local map = ctx.MatchService.Map
	if not map or not p.Parent then
		return
	end
	local team = ctx.Util.Team(p)
	local layout = map.Layout
	local O = map.Origin
	local function pts(list)
		local out = {}
		for _, pt in list do
			table.insert(out, { pt.X + O.X, pt.Z + O.Z })
		end
		return out
	end
	local paths, streams, landmarks = {}, {}, {}
	for _, path in layout.Paths do
		table.insert(paths, pts(path.Points))
	end
	for _, s in layout.Streams do
		table.insert(streams, pts(s.Points))
	end
	for _, f in layout.Features do
		table.insert(landmarks, { Type = f.Type, X = f.X + O.X, Z = f.Z + O.Z, R = f.R })
	end
	local campsOut = {}
	for campTeam in camps do
		if CampService.IsRevealed(team, campTeam) then
			table.insert(campsOut, CampService._campMapInfo(campTeam))
		end
	end
	local own = camps[team]
	local myCamp = own and {
		X = own.FirePos.X,
		Z = own.FirePos.Z,
		Clearances = own.Clearances,
		StaticRects = own.StaticRects,
	} or nil
	Net.FireClient("MapData", p, {
		HalfSize = layout.HalfSize,
		Origin = { O.X, O.Z },
		Paths = paths,
		Streams = streams,
		Landmarks = landmarks,
		Camps = campsOut,
		MyTeam = team,
		MyCamp = myCamp,
		BuildRadius = Config.Build.ZoneRadius,
	})
end

-- Players leaving mid-alert cleanup
Players.PlayerRemoving:Connect(function(p)
	lastHurt[p] = nil
end)

return CampService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="874">
          <Properties>
            <string name="Name">ChannelService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Server-timed channelled interactions (pour, steal, open, gather, fill, bandage).
--
-- ProximityPrompts are instant triggers (HoldDuration 0); the *server* times the
-- action, so exploit clients cannot skip progress. A channel is cancelled when
-- the player takes damage (if InterruptOnDamage), dies, moves out of range, the
-- target becomes invalid, CanContinue() fails, or (for Hold channels) the
-- player releases the prompt/button.
--
-- Prompt routing: every server prompt carries an "Action" attribute; services
-- register a handler per action with ChannelService.OnPrompt.

local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

export type Spec = {
	Kind: string,
	Label: string,
	Duration: number,
	Range: number,
	Position: () -> Vector3?, -- nil = target gone
	Hold: boolean?, -- releasing cancels
	InterruptOnDamage: boolean?,
	Prompt: ProximityPrompt?,
	CanContinue: (() -> (boolean, string?))?,
	OnComplete: () -> (),
	OnCancel: ((string) -> ())?,
	Action: string?, -- character "Action" attribute while channelling (drives animations)
	TargetKey: any?, -- identifies the target for exclusivity checks (e.g. a fire's team)
	MoveTolerance: number?, -- studs the player may drift from where they started (nil = any, within Range)
}

type Active = Spec & { Player: Player, Started: number, Id: number, StartPos: Vector3? }

local ChannelService = {}

local ctx: any
local active: { [Player]: Active } = {}
local handlers: { [string]: (Player, ProximityPrompt) -> () } = {}
local nextId = 0

function ChannelService.Init(c)
	ctx = c
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		local action = prompt:GetAttribute("Action") :: string?
		if not action then
			return
		end
		local h = handlers[action]
		if not h then
			return
		end
		if not ctx.Util.Allow(player, "Interact") then
			return
		end
		local ok, err = pcall(h, player, prompt)
		if not ok then
			warn("[ChannelService] prompt handler " .. action .. " error:", err)
		end
	end)
	ProximityPromptService.PromptTriggerEnded:Connect(function(prompt: ProximityPrompt, player: Player)
		local a = active[player]
		if a and a.Hold and a.Prompt == prompt then
			ChannelService.Cancel(player, "Released")
		end
	end)
	ctx.Util.Connect("ChannelStop", "Interact", function(player: Player)
		local a = active[player]
		if a then
			ChannelService.Cancel(player, "Cancelled")
		end
	end)
	ctx.Util.OnPlayerRemoving(function(player: Player)
		ChannelService.Cancel(player, "Left")
	end)
	ctx.MatchService.On("MatchCleanup", function()
		for p in active do
			ChannelService.Cancel(p, "Match over")
		end
	end)
end

function ChannelService.Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		local t = os.clock()
		for player, a in active do
			local reason: string? = nil
			local root = ctx.Util.Root(player)
			local hum = ctx.Util.Humanoid(player)
			if not root or not hum or hum.Health <= 0 then
				reason = "You died"
			else
				local pos = a.Position()
				if not pos then
					reason = "Target is gone"
				elseif (root.Position - pos).Magnitude > a.Range + 2 then
					reason = "Moved out of range"
				elseif a.MoveTolerance and a.StartPos and ((root.Position - a.StartPos) * Vector3.new(1, 0, 1)).Magnitude > a.MoveTolerance then
					reason = "You moved"
				elseif a.CanContinue then
					local ok, why = a.CanContinue()
					if not ok then
						reason = why or "Interrupted"
					end
				end
			end
			if reason then
				ChannelService.Cancel(player, reason)
			elseif t - a.Started >= a.Duration then
				active[player] = nil
				ChannelService._clearAction(player)
				Net.FireClient("ChannelState", player, { Id = a.Id, Done = true })
				local ok, err = pcall(a.OnComplete)
				if not ok then
					warn("[ChannelService] OnComplete error:", err)
				end
			end
		end
	end)
end

function ChannelService.OnPrompt(action: string, handler: (Player, ProximityPrompt) -> ())
	handlers[action] = handler
end

-- Creates a standard server prompt.
function ChannelService.MakePrompt(parent: Instance, action: string, actionText: string, objectText: string, range: number?, filter: string?, team: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = action .. "Prompt"
	p.ActionText = actionText
	p.ObjectText = objectText
	p.HoldDuration = 0
	p.MaxActivationDistance = range or 10
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Custom
	p:SetAttribute("Action", action)
	if filter then
		p:SetAttribute("Filter", filter) -- "Team" | "Enemy" (client hides prompts that don't apply)
	end
	if team then
		p:SetAttribute("Team", team)
	end
	p.Parent = parent
	return p
end

function ChannelService.Begin(player: Player, spec: Spec): boolean
	if active[player] then
		ChannelService.Cancel(player, "Started something else")
	end
	nextId += 1
	local a = spec :: any
	a.Player = player
	a.Started = os.clock()
	a.Id = nextId
	local root = ctx.Util.Root(player)
	a.StartPos = if root then root.Position else nil
	active[player] = a
	if spec.Action then
		local char = player.Character
		if char then
			char:SetAttribute("Action", spec.Action)
			char:SetAttribute("ActionAt", workspace:GetServerTimeNow())
		end
	end
	Net.FireClient("ChannelState", player, {
		Id = a.Id,
		Kind = spec.Kind,
		Label = spec.Label,
		Duration = spec.Duration,
		Hold = spec.Hold == true,
	})
	return true
end

function ChannelService._clearAction(player: Player)
	local char = player.Character
	if char and char:GetAttribute("Action") then
		char:SetAttribute("Action", nil)
	end
end

function ChannelService.Cancel(player: Player, reason: string)
	local a = active[player]
	if not a then
		return
	end
	active[player] = nil
	ChannelService._clearAction(player)
	if player.Parent then
		Net.FireClient("ChannelState", player, { Id = a.Id, Cancelled = true, Reason = reason })
	end
	if a.OnCancel then
		local ok, err = pcall(a.OnCancel, reason)
		if not ok then
			warn("[ChannelService] OnCancel error:", err)
		end
	end
end

function ChannelService.CancelFor(player: Player, reason: string)
	ChannelService.Cancel(player, reason)
end

function ChannelService.OnDamaged(player: Player)
	local a = active[player]
	if a and a.InterruptOnDamage ~= false then
		ChannelService.Cancel(player, "Interrupted by damage!")
	end
end

function ChannelService.Get(player: Player): Active?
	return active[player]
end

function ChannelService.IsBusy(player: Player, kind: string?): boolean
	local a = active[player]
	return a ~= nil and (kind == nil or a.Kind == kind)
end

-- Is anyone channelling `kind` against something identified by `key`?
function ChannelService.AnyOnTarget(kind: string, key: any): Player?
	for p, a in active do
		if a.Kind == kind and a.TargetKey == key then
			return p
		end
	end
	return nil
end

return ChannelService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="875">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Server-authoritative combat.
--
-- Clients only send *intent*: "I attacked with my equipped item in this aim
-- direction (with this bow charge)". The server checks cooldowns, ammo and
-- state, then finds targets itself from server positions:
--   * melee   – cone query in front of the attacker's server-side root
--   * arrows  – server-simulated projectiles (gravity + raycast steps)
--   * guns    – server raycast from the attacker's head along the aim
-- Damage then flows through CombatService.DamagePlayer / structures / animals,
-- which applies friendly-fire, spawn protection, shield and armor rules.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Logic = Shared:WaitForChild("Logic")
local CombatRules = require(Logic:WaitForChild("CombatRules"))

local CombatService = {}

export type Source = { Kind: string, By: Player?, Name: string?, Pos: Vector3?, Weapon: string?, Heavy: boolean?, Head: boolean? }
local CFG = Config.Combat

local ctx: any
local nextAttack: { [Player]: number } = {}
local lastShot: { [Player]: number } = {}
local arrows: { { Owner: Player, Pos: Vector3, Vel: Vector3, T: number, Damage: number, Id: number, Start: Vector3, Weapon: string? } } = {}
local arrowId = 0

function CombatService.Init(c)
	ctx = c
	ctx.Util.Connect("Attack", "Attack", CombatService._onAttack)
	-- Any melee weapon or tool can block (spec: Light / Heavy / Block); the Shield blocks best.
	ctx.Util.Connect("BlockState", "Default", function(p: Player, on: any)
		local id = ctx.InventoryService.EquippedItem(p)
		local def = Items[id]
		local broken = (p:GetAttribute("GuardBrokenUntil") or 0) > workspace:GetServerTimeNow()
		local can = def ~= nil and not def.Ranged and (def.Kind == "Weapon" or def.Kind == "Tool") and not broken
		p:SetAttribute("Blocking", on == true and can and ctx.Util.IsAlive(p) and ctx.StaminaService.Get(p) > 1)
	end)
	ctx.Util.Connect("DrawState", "Default", function(p: Player, on: any)
		local def = Items[(ctx.InventoryService.EquippedItem(p))]
		p:SetAttribute("Drawing", on == true and def ~= nil and def.Ranged ~= nil and ctx.Util.IsAlive(p))
	end)
	ctx.Util.OnPlayerRemoving(function(p)
		nextAttack[p] = nil
		lastShot[p] = nil
	end)
end

function CombatService.Start()
	RunService.Heartbeat:Connect(CombatService._stepArrows)
end

-- Damage pipeline ----------------------------------------------------------------------------

-- Returns the damage actually dealt.
function CombatService.DamagePlayer(victim: Player, amount: number, source: Source): number
	local phase = ctx.MatchService.Phase
	if amount <= 0 or not victim:GetAttribute("InMatch") or not ctx.MatchService.Active or (phase ~= "Day" and phase ~= "Night") then
		return 0 -- no damage in the lobby, during the intro countdown or after the match ends
	end
	local hum = ctx.Util.Humanoid(victim)
	local root = ctx.Util.Root(victim)
	if not hum or not root or hum.Health <= 0 then
		return 0
	end
	if source.By then
		if source.By == victim then
			return 0
		end
		if ctx.Util.Team(source.By) == ctx.Util.Team(victim) then
			return 0 -- friendly fire off
		end
		if ctx.LivesService.IsProtected(source.By) then
			return 0 -- spawn / sunrise protection: protected players can't deal damage
		end
	end
	if ctx.LivesService.IsProtected(victim) then
		return 0
	end
	local dmg = amount
	-- Block (frontal): stops part of the hit for stamina; heavies drain extra and can break the guard.
	if victim:GetAttribute("Blocking") and source.Pos then
		local toAttacker = (source.Pos - root.Position) * Vector3.new(1, 0, 1)
		if toAttacker.Magnitude > 0.1 and root.CFrame.LookVector:Dot(toAttacker.Unit) > 0.25 then
			local bid, slot = ctx.InventoryService.EquippedItem(victim)
			local bdef = Items[bid]
			local isShield = bdef and bdef.BlockReduction ~= nil
			local r = CombatRules.Block(dmg, if isShield then bdef.BlockReduction else CFG.BlockReduction, ctx.StaminaService.Get(victim),
				if isShield then CFG.ShieldDrainPerHp else CFG.BlockDrainPerHp, if source.Heavy then CFG.HeavyGuardDrain else 0)
			ctx.StaminaService.Drain(victim, r.Drain)
			local bchar = victim.Character
			if bchar then
				bchar:SetAttribute("BlockHitAt", workspace:GetServerTimeNow())
			end
			if slot then
				ctx.InventoryService.Wear(victim, slot, math.max(1, math.ceil((dmg - r.Taken) / 4)))
			end
			dmg = r.Taken
			Net.FireAll("Fx", "Block", { Pos = root.Position })
			if r.GuardBroken then
				victim:SetAttribute("Blocking", false)
				victim:SetAttribute("GuardBrokenUntil", workspace:GetServerTimeNow() + CFG.GuardBreakTime)
				Net.FireClient("HitFeedback", victim, "GuardBreak", 0, source.Pos)
				if source.By then
					Net.FireClient("HitFeedback", source.By, "GuardBreak", 0, root.Position)
				end
			end
		end
	end
	-- Armour: every worn piece reduces damage and wears a little.
	local inv = ctx.InventoryService.Get(victim)
	if inv and next(inv.Armor) then
		local shares = {}
		for _, st in inv.Armor do
			table.insert(shares, (Items[st.Id] and Items[st.Id].DamageReduction) or 0)
		end
		local red = dmg * CombatRules.ArmorReduction(shares, CFG.ArmorCap)
		dmg -= red
		for piece in table.clone(inv.Armor) do
			ctx.InventoryService.Wear(victim, "Armor" .. piece, math.max(1, math.ceil(red / 3)))
		end
	end
	dmg = math.max(1, math.floor(dmg + 0.5))
	ctx.LivesService.RecordDamage(victim, source.Kind, source.By, source.Name)
	ctx.ChannelService.OnDamaged(victim)
	ctx.CampService.NoteHurt(victim)
	hum.Health = math.max(0, hum.Health - dmg)
	ctx.PowerupService.OnPlayerHurt(victim, dmg)
	-- hit reaction (Animation flinches away from the attacker)
	local vchar = victim.Character
	if vchar then
		vchar:SetAttribute("HitAt", workspace:GetServerTimeNow())
		if source.Pos then
			local away = (root.Position - source.Pos) * Vector3.new(1, 0, 1)
			vchar:SetAttribute("HitDir", if away.Magnitude > 0.1 then away.Unit else nil)
		end
	end
	Net.FireClient("HitFeedback", victim, "Hurt", dmg, source.Pos)
	if source.By then
		Net.FireClient("HitFeedback", source.By, "Player", dmg, root.Position)
	end
	ctx.Util.PlaySound("HitFlesh", root)
	return dmg
end

-- Aim/target helpers ------------------------------------------------------------------------

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, -1)
end

-- What kind of thing is this part? Returns kind, object.
function CombatService.Classify(part: Instance): (string?, any)
	local p = ctx.Util.PlayerFromPart(part)
	if p then
		return "Player", p
	end
	local animal = ctx.WildlifeService.FromPart(part)
	if animal then
		return "Animal", animal
	end
	local structure = ctx.BuildService.FromPart(part)
	if structure then
		return "Structure", structure
	end
	local node = ctx.GatherService.FromPart(part)
	if node then
		return "Node", node
	end
	return nil, nil
end

-- Melee: best target in a 60 degree cone.
local function meleeTarget(attacker: Player, origin: Vector3, dir: Vector3, range: number): (string?, any, Vector3?)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker.Character :: Instance }
	local reach = range + Config.Combat.MeleeTolerance
	local parts = workspace:GetPartBoundsInRadius(origin + dir * reach * 0.5, reach * 0.6 + 2, params)
	local best: { Kind: string?, Obj: any, Pos: Vector3?, Score: number } = { Kind = nil, Obj = nil, Pos = nil, Score = math.huge }
	local priority = { Player = 0, Animal = 0, Structure = 20, Node = 30 }
	local seen = {}
	for _, part in parts do
		local kind, obj = CombatService.Classify(part)
		if kind and not seen[obj] then
			seen[obj] = true
			local pos = part.Position
			local to = pos - origin
			local horiz = Vector3.new(to.X, 0, to.Z)
			local dist = horiz.Magnitude
			if dist <= reach + part.Size.Magnitude * 0.25 and math.abs(to.Y) < 9 then
				local facing = if dist > 0.5 then dir:Dot(horiz.Unit) else 1
				-- Players and animals can't be hit through walls: require line of sight.
				if facing > 0.45 and (kind == "Player" or kind == "Animal") then
					local los = RaycastParams.new()
					los.FilterType = Enum.RaycastFilterType.Exclude
					los.FilterDescendantsInstances = { attacker.Character :: Instance }
					los.IgnoreWater = true
					local eye = origin + Vector3.new(0, 1.5, 0)
					local block = workspace:Raycast(eye, pos - eye, los)
					if block and block.Instance ~= part and CombatService.Classify(block.Instance) ~= kind then
						facing = 0
					end
				end
				if facing > 0.45 then
					local score = dist + priority[kind] - facing * 2
					if score < best.Score then
						best = { Kind = kind, Obj = obj, Pos = pos, Score = score }
					end
				end
			end
		end
	end
	return best.Kind, best.Obj, best.Pos
end

-- Attack --------------------------------------------------------------------------------------

function CombatService._onAttack(p: Player, payload: any)
	if type(payload) ~= "table" or not ctx.Util.IsUnit(payload.Dir) then
		return
	end
	local char = p.Character
	local root = ctx.Util.Root(p)
	if not char or not root or not ctx.Util.IsAlive(p) then
		return
	end
	local id, slot = ctx.InventoryService.EquippedItem(p)
	local def = Items[id]
	if not def or def.Kind == "Utility" then
		return
	end
	local t = os.clock()
	local heavy = payload.Heavy == true and not def.Ranged
	local cd = (def.Cooldown or 0.6) * (if heavy then CFG.HeavyCooldownMult else 1)
	if t < (nextAttack[p] or 0) then
		return
	end
	-- A heavy needs a wind-up since the last swing (the client holds it for HeavyWindup).
	if heavy and t - (nextAttack[p] or 0) < CFG.HeavyWindup * 0.8 then
		heavy = false
	end
	if ctx.ChannelService.IsBusy(p) then
		ctx.ChannelService.Cancel(p, "Attacked")
	end
	if p:GetAttribute("Blocking") then
		p:SetAttribute("Blocking", false)
	end
	nextAttack[p] = t + cd * 0.9 -- small tolerance for latency jitter
	char:SetAttribute("Action", "Attack")
	char:SetAttribute("ActionAt", workspace:GetServerTimeNow())
	char:SetAttribute("ActionItem", id)
	char:SetAttribute("ActionHeavy", heavy)
	p:SetAttribute("Drawing", false)
	char:SetAttribute("ActionVariant", ((char:GetAttribute("ActionVariant") or 0) + 1) % 2) -- alternate swing direction

	local inMatch = p:GetAttribute("InMatch") == true and ctx.MatchService.IsPlaying()

	if def.Ranged == "Arrow" then
		CombatService._fireArrow(p, def, payload, slot)
		return
	elseif def.Ranged == "Hitscan" then
		CombatService._fireGun(p, def, payload, slot)
		return
	end

	-- Melee / tools
	local dir = flat(payload.Dir)
	ctx.Util.PlaySound("Swing", root)
	if not inMatch then
		return
	end
	local kind, obj, hitPos = meleeTarget(p, root.Position, dir, def.Range or 5)
	if not kind then
		return
	end
	-- Stamina: light 6 / heavy 18; without enough, heavies become lights and swings are weak.
	local tired = false
	if inMatch then
		if heavy and not ctx.StaminaService.Spend(p, CFG.HeavyStamina) then
			heavy = false
		end
		if not heavy and not ctx.StaminaService.Spend(p, CFG.LightStamina) then
			tired = true
		end
	end
	local dmg = CombatRules.MeleeDamage(def.Damage or 5, heavy, CFG.HeavyMult, tired)
	local worn = false
	if kind == "Player" then
		dmg = dmg * ctx.PowerupService.DamageMult(p, "Player")
		if CombatService.DamagePlayer(obj, dmg, { Kind = "Player", By = p, Pos = root.Position, Weapon = id, Heavy = heavy }) > 0 then
			worn = true
		end
	elseif kind == "Animal" then
		dmg = dmg * (def.AnimalMult or 1) * ctx.PowerupService.DamageMult(p, "Animal")
		if ctx.WildlifeService.Damage(obj, dmg, p) then
			worn = true
		end
	elseif kind == "Structure" then
		if id == "RepairHammer" then
			ctx.BuildService.Repair(p, obj)
			worn = true
		else
			local sdmg = dmg * (def.StructureMult or 1) * Config.Combat.StructureDamageScale
			if ctx.BuildService.Damage(obj, sdmg, p) then
				worn = true
			end
		end
	elseif kind == "Node" then
		if ctx.GatherService.Hit(p, obj, id) then
			worn = true
		end
	end
	if worn and slot then
		ctx.InventoryService.Wear(p, slot, if def.ToolType then ctx.PowerupService.ToolWear(p, def.ToolType) else 1)
	end
	if hitPos and kind ~= "Node" then
		Net.FireAll("Fx", "Impact", { Pos = hitPos, Kind = kind })
	end
end

-- Bow -------------------------------------------------------------------------------------------

function CombatService._fireArrow(p: Player, def: any, payload: any, slot: string?)
	local inv = ctx.InventoryService.Get(p)
	local head = p.Character and p.Character:FindFirstChild("Head") :: BasePart?
	if not inv or not head then
		return
	end
	local ammo = def.AmmoType or "Arrow"
	if (inv.Ammo[ammo] or 0) <= 0 then
		ctx.Util.Notify(p, if ammo == "Bolt" then "No bolts! Craft them at Workbench Tier IV." else "No arrows! Craft them at Workbench Tier II.", "warn")
		return
	end
	local t = os.clock()
	local drawTime = (def.DrawTime or 0.6) * ctx.PowerupService.DrawMult(p)
	-- Server-side minimum draw: charge can't exceed time since the last shot allows.
	local maxCharge = math.clamp((t - (lastShot[p] or 0)) / drawTime, 0, 1)
	local charge = math.clamp(if ctx.Util.IsFinite(payload.Charge) then payload.Charge else 0, 0.2, maxCharge)
	lastShot[p] = t
	inv.Ammo[ammo] -= 1
	if slot then
		ctx.InventoryService.Wear(p, slot, 1)
	else
		ctx.InventoryService.Sync(p)
	end
	local spread = math.rad((def.Spread or 1) * (1.5 - charge) * ctx.PowerupService.SpreadMult(p))
	local dir = (CFrame.lookAt(Vector3.zero, payload.Dir) * CFrame.Angles((math.random() - 0.5) * spread, (math.random() - 0.5) * spread, 0)).LookVector
	local speed = Config.Combat.ArrowSpeed * (0.55 + 0.45 * charge)
	local origin = head.Position + dir * 2
	arrowId += 1
	table.insert(arrows, { Owner = p, Pos = origin, Vel = dir * speed, T = 0, Damage = (def.Damage or 20) * (0.4 + 0.6 * charge), Id = arrowId, Start = origin, Weapon = def.Id })
	Net.FireAll("Fx", "Arrow", { Id = arrowId, Origin = origin, Velocity = dir * speed, Gravity = Config.Combat.ArrowGravity })
	ctx.Util.PlaySound("BowRelease", head)
end

function CombatService._stepArrows(dt: number)
	if #arrows == 0 then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local match = workspace:FindFirstChild("Match")
	local pickups = match and match:FindFirstChild("Pickups")
	for i = #arrows, 1, -1 do
		local a = arrows[i]
		a.T += dt
		local owner = a.Owner
		params.FilterDescendantsInstances = { owner.Character :: Instance, pickups :: Instance }
		local vel = a.Vel - Vector3.new(0, Config.Combat.ArrowGravity * dt, 0)
		local step = vel * dt
		local hit = workspace:Raycast(a.Pos, step, params)
		a.Vel = vel
		if hit then
			table.remove(arrows, i)
			Net.FireAll("Fx", "ArrowStop", { Id = a.Id, Pos = hit.Position })
			if owner.Parent and owner:GetAttribute("InMatch") then
				local kind, obj = CombatService.Classify(hit.Instance)
				local wdef = Items[a.Weapon or "Bow"] or Items.Bow
				local head = kind == "Player" and hit.Instance.Name == "Head" and wdef.Headshots == true
				local dmg = CombatRules.Headshot(a.Damage, head, CFG.HeadshotMult)
				if head then
					Net.FireClient("HitFeedback", owner, "Headshot", math.floor(dmg + 0.5), hit.Position)
				end
				if kind == "Player" then
					local dealt = CombatService.DamagePlayer(obj, dmg * ctx.PowerupService.DamageMult(owner, "Player"), { Kind = "Player", By = owner, Pos = a.Start, Weapon = wdef.Id, Head = head })
					if dealt > 0 then
						ctx.PowerupService.OnArrowHit(owner, obj, (hit.Position - a.Start).Magnitude)
					end
				elseif kind == "Animal" then
					ctx.WildlifeService.Damage(obj, dmg * ctx.PowerupService.DamageMult(owner, "Animal"), owner)
				elseif kind == "Structure" then
					ctx.BuildService.Damage(obj, dmg * (wdef.StructureMult or 0.4), owner)
				end
			end
		else
			a.Pos += step
			if a.T > Config.Combat.ArrowMaxTime then
				table.remove(arrows, i)
				Net.FireAll("Fx", "ArrowStop", { Id = a.Id, Pos = a.Pos })
			end
		end
	end
end

-- Guns -------------------------------------------------------------------------------------------

function CombatService._fireGun(p: Player, def: any, payload: any, slot: string?)
	local inv = ctx.InventoryService.Get(p)
	local head = p.Character and p.Character:FindFirstChild("Head") :: BasePart?
	if not inv or not head then
		return
	end
	if (inv.Ammo.Bullet or 0) <= 0 then
		ctx.Util.Notify(p, "Out of bullets! Find more in care packages and crates.", "warn")
		return
	end
	inv.Ammo.Bullet -= 1
	if slot then
		ctx.InventoryService.Wear(p, slot, 1)
	else
		ctx.InventoryService.Sync(p)
	end
	local spread = math.rad(def.Spread or 1)
	local dir = (CFrame.lookAt(Vector3.zero, payload.Dir) * CFrame.Angles((math.random() - 0.5) * spread, (math.random() - 0.5) * spread, 0)).LookVector
	local origin = head.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { p.Character :: Instance }
	local hit = workspace:Raycast(origin, dir * (def.Range or 120), params)
	local endPos = if hit then hit.Position else origin + dir * (def.Range or 120)
	Net.FireAll("Fx", "Shot", { Origin = origin + dir * 2, End = endPos })
	ctx.Util.PlaySound("Gunshot", head)
	if not hit or not p:GetAttribute("InMatch") then
		return
	end
	local kind, obj = CombatService.Classify(hit.Instance)
	if kind == "Player" then
		local isHead = hit.Instance.Name == "Head"
		local dmg = CombatRules.Headshot(def.Damage or 25, isHead, CFG.HeadshotMult)
		if isHead then
			Net.FireClient("HitFeedback", p, "Headshot", math.floor(dmg + 0.5), hit.Position)
		end
		CombatService.DamagePlayer(obj, dmg * ctx.PowerupService.DamageMult(p, "Player"), { Kind = "Player", By = p, Pos = origin, Weapon = def.Id, Head = isHead })
	elseif kind == "Animal" then
		ctx.WildlifeService.Damage(obj, (def.Damage or 25) * ctx.PowerupService.DamageMult(p, "Animal"), p)
	elseif kind == "Structure" then
		ctx.BuildService.Damage(obj, (def.Damage or 25) * (def.StructureMult or 0.5), p)
	end
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="876">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Applies worn cosmetics (Shared/Cosmetics). Purely visual — nothing here
-- changes stats, hitboxes or visibility in a way that helps in a fight:
--   Outfit        body colours (torso / limbs)
--   Nameplate     coloured plate behind the title/level tag over your head
--   Title         text on that tag
--   ToolSkin      coloured grip wrap on every held tool/weapon
--   BackpackSkin  colour of the worn pack shell
--   CampfireSkin  flame / light colour of your camp fire
--   WorkbenchSkin coloured plate on your workbench
--   StorageSkin   coloured crest on storage you place
--   Emote         lobby emote (pose + particle burst)
--   EliminationFx burst where you eliminate someone
--   VictoryPose   pose on the end screen when you win

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local CosmeticService = {}

local ctx: any
local lastEmote: { [Player]: number } = {}

local function rgb(c: { number }?): Color3?
	return if c then Color3.fromRGB(c[1], c[2], c[3]) else nil
end

-- Worn cosmetic def of a type (validated against ownership), or nil.
function CosmeticService.Worn(p: Player, typ: string): Cosmetics.Def?
	local session = ctx.DataService.Get(p)
	local profile = session and session.Profile
	local id = profile and profile.Wearing[typ]
	local def = id and Cosmetics.ById[id]
	return if def and def.Type == typ and profile.Cosmetics[id] then def else nil
end

function CosmeticService.Init(c)
	ctx = c
	ctx.Util.OnPlayerAdded(function(p: Player)
		p.CharacterAdded:Connect(function(char)
			task.wait(0.5)
			if char.Parent then
				CosmeticService.Apply(p)
			end
		end)
	end)
	ctx.Util.OnPlayerRemoving(function(p)
		lastEmote[p] = nil
	end)
	ctx.MatchService.On("PlayerJoinedMatch", function(p: Player)
		task.delay(2, function()
			CosmeticService._applyCamp(p)
		end)
	end)
end

-- Re-applies everything visible on the character (safe to call repeatedly).
function CosmeticService.Apply(p: Player)
	local char = p.Character
	local outfit = CosmeticService.Worn(p, "Outfit")
	local plate = CosmeticService.Worn(p, "Nameplate")
	local title = CosmeticService.Worn(p, "Title")
	local tool = CosmeticService.Worn(p, "ToolSkin")
	local pack = CosmeticService.Worn(p, "BackpackSkin")
	p:SetAttribute("Title", if title then title.Text else nil)
	p:SetAttribute("ToolSkin", rgb(tool and tool.Color))
	p:SetAttribute("PackSkin", rgb(pack and pack.Color))
	if not char then
		return
	end
	-- Outfit
	local bc = char:FindFirstChildOfClass("BodyColors")
	if outfit and outfit.Color then
		if not bc then
			bc = Instance.new("BodyColors")
			bc.Parent = char
		end
		local torso = rgb(outfit.Color) :: Color3
		local limbs = rgb(outfit.Color2) or torso
		bc.TorsoColor3 = torso
		bc.LeftArmColor3 = torso
		bc.RightArmColor3 = torso
		bc.LeftLegColor3 = limbs
		bc.RightLegColor3 = limbs
		char:SetAttribute("Outfit", outfit.Id)
	elseif char:GetAttribute("Outfit") and bc then
		bc:Destroy()
		char:SetAttribute("Outfit", nil)
	end
	-- Title / level tag
	local head = char:FindFirstChild("Head") :: BasePart?
	if head then
		local tag = head:FindFirstChild("CosmeticTag") :: BillboardGui?
		local level = p:GetAttribute("Level") or 1
		if not tag then
			tag = Instance.new("BillboardGui")
			tag.Name = "CosmeticTag"
			tag.Size = UDim2.fromOffset(150, 20)
			tag.StudsOffset = Vector3.new(0, 3.4, 0)
			tag.MaxDistance = 45
			tag.LightInfluence = 0
			tag.Parent = head
			local label = Instance.new("TextLabel")
			label.Name = "Text"
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextScaled = true
			label.Font = Enum.Font.GothamBold
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextStrokeTransparency = 0.4
			label.Parent = tag
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = label
		end
		local label = (tag :: BillboardGui):FindFirstChild("Text") :: TextLabel
		label.Text = (if title then title.Text .. " · " else "") .. "Lv " .. tostring(level)
		label.BackgroundColor3 = rgb(plate and plate.Color) or Color3.fromRGB(30, 30, 30)
		label.BackgroundTransparency = if plate then 0.15 else 0.7
	end
	-- Held tool wrap refresh
	local held = char:FindFirstChild("HeldItem")
	if held then
		CosmeticService.DressHeld(p, held :: Model)
	end
	if ctx.InventoryService.Get(p) then
		ctx.InventoryService._refreshHeld(p) -- backpack tint
	end
end

-- Adds a coloured grip wrap to a freshly created held-item model.
function CosmeticService.DressHeld(p: Player, model: Model)
	local color = p:GetAttribute("ToolSkin") :: Color3?
	local old = model:FindFirstChild("SkinWrap")
	if old then
		old:Destroy()
	end
	local handle = model.PrimaryPart
	if not color or not handle then
		return
	end
	local wrap = Instance.new("Part")
	wrap.Name = "SkinWrap"
	wrap.Size = Vector3.new(0.34, 0.5, 0.34)
	wrap.Color = color
	wrap.Material = Enum.Material.Fabric
	wrap.CanCollide = false
	wrap.CanQuery = false
	wrap.CanTouch = false
	wrap.Massless = true
	wrap.CFrame = handle.CFrame
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = wrap
	weld.Parent = wrap
	wrap.Parent = model
end

-- Campfire flame colour + workbench plate for the player's own camp.
function CosmeticService._applyCamp(p: Player)
	local camp = ctx.CampService.GetCamp(ctx.Util.Team(p))
	if not camp then
		return
	end
	local fire = CosmeticService.Worn(p, "CampfireSkin")
	if fire and camp.Fire then
		local c1, c2 = rgb(fire.Color) :: Color3, rgb(fire.Color2) or rgb(fire.Color) :: Color3
		for _, d in camp.Fire:GetDescendants() do
			if d:IsA("Fire") then
				d.Color = c1
				d.SecondaryColor = c2
			elseif d:IsA("PointLight") then
				d.Color = c1
			elseif d:IsA("ParticleEmitter") and d.Name ~= "Smoke" then
				d.Color = ColorSequence.new(c2, c1)
			end
		end
		camp.Fire:SetAttribute("FlameSkin", fire.Id)
	end
	local bench = CosmeticService.Worn(p, "WorkbenchSkin")
	if bench and camp.Workbench then
		CosmeticService._plate(camp.Workbench, rgb(bench.Color) :: Color3, "BenchPlate")
	end
end

-- Workbench upgrades rebuild the model: re-apply.
function CosmeticService.OnWorkbenchRebuilt(team: number)
	for _, p in ctx.Util.TeamPlayers(team) do
		local bench = CosmeticService.Worn(p, "WorkbenchSkin")
		local camp = ctx.CampService.GetCamp(team)
		if bench and camp and camp.Workbench then
			CosmeticService._plate(camp.Workbench, rgb(bench.Color) :: Color3, "BenchPlate")
		end
	end
end

-- Storage the player places gets their crest.
function CosmeticService.OnStructurePlaced(p: Player, model: Model, kind: string?)
	if kind ~= "Storage" then
		return
	end
	local crest = CosmeticService.Worn(p, "StorageSkin")
	if crest then
		CosmeticService._plate(model, rgb(crest.Color) :: Color3, "Crest")
	end
end

function CosmeticService._plate(model: Model, color: Color3, name: string)
	local old = model:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local cf, size = model:GetBoundingBox()
	local plate = Instance.new("Part")
	plate.Name = name
	plate.Anchored = true
	plate.CanCollide = false
	plate.CanQuery = false
	plate.CanTouch = false
	plate.Size = Vector3.new(math.min(1.6, size.X * 0.4), 0.8, 0.12)
	plate.Color = color
	plate.Material = Enum.Material.Metal
	-- front face (local -Z), a little above the middle
	plate.CFrame = cf * CFrame.new(0, size.Y * 0.1, -size.Z / 2 - 0.07)
	plate.Parent = model
end

-- Lobby emote: short pose + burst in the emote's colour.
function CosmeticService.Emote(p: Player, id: string)
	local session = ctx.DataService.Get(p)
	local def = Cosmetics.ById[id]
	if not session or not def or def.Type ~= "Emote" or not session.Profile.Cosmetics[id] then
		return
	end
	local t = os.clock()
	if t - (lastEmote[p] or 0) < 3 then
		return
	end
	lastEmote[p] = t
	local char = p.Character
	local root = ctx.Util.Root(p)
	if not char or not root then
		return
	end
	char:SetAttribute("Action", "Emote")
	char:SetAttribute("ActionAt", workspace:GetServerTimeNow())
	char:SetAttribute("ActionItem", id)
	Net.FireAll("Fx", "Cosmetic", { Pos = root.Position + Vector3.new(0, 2, 0), Color = rgb(def.Color) or Color3.new(1, 1, 1), Count = 20 })
end

function CosmeticService.OnElimination(killer: Player, victim: Player)
	local fx = CosmeticService.Worn(killer, "EliminationFx")
	local root = ctx.Util.Root(victim)
	if fx and root then
		Net.FireAll("Fx", "Cosmetic", { Pos = root.Position, Color = rgb(fx.Color) or Color3.new(1, 1, 1), Count = 45 })
	end
end

function CosmeticService.OnVictory(p: Player)
	local pose = CosmeticService.Worn(p, "VictoryPose")
	local char = p.Character
	if char then
		char:SetAttribute("Action", "Victory")
		char:SetAttribute("ActionAt", workspace:GetServerTimeNow())
		char:SetAttribute("ActionItem", if pose then pose.Id else "")
	end
	local root = ctx.Util.Root(p)
	if root then
		Net.FireAll("Fx", "Cosmetic", { Pos = root.Position + Vector3.new(0, 3, 0), Color = Color3.fromRGB(255, 215, 90), Count = 40 })
	end
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="877">
          <Properties>
            <string name="Name">CraftService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Crafting (equipment, ammo, rope) and shared workbench upgrades.
-- Structure recipes are "paid on placement" by BuildService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Recipes = require(Shared:WaitForChild("Recipes"))
local Logic = Shared:WaitForChild("Logic")
local InventoryModel = require(Logic:WaitForChild("InventoryModel"))
local StorageLedger = require(Logic:WaitForChild("StorageLedger"))

local CraftService = {}

local ctx: any
local WORKBENCH_RANGE = 14

function CraftService.Init(c)
	ctx = c
	ctx.Util.Connect("Craft", "Craft", CraftService._onCraft)
	ctx.Util.Connect("UpgradeWorkbench", "Craft", CraftService._onUpgrade)
	ctx.MatchService.On("MatchStarting", function()
		for t = 1, Config.Match.TeamCount do
			ctx.MatchService.State:SetAttribute("Bench" .. t, 1)
		end
	end)
end

local function nearWorkbench(p: Player): boolean
	local camp = ctx.CampService.GetCamp(ctx.Util.Team(p))
	return camp ~= nil and ctx.Util.DistTo(p, camp.WorkbenchCF.Position) <= WORKBENCH_RANGE
end

function CraftService.OpenFor(p: Player)
	CraftService.Push(p, true)
end

-- Sends craft UI data: level, and team storage totals (for combined-cost display).
function CraftService.Push(p: Player, open: boolean?)
	local team = ctx.Util.Team(p)
	local totals = ctx.StorageService.TeamTotals(team)
	Net.FireClient("CraftSync", p, {
		Level = ctx.CampService.GetLevel(team),
		Storage = totals,
		Open = open == true,
		NearBench = nearWorkbench(p),
	})
end

-- Crafting takes a short, interruptible channel (longer for higher tiers; the
-- Craftsman power-up shortens it). Everything is re-validated on completion.
function CraftService._onCraft(p: Player, recipeId: any)
	if type(recipeId) ~= "string" or not p:GetAttribute("InMatch") or not ctx.Util.IsAlive(p) then
		return
	end
	local recipe = Recipes.ById[recipeId]
	if not recipe or recipe.Kind == "Structure" then
		return
	end
	local inv = ctx.InventoryService.Get(p)
	if not inv or not InventoryModel.HasResources(inv, recipe.Cost) then
		ctx.Util.Notify(p, "Not enough materials in your pack.", "error")
		return
	end
	if recipe.Level > 0 and ctx.CampService.GetLevel(ctx.Util.Team(p)) < recipe.Level then
		ctx.Util.Notify(p, "Requires Workbench Tier " .. ({ "I", "II", "III", "IV", "V" })[recipe.Level] .. ".", "error")
		return
	end
	if recipe.Level > 0 and not nearWorkbench(p) then
		ctx.Util.Notify(p, "Stand at your workbench to craft that.", "error")
		return
	end
	local root = ctx.Util.Root(p)
	if not root then
		return
	end
	local start = root.Position
	local def = Items[recipe.Result]
	ctx.ChannelService.Begin(p, {
		Kind = "Craft",
		Label = "Crafting " .. (if def then def.Name else recipe.Result),
		Duration = (Config.Craft.BaseTime + Config.Craft.PerTier * recipe.Level) / ctx.PowerupService.CraftSpeedMult(p),
		Range = 8,
		MoveTolerance = 4,
		InterruptOnDamage = true,
		Action = "Craft",
		Position = function()
			return start
		end,
		OnComplete = function()
			CraftService._craftNow(p, recipeId)
		end,
	})
end

function CraftService._craftNow(p: Player, recipeId: string)
	if not p:GetAttribute("InMatch") or not ctx.Util.IsAlive(p) then
		return
	end
	local recipe = Recipes.ById[recipeId]
	if not recipe or recipe.Kind == "Structure" then
		return
	end
	local team = ctx.Util.Team(p)
	local inv = ctx.InventoryService.Get(p)
	if not inv then
		return
	end
	if recipe.Level > 0 then
		if ctx.CampService.GetLevel(team) < recipe.Level then
			ctx.Util.Notify(p, "Requires Workbench Tier " .. ({ "I", "II", "III", "IV", "V" })[recipe.Level] .. ".", "error")
			return
		end
		if not nearWorkbench(p) then
			ctx.Util.Notify(p, "Stand at your workbench to craft that.", "error")
			return
		end
	end
	if not InventoryModel.HasResources(inv, recipe.Cost) then
		ctx.Util.Notify(p, "Not enough materials in your pack.", "error")
		return
	end
	local def = Items[recipe.Result]
	-- Space checks before paying
	if recipe.Kind == "Consumable" then
		if inv.Bandages >= inv.BandageMax then
			ctx.Util.Notify(p, "Your bandage pouch is full.", "warn")
			return
		end
	elseif recipe.Kind == "Ammo" then
		if (inv.Ammo[recipe.Result] or 0) >= (inv.AmmoMax[recipe.Result] or 0) then
			ctx.Util.Notify(p, "Your ammo pouch is full.", "warn")
			return
		end
	end
	if not InventoryModel.RemoveResources(inv, recipe.Cost) then
		return
	end
	if recipe.Kind == "Resource" then
		local added = InventoryModel.AddResource(inv, recipe.Result, recipe.Count)
		local root = ctx.Util.Root(p)
		if added < recipe.Count and root then
			ctx.InventoryService.SpawnPickup(recipe.Result, recipe.Count - added, root.Position + root.CFrame.LookVector * 3)
		end
		ctx.InventoryService.Sync(p)
	elseif recipe.Kind == "Consumable" then
		InventoryModel.AddBandages(inv, recipe.Count)
		ctx.InventoryService.Sync(p)
	elseif recipe.Kind == "Ammo" then
		InventoryModel.AddAmmo(inv, recipe.Result, recipe.Count)
		ctx.InventoryService.Sync(p)
	else
		local root = ctx.Util.Root(p)
		local taken, displaced = ctx.InventoryService.Give(p, recipe.Result, 1, nil, nil)
		if taken <= 0 then
			-- Should not happen (armor/slots always accept), but never lose materials.
			for id, n in recipe.Cost do
				inv.Resources[id] += n
			end
			ctx.InventoryService.Sync(p)
			return
		end
		if displaced and root then
			ctx.InventoryService.SpawnPickup(displaced.Id, 1, root.Position + root.CFrame.LookVector * 3, displaced)
			ctx.Util.Notify(p, "Dropped your old " .. Items[displaced.Id].Name .. " to make room.", "info")
		end
	end
	ctx.Util.PlaySound("Craft", ctx.Util.Root(p))
	local cr = ctx.Util.Root(p)
	if cr then
		Net.FireAll("Fx", "Crafted", { Pos = cr.Position })
	end
	ctx.Util.Notify(p, "Crafted " .. (if recipe.Count > 1 then recipe.Count .. " " else "") .. def.Name, "success")
	CraftService.Push(p)
end

function CraftService._onUpgrade(p: Player)
	if not p:GetAttribute("InMatch") or not ctx.Util.IsAlive(p) then
		return
	end
	local team = ctx.Util.Team(p)
	local level = ctx.CampService.GetLevel(team)
	if level >= Recipes.MaxWorkbenchLevel then
		ctx.Util.Notify(p, "Your workbench is already at max level.", "info")
		return
	end
	if not nearWorkbench(p) then
		ctx.Util.Notify(p, "Stand at your workbench to upgrade it.", "error")
		return
	end
	local cost = Recipes.WorkbenchUpgrades[level + 1]
	local inv = ctx.InventoryService.Get(p)
	local stores = ctx.StorageService.TeamStores(team)
	if not inv or not StorageLedger.PayCombined(cost, inv, stores) then
		ctx.Util.Notify(p, "Not enough materials (your pack + team storage).", "error")
		return
	end
	ctx.CampService.SetLevel(team, level + 1)
	ctx.PowerupService.OnWorkbenchLevel(p, team, level + 1)
	ctx.Util.SetAction(p, "Craft")
	for _, mate in ctx.Util.TeamPlayers(team) do
		Net.FireClient("MatchEvent", mate, "Upgraded", { What = "Workbench", Level = level + 1 })
	end
	Net.FireAll("Fx", "BenchUpgrade", { Pos = ctx.CampService.GetCamp(team).WorkbenchCF.Position, Level = level + 1 })
	ctx.InventoryService.Sync(p)
	ctx.StorageService.SyncTeam(team)
	ctx.Util.NotifyTeam(team, p.DisplayName .. " upgraded the workbench to level " .. (level + 1) .. "! New recipes unlocked.", "success")
	ctx.Util.PlaySound("Build", ctx.CampService.GetCamp(team).Workbench.PrimaryPart)
	for _, mate in ctx.Util.TeamPlayers(team) do
		CraftService.Push(mate)
	end
end

return CraftService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="878">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Persistent player profiles with session locking.
--
-- Stored record: { Profile = <ProfileRules.Profile>, Lock = { JobId, Time } | nil }
--
-- Safety rules:
--   * A profile is only ever written by the server holding its lock.
--   * If loading fails (DataStore errors, or a lock we cannot take), the
--     profile is marked NotLoaded: the player can still play, but nothing is
--     saved, so good data is never overwritten by a blank profile. Receipts
--     return NotProcessedYet until a later session loads properly.
--   * Saves use UpdateAsync and verify the lock before writing.
--   * In Studio, DataStores are skipped unless Config.Dev.SaveInStudio (memory profile).

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Progression = require(Shared:WaitForChild("Progression"))
local ProfileRules = require(Shared:WaitForChild("Logic"):WaitForChild("ProfileRules"))

export type Session = {
	Player: Player,
	Profile: ProfileRules.Profile,
	State: string, -- "Loading" | "Loaded" | "Failed" | "Memory"
	Persist: boolean,
	LockLost: boolean,
	Saving: boolean,
	Released: boolean,
	LoadedEvent: BindableEvent,
}

local DataService = {}

local ctx: any
local store: DataStore? = nil
local boards: { [string]: OrderedDataStore } = {}
local boardCache: { [string]: { { UserId: number, Name: string, Value: number } } } = { Wins = {}, XP = {} }
local names: { [number]: string } = {}
local sessions: { [Player]: Session } = {}

local function key(userId: number): string
	return "u_" .. userId
end

local function usePersistence(): boolean
	if ctx.IsStudio and not Config.Dev.SaveInStudio then
		return false
	end
	return store ~= nil
end

function DataService.Init(c)
	ctx = c
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable:", result)
	end
	for _, b in { "Wins", "XP" } do
		local okb, ods = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.Data.StoreName .. "_Board_" .. b)
		end)
		if okb then
			boards[b] = ods
		end
	end
	ctx.Util.Connect("SetSetting", "Lobby", function(player: Player, key: any, value: any)
		local s = sessions[player]
		if s and ProfileRules.SetSetting(s.Profile, key, value) then
			DataService.Push(player)
		end
	end)
	ctx.Util.OnPlayerAdded(DataService._onJoin)
	ctx.Util.OnPlayerRemoving(DataService._onLeave)
	game:BindToClose(DataService._onClose)
end

function DataService.Start()
	if ctx.Mode == "Lobby" and usePersistence() then
		task.spawn(function()
			while true do
				DataService._refreshBoards()
				task.wait(120)
			end
		end)
	end
	while true do
		task.wait(Config.Data.AutosaveInterval)
		for p, s in sessions do
			if s.State == "Loaded" and not s.Released then
				task.spawn(DataService.Save, p, false)
			end
		end
	end
end

-- Loading ------------------------------------------------------------------------------

local function tryLoad(userId: number): (string, any)
	-- returns "ok", profileData | "locked", nil | "error", message
	local now = os.time()
	local lockedBy: string? = nil
	local captured: any = nil
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key(userId), function(old)
			-- The transform may run more than once; the last run is what commits.
			lockedBy = nil
			local rec = if type(old) == "table" then old else {}
			local lock = rec.Lock
			if type(lock) == "table" and lock.JobId ~= game.JobId and type(lock.Time) == "number"
				and now - lock.Time < Config.Data.SessionLockTimeout then
				lockedBy = lock.JobId
				return nil -- abort write
			end
			rec.Lock = { JobId = game.JobId, Time = now }
			captured = rec.Profile
			return rec
		end)
	end)
	if not ok then
		return "error", err
	end
	if lockedBy then
		return "locked", nil
	end
	return "ok", captured
end

function DataService._onJoin(player: Player)
	local s: Session = {
		Player = player,
		Profile = ProfileRules.New(),
		State = "Loading",
		Persist = usePersistence(),
		LockLost = false,
		Saving = false,
		Released = false,
		LoadedEvent = Instance.new("BindableEvent"),
	}
	sessions[player] = s
	player:SetAttribute("DataState", "Loading")

	if not s.Persist then
		s.State = "Memory"
		if ctx.IsStudio then
			-- A little starting currency in Studio so the shop can be tested.
			s.Profile.Diamonds = 300
			s.Profile.Coins = 20000
		end
	else
		local attempt = 0
		local result, data
		repeat
			attempt += 1
			result, data = tryLoad(player.UserId)
			if result == "ok" then
				break
			end
			if result == "error" then
				warn(string.format("[DataService] load error for %d (attempt %d): %s", player.UserId, attempt, tostring(data)))
			end
			-- Locks are released by the previous server on leave; teleports take a few seconds.
			task.wait(math.min(2 + attempt * 2, 10))
		until attempt >= Config.Data.LoadRetries or player.Parent == nil
		if result == "ok" then
			s.Profile = ProfileRules.Reconcile(data)
			s.State = "Loaded"
		else
			s.State = "Failed"
			warn("[DataService] profile load failed; running without saving for", player.UserId)
		end
	end

	if player.Parent == nil then
		-- Left while loading: release the lock we might hold.
		if s.State == "Loaded" then
			DataService.Save(player, true)
		end
		sessions[player] = nil
		return
	end
	player:SetAttribute("DataState", s.State)
	s.LoadedEvent:Fire()
	DataService.Push(player)
	if s.State == "Failed" then
		ctx.Util.Notify(player, "Your saved data couldn't be loaded. Progress this session won't be saved. Try rejoining later.", "error")
	end
end

-- Returns the session once loading finished (or nil if the player left).
function DataService.WaitFor(player: Player, timeout: number?): Session?
	local s = sessions[player]
	local deadline = os.clock() + (timeout or 60)
	while s == nil and player.Parent and os.clock() < deadline do
		task.wait(0.2)
		s = sessions[player]
	end
	if not s then
		return nil
	end
	if s.State == "Loading" then
		local done = false
		local conn = s.LoadedEvent.Event:Once(function()
			done = true
		end)
		while not done and player.Parent and os.clock() < deadline do
			task.wait(0.1)
		end
		conn:Disconnect()
	end
	return if s.State ~= "Loading" then s else nil
end

function DataService.Get(player: Player): Session?
	return sessions[player]
end

-- True when changes to this profile will be durable (or deliberately in-memory in Studio).
function DataService.CanGrant(player: Player): boolean
	local s = sessions[player]
	return s ~= nil and (s.State == "Loaded" or s.State == "Memory") and not s.LockLost and not s.Released
end

-- Saving ---------------------------------------------------------------------------------

-- Returns true if the profile is durably stored (or in memory mode).
function DataService.Save(player: Player, release: boolean): boolean
	local s = sessions[player]
	if not s then
		return false
	end
	if s.State == "Memory" then
		return true
	end
	if s.State ~= "Loaded" or s.LockLost then
		return false
	end
	while s.Saving do
		task.wait(0.1)
	end
	s.Saving = true
	local snapshot = HttpService:JSONDecode(HttpService:JSONEncode(s.Profile))
	local success = false
	for attempt = 1, 3 do
		local lost = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key(player.UserId), function(old)
				local rec = if type(old) == "table" then old else {}
				local lock = rec.Lock
				if type(lock) == "table" and lock.JobId ~= game.JobId then
					lost = true
					return nil
				end
				rec.Profile = snapshot
				rec.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
				return rec
			end)
		end)
		if ok and lost then
			s.LockLost = true
			warn("[DataService] session lock lost for", player.UserId, "- not overwriting")
			break
		elseif ok then
			success = true
			break
		else
			warn(string.format("[DataService] save failed for %d (attempt %d): %s", player.UserId, attempt, tostring(err)))
			task.wait(attempt)
		end
	end
	s.Saving = false
	if release and success then
		s.Released = true
	end
	return success
end

function DataService._onLeave(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	if s.State == "Loaded" then
		DataService.Save(player, true)
	end
	sessions[player] = nil
end

function DataService._onClose()
	local pending = 0
	for p, s in sessions do
		if s.State == "Loaded" and not s.Released then
			pending += 1
			task.spawn(function()
				DataService.Save(p, true)
				pending -= 1
			end)
		end
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.2)
	end
end

-- Client view ---------------------------------------------------------------------------

function DataService.Push(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	local p = s.Profile
	local now = os.time()
	local level, into, need = Progression.LevelFromXP(p.XP)
	local week = Progression.WeekNumber(now)
	local weekly = if p.Weekly.Week == week then p.Weekly else { Matches = 0, Wins = 0, Claimed = false }
	local canDaily = ProfileRules.CanClaimDaily(p, now)
	local nextStreak = if p.Daily.Day == Progression.DayNumber(now) - 1 then p.Daily.Streak + 1 else 1
	Net.FireClient("ProfileSync", player, {
		Diamonds = p.Diamonds,
		Coins = p.Coins,
		XP = p.XP,
		Level = level,
		LevelInto = into,
		LevelNeed = need,
		Class = p.Class,
		OwnedClasses = p.OwnedClasses,
		Perk = p.Perk or false,
		OwnedPerks = p.OwnedPerks,
		Cosmetics = p.Cosmetics,
		Wearing = p.Wearing,
		Credits = p.Credits,
		Wins = p.Wins,
		Matches = p.Matches,
		Kills = p.Kills,
		Eliminations = p.Eliminations,
		Daily = { CanClaim = canDaily, Streak = p.Daily.Streak, Amount = Progression.DailyCoins(if canDaily then nextStreak else p.Daily.Streak + 1) },
		Weekly = {
			Matches = weekly.Matches,
			Wins = weekly.Wins,
			Need = Progression.WeeklyMatches,
			Claimed = weekly.Claimed,
			CanClaim = ProfileRules.CanClaimWeekly(p, now),
			Amount = Progression.WeeklyCoins(weekly.Wins),
		},
		Settings = p.Settings,
		State = s.State,
	})
	player:SetAttribute("Level", level)
	ctx.CosmeticService.Apply(player)
end

-- Leaderboards (OrderedDataStore; every call is pcall-guarded) ----------------------------

function DataService.PostLeaderboards(player: Player)
	local s = sessions[player]
	if not s or s.State ~= "Loaded" then
		return
	end
	for b, value in { Wins = s.Profile.Wins, XP = s.Profile.XP } do
		local ods = boards[b]
		if ods and value > 0 then
			local ok, err = pcall(function()
				ods:SetAsync(key(player.UserId), math.floor(value))
			end)
			if not ok then
				warn("[DataService] leaderboard write failed:", err)
			end
		end
	end
end

function DataService._refreshBoards()
	for b, ods in boards do
		local ok, pages = pcall(function()
			return ods:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			local list = {}
			for _, entry in pages:GetCurrentPage() do
				local uid = tonumber(string.sub(entry.key, 3))
				if uid then
					if not names[uid] then
						local okn, n = pcall(function()
							return game:GetService("Players"):GetNameFromUserIdAsync(uid)
						end)
						names[uid] = if okn then n else "Player " .. uid
					end
					table.insert(list, { UserId = uid, Name = names[uid], Value = entry.value })
				end
			end
			boardCache[b] = list
		end
	end
end

-- Top 10 lists (cached; empty in Studio memory mode).
function DataService.Boards(): { [string]: { { UserId: number, Name: string, Value: number } } }
	return boardCache
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="879">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Studio-only developer commands (never active in live servers: ctx.DevEnabled
-- requires RunService:IsStudio()). Used by the DEV panel on the client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))

local DevService = {}

local ctx: any

function DevService.Init(c)
	ctx = c
	if not ctx.DevEnabled then
		return
	end
	ctx.Util.Connect("DevCommand", "Default", DevService._onCommand)
end

function DevService._onCommand(p: Player, cmd: any, arg: any)
	if not ctx.DevEnabled or type(cmd) ~= "string" then
		return
	end
	local M = ctx.MatchService
	if cmd == "StartMatch" then
		if M.Active then
			return
		end
		local assignment = {}
		local t = 0
		for _, pl in Players:GetPlayers() do
			t = (t % 4) + 1
			assignment[pl] = t
		end
		task.spawn(M.Begin, assignment, nil)
	elseif cmd == "SkipPhase" then
		M.SkipPhase()
	elseif cmd == "GiveResources" then
		for _, id in { "Stick", "Stone", "Wood", "Plant", "Leather", "Rope", "Scrap", "Iron", "Coal" } do
			ctx.InventoryService.AddResource(p, id, 20)
		end
	elseif cmd == "GiveItem" and type(arg) == "string" and Items[arg] then
		local def = Items[arg]
		local n = if def.Kind == "Ammo" then 20 elseif def.Kind == "Consumable" then 3 elseif def.Kind == "Resource" then 10 else 1
		local _, displaced = ctx.InventoryService.Give(p, arg, n)
		if displaced then
			local root = ctx.Util.Root(p)
			if root then
				ctx.InventoryService.SpawnPickup(displaced.Id, 1, root.Position + Vector3.new(3, 0, 0), displaced)
			end
		end
	elseif cmd == "FillCanteen" then
		local inv = ctx.InventoryService.Get(p)
		local st = inv and inv.Slots.Utility
		if st and st.Id == "Canteen" then
			st.Filled = true
			ctx.InventoryService.Sync(p)
		end
	elseif cmd == "BenchLevel" and type(arg) == "number" then
		ctx.CampService.SetLevel(ctx.Util.Team(p), math.clamp(math.floor(arg), 1, 5))
		ctx.CraftService.Push(p)
	elseif cmd == "Extinguish" and type(arg) == "number" then
		M.ExtinguishFire(math.clamp(math.floor(arg), 1, 4), nil)
	elseif cmd == "SpawnAnimal" and type(arg) == "string" and ctx.WildlifeService.Species[arg] then
		local root = ctx.Util.Root(p)
		if root then
			ctx.WildlifeService._spawn(arg, root.Position + root.CFrame.LookVector * 30)
		end
	elseif cmd == "DropPackage" then
		ctx.LootService._drop({ Source = "Free" })
	elseif cmd == "Damage" then
		ctx.CombatService.DamagePlayer(p, 25, { Kind = "Environment" })
	elseif cmd == "Kill" then
		local hum = ctx.Util.Humanoid(p)
		if hum then
			hum.Health = 0
		end
	elseif cmd == "Diamonds" then
		local s = ctx.DataService.Get(p)
		if s then
			s.Profile.Diamonds += 100
			ctx.DataService.Push(p)
		end
	elseif cmd == "CompleteChallenges" then
		local s = ctx.DataService.Get(p)
		if s then
			for _, stat in { "DistanceTravelled", "CratesOpened", "AnimalsKilled", "EnemyWallsScaled", "HealthRepaired", "LongArrowHits" } do
				s.Profile.Stats[stat] = 999999
			end
			ctx.DataService.Push(p)
		end
	elseif cmd == "EndMatch" then
		if M.Active then
			M.End(ctx.Util.Team(p))
		end
	end
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="880">
          <Properties>
            <string name="Name">GatherService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Resource nodes, driven by shared/Resources (balance) and
-- Logic/ResourceRules (state machine). One service handles every node type:
--   Trees   (axe hits or the Chop prompt): Healthy -> Damaged (notch shows,
--           trunk shudders) -> Felled (top tips over, anchored tween) ->
--           Stump -> Respawning (sapling grows back) -> Healthy.
--   Harvest (hand prompt): gathers until exhausted; the model's `Yield` parts
--           hide, then return after the respawn time.
-- Respawns wait until no character/structure/animal stands on the spot.
-- Items that don't fit in the pack spill as pickups at the node, so a felled
-- tree's bonus wood is never lost.
-- Model part roles are documented in docs/OVERHAUL.md.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))
local Net = require(Shared:WaitForChild("Net"))
local Resources = require(Shared:WaitForChild("Resources"))
local Logic = Shared:WaitForChild("Logic")
local ResourceRules = require(Logic:WaitForChild("ResourceRules"))
local InventoryModel = require(Logic:WaitForChild("InventoryModel"))
local Rng = require(Logic:WaitForChild("Rng"))
local Models = Shared:WaitForChild("Models")
local Flora = require(Models:WaitForChild("Flora"))
local Skins = require(Models:WaitForChild("Skins"))

local GatherService = {}

type Node = {
	Id: number,
	Def: Resources.Def,
	S: ResourceRules.State,
	Model: Model,
	Pos: Vector3,
	Prompt: ProximityPrompt?,
	Top: Model?, -- trees: everything above the stump
	TopHome: CFrame?, -- Top pivot when standing
	Yield: { BasePart }, -- harvest nodes: parts hidden while exhausted
	Notches: { BasePart },
	Anim: number, -- bumps to cancel running tweens
}

local ctx: any
local nodes: { Node } = {}
local byModel: { [Model]: Node } = {}
local rng = Rng.new(os.time())

function GatherService.Init(c)
	ctx = c
	ctx.MatchService.On("MatchStarting", GatherService._build)
	ctx.MatchService.On("MatchCleanup", function()
		nodes = {}
		byModel = {}
	end)
	ctx.ChannelService.OnPrompt("Gather", GatherService._onGatherPrompt)
end

function GatherService.Start()
	while true do
		task.wait(Resources.TickInterval)
		if ctx.MatchService.Active then
			local t = os.clock()
			for _, n in nodes do
				if n.S.State ~= "Healthy" and n.S.State ~= "Damaged" then
					local entered = ResourceRules.Advance(n.Def, n.S, t, function()
						return GatherService._spotClear(n)
					end)
					if entered then
						GatherService._show(n, entered)
					end
				end
			end
		end
	end
end

-- Building ---------------------------------------------------------------------------------

local TIER_NAMES = { "Crude", "Stone", "Iron", "Steel" }

-- "Stone Axe" style name of the weakest tool that works on a node.
local function toolNeed(def: Resources.Def): string
	return (TIER_NAMES[def.MinTier or 1] or "") .. " " .. def.RequiredTool
end

local function promptText(def: Resources.Def): (string, string)
	if def.Kind == "Tree" then
		return "Chop (" .. toolNeed(def) .. "+)", def.Label
	elseif def.RequiredTool == "Pickaxe" then
		return "Mine (" .. toolNeed(def) .. "+)", def.Label
	elseif def.PerHit.Berries or def.PerHit.Mushroom then
		return "Pick", def.Label
	end
	return "Gather", def.Label
end

function GatherService._build(map: any)
	local folder = Instance.new("Folder")
	folder.Name = "Resources"
	folder.Parent = map.Folder
	local O = map.Origin
	local modelRng = Random.new(map.Seed)
	for i, nd in map.Layout.Nodes do
		local def = Resources.Get(nd.Type)
		if not def then
			warn("[GatherService] unknown resource type " .. tostring(nd.Type))
			continue
		end
		local x, z = nd.X + O.X, nd.Z + O.Z
		local y = ctx.WorldService.GroundY(x, z) - 0.15
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, (i * 2.399) % 6.283, 0)
		local m: Model
		if def.Model == "ResourceTree" then
			m = Flora.ResourceTree(cf, modelRng, def.ModelArgs[1], nd.Species or "Pine", folder)
		else
			m = Flora[def.Model](cf, modelRng, folder)
		end
		m.Name = def.Id
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		m:SetAttribute("Node", def.Id)
		local node: Node = {
			Id = i,
			Def = def,
			S = ResourceRules.New(def),
			Model = m,
			Pos = Vector3.new(x, y, z),
			Prompt = nil,
			Top = m:FindFirstChild("Top") :: Model?,
			TopHome = nil,
			Yield = {},
			Notches = {},
			Anim = 0,
		}
		if node.Top then
			node.TopHome = node.Top:GetPivot()
		end
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d:SetAttribute("BaseT", d.Transparency)
				if d.Name == "Notch" then
					table.insert(node.Notches, d)
				elseif d:GetAttribute("Yield") then
					table.insert(node.Yield, d)
				end
			end
		end
		if def.Kind == "Harvest" and #node.Yield == 0 then
			-- No marked yield parts: the whole model (except Root) is the yield.
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") and d ~= m.PrimaryPart then
					table.insert(node.Yield, d)
				end
			end
		end
		local action, object = promptText(def)
		local p = ctx.ChannelService.MakePrompt(m.PrimaryPart, "Gather", action, object, def.Range)
		if def.RequiredTool ~= "Hand" then
			p:SetAttribute("NeedsTool", def.RequiredTool)
			p:SetAttribute("MinTier", def.MinTier or 1)
			m:SetAttribute("NeedsTool", def.RequiredTool)
		end
		p:SetAttribute("Rarity", def.Rarity)
		node.Prompt = p
		table.insert(nodes, node)
		byModel[m] = node
		if i % 40 == 0 then
			task.wait()
		end
	end
end

function GatherService.FromPart(part: Instance): Node?
	local m = part:FindFirstAncestorOfClass("Model")
	while m do
		local n = byModel[m]
		if n then
			return if ResourceRules.Available(n.S) then n else nil
		end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- Nodes of one resource type (for UI/debug/tests).
function GatherService.Count(): number
	return #nodes
end

-- Visuals ------------------------------------------------------------------------------------

local function setParts(list: { BasePart }, visible: boolean, collide: boolean?)
	for _, d in list do
		d.Transparency = if visible then (d:GetAttribute("BaseT") :: number? or 0) else 1
		if collide ~= nil and d.CanQuery then
			d.CanCollide = collide and visible
		end
	end
end

local function topParts(n: Node): { BasePart }
	local out = {}
	if n.Top then
		for _, d in n.Top:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(out, d)
			end
		end
	end
	return out
end

-- Remembers which Top parts collide so regrowth can restore them.
local function restoreTop(n: Node, visible: boolean)
	for _, d in topParts(n) do
		if d:GetAttribute("BaseCollide") == nil then
			d:SetAttribute("BaseCollide", d.CanCollide)
		end
		d.Transparency = if visible then (d:GetAttribute("BaseT") :: number? or 0) else 1
		d.CanCollide = visible and d:GetAttribute("BaseCollide") == true
		d.CanQuery = visible and d:GetAttribute("BaseCollide") == true
	end
end

-- Drives a model's pivot over time with an easing curve (anchored parts, no physics).
local function pivotTween(n: Node, model: Model, from: CFrame, to: CFrame, duration: number, style: Enum.EasingStyle, dir: Enum.EasingDirection)
	n.Anim += 1
	local token = n.Anim
	task.spawn(function()
		local t0 = os.clock()
		while true do
			local a = math.clamp((os.clock() - t0) / duration, 0, 1)
			if token ~= n.Anim or not model.Parent then
				return
			end
			model:PivotTo(from:Lerp(to, TweenService:GetValue(a, style, dir)))
			if a >= 1 then
				return
			end
			task.wait()
		end
	end)
end

local function shudder(n: Node, from: Vector3)
	local top, home = n.Top, n.TopHome
	if not top or not home or n.S.State ~= "Damaged" then
		return
	end
	-- lean a couple of degrees away from the hit, then settle
	local away = (home.Position - from) * Vector3.new(1, 0, 1)
	if away.Magnitude < 0.01 then
		return
	end
	local axis = away.Unit:Cross(Vector3.yAxis)
	local lean = CFrame.fromAxisAngle(axis, math.rad(-2.5))
	local leaned = CFrame.new(home.Position) * lean * home.Rotation
	n.Anim += 1
	local token = n.Anim
	task.spawn(function()
		top:PivotTo(leaned)
		task.wait(0.08)
		if token == n.Anim and n.S.State == "Damaged" then
			top:PivotTo(home)
		end
	end)
end

local function fell(n: Node, from: Vector3)
	local top, home = n.Top, n.TopHome
	if not top or not home then
		return
	end
	for _, d in topParts(n) do
		if d:GetAttribute("BaseCollide") == nil then
			d:SetAttribute("BaseCollide", d.CanCollide)
		end
		d.CanCollide = false -- a falling tree never shoves players
	end
	local away = (home.Position - from) * Vector3.new(1, 0, 1)
	if away.Magnitude < 0.01 then
		away = home.LookVector * Vector3.new(1, 0, 1)
	end
	local axis = away.Unit:Cross(Vector3.yAxis)
	local down = CFrame.new(home.Position) * CFrame.fromAxisAngle(axis, math.rad(-86)) * home.Rotation
	pivotTween(n, top, home, down, n.Def.FellTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	ctx.Util.PlaySound("TreeCreak", n.Model.PrimaryPart)
	task.delay(n.Def.FellTime, function()
		if n.S.State == "Felled" or n.S.State == "Stump" then
			ctx.Util.PlaySound("TreeFall", n.Model.PrimaryPart)
			local landing = home.Position + away.Unit * 10
			Net.FireAll("Fx", "ResourceBreak", { Pos = landing, Kind = n.Def.Effects.Break, Big = true })
		end
	end)
end

-- Applies the look for a state the node just entered.
function GatherService._show(n: Node, state: string, from: Vector3?)
	local def = n.Def
	n.Model:SetAttribute("State", state)
	if n.Prompt then
		n.Prompt.Enabled = state == "Healthy" or state == "Damaged"
	end
	if def.Kind == "Tree" then
		-- mesh-pack stump (Skins): visible whenever the tree isn't standing
		Skins.SetTagged(n.Model, "SkinStump", state ~= "Healthy" and state ~= "Damaged")
		if state == "Healthy" then
			n.Anim += 1
			if n.Top and n.TopHome then
				local top, home = n.Top, n.TopHome
				pcall(function()
					top:ScaleTo(1)
				end)
				top:PivotTo(home)
			end
			restoreTop(n, true)
			setParts(n.Notches, false)
		elseif state == "Damaged" then
			setParts(n.Notches, true)
		elseif state == "Felled" then
			setParts(n.Notches, false)
			fell(n, from or n.Pos)
		elseif state == "Stump" then
			-- The felled trunk lies on the ground for a moment, then fades away.
			n.Anim += 1
			local token = n.Anim
			task.spawn(function()
				task.wait(2.5)
				local parts = topParts(n)
				for step = 1, 10 do
					if token ~= n.Anim then
						return
					end
					for _, d in parts do
						local base = d:GetAttribute("BaseT") :: number? or 0
						d.Transparency = base + (1 - base) * step / 10
					end
					task.wait(0.08)
				end
				if token == n.Anim then
					restoreTop(n, false)
				end
			end)
		elseif state == "Respawning" then
			-- Grow back from a sapling around the hinge (anchored scale-up).
			if n.Top and n.TopHome then
				n.Anim += 1
				local token = n.Anim
				local top, home = n.Top, n.TopHome
				top:PivotTo(home)
				pcall(function()
					top:ScaleTo(0.2)
				end)
				restoreTop(n, true)
				for _, d in topParts(n) do
					d.CanCollide = false -- saplings don't block
				end
				task.spawn(function()
					local t0 = os.clock()
					while token == n.Anim and top.Parent do
						local a = math.clamp((os.clock() - t0) / def.GrowTime, 0, 1)
						pcall(function()
							top:ScaleTo(0.2 + 0.8 * TweenService:GetValue(a, Enum.EasingStyle.Sine, Enum.EasingDirection.Out))
						end)
						if a >= 1 then
							break
						end
						task.wait(0.1)
					end
				end)
			end
		end
	else
		if state == "Healthy" then
			setParts(n.Yield, true, true)
		elseif state == "Exhausted" then
			setParts(n.Yield, false, false)
		elseif state == "Respawning" then
			-- fade the yield back in over the grow time
			for _, d in n.Yield do
				d.Transparency = 0.75
			end
		end
	end
end

-- Spot check before respawning -----------------------------------------------------------------

function GatherService._spotClear(n: Node): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { n.Model, workspace.Terrain }
	local parts = workspace:GetPartBoundsInRadius(n.Pos + Vector3.new(0, 2, 0), Resources.RespawnClearance + n.Def.Placement.Radius * 0.5, params)
	for _, part in parts do
		if ctx.Util.PlayerFromPart(part) or ctx.BuildService.FromPart(part) or ctx.WildlifeService.FromPart(part) then
			return false
		end
	end
	return true
end

-- Hits -----------------------------------------------------------------------------------------

-- Grants items; anything that doesn't fit spills as a pickup at the node.
local function grant(p: Player, n: Node, items: { [string]: number }): { string }
	local lines = {}
	for id, count in items do
		local added = ctx.InventoryService.AddResource(p, id, count)
		if added > 0 then
			table.insert(lines, string.format("+%d %s", added, Items[id] and Items[id].Name or id))
		end
		if added < count then
			local root = ctx.Util.Root(p)
			local at = if root then n.Pos:Lerp(root.Position, 0.5) else n.Pos
			ctx.InventoryService.SpawnPickup(id, count - added, at + Vector3.new(0, 1, 0))
		end
	end
	return lines
end

-- Applies one hit/gather. `toolType`/`power` from the equipped item (hand = nil / HandPower).
function GatherService._apply(p: Player, n: Node, toolType: string?, power: number, tier: number?): boolean
	local def = n.Def
	if not ResourceRules.ToolOk(def, toolType, tier) then
		ctx.Util.Notify(p, "You need a " .. toolNeed(def) .. " or better for that.", "warn")
		return false
	end
	local inv = ctx.InventoryService.Get(p)
	if inv then
		local room = false
		for id in def.Yield or def.PerHit do
			if InventoryModel.SpaceFor(inv, id) > 0 then
				room = true
			end
		end
		if not room then
			ctx.Util.Notify(p, "Your pack is full. Deposit at your storage or craft a bigger backpack.", "warn")
			return false
		end
	end
	local r = ResourceRules.Hit(def, n.S, toolType, power, os.clock(), rng, tier)
	if not r.Ok then
		return false
	end
	local root = ctx.Util.Root(p)
	local from = if root then root.Position else n.Pos
	local lines = grant(p, n, r.Items)
	if #lines > 0 then
		ctx.Util.Notify(p, table.concat(lines, "  "), "gain")
	end
	ctx.Util.PlaySound(if r.Finished and def.Kind == "Tree" then "ChopHeavy" else def.Sounds.Hit, n.Model.PrimaryPart)
	local hitPos = n.Pos + Vector3.new(0, if def.Kind == "Tree" then 2.5 else 1, 0)
	-- non-tree nodes (rocks, bushes, ore) get a quick client-side jolt; trees shudder server-side
	Net.FireAll("Fx", "ResourceHit", { Pos = hitPos, From = from, Kind = def.Effects.Hit, Model = if def.Kind ~= "Tree" then n.Model else nil, Last = r.Finished })
	Net.FireClient("HitFeedback", p, "Resource", r.Dealt)
	n.Model:SetAttribute("Health", n.S.Health)
	n.Model:SetAttribute("MaxHealth", n.S.Max)
	if r.Finished then
		if def.Kind == "Harvest" then
			Net.FireAll("Fx", "ResourceBreak", { Pos = hitPos, Kind = def.Effects.Break })
		end
		GatherService._show(n, n.S.State, from)
		ctx.PowerupService.OnPickup(p, def.Id)
	else
		GatherService._show(n, n.S.State, from)
		if def.Kind == "Tree" then
			shudder(n, from)
		end
	end
	return true
end

local function equippedTool(p: Player): (string?, number, string?, string?, number?)
	local id, slot = ctx.InventoryService.EquippedItem(p)
	local def = id and Items[id]
	if def and def.ToolType then
		return def.ToolType, (def.ToolPower or 1) * ctx.PowerupService.ToolSpeedMult(p, def.ToolType), id, slot, def.ToolTier
	end
	return nil, Resources.HandPower, id, slot, nil
end

-- Best carried tool slot for a node (right type, high enough tier), or nil.
local function bestToolSlot(p: Player, def: Resources.Def): string?
	local inv = ctx.InventoryService.Get(p)
	if not inv then
		return nil
	end
	local best, bestTier = nil, 0
	for _, slot in InventoryModel.SlotNames do
		local st = inv.Slots[slot]
		local tdef = st and Items[st.Id]
		if tdef and tdef.ToolType == def.RequiredTool and (tdef.ToolTier or 1) >= (def.MinTier or 1) and (tdef.ToolTier or 1) > bestTier then
			best, bestTier = slot, tdef.ToolTier or 1
		end
	end
	return best
end

-- Melee swing on a node (from CombatService). Returns true if it counted (wears the tool).
function GatherService.Hit(p: Player, n: Node, itemId: string): boolean
	if not ResourceRules.Available(n.S) or n.Def.RequiredTool == "Hand" then
		return false -- hand nodes use their prompt
	end
	local def = Items[itemId]
	local toolType = def and def.ToolType
	if not toolType then
		ctx.Util.Notify(p, "You need a " .. toolNeed(n.Def) .. " or better for that.", "warn")
		return false
	end
	local power = (def.ToolPower or 1) * ctx.PowerupService.ToolSpeedMult(p, toolType)
	return GatherService._apply(p, n, toolType, power, def.ToolTier)
end

function GatherService._onGatherPrompt(p: Player, prompt: ProximityPrompt)
	local m = prompt:FindFirstAncestorOfClass("Model")
	local n = m and byModel[m]
	if not n or not ResourceRules.Available(n.S) or not ctx.Util.IsAlive(p) or not p:GetAttribute("InMatch") then
		return
	end
	local def = n.Def
	if def.RequiredTool ~= "Hand" then
		-- Prompt chopping: auto-equip a matching tool from the Tool slot, then channel one chop.
		local toolType, _, _, _, tier = equippedTool(p)
		if not ResourceRules.ToolOk(def, toolType, tier) then
			local slot = bestToolSlot(p, def)
			if slot then
				ctx.InventoryService._onEquip(p, slot)
			else
				ctx.Util.Notify(p, "You need a " .. toolNeed(def) .. " or better for that.", "warn")
				return
			end
		end
	end
	local duration = def.HarvestTime / ctx.PowerupService.GatherMult(p)
	ctx.ChannelService.Begin(p, {
		Kind = "Gather",
		Label = if def.Kind == "Tree" then "Chopping" elseif def.RequiredTool == "Pickaxe" then "Mining" elseif def.PerHit.Berries or def.PerHit.Mushroom then "Picking" else "Gathering",
		Duration = duration,
		Range = def.Range,
		InterruptOnDamage = true,
		Action = if def.Kind == "Tree" then "Chop" elseif def.RequiredTool == "Pickaxe" then "Mine" else "Gather",
		Position = function()
			return if ResourceRules.Available(n.S) then n.Pos else nil
		end,
		OnComplete = function()
			if not ResourceRules.Available(n.S) or not ctx.Util.IsAlive(p) then
				return
			end
			local toolType, power, _, slot, tier = equippedTool(p)
			if def.RequiredTool == "Hand" then
				toolType, power, tier = nil, Resources.HandPower, nil
			end
			if GatherService._apply(p, n, toolType, power, tier) and def.RequiredTool ~= "Hand" and slot then
				ctx.InventoryService.Wear(p, slot, ctx.PowerupService.ToolWear(p, toolType))
			end
		end,
	})
end

return GatherService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="881">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Per-player match inventories, world pickups, supply bags, held-item visuals,
-- canteens and bandages. Inventories only exist while a player is in a match.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Resources = require(Shared:WaitForChild("Resources"))
local Logic = Shared:WaitForChild("Logic")
local InventoryModel = require(Logic:WaitForChild("InventoryModel"))
local Models = Shared:WaitForChild("Models")
local ItemModels = require(Models:WaitForChild("ItemModels"))
local Build = require(Models:WaitForChild("Build"))

local InventoryService = {}

local ctx: any
local invs: { [Player]: InventoryModel.Inventory } = {}
local pickups: { [Model]: { Id: string, Count: number, Stack: any?, Expires: number } } = {}
local bags: { [Model]: { Items: { [string]: number }, Expires: number } } = {}
local pickupFolder: Folder? = nil

local function folder(): Folder
	if pickupFolder and pickupFolder.Parent then
		return pickupFolder
	end
	local match = workspace:FindFirstChild("Match")
	pickupFolder = ctx.Util.Folder("Pickups", match or workspace)
	return pickupFolder :: Folder
end

function InventoryService.Init(c)
	ctx = c
	ctx.MatchService.On("PlayerJoinedMatch", function(p: Player)
		local inv = InventoryModel.New(Config.Inventory.PackSlots, Config.Inventory.BandageMax, Config.Inventory.AmmoMax)
		inv.BonusSlots = ctx.PowerupService.BonusSlots(p)
		InventoryModel.SetPackSlots(inv, nil)
		invs[p] = inv
		InventoryService._deliverBandageCredits(p)
		InventoryService.Sync(p)
	end)
	ctx.MatchService.On("MatchCleanup", function()
		invs = {}
		pickups = {}
		bags = {}
		pickupFolder = nil
	end)
	ctx.Util.OnPlayerRemoving(function(p: Player)
		local inv = invs[p]
		if inv and ctx.MatchService.Active then
			local root = ctx.Util.Root(p)
			if root then
				InventoryService.DropOnDeath(p, root.Position)
			end
		end
		invs[p] = nil
	end)

	ctx.Util.Connect("Equip", "Default", InventoryService._onEquip)
	ctx.Util.Connect("SwapWeapons", "Default", function(p: Player)
		local inv = invs[p]
		if inv and InventoryModel.Swap(inv, "Weapon1", "Weapon2") then
			InventoryService.Sync(p)
		end
	end)
	ctx.Util.Connect("DropItem", "Interact", InventoryService._onDrop)
	ctx.Util.Connect("UseBandage", "Interact", InventoryService._onBandage)
	ctx.Util.Connect("Eat", "Interact", InventoryService._onEat)

	ctx.ChannelService.OnPrompt("Pickup", InventoryService._onPickupPrompt)
	ctx.ChannelService.OnPrompt("Bag", InventoryService._onBagPrompt)
	ctx.ChannelService.OnPrompt("Fill", InventoryService._onFillPrompt)
	ctx.MatchService.On("MatchStarting", function(map)
		for _, w in map.WaterPoints do
			local pr = ctx.ChannelService.MakePrompt(w.Part, "Fill", "Fill Canteen", "Stream", Config.Canteen.FillRange)
			pr:SetAttribute("NeedsCanteen", true)
		end
	end)

	ctx.PurchaseService.OnGranted("Bandage", function(p: Player)
		if invs[p] then
			InventoryService._deliverBandageCredits(p)
		else
			ctx.Util.Notify(p, "Bandage purchased! It's stored and will be delivered in your next match.", "success")
		end
	end)
end

function InventoryService.Start()
	-- Despawn sweep
	while true do
		task.wait(5)
		local t = os.clock()
		for m, data in pickups do
			if t > data.Expires then
				pickups[m] = nil
				m:Destroy()
			end
		end
		for m, data in bags do
			if t > data.Expires then
				bags[m] = nil
				m:Destroy()
			end
		end
	end
end

function InventoryService.Get(p: Player): InventoryModel.Inventory?
	return invs[p]
end

function InventoryService.Sync(p: Player)
	local inv = invs[p]
	if not inv then
		return
	end
	Net.FireClient("InventorySync", p, InventoryModel.Snapshot(inv))
	p:SetAttribute("Carry", InventoryModel.ResourceTotal(inv))
	InventoryService._refreshHeld(p)
end

-- Credits bought with Robux (or deferred) become bandages up to the pouch cap.
function InventoryService._deliverBandageCredits(p: Player)
	local inv = invs[p]
	local session = ctx.DataService.Get(p)
	if not inv or not session then
		return
	end
	local credits = session.Profile.Credits.Bandage
	if credits <= 0 then
		return
	end
	local added = InventoryModel.AddBandages(inv, credits)
	if added > 0 then
		session.Profile.Credits.Bandage -= added
		task.spawn(ctx.DataService.Save, p, false)
		ctx.DataService.Push(p)
		ctx.Util.Notify(p, string.format("+%d bandage%s delivered%s.", added, if added > 1 then "s" else "", if session.Profile.Credits.Bandage > 0 then " (the rest are stored for later)" else ""), "success")
		InventoryService.Sync(p)
	elseif credits > 0 then
		ctx.Util.Notify(p, "Bandage pouch full — your bandage is stored and will be delivered when there's room.", "info")
	end
end

-- Resources -------------------------------------------------------------------------------

function InventoryService.AddResource(p: Player, id: string, n: number): number
	local inv = invs[p]
	if not inv then
		return 0
	end
	local added = InventoryModel.AddResource(inv, id, n)
	if added < n then
		Net.FireClient("Notify", p, "Your pack is full (" .. inv.Capacity .. " slots). Deposit at your storage or craft a bigger backpack.", "warn")
	end
	if added > 0 then
		InventoryService.Sync(p)
	end
	return added
end

-- Adds any item (resource/equipment/ammo/bandage). Returns amount taken and
-- any displaced equipment stack (caller drops it).
function InventoryService.Give(p: Player, id: string, count: number, stack: any?, preferSlot: string?): (number, any?)
	local inv = invs[p]
	local def = Items[id]
	if not inv or not def then
		return 0, nil
	end
	local taken, displaced = 0, nil
	if def.Kind == "Resource" then
		taken = InventoryModel.AddResource(inv, id, count)
	elseif def.Kind == "Ammo" then
		taken = InventoryModel.AddAmmo(inv, id, count)
	elseif def.Kind == "Consumable" then
		taken = InventoryModel.AddBandages(inv, count)
	elseif def.Kind == "Backpack" then
		local old
		_, old = InventoryModel.AddEquipment(inv, "Backpack", stack or { Id = id })
		displaced = old
		taken = 1
		InventoryModel.SetPackSlots(inv, def.Slots)
		local overflow = InventoryModel.TrimToCapacity(inv)
		if next(overflow) then
			local root = ctx.Util.Root(p)
			if root then
				InventoryService.SpawnBag(overflow, root.Position + root.CFrame.LookVector * 3, Color3.fromRGB(150, 120, 80), "Overflow")
			end
		end
	elseif def.Kind == "Weapon" or def.Kind == "Tool" or def.Kind == "Utility" or def.Kind == "Armor" then
		local st = stack or { Id = id, Durability = def.Durability }
		if st.Id == "Canteen" and st.Filled == nil then
			st.Filled = false
		end
		local slot
		slot, displaced = InventoryModel.AddEquipment(inv, def.Kind, st, if def.Kind == "Armor" then def.ArmorSlot else preferSlot or inv.Equipped)
		if slot then
			taken = 1
			if def.Kind ~= "Armor" and inv.Equipped == nil then
				inv.Equipped = slot
			end
		end
	end
	if taken > 0 then
		InventoryService.Sync(p)
	end
	return taken, displaced
end

-- Pickups -----------------------------------------------------------------------------------

function InventoryService.SpawnPickup(id: string, count: number, pos: Vector3, stack: any?, lifetime: number?): Model?
	local def = Items[id]
	if not def or count <= 0 then
		return nil
	end
	local ground = ctx.WorldService.RaycastGround(pos, { folder() })
	local at = if ground then ground else pos
	local m = ItemModels.Pickup(id, count, CFrame.new(at) * CFrame.Angles(0, math.random() * 6.28, 0), folder())
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local label = if count > 1 then string.format("%s x%d", def.Name, count) else def.Name
	local pr = ctx.ChannelService.MakePrompt(m.PrimaryPart, "Pickup", "Pick up", label, Config.Inventory.PickupRange)
	pr.KeyboardKeyCode = Enum.KeyCode.F
	pr:SetAttribute("ItemId", id)
	pickups[m] = { Id = id, Count = count, Stack = stack, Expires = os.clock() + (lifetime or Config.Inventory.DropDespawn) }
	return m
end

function InventoryService._onPickupPrompt(p: Player, prompt: ProximityPrompt)
	local m = prompt:FindFirstAncestorOfClass("Model")
	local data = m and pickups[m]
	if not m or not data or not invs[p] or not ctx.Util.IsAlive(p) then
		return
	end
	if ctx.Util.DistTo(p, m:GetPivot().Position) > Config.Inventory.PickupRange + 2 then
		return
	end
	local inv = invs[p] :: InventoryModel.Inventory
	local taken, displaced = InventoryService.Give(p, data.Id, data.Count, data.Stack, inv.Equipped)
	if taken <= 0 then
		ctx.Util.Notify(p, "No room for that.", "warn")
		return
	end
	ctx.Util.PlaySound("Pickup", m.PrimaryPart)
	local pos = m:GetPivot().Position
	data.Count -= taken
	if data.Count <= 0 then
		pickups[m] = nil
		m:Destroy()
	else
		local def = Items[data.Id]
		prompt.ObjectText = string.format("%s x%d", def.Name, data.Count)
	end
	if displaced then
		InventoryService.SpawnPickup(displaced.Id, 1, pos + Vector3.new(0, 0.5, 0), displaced)
		ctx.Util.Notify(p, "Swapped: dropped " .. Items[displaced.Id].Name, "info")
	end
	ctx.PowerupService.OnPickup(p, data.Id)
end

-- Supply bags (death / leave drops) ---------------------------------------------------------

function InventoryService.DropOnDeath(p: Player, pos: Vector3)
	local inv = invs[p]
	if not inv then
		return
	end
	local dropped = InventoryModel.TakeAllResources(inv)
	if next(dropped) == nil then
		InventoryService.Sync(p)
		return
	end
	local team = ctx.Util.Team(p)
	local color = if Config.Teams[team] then Config.Teams[team].Color else Color3.new(1, 1, 1)
	InventoryService.SpawnBag(dropped, pos, color, p.DisplayName .. "'s Supplies", { p.Character :: Instance })
	InventoryService.Sync(p)
end

function InventoryService.SpawnBag(contents: { [string]: number }, pos: Vector3, color: Color3, label: string, ignore: { Instance }?): Model
	local ig = ignore or {}
	table.insert(ig, folder())
	local ground = ctx.WorldService.RaycastGround(pos, ig)
	local m = ItemModels.SupplyBag(CFrame.new(ground or pos), color, folder())
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local pr = ctx.ChannelService.MakePrompt(m.PrimaryPart, "Bag", "Loot", label, Config.Inventory.PickupRange)
	pr.KeyboardKeyCode = Enum.KeyCode.F
	bags[m] = { Items = contents, Expires = os.clock() + Config.Inventory.SupplyBagDespawn }
	return m
end

function InventoryService._onBagPrompt(p: Player, prompt: ProximityPrompt)
	local m = prompt:FindFirstAncestorOfClass("Model")
	local data = m and bags[m]
	local inv = invs[p]
	if not m or not data or not inv or not ctx.Util.IsAlive(p) then
		return
	end
	if ctx.Util.DistTo(p, m:GetPivot().Position) > Config.Inventory.PickupRange + 2 then
		return
	end
	local got = 0
	for id, n in data.Items do
		local add = InventoryModel.AddResource(inv, id, n)
		data.Items[id] = n - add
		got += add
		if data.Items[id] <= 0 then
			data.Items[id] = nil
		end
	end
	if got == 0 then
		ctx.Util.Notify(p, "Your pack is full.", "warn")
		return
	end
	ctx.Util.PlaySound("Pickup", m.PrimaryPart)
	if next(data.Items) == nil then
		bags[m] = nil
		m:Destroy()
	end
	InventoryService.Sync(p)
end

-- Equip / drop / swap ------------------------------------------------------------------------

function InventoryService._onEquip(p: Player, slot: any)
	local inv = invs[p]
	if not inv then
		return
	end
	if slot ~= nil and not (type(slot) == "string" and table.find(InventoryModel.SlotNames, slot)) then
		return
	end
	if slot ~= nil and inv.Slots[slot] == nil then
		return
	end
	if ctx.ChannelService.IsBusy(p, "Pour") then
		return -- keep the canteen in hand while pouring
	end
	InventoryModel.Equip(inv, slot)
	InventoryService.Sync(p)
end

function InventoryService.EquipUtility(p: Player)
	local inv = invs[p]
	if inv and inv.Slots.Utility then
		InventoryModel.Equip(inv, "Utility")
		InventoryService.Sync(p)
	end
end

function InventoryService._onDrop(p: Player, req: any)
	local inv = invs[p]
	if not inv or type(req) ~= "table" or not ctx.Util.IsAlive(p) then
		return
	end
	local root = ctx.Util.Root(p)
	if not root then
		return
	end
	local dropPos = root.Position + root.CFrame.LookVector * 3
	if type(req.Slot) == "string" and (table.find(InventoryModel.SlotNames, req.Slot) or InventoryModel.ArmorPiece(req.Slot) or req.Slot == "Backpack") then
		if ctx.ChannelService.IsBusy(p) then
			return
		end
		local st = InventoryModel.RemoveSlot(inv, req.Slot)
		if st then
			InventoryService.SpawnPickup(st.Id, 1, dropPos, st)
			if req.Slot == "Backpack" then
				InventoryModel.SetPackSlots(inv, nil)
				local overflow = InventoryModel.TrimToCapacity(inv)
				if next(overflow) then
					InventoryService.SpawnBag(overflow, dropPos + Vector3.new(0, 0, 2), Color3.fromRGB(150, 120, 80), "Overflow")
				end
			end
			InventoryService.Sync(p)
		end
	elseif type(req.Resource) == "string" and ctx.Util.IsInt(req.Count, 1, 100) then
		local n = InventoryModel.TakeResource(inv, req.Resource, req.Count)
		if n > 0 then
			InventoryService.SpawnPickup(req.Resource, n, dropPos)
			InventoryService.Sync(p)
		end
	end
end

-- Canteen ------------------------------------------------------------------------------------

function InventoryService.HasCanteen(p: Player): boolean
	local inv = invs[p]
	return inv ~= nil and inv.Slots.Utility ~= nil and (inv.Slots.Utility :: any).Id == "Canteen"
end

function InventoryService.HasFilledCanteen(p: Player): boolean
	local inv = invs[p]
	local st = inv and inv.Slots.Utility
	return st ~= nil and st.Id == "Canteen" and st.Filled == true
end

function InventoryService.UseCanteen(p: Player): boolean
	local inv = invs[p]
	local st = inv and inv.Slots.Utility
	if st and st.Id == "Canteen" and st.Filled then
		st.Filled = false
		InventoryService.Sync(p)
		return true
	end
	return false
end

function InventoryService._onFillPrompt(p: Player, prompt: ProximityPrompt)
	if not ctx.Util.IsAlive(p) then
		return
	end
	if not InventoryService.HasCanteen(p) then
		ctx.Util.Notify(p, "You need a canteen (craft at Workbench Tier II).", "error")
		return
	end
	if InventoryService.HasFilledCanteen(p) then
		ctx.Util.Notify(p, "Your canteen is already full.", "info")
		return
	end
	local part = prompt.Parent :: BasePart
	ctx.ChannelService.Begin(p, {
		Kind = "Fill",
		Label = "Filling canteen",
		Duration = Config.Canteen.FillTime,
		Range = Config.Canteen.FillRange,
		InterruptOnDamage = false,
		Action = "Fill",
		Position = function()
			return if part.Parent then part.Position else nil
		end,
		OnComplete = function()
			local inv = invs[p]
			local st = inv and inv.Slots.Utility
			if st and st.Id == "Canteen" then
				st.Filled = true
				InventoryService.Sync(p)
				ctx.Util.PlaySound("Fill", part)
				ctx.Util.Notify(p, "Canteen filled. Pour it on an enemy fire at night!", "success")
			end
		end,
	})
end

-- Bandages -------------------------------------------------------------------------------------

function InventoryService._onBandage(p: Player)
	InventoryService.Heal(p, "Bandage")
end

-- Timed, interruptible healing (spec: Bandage ~20, First Aid ~50, Medkit ~100).
-- Bandages come from the pouch; First Aid kits and Medkits from the pack.
function InventoryService.Heal(p: Player, itemId: string)
	local inv = invs[p]
	local spec = Config.Healing[itemId]
	if not inv or not spec or not ctx.Util.IsAlive(p) then
		return
	end
	local function have(): boolean
		local cur = invs[p]
		if not cur then
			return false
		end
		return if itemId == "Bandage" then cur.Bandages > 0 else (cur.Resources[itemId] or 0) > 0
	end
	if not have() then
		ctx.Util.Notify(p, "You don't have a " .. Items[itemId].Name .. ".", "info")
		return
	end
	local hum = ctx.Util.Humanoid(p)
	if not hum or hum.Health >= hum.MaxHealth then
		ctx.Util.Notify(p, "You're already at full health.", "info")
		return
	end
	local root = ctx.Util.Root(p)
	if not root then
		return
	end
	local start = root.Position
	ctx.ChannelService.Begin(p, {
		Kind = "Heal",
		Label = "Applying " .. Items[itemId].Name:lower(),
		Duration = spec.UseTime / ctx.PowerupService.HealSpeedMult(p),
		Range = 30, -- you can walk slowly while healing
		InterruptOnDamage = true,
		Action = "Bandage",
		Position = function()
			return start
		end,
		OnComplete = function()
			local h = ctx.Util.Humanoid(p)
			local cur = invs[p]
			if not cur or not have() or not h or h.Health <= 0 then
				return
			end
			if itemId == "Bandage" then
				cur.Bandages -= 1
			else
				InventoryModel.TakeResource(cur, itemId, 1)
			end
			h.Health = math.min(h.MaxHealth, h.Health + spec.Heal)
			InventoryService.Sync(p)
			local hr = ctx.Util.Root(p)
			if hr then
				Net.FireAll("Fx", "Healed", { Pos = hr.Position, Amount = spec.Heal })
			end
			ctx.Util.PlaySound("Heal", ctx.Util.Root(p))
		end,
	})
end

-- Food ------------------------------------------------------------------------------------------

local lastEat: { [Player]: number } = {}

-- Eats one food resource (berries/mushroom) from the pack. `id` nil = best food carried.
function InventoryService._onEat(p: Player, id: any)
	local inv = invs[p]
	if not inv or not ctx.Util.IsAlive(p) then
		return
	end
	if id == nil then
		local best, heal = nil, 0
		for fid, f in Resources.Food do
			if (inv.Resources[fid] or 0) > 0 and f.Heal > heal then
				best, heal = fid, f.Heal
			end
		end
		id = best
		if not id then
			ctx.Util.Notify(p, "You have no food. Pick berries or mushrooms.", "info")
			return
		end
	end
	if type(id) == "string" and Config.Healing[id] and id ~= "Bandage" then
		InventoryService.Heal(p, id)
		return
	end
	local food = type(id) == "string" and Resources.Food[id]
	if not food or (inv.Resources[id] or 0) <= 0 then
		return
	end
	local t = os.clock()
	if t - (lastEat[p] or 0) < food.Cooldown then
		return
	end
	local hum = ctx.Util.Humanoid(p)
	if not hum or hum.Health >= hum.MaxHealth then
		ctx.Util.Notify(p, "You're already at full health.", "info")
		return
	end
	lastEat[p] = t
	InventoryModel.TakeResource(inv, id, 1)
	hum.Health = math.min(hum.MaxHealth, hum.Health + food.Heal)
	InventoryService.Sync(p)
	ctx.Util.PlaySound("Eat", ctx.Util.Root(p))
	ctx.Util.SetAction(p, "Eat")
	ctx.Util.Notify(p, string.format("Ate %s  +%d HP", Items[id].Name, food.Heal), "gain")
end

-- Durability -------------------------------------------------------------------------------------

function InventoryService.Wear(p: Player, slot: string, amount: number)
	local inv = invs[p]
	if not inv then
		return
	end
	local piece = InventoryModel.ArmorPiece(slot)
	local st = if piece then inv.Armor[piece] else inv.Slots[slot]
	local name = st and Items[st.Id] and Items[st.Id].Name
	if InventoryModel.Wear(inv, slot, amount) then
		ctx.Util.Notify(p, (name or "Item") .. " broke!", "warn")
		ctx.Util.PlaySound("Break", ctx.Util.Root(p))
		local br = ctx.Util.Root(p)
		if br then
			Net.FireAll("Fx", "ToolBroke", { Pos = br.Position + Vector3.new(0, 1.5, 0) })
		end
		Net.FireClient("MatchEvent", p, "ToolBroke", { Name = name or "Item" })
	end
	InventoryService.Sync(p)
end

function InventoryService.EquippedItem(p: Player): (string, string?)
	local inv = invs[p]
	if not inv or not inv.Equipped then
		return "Fists", nil
	end
	local st = inv.Slots[inv.Equipped]
	if not st then
		return "Fists", nil
	end
	return st.Id, inv.Equipped
end

-- Held visuals ---------------------------------------------------------------------------------

function InventoryService._refreshHeld(p: Player)
	local char = p.Character
	if not char then
		return
	end
	local id = InventoryService.EquippedItem(p)
	local inv = invs[p]
	if char:GetAttribute("HeldId") ~= id then
		local old = char:FindFirstChild("HeldItem")
		if old then
			old:Destroy()
		end
		char:SetAttribute("HeldId", id)
		local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
		if id ~= "Fists" and hand and hand:IsA("BasePart") then
			local model = ItemModels.Held(id)
			if model then
				model.Name = "HeldItem"
				local handle = model.PrimaryPart :: BasePart
				handle.CFrame = hand.CFrame * ItemModels.GripFor(id)
				local weld = Instance.new("Weld")
				weld.Part0 = hand
				weld.Part1 = handle
				weld.C0 = ItemModels.GripFor(id)
				weld.Parent = handle
				model.Parent = char
				ctx.CosmeticService.DressHeld(p, model)
			end
		end
	end
	-- Canteen fill state for visuals
	local util = inv and inv.Slots.Utility
	char:SetAttribute("CanteenFilled", util ~= nil and util.Id == "Canteen" and util.Filled == true)
	-- Worn armour: one shell per piece, coloured by tier (Hide → Tactical).
	local ARMOR_BONES = { Head = { "Head" }, Chest = { "UpperTorso", "Torso" }, Legs = { "LeftUpperLeg", "RightUpperLeg" } }
	for piece, bones in ARMOR_BONES do
		local st = inv and inv.Armor[piece]
		local wantId = if st then st.Id else nil
		for _, old in char:GetChildren() do
			if old:GetAttribute("ArmorPiece") == piece and old:GetAttribute("ArmorId") ~= wantId then
				old:Destroy()
			end
		end
		local def = wantId and Items[wantId]
		if def then
			for _, boneName in bones do
				local bone = char:FindFirstChild(boneName)
				if bone and bone:IsA("BasePart") and not bone:FindFirstChild("ArmorShell") then
					local mat = if (def.Tier or 1) >= 3 then Enum.Material.Metal else Enum.Material.Fabric
					local size = bone.Size + (if piece == "Head" then Vector3.new(0.25, -0.2, 0.25) else Vector3.new(0.3, 0.1, 0.3))
					local shell = Build.Part({ Name = "ArmorShell", Size = size, CFrame = bone.CFrame * CFrame.new(0, if piece == "Head" then 0.25 else 0, 0), Color = def.Icon.Color, Material = mat, Anchored = false, CanCollide = false, CanQuery = false, Massless = true, Parent = bone })
					shell:SetAttribute("ArmorPiece", piece)
					shell:SetAttribute("ArmorId", wantId)
					local w = Instance.new("WeldConstraint")
					w.Part0 = bone
					w.Part1 = shell
					w.Parent = shell
				end
			end
		end
		-- remove stale shells parented under bones
		for _, boneName in bones do
			local bone = char:FindFirstChild(boneName)
			local shell = bone and bone:FindFirstChild("ArmorShell")
			if shell and shell:GetAttribute("ArmorId") ~= wantId then
				shell:Destroy()
			end
		end
	end
	-- Worn backpack: a pack on the back, tinted by the BackpackSkin cosmetic.
	local packId = inv and inv.Backpack and inv.Backpack.Id
	local tint = p:GetAttribute("PackSkin") :: Color3?
	local want = if packId then packId .. (if tint then tint:ToHex() else "") else nil
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	local pack = torso and torso:FindFirstChild("PackShell")
	if pack and pack:GetAttribute("Key") ~= want then
		pack:Destroy()
		pack = nil
	end
	if want and not pack and torso and torso:IsA("BasePart") then
		local slots = (Items[packId :: string] and Items[packId :: string].Slots) or 10
		local k = math.clamp(slots / 25, 0.6, 1.4)
		local shell = Build.Part({ Name = "PackShell", Size = Vector3.new(1.4 * k, 1.6 * k, 0.7 * k), CFrame = torso.CFrame * CFrame.new(0, 0.1, torso.Size.Z / 2 + 0.35 * k), Color = tint or (Items[packId :: string] and Items[packId :: string].Icon.Color) or Color3.fromRGB(120, 90, 60), Material = Enum.Material.Fabric, Anchored = false, CanCollide = false, CanQuery = false, Massless = true, Parent = torso })
		shell:SetAttribute("Key", want)
		local w = Instance.new("WeldConstraint")
		w.Part0 = torso
		w.Part1 = shell
		w.Parent = shell
	end
end

function InventoryService.OnSpawn(p: Player)
	local char = p.Character
	if char then
		char:SetAttribute("HeldId", nil)
	end
	if invs[p] then
		InventoryService.Sync(p)
	end
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="882">
          <Properties>
            <string name="Name">LivesService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Spawning, deaths, free respawns, paid revives, elimination and spectating state.
-- Rules live in Shared/Logic/LivesRules (unit-tested); this service drives timers,
-- characters and replication.
--
-- Player attributes (replicated): LifeState, FreeRespawns, PaidRevives,
-- WindowEnds (server time), ReviveTier, ReviveLockBy (userId), ProtectedUntil.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Products = require(Shared:WaitForChild("Products"))
local Logic = Shared:WaitForChild("Logic")
local LivesRules = require(Logic:WaitForChild("LivesRules"))
local ProfileRules = require(Logic:WaitForChild("ProfileRules"))

local LivesService = {}

local ctx: any
local lives: { [number]: LivesRules.Life } = {} -- userId -> life (match participants)
local lastDamage: { [Player]: { Kind: string, By: Player?, Name: string?, Time: number } } = {}
local spawnIndex: { [number]: number } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

function LivesService.Init(c)
	ctx = c
	ctx.Util.OnPlayerAdded(function(p: Player)
		p:SetAttribute("LifeState", "Lobby")
		p.CharacterAdded:Connect(function(char)
			LivesService._setupCharacter(p, char)
		end)
		if ctx.Mode == "Lobby" then
			ctx.DataService.WaitFor(p, 30)
			if p.Parent and not p:GetAttribute("InMatch") then
				LivesService.SpawnInLobby(p)
			end
		end
	end)
	ctx.Util.OnPlayerRemoving(function(p: Player)
		local life = lives[p.UserId]
		if life and life.State ~= "Eliminated" then
			life.State = "Left"
		end
		lastDamage[p] = nil
	end)

	ctx.MatchService.On("MatchStarting", function()
		lives = {}
		spawnIndex = {}
	end)
	ctx.MatchService.On("PlayerJoinedMatch", function(p: Player)
		lives[p.UserId] = LivesRules.New(Config.Lives.FreeRespawns)
		LivesService._sync(p)
	end)
	ctx.MatchService.On("FireOut", LivesService._onFireOut)
	ctx.MatchService.On("PhaseChanged", LivesService._onPhase)
	ctx.MatchService.On("MatchCleanup", function()
		lives = {}
	end)

	ctx.Util.Connect("RequestRevive", "Purchase", LivesService._onRequestRevive)
	ctx.PurchaseService.OnGranted("Revive", LivesService._onReviveGranted)
end

function LivesService.Start()
	while true do
		task.wait(0.25)
		if ctx.MatchService.Active then
			local t = now()
			for uid, life in lives do
				if LivesRules.Tick(life, t) then
					local p = Players:GetPlayerByUserId(uid)
					if p then
						LivesService._sync(p)
						ctx.Util.Notify(p, "Revive window closed. You are eliminated — spectating.", "danger")
					end
					ctx.MatchService.CheckOutcome()
				elseif life.PurchaseLockUntil and t >= life.PurchaseLockUntil then
					life.PurchaseLockBy = nil
					life.PurchaseLockUntil = nil
					local p = Players:GetPlayerByUserId(uid)
					if p then
						LivesService._sync(p)
					end
				end
			end
		end
	end
end

function LivesService.GetLife(p: Player): LivesRules.Life?
	return lives[p.UserId]
end

function LivesService.TeamLives(team: number): { LivesRules.Life }
	local out = {}
	for uid, life in lives do
		if ctx.MatchService.Roster[uid] == team then
			table.insert(out, life)
		end
	end
	return out
end

function LivesService._sync(p: Player)
	local life = lives[p.UserId]
	if not life then
		return
	end
	p:SetAttribute("LifeState", life.State)
	-- -1 = unlimited while the fire burns (attributes can't carry math.huge reliably)
	p:SetAttribute("FreeRespawns", if LivesRules.Unlimited(life) then -1 else life.FreeRespawns)
	p:SetAttribute("Deaths", life.Deaths)
	p:SetAttribute("PaidRevives", life.PaidRevives)
	p:SetAttribute("WindowEnds", life.WindowEndsAt or 0)
	p:SetAttribute("ReviveTier", LivesRules.ReviveTier(life, Config.Lives.MaxReviveTier))
	p:SetAttribute("ReviveLockBy", life.PurchaseLockBy or 0)
end

-- Spawning ---------------------------------------------------------------------------------

function LivesService._setupCharacter(p: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	hum.MaxHealth = Config.Player.MaxHealth
	hum.Health = Config.Player.MaxHealth
	hum.BreakJointsOnDeath = false
	hum.NameDisplayDistance = 60
	hum.MaxSlopeAngle = 55 -- grounded: no scrambling up near-vertical cliffs
	hum.HealthDisplayDistance = 0
	for _, part in char:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = "Characters"
		end
	end
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = "Characters"
		end
	end)
	hum.Died:Connect(function()
		LivesService._onDied(p, char)
	end)
end

-- LoadCharacterAsync replaces the deprecated LoadCharacter; fall back if unavailable.
function LivesService._load(p: Player)
	local ok = pcall(function()
		(p :: any):LoadCharacterAsync()
	end)
	if not ok and p.Parent then
		p:LoadCharacter()
	end
end

local function protect(p: Player, seconds: number?)
	local untilT = now() + (seconds or Config.Lives.SpawnProtection)
	local prev = p:GetAttribute("ProtectedUntil")
	p:SetAttribute("ProtectedUntil", math.max(untilT, if type(prev) == "number" then prev else 0))
end

-- Sunrise (from Day 2): everyone alive at that moment is invincible for a short
-- time and can't deal damage (CombatService / BuildService check IsProtected).
function LivesService._onPhase(phase: string, day: number)
	if phase ~= "Day" or day < 2 then
		return
	end
	for uid, life in lives do
		local p = Players:GetPlayerByUserId(uid)
		if p and life.State == "Alive" and ctx.Util.IsAlive(p) then
			protect(p, Config.Match.SunriseProtection)
			ctx.Util.Notify(p, string.format("Sunrise! You're protected for %d s, and can't deal damage.", Config.Match.SunriseProtection), "info")
		end
	end
end

function LivesService.SpawnInLobby(p: Player)
	if not p.Parent then
		return
	end
	p:SetAttribute("LifeState", "Lobby")
	LivesService._load(p)
	local char = p.Character
	if char then
		local spawnCF = ctx.WorldService.LobbySpawn * CFrame.new(math.random(-6, 6), 0, math.random(-4, 4))
		char:PivotTo(spawnCF)
	end
	ctx.InventoryService.OnSpawn(p)
	ctx.PowerupService.OnSpawn(p)
end

function LivesService.SpawnAtCamp(p: Player)
	if not p.Parent or not p:GetAttribute("InMatch") then
		return
	end
	local team = ctx.Util.Team(p)
	local camp = ctx.CampService.GetCamp(team)
	local life = lives[p.UserId]
	if not camp or not life then
		return
	end
	life.State = "Alive"
	LivesService._sync(p)
	LivesService._load(p)
	local char = p.Character
	if not char then
		return
	end
	spawnIndex[team] = ((spawnIndex[team] or 0) % #camp.SpawnPads) + 1
	local pad = camp.SpawnPads[spawnIndex[team]]
	char:PivotTo(CFrame.lookAt(pad.Position, camp.FirePos + Vector3.new(0, 3.5, 0)))
	protect(p)
	ctx.StaminaService.OnSpawn(p)
	ctx.InventoryService.OnSpawn(p)
	ctx.PowerupService.OnSpawn(p)
	ctx.MatchService.CheckOutcome()
end

-- Damage bookkeeping ---------------------------------------------------------------------------

function LivesService.RecordDamage(victim: Player, kind: string, by: Player?, name: string?)
	lastDamage[victim] = { Kind = kind, By = by, Name = name, Time = os.clock() }
end

function LivesService.IsProtected(p: Player): boolean
	local t = p:GetAttribute("ProtectedUntil") :: number?
	return t ~= nil and now() < t
end

-- Death -----------------------------------------------------------------------------------------

function LivesService._onDied(p: Player, char: Model)
	if not p:GetAttribute("InMatch") or not ctx.MatchService.Active then
		task.delay(2, function()
			if p.Parent and p.Character == char and not p:GetAttribute("InMatch") then
				LivesService.SpawnInLobby(p)
			end
		end)
		return
	end
	local life = lives[p.UserId]
	if not life or life.State ~= "Alive" then
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pos = if root then root.Position else nil

	-- Cause (only damage in the last 10 s counts as the killer)
	local dmg = lastDamage[p]
	local cause, killer = "Environment", nil
	if dmg and os.clock() - dmg.Time < 10 then
		cause = dmg.Kind
		killer = dmg.By
	end
	lastDamage[p] = nil

	ctx.ChannelService.CancelFor(p, "You died")
	if pos then
		ctx.InventoryService.DropOnDeath(p, pos)
	end

	local team = ctx.Util.Team(p)
	local burning = ctx.MatchService.FireBurning(team)
	local action = LivesRules.OnDeath(life, burning, now(), Config.Lives.ReviveWindow)
	LivesService._sync(p)

	ctx.MatchService.Broadcast("Death", {
		Victim = p.DisplayName,
		VictimTeam = team,
		Killer = if killer then killer.DisplayName else nil,
		KillerTeam = if killer then ctx.Util.Team(killer) else nil,
		KillerId = if killer then killer.UserId else nil,
		Cause = if cause == "Animal" and dmg then (dmg.Name or "Animal") else cause,
		Eliminated = action == "Eliminate",
	})
	if killer and killer ~= p then
		ctx.PowerupService.OnPlayerKill(killer, p, action == "Eliminate")
	end

	if action == "Respawn" then
		local delay = LivesRules.RespawnDelay(life, Config.Lives.RespawnDelays)
		p:SetAttribute("RespawnAt", now() + delay)
		Net.FireClient("MatchEvent", p, "Died", { Respawn = delay, Left = if LivesRules.Unlimited(life) then -1 else life.FreeRespawns, Cause = cause, Killer = if killer then killer.DisplayName else nil })
		task.delay(delay, function()
			if p.Parent and life.State == "Respawning" and ctx.MatchService.Active and ctx.MatchService.FireBurning(team) then
				LivesService.SpawnAtCamp(p)
			end
		end)
	elseif action == "ReviveWindow" then
		Net.FireClient("MatchEvent", p, "Died", { ReviveWindow = Config.Lives.ReviveWindow, Tier = LivesRules.ReviveTier(life, Config.Lives.MaxReviveTier), Cause = cause, Killer = if killer then killer.DisplayName else nil })
		for _, mate in ctx.Util.TeamPlayers(team) do
			if mate ~= p then
				Net.FireClient("MatchEvent", mate, "TeammateNeedsRevive", { UserId = p.UserId, Name = p.DisplayName, Ends = life.WindowEndsAt })
			end
		end
		-- A stored credit of a sufficient tier is used automatically (D8).
		LivesService._tryCredit(p, p)
	else
		Net.FireClient("MatchEvent", p, "Eliminated", { Cause = cause, Killer = if killer then killer.DisplayName else nil })
	end
	ctx.MatchService.CheckOutcome()
end

function LivesService._onFireOut(team: number)
	for uid, life in lives do
		if ctx.MatchService.Roster[uid] == team then
			if LivesRules.OnFireOut(life) then
				local p = Players:GetPlayerByUserId(uid)
				if p then
					LivesService._sync(p)
					Net.FireClient("MatchEvent", p, "Eliminated", { Cause = "FireOut" })
				end
			end
		end
	end
	for _, p in ctx.Util.TeamPlayers(team) do
		LivesService._sync(p)
	end
end

-- Revives -----------------------------------------------------------------------------------

-- Uses a revive credit from `payer`'s profile for `target` if one covers the tier.
function LivesService._tryCredit(payer: Player, target: Player): boolean
	local life = lives[target.UserId]
	local session = ctx.DataService.Get(payer)
	if not life or not session or not ctx.DataService.CanGrant(payer) then
		return false
	end
	local tier = LivesRules.ReviveTier(life, Config.Lives.MaxReviveTier)
	local creditTier = LivesRules.FindCredit(session.Profile.Credits.Revive, tier, Config.Lives.MaxReviveTier)
	if not creditTier then
		return false
	end
	local team = ctx.Util.Team(target)
	if not LivesRules.CanStartRevive(life, ctx.MatchService.FireBurning(team), now(), payer.UserId) then
		return false
	end
	if not ProfileRules.ConsumeReviveCredit(session.Profile, creditTier) then
		return false
	end
	if LivesRules.ApplyRevive(life, creditTier, ctx.MatchService.FireBurning(team), now(), Config.Lives.MaxReviveTier) then
		task.spawn(ctx.DataService.Save, payer, false)
		ctx.DataService.Push(payer)
		LivesService._revived(target, payer, true)
		return true
	end
	-- Could not apply: give the credit back.
	session.Profile.Credits.Revive[tostring(creditTier)] = (session.Profile.Credits.Revive[tostring(creditTier)] or 0) + 1
	return false
end

function LivesService._revived(target: Player, payer: Player, fromCredit: boolean)
	LivesService._sync(target)
	local msg = if payer == target then target.DisplayName .. " revived" else payer.DisplayName .. " revived " .. target.DisplayName
	ctx.Util.NotifyTeam(ctx.Util.Team(target), msg .. (if fromCredit then " (used a revive credit)" else "") .. "!", "success")
	task.delay(1, function()
		if target.Parent and lives[target.UserId] and lives[target.UserId].State == "Respawning" then
			LivesService.SpawnAtCamp(target)
		end
	end)
end

function LivesService._onRequestRevive(payer: Player, targetUserId: any)
	if not ctx.Util.IsInt(targetUserId) or not payer:GetAttribute("InMatch") then
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or not target:GetAttribute("InMatch") or ctx.Util.Team(target) ~= ctx.Util.Team(payer) then
		ctx.Util.Notify(payer, "You can only revive yourself or a teammate.", "error")
		return
	end
	local life = lives[target.UserId]
	if not life then
		return
	end
	local team = ctx.Util.Team(target)
	local ok, why = LivesRules.CanStartRevive(life, ctx.MatchService.FireBurning(team), now(), payer.UserId)
	if not ok then
		ctx.Util.Notify(payer, why or "Can't revive right now.", "error")
		return
	end
	if not ctx.PurchaseService.GiftAllowed(payer, target) then
		ctx.Util.Notify(payer, "Regional pricing prevents paying for this teammate's revive.", "error")
		return
	end
	if LivesService._tryCredit(payer, target) then
		return
	end
	local tier = LivesRules.ReviveTier(life, Config.Lives.MaxReviveTier)
	LivesRules.Lock(life, payer.UserId, now(), Config.Lives.PurchaseLockTime)
	LivesService._sync(target)
	if payer ~= target then
		ctx.Util.Notify(target, payer.DisplayName .. " is buying your revive...", "info")
	end
	local started, reason = ctx.PurchaseService.Prompt(payer, Products.ReviveKey(tier), {
		Target = target.UserId,
		Tier = tier,
		MatchId = ctx.MatchService.MatchId,
	}, function()
		LivesRules.Unlock(life, payer.UserId)
		LivesService._sync(target)
	end)
	if not started then
		LivesRules.Unlock(life, payer.UserId)
		LivesService._sync(target)
		ctx.Util.Notify(payer, reason or "Purchase unavailable.", "error")
	end
end

-- Called after a revive receipt was durably credited to `buyer`.
function LivesService._onReviveGranted(buyer: Player, product: any, data: { [string]: any }?)
	local targetId = if data and data.Target then data.Target else buyer.UserId
	local target = Players:GetPlayerByUserId(targetId)
	local sameMatch = data ~= nil and data.MatchId == ctx.MatchService.MatchId and ctx.MatchService.Active
	if target and sameMatch and LivesService._tryCredit(buyer, target) then
		return
	end
	ctx.Util.Notify(buyer, string.format("Your revive (tier %d) couldn't be used right now, so it was saved as a Revive Credit. It will be used automatically next time.", product.Tier or 1), "info")
end

return LivesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="883">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Lobby: parties (up to 4, invite/accept/leave/kick), ready status (UI toggle
-- or standing in the Ready ring), classes / power-ups (Diamonds), cosmetics
-- (Coins), daily / weekly bonuses, emotes, Robux Coin packs, and the lobby
-- view pushed to clients.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Products = require(Shared:WaitForChild("Products"))
local ProfileRules = require(Shared:WaitForChild("Logic"):WaitForChild("ProfileRules"))

local LobbyService = {}

export type Party = {
	Id: string,
	Leader: Player,
	Members: { Player },
	Invites: { [number]: number }, -- userId -> expiry (os.clock)
	Queued: boolean,
	QueuedAt: number,
}

local ctx: any
local parties: { [string]: Party } = {}
local partyOf: { [Player]: Party } = {}
local ready: { [Player]: string? } = {} -- "Button" | "Ring"
local counter = 0
local dirty = true

local MAX_PARTY = Config.Match.MaxPerTeam -- solo launch: 1 (parties disabled)

function LobbyService.Init(c)
	ctx = c
	if ctx.Mode ~= "Lobby" then
		return
	end
	ctx.Util.OnPlayerAdded(function(p)
		LobbyService._solo(p)
		dirty = true
		-- Stream the lobby around its fire (not the character) while in the lobby: the
		-- title screen shows the refuge before any character exists.
		local focus
		function focus()
			local lobby = workspace:FindFirstChild("Lobby")
			local fire = lobby and lobby:FindFirstChild("LobbyFire")
			local part = fire and (fire:IsA("Model") and fire.PrimaryPart or fire:FindFirstChildWhichIsA("BasePart", true))
			p.ReplicationFocus = if p:GetAttribute("InMatch") then nil else part
			if not part and not p:GetAttribute("InMatch") and p.Parent then
				task.delay(1, focus) -- lobby still being built
			end
		end
		focus()
		p:GetAttributeChangedSignal("InMatch"):Connect(focus)
	end)
	ctx.Util.OnPlayerRemoving(function(p)
		LobbyService._leaveParty(p, true)
		ready[p] = nil
		dirty = true
	end)
	ctx.Util.Connect("LobbyAction", "Lobby", LobbyService._onAction)
	ctx.ChannelService.OnPrompt("Station", function(p: Player, prompt: ProximityPrompt)
		Net.FireClient("MatchEvent", p, "OpenStation", { Station = prompt:GetAttribute("Station") })
	end)
	ctx.MatchService.On("MatchCleanup", function()
		task.delay(1, function()
			dirty = true
		end)
	end)
end

function LobbyService.Start()
	if ctx.Mode ~= "Lobby" then
		return
	end
	local acc = 0
	while true do
		task.wait(0.5)
		LobbyService._ringCheck()
		acc += 0.5
		if dirty or acc >= 3 then
			acc = 0
			dirty = false
			LobbyService.PushAll()
			LobbyService._board()
		end
	end
end

-- Parties ---------------------------------------------------------------------------------------

function LobbyService._solo(p: Player)
	counter += 1
	local party: Party = {
		Id = game.JobId .. "-" .. counter .. "-" .. p.UserId,
		Leader = p,
		Members = { p },
		Invites = {},
		Queued = false,
		QueuedAt = 0,
	}
	parties[party.Id] = party
	partyOf[p] = party
	return party
end

function LobbyService.PartyOf(p: Player): Party?
	return partyOf[p]
end

local function unreadyParty(party: Party)
	for _, m in party.Members do
		ready[m] = nil
	end
	if party.Queued then
		ctx.MatchmakingService.Dequeue(party)
		party.Queued = false
	end
end

function LobbyService._leaveParty(p: Player, leaving: boolean)
	local party = partyOf[p]
	if not party then
		return
	end
	unreadyParty(party)
	local idx = table.find(party.Members, p)
	if idx then
		table.remove(party.Members, idx)
	end
	partyOf[p] = nil
	if #party.Members == 0 then
		parties[party.Id] = nil
	elseif party.Leader == p then
		party.Leader = party.Members[1]
	end
	if not leaving then
		LobbyService._solo(p)
	end
	dirty = true
end

function LobbyService.RemoveFromQueue(party: Party)
	party.Queued = false
	for _, m in party.Members do
		ready[m] = nil
	end
	dirty = true
end

local function canUseLobby(p: Player): boolean
	return not p:GetAttribute("InMatch")
end

function LobbyService._onAction(p: Player, req: any)
	if type(req) ~= "table" or type(req.Action) ~= "string" then
		return
	end
	local a = req.Action
	local party = partyOf[p]
	if not party then
		return
	end
	if a == "Invite" then
		if not ctx.Util.IsInt(req.UserId) or party.Leader ~= p then
			return
		end
		local target = Players:GetPlayerByUserId(req.UserId)
		if not target or target == p or not canUseLobby(target) then
			return
		end
		if #party.Members >= MAX_PARTY then
			ctx.Util.Notify(p, if MAX_PARTY <= 1 then "Matches are solo for now — parties are disabled." else "Your party is full (" .. MAX_PARTY .. ").", "warn")
			return
		end
		party.Invites[target.UserId] = os.clock() + 60
		Net.FireClient("MatchEvent", target, "PartyInvite", { PartyId = party.Id, From = p.DisplayName })
		ctx.Util.Notify(p, "Invite sent to " .. target.DisplayName .. ".", "info")
	elseif a == "Accept" then
		if type(req.PartyId) ~= "string" then
			return
		end
		local target = parties[req.PartyId]
		if not target or target == party then
			return
		end
		local exp = target.Invites[p.UserId]
		if not exp or os.clock() > exp then
			ctx.Util.Notify(p, "That invite expired.", "warn")
			return
		end
		if #target.Members >= MAX_PARTY then
			ctx.Util.Notify(p, "That party is full.", "warn")
			return
		end
		target.Invites[p.UserId] = nil
		LobbyService._leaveParty(p, true)
		unreadyParty(target)
		table.insert(target.Members, p)
		partyOf[p] = target
		for _, m in target.Members do
			ctx.Util.Notify(m, p.DisplayName .. " joined the party.", "success")
		end
	elseif a == "Decline" then
		local target = type(req.PartyId) == "string" and parties[req.PartyId]
		if target then
			target.Invites[p.UserId] = nil
			ctx.Util.Notify(target.Leader, p.DisplayName .. " declined your invite.", "info")
		end
	elseif a == "Leave" then
		if #party.Members > 1 then
			LobbyService._leaveParty(p, false)
		end
	elseif a == "Kick" then
		if party.Leader ~= p or not ctx.Util.IsInt(req.UserId) then
			return
		end
		local target = Players:GetPlayerByUserId(req.UserId)
		if target and target ~= p and partyOf[target] == party then
			LobbyService._leaveParty(target, false)
			ctx.Util.Notify(target, "You were removed from the party.", "info")
		end
	elseif a == "Ready" then
		if not canUseLobby(p) then
			return
		end
		ready[p] = if req.Value == true then "Button" else nil
		LobbyService._checkParty(party)
	elseif a == "Cancel" then
		unreadyParty(party)
	elseif a == "BuyClass" or a == "EquipClass" or a == "BuyPerk" or a == "EquipPerk" or a == "BuyCosmetic" or a == "WearCosmetic" or a == "ClaimDaily" or a == "ClaimWeekly" then
		LobbyService._profileAction(p, a, req)
	elseif a == "Emote" then
		if canUseLobby(p) and type(req.Id) == "string" then
			ctx.CosmeticService.Emote(p, req.Id)
		end
	elseif a == "BuyRobux" then
		LobbyService._robux(p, req.Key)
	end
	dirty = true
end

function LobbyService._checkParty(party: Party)
	local all = true
	for _, m in party.Members do
		if not ready[m] then
			all = false
		end
	end
	if all and not party.Queued then
		party.Queued = true
		party.QueuedAt = os.clock()
		ctx.MatchmakingService.Enqueue(party)
		for _, m in party.Members do
			ctx.Util.Notify(m, "Searching for a match...", "info")
		end
	elseif not all and party.Queued then
		party.Queued = false
		ctx.MatchmakingService.Dequeue(party)
	end
	dirty = true
end

function LobbyService._ringCheck()
	local lobby = workspace:FindFirstChild("Lobby")
	if not lobby then
		return
	end
	local center = lobby:GetAttribute("ReadyCenter") :: Vector3?
	local radius = lobby:GetAttribute("ReadyRadius") :: number?
	if not center or not radius then
		return
	end
	for _, p in Players:GetPlayers() do
		if canUseLobby(p) and partyOf[p] then
			local root = ctx.Util.Root(p)
			local inside = root ~= nil and Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude <= radius and math.abs(root.Position.Y - center.Y) < 12
			if inside and not ready[p] then
				ready[p] = "Ring"
				LobbyService._checkParty(partyOf[p] :: Party)
			elseif not inside and ready[p] == "Ring" then
				ready[p] = nil
				LobbyService._checkParty(partyOf[p] :: Party)
			end
		end
	end
end

-- Shop --------------------------------------------------------------------------------------

local ACTION_FN = {
	BuyClass = ProfileRules.BuyClass,
	EquipClass = ProfileRules.EquipClass,
	BuyPerk = ProfileRules.BuyPerk,
	EquipPerk = ProfileRules.EquipPerk,
	BuyCosmetic = ProfileRules.BuyCosmetic,
}

local ACTION_DONE = {
	BuyClass = "Class unlocked!",
	EquipClass = "Class equipped for your next match.",
	BuyPerk = "Power-up unlocked!",
	EquipPerk = "Power-up set for your next match.",
	BuyCosmetic = "Cosmetic unlocked!",
	WearCosmetic = "Cosmetic updated.",
}

function LobbyService._profileAction(p: Player, action: string, req: any)
	if not canUseLobby(p) then
		ctx.Util.Notify(p, "Classes, power-ups and cosmetics can only be changed in the lobby.", "warn")
		return
	end
	local session = ctx.DataService.Get(p)
	if not session or not ctx.DataService.CanGrant(p) then
		ctx.Util.Notify(p, "Your data isn't loaded — shop unavailable.", "error")
		return
	end
	local profile = session.Profile
	local id = req.Id
	if id ~= nil and type(id) ~= "string" then
		return
	end
	local ok, why = false, nil
	local note: string? = nil
	if action == "ClaimDaily" then
		local coins = ProfileRules.ClaimDaily(profile, os.time())
		ok, why = coins > 0, "Already claimed today."
		note = "Daily bonus: +" .. coins .. " Coins"
	elseif action == "ClaimWeekly" then
		local coins = ProfileRules.ClaimWeekly(profile, os.time())
		ok, why = coins > 0, "Play more matches this week first."
		note = "Weekly bonus: +" .. coins .. " Coins"
	elseif action == "WearCosmetic" then
		if type(req.Type) ~= "string" then
			return
		end
		ok, why = ProfileRules.WearCosmetic(profile, req.Type, id)
	elseif action == "EquipPerk" then
		ok, why = ProfileRules.EquipPerk(profile, id)
	elseif id then
		ok, why = ACTION_FN[action](profile, id)
	end
	if ok then
		task.spawn(ctx.DataService.Save, p, false)
		ctx.Util.Notify(p, note or ACTION_DONE[action] or "Done!", "success")
		ctx.Util.PlaySound("UiReady", ctx.Util.Root(p))
	else
		ctx.Util.Notify(p, why or "Can't do that.", "error")
	end
	ctx.DataService.Push(p)
end

function LobbyService._robux(p: Player, key: any)
	if type(key) ~= "string" then
		return
	end
	local product = Products.ByKey[key]
	if not product or not Products.OnSale(key) or not (product.Kind == "Coins" or product.Kind == "Bundle") then
		return
	end
	local session = ctx.DataService.Get(p)
	if not session or not ctx.DataService.CanGrant(p) then
		ctx.Util.Notify(p, "Your data isn't loaded — purchases are paused to keep them safe.", "error")
		return
	end
	local ok, why = ctx.PurchaseService.Prompt(p, key, {})
	if not ok then
		ctx.Util.Notify(p, why or "Unavailable", "error")
	end
end

-- View ----------------------------------------------------------------------------------------------

function LobbyService.PushAll()
	local list = {}
	for _, pl in Players:GetPlayers() do
		if canUseLobby(pl) then
			table.insert(list, { UserId = pl.UserId, Name = pl.DisplayName, InParty = partyOf[pl] ~= nil and #(partyOf[pl] :: Party).Members > 1 })
		end
	end
	local queueInfo = ctx.MatchmakingService.Status()
	for _, pl in Players:GetPlayers() do
		local party = partyOf[pl]
		if party and canUseLobby(pl) then
			local members = {}
			for _, m in party.Members do
				table.insert(members, { UserId = m.UserId, Name = m.DisplayName, Ready = ready[m] ~= nil, Leader = party.Leader == m })
			end
			Net.FireClient("LobbySync", pl, {
				PartyId = party.Id,
				Members = members,
				IsLeader = party.Leader == pl,
				Queued = party.Queued,
				QueuedFor = if party.Queued then os.clock() - party.QueuedAt else 0,
				Ready = ready[pl] ~= nil,
				Players = list,
				Queue = queueInfo,
				MinPlayers = if ctx.LocalMatches then Config.Dev.StudioMinPlayers else Config.Match.MinPlayers,
				MaxPlayers = Config.Match.MaxPlayers,
				Boards = ctx.DataService.Boards(),
			})
		end
	end
end

-- Hall of Fame board in the lobby (top 5 wins + top 5 levels).
local lastBoard = ""
function LobbyService._board()
	local boards = ctx.DataService.Boards()
	local lines = { "HALL OF FAME" }
	for _, spec in { { "Wins", "Most wins" }, { "XP", "Most XP" } } do
		table.insert(lines, "— " .. spec[2] .. " —")
		local list = boards[spec[1]] or {}
		if #list == 0 then
			table.insert(lines, "(live servers only)")
		end
		for i = 1, math.min(5, #list) do
			table.insert(lines, string.format("%d. %s  %d", i, list[i].Name, list[i].Value))
		end
	end
	local text = table.concat(lines, "\n")
	if text ~= lastBoard then
		lastBoard = text
		ctx.WorldService.SetLobbyBoard(lines)
	end
end

function LobbyService.MarkDirty()
	dirty = true
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="884">
          <Properties>
            <string name="Name">LootService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Care packages (free daily + Robux-purchased, all public and contestable) and
-- hidden forest crates that restock each dawn.
--
-- Delivery queue (DECISIONS D25/D26):
--   * one free package per day, 20–40 s after dawn
--   * paid packages bought by day are queued immediately; bought at night they
--     wait for dawn (the shop says so before purchase)
--   * drops leave one at a time, QueueSpacing seconds apart, and never land
--     within 30 studs of another unopened package

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Products = require(Shared:WaitForChild("Products"))
local Net = require(Shared:WaitForChild("Net"))
local Loot = require(Shared:WaitForChild("Loot"))
local Models = Shared:WaitForChild("Models")
local LootModels = require(Models:WaitForChild("LootModels"))
local Landmarks = require(Models:WaitForChild("Landmarks"))

local LootService = {}

type Package = { Id: number, Model: Model, Pos: Vector3, Landed: boolean, Opened: boolean, Source: string, Buyer: string? }
type Crate = { Id: number, Model: Model, Pos: Vector3, Spot: number }
type Chest = { Key: string, Model: Model, Pos: Vector3, Tier: string, Poi: string, Opened: boolean }

local ctx: any
local queue: { { Source: string, Buyer: string?, BuyerId: number? } } = {}
local packages: { [number]: Package } = {}
local crates: { [number]: Crate } = {}
local chests: { [string]: Chest } = {}
-- Spec: POI chests open once per match; better chests take longer to search.
local CHEST_TIME = { Common = 2, Uncommon = 3, Rare = 4.5, VeryRare = 6 }
local CHEST_NAME = { Common = "Common Chest", Uncommon = "Uncommon Chest", Rare = "Rare Chest", VeryRare = "Very Rare Chest" }
local usedSpots: { [number]: boolean } = {}
local lastSpots: { [number]: boolean } = {}
local nextId = 0
local lastDispatch = 0
local folder: Folder? = nil
local rng = Random.new()

function LootService.Init(c)
	ctx = c
	ctx.MatchService.On("MatchStarting", function(map)
		folder = Instance.new("Folder")
		folder.Name = "Loot"
		folder.Parent = map.Folder
		queue = {}
		packages = {}
		crates = {}
		usedSpots = {}
		lastSpots = {}
		chests = {}
		LootService._restockCrates()
		LootService._spawnChests(map)
	end)
	ctx.MatchService.On("PhaseChanged", function(phase: string, day: number)
		if phase == "Day" then
			if day > 1 then
				LootService._restockCrates()
			end
			local delay = rng:NextNumber(Config.CarePackage.FreeDropDelayMin, Config.CarePackage.FreeDropDelayMax)
			task.delay(delay, function()
				if ctx.MatchService.Active and ctx.MatchService.Phase == "Day" then
					table.insert(queue, 1, { Source = "Free" })
				end
			end)
		elseif phase == "Night" and #queue > 0 then
			ctx.MatchService.Broadcast("PackagesQueued", { Count = #queue })
		end
	end)
	ctx.MatchService.On("MatchCleanup", function()
		queue = {}
		packages = {}
		crates = {}
		chests = {}
		folder = nil
	end)
	ctx.ChannelService.OnPrompt("OpenChest", LootService._onOpenChest)
	ctx.ChannelService.OnPrompt("OpenPackage", LootService._onOpenPackage)
	ctx.ChannelService.OnPrompt("OpenCrate", LootService._onOpenCrate)
	ctx.Util.Connect("BuyInMatch", "Purchase", LootService._onBuy)
	ctx.PurchaseService.OnGranted("CarePackage", LootService._onPackageGranted)
end

function LootService.Start()
	while true do
		task.wait(1)
		if ctx.MatchService.Active and ctx.MatchService.Phase == "Day" and #queue > 0 then
			if os.clock() - lastDispatch >= Config.CarePackage.QueueSpacing then
				local entry = table.remove(queue, 1)
				if entry then
					lastDispatch = os.clock()
					LootService._drop(entry)
				end
			end
		end
	end
end

-- Care packages ---------------------------------------------------------------------------------

local function landingSpot(): Vector3?
	local map = ctx.MatchService.Map
	local candidates = table.clone(map.DropPoints)
	-- extra random spots near the centre ring and sector glades for variety
	for _ = 1, 8 do
		local a = rng:NextNumber() * math.pi * 2
		local d = rng:NextNumber(20, 60)
		local x, z = map.Origin.X + math.cos(a) * d, map.Origin.Z + math.sin(a) * d
		table.insert(candidates, Vector3.new(x, ctx.WorldService.GroundY(x, z), z))
	end
	for i = #candidates, 2, -1 do
		local j = rng:NextInteger(1, i)
		candidates[i], candidates[j] = candidates[j], candidates[i]
	end
	for _, pos in candidates do
		local ok = true
		for _, pk in packages do
			if not pk.Opened and (pk.Pos - pos).Magnitude < 30 then
				ok = false
				break
			end
		end
		if ok then
			for team = 1, Config.Match.TeamCount do
				local camp = ctx.CampService.GetCamp(team)
				if camp and (camp.FirePos - pos).Magnitude < Config.Build.ZoneRadius + 20 then
					ok = false
					break
				end
			end
		end
		if ok then
			local ground = ctx.WorldService.GroundY(pos.X, pos.Z)
			return Vector3.new(pos.X, ground, pos.Z)
		end
	end
	return nil
end

function LootService._drop(entry: { Source: string, Buyer: string?, BuyerId: number? })
	local pos = landingSpot()
	if not pos or not folder then
		table.insert(queue, 1, entry) -- retry later; never lose a paid drop
		return
	end
	nextId += 1
	local id = nextId
	local start = pos + Vector3.new(0, 160, 0)
	local model = LootModels.CarePackage(CFrame.new(start), folder)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local pk: Package = { Id = id, Model = model, Pos = pos, Landed = false, Opened = false, Source = entry.Source, Buyer = entry.Buyer }
	packages[id] = pk
	ctx.MatchService.Broadcast("CarePackage", {
		Id = id,
		X = pos.X,
		Z = pos.Z,
		Eta = workspace:GetServerTimeNow() + Config.CarePackage.FallTime,
		Source = entry.Source,
		Buyer = entry.Buyer,
	})
	-- Descend (server-driven, anchored)
	task.spawn(function()
		local steps = math.floor(Config.CarePackage.FallTime * 15)
		for i = 1, steps do
			if not model.Parent then
				return
			end
			local t = i / steps
			model:PivotTo(CFrame.new(start:Lerp(pos, t)) * CFrame.Angles(0, t * 2, math.sin(t * 20) * 0.03))
			task.wait(1 / 15)
		end
		if not model.Parent then
			return
		end
		-- Nudge anyone standing exactly on the landing spot so the box never lands inside them.
		for _, p in ctx.Util.MatchPlayers() do
			local r = ctx.Util.Root(p)
			if r and (r.Position - pos).Magnitude < 4 then
				local away = (r.Position - pos) * Vector3.new(1, 0, 1)
				away = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)
				r.CFrame += away * 4 + Vector3.new(0, 1, 0)
			end
		end
		model:PivotTo(CFrame.new(pos))
		LootModels.Land(model)
		pk.Landed = true
		ctx.Util.PlaySound("PackageLand", model.PrimaryPart)
		local prompt = ctx.ChannelService.MakePrompt(model.PrimaryPart, "OpenPackage", "Open", "Care Package", Config.CarePackage.OpenRange)
		prompt:SetAttribute("PackageId", id)
		ctx.MatchService.Broadcast("CarePackageLanded", { Id = id })
	end)
end

function LootService._onOpenPackage(p: Player, prompt: ProximityPrompt)
	local id = prompt:GetAttribute("PackageId") :: number?
	local pk = id and packages[id]
	if not pk or not pk.Landed or pk.Opened or not ctx.Util.IsAlive(p) or not p:GetAttribute("InMatch") then
		return
	end
	ctx.ChannelService.Begin(p, {
		Kind = "OpenPackage",
		Label = "Opening care package",
		Duration = Config.CarePackage.OpenTime,
		Range = Config.CarePackage.OpenRange,
		InterruptOnDamage = true,
		Action = "Open",
		TargetKey = id,
		Position = function()
			return if pk.Opened then nil else pk.Pos
		end,
		OnComplete = function()
			if pk.Opened then
				return
			end
			pk.Opened = true
			local rolls = Loot.RollCarePackage(function()
				return rng:NextNumber()
			end)
			local labels = {}
			for i, entry in rolls do
				table.insert(labels, entry.Label)
				for j, g in entry.Grants do
					local a = (i * 2.1 + j * 0.7)
					local off = Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(2.5, Config.CarePackage.LootScatter)
					ctx.InventoryService.SpawnPickup(g.Item, g.Count, pk.Pos + off + Vector3.new(0, 2, 0), nil, 300)
				end
			end
			ctx.Util.PlaySound("Open", pk.Model.PrimaryPart)
			Net.FireAll("Fx", "PackageOpen", { Pos = pk.Pos })
			pk.Model:Destroy()
			ctx.MatchService.Broadcast("CarePackageOpened", { Id = pk.Id, By = p.DisplayName, ByTeam = ctx.Util.Team(p) })
			ctx.Util.Notify(p, "Package contents: " .. table.concat(labels, ", "), "success")
		end,
	})
end

-- Purchases ---------------------------------------------------------------------------------------

function LootService._enqueuePaid(buyer: Player)
	table.insert(queue, { Source = "Paid", Buyer = buyer.DisplayName, BuyerId = buyer.UserId })
	local atDawn = ctx.MatchService.IsNight()
	ctx.MatchService.Broadcast("PackageCalled", { Buyer = buyer.DisplayName, AtDawn = atDawn, Position = #queue })
end

function LootService._onBuy(p: Player, req: any)
	if type(req) ~= "table" or not p:GetAttribute("InMatch") or not ctx.MatchService.IsPlaying() then
		return
	end
	if type(req.Kind) ~= "string" or not Products.OnSale(req.Kind) then
		ctx.Util.Notify(p, "That isn't sold — Survival Wars never sells gameplay advantages.", "info")
		return
	end
	if req.Kind == "CarePackage" then
		if not ctx.PurchaseService.PaidRandomAllowed(p) then
			ctx.Util.Notify(p, "Paid care packages aren't available in your region. The free daily package still drops for everyone!", "info")
			return
		end
		local session = ctx.DataService.Get(p)
		if session and session.Profile.Credits.CarePackage > 0 and ctx.DataService.CanGrant(p) then
			session.Profile.Credits.CarePackage -= 1
			task.spawn(ctx.DataService.Save, p, false)
			ctx.DataService.Push(p)
			LootService._enqueuePaid(p)
			return
		end
		local ok, why = ctx.PurchaseService.Prompt(p, "CarePackage", { MatchId = ctx.MatchService.MatchId })
		if not ok then
			ctx.Util.Notify(p, why or "Unavailable", "error")
		end
	elseif req.Kind == "Bandage" then
		local ok, why = ctx.PurchaseService.Prompt(p, "Bandage", { MatchId = ctx.MatchService.MatchId })
		if not ok then
			ctx.Util.Notify(p, why or "Unavailable", "error")
		end
	end
end

function LootService._onPackageGranted(p: Player)
	local session = ctx.DataService.Get(p)
	if p:GetAttribute("InMatch") and ctx.MatchService.IsPlaying() and session and session.Profile.Credits.CarePackage > 0 then
		session.Profile.Credits.CarePackage -= 1
		task.spawn(ctx.DataService.Save, p, false)
		ctx.DataService.Push(p)
		LootService._enqueuePaid(p)
	else
		ctx.Util.Notify(p, "Care package call saved as a credit — use it from the shop in your next match.", "info")
	end
end

-- Forest crates -------------------------------------------------------------------------------------

function LootService._restockCrates()
	local map = ctx.MatchService.Map
	if not map or not folder then
		return
	end
	local spots = map.Layout.CrateSpots
	local O = map.Origin
	for sector = 0, 4 do
		local want = if sector == 0 then Config.Crates.Center else Config.Crates.PerSector
		local have = 0
		for _, c in crates do
			if spots[c.Spot].Sector == sector then
				have += 1
			end
		end
		local options = {}
		for i, s in spots do
			if s.Sector == sector and not usedSpots[i] and not lastSpots[i] then
				table.insert(options, i)
			end
		end
		for i = #options, 2, -1 do
			local j = rng:NextInteger(1, i)
			options[i], options[j] = options[j], options[i]
		end
		for k = 1, math.min(want - have, #options) do
			local idx = options[k]
			local s = spots[idx]
			local x, z = s.X + O.X, s.Z + O.Z
			local pos = Vector3.new(x, ctx.WorldService.GroundY(x, z) - 0.1, z)
			nextId += 1
			local model = LootModels.ForestCrate(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber() * 6.28, 0), folder)
			model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
			local prompt = ctx.ChannelService.MakePrompt(model.PrimaryPart, "OpenCrate", "Open", "Supply Crate", Config.Crates.OpenRange)
			prompt:SetAttribute("CrateId", nextId)
			crates[nextId] = { Id = nextId, Model = model, Pos = pos, Spot = idx }
			usedSpots[idx] = true
		end
	end
	lastSpots = {}
end

function LootService._onOpenCrate(p: Player, prompt: ProximityPrompt)
	local id = prompt:GetAttribute("CrateId") :: number?
	local crate = id and crates[id]
	if not crate or not ctx.Util.IsAlive(p) or not p:GetAttribute("InMatch") then
		return
	end
	ctx.ChannelService.Begin(p, {
		Kind = "OpenCrate",
		Label = "Opening crate",
		Duration = Config.Crates.OpenTime,
		Range = Config.Crates.OpenRange,
		InterruptOnDamage = true,
		Action = "Open",
		Position = function()
			return if crates[crate.Id] then crate.Pos else nil
		end,
		OnComplete = function()
			if not crates[crate.Id] then
				return
			end
			crates[crate.Id] = nil
			usedSpots[crate.Spot] = nil
			lastSpots[crate.Spot] = true -- next restock picks a different spot
			local entry = Loot.Roll(Loot.Crate, function()
				return rng:NextNumber()
			end)
			for j, g in entry.Grants do
				local off = Vector3.new(math.cos(j * 2.1), 0, math.sin(j * 2.1)) * 2
				ctx.InventoryService.SpawnPickup(g.Item, g.Count, crate.Pos + off + Vector3.new(0, 1.5, 0))
			end
			ctx.Util.PlaySound("Open", crate.Model.PrimaryPart)
			crate.Model:Destroy()
			ctx.PowerupService.OnCrateOpened(p, crate.Id)
		end,
	})
end

-- POI chests -----------------------------------------------------------------------------------------

function LootService._spawnChests(map: any)
	if not folder then
		return
	end
	for _, spot in map.ChestSpots or {} do
		local model = Landmarks.Chest(spot.CF, spot.Tier, folder)
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		local prompt = ctx.ChannelService.MakePrompt(model.PrimaryPart, "OpenChest", "Search", CHEST_NAME[spot.Tier] or "Chest", Config.Crates.OpenRange)
		prompt:SetAttribute("ChestKey", spot.Key)
		prompt:SetAttribute("Rarity", spot.Tier)
		chests[spot.Key] = { Key = spot.Key, Model = model, Pos = model:GetPivot().Position, Tier = spot.Tier, Poi = spot.Poi, Opened = false }
	end
end

function LootService._onOpenChest(p: Player, prompt: ProximityPrompt)
	local key = prompt:GetAttribute("ChestKey") :: string?
	local chest = key and chests[key]
	if not chest or chest.Opened or not ctx.Util.IsAlive(p) or not p:GetAttribute("InMatch") then
		return
	end
	local other = ctx.ChannelService.AnyOnTarget("OpenChest", chest.Key)
	if other and other ~= p then
		ctx.Util.Notify(p, other.DisplayName .. " is already searching this chest.", "warn")
		return
	end
	ctx.ChannelService.Begin(p, {
		Kind = "OpenChest",
		Label = "Searching the " .. (CHEST_NAME[chest.Tier] or "chest"):lower(),
		Duration = (CHEST_TIME[chest.Tier] or 3) / ctx.PowerupService.SearchSpeedMult(p),
		Range = Config.Crates.OpenRange,
		InterruptOnDamage = true,
		Action = "Open",
		TargetKey = chest.Key,
		Position = function()
			return if chests[chest.Key] and not chest.Opened then chest.Pos else nil
		end,
		OnComplete = function()
			if chest.Opened then
				return
			end
			chest.Opened = true
			prompt.Enabled = false
			Landmarks.OpenChest(chest.Model)
			local roll = Loot.RollChest(chest.Tier, function()
				return rng:NextNumber()
			end)
			-- Scavenger: small chance of an extra common roll
			if rng:NextNumber() < ctx.PowerupService.ExtraLootChance(p) then
				table.insert(roll, Loot.Roll(Loot.Chest.Common, function()
					return rng:NextNumber()
				end))
			end
			-- item reveal for the searcher (rarer chests get a richer card)
			local found = {}
			for _, entry in roll do
				for _, g in entry.Grants do
					table.insert(found, { Id = g.Item, Count = g.Count })
				end
			end
			Net.FireClient("MatchEvent", p, "LootReveal", { Tier = chest.Tier, Items = found })
			local k = 0
			for _, entry in roll do
				for _, g in entry.Grants do
					k += 1
					local off = Vector3.new(math.cos(k * 1.9), 0, math.sin(k * 1.9)) * 2.2
					ctx.InventoryService.SpawnPickup(g.Item, g.Count, chest.Pos + off + Vector3.new(0, 1.5, 0))
				end
			end
			ctx.Util.PlaySound("ChestOpen", chest.Model.PrimaryPart)
			Net.FireAll("Fx", "ChestOpened", { Pos = chest.Pos, Tier = chest.Tier })
			ctx.PowerupService.OnChestOpened(p, chest.Tier, chest.Poi)
		end,
	})
end

-- Unopened POI chests within `radius` (Scavenger container sense).
function LootService.ChestsNear(pos: Vector3, radius: number): { Vector3 }
	local out = {}
	for _, c in chests do
		if not c.Opened and (c.Pos - pos).Magnitude <= radius then
			table.insert(out, c.Pos)
		end
	end
	return out
end

function LootService.CratesNear(pos: Vector3, radius: number): { Vector3 }
	local out = {}
	for _, c in crates do
		if (c.Pos - pos).Magnitude <= radius then
			table.insert(out, c.Pos)
		end
	end
	return out
end

return LootService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="885">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Match state machine: arrival → intro → Day/Night cycle → end → return.
--
-- Public state replicates through attributes on ReplicatedStorage.MatchState:
--   Phase ("Idle" | "Loading" | "Intro" | "Day" | "Night" | "Ended"), PhaseEnds (server time),
--   Day (number), Fire1..4 (bool), Standing1..4 (bool), Alive1..4 (int), Winner (int), MatchId.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Logic = Shared:WaitForChild("Logic")
local LivesRules = require(Logic:WaitForChild("LivesRules"))
local ProfileRules = require(Logic:WaitForChild("ProfileRules"))
local TeamAssignment = require(Logic:WaitForChild("TeamAssignment"))
local FireRules = require(Logic:WaitForChild("FireRules"))

local MatchService = {}

local ctx: any
local state: Folder
local hooks: { [string]: { (...any) -> () } } = {}

MatchService.Active = false
MatchService.Phase = "Idle"
MatchService.Day = 0
MatchService.MatchId = ""
MatchService.StartedTeams = {} :: { number }
MatchService.Roster = {} :: { [number]: number } -- userId -> team
MatchService.Participants = {} :: { [number]: boolean } -- userId -> was in the match at start
MatchService.Map = nil :: any
MatchService.State = (nil :: any) :: Folder -- ReplicatedStorage.MatchState, set in Init
local phaseToken = 0
local ending = false
local elimOrder: { number } = {} -- teams in the order they were eliminated (for placements)

function MatchService.On(event: string, fn: (...any) -> ())
	hooks[event] = hooks[event] or {}
	table.insert(hooks[event], fn)
end

local function emit(event: string, ...: any)
	for _, fn in hooks[event] or {} do
		local args = table.pack(...)
		task.spawn(function()
			local ok, err = pcall(fn, table.unpack(args, 1, args.n))
			if not ok then
				warn("[MatchService] hook " .. event .. " error:", err)
			end
		end)
	end
end

function MatchService.Init(c)
	ctx = c
	ctx.Util.Connect("LeaveMatch", "Lobby", MatchService._onLeaveMatch)
	state = Instance.new("Folder")
	state.Name = "MatchState"
	state.Parent = ReplicatedStorage
	MatchService.State = state
	MatchService._setPhase("Idle", 0)
	ctx.Util.OnPlayerRemoving(MatchService._onLeave)
end

function MatchService.Start()
	if ctx.Mode == "Match" then
		MatchService._runReserved()
	end
end

function MatchService.Broadcast(eventName: string, payload: any)
	Net.FireList("MatchEvent", ctx.Util.MatchPlayers(), eventName, payload)
end

function MatchService._setPhase(phase: string, duration: number)
	MatchService.Phase = phase
	state:SetAttribute("Phase", phase)
	state:SetAttribute("PhaseEnds", workspace:GetServerTimeNow() + duration)
	state:SetAttribute("Day", MatchService.Day)
end

local function phaseLength(kind: string): number
	if ctx.IsStudio and Config.Dev.StudioPhaseLength then
		return Config.Dev.StudioPhaseLength
	end
	return if kind == "Day" then Config.Match.DayLength else Config.Match.NightLength
end

-- Reserved (production) match server -------------------------------------------------------

function MatchService._runReserved()
	MatchService._setPhase("Loading", Config.Match.ArrivalTimeout)
	local manifest = ctx.MatchmakingService.ReadManifest(game.PrivateServerId)
	if not manifest then
		warn("[MatchService] no manifest for this reserved server; returning players")
		task.wait(5)
		MatchService.ReturnToLobby(Players:GetPlayers(), "Match could not be found.")
		return
	end
	-- manifest.Teams = { { { Id = partyId, Members = { userId... } } ... } x4 }
	local expected: { [number]: boolean } = {}
	for _, team in manifest.Teams do
		for _, party in team do
			for _, uid in party.Members do
				expected[uid] = true
			end
		end
	end
	-- Kick back anyone not in the manifest (late arrivals / strangers).
	ctx.Util.OnPlayerAdded(function(p: Player)
		if not expected[p.UserId] or MatchService.Active then
			task.wait(2)
			MatchService.ReturnToLobby({ p }, "That match already started. Queue again for the next one!")
		end
	end)
	local deadline = os.clock() + Config.Match.ArrivalTimeout
	while os.clock() < deadline do
		local allHere = true
		for uid in expected do
			if not Players:GetPlayerByUserId(uid) then
				allHere = false
				break
			end
		end
		if allHere then
			break
		end
		task.wait(1)
	end
	-- Build party lists with arrived members only, then rebalance if a team emptied (D4).
	local teams = {}
	for t, team in manifest.Teams do
		teams[t] = {}
		for _, party in team do
			local members = {}
			for _, uid in party.Members do
				if Players:GetPlayerByUserId(uid) then
					table.insert(members, uid)
				end
			end
			table.insert(teams[t], { Id = party.Id, Size = #members, Members = members })
		end
	end
	local balanced = TeamAssignment.Rebalance(teams, Config.Match.MaxPerTeam)
	local assignment: { [Player]: number } = {}
	local populated = 0
	for t = 1, Config.Match.TeamCount do
		local any = false
		for _, party in balanced[t] or {} do
			for _, uid in party.Members or {} do
				local p = Players:GetPlayerByUserId(uid)
				if p then
					assignment[p] = t
					any = true
				end
			end
		end
		if any then
			populated += 1
		end
	end
	if populated < 2 then
		MatchService.ReturnToLobby(Players:GetPlayers(), "Not enough players arrived for a fair match. Please ready up again.", true)
		return
	end
	MatchService.Begin(assignment, manifest.MatchId or game.PrivateServerId)
end

-- Starts a match with players already assigned to teams. Used by both the
-- reserved-server path and the Studio local mode.
function MatchService.Begin(assignment: { [Player]: number }, matchId: string?)
	assert(not MatchService.Active, "match already active")
	MatchService.Active = true
	ending = false
	MatchService.MatchId = matchId or HttpService:GenerateGUID(false)
	MatchService.Day = 0
	MatchService.Roster = {}
	MatchService.Participants = {}
	state:SetAttribute("MatchId", MatchService.MatchId)
	state:SetAttribute("Winner", 0)
	state:SetAttribute("SnuffOpen", false)
	MatchService._setPhase("Loading", 30)
	Net.FireList("MatchEvent", (function()
		local list = {}
		for p in assignment do
			table.insert(list, p)
		end
		return list
	end)(), "Loading", {})

	local seed = math.floor(os.time() % 1000000) + math.random(1, 9999)
	local buildStart = os.clock()
	local map = ctx.WorldService.BuildMatch(seed)
	print(string.format("[Match] forest built in %.2fs (seed %d)", os.clock() - buildStart, seed))
	MatchService.Map = map

	local started = {}
	for t = 1, Config.Match.TeamCount do
		state:SetAttribute("Fire" .. t, true)
		state:SetAttribute("Standing" .. t, false)
		state:SetAttribute("Alive" .. t, 0)
	end
	for p, t in assignment do
		if p.Parent then
			MatchService.Roster[p.UserId] = t
			MatchService.Participants[p.UserId] = true
			if not table.find(started, t) then
				table.insert(started, t)
			end
		end
	end
	table.sort(started)
	MatchService.StartedTeams = started
	elimOrder = {}
	for t = 1, Config.Match.TeamCount do
		state:SetAttribute("Standing" .. t, table.find(started, t) ~= nil)
	end

	emit("MatchStarting", map)
	for p, t in assignment do
		if p.Parent then
			p:SetAttribute("Team", t)
			p:SetAttribute("InMatch", true)
			emit("PlayerJoinedMatch", p, t)
		end
	end
	-- Give services a moment to set up camps/nodes, then spawn everyone.
	task.wait(0.5)
	for p, t in assignment do
		if p.Parent then
			ctx.LivesService.SpawnAtCamp(p)
		end
	end

	MatchService._setPhase("Intro", Config.Match.IntroLength)
	-- Publish the initial Alive counts (otherwise they read 0 until the first death).
	MatchService.CheckOutcome()
	MatchService.Broadcast("Intro", { Seconds = Config.Match.IntroLength })
	task.wait(Config.Match.IntroLength)
	if not MatchService.Active then
		return
	end
	MatchService._cycle()
end

-- Runs Day/Night forever (no time limit) starting at `first`.
function MatchService._cycle(first: string?)
	phaseToken += 1
	local token = phaseToken
	task.spawn(function()
		local phase = first or "Day"
		while MatchService.Active and not ending and token == phaseToken do
			if phase == "Day" then
				MatchService.Day += 1
			end
			MatchService._enterPhase(phase)
			task.wait(phaseLength(phase))
			phase = if phase == "Day" then "Night" else "Day"
		end
	end)
end

-- Dev/test helper: jump straight to the next phase.
function MatchService.SkipPhase()
	if MatchService.Active and not ending and (MatchService.Phase == "Day" or MatchService.Phase == "Night") then
		MatchService._cycle(if MatchService.Phase == "Day" then "Night" else "Day")
	end
end

function MatchService._enterPhase(phase: string)
	MatchService._setPhase(phase, phaseLength(phase))
	-- weather: an occasional rain shower for the whole phase (visual only, never on Day 1)
	local rain = MatchService.Day > 1 and math.random() < Config.Lighting.RainChance
	state:SetAttribute("Weather", if rain then "Rain" else "Clear")
	if phase == "Day" then
		-- Dawn -> Day -> Sunset across the day (cancelled if the phase changes).
		ctx.WorldService.ApplyLighting("Dawn", false)
		local token = phaseToken
		local len = phaseLength(phase)
		task.delay(math.min(Config.Lighting.DawnTime, len * 0.2), function()
			if token == phaseToken and MatchService.Phase == "Day" then
				ctx.WorldService.ApplyLighting("Day", false)
			end
		end)
		task.delay(len * Config.Lighting.AfternoonAt, function()
			if token == phaseToken and MatchService.Phase == "Day" then
				ctx.WorldService.ApplyLighting("Afternoon", false)
			end
		end)
		task.delay(len * Config.Lighting.SunsetAt, function()
			if token == phaseToken and MatchService.Phase == "Day" then
				ctx.WorldService.ApplyLighting("Sunset", false)
				MatchService.Broadcast("Sunset", { Day = MatchService.Day })
			end
		end)
	else
		ctx.WorldService.ApplyLighting(phase, false)
	end
	local wasOpen = state:GetAttribute("SnuffOpen") == true
	local open = FireRules.SnuffAllowed(phase, MatchService.Day, Config.Fire :: any)
	state:SetAttribute("SnuffOpen", open)
	MatchService.Broadcast("Phase", { Phase = phase, Day = MatchService.Day, SnuffOpen = open, ProtectionEnded = open and not wasOpen })
	emit("PhaseChanged", phase, MatchService.Day)
end

function MatchService.IsNight(): boolean
	return MatchService.Active and MatchService.Phase == "Night"
end

function MatchService.IsPlaying(): boolean
	return MatchService.Active and (MatchService.Phase == "Day" or MatchService.Phase == "Night" or MatchService.Phase == "Intro")
end

-- Fires --------------------------------------------------------------------------------

function MatchService.FireBurning(team: number): boolean
	return state:GetAttribute("Fire" .. team) == true
end

function MatchService.ExtinguishFire(team: number, byPlayer: Player?)
	if not MatchService.FireBurning(team) then
		return
	end
	state:SetAttribute("Fire" .. team, false)
	emit("FireOut", team, byPlayer)
	local teamDef = Config.Teams[team]
	MatchService.Broadcast("FireOut", { Team = team, By = if byPlayer then byPlayer.DisplayName else nil, ByTeam = if byPlayer then ctx.Util.Team(byPlayer) else nil })
	ctx.Util.NotifyTeam(team, "Your fire is OUT. You're on your FINAL LIFE — your next death eliminates you.", "danger")
	print(string.format("[Match] %s fire extinguished%s", teamDef.Name, if byPlayer then " by " .. byPlayer.Name else ""))
	MatchService.CheckOutcome()
end

-- Outcome ------------------------------------------------------------------------------

function MatchService.CheckOutcome()
	if not MatchService.Active or ending or MatchService.Phase == "Loading" then
		return
	end
	local standing = {}
	for t = 1, Config.Match.TeamCount do
		local lives = ctx.LivesService.TeamLives(t)
		standing[t] = LivesRules.TeamStanding(lives)
		local alive = 0
		for _, l in lives do
			if l.State == "Alive" then
				alive += 1
			end
		end
		state:SetAttribute("Alive" .. t, alive)
		local was = state:GetAttribute("Standing" .. t)
		state:SetAttribute("Standing" .. t, standing[t])
		if was and not standing[t] and table.find(MatchService.StartedTeams, t) then
			if not table.find(elimOrder, t) then
				table.insert(elimOrder, t)
			end
			MatchService.Broadcast("TeamEliminated", { Team = t })
			emit("TeamEliminated", t)
		end
	end
	local result, winner = LivesRules.Outcome(standing, MatchService.StartedTeams, ctx.IsStudio and Config.Dev.StudioAllowSingleTeam)
	if result == "Winner" then
		MatchService.End(winner)
	elseif result == "NoTeams" then
		MatchService.End(nil)
	end
end

function MatchService.End(winner: number?)
	if ending then
		return
	end
	ending = true
	phaseToken += 1
	state:SetAttribute("Winner", winner or 0)
	MatchService._setPhase("Ended", Config.Match.EndScreenLength)
	emit("MatchEnded", winner)

	-- Rewards: placements (1st / 2nd / 3rd by elimination order) are granted
	-- exactly once per MatchId (ProfileRules.AwardPlacement); everyone gets an
	-- XP / Coins summary of what they earned during the match.
	local started = #MatchService.StartedTeams
	local function placeOf(team: number): number?
		if winner and team == winner then
			return 1
		end
		local idx = table.find(elimOrder, team)
		return if idx then started - idx + 1 else nil
	end
	local summaries = {}
	for _, p in Players:GetPlayers() do
		local team = MatchService.Roster[p.UserId]
		if MatchService.Participants[p.UserId] and team then
			local place = placeOf(team)
			local session = ctx.DataService.Get(p)
			local earned = ctx.PowerupService.Earned(p) or { XP = 0, Coins = 0, Diamonds = 0, Levels = 0 }
			local sum = { Place = place, Of = started, XP = earned.XP, Coins = earned.Coins, Diamonds = earned.Diamonds, Levels = earned.Levels, Stats = ctx.PowerupService.Stats(p), Nights = MatchService.Day or 0 }
			if session and ctx.DataService.CanGrant(p) then
				session.Profile.Matches += 1
				ProfileRules.NoteMatch(session.Profile, os.time(), place == 1)
				if place and place <= 3 then
					local before = session.Profile.Level
					local xp, coins, diamonds = ProfileRules.AwardPlacement(session.Profile, MatchService.MatchId, place, Config.Data.RewardedMatchMemory)
					sum.XP += xp
					sum.Coins += coins
					sum.Diamonds += diamonds
					sum.Levels += session.Profile.Level - before
				end
				sum.Level = session.Profile.Level
				task.spawn(function()
					ctx.DataService.Save(p, false)
					ctx.DataService.Push(p)
					ctx.DataService.PostLeaderboards(p)
				end)
			end
			summaries[p] = sum
		end
	end
	for _, p in ctx.Util.MatchPlayers() do
		local won = winner ~= nil and ctx.Util.Team(p) == winner
		local sum = summaries[p] or {}
		Net.FireClient("MatchEvent", p, "MatchEnded", {
			Winner = winner or 0,
			Won = won,
			Diamonds = sum.Diamonds or 0,
			Summary = sum,
		})
		if won then
			ctx.CosmeticService.OnVictory(p)
		end
	end
	print("[Match] ended; winner:", winner and Config.Teams[winner].Name or "none")

	task.delay(Config.Match.EndScreenLength, function()
		MatchService._teardown()
	end)
end

function MatchService._teardown()
	local players = ctx.Util.MatchPlayers()
	emit("MatchCleanup")
	MatchService.Active = false
	for _, p in players do
		p:SetAttribute("InMatch", false)
		p:SetAttribute("Team", 0)
	end
	if ctx.Mode == "Match" then
		MatchService.ReturnToLobby(Players:GetPlayers(), nil)
	else
		ctx.WorldService.ClearMatch()
		MatchService.Map = nil
		ctx.WorldService.ApplyLighting(if ctx.Mode == "Lobby" then "Lobby" else "Day", true)
		state:SetAttribute("Weather", nil)
		MatchService._setPhase("Idle", 0)
		for _, p in players do
			if p.Parent then
				ctx.LivesService.SpawnInLobby(p)
				Net.FireClient("MatchEvent", p, "ReturnedToLobby", {})
			end
		end
	end
end

-- Returns players to a public lobby server (production) or the local lobby (Studio).
function MatchService.ReturnToLobby(players: { Player }, message: string?, priority: boolean?)
	if #players == 0 then
		return
	end
	for _, p in players do
		if message then
			ctx.Util.Notify(p, message, "info")
		end
	end
	if ctx.Mode ~= "Match" or ctx.IsStudio then
		for _, p in players do
			p:SetAttribute("InMatch", false)
			ctx.LivesService.SpawnInLobby(p)
		end
		return
	end
	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({ ReturnFromMatch = true, Priority = priority == true })
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, players, options)
		end)
		if ok then
			return
		end
		warn("[MatchService] return teleport failed:", err)
		task.wait(attempt * 2)
	end
	for _, p in players do
		p:Kick("Match over — please rejoin Survival Hour.")
	end
end

-- Eliminated players may leave early (their placement is already decided).
function MatchService._onLeaveMatch(p: Player)
	if not MatchService.Active or not p:GetAttribute("InMatch") or p:GetAttribute("LifeState") ~= "Eliminated" then
		return
	end
	if ctx.Mode == "Match" then
		MatchService.ReturnToLobby({ p }, nil)
	else
		p:SetAttribute("InMatch", false)
		p:SetAttribute("Team", 0)
		ctx.LivesService.SpawnInLobby(p)
		Net.FireClient("MatchEvent", p, "ReturnedToLobby", {})
	end
end

-- Leavers --------------------------------------------------------------------------------

function MatchService._onLeave(player: Player)
	if not MatchService.Active then
		return
	end
	if player:GetAttribute("InMatch") then
		-- LivesService marks the life as Left; re-check next frame.
		task.defer(MatchService.CheckOutcome)
	end
	if ctx.Mode == "Match" then
		task.delay(1, function()
			if #Players:GetPlayers() == 0 and MatchService.Active then
				-- Everyone left: nothing left to do (reserved servers shut down when empty).
				MatchService.Active = false
				phaseToken += 1
			end
		end)
	end
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="886">
          <Properties>
            <string name="Name">MatchmakingService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Matchmaking.
--
-- LIVE (published place, lobby servers):
--   * Each ready party is written to a MemoryStore sorted map (sort key = queue
--     time, so older parties come first) and refreshed while waiting.
--   * One lobby server at a time holds a short matchmaker lease. It reads the
--     queue, packs parties into 4 teams with TeamAssignment.Select (parties are
--     never split; impossible compositions stay queued), reserves a server, and
--     writes a manifest (keyed by PrivateServerId) plus a per-party assignment.
--   * Every lobby server polls assignments for its own parties and teleports them.
--   * The match server reads the manifest; teleport data is never trusted.
--
-- STUDIO (Config.Dev.StudioLocalMatches): an in-process queue that starts the
-- match inside the same server, with relaxed minimums for solo testing.

local MemoryStoreService = game:GetService("MemoryStoreService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local TeamAssignment = require(Shared:WaitForChild("Logic"):WaitForChild("TeamAssignment"))

local MatchmakingService = {}

local ctx: any
local localQueue: { any } = {} -- LobbyService parties
local lastRefresh: { [string]: number } = {}
local status = { Searching = 0, Mode = "Local" }
local queueMap: MemoryStoreSortedMap? = nil
local assignMap: MemoryStoreSortedMap? = nil
local manifestMap: MemoryStoreSortedMap? = nil
local lockMap: MemoryStoreSortedMap? = nil
local teleporting: { [string]: boolean } = {}

local function live(): boolean
	return ctx.Mode == "Lobby" and not ctx.LocalMatches
end

function MatchmakingService.Init(c)
	ctx = c
	local ok, err = pcall(function()
		queueMap = MemoryStoreService:GetSortedMap(Config.Matchmaking.QueueMapName)
		assignMap = MemoryStoreService:GetSortedMap(Config.Matchmaking.AssignMapName)
		manifestMap = MemoryStoreService:GetSortedMap(Config.Matchmaking.ManifestMapName)
		lockMap = MemoryStoreService:GetSortedMap(Config.Matchmaking.LockKey)
	end)
	if not ok then
		warn("[Matchmaking] MemoryStore unavailable:", err)
	end
	status.Mode = if ctx.LocalMatches then "Local" else "Live"
	TeleportService.TeleportInitFailed:Connect(function(player: Player, result: Enum.TeleportResult, message: string)
		warn("[Matchmaking] teleport failed for", player.Name, result, message)
		ctx.Util.Notify(player, "Couldn't join the match (" .. tostring(message) .. "). Please ready up again.", "error")
		local party = ctx.LobbyService.PartyOf(player)
		if party then
			teleporting[party.Id] = nil
			party.Queued = false
			ctx.LobbyService.RemoveFromQueue(party)
		end
	end)
end

function MatchmakingService.Start()
	if ctx.Mode ~= "Lobby" then
		return
	end
	while true do
		task.wait(Config.Matchmaking.PollInterval)
		local ok, err = pcall(function()
			if live() then
				MatchmakingService._liveTick()
			else
				MatchmakingService._localTick()
			end
		end)
		if not ok then
			warn("[Matchmaking] tick error:", err)
		end
	end
end

function MatchmakingService.Status()
	return status
end

local function partyEntry(party: any)
	local members = {}
	for _, m in party.Members do
		table.insert(members, m.UserId)
	end
	return { Id = party.Id, Members = members, Size = #members, Job = game.JobId }
end

function MatchmakingService.Enqueue(party: any)
	if not table.find(localQueue, party) then
		table.insert(localQueue, party)
	end
	lastRefresh[party.Id] = 0
end

function MatchmakingService.Dequeue(party: any)
	local idx = table.find(localQueue, party)
	if idx then
		table.remove(localQueue, idx)
	end
	lastRefresh[party.Id] = nil
	if live() and queueMap then
		task.spawn(function()
			pcall(function()
				(queueMap :: MemoryStoreSortedMap):RemoveAsync(party.Id)
			end)
		end)
	end
end

-- Local (Studio) ------------------------------------------------------------------------------------

function MatchmakingService._localTick()
	-- prune
	for i = #localQueue, 1, -1 do
		local party = localQueue[i]
		if not party.Queued or #party.Members == 0 then
			table.remove(localQueue, i)
		end
	end
	local total = 0
	for _, party in localQueue do
		total += #party.Members
	end
	status.Searching = total
	if ctx.MatchService.Active or #localQueue == 0 then
		return
	end
	local entries = {}
	for _, party in localQueue do
		table.insert(entries, { Id = party.Id, Size = #party.Members, Party = party })
	end
	local packing = TeamAssignment.Select(entries, Config.Match.TeamCount, Config.Match.MaxPerTeam, Config.Match.MinPlayers)
	local teams: { { any } }
	if packing then
		teams = packing.Teams
	elseif total >= Config.Dev.StudioMinPlayers then
		local oldest = math.huge
		for _, party in localQueue do
			oldest = math.min(oldest, party.QueuedAt)
		end
		if os.clock() - oldest < Config.Dev.StudioFillWait and total < Config.Match.MaxPlayers then
			return
		end
		-- Relaxed Studio assignment: fill the emptiest team that fits, parties intact.
		teams = { {}, {}, {}, {} }
		local sizes = { 0, 0, 0, 0 }
		table.sort(entries, function(a, b)
			return a.Size > b.Size
		end)
		for _, e in entries do
			local best = nil
			for t = 1, 4 do
				if sizes[t] + e.Size <= Config.Match.MaxPerTeam and (best == nil or sizes[t] < sizes[best]) then
					best = t
				end
			end
			if best then
				table.insert(teams[best], e)
				sizes[best] += e.Size
			end
		end
	else
		return
	end
	local assignment: { [Player]: number } = {}
	for t, list in teams do
		for _, e in list do
			local party = e.Party
			for _, m in party.Members do
				if m.Parent then
					assignment[m] = t
				end
			end
			local idx = table.find(localQueue, party)
			if idx then
				table.remove(localQueue, idx)
			end
			ctx.LobbyService.RemoveFromQueue(party)
		end
	end
	if next(assignment) then
		print("[Matchmaking] starting local Studio match")
		task.spawn(ctx.MatchService.Begin, assignment, nil)
	end
end

-- Live -------------------------------------------------------------------------------------------------

function MatchmakingService._liveTick()
	if not queueMap or not assignMap or not manifestMap or not lockMap then
		return
	end
	local qm = queueMap :: MemoryStoreSortedMap
	local am = assignMap :: MemoryStoreSortedMap
	local now = os.time()

	-- 1) Refresh our queued parties (sort key = first-queued time).
	for _, party in localQueue do
		if party.Queued and not teleporting[party.Id] and os.clock() - (lastRefresh[party.Id] or 0) > 30 then
			lastRefresh[party.Id] = os.clock()
			local entry = partyEntry(party)
			entry.QueuedAt = now - math.floor(os.clock() - party.QueuedAt)
			qm:SetAsync(party.Id, entry, Config.Matchmaking.EntryTtl, entry.QueuedAt)
		end
	end

	-- 2) Check assignments for our parties.
	for _, party in table.clone(localQueue) do
		if party.Queued and not teleporting[party.Id] then
			local assignment = am:GetAsync(party.Id)
			if type(assignment) == "table" and type(assignment.AccessCode) == "string" then
				teleporting[party.Id] = true
				MatchmakingService._teleportParty(party, assignment.AccessCode)
			end
		end
	end

	-- 3) Matchmaker lease (10 s) — only one server matches at a time.
	local holder = false
	lockMap:UpdateAsync("lease", function(old)
		if type(old) == "table" and old.Job ~= game.JobId and (old.Until or 0) > now then
			return nil
		end
		holder = true
		return { Job = game.JobId, Until = now + 10 }
	end, 15)

	local range = qm:GetRangeAsync(Enum.SortDirection.Ascending, 100)
	local total = 0
	for _, item in range do
		total += (item.value and item.value.Size) or 0
	end
	status.Searching = total
	if holder then
		MatchmakingService._match(range)
	end
end

function MatchmakingService._match(range: { any })
	local qm = queueMap :: MemoryStoreSortedMap
	local am = assignMap :: MemoryStoreSortedMap
	local mm = manifestMap :: MemoryStoreSortedMap
	local entries = {}
	local oldest = math.huge
	for _, item in range do
		local v = item.value
		if type(v) == "table" and type(v.Members) == "table" and v.Size >= 1 and v.Size <= Config.Match.MaxPerTeam then
			table.insert(entries, { Id = item.key, Size = v.Size, Members = v.Members })
			oldest = math.min(oldest, item.sortKey or os.time())
		end
	end
	local packing = TeamAssignment.Select(entries, Config.Match.TeamCount, Config.Match.MaxPerTeam, Config.Match.MinPlayers)
	if not packing then
		return
	end
	local waited = os.time() - oldest
	if packing.Total < Config.Match.MaxPlayers and waited < Config.Matchmaking.FillWait then
		return -- give the queue a little longer to fill to 16
	end
	local accessCode, privateServerId = TeleportService:ReserveServer(game.PlaceId)
	local matchId = HttpService:GenerateGUID(false)
	local teams = {}
	for t, list in packing.Teams do
		teams[t] = {}
		for _, e in list do
			table.insert(teams[t], { Id = e.Id, Members = e.Members })
		end
	end
	mm:SetAsync(privateServerId, { MatchId = matchId, Teams = teams, Created = os.time() }, 3600)
	for _, list in packing.Teams do
		for _, e in list do
			am:SetAsync(e.Id, { AccessCode = accessCode, MatchId = matchId }, 300)
			qm:RemoveAsync(e.Id)
		end
	end
	print(string.format("[Matchmaking] formed match %s with %d players", matchId, packing.Total))
end

function MatchmakingService._teleportParty(party: any, accessCode: string)
	local members = {}
	for _, m in party.Members do
		if m.Parent then
			table.insert(members, m)
			ctx.Util.Notify(m, "Match found! Travelling to the forest...", "success")
		end
	end
	ctx.LobbyService.RemoveFromQueue(party)
	local idx = table.find(localQueue, party)
	if idx then
		table.remove(localQueue, idx)
	end
	if #members == 0 then
		return
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = accessCode
	options:SetTeleportData({ PartyId = party.Id })
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, members, options)
	end)
	if not ok then
		warn("[Matchmaking] TeleportAsync failed:", err)
		teleporting[party.Id] = nil
		for _, m in members do
			ctx.Util.Notify(m, "Teleport failed. Please ready up again.", "error")
		end
	end
end

-- Match server: read the manifest written by the matchmaker.
function MatchmakingService.ReadManifest(privateServerId: string): any
	if not manifestMap then
		return nil
	end
	for _ = 1, 10 do
		local ok, v = pcall(function()
			return (manifestMap :: MemoryStoreSortedMap):GetAsync(privateServerId)
		end)
		if ok and type(v) == "table" then
			return v
		end
		task.wait(2)
	end
	return nil
end


return MatchmakingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="887">
          <Properties>
            <string name="Name">PowerupService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Classes + power-ups (Shared/Classes, Shared/Perks) and in-match XP / Coin
-- rewards (Shared/Progression, Logic/ProfileRules).
--
-- The equipped class and power-up are read from the profile when the player
-- joins a match and are LOCKED for that match (changed only in the lobby).
-- Every effect is a sidegrade exposed through the multiplier hooks below, which
-- other services already call; nothing here adds raw damage or health.
--
-- Rewards are granted live (so leaving early keeps what you earned) and summed
-- per match for the end screen. Anti-farm: repeat kills on the same victim and
-- wildlife kills are capped per match; nothing is granted in under-filled live
-- matches (Studio always counts).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Classes = require(Shared:WaitForChild("Classes"))
local Perks = require(Shared:WaitForChild("Perks"))
local Progression = require(Shared:WaitForChild("Progression"))
local ProfileRules = require(Shared:WaitForChild("Logic"):WaitForChild("ProfileRules"))

local PowerupService = {}

local KILL_REWARDS_PER_VICTIM = 2
local WILDLIFE_REWARDS_PER_MATCH = 25
local POI_RADIUS = 34
local SENSE_INTERVAL = 3
local TRACK_RADIUS = 70
local BLOOD_DELAY = 4 -- seconds before a blood trail point becomes visible (no live tracking)
local BLOOD_LIFE = 20
local HURT_CUE_RADIUS = 60
local SECOND_WIND_HP = 25
local SECOND_WIND_TIME = 5
local SECOND_WIND_SPEED = 0.2

local PREDATORS = { Wolf = true, Bear = true, Boar = true }

type PState = {
	Class: string,
	Perk: string?,
	Effects: { [string]: number },
	Earned: { XP: number, Coins: number, Diamonds: number, Levels: number, Lines: { [string]: number } },
	KillsOn: { [number]: number },
	WildlifeRewards: number,
	Stats: { Kills: number, Animals: number, Chests: number },
	Pois: { [number]: boolean },
	SecondWindUsed: boolean,
	SecondWindUntil: number,
	LastSense: number,
}

local ctx: any
local states: { [Player]: PState } = {}
local blood: { { Pos: Vector3, At: number, UserId: number } } = {}
local workbenchRewarded: { [number]: boolean } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function eff(p: Player, key: string): number
	local st = states[p]
	return if st then st.Effects[key] or 0 else 0
end

local function merge(into: { [string]: number }, from: { [string]: number })
	for k, v in from do
		into[k] = (into[k] or 0) + v
	end
end

function PowerupService.Init(c)
	ctx = c
	ctx.MatchService.On("PlayerJoinedMatch", PowerupService._lock)
	ctx.MatchService.On("MatchCleanup", function()
		states = {}
		blood = {}
		workbenchRewarded = {}
	end)
	ctx.MatchService.On("PhaseChanged", function(phase: string, day: number)
		-- Surviving a night: everyone still alive at sunrise (Day 2 onwards).
		if phase == "Day" and day > 1 then
			for p in states do
				if p.Parent and ctx.Util.IsAlive(p) then
					PowerupService.Reward(p, "SurviveNight", "Survived night " .. (day - 1))
				end
			end
		end
	end)
	ctx.Util.OnPlayerRemoving(function(p)
		states[p] = nil
	end)
	-- Retired active abilities: tell clients there is none.
	ctx.Util.Connect("UseAbility", "Default", function() end)
end

-- Reads (and locks) class + power-up for this match.
function PowerupService._lock(p: Player)
	local session = ctx.DataService.Get(p)
	local profile = session and session.Profile
	local classId = if profile and Classes.ById[profile.Class] and profile.OwnedClasses[profile.Class] then profile.Class else Classes.Default
	local perkId = if profile and profile.Perk and Perks.ById[profile.Perk] and profile.OwnedPerks[profile.Perk] then profile.Perk else nil
	local effects = {}
	merge(effects, Classes.ById[classId].Effects)
	if perkId then
		merge(effects, Perks.ById[perkId].Effects)
	end
	states[p] = {
		Class = classId,
		Perk = perkId,
		Effects = effects,
		Earned = { XP = 0, Coins = 0, Diamonds = 0, Levels = 0, Lines = {} },
		KillsOn = {},
		WildlifeRewards = 0,
		Stats = { Kills = 0, Animals = 0, Chests = 0 },
		Pois = {},
		SecondWindUsed = false,
		SecondWindUntil = 0,
		LastSense = 0,
	}
	PowerupService._sync(p)
end

function PowerupService.Start()
	while true do
		task.wait(0.25)
		if ctx.MatchService.Active then
			PowerupService._tick()
		end
	end
end

function PowerupService._tick()
	local map = ctx.MatchService.Map
	local t = now()
	for p, st in states do
		local hum = ctx.Util.Humanoid(p)
		local root = ctx.Util.Root(p)
		if hum and root and hum.Health > 0 then
			-- Movement speed (brush slowdown; Hunter moves through it more easily)
			local speed = Config.Player.WalkSpeed
			if map then
				for _, b in map.Brush do
					if Vector3.new(root.Position.X - b.Pos.X, 0, root.Position.Z - b.Pos.Z).Magnitude < b.R then
						speed *= if (st.Effects.QuietBrush or 0) > 0 then 0.92 else 0.82
						break
					end
				end
			end
			if t < st.SecondWindUntil then
				speed *= 1 + SECOND_WIND_SPEED
			end
			local want = if ctx.BuildService.IsHeld(p) then 0 else speed * ctx.StaminaService.SpeedMult(p) * (if ctx.ChannelService.IsBusy(p, "Heal") then Config.Healing.MoveSlow else 1)
			-- ease speed changes (sprint builds up over ~0.5 s, stopping is quicker); traps snap to 0
			local cur = hum.WalkSpeed
			if want == 0 or math.abs(want - cur) < 0.5 then
				hum.WalkSpeed = want
			else
				hum.WalkSpeed = cur + (want - cur) * (if want > cur then 0.55 else 0.8)
			end
			-- Second Wind (automatic, once per life)
			if (st.Effects.SecondWind or 0) > 0 and not st.SecondWindUsed and hum.Health < SECOND_WIND_HP then
				st.SecondWindUsed = true
				st.SecondWindUntil = t + SECOND_WIND_TIME
				ctx.StaminaService.Refill(p, math.huge)
				p:SetAttribute("Bursting", st.SecondWindUntil)
				ctx.Util.Notify(p, "Second Wind! Stamina refilled.", "success")
			end
			-- In a cave (Miner sight; client lighting reads this)
			local inCave = false
			if map then
				for _, cave in map.Caves or {} do
					local l = cave.CF:PointToObjectSpace(root.Position)
					if l.Z > 0 and l.Z < cave.Length + 4 and math.abs(l.X) < cave.Width / 2 + 2 and root.Position.Y < cave.FloorY + 16 then
						inCave = true
						break
					end
				end
				-- POI discovery
				for i, poi in map.Pois or {} do
					if not st.Pois[i] and (poi.Pos - root.Position).Magnitude <= POI_RADIUS then
						st.Pois[i] = true
						PowerupService.Reward(p, "PoiDiscovered", "Discovered a " .. poi.Type)
					end
				end
			end
			if p:GetAttribute("InCave") ~= inCave then
				p:SetAttribute("InCave", inCave)
			end
			-- Periodic senses
			if t - st.LastSense >= SENSE_INTERVAL then
				st.LastSense = t
				PowerupService._sense(p, st, root.Position)
			end
			-- Blood trail sample for Trackers (injured players only)
			if hum.Health < hum.MaxHealth * 0.6 and math.random() < 0.25 then
				table.insert(blood, { Pos = root.Position, At = t, UserId = p.UserId })
			end
		end
	end
	for i = #blood, 1, -1 do
		if t - blood[i].At > BLOOD_LIFE then
			table.remove(blood, i)
		end
	end
end

function PowerupService._sense(p: Player, st: PState, pos: Vector3)
	local fx = st.Effects
	if (fx.TrackWildlife or 0) > 0 then
		local list = {}
		for _, a in ctx.WildlifeService.List() do
			if (a.Root.Position - pos).Magnitude <= TRACK_RADIUS then
				table.insert(list, { Species = a.Species, Pos = a.Root.Position })
			end
		end
		if #list > 0 then
			Net.FireClient("Reveal", p, "Animals", list, SENSE_INTERVAL + 0.5)
		end
	end
	if (fx.ContainerSense or 0) > 0 then
		local list = ctx.LootService.CratesNear(pos, fx.ContainerSense)
		for _, c in ctx.LootService.ChestsNear(pos, fx.ContainerSense) do
			table.insert(list, c)
		end
		if #list > 0 then
			Net.FireClient("Reveal", p, "Crates", list, SENSE_INTERVAL + 0.5)
		end
	end
	if (fx.BloodTrails or 0) > 0 then
		local t = now()
		local list = {}
		for _, b in blood do
			if b.UserId ~= p.UserId and t - b.At >= BLOOD_DELAY and (b.Pos - pos).Magnitude <= TRACK_RADIUS then
				table.insert(list, b.Pos)
			end
		end
		if #list > 0 then
			Net.FireClient("Reveal", p, "Blood", list, SENSE_INTERVAL + 0.5)
		end
	end
end

function PowerupService._sync(p: Player)
	local st = states[p]
	p:SetAttribute("Class", if st then st.Class else nil)
	p:SetAttribute("Perk", if st then st.Perk else nil)
	p:SetAttribute("DrawMult", PowerupService.DrawMult(p))
	p:SetAttribute("ClimbBonus", 0)
	-- There are no active abilities in Survival Wars.
	Net.FireClient("AbilitySync", p, { Id = false })
end

function PowerupService.OnSpawn(p: Player)
	local st = states[p]
	if st then
		st.SecondWindUsed = false
		st.SecondWindUntil = 0
		PowerupService._sync(p)
	else
		p:SetAttribute("ClimbBonus", 0)
		local hum = ctx.Util.Humanoid(p)
		if hum then
			hum.WalkSpeed = Config.Player.WalkSpeed
		end
	end
end

function PowerupService.ClassOf(p: Player): string?
	local st = states[p]
	return st and st.Class
end

function PowerupService.PerkOf(p: Player): string?
	local st = states[p]
	return st and st.Perk
end

-- Multipliers used by other services ------------------------------------------------------------

-- Chop/mine power multiplier for a tool class ("Axe" | "Pickaxe"). Never changes yields.
function PowerupService.ToolSpeedMult(p: Player, toolType: string): number
	return 1 + (if toolType == "Axe" then eff(p, "AxeSpeed") elseif toolType == "Pickaxe" then eff(p, "PickSpeed") else 0)
end

-- Durability lost per successful tool hit (1 = one hit).
function PowerupService.ToolWear(p: Player, toolType: string): number
	local w = 1 + eff(p, "ToolWear") + (if toolType == "Axe" then eff(p, "AxeWear") elseif toolType == "Pickaxe" then eff(p, "PickWear") else 0)
	return math.max(0.3, w)
end

function PowerupService.WildlifeDamageMult(p: Player): number
	return math.max(0.5, 1 + eff(p, "WildlifeDamage"))
end

function PowerupService.ExtraHide(p: Player): number
	return eff(p, "ExtraHide")
end

function PowerupService.SearchSpeedMult(p: Player): number
	return 1 + eff(p, "SearchSpeed")
end

function PowerupService.ExtraLootChance(p: Player): number
	return eff(p, "ExtraLoot")
end

function PowerupService.BreachSpeedMult(p: Player): number
	return 1 + eff(p, "BreachSpeed")
end

-- Durability multiplier for breaching tools (Raider: tools last longer).
function PowerupService.BreachWear(p: Player): number
	return math.max(0.3, 1 + eff(p, "BreachWear"))
end

-- Radius multiplier for the breach "raid noise" heard by nearby enemies.
function PowerupService.BreachNoiseMult(p: Player): number
	return if eff(p, "QuietBreach") > 0 then 0.5 else 1
end

function PowerupService.BonusSlots(p: Player): number
	return eff(p, "BonusSlots")
end

function PowerupService.HealSpeedMult(p: Player): number
	return 1 + eff(p, "HealSpeed")
end

function PowerupService.StaminaMaxMult(p: Player): number
	return 1 + eff(p, "StaminaMax")
end

function PowerupService.StaminaRegenMult(p: Player): number
	return 1 + eff(p, "StaminaRegen")
end

function PowerupService.SprintMult(p: Player): number
	return 1 + eff(p, "SprintSpeed")
end

function PowerupService.FireFuelMult(p: Player): number
	return 1 + eff(p, "FireFuel")
end

function PowerupService.CraftSpeedMult(p: Player): number
	return 1 + eff(p, "CraftSpeed")
end

-- Bow draw time multiplier (Hunter: faster draw).
function PowerupService.DrawMult(p: Player): number
	return 1 - eff(p, "DrawSpeed")
end

-- Retired multipliers (kept so callers stay simple): no class changes these.
function PowerupService.GatherMult(_p: Player): number
	return 1
end

function PowerupService.DamageMult(_p: Player, _kind: string): number
	return 1
end

function PowerupService.RepairMult(_p: Player): number
	return 1
end

function PowerupService.SpreadMult(_p: Player): number
	return 1
end

function PowerupService.ConsumeFreeRepair(_p: Player): boolean
	return false
end

-- Rewards ----------------------------------------------------------------------------------------

local function rewardsEnabled(): boolean
	if ctx.IsStudio then
		return true
	end
	local n = 0
	for _ in ctx.MatchService.Participants do
		n += 1
	end
	return n >= Config.Match.MinPlayers
end

-- Grants the XP / Coins for `key` (Progression.XP / Progression.Coins) to `p`.
function PowerupService.Reward(p: Player, key: string, line: string?)
	local xp = Progression.XP[key] or 0
	local coins = Progression.Coins[key] or 0
	PowerupService.Grant(p, xp, coins, 0, line or key)
end

function PowerupService.Grant(p: Player, xp: number, coins: number, diamonds: number, line: string)
	local st = states[p]
	local session = ctx.DataService.Get(p)
	if not session or not ctx.DataService.CanGrant(p) or not rewardsEnabled() or (xp <= 0 and coins <= 0 and diamonds <= 0) then
		return
	end
	local res = ProfileRules.AddXP(session.Profile, xp)
	ProfileRules.AddCoins(session.Profile, coins)
	session.Profile.Diamonds += diamonds
	if st then
		st.Earned.XP += xp
		st.Earned.Coins += coins + res.Coins
		st.Earned.Diamonds += diamonds + res.Diamonds
		st.Earned.Levels += res.Levels
		st.Earned.Lines[line] = (st.Earned.Lines[line] or 0) + xp
	end
	Net.FireClient("MatchEvent", p, "Reward", { XP = xp, Coins = coins, Line = line })
	if res.Levels > 0 then
		local extra = {}
		if res.Coins > 0 then
			table.insert(extra, "+" .. res.Coins .. " Coins")
		end
		if res.Diamonds > 0 then
			table.insert(extra, "+" .. res.Diamonds .. " ◆")
		end
		if #res.Cosmetics > 0 then
			table.insert(extra, "new title / nameplate unlocked")
		end
		ctx.Util.Notify(p, "LEVEL " .. res.NewLevel .. "!" .. (if #extra > 0 then "  " .. table.concat(extra, " · ") else ""), "success")
		ctx.DataService.Push(p)
	end
end

-- Totals earned this match (for the end screen).
function PowerupService.Earned(p: Player): { XP: number, Coins: number, Diamonds: number, Levels: number, Lines: { [string]: number } }?
	local st = states[p]
	return st and st.Earned
end

-- Per-match tallies for the end screen (counted even when rewards are off).
function PowerupService.Stats(p: Player): { Kills: number, Animals: number, Chests: number }?
	local st = states[p]
	return st and st.Stats
end

-- Hooks from other services ----------------------------------------------------------------------

function PowerupService.OnPlayerKill(killer: Player, victim: Player, eliminated: boolean?)
	local st = states[killer]
	if not st then
		return
	end
	st.Stats.Kills += 1
	local n = st.KillsOn[victim.UserId] or 0
	st.KillsOn[victim.UserId] = n + 1
	local session = ctx.DataService.Get(killer)
	if session and ctx.DataService.CanGrant(killer) then
		session.Profile.Kills += 1
		if eliminated then
			session.Profile.Eliminations += 1
		end
	end
	if eliminated then
		PowerupService.Reward(killer, "Elimination", "Eliminated " .. victim.DisplayName)
		ctx.CosmeticService.OnElimination(killer, victim)
	elseif n < KILL_REWARDS_PER_VICTIM then
		PowerupService.Reward(killer, "Kill", "Kills")
	end
end

function PowerupService.OnFireExtinguished(p: Player)
	PowerupService.Reward(p, "ExtinguishFire", "Snuffed a fire")
end

function PowerupService.OnWildlifeKill(p: Player, species: string, _night: boolean)
	local st = states[p]
	if st then
		st.Stats.Animals += 1
	end
	if not st or st.WildlifeRewards >= WILDLIFE_REWARDS_PER_MATCH then
		return
	end
	st.WildlifeRewards += 1
	PowerupService.Reward(p, if PREDATORS[species] then "Predator" else "Wildlife", "Hunting")
end

function PowerupService.OnChestOpened(p: Player, tier: string, _poi: string?)
	local st = states[p]
	if st then
		st.Stats.Chests += 1
	end
	PowerupService.Reward(p, if tier == "Rare" or tier == "VeryRare" then "RareChest" else "Chest", "Chests")
end

-- Workbench V: once per camp per match, to the player who finished it.
function PowerupService.OnWorkbenchLevel(p: Player, team: number, level: number)
	if level >= 5 and not workbenchRewarded[team] then
		workbenchRewarded[team] = true
		PowerupService.Reward(p, "WorkbenchV", "Workbench Tier V")
	end
end

-- Tracker: directional cue when a nearby player is hurt (direction only, no position).
function PowerupService.OnPlayerHurt(victim: Player, _amount: number)
	local vroot = ctx.Util.Root(victim)
	if not vroot then
		return
	end
	for p, st in states do
		if p ~= victim and (st.Effects.HurtCues or 0) > 0 then
			local root = ctx.Util.Root(p)
			if root then
				local d = (vroot.Position - root.Position) * Vector3.new(1, 0, 1)
				if d.Magnitude > 4 and d.Magnitude <= HURT_CUE_RADIUS then
					Net.FireClient("MatchEvent", p, "HurtCue", { Bearing = math.deg(math.atan2(d.X, -d.Z)) % 360 })
				end
			end
		end
	end
end

-- Legacy hooks (no longer reward anything on their own).
function PowerupService.OnAnimalKilled(_p: Player, _animalId: number) end
function PowerupService.OnCrateOpened(_p: Player, _crateId: number) end
function PowerupService.OnRepair(_p: Player, _amount: number) end
function PowerupService.OnArrowHit(_p: Player, _victim: Player, _distance: number) end
function PowerupService.OnPickup(_p: Player, _id: string) end

-- Unused but kept for the end-of-match push.
function PowerupService.PushAll()
	for _, p in Players:GetPlayers() do
		if states[p] then
			ctx.DataService.Push(p)
		end
	end
end

return PowerupService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="888">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Robux purchases (developer products).
--
-- Flow:
--   1. A gameplay service validates the request, then calls PurchaseService.Prompt
--      with an optional *intent* (e.g. { Target = userId } for a teammate revive).
--   2. Roblox calls ProcessReceipt. We apply the product to the buyer's profile as
--      a durable change (ProfileRules.ApplyReceipt: idempotent by PurchaseId) and
--      save. Only after a successful save do we return PurchaseGranted.
--   3. Registered consumers (revive, care package, bandage) then try to use the
--      new credit immediately. If they can't (target died, match ended, buyer
--      left), the credit simply stays in the profile (DECISIONS D8).
--
-- Nothing is granted from PromptProductPurchaseFinished (it's only used to
-- release UI locks when a prompt is cancelled).

local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Products = require(Shared:WaitForChild("Products"))
local ProfileRules = require(Shared:WaitForChild("Logic"):WaitForChild("ProfileRules"))

type Intent = { Key: string, Data: { [string]: any }, Time: number, OnCancel: (() -> ())? }

local PurchaseService = {}

local ctx: any
local pending: { [number]: Intent } = {} -- buyer userId -> latest intent
local consumers: { [string]: { (Player, any, { [string]: any }?) -> () } } = {}
local policy: { [Player]: { RandomRestricted: boolean } } = {}
local priceLevels: { [Player]: number } = {}

PurchaseService.EnforceGiftPriceLevels = true

function PurchaseService.Init(c)
	ctx = c
	MarketplaceService.ProcessReceipt = PurchaseService._processReceipt
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, productId: number, isPurchased: boolean)
		local intent = pending[userId]
		if intent and not isPurchased then
			local product = Products.ByKey[intent.Key]
			if product and product.ProductId == productId then
				pending[userId] = nil
				if intent.OnCancel then
					intent.OnCancel()
				end
			end
		end
	end)
	ctx.Util.OnPlayerAdded(function(player: Player)
		-- Paid random items policy (care packages are randomized; DECISIONS D27).
		local restricted = true
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(info) == "table" then
			restricted = info.ArePaidRandomItemsRestricted == true
		elseif ctx.IsStudio then
			restricted = false
		end
		policy[player] = { RandomRestricted = restricted }
		player:SetAttribute("PaidRandomRestricted", restricted)
		-- Regional price level (never cached across sessions).
		local okLvl, levels = pcall(function()
			return (MarketplaceService :: any):GetUsersPriceLevelsAsync({ player.UserId })
		end)
		if okLvl and type(levels) == "table" then
			for _, entry in levels do
				if type(entry) == "table" then
					local uid = entry.UserId or entry.userId
					local lvl = entry.PriceLevel or entry.priceLevel
					if uid == player.UserId and type(lvl) == "number" then
						priceLevels[player] = lvl
					end
				end
			end
		end
	end)
	ctx.Util.OnPlayerRemoving(function(player: Player)
		policy[player] = nil
		priceLevels[player] = nil
		pending[player.UserId] = nil
	end)
end

-- Consumers are called after a successful grant for products of `kind`.
function PurchaseService.OnGranted(kind: string, fn: (Player, any, { [string]: any }?) -> ())
	consumers[kind] = consumers[kind] or {}
	table.insert(consumers[kind], fn)
end

function PurchaseService.PaidRandomAllowed(player: Player): boolean
	local p = policy[player]
	return p ~= nil and not p.RandomRestricted
end

-- Gift rule for teammate revives with regional pricing (DECISIONS D10).
function PurchaseService.GiftAllowed(payer: Player, receiver: Player): boolean
	if not PurchaseService.EnforceGiftPriceLevels or payer == receiver then
		return true
	end
	local a, b = priceLevels[payer], priceLevels[receiver]
	if a == nil or b == nil then
		return true -- API unavailable or regional pricing not in use
	end
	return a >= b
end

function PurchaseService.IsConfigured(key: string): boolean
	return Products.IsConfigured(key)
end

-- Starts a purchase. Returns ok, reason.
function PurchaseService.Prompt(player: Player, key: string, data: { [string]: any }?, onCancel: (() -> ())?): (boolean, string?)
	local product = Products.ByKey[key]
	if not product then
		return false, "Unknown product"
	end
	if not Products.OnSale(key) then
		return false, "That isn't sold — Survival Wars never sells gameplay advantages."
	end
	if product.Kind == "CarePackage" and not PurchaseService.PaidRandomAllowed(player) then
		return false, "Paid care packages are not available in your region"
	end
	if not ctx.Util.Allow(player, "Purchase") then
		return false, "Please wait a moment"
	end
	pending[player.UserId] = { Key = key, Data = data or {}, Time = os.clock(), OnCancel = onCancel }
	if product.ProductId == 0 then
		if ctx.DevEnabled then
			-- Clearly labelled development simulation. Never active in live servers.
			task.spawn(PurchaseService._simulate, player, product)
			return true, "simulated"
		end
		pending[player.UserId] = nil
		return false, "This product isn't set up yet"
	end
	MarketplaceService:PromptProductPurchase(player, product.ProductId)
	return true, nil
end

function PurchaseService._simulate(player: Player, product: any)
	task.wait(0.4)
	ctx.Util.Notify(player, "[DEV] Simulated purchase of '" .. product.Title .. "'. No Robux involved.", "dev")
	local fakeReceipt = {
		PlayerId = player.UserId,
		ProductId = -1,
		PurchaseId = "SIM-" .. HttpService:GenerateGUID(false),
		CurrencySpent = 0,
		_SimProduct = product,
	}
	PurchaseService._grant(player, product, fakeReceipt.PurchaseId)
end

function PurchaseService._processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local product = Products.ById[receipt.ProductId]
	if not product then
		warn("[PurchaseService] receipt for unmapped product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		-- Roblox re-delivers when the buyer joins a server again.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local session = ctx.DataService.WaitFor(player, 30)
	if not session or not ctx.DataService.CanGrant(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok = PurchaseService._grant(player, product, receipt.PurchaseId)
	return if ok then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
end

-- Applies + saves. Returns true when durable.
function PurchaseService._grant(player: Player, product: any, purchaseId: string): boolean
	local session = ctx.DataService.Get(player)
	if not session then
		return false
	end
	local status = ProfileRules.ApplyReceipt(session.Profile, purchaseId, product, Config.Data.ProcessedReceiptMemory)
	local saved = ctx.DataService.Save(player, false)
	if not saved then
		-- The receipt id is recorded in memory; the retry will find it and just save.
		return false
	end
	ctx.DataService.Push(player)
	if status == "Granted" then
		local intent = pending[player.UserId]
		local data: { [string]: any }? = nil
		if intent and intent.Key == product.Key and os.clock() - intent.Time < 600 then
			data = intent.Data
			pending[player.UserId] = nil
		end
		for _, fn in consumers[product.Kind] or {} do
			task.spawn(function()
				local okc, err = pcall(fn, player, product, data)
				if not okc then
					warn("[PurchaseService] consumer error:", err)
				end
			end)
		end
		if product.Kind == "Coins" or product.Kind == "Bundle" or product.Kind == "Diamonds" or product.Kind == "Unlock" or product.Kind == "Upgrade" then
			ctx.Util.Notify(player, "Purchase complete: " .. product.Title, "success")
		end
	end
	return true
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="889">
          <Properties>
            <string name="Name">StaminaService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Stamina (spec: 100). Sprinting drains it, and melee/blocking spend it
-- (CombatService calls Spend). It regenerates after a short pause. Movement speed
-- is still applied by PowerupService's movement loop, which multiplies in SpeedMult.
--
-- Replicated player attributes: Stamina (0..MaxStamina), MaxStamina, Sprinting, Exhausted.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local StaminaService = {}

type St = { Value: number, Want: boolean, Sprinting: boolean, Exhausted: boolean, LastSpend: number, Pushed: number }

local ctx: any
local states: { [Player]: St } = {}
local S = Config.Stamina

local function max(p: Player): number
	return S.Max * ctx.PowerupService.StaminaMaxMult(p)
end

local function get(p: Player): St
	local st = states[p]
	if not st then
		st = { Value = S.Max, Want = false, Sprinting = false, Exhausted = false, LastSpend = 0, Pushed = -1 }
		states[p] = st
	end
	return st
end

function StaminaService.Init(c)
	ctx = c
	ctx.Util.Connect("Sprint", "Default", function(p: Player, want: any)
		get(p).Want = want == true
	end)
	ctx.Util.OnPlayerRemoving(function(p)
		states[p] = nil
	end)
end

function StaminaService.Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		local step = acc
		acc = 0
		local t = os.clock()
		for p, st in states do
			local hum = ctx.Util.Humanoid(p)
			if not hum or hum.Health <= 0 or not p:GetAttribute("InMatch") then
				st.Sprinting = false
				continue
			end
			local m = max(p)
			local moving = hum.MoveDirection.Magnitude > 0.1
			st.Sprinting = st.Want and moving and not st.Exhausted and st.Value > 0
			if st.Sprinting then
				st.Value = math.max(0, st.Value - S.SprintDrain * step)
				st.LastSpend = t
				if st.Value <= 0 then
					st.Exhausted = true
				end
			elseif t - st.LastSpend >= S.RegenDelay then
				st.Value = math.min(m, st.Value + S.Regen * ctx.PowerupService.StaminaRegenMult(p) * step)
			end
			if st.Exhausted and st.Value >= S.MinToSprint then
				st.Exhausted = false
			end
			local shown = math.floor(st.Value + 0.5)
			if shown ~= st.Pushed then
				st.Pushed = shown
				p:SetAttribute("Stamina", shown)
				p:SetAttribute("MaxStamina", math.floor(m + 0.5))
			end
			if p:GetAttribute("Sprinting") ~= st.Sprinting then
				p:SetAttribute("Sprinting", st.Sprinting)
			end
			if p:GetAttribute("Exhausted") ~= st.Exhausted then
				p:SetAttribute("Exhausted", st.Exhausted)
			end
		end
	end)
end

-- Movement speed multiplier (sprint, exhaustion).
function StaminaService.SpeedMult(p: Player): number
	local st = states[p]
	if not st then
		return 1
	end
	if st.Sprinting then
		return S.SprintMult * ctx.PowerupService.SprintMult(p)
	end
	return if st.Exhausted then S.ExhaustedMult else 1
end

function StaminaService.Get(p: Player): number
	return get(p).Value
end

-- Spends stamina for an action. Returns false (nothing spent) if there isn't enough.
function StaminaService.Spend(p: Player, amount: number): boolean
	local st = get(p)
	if st.Value < amount then
		return false
	end
	st.Value -= amount
	st.LastSpend = os.clock()
	return true
end

-- Drains up to `amount` (used by blocking); returns what was drained.
function StaminaService.Drain(p: Player, amount: number): number
	local st = get(p)
	local d = math.min(st.Value, amount)
	st.Value -= d
	st.LastSpend = os.clock()
	if st.Value <= 0 then
		st.Exhausted = true
	end
	return d
end

-- Fresh bar on (re)spawn.
function StaminaService.OnSpawn(p: Player)
	local st = get(p)
	st.Value = max(p)
	st.Exhausted = false
	st.Pushed = -1
end

-- Short boost (Second Wind).
function StaminaService.Refill(p: Player, amount: number)
	local st = get(p)
	st.Value = math.min(max(p), st.Value + amount)
	st.Exhausted = false
end

return StaminaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="890">
          <Properties>
            <string name="Name">StorageService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player-built storage (Wooden Crate I, Reinforced Chest II, Metal Locker III,
-- Survival Safe IV). Capacity is in stack slots (Items[id].Stacks).
--
-- Raids (spec): enemies BREACH a storage to unlock it. Breaching never deletes
-- anything: once breached, any enemy can open it and take what fits in their pack.
-- The owner can RESECURE it (short hold + a few materials). Breach time depends on
-- the storage tier and the tool: any axe/pickaxe on low tiers, a Crowbar for Metal
-- Lockers, a Sledgehammer for Survival Safes, or a Breaching Charge on anything.
-- Breaches are loud: players nearby get a warning, the owner gets a direction.
-- All transfers go through StorageLedger (validated, single synchronous step).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Net = require(Shared:WaitForChild("Net"))
local Logic = Shared:WaitForChild("Logic")
local StorageLedger = require(Logic:WaitForChild("StorageLedger"))
local InventoryModel = require(Logic:WaitForChild("InventoryModel"))
local Models = Shared:WaitForChild("Models")
local Structures = require(Models:WaitForChild("Structures"))

local StorageService = {}

type Entry = { Store: StorageLedger.Store, Structure: any, Key: string, Tier: number, Breached: boolean }

local ctx: any
local byKey: { [string]: Entry } = {}
local viewers: { [Player]: string } = {} -- player -> storage key they have open
local lastAlert: { [string]: number } = {}
local S = Config.Storage

function StorageService.Init(c)
	ctx = c
	ctx.Util.Connect("StorageAction", "Interact", StorageService._onAction)
	ctx.ChannelService.OnPrompt("StorageOpen", StorageService._onOpen)
	ctx.ChannelService.OnPrompt("StorageSteal", StorageService._onEnemyPrompt)
	ctx.ChannelService.OnPrompt("StorageResecure", StorageService._onResecure)
	ctx.MatchService.On("MatchCleanup", function()
		byKey = {}
		viewers = {}
		lastAlert = {}
	end)
	ctx.Util.OnPlayerRemoving(function(p)
		viewers[p] = nil
	end)
end

local function roman(n: number): string
	return ({ "I", "II", "III", "IV", "V" })[n] or tostring(n)
end

function StorageService.Register(s: any)
	local def = Items[s.Id]
	local e: Entry = {
		Store = StorageLedger.New(def.Stacks or S.Capacity),
		Structure = s,
		Key = s.Key,
		Tier = def.Tier or 1,
		Breached = false,
	}
	byKey[s.Key] = e
	s.Model:SetAttribute("StorageKey", s.Key)
	local root = s.Model.PrimaryPart
	local open = ctx.ChannelService.MakePrompt(root, "StorageOpen", "Open", def.Name, S.InteractRange, "Team", s.Team)
	open:SetAttribute("StorageKey", s.Key)
	local enemy = ctx.ChannelService.MakePrompt(root, "StorageSteal", "Hold: Breach", "Enemy " .. def.Name, S.InteractRange, "Enemy", s.Team)
	enemy:SetAttribute("StorageKey", s.Key)
	enemy.KeyboardKeyCode = Enum.KeyCode.G
	local resecure = ctx.ChannelService.MakePrompt(root, "StorageResecure", "Hold: Resecure", def.Name, S.InteractRange, "Team", s.Team)
	resecure:SetAttribute("StorageKey", s.Key)
	resecure.KeyboardKeyCode = Enum.KeyCode.R
	resecure.UIOffset = Vector2.new(0, 72)
	resecure.Enabled = false
end

function StorageService.TeamStores(team: number): { StorageLedger.Store }
	local out = {}
	for _, e in byKey do
		if e.Structure.Team == team then
			table.insert(out, e.Store)
		end
	end
	return out
end

function StorageService.TeamTotals(team: number): { [string]: number }
	local totals = {}
	for _, id in InventoryModel.ResourceIds do
		totals[id] = 0
	end
	for _, st in StorageService.TeamStores(team) do
		for id, n in st.Items do
			totals[id] += n
		end
	end
	return totals
end

local function mode(p: Player, e: Entry): string
	if ctx.Util.Team(p) == e.Structure.Team then
		return "Owner"
	end
	return if e.Breached then "Loot" else "Locked"
end

local function send(p: Player, e: Entry)
	Net.FireClient("StorageSync", p, e.Key, e.Store.Items, mode(p, e), e.Store.Capacity, {
		Name = Items[e.Structure.Id].Name,
		Tier = e.Tier,
		Breached = e.Breached,
		SlotsUsed = StorageLedger.SlotsUsed(e.Store),
	})
end

local function refreshViewers(e: Entry)
	for p, key in viewers do
		if key == e.Key and p.Parent then
			send(p, e)
		end
	end
end

function StorageService.SyncTeam(team: number)
	for p, key in viewers do
		local e = byKey[key]
		if e and p.Parent then
			send(p, e)
		end
	end
	for _, p in ctx.Util.TeamPlayers(team) do
		ctx.CraftService.Push(p)
	end
end

local function setBreached(e: Entry, breached: boolean)
	e.Breached = breached
	Structures.SetBreached(e.Structure.Model, breached)
	local resecure = e.Structure.Model.PrimaryPart:FindFirstChild("StorageResecurePrompt")
	if resecure then
		resecure.Enabled = breached
	end
	local enemy = e.Structure.Model.PrimaryPart:FindFirstChild("StorageStealPrompt")
	if enemy then
		enemy.ActionText = if breached then "Loot" else "Hold: Breach"
	end
	refreshViewers(e)
end

function StorageService.IsBreached(key: string): boolean
	local e = byKey[key]
	return e ~= nil and e.Breached
end

-- Opening ------------------------------------------------------------------------------------

function StorageService._onOpen(p: Player, prompt: ProximityPrompt)
	local key = prompt:GetAttribute("StorageKey") :: string?
	local e = key and byKey[key]
	if not e or not ctx.Util.IsAlive(p) or ctx.Util.Team(p) ~= e.Structure.Team then
		return
	end
	viewers[p] = e.Key
	send(p, e)
end

-- Enemy prompt: loot if breached, else start breaching.
function StorageService._onEnemyPrompt(p: Player, prompt: ProximityPrompt)
	local key = prompt:GetAttribute("StorageKey") :: string?
	local e = key and byKey[key]
	if not e or not ctx.Util.IsAlive(p) or ctx.Util.Team(p) == e.Structure.Team then
		return
	end
	if e.Breached then
		viewers[p] = e.Key
		send(p, e)
		return
	end
	StorageService._beginBreach(p, e, prompt)
end

-- Breach method for the player's gear: returns seconds, a label and whether a charge is used.
function StorageService.BreachPlan(p: Player, tier: number): (number?, string, boolean)
	local inv = ctx.InventoryService.Get(p)
	if not inv then
		return nil, "", false
	end
	if (inv.Resources.BreachingCharge or 0) > 0 then
		return S.ChargeTime, "Breaching Charge", true
	end
	local best, bestMult = nil, 1.01
	local hasTool = false
	for _, slot in InventoryModel.SlotNames do
		local st = inv.Slots[slot]
		local def = st and Items[st.Id]
		if def and (def.BreachTool or def.ToolType) then
			hasTool = true
			local mult = if def.BreachTool then S.BreachToolMult[def.BreachTool] else 1
			if mult < bestMult then
				best, bestMult = def, mult
			end
		end
	end
	local need = S.BreachNeeds[tier]
	if need == "Crowbar" and not (best and (best.BreachTool == "Crowbar" or best.BreachTool == "Sledgehammer")) then
		return nil, "a Crowbar or better", false
	elseif need == "Sledgehammer" and not (best and best.BreachTool == "Sledgehammer") then
		return nil, "a Sledgehammer or a Breaching Charge", false
	elseif not hasTool then
		return nil, "an axe, pickaxe or breaching tool", false
	end
	local secs = S.BreachTimes[math.clamp(tier, 1, #S.BreachTimes)] * bestMult / ctx.PowerupService.BreachSpeedMult(p)
	return secs, if best then best.Name else "tool", false
end

local function alertBreach(p: Player, e: Entry, loud: boolean)
	local pos = e.Structure.Model:GetPivot().Position
	local t = os.clock()
	if t - (lastAlert[e.Key] or 0) < 6 and not loud then
		return
	end
	lastAlert[e.Key] = t
	local camp = ctx.CampService.GetCamp(e.Structure.Team)
	local dir = if camp then (pos - camp.FirePos) * Vector3.new(1, 0, 1) else Vector3.zero
	local bearingDeg = if dir.Magnitude > 0.1 then math.deg(math.atan2(dir.X, -dir.Z)) % 360 else nil
	for _, mate in ctx.Util.TeamPlayers(e.Structure.Team) do
		Net.FireClient("MatchEvent", mate, "StorageRaided", { Bearing = bearingDeg, Name = Items[e.Structure.Id].Name })
	end
	-- Raids are loud: anyone near hears it (no position, just that it's close).
	for _, other in ctx.Util.MatchPlayers() do
		if other ~= p and ctx.Util.Team(other) ~= e.Structure.Team and ctx.Util.DistTo(other, pos) <= S.NoiseRadius * ctx.PowerupService.BreachNoiseMult(p) then
			Net.FireClient("MatchEvent", other, "RaidNoise", { Loud = loud })
		end
	end
	ctx.Util.PlaySound(if loud then "Explosion" else "Breach", e.Structure.Model.PrimaryPart)
end

function StorageService._beginBreach(p: Player, e: Entry, prompt: ProximityPrompt?)
	local secs, how, useCharge = StorageService.BreachPlan(p, e.Tier)
	local def = Items[e.Structure.Id]
	if not secs then
		ctx.Util.Notify(p, def.Name .. " (Tier " .. roman(e.Tier) .. ") needs " .. how .. " to breach.", "error")
		return
	end
	local model = e.Structure.Model
	local noise = 0
	ctx.ChannelService.Begin(p, {
		Kind = "Breach",
		Label = string.format("Breaching the %s (%s)", def.Name, how),
		Duration = secs,
		Range = S.InteractRange,
		Hold = true,
		Prompt = prompt,
		InterruptOnDamage = true,
		MoveTolerance = 3,
		Action = if useCharge then "Gather" else "Breach",
		TargetKey = e.Key,
		Position = function()
			return if model.Parent and byKey[e.Key] then model:GetPivot().Position else nil
		end,
		CanContinue = function()
			noise += 1
			if noise % 20 == 0 then -- every ~2 s: banging on the lock
				alertBreach(p, e, false)
			end
			if e.Breached then
				return false, "Already breached."
			end
			return true
		end,
		OnComplete = function()
			if not byKey[e.Key] or e.Breached then
				return
			end
			local inv = ctx.InventoryService.Get(p)
			if useCharge then
				if not inv or InventoryModel.TakeResource(inv, "BreachingCharge", 1) ~= 1 then
					return
				end
				ctx.InventoryService.Sync(p)
				local pos = model:GetPivot().Position
				Net.FireAll("Fx", "StructureBreak", { Pos = pos, Id = "Explosion" })
				for _, other in ctx.Util.MatchPlayers() do
					if other ~= p and ctx.Util.DistTo(other, pos) <= S.ChargeRadius then
						ctx.CombatService.DamagePlayer(other, S.ChargeDamage, { Kind = "Explosion", By = p, Name = "Breaching Charge", Pos = pos })
					end
				end
			else
				local _, slot = ctx.InventoryService.EquippedItem(p)
				if slot then
					ctx.InventoryService.Wear(p, slot, 3 * ctx.PowerupService.BreachWear(p))
				end
			end
			setBreached(e, true)
			alertBreach(p, e, true)
			ctx.Util.NotifyTeam(e.Structure.Team, "⚠ Your " .. def.Name .. " was BREACHED! Resecure it (hold R at the storage).", "danger")
			ctx.Util.Notify(p, "Breached! Open it to loot.", "success")
			viewers[p] = e.Key
			send(p, e)
		end,
	})
	alertBreach(p, e, useCharge)
end

-- Resecuring -----------------------------------------------------------------------------------

function StorageService._onResecure(p: Player, prompt: ProximityPrompt)
	local key = prompt:GetAttribute("StorageKey") :: string?
	local e = key and byKey[key]
	if not e or not e.Breached or ctx.Util.Team(p) ~= e.Structure.Team or not ctx.Util.IsAlive(p) then
		return
	end
	local def = Items[e.Structure.Id]
	local cost = S.ResecureCost[def.Material or "Wood"] or S.ResecureCost.Wood
	local inv = ctx.InventoryService.Get(p)
	if not inv or not StorageLedger.CanPayCombined(cost, inv, StorageService.TeamStores(e.Structure.Team)) then
		local id, n = next(cost)
		ctx.Util.Notify(p, string.format("Resecuring needs %d %s.", n, Items[id].Name), "warn")
		return
	end
	local model = e.Structure.Model
	ctx.ChannelService.Begin(p, {
		Kind = "Resecure",
		Label = "Resecuring the " .. def.Name,
		Duration = S.ResecureTime,
		Range = S.InteractRange,
		Hold = true,
		Prompt = prompt,
		InterruptOnDamage = true,
		Action = "Chop",
		Position = function()
			return if model.Parent and byKey[e.Key] then model:GetPivot().Position else nil
		end,
		OnComplete = function()
			local invNow = ctx.InventoryService.Get(p)
			if not byKey[e.Key] or not e.Breached or not invNow then
				return
			end
			if not StorageLedger.PayCombined(cost, invNow, StorageService.TeamStores(e.Structure.Team)) then
				return
			end
			ctx.InventoryService.Sync(p)
			setBreached(e, false)
			-- kick enemy viewers out
			for viewer, vkey in viewers do
				if vkey == e.Key and ctx.Util.Team(viewer) ~= e.Structure.Team then
					viewers[viewer] = nil
					Net.FireClient("StorageSync", viewer, e.Key, nil, "Closed", 0)
				end
			end
			ctx.Util.Notify(p, "Storage resecured.", "success")
			StorageService.SyncTeam(e.Structure.Team)
		end,
	})
end

-- Transfers -----------------------------------------------------------------------------------

local function inRange(p: Player, e: Entry): boolean
	local model = e.Structure.Model
	return model.Parent ~= nil and ctx.Util.DistTo(p, model:GetPivot().Position) <= S.InteractRange + 3
end

function StorageService._onAction(p: Player, req: any)
	if type(req) ~= "table" or type(req.Key) ~= "string" or type(req.Action) ~= "string" then
		return
	end
	local e = byKey[req.Key]
	local inv = ctx.InventoryService.Get(p)
	if not e or not inv or not ctx.Util.IsAlive(p) or not inRange(p, e) then
		return
	end
	local isOwner = ctx.Util.Team(p) == e.Structure.Team
	local action: string = req.Action
	if action == "Close" then
		viewers[p] = nil
		return
	end
	-- Enemies may only take from a breached storage.
	local taking = action == "Withdraw" or action == "TakeAll"
	if not isOwner and not (e.Breached and taking) then
		return
	end
	if action == "DepositAll" then
		local moved = 0
		for _, id in InventoryModel.ResourceIds do
			moved += StorageLedger.Deposit(e.Store, inv, id, inv.Resources[id])
		end
		if moved == 0 then
			ctx.Util.Notify(p, if StorageLedger.Free(e.Store) == 0 then "Storage is full." else "Nothing to deposit.", "info")
		end
	elseif action == "TakeAll" then
		local moved = 0
		for _, id in InventoryModel.ResourceIds do
			moved += StorageLedger.Withdraw(e.Store, inv, id, e.Store.Items[id] or 0)
		end
		if moved == 0 then
			ctx.Util.Notify(p, "Your pack is full (or the storage is empty).", "info")
		end
	elseif action == "Deposit" or action == "Withdraw" then
		if type(req.Resource) ~= "string" or not ctx.Util.IsInt(req.Count, 1, 999) then
			return
		end
		local moved
		if action == "Deposit" then
			moved = StorageLedger.Deposit(e.Store, inv, req.Resource, req.Count)
		else
			moved = StorageLedger.Withdraw(e.Store, inv, req.Resource, req.Count)
			if moved == 0 and InventoryModel.SpaceFor(inv, req.Resource) == 0 then
				ctx.Util.Notify(p, "Your pack is full.", "warn")
			end
		end
	else
		return
	end
	ctx.InventoryService.Sync(p)
	if not isOwner then
		alertBreach(p, e, false)
	end
	refreshViewers(e)
	StorageService.SyncTeam(e.Structure.Team)
end

function StorageService.OnDestroyed(s: any, pos: Vector3)
	local e = byKey[s.Key]
	if not e then
		return
	end
	byKey[s.Key] = nil
	local contents = {}
	local any = false
	for id, n in e.Store.Items do
		if n > 0 then
			contents[id] = n
			any = true
		end
	end
	if any then
		ctx.InventoryService.SpawnBag(contents, pos, Config.Teams[s.Team].Color, "Spilled Storage")
	end
	for p, key in viewers do
		if key == s.Key then
			viewers[p] = nil
			Net.FireClient("StorageSync", p, s.Key, nil, "Closed", 0)
		end
	end
	StorageService.SyncTeam(s.Team)
end

return StorageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="891">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Shared server helpers: ordered player-join hooks, rate-limited remote
-- handlers, argument validation and character queries.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local RateLimiter = require(Shared:WaitForChild("Logic"):WaitForChild("RateLimiter"))

local Util = {}

local ctx: any
local joinHooks: { (Player) -> () } = {}
local leaveHooks: { (Player) -> () } = {}
local joined: { [Player]: boolean } = {}
local limiter = RateLimiter.New(Config.RateLimits)
local rejectLog: { [Player]: number } = {}

function Util.Init(c)
	ctx = c
	Players.PlayerAdded:Connect(Util.FirePlayerAdded)
	Players.PlayerRemoving:Connect(function(p)
		for _, fn in leaveHooks do
			local ok, err = pcall(fn, p)
			if not ok then
				warn("[Util] leave hook error:", err)
			end
		end
		joined[p] = nil
		rejectLog[p] = nil
		RateLimiter.Forget(limiter, p)
	end)
end

function Util.OnPlayerAdded(fn: (Player) -> ())
	table.insert(joinHooks, fn)
end

function Util.OnPlayerRemoving(fn: (Player) -> ())
	table.insert(leaveHooks, fn)
end

function Util.FirePlayerAdded(p: Player)
	if joined[p] then
		return
	end
	joined[p] = true
	for _, fn in joinHooks do
		task.spawn(function()
			local ok, err = pcall(fn, p)
			if not ok then
				warn("[Util] join hook error:", err)
			end
		end)
	end
end

-- Connects a client->server remote with rate limiting and error isolation.
function Util.Connect(remoteName: string, bucket: string, handler: (Player, ...any) -> ())
	Net.Event(remoteName).OnServerEvent:Connect(function(player: Player, ...)
		if not RateLimiter.Allow(limiter, player, bucket, os.clock()) then
			rejectLog[player] = (rejectLog[player] or 0) + 1
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[%s] handler error from %s: %s", remoteName, player.Name, tostring(err)))
		end
	end)
end

function Util.Allow(player: Player, bucket: string): boolean
	return RateLimiter.Allow(limiter, player, bucket, os.clock())
end

-- Validation ------------------------------------------------------------------------

function Util.IsFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function Util.IsInt(n: any, lo: number?, hi: number?): boolean
	if not Util.IsFinite(n) or n ~= math.floor(n) then
		return false
	end
	if lo and n < lo then
		return false
	end
	if hi and n > hi then
		return false
	end
	return true
end

function Util.IsStr(s: any, maxLen: number?): boolean
	return type(s) == "string" and #s <= (maxLen or 64)
end

function Util.IsVec3(v: any): boolean
	return typeof(v) == "Vector3" and Util.IsFinite(v.X) and Util.IsFinite(v.Y) and Util.IsFinite(v.Z)
end

function Util.IsUnit(v: any): boolean
	return Util.IsVec3(v) and math.abs(v.Magnitude - 1) < 0.05
end

function Util.IsCFrame(c: any): boolean
	if typeof(c) ~= "CFrame" then
		return false
	end
	local p = c.Position
	return Util.IsVec3(p) and Util.IsFinite(c.LookVector.X)
end

-- Characters -------------------------------------------------------------------------

function Util.Root(player: Player): BasePart?
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Util.Humanoid(player: Player): Humanoid?
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChildOfClass("Humanoid")
end

function Util.IsAlive(player: Player): boolean
	local hum = Util.Humanoid(player)
	return hum ~= nil and hum.Health > 0 and player:GetAttribute("LifeState") == "Alive"
end

function Util.DistTo(player: Player, pos: Vector3): number
	local r = Util.Root(player)
	if not r then
		return math.huge
	end
	return (r.Position - pos).Magnitude
end

function Util.Team(player: Player): number
	return (player:GetAttribute("Team") :: number?) or 0
end

function Util.InMatch(player: Player): boolean
	return player:GetAttribute("InMatch") == true
end

-- One-shot character action for the procedural animator (Controllers/Animation):
-- the client plays the pose for a short window after ActionAt.
function Util.SetAction(player: Player, action: string, item: string?)
	local char = player.Character
	if char then
		char:SetAttribute("Action", action)
		char:SetAttribute("ActionAt", workspace:GetServerTimeNow())
		if item then
			char:SetAttribute("ActionItem", item)
		end
	end
end

function Util.Notify(player: Player, text: string, kind: string?)
	Net.FireClient("Notify", player, text, kind or "info")
end

function Util.NotifyTeam(team: number, text: string, kind: string?)
	for _, p in Players:GetPlayers() do
		if Util.Team(p) == team and Util.InMatch(p) then
			Net.FireClient("Notify", p, text, kind or "info")
		end
	end
end

function Util.MatchPlayers(): { Player }
	local out = {}
	for _, p in Players:GetPlayers() do
		if Util.InMatch(p) then
			table.insert(out, p)
		end
	end
	return out
end

function Util.TeamPlayers(team: number): { Player }
	local out = {}
	for _, p in Players:GetPlayers() do
		if Util.InMatch(p) and Util.Team(p) == team then
			table.insert(out, p)
		end
	end
	return out
end

-- Returns the Player owning a model (character), or nil.
function Util.PlayerFromPart(part: Instance): Player?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local p = Players:GetPlayerFromCharacter(model)
		if p then
			return p
		end
		-- FindFirstAncestorOfClass starts at the parent, so nested models
		-- (e.g. a held item inside the character) still resolve.
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Util.Now(): number
	return workspace:GetServerTimeNow()
end

-- Sounds (server-side spatial one-shots replicate to everyone nearby)
local SoundLib = require(Shared:WaitForChild("Sounds"))

function Util.PlaySound(name: string, parent: Instance?)
	if parent then
		SoundLib.PlayAt(name, parent)
	end
end

function Util.MakeSound(name: string, parent: Instance): Sound?
	local s = SoundLib.Make(name)
	if s then
		s.Parent = parent
	end
	return s
end

-- Folder helper under workspace
function Util.Folder(name: string, parent: Instance?): Folder
	local p = parent or workspace
	local f = p:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = name
	nf.Parent = p
	return nf
end

return Util
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="892">
          <Properties>
            <string name="Name">WildlifeService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Wildlife (spec): deer flee, rabbits are fast and passive, boars charge when
-- provoked, wolves hunt aggressively in packs at night, bears are uncommon,
-- territorial and dangerous (bats are kept in code but no longer spawn).
--
-- Night escalation (Logic/WildlifeRules) raises predator pressure, aggression,
-- pack size and roaming each night; it never inflates health. Animals spawn away
-- from players and outside burning campfire light, never enter fire light;
-- night-only hunters leave at dawn. Every animal drops leather when killed.
-- Movement is cheap steering (Humanoid:MoveTo / AlignPosition), not pathfinding,
-- with stuck detection, jumps, sidesteps and a give-up despawn.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Models = Shared:WaitForChild("Models")
local AnimalModels = require(Models:WaitForChild("Animals"))
local WildlifeRules = require(Shared:WaitForChild("Logic"):WaitForChild("WildlifeRules"))

local WildlifeService = {}

-- Role: "Prey" flees; "Pack" hunts (wolves); "Territorial" defends a home area
-- (bears); "Charger" charges when provoked (boars); "Flyer" (bats, disabled).
WildlifeService.Species = {
	Wolf = { Role = "Pack", NightOnly = true, Health = 60, Damage = 12, Speed = 21, Reach = 6.5, Cooldown = 1.6, Telegraph = 0.45, Leather = 1, Pack = { 2, 3 }, Sound = "WolfGrowl" },
	Bear = { Role = "Territorial", Health = 220, Damage = 30, Speed = 13, ChargeSpeed = 25, Reach = 8, Cooldown = 2.4, Telegraph = 0.8, Leather = 4, Pack = { 1, 1 }, Sound = "BearRoar" },
	Boar = { Role = "Charger", Health = 110, Damage = 18, Speed = 14, ChargeSpeed = 27, Reach = 6, Cooldown = 2.2, Telegraph = 0.6, Leather = 2, Pack = { 1, 2 }, Sound = "BearRoar" },
	Deer = { Role = "Prey", Health = 70, Damage = 0, Speed = 12, FleeSpeed = 26, Reach = 0, Cooldown = 1, Telegraph = 0, Leather = 2, Pack = { 1, 3 }, Sound = "AnimalHit" },
	Rabbit = { Role = "Prey", Health = 15, Damage = 0, Speed = 10, FleeSpeed = 30, Reach = 0, Cooldown = 1, Telegraph = 0, Leather = 1, Pack = { 1, 2 }, Sound = "AnimalHit" },
	Bat = { Role = "Flyer", NightOnly = true, Health = 25, Damage = 6, Speed = 24, Reach = 5, Cooldown = 1.3, Telegraph = 0.35, Leather = 1, Pack = { 3, 4 }, Sound = "BatScreech" },
}

type Animal = {
	Id: number,
	Species: string,
	Model: Model,
	Hum: Humanoid,
	Root: BasePart,
	State: string,
	Target: Player?,
	Waypoint: Vector3?,
	LastPos: Vector3,
	StillTime: number,
	StuckTotal: number,
	NextAttack: number,
	BusyUntil: number,
	ChargeUntil: number,
	ChargeDir: Vector3?,
	Damage: { [Player]: number },
	Dead: boolean,
	Leaving: boolean,
	SpawnedAt: number,
	Home: Vector3, -- territorial animals defend around here
	FleeUntil: number,
	FleeFrom: Vector3?,
}

local ctx: any
local animals: { [number]: Animal } = {}
local byModel: { [Model]: Animal } = {}
local nextId = 0
local folder: Folder? = nil
local rng = Random.new()

function WildlifeService.Init(c)
	ctx = c
	ctx.MatchService.On("MatchStarting", function(map)
		folder = Instance.new("Folder")
		folder.Name = "Wildlife"
		folder.Parent = map.Folder
	end)
	ctx.MatchService.On("PhaseChanged", function(phase: string)
		if phase == "Night" then
			WildlifeService._denSpawns()
		end
		if phase == "Day" then
			for _, a in animals do
				if WildlifeService.Species[a.Species].NightOnly then
					a.Leaving = true
				end
			end
		end
	end)
	ctx.MatchService.On("MatchCleanup", function()
		for _, a in animals do
			a.Model:Destroy()
		end
		animals = {}
		byModel = {}
		folder = nil
	end)
end

function WildlifeService.Start()
	local spawnAcc = 0
	while true do
		local dt = task.wait(Config.Wildlife.ThinkRate)
		if ctx.MatchService.Active and folder then
			spawnAcc += dt
			local pressure = WildlifeService.Pressure()
			if spawnAcc >= Config.Wildlife.SpawnInterval * pressure.IntervalMult then
				spawnAcc = 0
				local phase = ctx.MatchService.Phase
				if phase == "Day" or phase == "Night" then
					WildlifeService._trySpawn(pressure)
				end
			end
			for _, a in animals do
				if not a.Dead then
					local ok, err = pcall(WildlifeService._think, a, dt)
					if not ok then
						warn("[Wildlife] think error:", err)
						WildlifeService._despawn(a)
					end
				end
			end
		end
	end
end

function WildlifeService.FromPart(part: Instance): Animal?
	local m = part:FindFirstAncestorOfClass("Model")
	while m do
		local a = byModel[m]
		if a then
			return if a.Dead then nil else a
		end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function WildlifeService.List(): { Animal }
	local out = {}
	for _, a in animals do
		if not a.Dead then
			table.insert(out, a)
		end
	end
	return out
end

-- Current escalation (Logic/WildlifeRules).
function WildlifeService.Pressure(): WildlifeRules.Pressure
	local night = WildlifeRules.NightNumber(ctx.MatchService.Phase, ctx.MatchService.Day)
	return WildlifeRules.Pressure(night, Config.Wildlife)
end

-- Spawning --------------------------------------------------------------------------------

local function count(species: string?): number
	local n = 0
	for _, a in animals do
		if not a.Dead and (species == nil or a.Species == species) then
			n += 1
		end
	end
	return n
end

local function nearestPlayerDist(pos: Vector3): number
	local best = math.huge
	for _, p in ctx.Util.MatchPlayers() do
		local r = ctx.Util.Root(p)
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

local function predatorCount(): number
	local n = 0
	for _, a in animals do
		if not a.Dead and WildlifeRules.Predators[a.Species] then
			n += 1
		end
	end
	return n
end

-- Medium caves hold a wolf den and large caves a bear at night (spec: predators).
function WildlifeService._denSpawns()
	local map = ctx.MatchService.Map
	if not map or not map.Caves then
		return
	end
	for _, cave in map.Caves do
		local species = if cave.Size == "Large" then "Bear" elseif cave.Size == "Medium" then "Wolf" else nil
		if species and count(species) < (Config.Wildlife.MaxPerSpecies[species] or 0) then
			local inside = (cave.CF * CFrame.new(0, 1, cave.Length * 0.7)).Position
			local occupied = false
			for _, a in animals do
				if not a.Dead and (a.Root.Position - inside).Magnitude < 25 then
					occupied = true
				end
			end
			if not occupied then
				for i = 1, if species == "Wolf" then 2 else 1 do
					local a = WildlifeService._spawn(species, inside + Vector3.new(i * 2, 0, 0))
					if a then
						a.Home = inside
					end
				end
			end
		end
	end
end

function WildlifeService._trySpawn(pressure: WildlifeRules.Pressure)
	if count(nil) >= Config.Wildlife.MaxTotal then
		return
	end
	local candidates = {}
	for _, p in ctx.Util.MatchPlayers() do
		local r = ctx.Util.Root(p)
		if r and ctx.Util.IsAlive(p) and not ctx.CampService.InFireLight(r.Position, 10) then
			table.insert(candidates, r.Position)
		end
	end
	if #candidates == 0 then
		return
	end
	local focus = candidates[rng:NextInteger(1, #candidates)]
	-- Weighted species choice (by time of day / night number) respecting caps
	local allowed = {}
	local predatorsFull = predatorCount() >= pressure.PredatorCap
	for name in WildlifeService.Species do
		if count(name) < (Config.Wildlife.MaxPerSpecies[name] or 0) and not (predatorsFull and WildlifeRules.Predators[name]) then
			allowed[name] = true
		end
	end
	local species = WildlifeRules.Pick(WildlifeRules.Weights(pressure.Night), allowed, rng:NextNumber())
	if not species then
		return
	end
	local map = ctx.MatchService.Map
	local H = map.Layout.HalfSize - 12
	for _ = 1, 12 do
		local ang = rng:NextNumber() * math.pi * 2
		local dist = rng:NextNumber(Config.Wildlife.SpawnMinPlayerDist, Config.Wildlife.SpawnMaxPlayerDist)
		local x = math.clamp(focus.X + math.cos(ang) * dist, map.Origin.X - H, map.Origin.X + H)
		local z = math.clamp(focus.Z + math.sin(ang) * dist, map.Origin.Z - H, map.Origin.Z + H)
		local y = ctx.WorldService.GroundY(x, z)
		local pos = Vector3.new(x, y, z)
		if not ctx.CampService.InFireLight(pos, 25) and nearestPlayerDist(pos) >= Config.Wildlife.SpawnMinPlayerDist then
			local sp = WildlifeService.Species[species]
			local n = rng:NextInteger(sp.Pack[1], sp.Pack[2]) + (if species == "Wolf" then pressure.PackBonus else 0)
			n = math.min(n, Config.Wildlife.MaxPerSpecies[species] - count(species), Config.Wildlife.MaxTotal - count(nil))
			for i = 1, n do
				WildlifeService._spawn(species, pos + Vector3.new(i * 3, 0, (i % 2) * 3))
			end
			return
		end
	end
end

function WildlifeService._spawn(species: string, pos: Vector3): Animal?
	local sp = WildlifeService.Species[species]
	local model = AnimalModels.Build(species)
	local root = (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.MaxHealth = sp.Health
	hum.Health = sp.Health
	hum.WalkSpeed = sp.Speed
	local y = pos.Y + (if species == "Bat" then 12 else hum.HipHeight + root.Size.Y / 2 + 0.5)
	model:PivotTo(CFrame.new(pos.X, y, pos.Z) * CFrame.Angles(0, rng:NextNumber() * 6.28, 0))
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Animals"
		end
	end
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	nextId += 1
	local a: Animal = {
		Id = nextId,
		Species = species,
		Model = model,
		Hum = hum,
		Root = root,
		State = "Roam",
		Target = nil,
		Waypoint = nil,
		LastPos = root.Position,
		StillTime = 0,
		StuckTotal = 0,
		NextAttack = 0,
		BusyUntil = 0,
		ChargeUntil = 0,
		ChargeDir = nil,
		Damage = {},
		Dead = false,
		Leaving = false,
		SpawnedAt = os.clock(),
		Home = pos,
		FleeUntil = 0,
		FleeFrom = nil,
	}
	model:SetAttribute("Species", species)
	model:SetAttribute("AnimalId", a.Id)
	animals[a.Id] = a
	byModel[model] = a
	hum.Died:Connect(function()
		WildlifeService._onDied(a)
	end)
	return a
end

-- Behaviour ----------------------------------------------------------------------------------

local function flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Moves the destination out of any burning fire's light radius.
local function safeGoal(goal: Vector3): Vector3
	local fire = ctx.CampService.NearestLitFire(goal, Config.Fire.LightRadius + 4)
	if fire then
		local away = Vector3.new(goal.X - fire.X, 0, goal.Z - fire.Z)
		local dir = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)
		return Vector3.new(fire.X, goal.Y, fire.Z) + dir * (Config.Fire.LightRadius + 5)
	end
	return goal
end

-- Nearest valid player within `range` of `from` (default: the animal).
local function pickTarget(a: Animal, range: number?, from: Vector3?): Player?
	local origin = from or a.Root.Position
	local best, bestD = nil, range or (Config.Wildlife.AggroRange[a.Species] or 0) * WildlifeService.Pressure().AggroMult
	for _, p in ctx.Util.MatchPlayers() do
		local r = ctx.Util.Root(p)
		if r and ctx.Util.IsAlive(p) and not ctx.CampService.InFireLight(r.Position) then
			local d = (r.Position - origin).Magnitude
			if d < bestD then
				best, bestD = p, d
			end
		end
	end
	return best
end

-- Nearest player position within range (prey watch for threats, even in fire light).
local function nearestThreat(pos: Vector3, range: number): Vector3?
	local best, bestD = nil, range
	for _, p in ctx.Util.MatchPlayers() do
		local r = ctx.Util.Root(p)
		if r and ctx.Util.IsAlive(p) then
			local d = (r.Position - pos).Magnitude
			if d < bestD then
				best, bestD = r.Position, d
			end
		end
	end
	return best
end

local function moveTo(a: Animal, goal: Vector3)
	if a.Species == "Bat" then
		local mover = a.Root:FindFirstChild("Mover") :: AlignPosition?
		local facing = a.Root:FindFirstChild("Facing") :: AlignOrientation?
		if mover then
			mover.Position = goal
		end
		if facing then
			local flatDir = Vector3.new(goal.X - a.Root.Position.X, 0, goal.Z - a.Root.Position.Z)
			if flatDir.Magnitude > 0.5 then
				facing.CFrame = CFrame.lookAt(Vector3.zero, flatDir)
			end
		end
	else
		a.Hum:MoveTo(goal)
	end
end

local function telegraph(a: Animal, kind: string, duration: number)
	a.Model:SetAttribute("Telegraph", kind)
	a.Model:SetAttribute("TelegraphAt", workspace:GetServerTimeNow())
	ctx.Util.PlaySound(WildlifeService.Species[a.Species].Sound, a.Root)
	a.BusyUntil = os.clock() + duration
end

local function hitIfClose(a: Animal, target: Player, reach: number)
	local r = ctx.Util.Root(target)
	if not r or a.Dead then
		return
	end
	-- Walls and other solid cover block animal attacks.
	local los = RaycastParams.new()
	los.FilterType = Enum.RaycastFilterType.Exclude
	los.FilterDescendantsInstances = { a.Model, target.Character :: Instance }
	los.IgnoreWater = true
	local blocked = workspace:Raycast(a.Root.Position, r.Position - a.Root.Position, los)
	if blocked and blocked.Instance ~= workspace.Terrain then
		return
	end
	if (r.Position - a.Root.Position).Magnitude <= reach and not ctx.CampService.InFireLight(r.Position) then
		local sp = WildlifeService.Species[a.Species]
		ctx.CombatService.DamagePlayer(target, sp.Damage * ctx.PowerupService.WildlifeDamageMult(target), { Kind = "Animal", Name = a.Species, Pos = a.Root.Position })
		a.Model:SetAttribute("Telegraph", "Strike")
		a.Model:SetAttribute("TelegraphAt", workspace:GetServerTimeNow())
	end
end

function WildlifeService._think(a: Animal, dt: number)
	local now = os.clock()
	local pos = a.Root.Position
	local sp = WildlifeService.Species[a.Species]

	-- Dawn: run away from the nearest player and despawn.
	if a.Leaving or (sp.NightOnly and not ctx.MatchService.IsNight()) then
		a.Leaving = true
		a.Model:SetAttribute("Telegraph", nil)
		if now - a.SpawnedAt > 0 then
			a.Hum.WalkSpeed = sp.Speed * 1.2
			local away = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
			moveTo(a, pos + away * 40 + (if a.Species == "Bat" then Vector3.new(0, 30, 0) else Vector3.zero))
		end
		if nearestPlayerDist(pos) > 90 or (a.Model:GetAttribute("LeaveStart") and now - (a.Model:GetAttribute("LeaveStart") :: number) > 6) then
			WildlifeService._despawn(a)
		elseif not a.Model:GetAttribute("LeaveStart") then
			a.Model:SetAttribute("LeaveStart", now)
		end
		return
	end

	if nearestPlayerDist(pos) > Config.Wildlife.DespawnDistance then
		WildlifeService._despawn(a)
		return
	end

	-- Prey: roam; bolt away from nearby players or after being hit.
	if sp.Role == "Prey" then
		local threat = nearestThreat(pos, (Config.Wildlife.FleeRange[a.Species] or 25) * WildlifeService.Pressure().AggroMult)
		if threat then
			if now >= a.FleeUntil then
				-- startled: head snaps up (client) as it bolts
				a.Model:SetAttribute("AlertAt", workspace:GetServerTimeNow())
			end
			a.FleeUntil = now + 3
			a.FleeFrom = threat
		end
		if now < a.FleeUntil and a.FleeFrom then
			a.State = "Flee"
			a.Hum.WalkSpeed = sp.FleeSpeed
			local away = (pos - a.FleeFrom) * Vector3.new(1, 0, 1)
			local dir = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)
			-- zig-zag a little so it reads as a panicked run
			local jig = CFrame.Angles(0, math.sin(now * 3 + a.Id) * 0.5, 0) * dir
			local goal = pos + jig * 24
			moveTo(a, safeGoal(Vector3.new(goal.X, ctx.WorldService.GroundY(goal.X, goal.Z), goal.Z)))
		else
			a.State = "Roam"
			a.Hum.WalkSpeed = sp.Speed * 0.5
			if not a.Waypoint or flatDist(pos, a.Waypoint) < 5 then
				local wp = pos + Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-30, 30))
				a.Waypoint = safeGoal(Vector3.new(wp.X, ctx.WorldService.GroundY(wp.X, wp.Z), wp.Z))
			end
			moveTo(a, a.Waypoint :: Vector3)
		end
		WildlifeService._unstick(a, dt)
		return
	end

	-- Never linger inside fire light.
	if ctx.CampService.InFireLight(pos) then
		a.Target = nil
		a.State = "Retreat"
		moveTo(a, safeGoal(pos))
		return
	end

	if now < a.BusyUntil then
		return -- mid-telegraph / recovering
	end

	-- Target selection by role
	local pressure = WildlifeService.Pressure()
	local function lost(t: Player?): boolean
		local r = t and ctx.Util.Root(t)
		return not t or not r or not ctx.Util.IsAlive(t) or ctx.CampService.InFireLight(r.Position)
	end
	if sp.Role == "Territorial" then
		-- Bears defend a home area; they drop the chase once you leave it.
		local territory = Config.Wildlife.Territory * pressure.AggroMult
		if lost(a.Target) or flatDist((ctx.Util.Root(a.Target :: Player) :: BasePart).Position, a.Home) > territory * 1.6 then
			a.Target = pickTarget(a, territory, a.Home)
		end
	elseif sp.Role == "Charger" then
		-- Boars ignore you unless you come close (or hit them), and give up at a distance.
		if lost(a.Target) or ((ctx.Util.Root(a.Target :: Player) :: BasePart).Position - pos).Magnitude > 45 then
			a.Target = pickTarget(a)
		end
	elseif lost(a.Target) then
		a.Target = pickTarget(a)
	end
	local target = a.Target
	local troot = target and ctx.Util.Root(target)

	if not target or not troot then
		-- Roam around
		a.State = "Roam"
		a.Hum.WalkSpeed = sp.Speed * 0.5
		if not a.Waypoint or flatDist(pos, a.Waypoint) < 5 then
			local base = if sp.Role == "Territorial" then a.Home else pos
			local reach = 40 * pressure.AggroMult
			local wp = base + Vector3.new(rng:NextNumber(-reach, reach), 0, rng:NextNumber(-reach, reach))
			local map = ctx.MatchService.Map
			local H = map.Layout.HalfSize - 15
			wp = Vector3.new(math.clamp(wp.X, -H, H), ctx.WorldService.GroundY(wp.X, wp.Z) + (if a.Species == "Bat" then 14 else 0), math.clamp(wp.Z, -H, H))
			a.Waypoint = safeGoal(wp)
		end
		moveTo(a, a.Waypoint :: Vector3)
	else
		a.State = "Chase"
		local tpos = troot.Position
		local dist = (tpos - pos).Magnitude
		a.Hum.WalkSpeed = sp.Speed
		if a.Species == "Wolf" then
			if dist <= sp.Reach + 1.5 and now >= a.NextAttack then
				telegraph(a, "Lunge", sp.Telegraph)
				a.NextAttack = now + sp.Cooldown
				task.delay(sp.Telegraph, function()
					if a.Dead or not target.Parent then
						return
					end
					local r2 = ctx.Util.Root(target)
					if r2 then
						local dir = (r2.Position - a.Root.Position) * Vector3.new(1, 0, 1)
						if dir.Magnitude > 0.1 then
							a.Root.AssemblyLinearVelocity = dir.Unit * 38 + Vector3.new(0, 12, 0)
						end
						task.wait(0.15)
						hitIfClose(a, target, sp.Reach)
					end
				end)
			else
				-- Flank slightly so packs spread out
				local side = if a.Id % 2 == 0 then 1 else -1
				local offset = CFrame.lookAt(tpos, pos).RightVector * side * math.min(6, dist * 0.2)
				moveTo(a, safeGoal(tpos + offset))
			end
		elseif a.Species == "Bear" or a.Species == "Boar" then
			if now < a.ChargeUntil and a.ChargeDir then
				a.Hum.WalkSpeed = sp.ChargeSpeed :: number
				moveTo(a, safeGoal(pos + a.ChargeDir * 20))
				if dist <= sp.Reach then
					a.ChargeUntil = 0
					hitIfClose(a, target, sp.Reach)
					a.NextAttack = now + sp.Cooldown
					a.BusyUntil = now + 0.8
				end
			elseif dist <= sp.Reach and now >= a.NextAttack then
				telegraph(a, "Swipe", 0.5)
				a.NextAttack = now + sp.Cooldown
				task.delay(0.5, function()
					hitIfClose(a, target, sp.Reach + 1)
				end)
			elseif dist < (if a.Species == "Boar" then 22 else 32) and dist > (if a.Species == "Boar" then 6 else 12) and now >= a.NextAttack then
				-- Roar, then charge in a straight line
				telegraph(a, "Roar", sp.Telegraph)
				a.NextAttack = now + sp.Cooldown + 1
				local dir = (tpos - pos) * Vector3.new(1, 0, 1)
				a.ChargeDir = if dir.Magnitude > 0.1 then dir.Unit else nil
				a.ChargeUntil = now + sp.Telegraph + 2
			else
				moveTo(a, safeGoal(tpos))
			end
		else -- Bat
			local hover = tpos + Vector3.new(math.sin(now * 2.3 + a.Id) * 9, 8 + math.sin(now * 3.1 + a.Id) * 2, math.cos(now * 1.9 + a.Id) * 9)
			if dist <= 14 and now >= a.NextAttack then
				telegraph(a, "Swoop", sp.Telegraph)
				a.NextAttack = now + sp.Cooldown + rng:NextNumber(0, 0.8)
				task.delay(sp.Telegraph, function()
					if a.Dead or not target.Parent then
						return
					end
					local r2 = ctx.Util.Root(target)
					if r2 then
						moveTo(a, r2.Position + Vector3.new(0, 1.5, 0))
						task.wait(0.35)
						hitIfClose(a, target, sp.Reach)
					end
				end)
			else
				moveTo(a, safeGoal(hover))
			end
		end
	end

	WildlifeService._unstick(a, dt)
end

-- Stuck detection (ground animals): jump, sidestep, and give up if hopeless.
function WildlifeService._unstick(a: Animal, dt: number)
	local pos = a.Root.Position
	if a.Species ~= "Bat" then
		local moved = flatDist(pos, a.LastPos)
		if moved < 0.6 * dt * 5 then
			a.StillTime += dt
		else
			a.StillTime = 0
			a.StuckTotal = math.max(0, a.StuckTotal - dt)
		end
		a.LastPos = pos
		if a.StillTime > Config.Wildlife.StuckTime then
			a.StillTime = 0
			a.StuckTotal += Config.Wildlife.StuckTime
			a.Hum.Jump = true
			local side = CFrame.lookAt(pos, pos + a.Root.CFrame.LookVector).RightVector * (if rng:NextNumber() < 0.5 then -1 else 1)
			a.Waypoint = safeGoal(pos + side * 12)
			moveTo(a, a.Waypoint :: Vector3)
		end
		if a.StuckTotal > Config.Wildlife.StuckGiveUp then
			WildlifeService._despawn(a)
		end
		-- Fell out of the world / into a hole
		if pos.Y < ctx.WorldService.GroundY(pos.X, pos.Z) - 20 then
			WildlifeService._despawn(a)
		end
	end
end

-- Damage / death -----------------------------------------------------------------------------

function WildlifeService.Damage(a: Animal, amount: number, attacker: Player?): boolean
	if a.Dead or amount <= 0 then
		return false
	end
	if attacker then
		a.Damage[attacker] = (a.Damage[attacker] or 0) + amount
		-- Being hit draws aggro (predators, boars) or makes prey bolt.
		if WildlifeService.Species[a.Species].Role == "Prey" then
			local r = ctx.Util.Root(attacker)
			a.FleeFrom = if r then r.Position else a.Root.Position
			a.FleeUntil = os.clock() + 5
		else
			a.Target = attacker
		end
		Net.FireClient("HitFeedback", attacker, "Animal", math.floor(amount + 0.5), a.Root.Position)
	end
	ctx.Util.PlaySound("AnimalHit", a.Root)
	a.Model:SetAttribute("HitAt", workspace:GetServerTimeNow())
	Net.FireAll("Fx", "Impact", { Pos = a.Root.Position, Kind = "Animal" })
	a.Hum.Health = math.max(0, a.Hum.Health - amount)
	return true
end

function WildlifeService._onDied(a: Animal)
	if a.Dead then
		return
	end
	a.Dead = true
	local pos = a.Root.Position
	local night = ctx.MatchService.IsNight()
	-- Killer = biggest damage contributor (still in the match).
	local killer, best = nil, 0
	for p, d in a.Damage do
		if p.Parent and d > best then
			killer, best = p, d
		end
	end
	local sp = WildlifeService.Species[a.Species]
	local ground = ctx.WorldService.GroundY(pos.X, pos.Z)
	local leather = sp.Leather + (if killer then ctx.PowerupService.ExtraHide(killer) else 0)
	ctx.InventoryService.SpawnPickup("Leather", leather, Vector3.new(pos.X, ground + 1, pos.Z))
	if killer then
		ctx.PowerupService.OnAnimalKilled(killer, a.Id)
		ctx.PowerupService.OnWildlifeKill(killer, a.Species, night)
	end
	a.Model:SetAttribute("Telegraph", "Dead")
	for _, d in a.Model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	task.delay(2, function()
		WildlifeService._despawn(a)
	end)
end

function WildlifeService._despawn(a: Animal)
	a.Dead = true
	animals[a.Id] = nil
	byModel[a.Model] = nil
	if a.Model.Parent then
		a.Model:Destroy()
	end
end


return WildlifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="893">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds the lobby and the procedural match map (terrain + forest + camps).
-- All match content lives under workspace.Match and is removed by ClearMatch.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = Shared:WaitForChild("Logic")
local LayoutGen = require(Logic:WaitForChild("LayoutGen"))
local Models = Shared:WaitForChild("Models")
local Build = require(Models:WaitForChild("Build"))
local Nature = require(Models:WaitForChild("Nature"))
local Camp = require(Models:WaitForChild("Camp"))
local Flora = require(Models:WaitForChild("Flora"))
local Decor = require(Models:WaitForChild("Decor"))
local Landmarks = require(Models:WaitForChild("Landmarks"))
local Refuge = require(Models:WaitForChild("Refuge"))

local WorldService = {}

local ctx: any
local terrain = workspace.Terrain

export type CampInfo = {
	Team: number,
	Origin: CFrame, -- fire position, -Z faces the map centre
	Fire: Model,
	FirePos: Vector3,
	Workbench: Model,
	WorkbenchCF: CFrame,
	SpawnPads: { CFrame },
	Clearances: { { X: number, Z: number, R: number } },
	StaticRects: { { X: number, Z: number, HX: number, HZ: number, Yaw: number } },
	Folder: Folder,
}

export type MapInfo = {
	Seed: number,
	Layout: LayoutGen.Layout,
	Origin: Vector3,
	Folder: Folder,
	Camps: { CampInfo },
	WaterPoints: { { Pos: Vector3, Part: BasePart } },
	DropPoints: { Vector3 },
	Brush: { { Pos: Vector3, R: number } },
	-- Survival Wars world layers
	ChestSpots: { { CF: CFrame, Tier: string, Poi: string, Key: string } },
	NoBuild: { { X: number, Z: number, R: number, Label: string } },
	Caves: { { CF: CFrame, Length: number, Width: number, FloorY: number, Size: string } },
	Pois: { { Type: string, Tier: string, Pos: Vector3 } },
	TerrainReady: boolean?, -- terrain written: GroundY snaps to the real surface
}

WorldService.Map = nil :: MapInfo?
WorldService.LobbySpawn = CFrame.new()
WorldService.LobbyBoard = nil :: TextLabel?

function WorldService.Init(c)
	ctx = c
	local PhysicsService = game:GetService("PhysicsService")
	for _, g in { "Characters", "Animals" } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(g)
		end)
	end
	-- Bats and wolves shouldn't get wedged inside each other.
	PhysicsService:CollisionGroupSetCollidable("Animals", "Animals", false)
end

function WorldService.Start()
	if ctx.Mode == "Lobby" then
		WorldService.BuildLobby()
	end
	WorldService.ApplyLighting(if ctx.Mode == "Lobby" then "Lobby" else "Day", true)
end

-- Height -------------------------------------------------------------------------------

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { workspace.Terrain }
terrainOnly.IgnoreWater = true

function WorldService.GroundY(x: number, z: number): number
	local map = WorldService.Map
	if not map then
		return 0
	end
	-- inside a carved cave: the flat cave floor, not the cliff top above it
	for _, cave in map.Caves or {} do
		local l = cave.CF:PointToObjectSpace(Vector3.new(x, cave.FloorY, z))
		if l.Z > -2 and l.Z < cave.Length + 6 and math.abs(l.X) < cave.Width / 2 + 6 then
			return cave.FloorY
		end
	end
	local h = map.Origin.Y + LayoutGen.Height(map.Layout, x - map.Origin.X, z - map.Origin.Z)
	if map.TerrainReady then
		-- Voxel terrain smooths the heightfield, so objects placed at `h` can end up
		-- half-buried or floating: use the actual surface (water ignored).
		local r = workspace:Raycast(Vector3.new(x, h + 24, z), Vector3.new(0, -48, 0), terrainOnly)
		if r then
			return r.Position.Y
		end
	end
	return h
end

-- Raycast down onto terrain/geometry (used for dynamic spawns).
function WorldService.RaycastGround(pos: Vector3, ignore: { Instance }?): (Vector3?, Vector3?)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	params.IgnoreWater = false
	local r = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -200, 0), params)
	if r then
		return r.Position, r.Normal
	end
	return nil, nil
end

-- Lighting -------------------------------------------------------------------------------

local atmosphere: Atmosphere? = nil
local colorFx: ColorCorrectionEffect? = nil

-- `preset` is a Config.Lighting key: Dawn | Day | Sunset | Night | Lobby.
function WorldService.ApplyLighting(preset: string, instant: boolean?)
	local L = (Config.Lighting :: any)[preset] or Config.Lighting.Day
	if not atmosphere then
		local a = Instance.new("Atmosphere")
		a.Density = 0.32
		a.Offset = 0.1
		a.Parent = Lighting
		atmosphere = a
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Parent = Lighting
		colorFx = cc
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.4
		bloom.Size = 20
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
		local sun = Instance.new("SunRaysEffect")
		sun.Intensity = 0.04
		sun.Parent = Lighting
	end
	Lighting:SetAttribute("Preset", preset)
	local TweenService = game:GetService("TweenService")
	local info = TweenInfo.new(if instant then 0 else Config.Lighting.TransitionTime, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		ClockTime = L.ClockTime,
		Brightness = L.Brightness,
		Ambient = L.Ambient,
		OutdoorAmbient = L.OutdoorAmbient,
		FogColor = L.FogColor,
		FogStart = L.FogStart,
		FogEnd = L.FogEnd,
		ColorShift_Top = L.ColorShift,
	}):Play()
	if atmosphere then
		TweenService:Create(atmosphere, info, { Density = L.Density, Color = L.AtmoColor, Decay = L.Decay, Haze = L.Haze }):Play()
	end
	if colorFx then
		TweenService:Create(colorFx, info, { Saturation = L.Saturation, Contrast = L.Contrast, TintColor = L.Tint }):Play()
	end
end

-- Terrain ---------------------------------------------------------------------------------

local function writeTerrain(map: MapInfo)
	local layout = map.Layout
	local O = map.Origin
	local H = layout.HalfSize + 24
	local RES = 4
	local YCELLS = 12 -- 48 studs of terrain column (cliff rim tops out ~45)
	local CHUNK = 16 -- cells per chunk side

	local pathLists = layout.Paths
	local streams = layout.Streams
	local ponds = {}
	local glades = {}
	for _, f in layout.Features do
		if f.Type == "Pond" then
			table.insert(ponds, f)
		elseif f.Type == "Glade" then
			table.insert(glades, f)
		end
	end

	-- Forest palette: mossy LeafyGrass, leaf-litter Ground, dark Mud, cool Slate.
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(88, 122, 62))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(70, 106, 52))
		terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(104, 84, 60))
		terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(74, 60, 46))
		terrain:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(96, 98, 102))
		terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(118, 114, 108))
	end)

	local total = math.ceil(2 * H / RES)
	for cx0 = 0, total - 1, CHUNK do
		for cz0 = 0, total - 1, CHUNK do
			local nx = math.min(CHUNK, total - cx0)
			local nz = math.min(CHUNK, total - cz0)
			local mats = table.create(nx)
			local occs = table.create(nx)
			for ix = 1, nx do
				local mcol = table.create(YCELLS)
				local ocol = table.create(YCELLS)
				for iy = 1, YCELLS do
					mcol[iy] = table.create(nz, Enum.Material.Air)
					ocol[iy] = table.create(nz, 0)
				end
				mats[ix] = mcol
				occs[ix] = ocol
				local wx = -H + (cx0 + ix - 0.5) * RES
				for iz = 1, nz do
					local wz = -H + (cz0 + iz - 0.5) * RES
					local h = LayoutGen.Height(layout, wx, wz)
					-- Forest floor variety (spec: moss, leaf litter, dirt, grass patches; not one
					-- stretched green): two noise fields pick the ground material.
					local nA = math.noise(wx / 38, wz / 38, 5.3)
					local nB = math.noise(wx / 17 + 40, wz / 17, 9.1)
					local surface = if nA > 0.28 then Enum.Material.LeafyGrass
						elseif nA < -0.3 then Enum.Material.Ground -- leaf litter / dirt
						elseif nB > 0.35 then Enum.Material.Mud -- damp hollows
						else Enum.Material.Grass
					-- cliff rim: bare rock and slate on the slopes
					local rim = LayoutGen.RimFactor(wx, wz)
					if rim > 0.35 then
						surface = if nB > 0 then Enum.Material.Rock else Enum.Material.Slate
					end
					-- camps: packed earth
					for _, c in layout.Camps do
						local d = math.sqrt((wx - c.X) ^ 2 + (wz - c.Z) ^ 2)
						if d < 26 then
							surface = Enum.Material.Ground
						elseif d < 60 then
							surface = Enum.Material.LeafyGrass
						end
					end
					local dc = math.sqrt(wx * wx + wz * wz)
					if dc < 30 then
						surface = Enum.Material.Cobblestone
					elseif dc < 60 then
						surface = Enum.Material.Ground
					end
					for _, p in pathLists do
						if LayoutGen.DistToPolyline(wx, wz, p.Points) < p.Width / 2 then
							surface = Enum.Material.Mud
							break
						end
					end
					for _, g in glades do
						if (wx - g.X) ^ 2 + (wz - g.Z) ^ 2 < g.R * g.R then
							surface = Enum.Material.LeafyGrass
						end
					end
					-- water carving (+ muddy, rocky banks: forest -> grass/moss -> mud/rock -> water)
					local waterDepth = 0
					for _, s in streams do
						local d = LayoutGen.DistToPolyline(wx, wz, s.Points)
						local half = s.Width / 2 + 2
						if d < half then
							local t = d / half
							waterDepth = math.max(waterDepth, s.Depth * (1 - t * t))
						elseif d < half + 3 then
							surface = if nB > 0.2 then Enum.Material.Rock else Enum.Material.Mud
						elseif d < half + 7 and surface == Enum.Material.Grass then
							surface = Enum.Material.LeafyGrass
						end
					end
					for _, pd in ponds do
						local d = math.sqrt((wx - pd.X) ^ 2 + (wz - pd.Z) ^ 2)
						if d < pd.R then
							local t = d / pd.R
							waterDepth = math.max(waterDepth, 4 * (1 - t * t))
						end
					end
					local waterTop = h - 0.6
					local bed = h - waterDepth - 0.6
					if waterDepth > 0.3 then
						surface = Enum.Material.Sand
					end
					if math.abs(wx) > layout.HalfSize or math.abs(wz) > layout.HalfSize then
						surface = Enum.Material.LeafyGrass
					end
					for iy = 1, YCELLS do
						local y0 = (iy - 1) * RES
						local solidTop = if waterDepth > 0.3 then bed else h
						local occ = math.clamp((solidTop - y0) / RES, 0, 1)
						if occ > 0 then
							mats[ix][iy][iz] = if y0 + RES >= solidTop - 1 then surface elseif y0 < 4 then Enum.Material.Rock else Enum.Material.Ground
							occs[ix][iy][iz] = occ
						elseif waterDepth > 0.3 and y0 < waterTop then
							mats[ix][iy][iz] = Enum.Material.Water
							occs[ix][iy][iz] = 1
						end
					end
				end
			end
			local minV = Vector3.new(-H + cx0 * RES, 0, -H + cz0 * RES) + O
			local region = Region3.new(minV, minV + Vector3.new(nx * RES, YCELLS * RES, nz * RES))
			terrain:WriteVoxels(region, RES, mats, occs)
		end
		task.wait() -- keep the server responsive while building
	end
end

-- Match map -----------------------------------------------------------------------------

local function atomic(m: Model)
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
end

local function buildCamp(map: MapInfo, c: any): CampInfo
	local team = Config.Teams[c.Team]
	local O = map.Origin
	local y = WorldService.GroundY(c.X + O.X, c.Z + O.Z)
	local firePos = Vector3.new(c.X + O.X, y, c.Z + O.Z)
	-- -Z of origin faces the centre
	local origin = CFrame.lookAt(firePos, Vector3.new(O.X, y, O.Z))
	local folder = Instance.new("Folder")
	folder.Name = "Camp" .. c.Team
	folder.Parent = map.Folder

	local fire = Camp.Campfire(origin, team.Color, folder)
	fire.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	fire:SetAttribute("Team", c.Team)

	local wbCF = origin * CFrame.new(0, 0, 14) * CFrame.Angles(0, math.rad(180), 0)
	wbCF = CFrame.new(wbCF.Position) * wbCF.Rotation
	local wb = Camp.Workbench(wbCF, 1, team.Color, folder)
	wb.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	wb:SetAttribute("Team", c.Team)

	local pads = {}
	for _, off in { Vector3.new(-12, 0, 8), Vector3.new(12, 0, 8), Vector3.new(-18, 0, -2), Vector3.new(18, 0, -2) } do
		local cf = origin * CFrame.new(off)
		cf = CFrame.new(cf.Position.X, WorldService.GroundY(cf.Position.X, cf.Position.Z), cf.Position.Z) * origin.Rotation
		Camp.SpawnPad(cf, team.Color, folder)
		table.insert(pads, cf + Vector3.new(0, 3.5, 0))
	end

	local hutCF = origin * CFrame.new(0, 0, 34) * CFrame.Angles(0, math.rad(180), 0)
	local hut = Camp.Hut(CFrame.new(hutCF.Position.X, WorldService.GroundY(hutCF.Position.X, hutCF.Position.Z), hutCF.Position.Z) * hutCF.Rotation, team.Motif, team.Color, folder)
	atomic(hut)
	local bannerCF = origin * CFrame.new(9, 0, -14)
	local banner = Camp.Banner(CFrame.new(bannerCF.Position.X, WorldService.GroundY(bannerCF.Position.X, bannerCF.Position.Z), bannerCF.Position.Z) * origin.Rotation, team.Color, team.Symbol, folder)
	banner.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	for _, x in { -26, 26 } do
		local lcf = origin * CFrame.new(x, 0, -22)
		atomic(Camp.Lantern(CFrame.new(lcf.Position.X, WorldService.GroundY(lcf.Position.X, lcf.Position.Z), lcf.Position.Z) * origin.Rotation, team.Color, folder))
	end

	-- Build-zone boundary markers: short stakes with team-colour tips on the zone edge.
	for i = 0, 23 do
		local a = math.rad(i * 15)
		local px = firePos.X + math.cos(a) * Config.Build.ZoneRadius
		local pz = firePos.Z + math.sin(a) * Config.Build.ZoneRadius
		local py = WorldService.GroundY(px, pz)
		local stake = Build.Part({ Name = "ZoneStake", Size = Vector3.new(0.5, 2.2, 0.5), CFrame = CFrame.new(px, py + 1.1, pz), Color = Color3.fromRGB(110, 80, 50), Material = Enum.Material.Wood, CanCollide = false, CanQuery = false, Parent = folder })
		stake.CastShadow = false
		Build.Decor({ Name = "Tip", Size = Vector3.new(0.6, 0.5, 0.6), CFrame = CFrame.new(px, py + 2.4, pz), Color = team.Color, Material = Enum.Material.Neon, Parent = folder, CastShadow = false })
	end

	local function toLocal2D(cf: CFrame): (number, number)
		return cf.Position.X, cf.Position.Z
	end
	local wbFront = origin * CFrame.new(0, 0, 10)
	local clearances = {
		{ X = firePos.X, Z = firePos.Z, R = Config.Build.FireClearance },
	}
	local fx, fz = toLocal2D(wbFront)
	table.insert(clearances, { X = fx, Z = fz, R = Config.Build.WorkbenchClearance })
	for _, p in pads do
		table.insert(clearances, { X = p.Position.X, Z = p.Position.Z, R = Config.Build.SpawnClearance })
	end
	local _, yawRad = origin:ToOrientation()
	local yaw = math.deg(yawRad)
	local hx, hz = toLocal2D(hutCF)
	local wx, wz = toLocal2D(wbCF)
	local bx, bz = toLocal2D(bannerCF)
	local rects = {
		{ X = hx, Z = hz, HX = 6.5, HZ = 5.5, Yaw = -yaw },
		{ X = wx, Z = wz, HX = 5, HZ = 2.5, Yaw = -yaw },
		{ X = bx, Z = bz, HX = 1.5, HZ = 1.5, Yaw = 0 },
	}

	return {
		Team = c.Team,
		Origin = origin,
		Fire = fire,
		FirePos = firePos,
		Workbench = wb,
		WorkbenchCF = wbCF,
		SpawnPads = pads,
		Clearances = clearances,
		StaticRects = rects,
		Folder = folder,
	}
end

-- Points of interest ----------------------------------------------------------------------

-- Chest spots come from the model's ChestMount attachments (in order), one per chest
-- tier that LayoutGen rolled for this POI.
local chestCounter = 0
local function addChests(map: MapInfo, model: Model, f: any)
	local mounts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Attachment") and d.Name == "ChestMount" then
			table.insert(mounts, d)
		end
	end
	for i, tier in f.Chests or {} do
		local mnt = mounts[((i - 1) % math.max(1, #mounts)) + 1]
		if mnt then
			chestCounter += 1
			table.insert(map.ChestSpots, { CF = mnt.WorldCFrame, Tier = tier, Poi = f.Type, Key = "C" .. chestCounter })
		end
	end
end

-- Natural clustering: small ground-cover companions gathered around the props
-- they'd really grow by (mushrooms and moss on fallen logs, pebbles and ferns at
-- boulders, twigs round stumps, ferns and roots at tree bases, stones along the
-- water) instead of everything spread evenly. Non-colliding, capped.
local COMPANIONS = {
	FallenLog = { "Mushrooms", "MossPatch", "Fern" },
	Boulder = { "Pebbles", "Fern", "MossPatch" },
	Stump = { "Twigs", "Mushrooms", "Fern" },
	DeadSnag = { "Twigs", "Roots" },
	Roots = { "LeafLitter", "Mushrooms" },
}
local COMPANION_CAP = 700

function WorldService._companions(layout: any, ground: (number, number) -> CFrame, rng: Random, parent: Instance)
	local placed = 0
	local function near(kind: string, x: number, z: number, r0: number, r1: number)
		if placed >= COMPANION_CAP then
			return
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(r0, r1)
		local px, pz = x + math.cos(a) * d, z + math.sin(a) * d
		if math.abs(px) > layout.HalfSize - 4 or math.abs(pz) > layout.HalfSize - 4 then
			return
		end
		Decor.Place(kind, ground(px, pz) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) + Vector3.new(0, 0.2, 0), rng, 1, parent)
		placed += 1
	end
	for i, d in layout.Middle do
		local list = COMPANIONS[d.Kind]
		if list then
			for _ = 1, rng:NextInteger(1, 3) do
				near(list[rng:NextInteger(1, #list)], d.X, d.Z, 1.5 * (d.Scale or 1), 3.5 * (d.Scale or 1))
			end
		end
		if i % 100 == 0 then
			task.wait()
		end
	end
	for i, t in layout.Trees do
		if rng:NextNumber() < 0.3 then
			near(if rng:NextNumber() < 0.5 then "Fern" else "Roots", t.X, t.Z, 1.8, 3)
		end
		if i % 150 == 0 then
			task.wait()
		end
	end
	for _, st in layout.Streams do
		local pts = st.Points
		for i = 1, #pts - 1, 2 do
			local p = pts[i]
			near(if rng:NextNumber() < 0.6 then "Pebbles" else "Fern", p.X, p.Z, st.Width / 2 + 2, st.Width / 2 + 5)
		end
	end
end

local POI_SCALE = 1.35

-- Distant cues that make players wonder "what's over there?": a thin smoke
-- column over lived-in buildings by day, and a lantern glow at the bigger
-- sites that reads through the trees at night. No map markers — just curiosity.
local SMOKE_POIS = { Cabin = true, SmallCabin = true, RangerStation = true, AbandonedHouse = true, Campsite = true, LoggingCamp = true }
local LIGHT_POIS = { RangerStation = true, Outpost = true, Bunker = true, IndustrialSite = true, LargeMine = true, MineEntrance = true, Campsite = true }

function WorldService._poiBeacon(m: Model, kind: string)
	local cf, size = m:GetBoundingBox()
	if SMOKE_POIS[kind] then
		local anchor = Build.Part({ Name = "BeaconSmoke", Size = Vector3.new(0.5, 0.5, 0.5), CFrame = cf * CFrame.new(size.X * 0.2, size.Y / 2 + 1, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = m })
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205), Color3.fromRGB(150, 150, 160))
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 7) })
		pe.Lifetime = NumberRange.new(6, 9)
		pe.Speed = NumberRange.new(3, 5)
		pe.Rate = 2.5
		pe.Acceleration = Vector3.new(1.2, 0.6, 0)
		pe.SpreadAngle = Vector2.new(8, 8)
		pe.LightInfluence = 1
		pe.Parent = anchor
	end
	if LIGHT_POIS[kind] then
		local lamp = Build.Part({ Name = "BeaconLamp", Size = Vector3.new(0.6, 0.8, 0.6), CFrame = cf * CFrame.new(0, size.Y * 0.1, -size.Z / 2 - 0.4), Color = Color3.fromRGB(255, 196, 120), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false, Parent = m })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 180, 110)
		light.Range = 22
		light.Brightness = 1.4
		light.Shadows = false
		light.Parent = lamp
	end
end

function WorldService._buildPoi(map: MapInfo, f: any, cf: CFrame, rng: Random, parent: Instance)
	local m = Landmarks.Build(f.Type, cf, rng, parent)
	if not m then
		return
	end
	-- Buildings were a bit small next to players: scale the whole POI (colliders,
	-- meshes and chest mounts together) about its ground pivot.
	m:ScaleTo(POI_SCALE)
	WorldService._poiBeacon(m, f.Type)
	m:SetAttribute("Poi", f.Type)
	m:SetAttribute("Tier", f.Tier)
	addChests(map, m, f)
	local O = map.Origin
	table.insert(map.NoBuild, { X = f.X + O.X, Z = f.Z + O.Z, R = f.R * POI_SCALE + 4, Label = "a " .. f.Type })
	table.insert(map.Pois, { Type = f.Type, Tier = f.Tier or "Common", Pos = cf.Position })
	-- lived-in surroundings: a woodpile of stumps and logs, scattered twigs and
	-- overgrowth creeping back in around the edge of the site
	local SITE = { "Stump", "Twigs", "FallenLog", "Twigs", "Fern", "Mushrooms", "Bush" }
	for k = 1, rng:NextInteger(4, 7) do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = (f.R or 10) * POI_SCALE * rng:NextNumber(0.95, 1.35)
		local x, z = f.X + math.cos(a) * d, f.Z + math.sin(a) * d
		if math.abs(x) < map.Layout.HalfSize - 6 and math.abs(z) < map.Layout.HalfSize - 6 then
			local gy = WorldService.GroundY(x + map.Origin.X, z + map.Origin.Z)
			local pcf = CFrame.new(x + map.Origin.X, gy - 0.3, z + map.Origin.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			Decor.Place(SITE[(k % #SITE) + 1], pcf, rng, rng:NextNumber(0.8, 1.1), parent)
		end
	end
end

-- Caves: carve the tunnel (and chambers) into the cliff rim before anything is placed.
local CAVE_WIDTH = { Small = 9, Medium = 11, Large = 13 }
function WorldService._carveCaves(map: MapInfo)
	local O = map.Origin
	for _, f in map.Layout.Features do
		if f.Type == "Cave" then
			local floorY = O.Y + LayoutGen.Height(map.Layout, f.X, f.Z) - 0.2
			local cf = CFrame.new(f.X + O.X, floorY, f.Z + O.Z) * CFrame.Angles(0, math.rad(f.Rot), 0)
			local w = CAVE_WIDTH[f.Size] or 9
			local len = f.Length or 22
			for z = 0, len, 4 do
				terrain:FillBlock(cf * CFrame.new(0, 5.2, z), Vector3.new(w, 10.4, 4.6), Enum.Material.Air)
			end
			terrain:FillBall((cf * CFrame.new(0, 5, len)).Position, w * 0.75, Enum.Material.Air)
			if f.Size == "Large" then
				-- side chambers
				terrain:FillBall((cf * CFrame.new(-w * 0.8, 5, len * 0.6)).Position, w * 0.7, Enum.Material.Air)
				terrain:FillBall((cf * CFrame.new(w * 0.8, 5, len * 0.85)).Position, w * 0.6, Enum.Material.Air)
			end
			-- flat slate floor all the way in
			terrain:FillBlock(cf * CFrame.new(0, -1, len / 2), Vector3.new(w + 6, 2, len + 12), Enum.Material.Slate)
			table.insert(map.Caves, { CF = cf, Length = len, Width = w + (if f.Size == "Large" then 10 else 0), FloorY = floorY, Size = f.Size or "Small" })
		end
	end
end

function WorldService._buildCave(map: MapInfo, f: any, rng: Random, parent: Instance)
	local cave
	for _, c in map.Caves do
		local d = (c.CF.Position - Vector3.new(f.X + map.Origin.X, c.CF.Position.Y, f.Z + map.Origin.Z)).Magnitude
		if d < 1 then
			cave = c
		end
	end
	if not cave then
		return
	end
	local m = Landmarks.CaveEntrance(cave.CF, rng, cave.Length, cave.Size, parent)
	m:SetAttribute("Poi", "Cave")
	m:SetAttribute("Tier", f.Tier)
	m:SetAttribute("CaveSize", cave.Size)
	addChests(map, m, f)
	table.insert(map.NoBuild, { X = f.X + map.Origin.X, Z = f.Z + map.Origin.Z, R = f.R + 6, Label = "the cave" })
	table.insert(map.Pois, { Type = "Cave", Tier = f.Tier or "Common", Pos = cave.CF.Position })
end

function WorldService.BuildMatch(seed: number): MapInfo
	WorldService.ClearMatch()
	local layout = LayoutGen.Generate(seed)
	local folder = Instance.new("Folder")
	folder.Name = "Match"
	folder.Parent = workspace
	local O = Config.Map.MatchOrigin
	local map: MapInfo = {
		Seed = seed,
		Layout = layout,
		Origin = O,
		Folder = folder,
		Camps = {},
		WaterPoints = {},
		DropPoints = {},
		Brush = {},
		ChestSpots = {},
		NoBuild = {},
		Caves = {},
		Pois = {},
	}
	WorldService.Map = map

	writeTerrain(map)
	WorldService._carveCaves(map)
	map.TerrainReady = true

	local decor = Instance.new("Folder")
	decor.Name = "Forest"
	decor.Parent = folder

	local function ground(x: number, z: number): CFrame
		return CFrame.new(x + O.X, WorldService.GroundY(x + O.X, z + O.Z) - 0.3, z + O.Z)
	end

	local drng = Random.new(seed)
	for i, t in layout.Trees do
		local cf = ground(t.X, t.Z) * CFrame.Angles(0, math.rad((i * 67) % 360), 0)
		local m
		if t.Kind == "Pine" then
			m = Nature.Pine(cf, t.Scale, decor)
		elseif t.Kind == "Oak" then
			m = Nature.Oak(cf, t.Scale, decor)
		elseif t.Kind == "Birch" then
			m = Nature.Birch(cf, t.Scale, decor)
		else
			-- Spruce, Aspen, DeadSnag, GiantTree: more silhouettes (mesh-first, Flora fallback)
			m = Decor.Place(t.Kind, cf, drng, t.Scale, decor)
		end
		if m and m:IsA("Model") then
			atomic(m)
		end
		if i % 60 == 0 then
			task.wait()
		end
	end
	-- Layered forest: middle (logs/boulders/stumps/roots), low (ferns/bushes/grass/saplings),
	-- ground cover (litter/moss/flowers/mushrooms/pebbles/twigs). Mesh-first, cheap.
	for i, d in layout.Middle do
		Decor.Place(d.Kind, ground(d.X, d.Z) * CFrame.Angles(0, math.rad(d.Rot), 0), drng, d.Scale, decor)
		if i % 80 == 0 then
			task.wait()
		end
	end
	WorldService._companions(layout, ground, drng, decor)
	for i, d in layout.Undergrowth do
		Decor.Place(d.Kind, ground(d.X, d.Z) * CFrame.Angles(0, math.rad(d.Rot), 0), drng, d.Scale, decor)
		if i % 150 == 0 then
			task.wait()
		end
	end
	for i, d in layout.GroundCover do
		Decor.Place(d.Kind, ground(d.X, d.Z) * CFrame.Angles(0, math.rad(d.Rot), 0) + Vector3.new(0, 0.25, 0), drng, 1, decor)
		if i % 200 == 0 then
			task.wait()
		end
	end
	-- Cliff rim faces (Blender cliff kit when loaded, procedural otherwise)
	local Skins = require(Models:WaitForChild("Skins"))
	for i, c in layout.Cliffs do
		local cf = ground(c.X, c.Z) * CFrame.Angles(0, math.rad(c.Rot), 0)
		if Skins.Has("SM_Cliff_Face01") then
			Decor.Place("Cliff", cf, drng, c.H / 26, decor)
		else
			atomic(Flora.CliffRock(cf, drng, Vector3.new(c.W, c.H, 8), decor))
		end
		if i % 20 == 0 then
			task.wait()
		end
	end
	-- Riverbank strips along both sides of every stream (grass -> mud -> rocks -> water).
	if Skins.Has("SM_Riverbank_Straight") then
		for _, st in layout.Streams do
			local pts = st.Points
			for i = 1, #pts - 1 do
				local a, b = pts[i], pts[i + 1]
				local dx, dz = b.X - a.X, b.Z - a.Z
				local len = math.sqrt(dx * dx + dz * dz)
				if len > 1 then
					local nx, nz = -dz / len, dx / len
					local steps = math.max(1, math.floor(len / 16 + 0.5))
					for k = 0, steps - 1 do
						local t = (k + 0.5) / steps
						local cx, cz = a.X + dx * t, a.Z + dz * t
						for _, side in { -1, 1 } do
							local off = st.Width / 2 + 5
							local px, pz = cx + nx * side * off, cz + nz * side * off
							local g = ground(px, pz)
							-- local -Z (the water edge) faces the stream centre line
							local cf = CFrame.lookAt(g.Position, Vector3.new(cx + O.X, g.Position.Y, cz + O.Z))
							Decor.Place("Riverbank", cf, drng, 1, decor)
						end
					end
				end
			end
			task.wait()
		end
	end
	for _, r in layout.Rocks do
		atomic(Nature.BigRock(ground(r.X, r.Z) * CFrame.Angles(0, math.rad(r.Rot), 0), r.Scale, decor))
	end
	for i, b in layout.Bushes do
		atomic(Nature.Bush(ground(b.X, b.Z) * CFrame.Angles(0, i, 0), b.Scale, decor))
	end
	for _, s in layout.Stones do
		atomic(Nature.StandingStone(ground(s.X, s.Z) * CFrame.Angles(0, math.rad(s.Rot), 0), decor))
	end
	for _, f in layout.Features do
		local cf = ground(f.X, f.Z) * CFrame.Angles(0, math.rad(f.Rot), 0)
		if f.Type == "Ruins" then
			atomic(Nature.Ruins(cf, decor))
		elseif f.Type == "FallenGiant" then
			atomic(Nature.FallenGiant(cf, decor))
		elseif f.Type == "RockOutcrop" then
			for k = 0, 4 do
				local a = math.rad(k * 72 + f.Rot)
				local d = if k == 0 then 0 else f.R * 0.5
				atomic(Nature.BigRock(ground(f.X + math.cos(a) * d, f.Z + math.sin(a) * d) * CFrame.Angles(0, a, 0), if k == 0 then 2.2 else 1.3, decor))
			end
		elseif f.Type == "Glade" then
			local colors = { Color3.fromRGB(240, 220, 110), Color3.fromRGB(230, 130, 170), Color3.fromRGB(170, 150, 240), Color3.fromRGB(250, 250, 250) }
			for k = 1, 18 do
				local a = k * 2.39996
				local d = math.sqrt(k / 18) * f.R * 0.9
				Nature.Flower(ground(f.X + math.cos(a) * d, f.Z + math.sin(a) * d), colors[(k % #colors) + 1], decor)
			end
		elseif f.Type == "Thicket" then
			-- handled with brush below
		elseif f.Type == "Waterfall" then
			atomic(Flora.WaterfallRocks(cf, drng, LayoutGen.RimHeight * 0.7, decor))
		elseif f.Type == "Cave" then
			WorldService._buildCave(map, f, drng, decor)
		elseif LayoutGen.LandmarkRadius[f.Type] then
			WorldService._buildPoi(map, f, cf, drng, decor)
		end
	end
	for _, b in layout.Brush do
		local count = math.floor(b.R * 0.9)
		for k = 1, count do
			local a = k * 2.39996
			local d = math.sqrt(k / count) * b.R
			Nature.GrassClump(ground(b.X + math.cos(a) * d, b.Z + math.sin(a) * d) * CFrame.Angles(0, k, 0), decor)
		end
		table.insert(map.Brush, { Pos = Vector3.new(b.X + O.X, 0, b.Z + O.Z), R = b.R })
	end

	-- Water refill points
	local waterFolder = Instance.new("Folder")
	waterFolder.Name = "Water"
	waterFolder.Parent = folder
	for _, w in layout.WaterPoints do
		local y = WorldService.GroundY(w.X + O.X, w.Z + O.Z) - 0.6
		local p = Build.Part({ Name = "WaterPoint", Size = Vector3.new(3, 1, 3), CFrame = CFrame.new(w.X + O.X, y, w.Z + O.Z), Transparency = 1, CanCollide = false, CanQuery = false, Parent = waterFolder })
		local ring = Build.Decor({ Name = "Ripple", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 4, 4), CFrame = CFrame.new(w.X + O.X, y + 0.05, w.Z + O.Z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Neon, Transparency = 0.6, Parent = p, CastShadow = false })
		ring.Name = "Ripple"
		table.insert(map.WaterPoints, { Pos = p.Position, Part = p })
	end

	for _, d in layout.DropPoints do
		table.insert(map.DropPoints, Vector3.new(d.X + O.X, WorldService.GroundY(d.X + O.X, d.Z + O.Z), d.Z + O.Z))
	end

	for _, c in layout.Camps do
		map.Camps[c.Team] = buildCamp(map, c)
	end

	-- Boundary: invisible walls plus a ring of edge pines.
	local H = layout.HalfSize
	for _, w in { { 0, -H - 6, 2 * H + 40, 4 }, { 0, H + 6, 2 * H + 40, 4 }, { -H - 6, 0, 4, 2 * H + 40 }, { H + 6, 0, 4, 2 * H + 40 } } do
		Build.Part({ Name = "Boundary", Size = Vector3.new(w[3], 300, w[4]), CFrame = CFrame.new(w[1] + O.X, 140 + O.Y, w[2] + O.Z), Transparency = 1, Parent = folder })
	end
	for i = 0, 79 do
		local t = i / 80 * 4
		local side = math.floor(t)
		local f = (t - side) * 2 - 1
		local x, z
		if side == 0 then
			x, z = f * (H + 14), -H - 14
		elseif side == 1 then
			x, z = H + 14, f * (H + 14)
		elseif side == 2 then
			x, z = -f * (H + 14), H + 14
		else
			x, z = -H - 14, -f * (H + 14)
		end
		atomic(Nature.Pine(CFrame.new(x + O.X, O.Y + LayoutGen.Height(layout, math.clamp(x, -H, H), math.clamp(z, -H, H)) - 0.5, z + O.Z), 1.5, decor))
	end

	return map
end

function WorldService.ClearMatch()
	local old = workspace:FindFirstChild("Match")
	if old then
		old:Destroy()
	end
	local map = WorldService.Map
	if map then
		local H = map.Layout.HalfSize + 32
		local O = map.Origin
		terrain:FillBlock(CFrame.new(O + Vector3.new(0, 28, 0)), Vector3.new(2 * H, 64, 2 * H), Enum.Material.Air)
	end
	WorldService.Map = nil
end

-- Lobby -----------------------------------------------------------------------------------

function WorldService.BuildLobby()
	local O = Config.Map.LobbyOrigin
	-- The lobby is small, so it's one Persistent model: sent whole on join, so the
	-- title-screen camera never shows trees streamed in before the ground under them.
	local folder = Instance.new("Model")
	folder.Name = "Lobby"
	folder.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	folder.Parent = workspace

	-- Island base: voxel forest floor (grass, moss, leaf litter, dirt paths) with a
	-- stream and two ponds, over a rocky underside.
	WorldService._lobbyTerrain(O)
	for i = 0, 15 do
		local a = math.rad(i * 22.5)
		Build.Part({ Name = "UnderRock", Size = Vector3.new(24, 30, 24), CFrame = CFrame.new(O + Vector3.new(math.cos(a) * 50, -26, math.sin(a) * 50)) * CFrame.Angles(0.3, a, 0.2), Color = Color3.fromRGB(104, 100, 96), Material = Enum.Material.Rock, Parent = folder, CanCollide = false })
	end
	-- Edge trees and rail
	for i = 0, 27 do
		local a = math.rad(i * (360 / 28) + 6)
		local cf = CFrame.new(O + Vector3.new(math.cos(a) * 68, 0, math.sin(a) * 68))
		local m = if i % 3 == 0 then Nature.Oak(cf, 0.9, folder) elseif i % 3 == 1 then Nature.Pine(cf, 1, folder) else Nature.Birch(cf, 1, folder)
		atomic(m)
	end
	Build.Part({ Name = "Rail", Shape = Enum.PartType.Cylinder, Size = Vector3.new(60, 152, 152), CFrame = CFrame.new(O + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 1, CanCollide = false, Parent = folder })
	for i = 0, 35 do
		local a = math.rad(i * 10)
		Build.Part({ Name = "EdgeWall", Size = Vector3.new(14, 40, 2), CFrame = CFrame.lookAt(O + Vector3.new(math.cos(a) * 75, 18, math.sin(a) * 75), O + Vector3.new(0, 18, 0)), Transparency = 1, Parent = folder })
	end

	-- Central campfire (decor)
	local fire = Camp.Campfire(CFrame.new(O), Color3.fromRGB(255, 200, 120), folder)
	fire.Name = "LobbyFire"
	local ring = fire:FindFirstChild("SafeRing") :: BasePart?
	if ring then
		ring:Destroy()
	end
	for i = 0, 5 do
		local a = math.rad(i * 60 + 30)
		Build.Cyl("LogSeat", 6, 1.8, CFrame.new(O + Vector3.new(math.cos(a) * 9, 0.9, math.sin(a) * 9)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(120, 84, 54), Enum.Material.Wood, folder)
	end

	-- Ready ring (stand inside to ready up)
	local readyCenter = O + Vector3.new(0, 0, -38)
	local readyPad = Build.Cyl("ReadyPad", 0.4, 22, CFrame.new(readyCenter + Vector3.new(0, 0.2, 0)), Color3.fromRGB(70, 90, 70), Enum.Material.Slate, folder)
	readyPad.Name = "ReadyPad"
	local glow = Build.Cyl("ReadyGlow", 0.2, 24, CFrame.new(readyCenter + Vector3.new(0, 0.1, 0)), Color3.fromRGB(120, 255, 160), Enum.Material.Neon, folder, false)
	glow.Name = "ReadyGlow"
	glow.Transparency = 0.35
	for i = 0, 7 do
		local a = math.rad(i * 45)
		local post = Build.Cyl("Torch", 5, 0.6, CFrame.new(readyCenter + Vector3.new(math.cos(a) * 12.5, 2.5, math.sin(a) * 12.5)), Color3.fromRGB(96, 66, 42), Enum.Material.Wood, folder)
		local flame = Instance.new("Fire")
		flame.Size = 2.5
		flame.Heat = 6
		flame.Parent = post
	end
	local sign = Build.Part({ Name = "ReadySign", Size = Vector3.new(16, 4, 0.5), CFrame = CFrame.new(readyCenter + Vector3.new(0, 9, -13)), Color = Color3.fromRGB(60, 44, 30), Material = Enum.Material.WoodPlanks, Parent = folder })
	Build.Label(sign, "STAND HERE TO READY UP", Vector3.new(0, 0, 0), Color3.fromRGB(180, 255, 190), 150)
	folder:SetAttribute("ReadyCenter", readyCenter)
	folder:SetAttribute("ReadyRadius", 11)

	-- Stations: Shop (east), Class shrine (west), Party board (south), Outfitter (SE), Hall of Fame (SW)
	local function station(name: string, pos: Vector3, color: Color3, label: string, promptText: string)
		local m = Build.Model(name, folder)
		local counter = Build.Part({ Name = "Counter", Size = Vector3.new(10, 3.4, 3), CFrame = CFrame.lookAt(pos + Vector3.new(0, 1.7, 0), O + Vector3.new(0, 1.7, 0)), Color = Color3.fromRGB(120, 84, 54), Material = Enum.Material.WoodPlanks, Parent = m })
		for _, x in { -4.6, 4.6 } do
			Build.Part({ Name = "Post", Size = Vector3.new(0.8, 9, 0.8), CFrame = counter.CFrame * CFrame.new(x, 2.8, 1.2), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = m })
		end
		Build.Part({ Class = "WedgePart", Name = "Awning", Size = Vector3.new(11, 1.6, 5), CFrame = counter.CFrame * CFrame.new(0, 7.6, 0) * CFrame.Angles(0, math.rad(180), 0), Color = color, Material = Enum.Material.Fabric, Parent = m })
		Build.Label(counter, label, Vector3.new(0, 9, 0), Color3.new(1, 1, 1), 120)
		m.PrimaryPart = counter
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StationPrompt"
		prompt.ActionText = promptText
		prompt.ObjectText = label
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Station", name)
		prompt:SetAttribute("Action", "Station")
		prompt.Style = Enum.ProximityPromptStyle.Custom
		prompt.Parent = counter
		return m
	end
	station("Shop", O + Vector3.new(40, 0, 0), Color3.fromRGB(230, 170, 60), "TRADING POST", "Open Shop")
	local shrine = station("Classes", O + Vector3.new(-40, 0, 0), Color3.fromRGB(120, 200, 180), "CLASS SHRINE", "Choose Class")
	local Classes = require(Shared:WaitForChild("Classes"))
	for i, def in Classes.List do
		local a = math.rad(-75 + (i - 1) * 25)
		local pos = O + Vector3.new(-40 + math.cos(a + math.pi) * -9, 0, math.sin(a) * 12)
		local ped = Build.Cyl("Pedestal", 3, 2.4, CFrame.new(pos + Vector3.new(0, 1.5, 0)), Color3.fromRGB(140, 136, 128), Enum.Material.Marble, shrine)
		local orb = Build.Ball("Orb", 1.6, CFrame.new(pos + Vector3.new(0, 4, 0)), Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3]), Enum.Material.Neon, shrine)
		orb.CanQuery = false
		Build.Label(ped, def.Glyph .. " " .. def.Name, Vector3.new(0, 5.4, 0), Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3]), 60)
	end
	local party = station("Party", O + Vector3.new(0, 0, 40), Color3.fromRGB(110, 150, 230), "PARTY BOARD", "Manage Party")
	local locker = station("Locker", O + Vector3.new(30, 0, 30), Color3.fromRGB(190, 110, 200), "OUTFITTER", "Open Locker")
	local profile = station("Profile", O + Vector3.new(-30, 0, 30), Color3.fromRGB(240, 200, 90), "HALL OF FAME", "Profile & Rewards")
	WorldService.LobbyBoard = Refuge.Dress(folder, O, readyCenter, {
		Shop = folder:FindFirstChild("Shop") :: Model,
		Classes = shrine,
		Party = party,
		Locker = locker,
		Profile = profile,
	}, WorldService.LobbyWater)

	-- Title
	local title = Build.Part({ Name = "Title", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(O + Vector3.new(0, 26, -50)), Transparency = 1, CanCollide = false, Parent = folder })
	local bb = Build.Label(title, "SURVIVAL HOUR", Vector3.new(0, 0, 0), Color3.fromRGB(255, 200, 120), 400)
	bb.Size = UDim2.fromOffset(700, 110)
	bb.AlwaysOnTop = false

	WorldService.LobbySpawn = CFrame.new(O + Vector3.new(0, 4, 18)) * CFrame.Angles(0, math.rad(180), 0)
	return folder
end

-- Lobby water: shared with Refuge so decorations keep out of it.
WorldService.LobbyWater = {
	Ponds = { { X = 34, Z = -30, R = 9 }, { X = -36, Z = -26, R = 7 } },
	Stream = { { 58, -46 }, { 50, -41 }, { 43, -35 }, { 37, -32 } }, -- from the NE rim into the NE pond
}

-- Voxel island for the lobby. Surface at O.Y (4-stud aligned), 12 studs thick,
-- rock underneath; noise-picked forest-floor materials; dirt cross paths; a
-- stream falling off the edge into a pond; a second quiet pond.
function WorldService._lobbyTerrain(O: Vector3)
	local R = 74
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(88, 122, 62))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(70, 106, 52))
		terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(104, 84, 60))
		terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(74, 60, 46))
	end)
	-- body + rocky underside
	terrain:FillCylinder(CFrame.new(O + Vector3.new(0, -8, 0)), 16, R, Enum.Material.Ground)
	terrain:FillCylinder(CFrame.new(O + Vector3.new(0, -22, 0)), 12, R * 0.8, Enum.Material.Rock)
	terrain:FillCylinder(CFrame.new(O + Vector3.new(0, -32, 0)), 8, R * 0.5, Enum.Material.Rock)
	-- top layer: 4-stud cells, material from two noise fields
	local STEP = 4
	for x = -R, R, STEP do
		for z = -R, R, STEP do
			if x * x + z * z <= R * R then
				local nA = math.noise(x / 26, z / 26, 3.7)
				local nB = math.noise(x / 11 + 20, z / 11, 8.2)
				local mat = if nA > 0.22 then Enum.Material.LeafyGrass
					elseif nA < -0.3 then Enum.Material.Ground
					elseif nB > 0.4 then Enum.Material.Mud
					else Enum.Material.Grass
				if math.abs(x) <= 5 or math.abs(z) <= 5 then
					mat = Enum.Material.Ground -- cross paths
				end
				if x * x + z * z < 15 * 15 then
					mat = Enum.Material.Ground -- packed earth round the fire
				end
				terrain:FillBlock(CFrame.new(O + Vector3.new(x, -2, z)), Vector3.new(STEP, 4, STEP), mat)
			end
		end
	end
	-- water: ponds and the stream (carved, then filled a little below the bank)
	local W = WorldService.LobbyWater
	for _, pd in W.Ponds do
		local c = O + Vector3.new(pd.X, 0, pd.Z)
		terrain:FillCylinder(CFrame.new(c + Vector3.new(0, -2.5, 0)), 5, pd.R + 2.5, Enum.Material.Mud)
		terrain:FillCylinder(CFrame.new(c + Vector3.new(0, -2, 0)), 4, pd.R, Enum.Material.Air)
		terrain:FillCylinder(CFrame.new(c + Vector3.new(0, -2.5, 0)), 3, pd.R, Enum.Material.Water)
		terrain:FillCylinder(CFrame.new(c + Vector3.new(0, -5, 0)), 2, pd.R, Enum.Material.Sand)
	end
	for i = 1, #W.Stream - 1 do
		local a = O + Vector3.new(W.Stream[i][1], 0, W.Stream[i][2])
		local b = O + Vector3.new(W.Stream[i + 1][1], 0, W.Stream[i + 1][2])
		local mid = (a + b) / 2
		local len = (b - a).Magnitude + 3
		local cf = CFrame.lookAt(mid, b)
		terrain:FillBlock(cf * CFrame.new(0, -1.5, 0), Vector3.new(8, 3, len), Enum.Material.Mud)
		terrain:FillBlock(cf * CFrame.new(0, -1, 0), Vector3.new(4.5, 2, len), Enum.Material.Air)
		terrain:FillBlock(cf * CFrame.new(0, -1.5, 0), Vector3.new(4.5, 1.5, len), Enum.Material.Water)
	end
end

-- Updates the Hall of Fame board text (called by LobbyService).
function WorldService.SetLobbyBoard(lines: { string })
	local tl = WorldService.LobbyBoard
	if tl and tl.Parent then
		tl.Text = table.concat(lines, "\n")
	end
end

return WorldService
]]></string>
          </Properties>
