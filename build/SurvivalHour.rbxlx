	piece(m, { Name = "Head", Size = Vector3.new(0.7, 0.7, 1.6), CFrame = CFrame.new(0, 0, -2.5) * CFrame.Angles(math.rad(90), 0, 0), Color = STONE, Material = Enum.Material.Slate })
