local I = require("../src/shared/Logic/InventoryModel")

local function new()
	return I.New(30, 3, { Arrow = 30, Bullet = 24 })
end

return {
	capacity_limit = function(t)
		local inv = new()
		t.eq(I.AddResource(inv, "Wood", 25), 25)
		t.eq(I.AddResource(inv, "Stone", 10), 5, "only 5 fit")
		t.eq(I.FreeSpace(inv), 0)
		t.eq(I.AddResource(inv, "Stick", 1), 0)
	end,
	rejects_bad_input = function(t)
		local inv = new()
		t.eq(I.AddResource(inv, "Diamond", 5), 0)
		t.eq(I.AddResource(inv, "Wood", -3), 0)
		t.eq(I.AddResource(inv, "Wood", 1.5), 0)
	end,
	remove_all_or_nothing = function(t)
		local inv = new()
		I.AddResource(inv, "Wood", 3)
		I.AddResource(inv, "Stone", 1)
		t.no(I.RemoveResources(inv, { Wood = 2, Stone = 2 }))
		t.eq(inv.Resources.Wood, 3, "unchanged")
		t.ok(I.RemoveResources(inv, { Wood = 2, Stone = 1 }))
		t.eq(inv.Resources.Wood, 1)
	end,
	equipment_slots_and_swap = function(t)
		local inv = new()
		t.eq((I.AddEquipment(inv, "Weapon", { Id = "Spear", Durability = 90 })), "Weapon1")
		t.eq((I.AddEquipment(inv, "Weapon", { Id = "Bow", Durability = 150 })), "Weapon2")
		I.Equip(inv, "Weapon2")
		local slot, old = I.AddEquipment(inv, "Weapon", { Id = "Sword", Durability = 200 }, "Weapon2")
		t.eq(slot, "Weapon2")
		t.eq(old.Id, "Bow", "displaced item returned for dropping")
		t.eq((I.AddEquipment(inv, "Tool", { Id = "StoneAxe" })), "Tool")
		local _, oldTool = I.AddEquipment(inv, "Tool", { Id = "RepairHammer" })
		t.eq(oldTool.Id, "StoneAxe")
		t.ok(I.Swap(inv, "Weapon1", "Weapon2"))
		t.eq(inv.Slots.Weapon1.Id, "Sword")
		t.eq(inv.Equipped, "Weapon1", "equipped follows swap")
		t.no(I.Swap(inv, "Weapon1", "Tool"), "cannot swap weapon into tool slot")
	end,
	armor_is_worn = function(t)
		local inv = new()
		t.eq((I.AddEquipment(inv, "Armor", { Id = "Armor", Durability = 300 })), "Armor")
		t.eq(inv.Slots.Weapon1, nil)
	end,
	death_drop_keeps_equipment = function(t)
		local inv = new()
		I.AddResource(inv, "Wood", 4)
		I.AddResource(inv, "Leather", 2)
		I.AddEquipment(inv, "Weapon", { Id = "Spear" })
		local dropped = I.TakeAllResources(inv)
		t.eq(dropped.Wood, 4)
		t.eq(dropped.Leather, 2)
		t.eq(I.ResourceTotal(inv), 0)
		t.eq(inv.Slots.Weapon1.Id, "Spear")
	end,
	ammo_and_bandage_caps = function(t)
		local inv = new()
		t.eq(I.AddAmmo(inv, "Arrow", 40), 30)
		t.eq(I.AddBandages(inv, 5), 3)
		t.ok(I.UseAmmo(inv, "Arrow"))
		t.eq(inv.Ammo.Arrow, 29)
		t.no(I.UseAmmo(inv, "Bullet"))
	end,
	wear_breaks_item = function(t)
		local inv = new()
		I.AddEquipment(inv, "Weapon", { Id = "Spear", Durability = 2 })
		I.Equip(inv, "Weapon1")
		t.no(I.Wear(inv, "Weapon1", 1))
		t.ok(I.Wear(inv, "Weapon1", 1), "breaks")
		t.eq(inv.Slots.Weapon1, nil)
		t.eq(inv.Equipped, nil, "falls back to fists")
	end,
}
